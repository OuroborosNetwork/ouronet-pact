;;
;; REPL/deb-staleness-inject-cc.repl — sibling of deb-staleness-proof.repl for the
;; enforced-fresh inject CC-batch (defun+gate). Loads the IDENTICAL fixture chain
;; (through [6.4]_AQP-EXHAUSTIVE-COLLECT.repl, which stands up SubsidiaryTreasury +
;; ANHD's deb-based stake), then paginates the enforced-fresh inject: fix stale stakers
;; in chunks, then finalize-inject on the fresh divisor.
;;
;; SEPARATE DRIVER: the test moves ANHD's Elite-DEB down to create staleness — the same
;; starting deb the [6.2.8b] unstale test needs — so they run in different pact processes.
;; deb-staleness-proof.repl injects via the 2-step defpact ([6.2.7] DEB07/08); this driver
;; does the SAME enforced-fresh inject via the paginated CC-batch ([6.2.8c]).
;;
(print "")
(print "================================================================")
(print "FILE  REPL/deb-staleness-inject-cc.repl  —  inject CC-batch (defun+gate)")
(print "================================================================")
(load "Stage00_Sanboxes.repl")
(load "Stage01_Tester.repl")
;;#P2 REPAIR: this hand-rolled Stage-2 deploy block predated deploy-stage02.repl and no longer
;;provisions everything the suites below need -- notably KBN, which [5.4]_PopulateBunnies stopped
;;deploying itself ("no longer redeployed here", [5.4] line 50) once deploy-stage02 took it over.
;;The result was "Module KBN has no such member: A_Step01" partway through, killing the run.
;;deploy-stage02.repl IS this block plus [Z]_Reads, KBN, AQP-BOOT and Step0, so it replaces both
;;this and the hand-rolled AQP-BOOT transactions that used to follow.
(load "deploy-stage02.repl")
(load "Stage_02/[5.2]_PopulateBloodshed.repl")
(load "Stage_02/[5.1]_PopulateNosferatu.repl")
(load "Stage_02/[5.4]_PopulateBunnies.repl")
(load "Stage_02/[6.2.1]_AQP-ANK.repl")
(load "Stage_02/[6.2.2]_AQP-SCORE.repl")
(load "Stage_02/[6.2.3]_AQP-POOL.repl")
(load "Stage_02/[6.2.9]_AQP-BOOT-FULL.repl")
(load "Stage_02/[6.4]_AQP-EXHAUSTIVE-PREP.repl")
(load "Stage_02/[6.4]_AQP-EXHAUSTIVE-BOOT-POOLS.repl")
(load "Stage_02/[6.4]_AQP-EXHAUSTIVE-RPS.repl")
(load "Stage_02/[6.4]_AQP-EXHAUSTIVE-COLLECT.repl")

;;AQP-INFO is loaded HERE, not inside the suite below, because a SHARED suite file may only name what
;;its narrowest loader provides — the lesson from the launchpad gate failure, where `[5.3]_Launchpad`
;;compiled under one Stage-02 chain and died under the other. This runner is the only LIVE loader of
;;the suite below (AQP-FULL keeps it commented out), so it is the one chain that can supply the reader.
(begin-tx "AQP-INFO - load module for the zero-quote cost block")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(namespace "ouronet-ns")
(env-sigs [{ "key": "1a4e15d3c51e0b73e92644600487ba8eaae312e1a178b91801d54e13c1b350a5", "caps": [] }])
(load "../1_SOVEREIGN/STAGE_02/2_Core/03_AQP/09_AQP-INFO.pact")
(commit-tx)
(load "Stage_02/[6.2.8c]_AQP-INJECT-CC.repl")
