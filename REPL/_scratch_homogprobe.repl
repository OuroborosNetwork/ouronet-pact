;; REPL/_scratch_homogprobe.repl — find a HOMOGENEOUS ladder fixture that actually pays.
;; OuroLpFarm carries a MULTIPLET_BASE OURO reward (AQP-BOOT Step 11) and NO quality split, so it
;; is the homogeneous route: bronze -> OURO raw, silver -> one coil, gold -> two coils. That is the
;; route a live dhourolp collect takes, and the one whose per-score branching is untested.
(load "triplet-collect-golden.repl")
(begin-tx "TX-HP01 - diagnose OuroLpFarm homogeneous ladder payout")
(namespace "ouronet-ns")
(env-gasmodel "table")(env-gaslimit 200000000)
(print "")
(print "=== TX-HP01 — OuroLpFarm homogeneous diagnosis ================================")
(let
    (
        (patron:string KST.ANHD)
        (ouro-id:string "OURO-98c486052a51")
        (farm-id:string (U|DALOS.UDC_Makeid "OuroLpFarm"))
        (pool-id:string (U|DALOS.UDC_Makeid "DHOuroLp"))
    )
    (let*
        (
            (triplet-id:string (AQP-SCORE.UC_ComputeTripletId
                (U|DALOS.UDC_Makeid "BronzeSnakePower")
                (U|DALOS.UDC_Makeid "SilverSnakePower")
                (U|DALOS.UDC_Makeid "GoldenSnakePower")))
        )
        (print (format "ZZZ reward-kind = {}" [(AQP-FVT.UR_FVT-RG|RewardKind farm-id ouro-id)]))
        (print (format "ZZZ mode        = {}" [(RPS.UR_FVT-QS|Mode farm-id ouro-id)]))
        (print (format "ZZZ lanes       = {}" [(RPS.URC_ComputeTripletLanes patron pool-id triplet-id)]))
        (print (format "ZZZ claimable   = {}" [(AQP-FVT.URC_CollectClaimableRewards patron pool-id farm-id 3 triplet-id ouro-id)]))
        (print (format "ZZZ L_i         = {}" [(AQP-FVT.UR_FVT-RM|MemberDebRps farm-id triplet-id ouro-id)]))
        (print (format "ZZZ last-rps    = {}" [(AQP-FVT.UR_FVT-RU|LastRps patron farm-id triplet-id ouro-id)]))
        (env-sigs [{ "key": "PK_AncientHodler", "caps": [] }])
        (print (format "<(CC_Inject 500 OURO)> => \"{}\"" [(TS02-C3.AQP-FVT|CC_Inject patron patron farm-id ouro-id 500.0)]))
        (print (format "ZZZ claimable AFTER inject = {}" [(AQP-FVT.URC_CollectClaimableRewards patron pool-id farm-id 3 triplet-id ouro-id)]))
        (print (format "ZZZ L_i AFTER   = {}" [(AQP-FVT.UR_FVT-RM|MemberDebRps farm-id triplet-id ouro-id)]))
        (print (format "ZZZ PREVIEW     = {}" [(RPS.URC_CollectLadderPreview patron pool-id farm-id 3 triplet-id ouro-id)]))
    )
)
(env-sigs [])
(commit-tx)
