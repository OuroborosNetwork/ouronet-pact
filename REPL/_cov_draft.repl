(begin-tx "COV DRAFT 2 - HotRecovery (mint nonces) + Repurpose + Reverse(Recover) + SetHotRecoveryFees")
(namespace "ouronet-ns")
(env-sigs [ { "key": "PK_AOZ", "caps": [] } ])
(let
    (
        (ref-TS01-C2:module{TalosStageOne_ClientTwoV1} TS01-C2)
        (aoz:string KST.AOZT)
        (patron:string KST.ANHD)
        (ps:string "PlebeicStrength-98c486052a51")
        (th-k:string "THKOSON-98c486052a51")
        (pd-k:string "PDKOSON-98c486052a51")
    )
    (print (format "aoz PDKOSON (cold-rbt) balance: {}" [(DPTF.UR_AccountSupply pd-k aoz)]))
    (ref-TS01-C2::ATS|C_SetHotRecoveryFee aoz ps 20.0 30)
    (print "hot recovery fees set")
    (ref-TS01-C2::ATS|C_SwitchHotRecovery aoz ps true)
    (ref-TS01-C2::ATS|C_HotRecovery aoz aoz ps 1.0)
    (print (format "th-k nonces used: {}" [(DPOF.UR_NoncesUsed th-k)]))
)
(commit-tx)

;;||>>>>>>>>>>>>>>>>>>>>>>>>>
;;|| NEXT                   >
;;||>>>>>>>>>>>>>>>>>>>>>>>>>
(begin-tx "COV DRAFT 3 - Repurpose nonce 1, mint nonce 2, Reverse(Recover) nonce 2")
(namespace "ouronet-ns")
(env-sigs [ { "key": "PK_AOZ", "caps": [] } ])
(let
    (
        (ref-TS01-C2:module{TalosStageOne_ClientTwoV1} TS01-C2)
        (aoz:string KST.AOZT)
        (patron:string KST.ANHD)
        (ps:string "PlebeicStrength-98c486052a51")
        (th-k:string "THKOSON-98c486052a51")
    )
    (ref-TS01-C2::ATS|C_HOT-RBT|Repurpose aoz th-k 1 patron)
    (print (format "nonce 1 repurposed to patron: {}" [(DPOF.UR_NonceHolder th-k 1)]))
    (ref-TS01-C2::ATS|C_HotRecovery aoz aoz ps 1.0)
    (print (format "th-k nonces used now: {}" [(DPOF.UR_NoncesUsed th-k)]))
    (ref-TS01-C2::ATS|C_Reverse aoz aoz th-k 3)
    (print "nonce 2 reversed (Recover) back to cold-rbt")
)
(commit-tx)

;;||>>>>>>>>>>>>>>>>>>>>>>>>>
;;|| NEXT                   >
;;||>>>>>>>>>>>>>>>>>>>>>>>>>
(begin-tx "COV DRAFT 4 - A_RemoveSecondary (admin) + WithdrawRoyalties + DirectRecovery")
(namespace "ouronet-ns")
(env-sigs [ { "key": "PK_AOZ", "caps": [] } { "key": "PK_AncientHodler", "caps": [] } ])
(let
    (
        (ref-TS01-A:module{TalosStageOne_AdminV1} TS01-A)
        (ref-TS01-C2:module{TalosStageOne_ClientTwoV1} TS01-C2)
        (aoz:string KST.AOZT)
        (ancienthodler:string KST.ANHD)
        (ps:string "PlebeicStrength-98c486052a51")
        (e-k:string "EKOSON-98c486052a51")
        (pd-k:string "PDKOSON-98c486052a51")
    )
    (print (format "ps RT list before admin removal: {}" [(ATS.UR_RewardTokenList ps)]))
    (ref-TS01-A::ATS|A_RemoveSecondary ancienthodler ancienthodler ps e-k [])
    (print (format "ps RT list after admin removal: {}" [(ATS.UR_RewardTokenList ps)]))
    ;; WithdrawRoyalties - ensure some royalty exists first
    (ref-TS01-C2::ATS|C_UpdateRoyalty aoz ps 5.0)
    (ref-TS01-C2::ATS|C_SwitchColdRecovery aoz ps true)
    (ref-TS01-C2::ATS|C_Coil aoz ps pd-k 1.0)
    (print (format "ps royalty accrued: {}" [(ATS.UR_RewardTokenRUR ps 3)]))
    (ref-TS01-C2::ATS|C_WithdrawRoyalties aoz ps aoz)
    (print "royalties withdrawn")
    ;; DirectRecovery
    (ref-TS01-C2::ATS|C_SetDirectRecoveryFee aoz ps 5.0)
    (ref-TS01-C2::ATS|C_SwitchDirectRecovery aoz ps true)
    (ref-TS01-C2::ATS|C_DirectRecovery aoz ps 1.0)
    (print "direct recovery done")
)
(commit-tx)
