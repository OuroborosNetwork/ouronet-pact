(load "Stage_01/[5.2]_Dispenser+.repl")
(load "Stage_01/[6.2+3]_DPTF-SWP_Issuance-Only.repl")
(load "Stage_01/[6.5]_DPOF.repl")
(load "Stage_01/[6.6]_ATS.repl")

(begin-tx "COV DRAFT 0 - issue a fresh DPOF token owned directly by aoz (not a smart account)")
(namespace "ouronet-ns")
(let
    (
        (ref-DALOS:module{OuronetDalosV1} DALOS)
        (aoz:string KST.AOZT)
        (split-kda:[decimal] (ref-DALOS::URC_SplitKDAPrices aoz (ref-DALOS::UR_UsagePrice "dpmf")))
    )
    (env-sigs
        [
            { "key": "PK_AOZ", "caps": [] }
            { "key": "95a59029029524ebb250b2fafe6826ff88bb59c527d661cba3279d09a51d3bdf", "caps":
                [
                    (coin.TRANSFER "k:95a59029029524ebb250b2fafe6826ff88bb59c527d661cba3279d09a51d3bdf" "k:50d6c59b21e5e6e55baecaa75a1007de37576bde12d8230dc82459cc01b9484b" (at 2 split-kda))
                    (coin.TRANSFER "k:95a59029029524ebb250b2fafe6826ff88bb59c527d661cba3279d09a51d3bdf" "k:0cb30c0121ff919266121a99ff9359871818932211df94dae4137c29bc0e8f7e" (at 0 split-kda))
                    (coin.TRANSFER "k:95a59029029524ebb250b2fafe6826ff88bb59c527d661cba3279d09a51d3bdf" "c:XM-pkmuB5XUQlp87ZYSbfKt8qzmHY6O2EHAzMRVBt3k" (at 3 split-kda))
                    (coin.TRANSFER "k:95a59029029524ebb250b2fafe6826ff88bb59c527d661cba3279d09a51d3bdf" "c:iQQFWj6gWtpGEzhM_O5ekW1QtnQQy55R8BRPGhj_0FU" (at 1 split-kda))
                ]
            }
        ]
    )
)
(let
    (
        (ref-TS01-C1:module{TalosStageOne_ClientOneV1} TS01-C1)
        (aoz:string KST.AOZT)
        (ids:list
            (ref-TS01-C1::DPOF|C_Issue
                aoz aoz
                ["TestHotToken"] ["THKOSON"] [12]
                [true] [true] [true] [false] [false] [true] [true]
            )
        )
    )
    (print (format "issued: {}" [ids]))
)
(commit-tx)
