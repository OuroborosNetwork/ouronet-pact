(begin-tx "COV DRAFT 1a - rejection checks (patron key only)")
(namespace "ouronet-ns")
(env-sigs [ { "key": "PK_AncientHodler", "caps": [] } ])
(let
    (
        (ref-TS01-C2:module{TalosStageOne_ClientTwoV1} TS01-C2)
        (patron:string KST.ANHD)
        (ps:string "PlebeicStrength-98c486052a51")
        (th-k:string "THKOSON-98c486052a51")
    )
    (print (expect-failure "non-owner cannot toggle can-upgrade" (ref-TS01-C2::ATS|C_ToggleUpgrade patron ps false)))
)
(commit-tx)
;;||>>>>>>>>>>>>>>>>>>>>>>>>>
;;|| NEXT                   >
;;||>>>>>>>>>>>>>>>>>>>>>>>>>
(begin-tx "COV DRAFT 1b - real owner path (aoz key only)")
(namespace "ouronet-ns")
(env-sigs [ { "key": "PK_AOZ", "caps": [] } ])
(let
    (
        (ref-TS01-C2:module{TalosStageOne_ClientTwoV1} TS01-C2)
        (ref-DALOS:module{OuronetDalosV1} DALOS)
        (aoz:string KST.AOZT)
        (patron:string KST.ANHD)
        (ps:string "PlebeicStrength-98c486052a51")
        (th-k:string "THKOSON-98c486052a51")
    )
    (ref-TS01-C2::ATS|C_ToggleUpgrade aoz ps false)
    (print (format "can-upgrade now: {}" [(ATS.UR_CanUpgrade ps)]))
    (ref-TS01-C2::ATS|C_ToggleUpgrade aoz ps true)
    (print (format "can-upgrade restored: {}" [(ATS.UR_CanUpgrade ps)]))
    (ref-TS01-C2::ATS|C_SetHibernationFees aoz ps 100.0 0.01)
    (print "hibernation fees set")
    (ref-TS01-C2::ATS|C_SwitchColdRecovery aoz ps false)
    (ref-TS01-C2::ATS|C_SwitchHotRecovery aoz ps false)
    (ref-TS01-C2::ATS|C_AddHotRBT aoz ps th-k)
    (print (format "ps hot-rbt now: {}" [(ATS.UR_HotRewardBearingToken ps)]))
    (ref-TS01-C2::ATS|C_HOT-RBT|UpdatePendingBranding aoz th-k "logo" "desc" "site" [])
    (print "branding update ok")
    (let
        (
            (blue-split:[decimal] (ref-DALOS::URC_SplitKDAPrices aoz (ref-DALOS::UR_UsagePrice "blue")))
        )
        (env-sigs
            [
                { "key": "PK_AOZ", "caps": [] }
                { "key": "95a59029029524ebb250b2fafe6826ff88bb59c527d661cba3279d09a51d3bdf", "caps":
                    [
                        (coin.TRANSFER "k:95a59029029524ebb250b2fafe6826ff88bb59c527d661cba3279d09a51d3bdf" "k:50d6c59b21e5e6e55baecaa75a1007de37576bde12d8230dc82459cc01b9484b" (at 2 blue-split))
                        (coin.TRANSFER "k:95a59029029524ebb250b2fafe6826ff88bb59c527d661cba3279d09a51d3bdf" "k:0cb30c0121ff919266121a99ff9359871818932211df94dae4137c29bc0e8f7e" (at 0 blue-split))
                        (coin.TRANSFER "k:95a59029029524ebb250b2fafe6826ff88bb59c527d661cba3279d09a51d3bdf" "c:XM-pkmuB5XUQlp87ZYSbfKt8qzmHY6O2EHAzMRVBt3k" (at 3 blue-split))
                        (coin.TRANSFER "k:95a59029029524ebb250b2fafe6826ff88bb59c527d661cba3279d09a51d3bdf" "c:iQQFWj6gWtpGEzhM_O5ekW1QtnQQy55R8BRPGhj_0FU" (at 1 blue-split))
                    ]
                }
            ]
        )
    )
    (ref-TS01-C2::ATS|C_HOT-RBT|UpgradeBranding aoz th-k 1)
    (print "branding upgrade ok")
)
(commit-tx)

