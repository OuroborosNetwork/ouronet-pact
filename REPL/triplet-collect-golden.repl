(load "Stage_02/[5.4]_PopulateBunnies.repl")
(begin-tx "TX-AQP-BOOT - module")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(namespace "ouronet-ns")
(env-sigs [{"key": "1a4e15d3c51e0b73e92644600487ba8eaae312e1a178b91801d54e13c1b350a5", "caps": []}])
(load "../2_CITIZEN/4_VaultsMinter/04_AQP-BOOT.pact")
(commit-tx)
(begin-tx "TX-AQP-BOOT - Step0")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(namespace "ouronet-ns")
(env-sigs [{ "key": "PK_AncientHodler", "caps": [] }])
(print (format "<(AQP-BOOT|C_Step0_WireImcAndGovernor)> => \"{}\"" [(AQP-BOOT.C_Step0_WireImcAndGovernor KST.ANHD)]))
(commit-tx)
(begin-tx "TX-BOOT-04 - AQP-BOOT Step4 core scores")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(namespace "ouronet-ns")
(let
    (
        (patron:string KST.ANHD)
        (owner-konto:string KST.ANHD)
        (ref-DALOS:module{OuronetDalosV1} DALOS)
        (split-kda:[decimal] (ref-DALOS::URC_SplitKDAPrices patron (* 4.0 (ref-DALOS::UR_UsagePrice "smart"))))
    )
    (env-sigs
        [
            { "key": "PK_AncientHodler", "caps": [] }
            { "key": "6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263",
              "caps":
                [
                    (coin.TRANSFER "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263" "k:50d6c59b21e5e6e55baecaa75a1007de37576bde12d8230dc82459cc01b9484b" (at 2 split-kda))
                    (coin.TRANSFER "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263" "k:0cb30c0121ff919266121a99ff9359871818932211df94dae4137c29bc0e8f7e" (at 0 split-kda))
                    (coin.TRANSFER "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263" "c:XM-pkmuB5XUQlp87ZYSbfKt8qzmHY6O2EHAzMRVBt3k" (at 3 split-kda))
                    (coin.TRANSFER "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263" "c:iQQFWj6gWtpGEzhM_O5ekW1QtnQQy55R8BRPGhj_0FU" (at 1 split-kda))
                ]
            }
        ]
    )
    (print (format "<(AQP-BOOT|C_Step4_CreateCoreScores)> => \"{}\"" [(AQP-BOOT.C_Step4_CreateCoreScores patron owner-konto)]))
)
(env-sigs [])
(commit-tx)
