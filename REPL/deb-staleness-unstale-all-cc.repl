;;
;; REPL/deb-staleness-unstale-all-cc.repl — driver for the OWNER mass deb-unstale
;; (CCp_UnstaleAll). Loads the IDENTICAL fixture chain as deb-staleness-inject-cc.repl
;; (through [6.4]_AQP-EXHAUSTIVE-COLLECT.repl, which stands up SubsidiaryTreasury +
;; ANHD's deb-based stake), then exercises the owner-run mass-unstale: the FVT owner
;; force-refreshes every stale present staker to make the entity injection-ready,
;; WITHOUT injecting (the inject's fix-phase decoupled, still penalized).
;;
;; SEPARATE DRIVER: like deb-staleness-inject-cc.repl / deb-staleness-proof.repl, this test
;; moves ANHD's Elite-DEB DOWN from the same starting deb, so it must run in its own pact
;; process (deep deb-state mutation cannot be linearly composed with the other drivers).
;;
(print "")
(print "================================================================")
(print "FILE  REPL/deb-staleness-unstale-all-cc.repl  —  owner mass-unstale (CCp_UnstaleAll)")
(print "================================================================")
(load "Stage00_Sanboxes.repl")
(load "Stage01_Tester.repl")
(load "Stage_02/[0.1]_Interfaces.repl")
(load "Stage_02/[2.1]_DpdcCore.repl")
(load "Stage_02/[2.2]_DemiPad.repl")
(load "Stage_02/[2.3]_EarningPools.repl")
(load "Stage_02/[3]_Talos.repl")
(load "Stage_02/[4.0]_Sovereign-Executor.repl")
(load "Stage_02/[5.2]_PopulateBloodshed.repl")
(load "Stage_02/[5.1]_PopulateNosferatu.repl")
(load "Stage_02/[5.4]_PopulateBunnies.repl")
(begin-tx "TX-AQP-BOOT - AQP-BOOT module")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(namespace "ouronet-ns")
(env-sigs [{"key": "1a4e15d3c51e0b73e92644600487ba8eaae312e1a178b91801d54e13c1b350a5", "caps": []}])
(load "../2_CITIZEN/4_VaultsMinter/04_AQP-BOOT.pact")
(commit-tx)
(begin-tx "TX-AQP-BOOT - AQP-BOOT Step0 IMC + vault governor")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(namespace "ouronet-ns")
(env-sigs [{ "key": "PK_AncientHodler", "caps": [] }])
(print (format "<(AQP-BOOT|C_Step0_WireImcAndGovernor)> => \"{}\"" [(AQP-BOOT.C_Step0_WireImcAndGovernor KST.ANHD)]))
(commit-tx)
(load "Stage_02/[6.2.1]_AQP-ANK.repl")
(load "Stage_02/[6.2.2]_AQP-SCORE.repl")
(load "Stage_02/[6.2.3]_AQP-POOL.repl")
(load "Stage_02/[6.2.9]_AQP-BOOT-FULL.repl")
(load "Stage_02/[6.4]_AQP-EXHAUSTIVE-PREP.repl")
(load "Stage_02/[6.4]_AQP-EXHAUSTIVE-BOOT-POOLS.repl")
(load "Stage_02/[6.4]_AQP-EXHAUSTIVE-RPS.repl")
(load "Stage_02/[6.4]_AQP-EXHAUSTIVE-COLLECT.repl")
