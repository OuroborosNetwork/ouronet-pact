;;
;; REPL/_scratch_dpof_m11_togglemessages.repl — DALOS-audit #35M fix confirmation
;; (DPOF|C_TogglePause/C_ToggleFreezeAccount now return a format message instead of a raw
;; OutputCumulator object, matching the DPTF siblings' pattern; dead ref-TS01-A binding removed.)
;;
(load "Stage00_Sanboxes.repl")
(load "Stage_01/[0.0]_Starter.repl")
(load "Stage_01/[0.1]_Interfaces.repl")
(load "Stage_01/[1]_Utilities.repl")
(load "Stage_01/[2.1]_Dalos.repl")
(load "Stage_01/[2.2]_Core.repl")
(load "Stage_01/[3]_Talos.repl")
(load "Stage_01/[4.0]_Sovereign-Executor.repl")

(begin-tx "M11 CHECK - DPOF|C_TogglePause/C_ToggleFreezeAccount now return a real message")
(namespace "ouronet-ns")
(env-sigs
    [
        { "key": "PK_AncientHodler", "caps": [] }
        { "key": "6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263" ,
          "caps":
            [
                (coin.TRANSFER
                    "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263"
                    "k:0cb30c0121ff919266121a99ff9359871818932211df94dae4137c29bc0e8f7e"
                    10.0
                )
                (coin.TRANSFER
                    "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263"
                    "k:50d6c59b21e5e6e55baecaa75a1007de37576bde12d8230dc82459cc01b9484b"
                    10.0
                )
                (coin.TRANSFER
                    "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263"
                    "c:XM-pkmuB5XUQlp87ZYSbfKt8qzmHY6O2EHAzMRVBt3k"
                    10.0
                )
                (coin.TRANSFER
                    "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263"
                    "c:iQQFWj6gWtpGEzhM_O5ekW1QtnQQy55R8BRPGhj_0FU"
                    10.0
                )
            ]
        }
    ]
)
(let*
    (
        (ref-TS01-C1:module{TalosStageOne_ClientOneV1} TS01-C1)
        (patron:string KST.ANHD)
        (dpof-id:string
            (at 0
                (ref-TS01-C1::DPOF|C_Issue
                    patron patron
                    ["M11TestDpof"] ["M11D"] [12]
                    [true] [true] [true] [false]
                    [true] [false] [true]
                )
            )
        )
    )
    (map print
        [
            (format "DPOF|C_TogglePause => {}" [(ref-TS01-C1::DPOF|C_TogglePause patron dpof-id true)])
            (format "DPOF|C_ToggleFreezeAccount => {}" [(ref-TS01-C1::DPOF|C_ToggleFreezeAccount patron dpof-id patron true)])
        ]
    )
)
(commit-tx)
