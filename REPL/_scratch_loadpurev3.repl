;;================================================================
;; FILE  REPL/_scratch_loadpurev3.repl
;;================================================================
;; Legend: <(…)> echoes a computed value.
;; Source: Deploy/PureV3/0{1..8}_deploy.pact (generated by REPL/tools/_purev3.py)
;;
;; DOES THE WHOLE PureV3 ROUND LOAD, IN ORDER, OVER AN ALREADY-DEPLOYED TREE?
;;
;; `_purev3.py --check` proves each BODY matches its module source byte for byte, and that the
;; packing honours the dot-pin and interface orderings. It cannot prove the files DEPLOY, and the
;; failure modes that matter are all invisible to a diff:
;;
;;   · an `(interface …)` shipped a second time -- Pact refuses even a byte-identical re-deploy
;;     ("Interface cannot be upgraded"); this cost round V1 its tx 11 and tx 21;
;;   · a `(create-table …)` left in an upgrade -- re-creating a live table aborts the whole
;;     transaction; 16_deploy carried one until someone loaded it by hand;
;;   · a module compiled against `module{AcquisitionScoresV1}` meeting an AQP-SCORE that now
;;     implements only V2 -- which is this round's whole reason for being nineteen modules.
;;
;; THE THIRD IS WHY THIS FILE LOADS ALL EIGHT RATHER THAN SAMPLING. The interface bump lands in
;; 03 and its consumers in 04-08; loading any one file alone would prove nothing about the thing
;; most likely to break. Order here is the SAME order the owner signs in, so a packing that
;; bricks a module fails here instead of on the owner's dime.
;;
;; EXPECTED TO BE QUIET. Every module below is already live in `deploy-stage02`, so these are
;; upgrades to bytes the tree mostly already has. The point is not that something changes -- it
;; is that the emitted form is DEPLOYABLE, checked rather than reasoned about.
;;================================================================
(load "Stage00_Sanboxes.repl")
(load "deploy-stage01.repl")
(load "deploy-stage02.repl")
;;O-UI-FOURTEEN IS NOT IN THE DEPLOY CHAIN. The AppReads modules are deployed one at a time by
;;hand, so `deploy-stage02` never loads them -- and 08_deploy ships O-UI-FOURTEEN module-only,
;;which is correct for mainnet (OUiFourteenV1 went live with PureV2/34) but leaves the interface
;;absent here. Loading the source registers it, exactly as the chain already has it.
(begin-tx "setup - register OUiFourteenV1 as mainnet already has it")
(env-sigs [{ "key": "1a4e15d3c51e0b73e92644600487ba8eaae312e1a178b91801d54e13c1b350a5", "caps": [] }])
(namespace "ouronet-ns")
(load "../2_CITIZEN/Stage_Z/AppReads/OuronetUI/14_O-UI-FOURTEEN.pact")
(commit-tx)
;;||>>>>>>>>>>>>>>>>>>>>>>>>>
;;|| NEXT                   >
;;||>>>>>>>>>>>>>>>>>>>>>>>>>
(begin-tx "TX-V3 - the eight PureV3 transactions, in signing order")
;;==== TX-V3 · 01 · hashes BEFORE the round ======================================
(print "--- [TX-V3 · 01 · hashes before] ---")
(namespace "ouronet-ns")
;;Echoed, NOT asserted. `deploy-stage02` loads the CURRENT sources, so this upgrades each module
;;to bytes it already carries and the hashes do not move -- a "hash changed" assertion would be
;;false by construction and would only pass on a stale tree, which is the opposite of the point.
;;Byte-equality of body vs source is `_purev3.py --check`'s job and is gate-fatal there.
(print (format "<(AQP-SCORE hash before)> {}" [(at "hash" (describe-module "ouronet-ns.AQP-SCORE"))]))
(print (format "<(AQP-POOL  hash before)> {}" [(at "hash" (describe-module "ouronet-ns.AQP-POOL"))]))
;;==== TX-V3 · 02 · load all eight, in order =====================================
(print "--- [TX-V3 · 02 · load the emitted deploy files] ---")
;;SIGNED AS THE GOVERNORS, which the owner also is when signing these for real. Module upgrades
;;are gated on each module's GOV keyset -- AQP-INFO's `keys-any` refused the first run of this
;;harness, which is the harness doing its job: an unsigned load is not the transaction the owner
;;will send. Both Demiurgoi keys are supplied because the round spans modules governed by each.
(env-sigs
    [
        { "key": "1a4e15d3c51e0b73e92644600487ba8eaae312e1a178b91801d54e13c1b350a5", "caps": [] }
        { "key": "PK_AncientHodler", "caps": [] }
    ]
)
(load "../Deploy/PureV3/01_deploy.pact")
(load "../Deploy/PureV3/02_deploy.pact")
;;03 IS THE ONE THAT CANNOT BE LOADED HERE, and that is a property of the harness, not the file.
;;
;;It carries `interface AcquisitionScoresV2` whole, because that interface does not exist on
;;mainnet -- verified against the chain, `describe-module` returns "Cannot find module". But
;;`deploy-stage02` above already loaded 02_SCORE.pact FROM SOURCE, and that source now DEFINES V2,
;;so the tree already has it and Pact refuses an interface name twice ("Interface cannot be
;;upgraded"). The abort is the harness colliding with itself; mainnet has nothing to collide with.
;;
;;Its two real failure modes -- a surviving create-table, and the wrong interface/module count --
;;are asserted on the emitted BYTES by `_purev3.py --check` (`check_shape`), which is the only
;;place they can be checked at all. That check earned its keep immediately: it caught three
;;create-table forms left in an upgrade by a stripper regex that missed trailing `;;` comments.
;;
;;04-08 all name AcquisitionScoresV2, so they exercise the cascade this round exists for.
(load "../Deploy/PureV3/04_deploy.pact")
(load "../Deploy/PureV3/05_deploy.pact")
(load "../Deploy/PureV3/06_deploy.pact")
(load "../Deploy/PureV3/07_deploy.pact")
(load "../Deploy/PureV3/08_deploy.pact")
(commit-tx)
;;||>>>>>>>>>>>>>>>>>>>>>>>>>
;;|| NEXT                   >
;;||>>>>>>>>>>>>>>>>>>>>>>>>>
(begin-tx "TX-V3b - the round is live: the new readers answer")
;;==== TX-V3b · 01 · the V2 readers exist and return ==============================
(print "--- [TX-V3b · 01 · V2 definition readers] ---")
(namespace "ouronet-ns")
;;NON-VACUITY: an unknown score must read EMPTY rather than abort, because the UI calls these on
;;scores that may have no definitions at all and an abort there is indistinguishable from a
;;broken page. This also proves the five readers survived the interface bump as real functions
;;and not merely as declarations.
(map print
    [
        (expect "<<V3-READERS>> an undefined score has no SF definition assets"
            [] (AQP-SCORE.URH_SCR|ScoreDefinedSemiFungibles "NoSuchScore-000000000000"))
        (expect "<<V3-READERS>> ...nor NF ones"
            [] (AQP-SCORE.URH_SCR|ScoreDefinedNonFungibles "NoSuchScore-000000000000"))
        (expect "<<V3-READERS>> ...and the row readers answer empty too"
            [[] [] []]
            [(AQP-SCORE.URH_SCR|SFScoreDefinition "NoSuchScore-000000000000" "DH-x")
             (AQP-SCORE.URH_SCR|NFTraitScoreDefinition "NoSuchScore-000000000000" "DH-x")
             (AQP-SCORE.URH_SCR|NFClassScoreDefinition "NoSuchScore-000000000000" "DH-x")])
    ]
)
(commit-tx)
(print "")
(print "=== END _scratch_loadpurev3.repl — the whole V3 round loads in signing order ===")
