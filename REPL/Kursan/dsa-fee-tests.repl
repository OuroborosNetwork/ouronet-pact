;;
;; REPL/Kursan/dsa-fee-tests.repl — DSA Phase 5b: the operator fee (two-track, applied at inject).
;; Proves the fee split on a MULTI-delegator agency: operator own = 1000, delegators EMMA + LUMY = 2000 each
;; (W=5000, D=4000), fee = 10%. Inject 5000 OURO => the member index advances at (1−fee) so every staker accrues
;; net, and the whole fee slice is credited DIRECT to the operator =>
;;   operator collects 1400  (own 1000x0.9 = 900 via index  +  fee 500 direct)   = R·(own+fee·D)/W
;;   EMMA/LUMY collect 1800 each  (2000x0.9)                                      = R·d·(1−fee)/W
;; The operator collects its share INDEPENDENTLY (first, before any delegator). A mid-stream A_SetAgencyFee to
;; 20% reprices ONLY the next inject (O(1), no per-delegator recompute): operator 1800, delegators 1600 each.
;; Source: 04_FVT.pact XI_1|FarmSplitInject (fee split) + FVT|AgencyFee + 07_DSA.pact A_SetAgencyFee.
;;
(print "")
(print "================================================================")
(print "FILE  REPL/Kursan/dsa-fee-tests.repl  —  DSA operator fee (two-track) (Phase 5b)")
(print "================================================================")
(load "../Stage00_Sanboxes.repl")
(load "../Stage01_Tester.repl")
(load "../Stage_02/[0.1]_Interfaces.repl")
(load "../Stage_02/[2.1]_DpdcCore.repl")
(load "../Stage_02/[2.2]_DemiPad.repl")
(load "../Stage_02/[2.3]_EarningPools.repl")
(load "../Stage_02/[3]_Talos.repl")
(load "../Stage_02/[4.0]_Sovereign-Executor.repl")
(begin-tx "FEE-BOOT - KBN citizen")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(namespace "ouronet-ns")
(env-sigs [{ "key": "1a4e15d3c51e0b73e92644600487ba8eaae312e1a178b91801d54e13c1b350a5", "caps": [] }])
(load "../../2_CITIZEN/4_BunniesMinter/02_KBunnies.pact")
(commit-tx)
(begin-tx "FEE-BOOT - AQP-BOOT")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(namespace "ouronet-ns")
(env-sigs [{ "key": "1a4e15d3c51e0b73e92644600487ba8eaae312e1a178b91801d54e13c1b350a5", "caps": [] }])
(load "../../2_CITIZEN/5_VaultsMinter/04_AQP-BOOT.pact")
(commit-tx)
(begin-tx "FEE-BOOT - Step0")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(namespace "ouronet-ns")
(env-sigs [{ "key": "PK_AncientHodler", "caps": [] }])
(AQP-BOOT.C_Step0_WireImcAndGovernor KST.ANHD)
(commit-tx)
(print "")

;; env-sigs helper reused: PK_AncientHodler + the gas-station 4x coin.TRANSFER block.
;; ============================================================================
;; FEE-01 — fragment 500 silver DHOC -> -2 frags; distribute 200k to EMMA + 200k to LUMY (ANHD keeps 100k)
;; ============================================================================
(begin-tx "FEE-01 - fragment + distribute silver to delegators")
(namespace "ouronet-ns")
(env-gasmodel "table")(env-gaslimit 60000000)(env-gas 0)
(env-chain-data { "block-time": (time "2027-11-01T00:00:00Z") })
(env-sigs
  [ { "key": "PK_AncientHodler", "caps": [] }
    { "key": "6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263"
    , "caps":
      [ (coin.TRANSFER "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263" "k:50d6c59b21e5e6e55baecaa75a1007de37576bde12d8230dc82459cc01b9484b" 1000000.0)
        (coin.TRANSFER "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263" "k:0cb30c0121ff919266121a99ff9359871818932211df94dae4137c29bc0e8f7e" 1000000.0)
        (coin.TRANSFER "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263" "c:XM-pkmuB5XUQlp87ZYSbfKt8qzmHY6O2EHAzMRVBt3k" 1000000.0)
        (coin.TRANSFER "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263" "c:iQQFWj6gWtpGEzhM_O5ekW1QtnQQy55R8BRPGhj_0FU" 1000000.0) ] } ])
(print "--- [FEE-01 · 01 · fragment + distribute] ---")
(let
    (
        (anhd:string KST.ANHD)
        (emma:string KST.EMMA)
        (lumy:string KST.LUMY)
        (dhoc:string "DHOC-98c486052a51")
        (ref-DPDC:module{DpdcV2} DPDC)
        (ref-TS02-C1:module{TalosStageTwo_ClientOneV2} TS02-C1)
    )
    ;; 500 silver wholes -> 500000 fragment nonces (-2); each 1000-frag block = 10 quintessence when staked
    (ref-TS02-C1::C_DPSF|MakeFragments anhd anhd dhoc 2 500)
    ;; hand 200k to EMMA + 200k to LUMY (=> 2000 quintessence each); ANHD keeps 100k (=> 1000)
    (ref-TS02-C1::C_DPSF|TransferNonce anhd dhoc anhd emma -2 200000 false)
    (ref-TS02-C1::C_DPSF|TransferNonce anhd dhoc anhd lumy -2 200000 false)
    (map print
      [ (expect "<<FEE-01>> ANHD keeps 100000 frag -2" 100000 (ref-DPDC::UR_AccountNonceSupply anhd dhoc true -2))
        (expect "<<FEE-01>> EMMA holds 200000 frag -2" 200000 (ref-DPDC::UR_AccountNonceSupply emma dhoc true -2))
        (expect "<<FEE-01>> LUMY holds 200000 frag -2" 200000 (ref-DPDC::UR_AccountNonceSupply lumy dhoc true -2)) ]))
(env-sigs [])
(commit-tx)
(print "")
;;
;;|| NEXT >
;;|| Model + operator triplet + reward-linked class-0 vault + pool employing the 3 sub-scores.
;;
(begin-tx "FEE-02 - model + triplet + vault + pool")
(namespace "ouronet-ns")
(env-gasmodel "table")(env-gaslimit 60000000)(env-gas 0)
(env-chain-data { "block-time": (time "2027-11-01T00:00:00Z") })
(env-sigs
  [ { "key": "PK_AncientHodler", "caps": [] }
    { "key": "6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263"
    , "caps":
      [ (coin.TRANSFER "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263" "k:50d6c59b21e5e6e55baecaa75a1007de37576bde12d8230dc82459cc01b9484b" 1000000.0)
        (coin.TRANSFER "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263" "k:0cb30c0121ff919266121a99ff9359871818932211df94dae4137c29bc0e8f7e" 1000000.0)
        (coin.TRANSFER "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263" "c:XM-pkmuB5XUQlp87ZYSbfKt8qzmHY6O2EHAzMRVBt3k" 1000000.0)
        (coin.TRANSFER "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263" "c:iQQFWj6gWtpGEzhM_O5ekW1QtnQQy55R8BRPGhj_0FU" 1000000.0) ] } ])
(print "--- [FEE-02 · 01 · model + triplet + vault + pool] ---")
(let
    (
        (anhd:string KST.ANHD)
        (dhoc:string "DHOC-98c486052a51")
        (ouro:string "OURO-98c486052a51")
        (ref-U|CT:module{OuronetConstantsV2} U|CT)
        (ref-U|DALOS:module{UtilityDalosV2} U|DALOS)
        (ref-TS02-C3:module{TalosStageTwo_ClientThreeV2} TS02-C3)
    )
    (let
        (
            (bmid:string (ref-U|DALOS::UDC_Makeid "FeeBronzeModel"))
            (smid:string (ref-U|DALOS::UDC_Makeid "FeeSilverModel"))
            (gmid:string (ref-U|DALOS::UDC_Makeid "FeeGoldModel"))
            (model-id:string (ref-U|DALOS::UDC_Makeid "FeeTripletModel"))
            (fvt-id:string   (ref-U|DALOS::UDC_Makeid "FeeVault"))
            (pool-id:string  (ref-U|DALOS::UDC_Makeid "FeePool"))
            (bsid:string (ref-U|DALOS::UDC_Makeid (concat ["FeeAgency" "Bronze"])))
            (ssid:string (ref-U|DALOS::UDC_Makeid (concat ["FeeAgency" "Silver"])))
            (gsid:string (ref-U|DALOS::UDC_Makeid (concat ["FeeAgency" "Golden"])))
        )
        (ref-TS02-C3::C_AQP-SCR|IssueSingleScoreModel anhd "FeeBronzeModel" 3 dhoc 24 [-1] [1.0])
        (ref-TS02-C3::C_AQP-SCR|IssueSingleScoreModel anhd "FeeSilverModel" 3 dhoc 24 [-2] [10.0])
        (ref-TS02-C3::C_AQP-SCR|IssueSingleScoreModel anhd "FeeGoldModel"   3 dhoc 24 [-3] [100.0])
        (ref-TS02-C3::C_AQP-SCR|CombineTripletScoreModel anhd "FeeTripletModel" bmid smid gmid)
        (ref-TS02-C3::C_AQP-SCR|IssueScoreFromModel anhd anhd model-id "FeeAgency")
        (ref-TS02-C3::C_AQP-FVT|Issue anhd "FeeVault" anhd 0 ouro)
        (ref-TS02-C3::C_AQP-FVT|AddRewardLink anhd fvt-id ouro false (ref-U|CT::CT_BAR))
        (ref-TS02-C3::A_AQP-DSA|DefineDelegationVault anhd fvt-id model-id 2000)
        (ref-TS02-C3::C_AQP-POOL|Issue anhd "FeePool" dhoc 3)
        (ref-TS02-C3::C_AQP-POOL|AddScore anhd pool-id bsid)
        (ref-TS02-C3::C_AQP-POOL|AddScore anhd pool-id ssid)
        (ref-TS02-C3::C_AQP-POOL|AddScore anhd pool-id gsid)
        (print (format "<(setup)> => vault {} pool {}" [fvt-id pool-id]))
        ""
    )
)
(env-sigs [])
(commit-tx)
(print "")
