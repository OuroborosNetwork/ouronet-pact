;;
;; REPL/Kursan/dsa-fee-tests.repl — DSA Phase 5b: the operator fee (two-track, applied at inject).
;; Proves the fee split on a MULTI-delegator agency: operator own = 1000, delegators EMMA + LUMY = 2000 each
;; (W=5000, D=4000), fee = 10%. Inject 5000 OURO => the member index advances at (1−fee) so every staker accrues
;; net, and the whole fee slice is credited DIRECT to the operator =>
;;   operator collects 1400  (own 1000x0.9 = 900 via index  +  fee 500 direct)   = R·(own+fee·D)/W
;;   EMMA/LUMY collect 1800 each  (2000x0.9)                                      = R·d·(1−fee)/W
;; The operator collects its share INDEPENDENTLY (first, before any delegator). A mid-stream C_SetAgencyFee to
;; 20% reprices ONLY the next inject (O(1), no per-delegator recompute): operator 1800, delegators 1600 each.
;; Source: 05_FVT.pact XI_1|FarmSplitInject (fee split) + FVT|AgencyFee + 08_DSA.pact C_SetAgencyFee.
;;
(print "")
(print "================================================================")
(print "FILE  REPL/Kursan/dsa-fee-tests.repl  —  DSA operator fee (two-track) (Phase 5b)")
(print "================================================================")
(load "../Stage00_Sanboxes.repl")
(load "../Stage01_Tester.repl")
(load "../Stage_02/[0.1]_Interfaces.repl")
(load "../Stage_02/[2.1]_DpdcCore.repl")
(load "../Stage_02/[2.2]_DemiPad.repl")
(load "../Stage_02/[2.3]_EarningPools.repl")
(load "../Stage_02/[3]_Talos.repl")
(load "../Stage_02/[4.0]_Sovereign-Executor.repl")
(begin-tx "FEE-BOOT - KBN citizen")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(namespace "ouronet-ns")
;;==== FEE-BOOT - KBN citizen · 01 · env-sigs (caps) ==== =========================================
(print "--- [FEE-BOOT - KBN citizen · 01 · env-sigs (caps)] ---")
(env-sigs [{ "key": "1a4e15d3c51e0b73e92644600487ba8eaae312e1a178b91801d54e13c1b350a5", "caps": [] }])
;;==== FEE-BOOT - KBN citizen · 02 · load module ==== =============================================
(print "--- [FEE-BOOT - KBN citizen · 02 · load module] ---")
(load "../../2_CITIZEN/4_BunniesMinter/02_KBunnies.pact")
(commit-tx)
;;||>>>>>>>>>>>>>>>>>>>>>>>>>
;;|| NEXT                   >
;;||>>>>>>>>>>>>>>>>>>>>>>>>>
(print "")
(print "")
(begin-tx "FEE-BOOT - AQP-BOOT")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(namespace "ouronet-ns")
;;==== FEE-BOOT - AQP-BOOT · 01 · env-sigs (caps) ==== ============================================
(print "--- [FEE-BOOT - AQP-BOOT · 01 · env-sigs (caps)] ---")
(env-sigs [{ "key": "1a4e15d3c51e0b73e92644600487ba8eaae312e1a178b91801d54e13c1b350a5", "caps": [] }])
;;==== FEE-BOOT - AQP-BOOT · 02 · load module ==== ================================================
(print "--- [FEE-BOOT - AQP-BOOT · 02 · load module] ---")
(load "../../2_CITIZEN/5_VaultsMinter/04_AQP-BOOT.pact")
(commit-tx)
;;||>>>>>>>>>>>>>>>>>>>>>>>>>
;;|| NEXT                   >
;;||>>>>>>>>>>>>>>>>>>>>>>>>>
(print "")
;;AQP-INFO is loaded HERE so the cost block below can name it. This runner is self-booting and builds
;;Stage 02 by hand — it never reaches `Stage_02/[Z]_Reads.repl`, which is the only other loader of the
;;preview module. The DSA family's fixtures exist ONLY in these `Kursan/dsa-*.repl` runners, and none
;;of them loaded the reader, which is why all three `INFO_AQP-DSA|*` previews sat unmeasured while the
;;reachability report counted them as covered. (The launchpad gate failure taught the general rule:
;;a shared suite file may only name what its narrowest loader provides — here the fix belongs in the
;;runner, not in a shared file.)
(begin-tx "AQP-INFO - load module for the DSA cost blocks")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(namespace "ouronet-ns")
;;==== AQP-INFO - load module for the DSA cost blocks · 01 · env-sigs (caps) ==== =================
(print "--- [AQP-INFO - load module for the DSA cost blocks · 01 · env-sigs (caps)] ---")
(env-sigs [{ "key": "1a4e15d3c51e0b73e92644600487ba8eaae312e1a178b91801d54e13c1b350a5", "caps": [] }])
;;==== AQP-INFO - load module for the DSA cost blocks · 02 · load module ==== =====================
(print "--- [AQP-INFO - load module for the DSA cost blocks · 02 · load module] ---")
(load "../../1_SOVEREIGN/STAGE_02/2_Core/03_AQP/09_AQP-INFO.pact")
(commit-tx)
;;||>>>>>>>>>>>>>>>>>>>>>>>>>
;;|| NEXT                   >
;;||>>>>>>>>>>>>>>>>>>>>>>>>>
(print "")
(print "")
