;;
;;|| NEXT >
;;|| Delegators EMMA + LUMY each stake 2000 into the operator's agency (Q -> 5000). Then oracle nodes/uptime.
;;
(begin-tx "FEE-04 - delegators stake + oracle")
(namespace "ouronet-ns")
(env-gasmodel "table")(env-gaslimit 120000000)(env-gas 0)
(env-chain-data { "block-time": (time "2027-11-01T02:00:00Z") })
(env-data { "dsa-oracle": { "keys": ["dsa-oracle-key"], "pred": "keys-all" } })
;;==== FEE-04 - delegators stake + oracle · 01 · env-sigs (caps) ==== =============================
(print "--- [FEE-04 - delegators stake + oracle · 01 · env-sigs (caps)] ---")
(env-sigs
  [ { "key": "PK_AncientHodler", "caps": [] }
    { "key": "PK_Emma", "caps": [] }
    { "key": "PK_Lumy", "caps": [] }
    { "key": "dsa-oracle-key", "caps": [] }
    { "key": "6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263"
    , "caps":
      [ (coin.TRANSFER "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263" "k:50d6c59b21e5e6e55baecaa75a1007de37576bde12d8230dc82459cc01b9484b" 1000000.0)
        (coin.TRANSFER "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263" "k:0cb30c0121ff919266121a99ff9359871818932211df94dae4137c29bc0e8f7e" 1000000.0)
        (coin.TRANSFER "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263" "c:XM-pkmuB5XUQlp87ZYSbfKt8qzmHY6O2EHAzMRVBt3k" 1000000.0)
        (coin.TRANSFER "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263" "c:iQQFWj6gWtpGEzhM_O5ekW1QtnQQy55R8BRPGhj_0FU" 1000000.0) ] } ])
(print "--- [FEE-04 · 01 · delegators stake + oracle] ---")
;;==== FEE-04 - delegators stake + oracle · 02 · let / invocation ==== ============================
(print "--- [FEE-04 - delegators stake + oracle · 02 · let / invocation] ---")
(let
    (
        (anhd:string KST.ANHD)
        (emma:string KST.EMMA)
        (lumy:string KST.LUMY)
        (dhoc:string "DHOC-98c486052a51")
        (ref-U|DALOS:module{UtilityDalosV2} U|DALOS)
        (ref-SCR:module{AcquisitionScoresV1} AQP-SCORE)
        (ref-TS02-C3:module{TalosStageTwo_ClientThreeV1} TS02-C3)
    )
    (let
        (
            (fvt-id:string  (ref-U|DALOS::UDC_Makeid "FeeVault"))
            (pool-id:string (ref-U|DALOS::UDC_Makeid "FeePool"))
            (bsid:string (ref-U|DALOS::UDC_Makeid (concat ["FeeAgency" "Bronze"])))
            (ssid:string (ref-U|DALOS::UDC_Makeid (concat ["FeeAgency" "Silver"])))
            (gsid:string (ref-U|DALOS::UDC_Makeid (concat ["FeeAgency" "Golden"])))
        )
        (let ((triplet-id:string (ref-SCR::UC_ComputeTripletId bsid ssid gsid)))
            ;; each delegator stakes their -2 supply (200k => 2000 quintessence) into the operator's pool
            (ref-TS02-C3::AQP-POOL|CC_StakeSemiFungibleCollectable emma pool-id emma emma dhoc [-2])
            (ref-TS02-C3::AQP-POOL|CC_StakeSemiFungibleCollectable lumy pool-id lumy lumy dhoc [-2])
            ;; owner authorizes the oracle key, then oracle: 10 nodes at FULL uptime => capture-units =
            ;; min(5000/2000,10)=2, weight 2 (no royalty shortfall)
            (ref-TS02-C3::AQP-DSA|C_SetOracleAuth anhd anhd fvt-id (read-keyset "dsa-oracle"))
            ;;FUNCTION COVERAGE (G6) — `INFO_AQP-DSA|OracleWrite`, per the owner's spec: an INFO_ must
            ;;report the same cost the op actually charges. Template: `modules/ATS.repl <<ATS-I1>>`.
            ;;The DSA fixtures live nowhere else — `[6.5.1]_AQP-INFO-GROUNDTRUTH.repl` has the reader but
            ;;no DSA state, and these runners have the state but had no reader until the load above.
            (let
                (
                    (predicted:decimal
                        (at "ignis-need" (at "ignis"
                            (AQP-INFO.INFO_AQP-DSA|OracleWrite anhd fvt-id triplet-id 10 1000))))
                    (pre-gas:decimal (DPTF.UR_AccountSupply "GAS-98c486052a51" anhd))
                )
            (ref-TS02-C3::AQP-DSA|C_OracleWrite anhd fvt-id triplet-id 10 1000)
            (map print
              [ (format "<<FEE-04>> INFO_AQP-DSA|OracleWrite predicted={} real={}"
                    [predicted (- pre-gas (DPTF.UR_AccountSupply "GAS-98c486052a51" anhd))])
                (expect "<<FEE-04>> INFO_AQP-DSA|OracleWrite's quote equals what the write charged"
                    (- pre-gas (DPTF.UR_AccountSupply "GAS-98c486052a51" anhd)) predicted)
                (expect "<<FEE-04>> ...and it is a real, non-zero charge"
                    true (> (- pre-gas (DPTF.UR_AccountSupply "GAS-98c486052a51" anhd)) 0.0))
                (expect "<<FEE-04>> agency Q = 5000 (1000 op + 2000 + 2000)" 5000.0 (AQP-DSA.URC_AgencyQuintessence triplet-id))
                (expect "<<FEE-04>> capture-units 2" 2.0 (AQP-FVT.UR_FVT-SEL|CaptureUnits fvt-id triplet-id))
                (expect "<<FEE-04>> capture-weight 2 (full uptime)" 2.0 (AQP-FVT.UR_FVT-SEL|CaptureWeight fvt-id triplet-id)) ])))
    )
)
(env-sigs [])
(commit-tx)
(print "")
;;
;;|| NEXT >
;;|| Inject 5000 OURO. member-slice = 5000 (full uptime). Then collect — OPERATOR FIRST (independent of delegators).
;;
(begin-tx "FEE-05 - inject 5000 + collect all (fee 10%)")
(namespace "ouronet-ns")
(env-gasmodel "table")(env-gaslimit 120000000)(env-gas 0)
(env-chain-data { "block-time": (time "2027-11-01T03:00:00Z") })
;;==== FEE-05 - inject 5000 + collect all (fee 10%) · 01 · env-sigs (caps) ==== ===================
(print "--- [FEE-05 - inject 5000 + collect all (fee 10%) · 01 · env-sigs (caps)] ---")
(env-sigs
  [ { "key": "PK_AncientHodler", "caps": [] }
    { "key": "PK_Emma", "caps": [] }
    { "key": "PK_Lumy", "caps": [] }
    { "key": "6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263"
    , "caps":
      [ (coin.TRANSFER "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263" "k:50d6c59b21e5e6e55baecaa75a1007de37576bde12d8230dc82459cc01b9484b" 1000000.0)
        (coin.TRANSFER "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263" "k:0cb30c0121ff919266121a99ff9359871818932211df94dae4137c29bc0e8f7e" 1000000.0)
        (coin.TRANSFER "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263" "c:XM-pkmuB5XUQlp87ZYSbfKt8qzmHY6O2EHAzMRVBt3k" 1000000.0)
        (coin.TRANSFER "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263" "c:iQQFWj6gWtpGEzhM_O5ekW1QtnQQy55R8BRPGhj_0FU" 1000000.0) ] } ])
(print "--- [FEE-05 · 01 · inject + collect] ---")
;;==== FEE-05 - inject 5000 + collect all (fee 10%) · 02 · let / invocation ==== ==================
(print "--- [FEE-05 - inject 5000 + collect all (fee 10%) · 02 · let / invocation] ---")
(let
    (
        (anhd:string KST.ANHD)
        (emma:string KST.EMMA)
        (lumy:string KST.LUMY)
        (ouro:string "OURO-98c486052a51")
        (ref-U|DALOS:module{UtilityDalosV2} U|DALOS)
        (ref-SCR:module{AcquisitionScoresV1} AQP-SCORE)
        (ref-DPTF:module{DemiourgosPactTrueFungibleV2} DPTF)
        (ref-TS02-C3:module{TalosStageTwo_ClientThreeV1} TS02-C3)
    )
    (let
        (
            (fvt-id:string  (ref-U|DALOS::UDC_Makeid "FeeVault"))
            (bsid:string (ref-U|DALOS::UDC_Makeid (concat ["FeeAgency" "Bronze"])))
            (ssid:string (ref-U|DALOS::UDC_Makeid (concat ["FeeAgency" "Silver"])))
            (gsid:string (ref-U|DALOS::UDC_Makeid (concat ["FeeAgency" "Golden"])))
        )
        (let ((triplet-id:string (ref-SCR::UC_ComputeTripletId bsid ssid gsid)))
            (ref-TS02-C3::AQP-FVT|CC_Inject anhd anhd fvt-id ouro 5000.0)
            ;; OPERATOR COLLECTS FIRST — independent of delegators
            (let ((op-before:decimal (ref-DPTF::UR_AccountSupply ouro anhd)))
                (ref-TS02-C3::AQP-FVT|CC_Collect anhd anhd fvt-id 3 triplet-id ouro)
                (let
                    (
                        (op-got:decimal (- (ref-DPTF::UR_AccountSupply ouro anhd) op-before))
                        (em-before:decimal (ref-DPTF::UR_AccountSupply ouro emma))
                    )
                    (ref-TS02-C3::AQP-FVT|CC_Collect emma emma fvt-id 3 triplet-id ouro)
                    (let
                        (
                            (em-got:decimal (- (ref-DPTF::UR_AccountSupply ouro emma) em-before))
                            (lu-before:decimal (ref-DPTF::UR_AccountSupply ouro lumy))
                        )
                        ;;<<FEE-05-SPONSOR>> A SPONSORED COLLECT: ANHD is the patron (pays the
                        ;;IGNIS), LUMY is the collector (receives the rewards). Every other collect
                        ;;in this file passes the same account twice, which is what the Band 3
                        ;;migration produced and which proves only that nothing broke.
                        ;;
                        ;;This line is the one that proves the separation WORKS, and it doubles as
                        ;;the regression test for the bug Band 3 briefly shipped: the payout was
                        ;;computed from `patron` while being paid to `collector`, so LUMY would have
                        ;;been credited ANHD's claimable amount. The 1800 assertion below is the
                        ;;detector -- under that bug it fails, and under a correct implementation it
                        ;;is unchanged from when LUMY paid for herself.
                        (ref-TS02-C3::AQP-FVT|CC_Collect anhd lumy fvt-id 3 triplet-id ouro)
                        (let ((lu-got:decimal (- (ref-DPTF::UR_AccountSupply ouro lumy) lu-before)))
                            (print (format "<(operator / emma / lumy)> => {} / {} / {}" [op-got em-got lu-got]))
                            (map print
                              [ (expect "<<FEE-05>> operator collected 1400 (own 900 net + fee 500), INDEPENDENT" 1400.0 op-got)
                                (expect "<<FEE-05>> EMMA collected 1800 (2000 net of 10%)" 1800.0 em-got)
                                (expect "<<FEE-05>> LUMY collected 1800" 1800.0 lu-got)
                                ;;The other half of the sponsorship: ANHD paid the gas and must NOT
                                ;;have been credited anything for it. `op-got` was measured before
                                ;;LUMY's collect, so if the payout had gone to the patron this would
                                ;;have moved.
                                (expect "<<FEE-05-SPONSOR>> ...and ANHD, the PATRON, gained nothing from sponsoring it"
                                    1400.0 (- (ref-DPTF::UR_AccountSupply ouro anhd) op-before))
                                (expect "<<FEE-05>> conservation: op+emma+lumy = 5000" 5000.0 (+ op-got (+ em-got lu-got))) ])))))
        )
    )
)
(env-sigs [])
(commit-tx)
(print "")
;;
;;|| NEXT >
;;|| Mid-stream fee change to 20% (C_SetAgencyFee) — reprices ONLY the next inject (O(1), no per-delegator touch):
;;|| operator 1800 (own 800 net + fee 1000), delegators 1600 each.
;;
(begin-tx "FEE-06 - fee -> 20%, inject, collect (reprice future only)")
(namespace "ouronet-ns")
(env-gasmodel "table")(env-gaslimit 120000000)(env-gas 0)
(env-chain-data { "block-time": (time "2027-11-01T04:00:00Z") })
;;==== FEE-06 - fee -> 20%, inject, collect (reprice future only) · 01 · env-sigs (caps) ==== =====
(print "--- [FEE-06 - fee -> 20%, inject, collect (reprice future only) · 01 · env-sigs (caps)] ---")
(env-sigs
  [ { "key": "PK_AncientHodler", "caps": [] }
    { "key": "PK_Emma", "caps": [] }
    { "key": "PK_Lumy", "caps": [] }
    { "key": "6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263"
    , "caps":
      [ (coin.TRANSFER "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263" "k:50d6c59b21e5e6e55baecaa75a1007de37576bde12d8230dc82459cc01b9484b" 1000000.0)
        (coin.TRANSFER "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263" "k:0cb30c0121ff919266121a99ff9359871818932211df94dae4137c29bc0e8f7e" 1000000.0)
        (coin.TRANSFER "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263" "c:XM-pkmuB5XUQlp87ZYSbfKt8qzmHY6O2EHAzMRVBt3k" 1000000.0)
        (coin.TRANSFER "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263" "c:iQQFWj6gWtpGEzhM_O5ekW1QtnQQy55R8BRPGhj_0FU" 1000000.0) ] } ])
(print "--- [FEE-06 · 01 · fee change + inject + collect] ---")
;;==== FEE-06 - fee -> 20%, inject, collect (reprice future only) · 02 · let / invocation ==== ====
(print "--- [FEE-06 - fee -> 20%, inject, collect (reprice future only) · 02 · let / invocation] ---")
(let
    (
        (anhd:string KST.ANHD)
        (emma:string KST.EMMA)
        (lumy:string KST.LUMY)
        (ouro:string "OURO-98c486052a51")
        (ref-U|DALOS:module{UtilityDalosV2} U|DALOS)
        (ref-SCR:module{AcquisitionScoresV1} AQP-SCORE)
        (ref-DPTF:module{DemiourgosPactTrueFungibleV2} DPTF)
        (ref-TS02-C3:module{TalosStageTwo_ClientThreeV1} TS02-C3)
    )
    (let
        (
            (fvt-id:string  (ref-U|DALOS::UDC_Makeid "FeeVault"))
            (bsid:string (ref-U|DALOS::UDC_Makeid (concat ["FeeAgency" "Bronze"])))
            (ssid:string (ref-U|DALOS::UDC_Makeid (concat ["FeeAgency" "Silver"])))
            (gsid:string (ref-U|DALOS::UDC_Makeid (concat ["FeeAgency" "Golden"])))
        )
        (let ((triplet-id:string (ref-SCR::UC_ComputeTripletId bsid ssid gsid)))
            ;; O(1) fee change — reprices only the next inject
            (ref-TS02-C3::AQP-DSA|C_SetAgencyFee anhd anhd fvt-id triplet-id 200)
            (ref-TS02-C3::AQP-FVT|CC_Inject anhd anhd fvt-id ouro 5000.0)
            (let ((op-before:decimal (ref-DPTF::UR_AccountSupply ouro anhd)))
                (ref-TS02-C3::AQP-FVT|CC_Collect anhd anhd fvt-id 3 triplet-id ouro)
                (let
                    (
                        (op-got:decimal (- (ref-DPTF::UR_AccountSupply ouro anhd) op-before))
                        (em-before:decimal (ref-DPTF::UR_AccountSupply ouro emma))
                    )
                    (ref-TS02-C3::AQP-FVT|CC_Collect emma emma fvt-id 3 triplet-id ouro)
                    (let
                        (
                            (em-got:decimal (- (ref-DPTF::UR_AccountSupply ouro emma) em-before))
                            (lu-before:decimal (ref-DPTF::UR_AccountSupply ouro lumy))
                        )
                        (ref-TS02-C3::AQP-FVT|CC_Collect lumy lumy fvt-id 3 triplet-id ouro)
                        (let ((lu-got:decimal (- (ref-DPTF::UR_AccountSupply ouro lumy) lu-before)))
                            (print (format "<(20%% op / emma / lumy)> => {} / {} / {}" [op-got em-got lu-got]))
                            (map print
                              [ (expect "<<FEE-06>> operator collected 1800 (own 800 net + fee 1000) at 20%" 1800.0 op-got)
                                (expect "<<FEE-06>> EMMA collected 1600 (2000 net of 20%)" 1600.0 em-got)
                                (expect "<<FEE-06>> LUMY collected 1600" 1600.0 lu-got)
                                (expect "<<FEE-06>> conservation: op+emma+lumy = 5000" 5000.0 (+ op-got (+ em-got lu-got))) ])))))
        )
    )
)
(env-sigs [])
(commit-tx)
(print "")
(print "=== dsa-fee-tests END — operator two-track fee: 25k/95k split + independent collect + O(1) fee change ===")
