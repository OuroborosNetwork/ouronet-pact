;; CLAIM UNDER TEST — TS01-C2's ORBR|C_WithdrawFees @doc: "Only the Token Owner can withdraw these
;; fees." A security claim that was structurally TRUE and entirely UNTESTED.
;;
;; FOUND BY `python3 tools/_docclaims.py`, which audits @doc text for RULES nothing pins. Of the seven
;; AUTHORITY-class claims in the codebase, only ORBR|A_Fuel had a negative test -- and that one
;; only because the claim turned out to be FALSE and was fixed (its @doc said admin-only while
;; `(with-capability (SECURE) …)` enforced nothing, that module's SECURE being `(defcap SECURE () true)`).
;; This one is the opposite case: the gate is real (OUROBOROS|C>WITHDRAW composes DPTF::CAP_Owner),
;; so there is no bug -- but nothing watched it, and deleting CAP_Owner would have broken no test.
;;
;; WHY IT LIVES IN ITS OWN FILE. It needs a token that has actually ACCRUED fees, and the only
;; chain that produces one is Stage_01/[6.2]_DPTF.repl's. `modules/DPTF.repl` was the natural home
;; and cannot host it: its mock tokens start fee-less, and by the end of that file EMMA is frozen
;; for MOCKA and the spare accounts have no compatible DPTF account.
;;
;; THREE FACTS THE FIXTURE DEPENDS ON, none obvious, each established by running it rather than
;; by reading -- they are why a naive version of this test reads zero and looks like a broken
;; fee system:
;;   1. the token OWNER is fee-EXEMPT on its own token, so the owner's transfers accrue nothing;
;;      the fee must be generated by a second account. Exemption applies to EITHER party, so the
;;      receiver must not be the owner either.
;;   2. fee ROUTING depends on the token's kind. A reward (RT) or reward-bearing (RBT) token's fee
;;      is partly stilled and partly BURNED -- total supply drops and the fee target gets NOTHING.
;;      Only a PLAIN DPTF credits the target. Of the twelve fee-bearing tokens in [6.2], only OS
;;      and IR are plain; every other choice silently yields zero here.
;;   3. the ownership gate sits BEHIND an amount check, so on a token with no accrued fees a
;;      non-owner gets "There are no <id> fees to be withdrawn" and never reaches the authority
;;      error. Without step 2 succeeding, step 4 cannot test what it claims to test.
(load "../deploy-stage00.repl")
(load "../deploy-stage01.repl")
(load "../Stage_01/[6.2]_DPTF.repl")

;;||>>>>>>>>>>>>>>>>>>>>>>>>>
;;|| NEXT                   >
;;||>>>>>>>>>>>>>>>>>>>>>>>>>

(begin-tx "ORBR-FEE1 - seed a non-exempt holder of a PLAIN fee-bearing token")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(namespace "ouronet-ns")
(env-sigs [{ "key": "PK_AncientHodler", "caps": [] }])
(print "--- [ORBR-FEE1 . 01 . the three fixture facts, pinned] ---")
(map print
    [
        (expect "<<ORBR-FEE1>> OS is a PLAIN DPTF -- neither reward nor reward-bearing"
            [false false] [(DPTF.URC_IzRT "OS-98c486052a51") (DPTF.URC_IzRBT "OS-98c486052a51")])
        ;;the contrast that makes fact 2 concrete: LI carries the same 10-promille fee and is an
        ;;RBT, so its fee BURNS instead of crediting. Picking it here would read as zero.
        (expect "<<ORBR-FEE1>> ...whereas LI, same fee, is an RBT -- its fee burns instead"
            true (DPTF.URC_IzRBT "LI-98c486052a51"))
        (expect "<<ORBR-FEE1>> the token OWNER is fee-exempt on its own token"
            true (DPTF.UR_AccountRoleFeeExemption "OS-98c486052a51" KST.ANHD))
        ;;and the fee really is routed to the OUROBOROS smart account -- the thing C_WithdrawFees
        ;;exists to empty
        (expect "<<ORBR-FEE1>> the fee target IS the OUROBOROS smart account"
            OUROBOROS.ORBR|SC_NAME (DPTF.UR_FeeTarget "OS-98c486052a51"))
    ]
)
(TS01-C1.DPTF|C_Transfer KST.ANHD "OS-98c486052a51" KST.ANHD KST.EMMA 1000.0 true)
(commit-tx)

;;||>>>>>>>>>>>>>>>>>>>>>>>>>
;;|| NEXT                   >
;;||>>>>>>>>>>>>>>>>>>>>>>>>>

(begin-tx "ORBR-FEE2 - a plain DPTF's fee CREDITS the target rather than burning")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(namespace "ouronet-ns")
(env-sigs [{ "key": "PK_Emma", "caps": [] }])
(print "--- [ORBR-FEE2 . 01 . fee accrual] ---")
(let* ((os:string "OS-98c486052a51")
       (before:decimal (DPTF.UR_AccountSupply os OUROBOROS.ORBR|SC_NAME))
       (sup-before:decimal (DPTF.UR_Supply os)))
    (TS01-C1.DPTF|C_Transfer KST.EMMA os KST.EMMA KST.LUMY 500.0 true)
    (let ((after:decimal (DPTF.UR_AccountSupply os OUROBOROS.ORBR|SC_NAME))
          (sup-after:decimal (DPTF.UR_Supply os)))
        (map print
            [
                ;;EXACT, not "> 0": a fee whose rate silently changed would still be "> 0" and
                ;;would still look correctly collected
                (expect "<<ORBR-FEE2>> a 10-promille fee on 500 credits exactly 5 to the target"
                    5.0 (- after before))
                ;;the half that separates plain from RBT: supply untouched, so the fee MOVED
                (expect "<<ORBR-FEE2>> ...and total supply is unchanged -- moved, not burnt"
                    sup-before sup-after)
                (expect "<<ORBR-FEE2>> the receiver gets the amount net of fee"
                    495.0 (DPTF.UR_AccountSupply os KST.LUMY))
            ]
        )
    )
)
(commit-tx)

;;||>>>>>>>>>>>>>>>>>>>>>>>>>
;;|| NEXT                   >
;;||>>>>>>>>>>>>>>>>>>>>>>>>>

(begin-tx "ORBR-FEE3 - the claim: only the token owner may withdraw")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(namespace "ouronet-ns")
(env-sigs [{ "key": "PK_Emma", "caps": [] }])
(print "--- [ORBR-FEE3 . 01 . a non-owner is refused] ---")
;;EMMA holds the token and PAID the fee; she does not own it. The rejection is DPTF::CAP_Owner
;;demanding the owner's keyset. Drop CAP_Owner from OUROBOROS|C>WITHDRAW and this turns red --
;;which is the whole point, since until now the claim was enforced by code with nothing watching.
(map print
    [
        (expect-failure "<<ORBR-FEE3>> a NON-owner cannot withdraw a token's collected fees"
            "Keyset failure (keys-all)"
            (TS01-C2.ORBR|C_WithdrawFees KST.EMMA "OS-98c486052a51" KST.EMMA))
    ]
)
(commit-tx)

;;||>>>>>>>>>>>>>>>>>>>>>>>>>
;;|| NEXT                   >
;;||>>>>>>>>>>>>>>>>>>>>>>>>>

(begin-tx "ORBR-FEE4 - ...and the owner CAN, so the guard is not refusing everyone")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(namespace "ouronet-ns")
(env-sigs [{ "key": "PK_AncientHodler", "caps": [] }])
(print "--- [ORBR-FEE4 . 01 . the positive half] ---")
;;Without this, ORBR-FEE3 would pass just as well against a function that refuses EVERY caller,
;;including one broken into uselessness. The PAIR is what makes it an authority test rather than
;;a liveness one.
(let* ((os:string "OS-98c486052a51")
       (held:decimal (DPTF.UR_AccountSupply os OUROBOROS.ORBR|SC_NAME))
       (owner-before:decimal (DPTF.UR_AccountSupply os KST.ANHD))
       ;;FUNCTION COVERAGE (G6) — `INFO_ORBR|WithdrawFees`, per the owner's spec: an INFO_ must report
       ;;the same cost the op actually charges. Template: `modules/ATS.repl <<ATS-I1>>`.
       ;;IT LIVES HERE BECAUSE THE FIXTURE DOES. The preview is a two-leg reader (base token-issue price
       ;;+ the ORBR->target transfer of the accrued supply), and it can only be weighed against a token
       ;;that has actually ACCRUED fees. This file is the only place in the suite that builds one — the
       ;;header above explains why `modules/OUROBOROS.repl` cannot host it. Measuring it anywhere else
       ;;would mean pricing a withdrawal of nothing.
       (predicted:decimal
           (at "ignis-need" (at "ignis" (INFO-ONE.INFO_ORBR|WithdrawFees KST.ANHD os KST.ANHD))))
       (ignis-before:decimal (DALOS.UR_TF_AccountSupply KST.ANHD false)))
    (TS01-C2.ORBR|C_WithdrawFees KST.ANHD os KST.ANHD)
    (map print
        [
            (format "<<ORBR-FEE4>> INFO predicted={} real={}"
                [predicted (- ignis-before (DALOS.UR_TF_AccountSupply KST.ANHD false))])
            (expect "<<ORBR-FEE4>> INFO_ORBR|WithdrawFees's quote equals what the withdrawal charged"
                (- ignis-before (DALOS.UR_TF_AccountSupply KST.ANHD false)) predicted)
            (expect "<<ORBR-FEE4>> ...and it is a real, non-zero charge"
                true (> (- ignis-before (DALOS.UR_TF_AccountSupply KST.ANHD false)) 0.0))
            (expect "<<ORBR-FEE4>> fees had really accrued, so the drain below means something"
                5.0 held)
            (expect "<<ORBR-FEE4>> the OWNER can withdraw, draining the collected fees to zero"
                0.0 (DPTF.UR_AccountSupply os OUROBOROS.ORBR|SC_NAME))
            ;;and the fees actually ARRIVED at the target account -- a withdrawal that merely
            ;;zeroed the balance without paying anyone would pass the assertion above
            (expect "<<ORBR-FEE4>> ...and the withdrawn fees landed in the owner's account"
                (+ owner-before held) (DPTF.UR_AccountSupply os KST.ANHD))
        ]
    )
)
(commit-tx)
;;||>>>>>>>>>>>>>>>>>>>>>>>>>
;;|| NEXT                   >
;;||>>>>>>>>>>>>>>>>>>>>>>>>>

(begin-tx "ORBR-FEE5 - withdrawing twice: the empty-till guard")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(namespace "ouronet-ns")
(env-sigs [{ "key": "PK_AncientHodler", "caps": [] }])
(print "--- [ORBR-FEE5 . 01 . nothing left to withdraw] ---")
;;ORBR::C_WithdrawFees' "There are no {} fees to be withdrawn from {}" was UNPINNED. It needs the
;;fee target to hold ZERO of the token -- which is exactly the state ORBR-FEE4 above just created
;;by draining it. Pinning it here costs one transaction and no fixture; it is the same
;;"assert inside a state an existing block already produced" move, one block later.
;;
;;It also completes the pair: FEE4 proved the owner CAN withdraw when there is something there,
;;and this proves the same owner is refused when there is not -- so the success above was about
;;the balance, not about the caller being privileged enough to always succeed.
(let ((os:string "OS-98c486052a51"))
    (map print
        [
            ;;precondition: the till really is empty after FEE4
            (expect "<<ORBR-FEE5>> the fee target holds nothing after the drain"
                0.0 (DPTF.UR_AccountSupply os OUROBOROS.ORBR|SC_NAME))
            (expect-failure "<<ORBR-FEE5>> a second withdrawal is refused -- there is nothing to take"
                "There are no OS-98c486052a51 fees to be withdrawn"
                (TS01-C2.ORBR|C_WithdrawFees KST.ANHD os KST.ANHD))
        ]
    )
)
(commit-tx)

(print "=== END Kursan/_verify_finding_ORBR-FEE_01_withdraw_ownership.repl ===")
