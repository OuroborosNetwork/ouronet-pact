;;   Inter-tx:   ;;|| NEXT >  (same three lines as REPL/Stage_01/[2.2]_Core.repl)
;;   Intra-tx:   ;;==== <TX label> · mm · <slug> ====  + next-line (print "--- [<label> · mm · …] ---"); mm = 01.. within each (begin-tx …) (see OuronetInformational/ARCHITECTURE/REPL_AND_TESTS.md).
;;   format "{}": Talos / module echoes and (env-gas) — document additional prefixes in this file's (print …) lines as needed.
;;
(print "")
(print "================================================================")
(print "FILE  REPL/Kursan/table-write-partial-test2.repl")
(print "================================================================")
(print "Legend (terminal observability): see ;; preface; echoes use <(…)> where helpful.")
(print "Source: ;;|| NEXT > between txs; ;;==== … · mm · … ==== + banner before each begin-tx.")
(print "")
;; Follow-up: write with (+ read partial) pattern

(module test-write-partial2 G
  (defschema TestRow
    a:integer
    b:integer
    c:integer
  )

  (deftable test-table:{TestRow})

  (defcap G () true)

  (defun seed ()
    (insert test-table "k1" {"a": 1, "b": 2, "c": 3})
  )

  (defun write-merge-existing ()
    (write test-table "k1"
      (+ (read test-table "k1") {"b": 55})
    )
    (read test-table "k1")
  )

  (defun write-full-new ()
    (write test-table "k2" {"a": 7, "b": 8, "c": 9})
    (read test-table "k2")
  )
)

(create-table test-write-partial2.test-table)

(begin-tx "seed")
  (test-write-partial2.seed)
(commit-tx)
;;||>>>>>>>>>>>>>>>>>>>>>>>>>
;;|| NEXT                   >
;;||>>>>>>>>>>>>>>>>>>>>>>>>>
(print "")
(print "")
(begin-tx "write-merge-existing")
  (expect "write with merged full object" {"a": 1, "b": 55, "c": 3}
    (test-write-partial2.write-merge-existing)
  )
(commit-tx)
;;||>>>>>>>>>>>>>>>>>>>>>>>>>
;;|| NEXT                   >
;;||>>>>>>>>>>>>>>>>>>>>>>>>>
(print "")
(print "")
(begin-tx "write-full-new")
  (expect "write full new row" {"a": 7, "b": 8, "c": 9}
    (test-write-partial2.write-full-new)
  )
(commit-tx)
