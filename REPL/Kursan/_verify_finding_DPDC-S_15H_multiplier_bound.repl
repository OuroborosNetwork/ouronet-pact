;; Verification for DPDC Audit finding #15H (DPDC-S): <score-multiplier> was fully unvalidated at Define
;; time and only precision-checked (no magnitude bound) at Update time -- a role holder could set it to
;; anything, retroactively re-pricing every outstanding member of a Set-Class instantly. Owner: cap at 100x.
;; Fix: new shared DPDC-S::UEV_ScoreMultiplier enforces (0, 100] + 3-decimal precision, wired into both
;; Define (Primordial/Composite/Hybrid) and Update.
(load "../Stage00_Sanboxes.repl")
(load "../Stage01_Tester.repl")
(load "../Stage_02/[0.1]_Interfaces.repl")
(load "../Stage_02/[2.1]_DpdcCore.repl")
(load "../Stage_02/[2.2]_DemiPad.repl")
(load "../Stage_02/[2.3]_EarningPools.repl")
(load "../Stage_02/[3]_Talos.repl")
(load "../Stage_02/[4.0]_Sovereign-Executor.repl")

(begin-tx "PROBE-15H - score-multiplier bounded at Define AND Update, (0,100] + 3-decimal precision")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(namespace "ouronet-ns")
(let
    (
        (ref-DALOS:module{OuronetDalosV1} DALOS)
        (owner:string KST.ANHD)
        (dpnf-price:decimal (ref-DALOS::UR_UsagePrice "dpnf"))
        (split-kda:[decimal] (ref-DALOS::URC_SplitKDAPrices owner dpnf-price))
    )
    (env-sigs
        [
            { "key": "PK_AncientHodler", "caps": [] }
            { "key": "6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263",
              "caps":
                [
                    (coin.TRANSFER "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263"
                        "k:50d6c59b21e5e6e55baecaa75a1007de37576bde12d8230dc82459cc01b9484b" (at 2 split-kda))
                    (coin.TRANSFER "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263"
                        "k:0cb30c0121ff919266121a99ff9359871818932211df94dae4137c29bc0e8f7e" (at 0 split-kda))
                    (coin.TRANSFER "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263"
                        "c:XM-pkmuB5XUQlp87ZYSbfKt8qzmHY6O2EHAzMRVBt3k" (at 3 split-kda))
                    (coin.TRANSFER "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263"
                        "c:iQQFWj6gWtpGEzhM_O5ekW1QtnQQy55R8BRPGhj_0FU" (at 1 split-kda))
                ]
            }
        ]
    )
)
(let
    (
        (ref-DPDC-UDC:module{DpdcUdcV1} DPDC-UDC)
        (ref-TS02-C2:module{TalosStageTwo_ClientTwoV1} TS02-C2)
        (owner:string KST.ANHD)
        (creator:string KST.ANHD)
        (nd:object{DpdcUdcV1.DPDC|NonceData}
            (ref-DPDC-UDC::UDC_NonceData
                0.0 0.0 "n" "d" (ref-DPDC-UDC::UDC_NoMetaData)
                (ref-DPDC-UDC::UDC_URI|Type true false false false false false false)
                (ref-DPDC-UDC::UDC_URI|Data "ipfs://a" "" "" "" "" "" "")
                (ref-DPDC-UDC::UDC_ZeroURI|Data) (ref-DPDC-UDC::UDC_ZeroURI|Data)
            )
        )
    )
    (print (format "ISSUE RESULT = {}"
        [(ref-TS02-C2::DPNF|C_Issue owner owner creator "MultiplierProbeNFT" "MULP"
            true true true true true true true true)]))
    (let ((id:string "MULP-98c486052a51"))
        ;; 4 real primordial nonces so every Define below fails/succeeds specifically on the
        ;; multiplier check, not on an unrelated "nonexistent nonce" definition error.
        (print (format "CREATE 1 = {}" [(ref-TS02-C2::DPNF|C_Create owner id [nd])]))
        (print (format "CREATE 2 = {}" [(ref-TS02-C2::DPNF|C_Create owner id [nd])]))
        (print (format "CREATE 3 = {}" [(ref-TS02-C2::DPNF|C_Create owner id [nd])]))
        (print (format "CREATE 4 = {}" [(ref-TS02-C2::DPNF|C_Create owner id [nd])]))
        ;; #15H negatives at DEFINE time (previously entirely unchecked).
        (print (expect-failure "<<15H-1>> Define with multiplier=100.001 (> 100x) rejected"
            (ref-TS02-C2::DPNF|C_DefinePrimordialSet owner id "TooHigh" 100.001 [(ref-DPDC-UDC::N [1 3]) (ref-DPDC-UDC::N [2 4])] nd)))
        (print (expect-failure "<<15H-2>> Define with multiplier=0.0 rejected"
            (ref-TS02-C2::DPNF|C_DefinePrimordialSet owner id "Zero" 0.0 [(ref-DPDC-UDC::N [1 3]) (ref-DPDC-UDC::N [2 4])] nd)))
        (print (expect-failure "<<15H-3>> Define with multiplier=-1.0 rejected"
            (ref-TS02-C2::DPNF|C_DefinePrimordialSet owner id "Negative" -1.0 [(ref-DPDC-UDC::N [1 3]) (ref-DPDC-UDC::N [2 4])] nd)))
        (print (expect-failure "<<15H-4>> Define with multiplier=1.2345 (4-decimal precision) rejected"
            (ref-TS02-C2::DPNF|C_DefinePrimordialSet owner id "TooPrecise" 1.2345 [(ref-DPDC-UDC::N [1 3]) (ref-DPDC-UDC::N [2 4])] nd)))
        ;; Boundary + legit: exactly 100.0 accepted (set-class 1).
        (print (format "<<15H-5>> Define at exactly 100.0x RESULT = {}"
            [(ref-TS02-C2::DPNF|C_DefinePrimordialSet owner id "ExactlyMax" 100.0 [(ref-DPDC-UDC::N [1 3]) (ref-DPDC-UDC::N [2 4])] nd)]))
        ;; A second, ordinary set-class at 2.5x for the Update-path checks below.
        (print (format "<<15H-6>> Define at 2.5x (set-class 2) RESULT = {}"
            [(ref-TS02-C2::DPNF|C_DefinePrimordialSet owner id "OrdinaryClass" 2.5 [(ref-DPDC-UDC::N [1 3]) (ref-DPDC-UDC::N [2 4])] nd)]))
        ;; #15H negatives at UPDATE time (magnitude bound is new; precision check pre-existed).
        (print (expect-failure "<<15H-7>> Update set-class 2 multiplier to 250.0 (> 100x) rejected"
            (ref-TS02-C2::DPNF|C_UpdateSetMultiplier owner id 2 250.0)))
        (print (expect-failure "<<15H-8>> Update set-class 2 multiplier to -5.0 rejected"
            (ref-TS02-C2::DPNF|C_UpdateSetMultiplier owner id 2 -5.0)))
        ;; Legit update within bounds still works.
        (print (format "<<15H-9>> Update set-class 2 multiplier to 50.0 RESULT = {}"
            [(ref-TS02-C2::DPNF|C_UpdateSetMultiplier owner id 2 50.0)]))
        ""
    )
)
(commit-tx)
