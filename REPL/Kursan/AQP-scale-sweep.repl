(print "--- [SCALE-SWP-R1 · recompute chunk 15] ---")
;;==== SCALE-SWP-R1 - CCp_SweepRecomputeChunk 15 · 02 · let / invocation ==== =====================
(print "--- [SCALE-SWP-R1 - CCp_SweepRecomputeChunk 15 · 02 · let / invocation] ---")
(let
    (
        (patron:string KST.ANHD)
        (ref-U|DALOS:module{UtilityDalosV2} U|DALOS)
        (ref-AQP:module{AcquisitionPoolsV1} AQP-POOL)
        (ref-TS02-C3:module{TalosStageTwo_ClientThreeV1} TS02-C3)
        (anchor-id:string (ref-U|DALOS::UDC_Makeid "ScaleSwpAnchor"))
        (pool-id:string (ref-U|DALOS::UDC_Makeid "ScaleSwpPool"))
    )
    (env-gas 0)
    (ref-TS02-C3::AQP-FVT|CCp_SweepRecomputeChunk patron anchor-id 15)
    (let
        (
            (g:integer (env-gas))
            (offset:integer (at "offset" (AQP-FVT.UR_FVT|SweepProgress anchor-id)))
            (active:bool (AQP-FVT.UR_FVT|SweepActive anchor-id))
            (frozen:bool (ref-AQP::UR_AQP|PoolSweepInProgress pool-id))
        )
        (map print
            [
                (format "<<SCALE-SWP-R1>> gas={} offset={} remaining={} active={} pool-frozen={} fits-2M={}" [g offset (- 50 offset) active frozen (<= g 2000000)])
                (expect (format "<<SCALE-SWP-R1>> round fits 2M gas={}" [g]) true (<= g 2000000))
                (expect (format "<<SCALE-SWP-R1>> cursor active={}" [active]) true active)
                (expect (format "<<SCALE-SWP-R1>> pool frozen={}" [frozen]) true frozen)
            ]
        )
    )
)
(env-sigs [])
(commit-tx)
