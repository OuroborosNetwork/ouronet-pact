;; SCALE-SWP-DONE — after the final chunk: cursor closed, pool unfrozen, promiles recomputed to 0.
(begin-tx "SCALE-SWP-DONE - end-state check")
;;==== SCALE-SWP-DONE - end-state check · 01 · namespace ==== =====================================
(print "--- [SCALE-SWP-DONE - end-state check · 01 · namespace] ---")
(namespace "ouronet-ns")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
;;==== SCALE-SWP-DONE - end-state check · 02 · let / invocation ==== ==============================
(print "--- [SCALE-SWP-DONE - end-state check · 02 · let / invocation] ---")
(let
    (
        (ref-U|DALOS:module{UtilityDalosV2} U|DALOS)
        (ref-ANK:module{AcquisitionAnchorsV1} AQP-ANK)
        (ref-AQP:module{AcquisitionPoolsV1} AQP-POOL)
        (anchor-id:string (ref-U|DALOS::UDC_Makeid "ScaleSwpAnchor"))
        (pool-id:string (ref-U|DALOS::UDC_Makeid "ScaleSwpPool"))
        (boost-id:string (ref-U|DALOS::UDC_Makeid "ScaleSwpBoost"))
    )
    (map print
        [
            (format "<<SCALE-SWP-DONE>> active={} pool-frozen={} synth1-promile={} synth50-promile={}"
                [(AQP-FVT.UR_FVT|SweepActive anchor-id) (ref-AQP::UR_AQP|PoolSweepInProgress pool-id)
                 (ref-ANK::UR_UB|AggregatePromile (VCTGAS.UC_SynthAccount 1) boost-id) (ref-ANK::UR_UB|AggregatePromile (VCTGAS.UC_SynthAccount 50) boost-id)])
            (expect "<<SCALE-SWP-DONE>> cursor CLOSED" false (AQP-FVT.UR_FVT|SweepActive anchor-id))
            (expect "<<SCALE-SWP-DONE>> pool UNFROZEN" false (ref-AQP::UR_AQP|PoolSweepInProgress pool-id))
            (expect "<<SCALE-SWP-DONE>> synth-1 promile recomputed to 0 (anchor gone)" 0.0 (ref-ANK::UR_UB|AggregatePromile (VCTGAS.UC_SynthAccount 1) boost-id))
            (expect "<<SCALE-SWP-DONE>> synth-50 promile recomputed to 0" 0.0 (ref-ANK::UR_UB|AggregatePromile (VCTGAS.UC_SynthAccount 50) boost-id))
        ]
    )
)
(commit-tx)
(print "")
(print "=== END AQP-scale-sweep.repl — 50-holder anchor sweep paginated + gas ===")
