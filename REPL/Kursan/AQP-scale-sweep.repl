;;
;; ============================================================================
;; SCALE-SWP-01 — anchor on OURO + boost-linked score + 50 synth stakers (each gains promile)
;; ============================================================================
(begin-tx "SCALE-SWP-01 - anchor + boost-linked score + 50 synth stakers")
(namespace "ouronet-ns")
(env-gasmodel "table")(env-gaslimit 900000000)(env-gas 0)
;;==== SCALE-SWP-01 - anchor + boost-linked score + 50 synth stakers · 01 · env-sigs (caps) ==== ==
(print "--- [SCALE-SWP-01 - anchor + boost-linked score + 50 synth stakers · 01 · env-sigs (caps)] ---")
(env-sigs
    [
        { "key": "PK_AncientHodler", "caps": [] }
        { "key": "6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263",
          "caps":
            [
                (coin.TRANSFER "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263" "k:50d6c59b21e5e6e55baecaa75a1007de37576bde12d8230dc82459cc01b9484b" 1000000.0)
                (coin.TRANSFER "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263" "k:0cb30c0121ff919266121a99ff9359871818932211df94dae4137c29bc0e8f7e" 1000000.0)
                (coin.TRANSFER "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263" "c:XM-pkmuB5XUQlp87ZYSbfKt8qzmHY6O2EHAzMRVBt3k" 1000000.0)
                (coin.TRANSFER "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263" "c:iQQFWj6gWtpGEzhM_O5ekW1QtnQQy55R8BRPGhj_0FU" 1000000.0)
            ]
        }
    ]
)
(print "--- [SCALE-SWP-01 · anchor + boost-linked score + stake 50] ---")
;;==== SCALE-SWP-01 - anchor + boost-linked score + 50 synth stakers · 02 · let / invocation ==== =
(print "--- [SCALE-SWP-01 - anchor + boost-linked score + 50 synth stakers · 02 · let / invocation] ---")
(let
    (
        (patron:string KST.ANHD)
        (ouro-id:string "OURO-98c486052a51")
        (ref-U|DALOS:module{UtilityDalosV2} U|DALOS)
        (ref-ANK:module{AcquisitionAnchorsV1} AQP-ANK)
        (ref-TS02-C3:module{TalosStageTwo_ClientThreeV1} TS02-C3)
        (pool-id:string (ref-U|DALOS::UDC_Makeid "ScaleSwpPool"))
        (score-id:string (ref-U|DALOS::UDC_Makeid "ScaleSwpScore"))
        (fvt-id:string (ref-U|DALOS::UDC_Makeid "ScaleSwpFvt"))
        (anchor-id:string (ref-U|DALOS::UDC_Makeid "ScaleSwpAnchor"))
        (boost-id:string (ref-U|DALOS::UDC_Makeid "ScaleSwpBoost"))
    )
    ;; 1. anchor on OURO (promile 500 / reference 1000) — acnoi=true creates the boost-class
    (ref-TS02-C3::AQP-ANK|C_IssueTrueFungibleAnchor patron "ScaleSwpAnchor" ouro-id true "ScaleSwpBoost" 3 500.0 1000.0)
    ;; 2. pool + score, LINK the score to the boost-class WHILE EMPTY, then vault + enable
    (ref-TS02-C3::AQP-POOL|C_Issue patron "ScaleSwpPool" ouro-id 1)
    (ref-TS02-C3::AQP-SCR|C_IssueTrueFungibleScore patron patron "ScaleSwpScore" 12 1.0)
    (ref-TS02-C3::AQP-POOL|C_AddScore patron pool-id score-id)
    (ref-TS02-C3::AQP-SCR|C_CreateScoreBoostClassLink patron score-id boost-id)
    (ref-TS02-C3::AQP-FVT|REPL_BootstrapVault patron fvt-id patron score-id ouro-id)
    (ref-TS02-C3::AQP-POOL|C_EnablePoolStake patron pool-id)
    ;; 3. stake 50 synth (2 OURO each) → each gains proportional promile (2/1000 * 500 = 1.0)
    (VCTGAS.XI_TfStakeOnly patron pool-id ouro-id 50 2.0)
    (let
        (
            (probe-user:string (VCTGAS.UC_SynthAccount 1))
        )
        (map print
            [
                (format "<(SWP-01 · anchor state / boost-class / synth-1 promile)> => {} / {} / {}"
                    [(ref-ANK::UR_ANK|State anchor-id) boost-id (ref-ANK::UR_UB|AggregatePromile probe-user boost-id)])
                (expect "<<SCALE-SWP-01>> anchor ACTIVE" true (ref-ANK::UR_ANK|State anchor-id))
                (expect "<<SCALE-SWP-01>> synth-1 gained boost promile from staking anchored OURO" true (> (ref-ANK::UR_UB|AggregatePromile probe-user boost-id) 0.0))
            ]
        )
    )
)
(env-sigs [])
(commit-tx)
;;||>>>>>>>>>>>>>>>>>>>>>>>>>
;;|| NEXT                   >
;;||>>>>>>>>>>>>>>>>>>>>>>>>>
(print "")
(print "")
;;
;; ============================================================================
;; SCALE-SWP-BEGIN — revoke the anchor: freeze pools + swept-revoke + open cursor (total=50).
;; Recompute is DEFERRED (synth promiles unchanged here).
;; ============================================================================
(begin-tx "SCALE-SWP-BEGIN - CC_SweepBegin (revoke + freeze + open cursor)")
(namespace "ouronet-ns")
(env-gasmodel "table")(env-gaslimit 900000000)(env-gas 0)
;;==== SCALE-SWP-BEGIN - CC_SweepBegin (revoke + freeze + open cursor) · 01 · env-sigs (caps) ==== 
(print "--- [SCALE-SWP-BEGIN - CC_SweepBegin (revoke + freeze + open cursor) · 01 · env-sigs (caps)] ---")
(env-sigs
    [
        { "key": "PK_AncientHodler", "caps": [] }
        { "key": "6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263",
          "caps":
            [
                (coin.TRANSFER "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263" "k:50d6c59b21e5e6e55baecaa75a1007de37576bde12d8230dc82459cc01b9484b" 1000000.0)
                (coin.TRANSFER "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263" "k:0cb30c0121ff919266121a99ff9359871818932211df94dae4137c29bc0e8f7e" 1000000.0)
                (coin.TRANSFER "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263" "c:XM-pkmuB5XUQlp87ZYSbfKt8qzmHY6O2EHAzMRVBt3k" 1000000.0)
                (coin.TRANSFER "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263" "c:iQQFWj6gWtpGEzhM_O5ekW1QtnQQy55R8BRPGhj_0FU" 1000000.0)
            ]
        }
    ]
)
(print "--- [SCALE-SWP-BEGIN · CC_SweepBegin] ---")
;;==== SCALE-SWP-BEGIN - CC_SweepBegin (revoke + freeze + open cursor) · 02 · let / invocation ==== 
(print "--- [SCALE-SWP-BEGIN - CC_SweepBegin (revoke + freeze + open cursor) · 02 · let / invocation] ---")
(let
    (
        (patron:string KST.ANHD)
        (ref-U|DALOS:module{UtilityDalosV2} U|DALOS)
        (ref-ANK:module{AcquisitionAnchorsV1} AQP-ANK)
        (ref-AQP:module{AcquisitionPoolsV1} AQP-POOL)
        (ref-TS02-C3:module{TalosStageTwo_ClientThreeV1} TS02-C3)
        (anchor-id:string (ref-U|DALOS::UDC_Makeid "ScaleSwpAnchor"))
        (pool-id:string (ref-U|DALOS::UDC_Makeid "ScaleSwpPool"))
        (boost-id:string (ref-U|DALOS::UDC_Makeid "ScaleSwpBoost"))
        (probe-user:string (VCTGAS.UC_SynthAccount 1))
    )
    (env-gas 0)
    (ref-TS02-C3::AQP-FVT|CC_SweepBegin patron anchor-id)
    (let
        (
            (g:integer (env-gas))
            (total:integer (at "total" (AQP-FVT.UR_FVT|SweepProgress anchor-id)))
        )
        (map print
            [
                (format "<<SCALE-SWP-BEGIN>> gas={} total-to-recompute={} active={} anchor-revoked={} pool-frozen={} synth1-promile-still={}"
                    [g total (AQP-FVT.UR_FVT|SweepActive anchor-id) (not (ref-ANK::UR_ANK|State anchor-id)) (ref-AQP::UR_AQP|PoolSweepInProgress pool-id) (ref-ANK::UR_UB|AggregatePromile probe-user boost-id)])
                (expect "<<SCALE-SWP-BEGIN>> cursor active" true (AQP-FVT.UR_FVT|SweepActive anchor-id))
                (expect "<<SCALE-SWP-BEGIN>> 50 holders to recompute" 50 total)
                (expect "<<SCALE-SWP-BEGIN>> anchor swept-revoked" false (ref-ANK::UR_ANK|State anchor-id))
                (expect "<<SCALE-SWP-BEGIN>> pool FROZEN" true (ref-AQP::UR_AQP|PoolSweepInProgress pool-id))
                (expect "<<SCALE-SWP-BEGIN>> recompute DEFERRED (promile still >0)" true (> (ref-ANK::UR_UB|AggregatePromile probe-user boost-id) 0.0))
            ]
        )
    )
)
(env-sigs [])
(commit-tx)
;;||>>>>>>>>>>>>>>>>>>>>>>>>>
;;|| NEXT                   >
;;||>>>>>>>>>>>>>>>>>>>>>>>>>
(print "")
(print "")
(begin-tx "SCALE-SWP-FREEZE - collect is refused while the sweep is open")
(namespace "ouronet-ns")
(env-gasmodel "table")(env-gaslimit 900000000)(env-gas 0)
;;==== SCALE-SWP-FREEZE - collect is refused while the sweep is open · 01 · env-sigs (caps) ==== ==
(print "--- [SCALE-SWP-FREEZE - collect is refused while the sweep is open · 01 · env-sigs (caps)] ---")
(env-sigs [{ "key": "PK_AncientHodler", "caps": [] }])
(print "--- [SCALE-SWP-FREEZE . collect during an open sweep] ---")
;;FVT::UEV_CollectContext's first guard -- "Collect is frozen while a re-score sweep is in progress
;;on this pool" -- was UNPINNED (`python3 REPL/tools/_cheapseam.py`). It needs a pool with an OPEN sweep,
;;which exists for exactly the span between CC_SweepBegin above and the recompute chunks below, so
;;this is the only point in the suite where it can be reached. The block above already reads
;;UR_AQP|PoolSweepInProgress and asserts the pool is FROZEN; this asserts what that freeze is FOR.
;;
;;Why it matters, from the source's own note: mid-sweep the aggregate-promile is in flux, so a
;;collect on an unswept holder would refresh deb against a stale-high aggregate -- i.e. pay out on
;;a number the sweep is in the middle of correcting.
;;==== SCALE-SWP-FREEZE - collect is refused while the sweep is open · 02 · let / invocation ==== =
(print "--- [SCALE-SWP-FREEZE - collect is refused while the sweep is open · 02 · let / invocation] ---")
(let
    (
        (patron:string KST.ANHD)
        (ref-U|DALOS:module{UtilityDalosV2} U|DALOS)
        (ref-AQP:module{AcquisitionPoolsV1} AQP-POOL)
        (ref-TS02-C3:module{TalosStageTwo_ClientThreeV1} TS02-C3)
        (fvt-id:string (ref-U|DALOS::UDC_Makeid "ScaleSwpFvt"))
        (score-id:string (ref-U|DALOS::UDC_Makeid "ScaleSwpScore"))
        (pool-id:string (ref-U|DALOS::UDC_Makeid "ScaleSwpPool"))
        (ouro-id:string "OURO-98c486052a51")
    )
    (map print
        [
            ;;the precondition, asserted here too so this block stands on its own: if the sweep were
            ;;NOT open the rejection below would have to come from some other guard, and the test
            ;;would be pinning the wrong thing.
            (expect "<<SCALE-SWP-FREEZE>> the pool really is mid-sweep at this point"
                true (ref-AQP::UR_AQP|PoolSweepInProgress pool-id))
            (expect-failure "<<SCALE-SWP-FREEZE>> a collect on that pool is refused while the sweep is open"
                "Collect is frozen while a re-score sweep is in progress on this pool"
                (ref-TS02-C3::AQP-FVT|CC_Collect patron patron fvt-id 1 score-id ouro-id))
            ;;TWO MORE GUARDS LIVE IN EXACTLY THIS WINDOW, and nowhere else in the suite: an OPEN
            ;;sweep is the precondition for both, and it exists only between CC_SweepBegin above and
            ;;the recompute chunks below.
            ;;
            ;;`05_FVT.pact:3118` -- a sweep cannot be opened twice on the same anchor. Without this
            ;;a second Begin would reset the cursor mid-drain and silently re-freeze pools that the
            ;;finalizing chunk had already released.
            (expect-failure "<<SCALE-SWP-FREEZE>> a sweep cannot be opened twice on the same anchor"
                "A sweep is already in progress for this anchor"
                (ref-TS02-C3::AQP-FVT|CC_SweepBegin patron
                    (ref-U|DALOS::UDC_Makeid "ScaleSwpAnchor")))
            ;;`05_FVT.pact:1006` -- the chunk size bound, BOTH ends. SWEEP-CHUNK-MAX is derived as
            ;;SWEEP-CHUNK-GAS-BUDGET / SWEEP-GAS-PER-HOLDER = 2,000,000 / 2,000 = 1000, so the bound
            ;;is computed from the gas model rather than typed. It is deliberately LOOSE -- the UI
            ;;sizes the real chunk by simulation and the node gas meter is the actual enforcement --
            ;;which is exactly why it is worth pinning: a backstop nobody drives is a backstop nobody
            ;;knows the value of.
            (expect "<<SCALE-SWP-FREEZE>> the chunk bound is derived from the gas model, not typed"
                1000 AQP-FVT.SWEEP-CHUNK-MAX)
            (expect-failure "<<SCALE-SWP-FREEZE>> a ZERO chunk is out of range"
                "Sweep chunk out of range"
                (ref-TS02-C3::AQP-FVT|CCp_SweepRecomputeChunk patron
                    (ref-U|DALOS::UDC_Makeid "ScaleSwpAnchor") 0))
            (expect-failure "<<SCALE-SWP-FREEZE>> ...and so is one past SWEEP-CHUNK-MAX"
                "Sweep chunk out of range"
                (ref-TS02-C3::AQP-FVT|CCp_SweepRecomputeChunk patron
                    (ref-U|DALOS::UDC_Makeid "ScaleSwpAnchor") 1001))
            ;;the ACCEPTING side is not driven here on purpose: a valid chunk does real recompute
            ;;work and would advance the cursor this file's later assertions count on. SCALE-SWP-R1
            ;;below drives chunk 15 successfully, which is the contrast.
        ]
    )
)
(env-sigs [])
(commit-tx)
;;||>>>>>>>>>>>>>>>>>>>>>>>>>
;;|| NEXT                   >
;;||>>>>>>>>>>>>>>>>>>>>>>>>>
