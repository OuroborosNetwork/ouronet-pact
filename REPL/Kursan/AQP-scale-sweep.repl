;; REPL/Kursan/AQP-scale-sweep.repl — ANCHOR SWEEP at large population (50 holders).
;; Proves the sweep CC-batch (CC_SweepBegin + CCp_SweepRecomputeChunk) over 50 present
;; holders: revoke an anchor, recompute all 50 in rounds under 2M, freeze holds between
;; rounds, cursor closes. Reuses VCTGAS synth accounts.
;;
(print "")
(print "================================================================")
(print "FILE  REPL/Kursan/AQP-scale-sweep.repl  —  50-holder anchor sweep + gas")
(print "================================================================")
(load "../Stage00_Sanboxes.repl")
(load "../Stage01_Tester.repl")
