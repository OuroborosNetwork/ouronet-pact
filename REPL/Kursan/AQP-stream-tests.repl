;; ============================================================================
;; T-STREAM-04 — Guard bounds (UEV_StreamParams): duration < 1h, duration > 365d, and rate below the min are rejected.
;; ============================================================================
(begin-tx "T-STREAM-04 - streamed inject guard bounds")
(namespace "ouronet-ns")
(env-gasmodel "table")(env-gaslimit 900000000)(env-gas 0)
(env-chain-data { "block-time": (time "2027-06-01T00:00:00Z") })
;;==== T-STREAM-04 - streamed inject guard bounds · 01 · let / invocation ==== ====================
(print "--- [T-STREAM-04 - streamed inject guard bounds · 01 · let / invocation] ---")
(let
    (
        (patron:string KST.ANHD)
        (ouro-id:string "OURO-98c486052a51")
        (ref-U|DALOS:module{UtilityDalosV2} U|DALOS)
        (ref-TS02-C3:module{TalosStageTwo_ClientThreeV2} TS02-C3)
        (fvt-id:string (ref-U|DALOS::UDC_Makeid "StreamVault"))
        (gs-key:string "6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263")
    )
    (print "--- [T-STREAM-04 · guard rejects out-of-range duration + sub-min rate] ---")
    (env-sigs
        [ { "key": "PK_AncientHodler", "caps": [] }
          { "key": gs-key, "caps":
            [ (coin.TRANSFER (concat ["k:" gs-key]) "k:50d6c59b21e5e6e55baecaa75a1007de37576bde12d8230dc82459cc01b9484b" 1000000.0)
              (coin.TRANSFER (concat ["k:" gs-key]) "k:0cb30c0121ff919266121a99ff9359871818932211df94dae4137c29bc0e8f7e" 1000000.0)
              (coin.TRANSFER (concat ["k:" gs-key]) "c:XM-pkmuB5XUQlp87ZYSbfKt8qzmHY6O2EHAzMRVBt3k" 1000000.0)
              (coin.TRANSFER (concat ["k:" gs-key]) "c:iQQFWj6gWtpGEzhM_O5ekW1QtnQQy55R8BRPGhj_0FU" 1000000.0) ] } ])
    (map print
        [ (expect-failure "<<T-STREAM-04>> duration < 1h rejected" "FVT|Stream: duration must be 1h"
            (ref-TS02-C3::AQP-FVT|CC_InjectStream patron fvt-id ouro-id 240.0 1800))
          (expect-failure "<<T-STREAM-04>> duration > 365d rejected" "FVT|Stream: duration must be 1h"
            (ref-TS02-C3::AQP-FVT|CC_InjectStream patron fvt-id ouro-id 240.0 40000000))
          (expect-failure "<<T-STREAM-04>> rate below min rejected" "FVT|Stream: duration must be 1h"
            (ref-TS02-C3::AQP-FVT|CC_InjectStream patron fvt-id ouro-id 0.00000000001 31536000)) ])
    (env-sigs [])
)
(commit-tx)
