;;
;; ============================================================================
;; T-STREAM-06 — FARM (class 0) drip: a streamed inject on a farm releases via the O(members) split-at-inject
;;   path (XI_1|FarmSplitInject fed by the drip). ANHD stakes OURO-LP into a farm; stream 240 OURO / 24h; at
;;   +12h ANHD (sole staker) collects ~120. Proves the drip's FARM branch (vs the vault branch proven above).
;; ============================================================================
(begin-tx "T-STREAM-06 - farm (class 0) streamed drip")
(namespace "ouronet-ns")
(env-gasmodel "table")(env-gaslimit 900000000)(env-gas 0)
;;==== T-STREAM-06 - farm (class 0) streamed drip · 01 · let / invocation ==== ====================
(print "--- [T-STREAM-06 - farm (class 0) streamed drip · 01 · let / invocation] ---")
(let
    (
        (patron:string KST.ANHD)
        (anhd:string KST.ANHD)
        (ouro-id:string "OURO-98c486052a51")
        (swpair:string "W|DLK-98c486052a51|OURO-98c486052a51|DWK-98c486052a51")
        (ref-SWP:module{SwapperV4} SWP)
        (ref-DPTF:module{DemiourgosPactTrueFungibleV2} DPTF)
        (ref-U|CT:module{OuronetConstantsV2} U|CT)
        (ref-U|DALOS:module{UtilityDalosV2} U|DALOS)
        (ref-TS02-C3:module{TalosStageTwo_ClientThreeV2} TS02-C3)
        (ref-FVT:module{AcquisitionFarmsVaultsTreasuriesV2} AQP-FVT)
        (score-id:string (ref-U|DALOS::UDC_Makeid "FarmStreamScore"))
        (fvt-id:string (ref-U|DALOS::UDC_Makeid "FarmStreamFvt"))
        (pool-id:string (ref-U|DALOS::UDC_Makeid "FarmStreamPool"))
        (t6:time (time "2027-11-01T00:00:00Z"))
        (gs-key:string "6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263")
    )
    (let ((lp-id:string (ref-SWP::UR_TokenLP swpair)))
        (print (format "<<T-STREAM-06>> ouro-lp-id = {} ; ANHD LP balance = {}" [lp-id (ref-DPTF::UR_AccountSupply lp-id anhd)]))
        ;;==== T-STREAM-06 · 01 · build a class-0 farm on the OURO-LP + stake LP @t6 ====
        (print "--- [T-STREAM-06 · 01 · build farm + stake LP] ---")
        (env-chain-data { "block-time": t6 })
        (env-sigs
            [ { "key": "PK_AncientHodler", "caps": [] }
              { "key": gs-key, "caps":
                [ (coin.TRANSFER (concat ["k:" gs-key]) "k:50d6c59b21e5e6e55baecaa75a1007de37576bde12d8230dc82459cc01b9484b" 1000000.0)
                  (coin.TRANSFER (concat ["k:" gs-key]) "k:0cb30c0121ff919266121a99ff9359871818932211df94dae4137c29bc0e8f7e" 1000000.0)
                  (coin.TRANSFER (concat ["k:" gs-key]) "c:XM-pkmuB5XUQlp87ZYSbfKt8qzmHY6O2EHAzMRVBt3k" 1000000.0)
                  (coin.TRANSFER (concat ["k:" gs-key]) "c:iQQFWj6gWtpGEzhM_O5ekW1QtnQQy55R8BRPGhj_0FU" 1000000.0) ] } ])
        ;; farm score is a class-0 LP score (lp-denominator = OURO full id, per README_HOWTO_FVT)
        (ref-TS02-C3::AQP-SCR|C_IssueLiquidityScore patron patron "FarmStreamScore" 12 ouro-id 1.0 1.0)
        (ref-TS02-C3::AQP-POOL|C_Issue patron "FarmStreamPool" lp-id 0)
        (ref-TS02-C3::AQP-POOL|C_AddScore patron pool-id score-id)
        (ref-TS02-C3::AQP-FVT|C_Issue patron "FarmStreamFvt" patron 0 ouro-id)
        (ref-TS02-C3::AQP-FVT|C_AddRewardLink patron fvt-id ouro-id false (ref-U|CT::CT_BAR))
        (ref-TS02-C3::AQP-FVT|C_AddScoreEntity patron fvt-id 1 score-id)
        (ref-TS02-C3::AQP-POOL|CC_StakeTrueFungible patron pool-id anhd anhd lp-id 1.0)
        ;;==== T-STREAM-06 · 02 · @t6: stream 240 OURO / 24h into the farm ====
        (print "--- [T-STREAM-06 · 02 · CC_InjectStream 240/24h into farm] ---")
        (ref-TS02-C3::AQP-FVT|CC_InjectStream patron fvt-id ouro-id 240.0 86400)
        (expect "<<T-STREAM-06>> farm stream active (count 1)" 1 (AQP-FVT.UR_FVT-RG|StreamCount fvt-id ouro-id))
        ;;==== T-STREAM-06 · 03 · @t6+12h: sole staker ANHD collects ~120 (farm drip released half) ====
        (print "--- [T-STREAM-06 · 03 · @t6+12h farm collect ~120] ---")
        (env-chain-data { "block-time": (add-time t6 43200) })
        (env-sigs
            [ { "key": "PK_AncientHodler", "caps": [] }
              { "key": gs-key, "caps":
                [ (coin.TRANSFER (concat ["k:" gs-key]) "k:50d6c59b21e5e6e55baecaa75a1007de37576bde12d8230dc82459cc01b9484b" 1000000.0)
                  (coin.TRANSFER (concat ["k:" gs-key]) "k:0cb30c0121ff919266121a99ff9359871818932211df94dae4137c29bc0e8f7e" 1000000.0)
                  (coin.TRANSFER (concat ["k:" gs-key]) "c:XM-pkmuB5XUQlp87ZYSbfKt8qzmHY6O2EHAzMRVBt3k" 1000000.0)
                  (coin.TRANSFER (concat ["k:" gs-key]) "c:iQQFWj6gWtpGEzhM_O5ekW1QtnQQy55R8BRPGhj_0FU" 1000000.0) ] } ])
        (let ((anhd-pre:decimal (ref-DPTF::UR_AccountSupply ouro-id anhd)))
            (ref-TS02-C3::AQP-FVT|CC_Collect anhd fvt-id 1 score-id ouro-id)
            (let ((payout:decimal (- (ref-DPTF::UR_AccountSupply ouro-id anhd) anhd-pre)))
                (map print
                    [ (format "<<T-STREAM-06>> farm ANHD payout @12h = {}" [payout])
                      (expect (format "<<T-STREAM-06>> farm drip released ~half (120) to sole staker got={}" [payout]) true (and (> payout 119.9) (< payout 120.1))) ]))))
    (env-sigs [])
)
(commit-tx)
(print "")
(print "=== END AQP-stream-tests.repl ===")

;;|| NEXT >
;;
(begin-tx "T-STREAM-RT - RPS per-field readers: the key round-trip")
;;==== T-STREAM-RT - RPS per-field readers: the key round-trip · 01 · namespace ==== ==============
(print "--- [T-STREAM-RT - RPS per-field readers: the key round-trip · 01 · namespace] ---")
(namespace "ouronet-ns")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(print "--- [T-STREAM-RT · 01 · every identity field reads back the key component it was stored under] ---")
;;FUNCTION COVERAGE (G6, Tier 1: RPS). `04_RPS.pact` carries a large family of per-field row readers
;;-- UR_FVT-RU|*, UR_FVT-RM|*, UR_FVT-RG|*, UR_FVT-SEL|* -- and NOT ONE of them had ever been called
;;from a .repl. Individually they look too trivial to test: each is `(at "field" (full-row-read …))`.
;;
;;THEY ARE NOT TRIVIAL AS A GROUP, and the reason is what makes this sweep worth writing. Four of
;;these tables are keyed by COMPOSITE keys built from 2-4 components, and each row STORES those same
;;components as columns. So every identity reader is a round trip: put (user, fvt, score-entity,
;;dptf) in as a key, get the same four values back as fields. That round trip breaks if a key builder
;;transposes two components, if a writer stores a column in the wrong slot, or if a reader is
;;copy-pasted between sibling tables and left pointing at the neighbour's column -- and all three are
;;real bug shapes in this codebase (DPDC-MNG carried an account/id transposition of exactly this kind).
;;
;;A single wrong reader here would be invisible to every existing test, because the value returned is
;;still a plausible id of the right shape. Asserting the ROUND TRIP is what makes it visible.
;;==== T-STREAM-RT - RPS per-field readers: the key round-trip · 02 · let / invocation ==== =======
(print "--- [T-STREAM-RT - RPS per-field readers: the key round-trip · 02 · let / invocation] ---")
(let
    (
        (ref-U|DALOS:module{UtilityDalosV2} U|DALOS)
        (u:string KST.ANHD)
        (o:string "OURO-98c486052a51")
    )
    (let
        (
            (f:string (ref-U|DALOS::UDC_Makeid "StreamVault"))
            (sc:string (ref-U|DALOS::UDC_Makeid "StreamScore"))
        )
        (map print
            [
                ;;RU — the user RPS row, the widest key in the module: all FOUR components round-trip.
                ;;A transposition of any pair would show up as two mismatches here.
                (expect "<<T-STREAM-RT>> UR_FVT-RU|* returns all four key components unchanged"
                    [u f sc o]
                    [(RPS.UR_FVT-RU|UserId u f sc o)
                     (RPS.UR_FVT-RU|FvtId u f sc o)
                     (RPS.UR_FVT-RU|ScoreEntityId u f sc o)
                     (RPS.UR_FVT-RU|DptfId u f sc o)])
                ;;RM — the member row: three components. Note the argument ORDER differs from RU
                ;;(no user), which is exactly the kind of neighbouring-signature slip this catches.
                (expect "<<T-STREAM-RT>> UR_FVT-RM|* likewise, on the three-component member key"
                    [f sc o]
                    [(RPS.UR_FVT-RM|FvtId f sc o)
                     (RPS.UR_FVT-RM|ScoreEntityId f sc o)
                     (RPS.UR_FVT-RM|DptfId f sc o)])
                ;;RG — the lane/registry row: two components
                (expect "<<T-STREAM-RT>> UR_FVT-RG|* likewise, on the two-component lane key"
                    [f o]
                    [(RPS.UR_FVT-RG|FvtId f o)
                     (RPS.UR_FVT-RG|DptfId f o)])
                ;;SEL — the score-entity link row: two components, and this one shares BOTH its
                ;;argument shape and its column names with RG's neighbour, so a copy-paste between
                ;;the two would be silent everywhere except here.
                (expect "<<T-STREAM-RT>> UR_FVT-SEL|* likewise, on the score-entity link key"
                    [f sc]
                    [(RPS.UR_FVT-SEL|FvtId f sc)
                     (RPS.UR_FVT-SEL|ScoreEntityId f sc)])
                ;;=== THE ABOVE IS VACUOUS WITHOUT THIS ===
                ;;`UR_FVT-RU|RpsUser` is a `with-default-read` whose DEFAULT OBJECT IS BUILT FROM THE
                ;;KEY COMPONENTS (`UDC_FVT|RPS|User 0.0 0.0 user-id fvt-id score-entity-id dptf-id`).
                ;;So on a MISSING row the identity readers echo the arguments straight back, and every
                ;;round-trip assertion above would pass against an EMPTY TABLE. Discovered by writing
                ;;the negative control below and watching it return the key instead of failing.
                ;;
                ;;The round trips are still worth having -- on a row that REALLY EXISTS the values
                ;;come from stored columns, so a writer that transposed two of them is caught -- but
                ;;only once existence is established independently. That is what this pair does.
                (expect "<<T-STREAM-RT>> PREMISE: the RU row is REAL, not a default -- its checkpoint advanced past 0.0"
                    true (> (RPS.UR_FVT-RU|LastRps u f sc o) 0.0))
                ;;THE TRAP, pinned deliberately: a caller cannot use an identity reader to ask
                ;;"does this row exist". Handed a token that was never in this lane, it answers with
                ;;the token it was handed, confidently and wrongly.
                (expect "<<T-STREAM-RT>> TRAP: on a MISSING row the identity readers echo the key rather than failing"
                    ["NOSUCHTOKEN-98c486052a51" u]
                    [(RPS.UR_FVT-RU|DptfId u f sc "NOSUCHTOKEN-98c486052a51")
                     (RPS.UR_FVT-RU|UserId  u f sc "NOSUCHTOKEN-98c486052a51")])
                ;;...while the NUMERIC fields do default honestly to 0.0, which is the documented
                ;;behaviour ("absent rows read as zero pending and zero last-rps checkpoint") and the
                ;;only part of a defaulted row that can be distinguished from a real one.
                (expect "<<T-STREAM-RT>> ...and only the NUMERIC fields reveal the default: 0.0 checkpoint"
                    0.0 (RPS.UR_FVT-RU|LastRps u f sc "NOSUCHTOKEN-98c486052a51"))

                ;;the non-identity readers in the same family. CORRECTED 2026-09-13: this used to
                ;;assert `boosted >= base`, which passed here only because BOTH are 0.0 for this
                ;;vault class -- a vacuous pass hiding a wrong claim. `total-base-score` and
                ;;`total-boosted-score` are documented as independent sums ("Sum of user base-scores"
                ;;/ "Sum of user boosted-scores"), not a multiplier relationship, so no ordering
                ;;between them is guaranteed. (The SCORE module's *-deb-* pair IS a decomposition and
                ;;IS pinned additively -- see modules/AQP.repl <<AQP-F5>>; these are not those.)
                ;;Only non-negativity is actually claimed, so only non-negativity is asserted.
                (expect "<<T-STREAM-RT>> the vault aggregates are all non-negative"
                    true (and (>= (RPS.UR_FVT|TotalBoostedScore f) 0.0)
                              (and (>= (RPS.UR_FVT|TotalBaseScore f) 0.0)
                                   (>= (RPS.UR_FVT|TotalNzsCount f) 0))))
                ;;UR_FVT-UP|IsPresent — the user-presence flag. Both arms, because a reader that
                ;;always answered true would pass the first alone.
                (expect "<<T-STREAM-RT>> UR_FVT-UP|IsPresent is true for a staker and false for a stranger"
                    [true false]
                    [(RPS.UR_FVT-UP|IsPresent f u)
                     (RPS.UR_FVT-UP|IsPresent f "definitely-not-a-staker")])
            ]
        )
    )
    ""
)
(commit-tx)
