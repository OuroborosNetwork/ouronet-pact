;;
;; REPL/Kursan/AQP-stream-tests.repl — dedicated behavioral tests for the TIME-STREAMED inject
;; (linear vesting). Boots a fresh vault with two funded stakers and drives block-time via env-chain-data.
;;   T-STREAM-01 · Late staker (S1): ANHD stakes @T0, stream 240/24h @T0, EMMA stakes @T0+12h → at T0+24h
;;                ANHD collects 180 (sole for h0-12 = 120, half of h12-24 = 60), EMMA collects 60. Proves late
;;                stakers capture only the post-join drip, and the drip-at-stake checkpoint is exact.
;; Legend: <(call)> invocation echo · <<T-STREAM-nn>> assertion tag.
;; Source: 1_SOVEREIGN/STAGE_02/2_Core/03_AQP/04_FVT.pact (C_InjectStream / XI_ReleaseStream)
;;
(print "")
(print "================================================================")
(print "FILE  REPL/Kursan/AQP-stream-tests.repl  —  streamed inject behavioral tests")
(print "================================================================")
(load "../Stage00_Sanboxes.repl")
(load "../Stage01_Tester.repl")
(load "../Stage_02/[0.1]_Interfaces.repl")
(load "../Stage_02/[2.1]_DpdcCore.repl")
(load "../Stage_02/[2.2]_DemiPad.repl")
(load "../Stage_02/[2.3]_EarningPools.repl")
(load "../Stage_02/[3]_Talos.repl")
(load "../Stage_02/[4.0]_Sovereign-Executor.repl")
(begin-tx "STREAM-BOOT - KBN slave")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(namespace "ouronet-ns")
(env-sigs [{ "key": "1a4e15d3c51e0b73e92644600487ba8eaae312e1a178b91801d54e13c1b350a5", "caps": [] }])
(load "../../2_SLAVE/Stage_02/02_KBunnies.pact")
(commit-tx)
(begin-tx "STREAM-BOOT - AQP-BOOT")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(namespace "ouronet-ns")
(env-sigs [{ "key": "1a4e15d3c51e0b73e92644600487ba8eaae312e1a178b91801d54e13c1b350a5", "caps": [] }])
(load "../../2_SLAVE/Stage_02/04_AQP-BOOT.pact")
(commit-tx)
(begin-tx "STREAM-BOOT - Step0")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(namespace "ouronet-ns")
(env-sigs [{ "key": "PK_AncientHodler", "caps": [] }])
(print (format "<(Step0)> => \"{}\"" [(AQP-BOOT.C_Step0_WireImcAndGovernor KST.ANHD)]))
(commit-tx)
(print "")
;;
;; ============================================================================
;; T-STREAM-FIXTURE — TF anchor on OURO + class-1 score + class-1 pool + vault FVT + reward link + score entity
;; ============================================================================
(begin-tx "T-STREAM-FIXTURE - vault + score + pool")
(namespace "ouronet-ns")
(env-gasmodel "table")(env-gaslimit 900000000)(env-gas 0)
(env-sigs
    [
        { "key": "PK_AncientHodler", "caps": [] }
        { "key": "6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263",
          "caps":
            [
                (coin.TRANSFER "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263" "k:50d6c59b21e5e6e55baecaa75a1007de37576bde12d8230dc82459cc01b9484b" 1000000.0)
                (coin.TRANSFER "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263" "k:0cb30c0121ff919266121a99ff9359871818932211df94dae4137c29bc0e8f7e" 1000000.0)
                (coin.TRANSFER "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263" "c:XM-pkmuB5XUQlp87ZYSbfKt8qzmHY6O2EHAzMRVBt3k" 1000000.0)
                (coin.TRANSFER "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263" "c:iQQFWj6gWtpGEzhM_O5ekW1QtnQQy55R8BRPGhj_0FU" 1000000.0)
            ]
        }
    ]
)
(print "--- [T-STREAM-FIXTURE · build vault] ---")
(let
    (
        (patron:string KST.ANHD)
        (ouro-id:string "OURO-98c486052a51")
        (ref-U|CT:module{OuronetConstantsV1} U|CT)
        (ref-TS02-C3:module{TalosStageTwo_ClientThreeV1} TS02-C3)
        (ref-FVT:module{AcquisitionFarmsVaultsTreasuriesV1} AQP-FVT)
        (ref-U|DALOS:module{UtilityDalosV1} U|DALOS)
        (score-id:string (ref-U|DALOS::UDC_Makeid "StreamScore"))
        (fvt-id:string (ref-U|DALOS::UDC_Makeid "StreamVault"))
        (pool-id:string (ref-U|DALOS::UDC_Makeid "StreamPool"))
    )
    ;; 1. anchor on OURO (promile 500 / ref 5000) — acnoi=true creates the boost-class
    (ref-TS02-C3::AQP-ANK|C_IssueTrueFungibleAnchor patron "StreamAnchor" ouro-id true "StreamBoost" 3 500.0 5000.0)
    ;; 2. class-1 score, class-1 pool, employ score
    (ref-TS02-C3::AQP-SCR|C_IssueTrueFungibleScore patron patron "StreamScore" 12 1.0)
    (ref-TS02-C3::AQP-POOL|C_Issue patron "StreamPool" ouro-id 1)
    (ref-TS02-C3::AQP-POOL|C_AddScore patron pool-id score-id)
    ;; 3. vault FVT + reward link (OURO) + score entity
    (ref-TS02-C3::AQP-FVT|C_Issue patron "StreamVault" patron 1 "|")
    (ref-TS02-C3::AQP-FVT|C_AddRewardLink patron fvt-id ouro-id false (ref-U|CT::CT_BAR))
    (ref-TS02-C3::AQP-FVT|C_AddScoreEntity patron fvt-id 1 score-id)
    (map print
        [ (format "<(vault stake-ready)> => {}" [(ref-FVT::URC_PoolEmployedScoresFvtStakeReady pool-id)])
          (expect "<<T-STREAM-FIXTURE>> vault stake-ready" true (ref-FVT::URC_PoolEmployedScoresFvtStakeReady pool-id)) ]))
(env-sigs [])
(commit-tx)
(print "")
;;
;; ============================================================================
;; T-STREAM-01 — Late staker (S1): stream 240/24h; ANHD @T0, EMMA @T0+12h → ANHD 180 / EMMA 60 @T0+24h
;; ============================================================================
(begin-tx "T-STREAM-01 - late staker 180/60")
(namespace "ouronet-ns")
(env-gasmodel "table")(env-gaslimit 900000000)(env-gas 0)
(let
    (
        (patron:string KST.ANHD)
        (anhd:string KST.ANHD)
        (emma:string KST.EMMA)
        (ouro-id:string "OURO-98c486052a51")
        (ref-U|DALOS:module{UtilityDalosV1} U|DALOS)
        (ref-DPTF:module{DemiourgosPactTrueFungibleV1} DPTF)
        (ref-TS01-C1:module{TalosStageOne_ClientOneV1} TS01-C1)
        (ref-TS02-C3:module{TalosStageTwo_ClientThreeV1} TS02-C3)
        (score-id:string (ref-U|DALOS::UDC_Makeid "StreamScore"))
        (fvt-id:string (ref-U|DALOS::UDC_Makeid "StreamVault"))
        (pool-id:string (ref-U|DALOS::UDC_Makeid "StreamPool"))
        (t0:time (time "2026-09-01T00:00:00Z"))
        (gs-key:string "6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263")
    )
    ;;==== T-STREAM-01 · 01 · @T0: ANHD stakes 100, then streams 240 / 24h ====
    (print "--- [T-STREAM-01 · 01 · @T0 ANHD stake 100 + C_InjectStream 240/24h] ---")
    (env-chain-data { "block-time": t0 })
    (env-sigs
        [ { "key": "PK_AncientHodler", "caps": [] }
          { "key": gs-key, "caps":
            [ (coin.TRANSFER (concat ["k:" gs-key]) "k:50d6c59b21e5e6e55baecaa75a1007de37576bde12d8230dc82459cc01b9484b" 1000000.0)
              (coin.TRANSFER (concat ["k:" gs-key]) "k:0cb30c0121ff919266121a99ff9359871818932211df94dae4137c29bc0e8f7e" 1000000.0)
              (coin.TRANSFER (concat ["k:" gs-key]) "c:XM-pkmuB5XUQlp87ZYSbfKt8qzmHY6O2EHAzMRVBt3k" 1000000.0)
              (coin.TRANSFER (concat ["k:" gs-key]) "c:iQQFWj6gWtpGEzhM_O5ekW1QtnQQy55R8BRPGhj_0FU" 1000000.0) ] } ])
    (ref-TS02-C3::AQP-POOL|C_StakeTrueFungible patron pool-id anhd anhd ouro-id 100.0)
    (ref-TS02-C3::AQP-FVT|C_InjectStream patron fvt-id ouro-id 240.0 86400)
    ;;==== T-STREAM-01 · 02 · @T0+12h: fund EMMA + EMMA stakes 100 (drip credits ANHD the h0-12 slice = 120) ====
    (print "--- [T-STREAM-01 · 02 · @T0+12h EMMA stake 100] ---")
    (env-chain-data { "block-time": (add-time t0 43200) })
    (env-sigs
        [ { "key": "PK_AncientHodler", "caps": [] }
          { "key": "PK_Emma", "caps": [] }
          { "key": gs-key, "caps":
            [ (coin.TRANSFER (concat ["k:" gs-key]) "k:50d6c59b21e5e6e55baecaa75a1007de37576bde12d8230dc82459cc01b9484b" 1000000.0)
              (coin.TRANSFER (concat ["k:" gs-key]) "k:0cb30c0121ff919266121a99ff9359871818932211df94dae4137c29bc0e8f7e" 1000000.0)
              (coin.TRANSFER (concat ["k:" gs-key]) "c:XM-pkmuB5XUQlp87ZYSbfKt8qzmHY6O2EHAzMRVBt3k" 1000000.0)
              (coin.TRANSFER (concat ["k:" gs-key]) "c:iQQFWj6gWtpGEzhM_O5ekW1QtnQQy55R8BRPGhj_0FU" 1000000.0) ] } ])
    (if (< (ref-DPTF::UR_AccountSupply ouro-id emma) 100.0)
        (ref-TS01-C1::DPTF|C_Transfer patron ouro-id anhd emma 100.0 true) true)
    (ref-TS02-C3::AQP-POOL|C_StakeTrueFungible patron pool-id emma emma ouro-id 100.0)
    ;;==== T-STREAM-01 · 03 · @T0+24h (finish): ANHD collects 180, EMMA collects 60 ====
    (print "--- [T-STREAM-01 · 03 · @T0+24h collect ANHD=180 / EMMA=60] ---")
    (env-chain-data { "block-time": (add-time t0 86400) })
    (env-sigs
        [ { "key": "PK_AncientHodler", "caps": [] }
          { "key": "PK_Emma", "caps": [] }
          { "key": gs-key, "caps":
            [ (coin.TRANSFER (concat ["k:" gs-key]) "k:50d6c59b21e5e6e55baecaa75a1007de37576bde12d8230dc82459cc01b9484b" 1000000.0)
              (coin.TRANSFER (concat ["k:" gs-key]) "k:0cb30c0121ff919266121a99ff9359871818932211df94dae4137c29bc0e8f7e" 1000000.0)
              (coin.TRANSFER (concat ["k:" gs-key]) "c:XM-pkmuB5XUQlp87ZYSbfKt8qzmHY6O2EHAzMRVBt3k" 1000000.0)
              (coin.TRANSFER (concat ["k:" gs-key]) "c:iQQFWj6gWtpGEzhM_O5ekW1QtnQQy55R8BRPGhj_0FU" 1000000.0) ] } ])
    (let ((anhd-pre:decimal (ref-DPTF::UR_AccountSupply ouro-id anhd)))
        (ref-TS02-C3::AQP-FVT|C_Collect anhd fvt-id 1 score-id ouro-id)
        (let ((anhd-payout:decimal (- (ref-DPTF::UR_AccountSupply ouro-id anhd) anhd-pre)))
            (map print
                [ (format "<<T-STREAM-01>> ANHD payout @24h = {}" [anhd-payout])
                  (expect (format "<<T-STREAM-01>> ANHD = 180 (120 sole h0-12 + 60 half h12-24) got={}" [anhd-payout]) true (and (> anhd-payout 179.99) (< anhd-payout 180.01))) ])))
    (let ((emma-pre:decimal (ref-DPTF::UR_AccountSupply ouro-id emma)))
        (ref-TS02-C3::AQP-FVT|C_Collect emma fvt-id 1 score-id ouro-id)
        (let ((emma-payout:decimal (- (ref-DPTF::UR_AccountSupply ouro-id emma) emma-pre)))
            (map print
                [ (format "<<T-STREAM-01>> EMMA payout @24h = {}" [emma-payout])
                  (expect (format "<<T-STREAM-01>> EMMA = 60 (only post-join half of h12-24) got={}" [emma-payout]) true (and (> emma-payout 59.99) (< emma-payout 60.01)))
                  (expect "<<T-STREAM-01>> stream pruned @24h (count 0)" 0 (AQP-FVT.UR_FVT-RG|StreamCount fvt-id ouro-id)) ])))
    (env-sigs [])
)
(commit-tx)
(print "")
;;
;; ============================================================================
;; T-STREAM-02 — Superposition (D4): two overlapping 24h streams BOTH pay during the overlap window.
;;   Reuses the 2-staker vault (ANHD 100 + EMMA 100, total 200). Requires the owner konto's Elite-tier cap >= 2.
;; ============================================================================
(begin-tx "T-STREAM-02 - superposition (two overlapping streams)")
(namespace "ouronet-ns")
(env-gasmodel "table")(env-gaslimit 900000000)(env-gas 0)
(let
    (
        (patron:string KST.ANHD)
        (anhd:string KST.ANHD)
        (emma:string KST.EMMA)
        (ouro-id:string "OURO-98c486052a51")
        (ref-U|DALOS:module{UtilityDalosV1} U|DALOS)
        (ref-DPTF:module{DemiourgosPactTrueFungibleV1} DPTF)
        (ref-TS02-C3:module{TalosStageTwo_ClientThreeV1} TS02-C3)
        (score-id:string (ref-U|DALOS::UDC_Makeid "StreamScore"))
        (fvt-id:string (ref-U|DALOS::UDC_Makeid "StreamVault"))
        (t2:time (time "2026-12-01T00:00:00Z"))
        (gs-key:string "6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263")
    )
    (print (format "<<T-STREAM-02>> owner (ANHD) stream-lane cap = {}" [(AQP-FVT.URC_MaxStreamLanes patron)]))
    (expect "<<T-STREAM-02>> owner cap >= 2 (needed for two concurrent streams)" true (>= (AQP-FVT.URC_MaxStreamLanes patron) 2))
    ;;==== T-STREAM-02 · 01 · @t2: stream A 240/24h ====
    (print "--- [T-STREAM-02 · 01 · @t2 stream A 240/24h] ---")
    (env-chain-data { "block-time": t2 })
    (env-sigs
        [ { "key": "PK_AncientHodler", "caps": [] }
          { "key": gs-key, "caps":
            [ (coin.TRANSFER (concat ["k:" gs-key]) "k:50d6c59b21e5e6e55baecaa75a1007de37576bde12d8230dc82459cc01b9484b" 1000000.0)
              (coin.TRANSFER (concat ["k:" gs-key]) "k:0cb30c0121ff919266121a99ff9359871818932211df94dae4137c29bc0e8f7e" 1000000.0)
              (coin.TRANSFER (concat ["k:" gs-key]) "c:XM-pkmuB5XUQlp87ZYSbfKt8qzmHY6O2EHAzMRVBt3k" 1000000.0)
              (coin.TRANSFER (concat ["k:" gs-key]) "c:iQQFWj6gWtpGEzhM_O5ekW1QtnQQy55R8BRPGhj_0FU" 1000000.0) ] } ])
    (ref-TS02-C3::AQP-FVT|C_InjectStream patron fvt-id ouro-id 240.0 86400)
    ;;==== T-STREAM-02 · 02 · @t2+12h: clear A's first half, then add stream B 240/24h (now 2 overlapping) ====
    (print "--- [T-STREAM-02 · 02 · @t2+12h clear + stream B 240/24h] ---")
    (env-chain-data { "block-time": (add-time t2 43200) })
    (env-sigs
        [ { "key": "PK_AncientHodler", "caps": [] }
          { "key": "PK_Emma", "caps": [] }
          { "key": gs-key, "caps":
            [ (coin.TRANSFER (concat ["k:" gs-key]) "k:50d6c59b21e5e6e55baecaa75a1007de37576bde12d8230dc82459cc01b9484b" 1000000.0)
              (coin.TRANSFER (concat ["k:" gs-key]) "k:0cb30c0121ff919266121a99ff9359871818932211df94dae4137c29bc0e8f7e" 1000000.0)
              (coin.TRANSFER (concat ["k:" gs-key]) "c:XM-pkmuB5XUQlp87ZYSbfKt8qzmHY6O2EHAzMRVBt3k" 1000000.0)
              (coin.TRANSFER (concat ["k:" gs-key]) "c:iQQFWj6gWtpGEzhM_O5ekW1QtnQQy55R8BRPGhj_0FU" 1000000.0) ] } ])
    (ref-TS02-C3::AQP-FVT|C_Collect anhd fvt-id 1 score-id ouro-id)
    (ref-TS02-C3::AQP-FVT|C_Collect emma fvt-id 1 score-id ouro-id)
    (ref-TS02-C3::AQP-FVT|C_InjectStream patron fvt-id ouro-id 240.0 86400)
    (expect "<<T-STREAM-02>> 2 streams active after B" 2 (AQP-FVT.UR_FVT-RG|StreamCount fvt-id ouro-id))
    ;;==== T-STREAM-02 · 03 · @t2+18h: ANHD collect for [12h,18h] must be 60 (A 60 + B 60 at total 200) ====
    ;;   Superposition proof: a SINGLE stream would give ANHD 30; both streams paying gives 60.
    (print "--- [T-STREAM-02 · 03 · @t2+18h ANHD collect = 60 (both streams pay)] ---")
    (env-chain-data { "block-time": (add-time t2 64800) })
    (let ((anhd-pre:decimal (ref-DPTF::UR_AccountSupply ouro-id anhd)))
        (ref-TS02-C3::AQP-FVT|C_Collect anhd fvt-id 1 score-id ouro-id)
        (let ((anhd-payout:decimal (- (ref-DPTF::UR_AccountSupply ouro-id anhd) anhd-pre)))
            (map print
                [ (format "<<T-STREAM-02>> ANHD [12h,18h] payout = {} (one stream would be 30)" [anhd-payout])
                  (expect (format "<<T-STREAM-02>> both streams pay in overlap → 60 got={}" [anhd-payout]) true (and (> anhd-payout 59.99) (< anhd-payout 60.01))) ])))
    (env-sigs [])
)
(commit-tx)
(print "")
(print "=== END AQP-stream-tests.repl ===")
