;; Verify Fix for DPDC Audit #47L (DPDC-F|C>REPURPOSE rejects empty nonces/amounts with a clear message)
;; and #51L (UEV_PrimordialSetDefinition/UEV_CompositeSetDefinition reject empty/oversized definitions
;; with a clear message instead of an opaque out-of-bounds crash).
(load "../Stage00_Sanboxes.repl")
(load "../Stage00a_StoaTests.repl")
(load "../Stage01_Tester.repl")
(load "../Stage02_Tester.repl")

;;||>>>>>>>>>>>>>>>>>>>>>>>>>
;;|| NEXT                   >
;;||>>>>>>>>>>>>>>>>>>>>>>>>>

(begin-tx "PROBE-47L-51L - empty-definition guards")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(namespace "ouronet-ns")
(env-sigs [{ "key": "PK_AncientHodler", "caps": [] }])
(let
    (
        (ref-TS02-C1:module{TalosStageTwo_ClientOneV2} TS02-C1)
        (ref-DPDC-UDC:module{DpdcUdcV2} DPDC-UDC)
        (owner:string KST.ANHD)
        (lumy:string KST.LUMY)
        (id:string "DHCD-98c486052a51")
        (type:object{DpdcUdcV2.URI|Type} (ref-DPDC-UDC::UDC_URI|Type true false false false false false false))
        (nd:object{DpdcUdcV2.DPDC|NonceData}
            (ref-DPDC-UDC::UDC_NonceData 0.0 0.0 "N" "N" (ref-DPDC-UDC::UDC_NoMetaData) type
                (ref-DPDC-UDC::UDC_ZeroURI|Data) (ref-DPDC-UDC::UDC_ZeroURI|Data) (ref-DPDC-UDC::UDC_ZeroURI|Data))
        )
    )
    (map print
        [
            ;;#47L: empty repurpose (0 nonces/amounts) rejected with the clear "Invalid Repurpose data"
            ;;message, not an opaque out-of-bounds crash several hops downstream.
            (expect-failure
                "<<PROBE-47L>> empty DPSF|C_RepurposeFragments (0 nonces) rejected cleanly"
                (ref-TS02-C1::DPSF|C_RepurposeFragments owner id owner lumy [] [])
            )
            ;;#51L: empty Primordial set-definition rejected cleanly (previously crashed with an opaque
            ;;out-of-bounds error, since (enumerate 0 -1) = [0 -1], not []).
            (expect-failure
                "<<PROBE-51L>> empty Primordial set-definition rejected cleanly (was an opaque crash)"
                (ref-TS02-C1::DPSF|C_DefinePrimordialSet owner id "EmptyProbe" 1.0 [] nd)
            )
            ;;#51L: empty Composite set-definition rejected cleanly.
            (expect-failure
                "<<PROBE-51L>> empty Composite set-definition rejected cleanly (was an opaque crash)"
                (ref-TS02-C1::DPSF|C_DefineCompositeSet owner id "EmptyProbe2" 1.0 [] nd)
            )
            ;;#51L: an oversized Primordial set-definition (21 positions > MAX_SET_DEFINITION_SIZE=20)
            ;;is rejected cleanly.
            (expect-failure
                "<<PROBE-51L>> oversized (21-position) Primordial set-definition rejected"
                (ref-TS02-C1::DPSF|C_DefinePrimordialSet owner id "OversizedProbe" 1.0
                    (make-list 21 (ref-DPDC-UDC::UDC_DPDC|AllowedNonceForSetPosition [1])) nd)
            )
        ]
    )
)
(commit-tx)
