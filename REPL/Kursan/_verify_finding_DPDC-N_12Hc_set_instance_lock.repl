;; Verification for DPDC Audit finding #12Hc: an already-minted NFT Set instance's own NonceData
;; (including <composition>, the field C_BreakNonFungibleSet trusts to know what's backing it) could be
;; directly overwritten via DPDC-N::C_UpdateNonces / the per-field C_Update* family (Nonce path, nost=true),
;; completely decoupled from what's actually held in <dpdc> escrow. Fix: DPDC-N::UEV_NotSetInstance rejects
;; any Nonce-path update (nost=true) targeting an NFT nonce with nonce-class != 0 (a Set instance) — the
;; Set-Class definition/template path (nost=false, C_DPNF|UpdateSetNonce*) is untouched, still fully
;; editable, and SFT Sets (which have exactly one shared nonce, never re-derived per Make) are unaffected.
(load "../Stage00_Sanboxes.repl")
(load "../Stage01_Tester.repl")
(load "../Stage_02/[0.1]_Interfaces.repl")
(load "../Stage_02/[2.1]_DpdcCore.repl")
(load "../Stage_02/[2.2]_DemiPad.repl")
(load "../Stage_02/[2.3]_EarningPools.repl")
(load "../Stage_02/[3]_Talos.repl")
(load "../Stage_02/[4.0]_Sovereign-Executor.repl")

;;====================================================================================================
;; TX-1: NFT — Make a Primordial Set, prove instance is locked, template stays editable, ordinary
;; primordial nonces are unaffected.
;;====================================================================================================
(begin-tx "PROBE-12Hc-NFT - lock a minted NFT Set instance, keep its Set-Class template editable")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(namespace "ouronet-ns")
(let
    (
        (ref-DALOS:module{OuronetDalosV2} DALOS)
        (owner:string KST.ANHD)
        (dpnf-price:decimal (ref-DALOS::UR_UsagePrice "dpnf"))
        (split-stoa:[decimal] (ref-DALOS::URC_SplitSTOAPrices owner dpnf-price))
    )
    (env-sigs
        [
            { "key": "PK_AncientHodler", "caps": [] }
            { "key": "6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263",
              "caps":
                [
                    (coin.TRANSFER "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263"
                        "k:50d6c59b21e5e6e55baecaa75a1007de37576bde12d8230dc82459cc01b9484b" (at 2 split-stoa))
                    (coin.TRANSFER "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263"
                        "k:0cb30c0121ff919266121a99ff9359871818932211df94dae4137c29bc0e8f7e" (at 0 split-stoa))
                    (coin.TRANSFER "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263"
                        "c:XM-pkmuB5XUQlp87ZYSbfKt8qzmHY6O2EHAzMRVBt3k" (at 3 split-stoa))
                    (coin.TRANSFER "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263"
                        "c:iQQFWj6gWtpGEzhM_O5ekW1QtnQQy55R8BRPGhj_0FU" (at 1 split-stoa))
                ]
            }
        ]
    )
)
(let
    (
        (ref-DPDC:module{DpdcV2} DPDC)
        (ref-DPDC-UDC:module{DpdcUdcV2} DPDC-UDC)
        (ref-TS02-C2:module{TalosStageTwo_ClientTwoV2} TS02-C2)
        (owner:string KST.ANHD)
        (creator:string KST.ANHD)
        (nd:object{DpdcUdcV2.DPDC|NonceData}
            (ref-DPDC-UDC::UDC_NonceData
                0.0 0.0 "n" "d" (ref-DPDC-UDC::UDC_NoMetaData)
                (ref-DPDC-UDC::UDC_URI|Type true false false false false false false)
                (ref-DPDC-UDC::UDC_URI|Data "ipfs://a" "" "" "" "" "" "")
                (ref-DPDC-UDC::UDC_ZeroURI|Data) (ref-DPDC-UDC::UDC_ZeroURI|Data)
            )
        )
    )
    (print (format "ISSUE RESULT = {}"
        [(ref-TS02-C2::C_DPNF|Issue owner owner creator "SetLockProbeNFT" "SLPN"
            true true true true true true true true)]))
    (let ((id:string "SLPN-98c486052a51"))
        ;; Create 5 primordial (class 0) nonces: each Set position needs >1 allowed choice, so position 1
        ;; allows {1,3}, position 2 allows {2,4}; nonce 5 stays a plain, never-set-involved control nonce.
        (print (format "CREATE 1 = {}" [(ref-TS02-C2::C_DPNF|Create owner id [nd])]))
        (print (format "CREATE 2 = {}" [(ref-TS02-C2::C_DPNF|Create owner id [nd])]))
        (print (format "CREATE 3 = {}" [(ref-TS02-C2::C_DPNF|Create owner id [nd])]))
        (print (format "CREATE 4 = {}" [(ref-TS02-C2::C_DPNF|Create owner id [nd])]))
        (print (format "CREATE 5 (control) = {}" [(ref-TS02-C2::C_DPNF|Create owner id [nd])]))
        ;; Define a Primordial Set: position 1 allows nonce 1 or 3, position 2 allows nonce 2 or 4.
        (print (format "DEFINE PRIMORDIAL SET = {}"
            [(ref-TS02-C2::C_DPNF|DefinePrimordialSet owner id "PairSet" 1.0
                [(ref-DPDC-UDC::UDC_DPDC|AllowedNonceForSetPosition [1 3]) (ref-DPDC-UDC::UDC_DPDC|AllowedNonceForSetPosition [2 4])] nd)]))
        ;; Make an instance combining nonces 1+2 -> spawns nonce 6, set-class 1.
        (print (format "MAKE SET = {}" [(ref-TS02-C2::C_DPNF|Make owner owner id [1 2] 1)]))
        (print (format "nonce-class of spawned instance (6) = {}" [(ref-DPDC::UR_NonceClass id false 6)]))
        ;; #12Hc negative: direct edit of the Set INSTANCE's own data must now be rejected.
        (print (expect-failure "<<12Hc-1>> C_UpdateNonceName on a Set instance nonce (6) is rejected"
            (ref-TS02-C2::C_DPNF|UpdateNonceName owner id owner 6 true "hijacked")))
        (print (expect-failure "<<12Hc-2>> C_UpdateNonceMetaData on a Set instance nonce (6) is rejected"
            (ref-TS02-C2::C_DPNF|UpdateNonceMetaData owner id owner 6 true {"composition" : [999]})))
        ;; #12Hc positive: the Set-CLASS template (nost=false path) stays fully editable.
        (print (format "<<12Hc-3>> C_UpdateSetNonceName on the Set-Class (1) template RESULT = {}"
            [(ref-TS02-C2::C_DPNF|UpdateSetNonceName owner id owner 1 true "Renamed Class Template")]))
        ;; Regression: an ordinary, never-set-involved primordial nonce (5, class 0) is still editable.
        (print (format "<<12Hc-4>> C_UpdateNonceName on ordinary primordial nonce (5) RESULT = {}"
            [(ref-TS02-C2::C_DPNF|UpdateNonceName owner id owner 5 true "Renamed Ordinary Nonce")]))
        ""
    )
)
(commit-tx)

;;====================================================================================================
;; TX-2: SFT — Make a Primordial Set, prove the (single, shared) SFT Set nonce is UNAFFECTED — still
;; directly editable, since SFT Sets have no per-instance composition to protect.
;;====================================================================================================
(begin-tx "PROBE-12Hc-SFT - confirm SFT Set nonces are unaffected by the NFT-only lock")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(namespace "ouronet-ns")
(let
    (
        (ref-DALOS:module{OuronetDalosV2} DALOS)
        (owner:string KST.ANHD)
        (dpsf-price:decimal (ref-DALOS::UR_UsagePrice "dpsf"))
        (split-stoa:[decimal] (ref-DALOS::URC_SplitSTOAPrices owner dpsf-price))
    )
    (env-sigs
        [
            { "key": "PK_AncientHodler", "caps": [] }
            { "key": "6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263",
              "caps":
                [
                    (coin.TRANSFER "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263"
                        "k:50d6c59b21e5e6e55baecaa75a1007de37576bde12d8230dc82459cc01b9484b" (at 2 split-stoa))
                    (coin.TRANSFER "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263"
                        "k:0cb30c0121ff919266121a99ff9359871818932211df94dae4137c29bc0e8f7e" (at 0 split-stoa))
                    (coin.TRANSFER "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263"
                        "c:XM-pkmuB5XUQlp87ZYSbfKt8qzmHY6O2EHAzMRVBt3k" (at 3 split-stoa))
                    (coin.TRANSFER "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263"
                        "c:iQQFWj6gWtpGEzhM_O5ekW1QtnQQy55R8BRPGhj_0FU" (at 1 split-stoa))
                ]
            }
        ]
    )
)
(let
    (
        (ref-DPDC-S:module{DpdcSetsV2} DPDC-S)
        (ref-DPDC-UDC:module{DpdcUdcV2} DPDC-UDC)
        (ref-TS01-C1:module{TalosStageTwo_ClientOneV2} TS02-C1)
        (owner:string KST.ANHD)
        (creator:string KST.ANHD)
        (nd:object{DpdcUdcV2.DPDC|NonceData}
            (ref-DPDC-UDC::UDC_NonceData
                0.0 0.0 "n" "d" (ref-DPDC-UDC::UDC_NoMetaData)
                (ref-DPDC-UDC::UDC_URI|Type true false false false false false false)
                (ref-DPDC-UDC::UDC_URI|Data "ipfs://a" "" "" "" "" "" "")
                (ref-DPDC-UDC::UDC_ZeroURI|Data) (ref-DPDC-UDC::UDC_ZeroURI|Data)
            )
        )
    )
    (print (format "ISSUE RESULT = {}"
        [(ref-TS01-C1::C_DPSF|Issue owner owner creator "SetLockProbeSFT" "SLPS"
            true true true true true true true true)]))
    (let ((id:string "SLPS-98c486052a51"))
        (print (format "CREATE 1 = {}" [(ref-TS01-C1::C_DPSF|Create owner id [5] [nd])]))
        (print (format "CREATE 2 = {}" [(ref-TS01-C1::C_DPSF|Create owner id [5] [nd])]))
        (print (format "DEFINE PRIMORDIAL SET = {}"
            [(ref-TS01-C1::C_DPSF|DefinePrimordialSet owner id "PairSet" 1.0
                [(ref-DPDC-UDC::UDC_DPDC|AllowedNonceForSetPosition [1]) (ref-DPDC-UDC::UDC_DPDC|AllowedNonceForSetPosition [2])] nd)]))
        (let ((set-nonce:integer (ref-DPDC-S::UR_NonceOfSet id 1)))
            (print (format "Set-Class 1's shared nonce = {}" [set-nonce]))
            (print (format "MAKE SET = {}" [(ref-TS01-C1::C_DPSF|Make owner owner id [1 2] 1 1)]))
            ;; The SFT Set's one shared nonce must remain directly editable — no per-instance concept exists.
            (print (format "<<12Hc-5>> C_UpdateNonceName on the SFT Set's shared nonce ({}) RESULT = {}"
                [set-nonce (ref-TS01-C1::C_DPSF|UpdateNonceName owner id owner set-nonce true "SFT Set OK")]))
        )
        ""
    )
)
(commit-tx)
