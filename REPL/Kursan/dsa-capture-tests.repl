                    (expect "<<TX-P3-11>> royalty pool = 500 (uptime shortfall)" 500.0 roy)
                    ;; the live half flows to the member: global Tier-1 available += 500
                    (expect "<<TX-P3-11>> global available = 500" 500.0 glob)
                    ;; member Tier-2 mini-vault credited its slice = 500
                    (expect "<<TX-P3-11>> member mini-vault available = 500" 500.0 memv)
                    ;; nothing escrowed — the divisor was live (S=3)
                    (expect "<<TX-P3-11>> zombie/escrow = 0" 0.0 zomb)
                    ;; conservation: member-live + royalty == inject
                    (expect "<<TX-P3-11>> conservation glob + royalty = 1000" 1000.0 (+ glob roy)) ]))
        )
    )
)
