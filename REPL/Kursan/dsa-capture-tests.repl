        (
            (fvt-id:string     (ref-U|DALOS::UDC_Makeid "P3DelegationVault"))
            (bronze-sid:string (ref-U|DALOS::UDC_Makeid (concat ["P3capAgency" "Bronze"])))
            (silver-sid:string (ref-U|DALOS::UDC_Makeid (concat ["P3capAgency" "Silver"])))
            (gold-sid:string   (ref-U|DALOS::UDC_Makeid (concat ["P3capAgency" "Golden"])))
        )
        (let ((triplet-id:string (ref-SCR::UC_ComputeTripletId bronze-sid silver-sid gold-sid)))
            (ref-TS02-C3::AQP-DSA|A_OracleWrite anhd fvt-id triplet-id 10 500)
            (ref-TS02-C3::AQP-FVT|C_Inject anhd fvt-id ouro 400.0)
            (map print
              [ (expect "<<TX-P3-19>> royalty accrued = 200 (uptime-500 shortfall)" 200.0 (ref-FVT::UR_FVT-RG|RoyaltyRewards fvt-id ouro)) ]))
    )
)
(env-sigs [])
(commit-tx)
(print "")
;;
;;|| NEXT >
;;|| Fuel the OURO swpair — reserves rise by 200, LP total supply unchanged (no LP minted), royalty pool zeroed.
;;
(begin-tx "TX-P3-20 - owner fuels a swpair with the royalty (no LP mint)")
(namespace "ouronet-ns")
(env-gasmodel "table")(env-gaslimit 90000000)(env-gas 0)
(env-chain-data { "block-time": (time "2027-11-06T06:00:00Z") })
(env-sigs
  [ { "key": "PK_AncientHodler", "caps": [] }
    { "key": "6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263"
    , "caps":
      [ (coin.TRANSFER "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263" "k:50d6c59b21e5e6e55baecaa75a1007de37576bde12d8230dc82459cc01b9484b" 1000000.0)
        (coin.TRANSFER "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263" "k:0cb30c0121ff919266121a99ff9359871818932211df94dae4137c29bc0e8f7e" 1000000.0)
        (coin.TRANSFER "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263" "c:XM-pkmuB5XUQlp87ZYSbfKt8qzmHY6O2EHAzMRVBt3k" 1000000.0)
        (coin.TRANSFER "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263" "c:iQQFWj6gWtpGEzhM_O5ekW1QtnQQy55R8BRPGhj_0FU" 1000000.0) ] } ])
(print "--- [TX-P3-20 · 01 · owner fuels swpair with royalty] ---")
(let
    (
        (anhd:string KST.ANHD)
        (ouro:string "OURO-98c486052a51")
        (swpair:string "W|DLK-98c486052a51|OURO-98c486052a51|DWK-98c486052a51")
        (ref-U|DALOS:module{UtilityDalosV1} U|DALOS)
        (ref-FVT:module{AcquisitionFarmsVaultsTreasuriesV1} AQP-FVT)
        (ref-SWP:module{SwapperV3} SWP)
        (ref-DPTF:module{DemiourgosPactTrueFungibleV1} DPTF)
        (ref-TS02-C3:module{TalosStageTwo_ClientThreeV1} TS02-C3)
    )
    (let ((fvt-id:string (ref-U|DALOS::UDC_Makeid "P3DelegationVault")))
        (let
            (
                (roy-before:decimal (ref-FVT::UR_FVT-RG|RoyaltyRewards fvt-id ouro))
                (reserves-before:decimal (fold (+) 0.0 (ref-SWP::UR_PoolTokenSupplies swpair)))
                (lp-supply-before:decimal (ref-DPTF::UR_Supply (ref-SWP::UR_TokenLP swpair)))
            )
            (ref-TS02-C3::AQP-DSA|A_FuelRoyalty anhd fvt-id ouro swpair)
            (let
                (
                    (reserves-added:decimal (- (fold (+) 0.0 (ref-SWP::UR_PoolTokenSupplies swpair)) reserves-before))
                    (lp-supply-after:decimal (ref-DPTF::UR_Supply (ref-SWP::UR_TokenLP swpair)))
                )
                (map print
                  [ ;; the whole royalty (200) was added to the swpair's reserves
                    (expect "<<TX-P3-20>> swpair reserves rose by the royalty" roy-before reserves-added)
                    (expect "<<TX-P3-20>> reserves rose by exactly 200" 200.0 reserves-added)
                    ;; NO LP was minted — fueling boosts LP value, it does not issue LP
                    (expect "<<TX-P3-20>> LP total supply unchanged (no LP minted)" lp-supply-before lp-supply-after)
                    (expect "<<TX-P3-20>> royalty pool zeroed after fuel" 0.0 (ref-FVT::UR_FVT-RG|RoyaltyRewards fvt-id ouro)) ]))
        )
    )
)
(env-sigs [])
(commit-tx)
(print "")
;;
;;|| NEXT >
;;|| GLOBAL external-oracle switch + variable oracle-validity (DSA module admin). The member's last oracle write
;;|| is fixed at 2027-11-06T05:00:00Z (TX-P3-19). First: shrink the validity window so a 2h-old write expires.
;;
(begin-tx "TX-P3-21 - variable oracle-validity")
(namespace "ouronet-ns")
(env-gasmodel "table")(env-gaslimit 30000000)(env-gas 0)
(env-chain-data { "block-time": (time "2027-11-06T07:00:00Z") })   ; +2h after the last oracle write
(env-sigs [ { "key": "PK_AncientHodler", "caps": [] } ])
(print "--- [TX-P3-21 · 01 · variable oracle-validity] ---")
(let
    (
        (ref-U|DALOS:module{UtilityDalosV1} U|DALOS)
        (ref-SCR:module{AcquisitionScoresV1} AQP-SCORE)
        (ref-FVT:module{AcquisitionFarmsVaultsTreasuriesV1} AQP-FVT)
    )
    (let
        (
            (fvt-id:string     (ref-U|DALOS::UDC_Makeid "P3DelegationVault"))
            (bronze-sid:string (ref-U|DALOS::UDC_Makeid (concat ["P3capAgency" "Bronze"])))
            (silver-sid:string (ref-U|DALOS::UDC_Makeid (concat ["P3capAgency" "Silver"])))
            (gold-sid:string   (ref-U|DALOS::UDC_Makeid (concat ["P3capAgency" "Golden"])))
        )
        (let ((triplet-id:string (ref-SCR::UC_ComputeTripletId bronze-sid silver-sid gold-sid)))
            ;; at the DEFAULT validity (25h) a 2h-old oracle is fresh → effective = stored weight (1.5)
            (expect "<<TX-P3-21>> 2h-old oracle fresh at default validity → 1.5" 1.5 (ref-FVT::URC_MemberEffectiveCapture fvt-id triplet-id))
            ;; shrink validity to 1h → the same 2h-old oracle is now expired → effective 0
            (AQP-DSA.A_SetOracleValidity 3600)
            (map print
              [ (expect "<<TX-P3-21>> oracle-validity set to 3600s" 3600 (ref-FVT::UR_OracleValidity))
                (expect "<<TX-P3-21>> 2h-old oracle EXPIRED at 1h validity → 0" 0.0 (ref-FVT::URC_MemberEffectiveCapture fvt-id triplet-id)) ])
            ;; restore the default window for the switch tests
            (AQP-DSA.A_SetOracleValidity 90000)
            ""
        )
    )
)
(env-sigs [])
(commit-tx)
(print "")
;;
;;|| NEXT >
;;|| Turn the GLOBAL external-oracle OFF: even a long-stale oracle is ignored — the stored capture-weight is trusted.
;;
(begin-tx "TX-P3-22 - external-oracle OFF (trust stored capture)")
(namespace "ouronet-ns")
(env-gasmodel "table")(env-gaslimit 30000000)(env-gas 0)
(env-chain-data { "block-time": (time "2027-11-07T10:00:00Z") })   ; +29h — well past the 25h window
(env-sigs [ { "key": "PK_AncientHodler", "caps": [] } ])
(print "--- [TX-P3-22 · 01 · external-oracle OFF] ---")
(let
    (
        (ref-U|DALOS:module{UtilityDalosV1} U|DALOS)
        (ref-SCR:module{AcquisitionScoresV1} AQP-SCORE)
        (ref-FVT:module{AcquisitionFarmsVaultsTreasuriesV1} AQP-FVT)
    )
    (let
        (
            (fvt-id:string     (ref-U|DALOS::UDC_Makeid "P3DelegationVault"))
            (bronze-sid:string (ref-U|DALOS::UDC_Makeid (concat ["P3capAgency" "Bronze"])))
            (silver-sid:string (ref-U|DALOS::UDC_Makeid (concat ["P3capAgency" "Silver"])))
            (gold-sid:string   (ref-U|DALOS::UDC_Makeid (concat ["P3capAgency" "Golden"])))
        )
        (let ((triplet-id:string (ref-SCR::UC_ComputeTripletId bronze-sid silver-sid gold-sid)))
            ;; oracle ON, 29h-stale → effective 0
            (expect "<<TX-P3-22>> stale oracle (ON) → 0" 0.0 (ref-FVT::URC_MemberEffectiveCapture fvt-id triplet-id))
            (AQP-DSA.A_ToggleExternalOracle false)
            (map print
              [ (expect "<<TX-P3-22>> external-oracle switched OFF" false (ref-FVT::UR_ExternalOracle))
                ;; oracle OFF → oracling bypassed → the stored capture-weight (1.5) is trusted despite staleness
                (expect "<<TX-P3-22>> oracle OFF → stored capture trusted = 1.5" 1.5 (ref-FVT::URC_MemberEffectiveCapture fvt-id triplet-id)) ])
            ""
        )
    )
)
(env-sigs [])
(commit-tx)
(print "")
