;; ================================================================
;; FILE  REPL/Kursan/dsa-hetero-split-tests.repl
;; ----------------------------------------------------------------
;; DSA Round B — heterogeneous quality-split proof on the OuroLpFarm triplet.
;;
;; Legend (log prefixes):
;;   <(...)>       one operation echo
;;   <<TX-HET-nn>> an assertion tag
;;
;; Source : 1_SOVEREIGN/STAGE_02/2_Core/03_AQP/04_FVT.pact
;;          (FVT|QualitySplit, C_SetQualitySplit, XI_1|HeterogeneousLaneRoute)
;;          1_SOVEREIGN/STAGE_02/3_Talos/04_TS02-C3.pact (AQP-FVT|C_SetQualitySplit)
;;
;; What it proves:
;;   1. Default mode is HOMOGENEOUS (unset row).
;;   2. Owner sets a HETEROGENEOUS matrix; readers round-trip it.
;;   3. Matrix all [1000 0 0] -> collect routes the WHOLE payout to token-0 (OURO);
;;      Auryn (t1) and Elite-Auryn (t2) stay ZERO (impossible under homogeneous,
;;      which would send the silver lane to Auryn and gold lane to Elite).
;;   4. O(1) reprice: flip matrix to all [0 1000 0] -> next collect routes the
;;      WHOLE payout to token-1 (Auryn via the Coil leg); OURO/Elite stay ~0.
;;   5. Guard rejections: non-owner set, a row not summing to 1000, and a set on
;;      a PLAIN (non-MULTIPLET_BASE) reward are all refused.
;; ================================================================
(load "../Stage00_Sanboxes.repl")
(load "../Stage01_Tester.repl")
(load "../Stage_02/[0.1]_Interfaces.repl")
(load "../Stage_02/[2.1]_DpdcCore.repl")
(load "../Stage_02/[2.2]_DemiPad.repl")
(load "../Stage_02/[2.3]_EarningPools.repl")
(load "../Stage_02/[3]_Talos.repl")
(load "../Stage_02/[4.0]_Sovereign-Executor.repl")
(load "../Stage_02/[5.2]_PopulateBloodshed.repl")
(load "../Stage_02/[5.1]_PopulateNosferatu.repl")
(load "../Stage_02/[5.4]_PopulateBunnies.repl")
(begin-tx "TX-AQP-BOOT - module")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(namespace "ouronet-ns")
(env-sigs [{"key": "1a4e15d3c51e0b73e92644600487ba8eaae312e1a178b91801d54e13c1b350a5", "caps": []}])
(load "../../2_CITIZEN/5_VaultsMinter/04_AQP-BOOT.pact")
(commit-tx)
(begin-tx "TX-AQP-BOOT - Step0")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(namespace "ouronet-ns")
(env-sigs [{ "key": "PK_AncientHodler", "caps": [] }])
(print (format "<(AQP-BOOT|C_Step0_WireImcAndGovernor)> => \"{}\"" [(AQP-BOOT.C_Step0_WireImcAndGovernor KST.ANHD)]))
(commit-tx)
(begin-tx "TX-BOOT-04 - AQP-BOOT Step4 core scores")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(namespace "ouronet-ns")
(let
    (
        (patron:string KST.ANHD)
        (owner-konto:string KST.ANHD)
        (ref-DALOS:module{OuronetDalosV1} DALOS)
        (split-stoa:[decimal] (ref-DALOS::URC_SplitSTOAPrices patron (* 4.0 (ref-DALOS::UR_UsagePrice "smart"))))
    )
    (env-sigs
        [
            { "key": "PK_AncientHodler", "caps": [] }
            { "key": "6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263",
              "caps":
                [
                    (coin.TRANSFER "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263" "k:50d6c59b21e5e6e55baecaa75a1007de37576bde12d8230dc82459cc01b9484b" (at 2 split-stoa))
                    (coin.TRANSFER "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263" "k:0cb30c0121ff919266121a99ff9359871818932211df94dae4137c29bc0e8f7e" (at 0 split-stoa))
                    (coin.TRANSFER "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263" "c:XM-pkmuB5XUQlp87ZYSbfKt8qzmHY6O2EHAzMRVBt3k" (at 3 split-stoa))
                    (coin.TRANSFER "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263" "c:iQQFWj6gWtpGEzhM_O5ekW1QtnQQy55R8BRPGhj_0FU" (at 1 split-stoa))
                ]
            }
        ]
    )
    (print (format "<(AQP-BOOT|C_Step4_CreateCoreScores)> => \"{}\"" [(AQP-BOOT.C_Step4_CreateCoreScores patron owner-konto)]))
)
(env-sigs [])
(commit-tx)
(begin-tx "TX-BOOT-05 - AQP-BOOT Step5 subsidiary scores")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(namespace "ouronet-ns")
(let
    (
        (patron:string KST.ANHD)
        (owner-konto:string KST.ANHD)
        (ref-DALOS:module{OuronetDalosV1} DALOS)
        (split-stoa:[decimal] (ref-DALOS::URC_SplitSTOAPrices patron (* 5.0 (ref-DALOS::UR_UsagePrice "smart"))))
    )
    (env-sigs
        [
            { "key": "PK_AncientHodler", "caps": [] }
            { "key": "6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263",
              "caps":
                [
                    (coin.TRANSFER "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263" "k:50d6c59b21e5e6e55baecaa75a1007de37576bde12d8230dc82459cc01b9484b" (at 2 split-stoa))
                    (coin.TRANSFER "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263" "k:0cb30c0121ff919266121a99ff9359871818932211df94dae4137c29bc0e8f7e" (at 0 split-stoa))
                    (coin.TRANSFER "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263" "c:XM-pkmuB5XUQlp87ZYSbfKt8qzmHY6O2EHAzMRVBt3k" (at 3 split-stoa))
                    (coin.TRANSFER "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263" "c:iQQFWj6gWtpGEzhM_O5ekW1QtnQQy55R8BRPGhj_0FU" (at 1 split-stoa))
                ]
            }
        ]
    )
    (print (format "<(AQP-BOOT|C_Step5_CreateSubsidiaryScores)> => \"{}\"" [(AQP-BOOT.C_Step5_CreateSubsidiaryScores patron owner-konto)]))
)
(env-sigs [])
(commit-tx)
(load "../Stage_02/[6.2.9]_AQP-BOOT-FULL.repl")
;;
;;||>>>>>>>>>>>>>>>>>>>>>>>>>
;;|| NEXT                   >
;;||>>>>>>>>>>>>>>>>>>>>>>>>>
;;
(begin-tx "TX-HET-01 - heterogeneous quality-split routing + O(1) reprice")
(print "")
(print "=== TX-HET-01 - OuroLpFarm triplet: heterogeneous matrix drives lane routing ====")
(namespace "ouronet-ns")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(let
    (
        (patron:string KST.ANHD)
        (owner:string KST.ANHD)
        (emma:string KST.EMMA)
        (ouro-id:string "OURO-98c486052a51")
        (kbn-id:string "KBN-98c486052a51")
        (auryn-rain-nonce:integer 75)
        (ref-U|DALOS:module{UtilityDalosV1} U|DALOS)
        (ref-DALOS:module{OuronetDalosV1} DALOS)
        (ref-DPDC:module{DpdcV1} DPDC)
        (ref-ANK:module{AcquisitionAnchorsV1} AQP-ANK)
        (ref-SWP:module{SwapperV3} SWP)
        (ref-DPTF:module{DemiourgosPactTrueFungibleV1} DPTF)
        (ref-TS01-C3:module{TalosStageOne_ClientThreeV3} TS01-C3)
        (ref-TS02-C2:module{TalosStageTwo_ClientTwoV1} TS02-C2)
        (ref-TS02-C3:module{TalosStageTwo_ClientThreeV1} TS02-C3)
        (ref-SCR:module{AcquisitionScoresV1} AQP-SCORE)
        (ref-FVT:module{AcquisitionFarmsVaultsTreasuriesV1} AQP-FVT)
        (ref-AQP:module{AcquisitionPoolsV1} AQP-POOL)
        (pool-id:string (ref-U|DALOS::UDC_Makeid "DHOuroLp"))
        (bunnies-pool:string (ref-U|DALOS::UDC_Makeid "DHBunnies"))
        (silver-score:string (ref-U|DALOS::UDC_Makeid "SilverSnakePower"))
        (bronze-score:string (ref-U|DALOS::UDC_Makeid "BronzeSnakePower"))
        (golden-score:string (ref-U|DALOS::UDC_Makeid "GoldenSnakePower"))
        (triplet-id:string (concat ["T" "|" bronze-score "|" silver-score "|" golden-score]))
        (auryn-id:string (ref-DALOS::UR_AurynID))
        (elite-auryn-id:string (ref-DALOS::UR_EliteAurynID))
        (farm-id:string (ref-U|DALOS::UDC_Makeid "OuroLpFarm"))
        (swpair:string "W|DLK-98c486052a51|OURO-98c486052a51|DWK-98c486052a51")
        (lp-id:string (ref-SWP::UR_TokenLP swpair))
        (inject-amt:decimal 100.0)
        (farm-class:integer (try -1 (ref-FVT::UR_FVT|FvtClass farm-id)))
        (pool-class:integer (try -1 (ref-AQP::UR_AQP|PoolAqpClass pool-id)))
        (lp-bal:decimal (ref-DPTF::UR_AccountSupply lp-id owner))
    )
    (env-sigs
        [
            { "key": "PK_AncientHodler", "caps": [] }
            { "key": "PK_Emma", "caps": [] }
            { "key": "PK_Lumy", "caps": [] }
        ]
    )
    (if (and (= farm-class 0) (>= pool-class 0))
        (let
            (
                (lp-bal-work:decimal lp-bal)
            )
            ;; ----- fixture: seed LP, get SilverSnakePower promile, TF-stake (mirrors CL03) -----
            (if (< lp-bal-work 100.0)
                (print (format "<(SWP|C_AddLiquidity seed)> => \"{}\"" [
                    (ref-TS01-C3::SWP|C_AddLiquidity patron patron swpair [50.0 50.0 50.0])
                ]))
                true
            )
            (let
                (
                    (lp-bal-final:decimal (ref-DPTF::UR_AccountSupply lp-id owner))
                    (stake-amt:decimal (if (> (ref-DPTF::UR_AccountSupply lp-id owner) 100.0) 100.0 (ref-DPTF::UR_AccountSupply lp-id owner)))
                )
                (enforce (>= lp-bal-final stake-amt) "HET: patron needs LP balance after seed")
                (let
                    (
                        (anhd-kbn:[integer] (ref-DPDC::URD_AccountNonces owner kbn-id false))
                        (prom-pre:decimal (ref-ANK::UR_UB|AggregatePromile owner silver-score))
                    )
                    (if (= prom-pre 0.0)
                        (let
                            (
                                (emma-kbn:[integer] (ref-DPDC::URD_AccountNonces emma kbn-id false))
                            )
                            (if (not (contains auryn-rain-nonce anhd-kbn))
                                (enforce (contains auryn-rain-nonce emma-kbn) "HET: EMMA must hold Auryn Rain KBN nonce 75")
                                true
                            )
                            (if (not (contains auryn-rain-nonce anhd-kbn))
                                (print (format "<(DPNF transfer AurynRain nonce {} EMMA to ANHD)> => \"{}\"" [auryn-rain-nonce
                                    (ref-TS02-C2::DPNF|C_TransferNonce patron kbn-id emma owner auryn-rain-nonce 1 false)
                                ]))
                                true
                            )
                            (print (format "<(C_StakeNonFungible DHBunnies KBN nonce {})> => \"{}\"" [auryn-rain-nonce
                                (ref-TS02-C3::AQP-POOL|CC_StakeNonFungibleCollectable
                                    patron bunnies-pool owner owner kbn-id [auryn-rain-nonce]
                                )
                            ]))
                        )
                        true
                    )
                    (enforce (> (ref-ANK::UR_UB|AggregatePromile owner silver-score) 0.0)
                        "HET needs SilverSnakePower promile - Auryn Rain KBN stake on DHBunnies")
                )
                (print (format "<(CC_StakeTrueFungible DHOuroLp LP {})> => \"{}\"" [stake-amt
                    (ref-TS02-C3::AQP-POOL|CC_StakeTrueFungible patron pool-id owner owner lp-id stake-amt)
                ]))
                ;; ---------------------------------------------------------------------------------
                ;; PROOF 1 - default mode is HOMOGENEOUS
                (map print
                    [
                        (format "<(default quality mode)> => \"{}\"" [(ref-FVT::UR_FVT-QS|Mode farm-id ouro-id)])
                        (expect "<<TX-HET-01>> default mode is HOMOGENEOUS"
                            "HOMOGENEOUS" (ref-FVT::UR_FVT-QS|Mode farm-id ouro-id))
                    ]
                )
                ;; PROOF 2 - owner sets HETEROGENEOUS all-to-token0 [1000 0 0]; readers round-trip
                (print "--- [TX-HET-01 - 01 - set HETEROGENEOUS all-to-OURO [1000 0 0]] ---")
                (print (format "<(AQP-FVT|C_SetQualitySplit HET [1000 0 0]x3)> => \"{}\"" [
                    (ref-TS02-C3::AQP-FVT|C_SetQualitySplit patron farm-id ouro-id "HETEROGENEOUS" [1000 0 0] [1000 0 0] [1000 0 0])
                ]))
                (map print
                    [
                        (format "<(mode / bronze-split)> => \"{} / {}\"" [(ref-FVT::UR_FVT-QS|Mode farm-id ouro-id) (ref-FVT::UR_FVT-QS|BronzeSplit farm-id ouro-id)])
                        (expect "<<TX-HET-01>> mode now HETEROGENEOUS"
                            "HETEROGENEOUS" (ref-FVT::UR_FVT-QS|Mode farm-id ouro-id))
                        (expect "<<TX-HET-01>> bronze-split round-trips [1000 0 0]"
                            [1000 0 0] (ref-FVT::UR_FVT-QS|BronzeSplit farm-id ouro-id))
                        (expect "<<TX-HET-01>> gold-split round-trips [1000 0 0]"
                            [1000 0 0] (ref-FVT::UR_FVT-QS|GoldSplit farm-id ouro-id))
                    ]
                )
                ;; PROOF 3 - inject then collect => WHOLE payout as OURO; Auryn/Elite ZERO
                (print "--- [TX-HET-01 - 02 - inject + collect: expect pure OURO] ---")
                (ref-TS02-C3::AQP-FVT|CC_Inject patron farm-id ouro-id inject-amt)
                (let
                    (
                        (ouro-pre:decimal (ref-DPTF::UR_AccountSupply ouro-id owner))
                        (auryn-pre:decimal (ref-DPTF::UR_AccountSupply auryn-id owner))
                        (elite-pre:decimal (ref-DPTF::UR_AccountSupply elite-auryn-id owner))
                    )
                    (ref-TS02-C3::AQP-FVT|CC_Collect owner farm-id 3 triplet-id ouro-id)
                    (let
                        (
                            (pay-ouro:decimal (- (ref-DPTF::UR_AccountSupply ouro-id owner) ouro-pre))
                            (pay-auryn:decimal (- (ref-DPTF::UR_AccountSupply auryn-id owner) auryn-pre))
                            (pay-elite:decimal (- (ref-DPTF::UR_AccountSupply elite-auryn-id owner) elite-pre))
                        )
                        (map print
                            [
                                (format "<(HET all-OURO payouts ouro/auryn/elite)> => \"{} {} {}\"" [pay-ouro pay-auryn pay-elite])
                                (expect (format "<<TX-HET-01>> HET all-to-t0: OURO payout>0 got={}" [pay-ouro]) true (> pay-ouro 0.0))
                                (expect (format "<<TX-HET-01>> HET all-to-t0: Auryn payout==0 got={}" [pay-auryn]) 0.0 pay-auryn)
                                (expect (format "<<TX-HET-01>> HET all-to-t0: Elite payout==0 got={}" [pay-elite]) 0.0 pay-elite)
                            ]
                        )
                    )
                )
                ;; PROOF 4 - O(1) reprice to all-to-token1 [0 1000 0] => next collect is pure Auryn (Coil leg)
                (print "--- [TX-HET-01 - 03 - reprice all-to-Auryn [0 1000 0] + inject/collect] ---")
                (ref-TS02-C3::AQP-FVT|C_SetQualitySplit patron farm-id ouro-id "HETEROGENEOUS" [0 1000 0] [0 1000 0] [0 1000 0])
                (ref-TS02-C3::AQP-FVT|CC_Inject patron farm-id ouro-id inject-amt)
                (let
                    (
                        (ouro-pre:decimal (ref-DPTF::UR_AccountSupply ouro-id owner))
                        (auryn-pre:decimal (ref-DPTF::UR_AccountSupply auryn-id owner))
                        (elite-pre:decimal (ref-DPTF::UR_AccountSupply elite-auryn-id owner))
                    )
                    (ref-TS02-C3::AQP-FVT|CC_Collect owner farm-id 3 triplet-id ouro-id)
                    (let
                        (
                            (pay-ouro:decimal (- (ref-DPTF::UR_AccountSupply ouro-id owner) ouro-pre))
                            (pay-auryn:decimal (- (ref-DPTF::UR_AccountSupply auryn-id owner) auryn-pre))
                            (pay-elite:decimal (- (ref-DPTF::UR_AccountSupply elite-auryn-id owner) elite-pre))
                        )
                        (map print
                            [
                                (format "<(HET all-Auryn payouts ouro/auryn/elite)> => \"{} {} {}\"" [pay-ouro pay-auryn pay-elite])
                                (expect (format "<<TX-HET-01>> HET all-to-t1: Auryn payout>0 got={}" [pay-auryn]) true (> pay-auryn 0.0))
                                (expect (format "<<TX-HET-01>> HET all-to-t1: Elite payout==0 got={}" [pay-elite]) 0.0 pay-elite)
                                (expect (format "<<TX-HET-01>> HET all-to-t1: OURO net ~0 got={}" [pay-ouro]) true (< (abs pay-ouro) 0.000001))
                            ]
                        )
                    )
                )
            )
        )
        (print (format "SKIP TX-HET-01: OuroLpFarm/DHOuroLp not provisioned (farm-class={} pool-class={})" [farm-class pool-class]))
    )
)
(env-sigs [])
(commit-tx)
(print "")
;;||>>>>>>>>>>>>>>>>>>>>>>>>>
;;|| NEXT                   >
;;||>>>>>>>>>>>>>>>>>>>>>>>>>
(print "")
(begin-tx "TX-HET-02 - guard rejections")
(print "")
(print "=== TX-HET-02 - quality-split guard rejections =================================")
(namespace "ouronet-ns")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(let
    (
        (patron:string KST.ANHD)
        (emma:string KST.EMMA)
        (ouro-id:string "OURO-98c486052a51")
        (ref-U|DALOS:module{UtilityDalosV1} U|DALOS)
        (ref-FVT:module{AcquisitionFarmsVaultsTreasuriesV1} AQP-FVT)
        (ref-TS02-C3:module{TalosStageTwo_ClientThreeV1} TS02-C3)
        (farm-id:string (ref-U|DALOS::UDC_Makeid "OuroLpFarm"))
        (farm-class:integer (try -1 (ref-FVT::UR_FVT|FvtClass farm-id)))
    )
    (if (= farm-class 0)
        (let ((_seq:bool true))
            (print "--- [TX-HET-02 - 01 - non-owner set rejected] ---")
            (env-sigs [{ "key": "PK_Emma", "caps": [] }])
            (map print
                [
                    (expect-failure "<<TX-HET-02>> non-owner cannot set quality split"
                        (ref-TS02-C3::AQP-FVT|C_SetQualitySplit emma farm-id ouro-id "HETEROGENEOUS" [1000 0 0] [1000 0 0] [1000 0 0]))
                ]
            )
            (print "--- [TX-HET-02 - 02 - a row not summing to 1000 rejected] ---")
            (env-sigs [{ "key": "PK_AncientHodler", "caps": [] }])
            (map print
                [
                    (expect-failure "<<TX-HET-02>> silver row [500 400 0] (sum 900) rejected"
                        (ref-TS02-C3::AQP-FVT|C_SetQualitySplit patron farm-id ouro-id "HETEROGENEOUS" [1000 0 0] [500 400 0] [1000 0 0]))
                    (expect-failure "<<TX-HET-02>> a 2-element row rejected"
                        (ref-TS02-C3::AQP-FVT|C_SetQualitySplit patron farm-id ouro-id "HETEROGENEOUS" [1000 0 0] [600 400] [1000 0 0]))
                    (expect-failure "<<TX-HET-02>> unknown mode rejected"
                        (ref-TS02-C3::AQP-FVT|C_SetQualitySplit patron farm-id ouro-id "BOGUS" [1000 0 0] [1000 0 0] [1000 0 0]))
                ]
            )
            (print "--- [TX-HET-02 - 03 - set on a PLAIN (non-multiplet) reward rejected] ---")
            (map print
                [
                    (expect-failure "<<TX-HET-02>> quality split on a non-existent reward link rejected"
                        (ref-TS02-C3::AQP-FVT|C_SetQualitySplit patron farm-id "VESTA-98c486052a51" "HETEROGENEOUS" [1000 0 0] [1000 0 0] [1000 0 0]))
                ]
            )
        )
        (print (format "SKIP TX-HET-02: OuroLpFarm not provisioned (farm-class={})" [farm-class]))
    )
)
(env-sigs [])
(commit-tx)
(print "")
(print "=== END dsa-hetero-split-tests.repl ============================================")
