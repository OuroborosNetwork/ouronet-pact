;; Verification for DPDC Audit finding #9H (DPDC · H1): C_DPSF|UpdatePendingBranding passed 7 args to
;; DPDC's 6-param C_UpdatePendingBranding, hard-aborting every single call. Fix: dropped the stray
;; leading `patron` argument in 01_TS02-C1.pact to match the correct DPNF sibling's call shape.
;; This probe: (1) proves the SFT path now actually succeeds (it never did before, on any input), and
;; (2) settles the secondary question flagged in the finding — does the cross-module call actually
;; resolve when `ref-DPDC` is typed `module{DpdcV2}` but C_UpdatePendingBranding is declared on the
;; different interface BrandingUsageTertiaryV2? (Answered empirically by whether this even loads.)
(load "../Stage00_Sanboxes.repl")
(load "../Stage01_Tester.repl")
(load "../Stage_02/[0.1]_Interfaces.repl")
(load "../Stage_02/[2.1]_DpdcCore.repl")
(load "../Stage_02/[2.2]_DemiPad.repl")
(load "../Stage_02/[2.3]_EarningPools.repl")
(load "../Stage_02/[3]_Talos.repl")
(load "../Stage_02/[4.0]_Sovereign-Executor.repl")

(begin-tx "PROBE-H1 - SFT branding update, real collection, must now succeed")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(namespace "ouronet-ns")
(env-sigs [{ "key": "PK_AncientHodler", "caps": [] }])
(let
    (
        (ref-BRD:module{BrandingV2} BRD)
        (ref-TS02-C1:module{TalosStageTwo_ClientOneV2} TS02-C1)
        (id:string "DHOC-98c486052a51")
    )
    (print (format "BEFORE pending logo = {}" [(ref-BRD::UR_Logo id true)]))
    (print (format "SFT UPDATE RESULT = {}"
        [(ref-TS02-C1::C_DPSF|UpdatePendingBranding KST.ANHD id
            "https://example.com/logo.png" "The best DPSF collection" "https://example.com" [])]))
    (print (format "AFTER pending logo = {}" [(ref-BRD::UR_Logo id true)]))
    (print (format "AFTER pending description = {}" [(ref-BRD::UR_Description id true)]))
)
(commit-tx)

(begin-tx "PROBE-H1 - NFT branding update (already-correct sibling) still works, for comparison")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(namespace "ouronet-ns")
(env-sigs [{ "key": "PK_Lumy", "caps": [] }])
(let
    (
        (ref-BRD:module{BrandingV2} BRD)
        (ref-TS02-C2:module{TalosStageTwo_ClientTwoV2} TS02-C2)
        (id:string "DHN-98c486052a51")
    )
    ;; DHN's collection-owner is LUMY (per genesis), not ANHD
    (print (format "NFT UPDATE RESULT = {}"
        [(ref-TS02-C2::C_DPNF|UpdatePendingBranding KST.LUMY id
            "https://example.com/nft-logo.png" "The best DPNF collection" "https://example.com" [])]))
    (print (format "AFTER NFT pending logo = {}" [(ref-BRD::UR_Logo id true)]))
)
(commit-tx)
