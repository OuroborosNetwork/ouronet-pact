;;
;; REPL/Kursan/AQP-scale-vacate.repl — VACATE at large population (50 distinct users).
;; Proves the vacate-v2 CCp_BatchDrainTrueFungible pagination over 50 stakers: drain in
;; rounds under the 2M chain limit, freeze holds between rounds, C_FinalizeVacate closes.
;; Reuses the VCTGAS synth-account generators ([6.2.6]_AQP-VCT-GAS-BASE.repl: synth 001..999).
;;
(print "")
(print "================================================================")
(print "FILE  REPL/Kursan/AQP-scale-vacate.repl  —  50-user vacate drain + gas")
(print "================================================================")
(load "../Stage00_Sanboxes.repl")
(load "../Stage01_Tester.repl")
(load "../Stage_02/[0.1]_Interfaces.repl")
(load "../Stage_02/[2.1]_DpdcCore.repl")
(load "../Stage_02/[2.2]_DemiPad.repl")
(load "../Stage_02/[2.3]_EarningPools.repl")
(load "../Stage_02/[3]_Talos.repl")
(load "../Stage_02/[4.0]_Sovereign-Executor.repl")
