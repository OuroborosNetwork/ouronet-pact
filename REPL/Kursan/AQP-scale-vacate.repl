    (let ((n:integer (length owners)))
        (env-gas 0)
        (ref-TS02-C3::AQP-POOL|CCp_BatchDrainTrueFungible patron pool-id ouro-id owners owners (make-list n 2.0))
        (let
            (
                (g:integer (env-gas))
                (remain:integer (at "leg-count" (AQP-VCT.URH_VacateTfInventory pool-id ouro-id)))
            )
            (map print
                [
                    (format "<<SCALE-VAC-R2>> drained-legs={} gas={} gas-per-leg={} fits-2M={} legs-remaining={}" [n g (/ g n) (<= g 2000000) remain])
                    (expect (format "<<SCALE-VAC-R2>> round fits 2M gas={}" [g]) true (<= g 2000000))
                    (expect (format "<<SCALE-VAC-R2>> legs remaining={}" [remain]) 20 remain)
                    (expect "<<SCALE-VAC-R2>> pool STILL vacating (freeze holds, not finalized)" true (ref-AQP::UR_AQP|PoolVacateInProgress pool-id))
                ]
            )
        )
    )
)
(env-sigs [])
(commit-tx)
(print "")
