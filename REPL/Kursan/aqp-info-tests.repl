;; ================================================================
;; FILE  REPL/Kursan/aqp-info-tests.repl
;; ----------------------------------------------------------------
;; AQP-INFO cost-preview verification. For each AQP-<MOD>|INFO_* function, assert its
;; reported cost (ignis-full / stoa-full) equals the EXACT source the execution bills
;; (the GAS| constant read cross-module, or UR_UsagePrice tier × multiplier). Billing is
;; enabled (DALOS|A_IgnisToggle) so the magnitudes are the real, non-subsidised numbers.
;;
;; Procedure: OuronetInformational/skills/aqp-info-module-procedure.md
;; ================================================================
(load "../Stage00_Sanboxes.repl")
(load "../Stage01_Tester.repl")
(load "../Stage_02/[0.1]_Interfaces.repl")
(load "../Stage_02/[2.1]_DpdcCore.repl")
(load "../Stage_02/[2.2]_DemiPad.repl")
(load "../Stage_02/[2.3]_EarningPools.repl")
(load "../Stage_02/[3]_Talos.repl")
(load "../Stage_02/[4.0]_Sovereign-Executor.repl")
(begin-tx "AQP-INFO - load module")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(namespace "ouronet-ns")
;;==== AQP-INFO - load module · 01 · env-sigs (caps) ==== =========================================
(print "--- [AQP-INFO - load module · 01 · env-sigs (caps)] ---")
(env-sigs [{ "key": "1a4e15d3c51e0b73e92644600487ba8eaae312e1a178b91801d54e13c1b350a5", "caps": [] }])
;;==== AQP-INFO - load module · 02 · load module ==== =============================================
(print "--- [AQP-INFO - load module · 02 · load module] ---")
(load "../../1_SOVEREIGN/STAGE_02/2_Core/03_AQP/09_AQP-INFO.pact")
(commit-tx)
;;
;;|| NEXT >
;;|| Billing (virtual IGNIS + native STOA) is already enabled by the standard boot, so the info
;;|| magnitudes below are the real, non-subsidised numbers. Assert virtual billing is live first.
;;
(begin-tx "AQP-INFO - confirm billing live")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
;;==== AQP-INFO - confirm billing live · 01 · namespace ==== ======================================
(print "--- [AQP-INFO - confirm billing live · 01 · namespace] ---")
(namespace "ouronet-ns")
;;==== AQP-INFO - confirm billing live · 02 · let / invocation ==== ===============================
(print "--- [AQP-INFO - confirm billing live · 02 · let / invocation] ---")
(let ((ref-IGNIS:module{IgnisCollectorV3} IGNIS))
    (expect "virtual IGNIS billing is live (costs are real, not subsidised)" false (ref-IGNIS::URC_IsVirtualGasZero)))
(commit-tx)
;;||>>>>>>>>>>>>>>>>>>>>>>>>>
;;|| NEXT                   >
;;||>>>>>>>>>>>>>>>>>>>>>>>>>
(print "")
(print "")
;;
;;==== AQP-INFO · ANK group cost-equality ====
(begin-tx "AQP-INFO-ANK - anchor group cost equality")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
;;==== AQP-INFO-ANK - anchor group cost equality · 01 · namespace ==== ============================
(print "--- [AQP-INFO-ANK - anchor group cost equality · 01 · namespace] ---")
(namespace "ouronet-ns")
(print "=== AQP-INFO ANK group: info cost == execution cost source ===")
;;==== AQP-INFO-ANK - anchor group cost equality · 02 · let / invocation ==== =====================
(print "--- [AQP-INFO-ANK - anchor group cost equality · 02 · let / invocation] ---")
(let
    (
        (anhd:string KST.ANHD)
        (ref-DALOS:module{OuronetDalosV2} DALOS)
        (ref-IGNIS:module{IgnisCollectorV3} IGNIS)
    )
    (let
        (
            (standard:decimal (ref-DALOS::UR_UsagePrice "standard"))
            ;; issue previews (acnoi false = 1x STOA, true = 2x STOA)
            (i-tf-link:object (AQP-INFO.INFO_AQP-ANK|IssueTrueFungibleAnchor anhd "AName" "DPTF-x" false "BC-x" 4 100.0 1000.0))
            (i-tf-new:object  (AQP-INFO.INFO_AQP-ANK|IssueTrueFungibleAnchor anhd "AName" "DPTF-x" true  "BCName" 4 100.0 1000.0))
            (i-sf:object      (AQP-INFO.INFO_AQP-ANK|IssueSemiFungibleAnchor anhd "AName" "DPSF-x" false "BC-x" 4 100.0 1))
            (i-nf:object      (AQP-INFO.INFO_AQP-ANK|IssueNonFungibleAnchor anhd "AName" "DPNF-x" true "BCName" 4 100.0 "rarity" "gold"))
            (i-nfs:object     (AQP-INFO.INFO_AQP-ANK|IssueNonFungibleSetAnchor anhd "AName" "DPNF-x" false "BC-x" 4 100.0 1))
            (i-rev-a:object   (AQP-INFO.INFO_AQP-ANK|RevokeAnchor anhd "ANK-x"))
            (i-rev-bc:object  (AQP-INFO.INFO_AQP-ANK|RevokeBoostClass anhd "BC-x"))
        )
        (map print
            [
                ;; IGNIS: every anchor issue is priced by UC_IgnisPrice(<talos op key>, "anchor").
                ;;
                ;; These four were HARDCODED at 1000.0 with the note "matches ANK C_Issue* gas-costs",
                ;; which was true when ANK carried inline gas constants. #76 replaced those with the
                ;; computed price (574.0 today), and this suite was ORPHANED at the time -- nothing
                ;; loaded it -- so the re-pricing could not fail it and the numbers silently rotted.
                ;; Now DERIVED from the same single source the exec bills through
                ;; (ANK::URCi_IssueAnchor -> IGNIS::UC_IgnisPrice op-key "anchor"), so this is a real
                ;; preview-vs-source invariant instead of a snapshot that any reprice invalidates.
                (expect "<<ANK>> TF issue ignis-full IS UC_IgnisPrice(C_IssueTrueFungibleAnchor, anchor)"
                    (ref-IGNIS::UC_IgnisPrice "AQP-ANK|C_IssueTrueFungibleAnchor" "anchor")
                    (at "ignis-full" (at "ignis" i-tf-link)))
                (expect "<<ANK>> SF issue ignis-full IS UC_IgnisPrice(C_IssueSemiFungibleAnchor, anchor)"
                    (ref-IGNIS::UC_IgnisPrice "AQP-ANK|C_IssueSemiFungibleAnchor" "anchor")
                    (at "ignis-full" (at "ignis" i-sf)))
                (expect "<<ANK>> NF issue ignis-full IS UC_IgnisPrice(C_IssueNonFungibleAnchor, anchor)"
                    (ref-IGNIS::UC_IgnisPrice "AQP-ANK|C_IssueNonFungibleAnchor" "anchor")
                    (at "ignis-full" (at "ignis" i-nf)))
                (expect "<<ANK>> NFSet issue ignis-full IS UC_IgnisPrice(C_IssueNonFungibleSetAnchor, anchor)"
                    (ref-IGNIS::UC_IgnisPrice "AQP-ANK|C_IssueNonFungibleSetAnchor" "anchor")
                    (at "ignis-full" (at "ignis" i-nfs)))
                ;;The four anchor types share ONE deterrence tier ("a FLAT 500 deterrence for every
                ;;anchor type", URCi_IssueAnchor's own doc), so they must agree with each other --
                ;;which the four derivations above would NOT catch on their own if the shared tier
                ;;were accidentally split per type.
                (expect "<<ANK>> all four anchor types share one price, per the flat-deterrence rule"
                    true (= 1 (length (distinct
                        [(at "ignis-full" (at "ignis" i-tf-link)) (at "ignis-full" (at "ignis" i-sf))
                         (at "ignis-full" (at "ignis" i-nf))      (at "ignis-full" (at "ignis" i-nfs))]))))
                ;; STOA: standard × (2 if acnoi else 1) — the exact ANK XE_CollectStoa amount
                (expect "<<ANK>> TF issue (link) stoa-full == standard" standard (at "stoa-full" (at "stoa" i-tf-link)))
                (expect "<<ANK>> TF issue (acnoi) stoa-full == 2×standard" (* 2.0 standard) (at "stoa-full" (at "stoa" i-tf-new)))
                (expect "<<ANK>> NF issue (acnoi) stoa-full == 2×standard" (* 2.0 standard) (at "stoa-full" (at "stoa" i-nf)))
                ;; revokes: no STOA, and IGNIS from their own #76 keys (was the pre-#76
                ;; "biggest" tier; same rot as the four issues above).
                (expect "<<ANK>> RevokeAnchor ignis-full IS UC_IgnisPrice(C_RevokeAnchor, revoke-anchor)"
                    (ref-IGNIS::UC_IgnisPrice "AQP-ANK|C_RevokeAnchor" "revoke-anchor")
                    (at "ignis-full" (at "ignis" i-rev-a)))
                (expect "<<ANK>> RevokeAnchor no STOA" 0.0 (at "stoa-full" (at "stoa" i-rev-a)))
                (expect "<<ANK>> RevokeBoostClass ignis-full IS UC_IgnisPrice(C_RevokeBoostClass, revoke-boost)"
                    (ref-IGNIS::UC_IgnisPrice "AQP-ANK|C_RevokeBoostClass" "revoke-boost")
                    (at "ignis-full" (at "ignis" i-rev-bc)))
                ;; the account-specific need is discount × full (non-negative, ≤ full)
                (expect "<<ANK>> TF issue ignis-need ≤ full" true
                    (<= (at "ignis-need" (at "ignis" i-tf-link)) (at "ignis-full" (at "ignis" i-tf-link))))
                (expect "<<ANK>> preview carries the execution function name in pre-text" true
                    (contains "Executes via TS02-C3.AQP-ANK|C_IssueTrueFungibleAnchor." (at "pre-text" i-tf-link)))
            ]
        )
    )
)
(commit-tx)
;;||>>>>>>>>>>>>>>>>>>>>>>>>>
;;|| NEXT                   >
;;||>>>>>>>>>>>>>>>>>>>>>>>>>
(print "")
(print "")
;;
;;==== AQP-INFO · SCORE group cost-equality ====
(begin-tx "AQP-INFO-SCR - score group cost equality")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
;;==== AQP-INFO-SCR - score group cost equality · 01 · namespace ==== =============================
(print "--- [AQP-INFO-SCR - score group cost equality · 01 · namespace] ---")
(namespace "ouronet-ns")
(print "=== AQP-INFO SCORE group: info cost == execution cost source ===")
;;==== AQP-INFO-SCR - score group cost equality · 02 · let / invocation ==== ======================
(print "--- [AQP-INFO-SCR - score group cost equality · 02 · let / invocation] ---")
(let
    (
        (anhd:string KST.ANHD)
        (ref-DALOS:module{OuronetDalosV2} DALOS)
    )
    (let
        (
            (smart:decimal (ref-DALOS::UR_UsagePrice "smart"))
            (medium:decimal (ref-DALOS::UR_UsagePrice "ignis|medium"))
            (biggest:decimal (ref-DALOS::UR_UsagePrice "ignis|biggest"))
            (big:decimal (ref-DALOS::UR_UsagePrice "ignis|big"))
            (i-issue:object (AQP-INFO.INFO_AQP-SCR|IssueTrueFungibleScore anhd anhd "S" 4 0.0))
            (i-model:object (AQP-INFO.INFO_AQP-SCR|IssueSingleScoreModel anhd "M" 3 "DHOC-x" 4 [-2] [10.0]))
        )
        (map print
            [
                ;;#76 MODEL. Each GAS|* constant is UC_IgnisDeter(<key>) -- the DETERRENCE ALONE.
                ;;The reported price is UC_IgnisPrice = deterrence + components, so the old
                ;;equality assertions were only ever true while components were zero. They were
                ;;written pre-#76, this suite was orphaned, and so the re-pricing could not fail
                ;;them. Restated as the relationship the model actually guarantees.
                (expect "<<SCR>> issue ignis-full is its GAS|ISSUE-SCORE deterrence PLUS components"
                    true (>= (at "ignis-full" (at "ignis" i-issue)) AQP-SCORE.GAS|ISSUE-SCORE))
                (expect "<<SCR>> issue the component surcharge is real, not a zero pass-through"
                    true (> (at "ignis-full" (at "ignis" i-issue)) AQP-SCORE.GAS|ISSUE-SCORE))
                (expect "<<SCR>> issue stoa-full == smart" smart (at "stoa-full" (at "stoa" i-issue)))
                ;;FINDING -- INFO_AQP-SCR|RotateScoreOwnership cannot PREVIEW an unknown score.
                ;;Every other preview in this block takes the same "-x" placeholder ids happily
                ;;(i-bclink, i-deb, i-sfdef and i-nfdef all pass "SCR-x"), which is this suite's
                ;;whole convention and shows the intent: a read-only cost preview should not need
                ;;the entity to exist. This one routes through AQP-SCORE::UR_SCR|ScoreOwnerKonto,
                ;;a HARD read, and dies with "No value found in table ... for key: SCR-x" -- naming
                ;;neither the preview nor the missing score. For a UI cost preview that is the
                ;;wrong failure mode: it cannot render "unknown score" gracefully, it just aborts.
                ;;
                ;;It also cost this suite its whole SCORE block: the binding was eager, inside the
                ;;let, so the abort killed every assertion below it too. That is why the two
                ;;`rotate` assertions that used to live here are gone -- they could never run.
                (expect-failure "<<SCR>> FINDING: the rotate PREVIEW aborts on an unknown score id"
                    "No value found in table"
                    (AQP-INFO.INFO_AQP-SCR|RotateScoreOwnership anhd "SCR-x" anhd))
                (expect "<<SCR>> model ignis-full is its GAS|ISSUE-SCORE-MODEL deterrence PLUS components"
                    true (>= (at "ignis-full" (at "ignis" i-model)) AQP-SCORE.GAS|ISSUE-SCORE-MODEL))
                (expect "<<SCR>> model the component surcharge is real, not a zero pass-through"
                    true (> (at "ignis-full" (at "ignis" i-model)) AQP-SCORE.GAS|ISSUE-SCORE-MODEL))
                ;;FINDING -- NINE of AQP-SCORE's URCi_ cost readers HARD-READ the score row, so the
                ;;INFO_ previews built on them cannot preview a score that does not exist yet:
                ;;
                ;;  URCi_RotateOwnership   URCi_Control            URCi_CreateBoostClassLink
                ;;  URCi_CreateBoostLink   URCi_EnableDebBoost     URCi_IssueTriplet
                ;;  URCi_IssueSemiFungibleScoreDefinition          URCi_IssueNonFungibleScoreDefinition
                ;;  URCi_IssueNonFungibleSetScoreDefinition
                ;;
                ;;all reach UR_SCR|ScoreOwnerKonto, a hard `read`, and abort with
                ;;"No value found in table ... for key: SCR-x" -- naming neither the preview nor the
                ;;missing score. The ANK group above previews happily on the same "-x" placeholders,
                ;;which is this suite's whole convention and shows the intended contract: a
                ;;READ-ONLY cost preview should not require the entity to exist. For a UI that is
                ;;the wrong failure mode -- it cannot render "unknown score" gracefully, it aborts.
                ;;
                ;;THIS IS WHY THE SCORE BLOCK HAD NEVER RUN. The previews were bound EAGERLY in the
                ;;let above, so the first abort killed every assertion below it -- the block was
                ;;dead, silently, and the suite was orphaned so nothing reported it. Recorded as
                ;;expect-failures (the honest state today) rather than deleted; giving this group
                ;;real coverage needs a score FIXTURE, which is P3 work and is why the group cannot
                ;;stay "read-only, no fixture" as its header claims.
                (expect-failure "<<SCR>> FINDING: boost-class-link preview aborts on an unknown score"
                    "No value found in table"
                    (AQP-INFO.INFO_AQP-SCR|CreateScoreBoostClassLink anhd "SCR-x" "BC-x"))
                (expect-failure "<<SCR>> FINDING: enable-deb-boost preview aborts on an unknown score"
                    "No value found in table"
                    (AQP-INFO.INFO_AQP-SCR|EnableDebBoost anhd "SCR-x"))
                (expect-failure "<<SCR>> FINDING: triplet preview aborts on unknown component scores"
                    "No value found in table"
                    (AQP-INFO.INFO_AQP-SCR|IssueTriplet anhd "B" "S" "G"))
                (expect-failure "<<SCR>> FINDING: SF score-definition preview aborts on an unknown score"
                    "No value found in table"
                    (AQP-INFO.INFO_AQP-SCR|IssueSemiFungibleScoreDefinition anhd "SCR-x" "DPSF-x" [1 2 3] [1.0 2.0 3.0]))
                (expect-failure "<<SCR>> FINDING: NF score-definition preview aborts on an unknown score"
                    "No value found in table"
                    (AQP-INFO.INFO_AQP-SCR|IssueNonFungibleScoreDefinition anhd "SCR-x" "DPNF-x" ["a" "b"] ["x" "y"] [1.0 2.0]))
                ;;...while the two previews that do NOT touch the score row work on placeholders,
                ;;which is what makes the nine above a defect rather than the convention.
                (expect "<<SCR>> the previews that avoid the score row DO preview on placeholders"
                    true (and (> (at "ignis-full" (at "ignis" i-issue)) 0.0)
                              (> (at "ignis-full" (at "ignis" i-model)) 0.0)))
                ;; all score ops carry no STOA except the issue ops
                (expect "<<SCR>> model no STOA" 0.0 (at "stoa-full" (at "stoa" i-model)))
            ]
        )
    )
)
(commit-tx)
;;||>>>>>>>>>>>>>>>>>>>>>>>>>
;;|| NEXT                   >
;;||>>>>>>>>>>>>>>>>>>>>>>>>>
(print "")
(print "")
;;
;;==== AQP-INFO · POOL config group cost-equality ====
(begin-tx "AQP-INFO-POOL - pool config cost equality")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
;;==== AQP-INFO-POOL - pool config cost equality · 01 · namespace ==== ============================
(print "--- [AQP-INFO-POOL - pool config cost equality · 01 · namespace] ---")
(namespace "ouronet-ns")
(print "=== AQP-INFO POOL config group: info cost == execution cost source ===")
;;==== AQP-INFO-POOL - pool config cost equality · 02 · let / invocation ==== =====================
(print "--- [AQP-INFO-POOL - pool config cost equality · 02 · let / invocation] ---")
(let
    (
        (anhd:string KST.ANHD)
        (ref-DALOS:module{OuronetDalosV2} DALOS)
    )
    (let
        (
            (smart:decimal (ref-DALOS::UR_UsagePrice "smart"))
            (i-issue:object (AQP-INFO.INFO_AQP-POOL|Issue anhd "P" "DHOC-x" 3))
            (i-add:object (AQP-INFO.INFO_AQP-POOL|AddScore anhd "POOL-x" "SCR-x"))
            (i-rev:object (AQP-INFO.INFO_AQP-POOL|RevokeScore anhd "POOL-x" "SCR-x"))
            (i-en:object (AQP-INFO.INFO_AQP-POOL|EnablePoolStake anhd "POOL-x"))
            (i-tf:object (AQP-INFO.INFO_AQP-POOL|SyncTrueFungibleAnchors anhd "BEN-x" "DPTF-x"))
            (i-sf:object (AQP-INFO.INFO_AQP-POOL|SyncSemiFungibleAnchors anhd "BEN-x" "DPSF-x"))
        )
        (map print
            [
                ;;#76 MODEL. Each GAS|* constant is UC_IgnisDeter(<key>) -- the DETERRENCE ALONE.
                ;;The reported price is UC_IgnisPrice = deterrence + components, so the old
                ;;equality assertions were only ever true while components were zero. They were
                ;;written pre-#76, this suite was orphaned, and so the re-pricing could not fail
                ;;them. Restated as the relationship the model actually guarantees.
                (expect "<<POOL>> issue ignis-full is its GAS|ISSUE-POOL deterrence PLUS components"
                    true (>= (at "ignis-full" (at "ignis" i-issue)) AQP-POOL.GAS|ISSUE-POOL))
                (expect "<<POOL>> issue the component surcharge is real, not a zero pass-through"
                    true (> (at "ignis-full" (at "ignis" i-issue)) AQP-POOL.GAS|ISSUE-POOL))
                (expect "<<POOL>> issue stoa-full == smart" smart (at "stoa-full" (at "stoa" i-issue)))
                (expect "<<POOL>> add-score ignis-full is its GAS|ADD-SCORE deterrence PLUS components"
                    true (>= (at "ignis-full" (at "ignis" i-add)) AQP-POOL.GAS|ADD-SCORE))
                (expect "<<POOL>> add-score the component surcharge is real, not a zero pass-through"
                    true (> (at "ignis-full" (at "ignis" i-add)) AQP-POOL.GAS|ADD-SCORE))
                (expect "<<POOL>> revoke-score ignis-full is its GAS|REVOKE-SCORE deterrence PLUS components"
                    true (>= (at "ignis-full" (at "ignis" i-rev)) AQP-POOL.GAS|REVOKE-SCORE))
                (expect "<<POOL>> revoke-score the component surcharge is real, not a zero pass-through"
                    true (> (at "ignis-full" (at "ignis" i-rev)) AQP-POOL.GAS|REVOKE-SCORE))
                (expect "<<POOL>> enable-stake ignis-full is its GAS|SET-POOL-STAKE deterrence PLUS components"
                    true (>= (at "ignis-full" (at "ignis" i-en)) AQP-POOL.GAS|SET-POOL-STAKE))
                (expect "<<POOL>> enable-stake the component surcharge is real, not a zero pass-through"
                    true (> (at "ignis-full" (at "ignis" i-en)) AQP-POOL.GAS|SET-POOL-STAKE))
                (expect "<<POOL>> sync-TF base ignis-full is its GAS|SYNC-TF-ANCHORS deterrence PLUS components"
                    true (>= (at "ignis-full" (at "ignis" i-tf)) AQP-POOL.GAS|SYNC-TF-ANCHORS))
                (expect "<<POOL>> sync-TF base the component surcharge is real, not a zero pass-through"
                    true (> (at "ignis-full" (at "ignis" i-tf)) AQP-POOL.GAS|SYNC-TF-ANCHORS))
                (expect "<<POOL>> sync-SF base ignis-full is its GAS|SYNC-COLLECTABLE-ANCHORS deterrence PLUS components"
                    true (>= (at "ignis-full" (at "ignis" i-sf)) AQP-POOL.GAS|SYNC-COLLECTABLE-ANCHORS))
                (expect "<<POOL>> sync-SF base the component surcharge is real, not a zero pass-through"
                    true (> (at "ignis-full" (at "ignis" i-sf)) AQP-POOL.GAS|SYNC-COLLECTABLE-ANCHORS))
                (expect "<<POOL>> add-score no STOA" 0.0 (at "stoa-full" (at "stoa" i-add)))
            ]
        )
    )
)
(commit-tx)
