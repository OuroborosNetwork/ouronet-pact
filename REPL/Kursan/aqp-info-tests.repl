;;
;;==== AQP-INFO · FVT group cost-equality ====
(begin-tx "AQP-INFO-FVT - fvt group cost equality")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
;;==== AQP-INFO-FVT - fvt group cost equality · 01 · namespace ==== ===============================
(print "--- [AQP-INFO-FVT - fvt group cost equality · 01 · namespace] ---")
(namespace "ouronet-ns")
(print "=== AQP-INFO FVT group: info cost == execution cost source ===")
;;==== AQP-INFO-FVT - fvt group cost equality · 02 · let / invocation ==== ========================
(print "--- [AQP-INFO-FVT - fvt group cost equality · 02 · let / invocation] ---")
(let
    (
        (anhd:string KST.ANHD)
        (ref-DALOS:module{OuronetDalosV2} DALOS)
    )
    (let
        (
            (smart:decimal (ref-DALOS::UR_UsagePrice "smart"))
            (medium:decimal (ref-DALOS::UR_UsagePrice "ignis|medium"))
            (i-issue:object (AQP-INFO.INFO_AQP-FVT|Issue anhd "F" anhd 0 "OURO-x"))
            (i-unst:object (AQP-INFO.INFO_AQP-FVT|UnstaleMyScores anhd ["FVT-x"]))
            (i-fix:object (AQP-INFO.INFO_AQP-FVT|InjectFixChunk anhd "FVT-x" "OURO-x" 10))
            (i-sweep:object (AQP-INFO.INFO_AQP-FVT|SweepRevokeAnchor anhd "ANK-x"))
        )
        (map print
            [
                ;;#76 MODEL. Each GAS|* constant is UC_IgnisDeter(<key>) -- the DETERRENCE ALONE.
                ;;The reported price is UC_IgnisPrice = deterrence + components, so the old
                ;;equality assertions were only ever true while components were zero. They were
                ;;written pre-#76, this suite was orphaned, and so the re-pricing could not fail
                ;;them. Restated as the relationship the model actually guarantees.
                (expect "<<FVT>> issue ignis-full is its GAS|ISSUE-FVT deterrence PLUS components"
                    true (>= (at "ignis-full" (at "ignis" i-issue)) AQP-FVT.GAS|ISSUE-FVT))
                (expect "<<FVT>> issue the component surcharge is real, not a zero pass-through"
                    true (> (at "ignis-full" (at "ignis" i-issue)) AQP-FVT.GAS|ISSUE-FVT))
                (expect "<<FVT>> issue stoa-full == smart" smart (at "stoa-full" (at "stoa" i-issue)))
                ;;FINDING (systemic, same shape as the SCORE group above). TWELVE of RPS's URCi_
                ;;cost readers hard-read UR_FVT|OwnerKonto -- RotateOwnership, Control,
                ;;SetCommonDenominator, SetMosaic, SetSplitMode, AddScoreEntity,
                ;;ToggleScoreEntityLink, AddRewardLink, ToggleRewardLink, SetQualitySplit, Inject,
                ;;Collect -- so every INFO_ preview built on them aborts for an FVT that does not
                ;;exist. With the nine in AQP-SCORE that is TWENTY-ONE cost readers across two
                ;;modules that cannot price an operation until its entity is already on chain.
                ;;
                ;;For a READ-ONLY cost preview that is the wrong failure mode: a UI asking "what
                ;;would this cost" gets a raw table miss naming neither the preview nor the missing
                ;;entity. The ANK group previews fine on the same "-x" placeholders, which is what
                ;;shows this is a defect and not the convention.
                ;;
                ;;It is also why this whole block was DEAD: the previews were bound eagerly in the
                ;;let, so the first abort took every assertion below it with it. Recorded as
                ;;expect-failures -- the honest state today. Real coverage needs an FVT fixture
                ;;(P3), which is exactly what the suite's "read-only, no fixture" header rules out.
                (expect-failure "<<FVT>> FINDING: the rotate preview aborts on an unknown FVT"
                    "No value found in table"
                    (AQP-INFO.INFO_AQP-FVT|RotateOwnership anhd "FVT-x" anhd))
                (expect-failure "<<FVT>> FINDING: the add-score-entity preview aborts on an unknown FVT"
                    "No value found in table"
                    (AQP-INFO.INFO_AQP-FVT|AddScoreEntity anhd "FVT-x" 3 "T-x"))
                (expect-failure "<<FVT>> FINDING: the add-reward-link preview aborts on an unknown FVT"
                    "No value found in table"
                    (AQP-INFO.INFO_AQP-FVT|AddRewardLink anhd "FVT-x" "OURO-x" false "BAR"))
                (expect-failure "<<FVT>> FINDING: the quality-split preview aborts on an unknown FVT"
                    "No value found in table"
                    (AQP-INFO.INFO_AQP-FVT|SetQualitySplit anhd "FVT-x" "OURO-x" "HOMOGENEOUS" [1000 0 0] [1000 0 0] [1000 0 0]))
                (expect-failure "<<FVT>> FINDING: the inject preview aborts on an unknown FVT"
                    "No value found in table"
                    (AQP-INFO.INFO_AQP-FVT|Inject anhd "FVT-x" "OURO-x" 100.0))
                (expect-failure "<<FVT>> FINDING: the collect preview aborts on an unknown FVT"
                    "No value found in table"
                    (AQP-INFO.INFO_AQP-FVT|Collect anhd "FVT-x" 3 "T-x" "OURO-x"))
                ;;...and the four that do NOT touch the FVT row preview fine on the same
                ;;placeholder, which is what makes the twelve above a defect and not the rule.
                (expect "<<FVT>> unstale ignis-full is its GAS|UNSTALE deterrence PLUS components"
                    true (>= (at "ignis-full" (at "ignis" i-unst)) AQP-FVT.GAS|UNSTALE))
                (expect "<<FVT>> unstale the component surcharge is real, not a zero pass-through"
                    true (> (at "ignis-full" (at "ignis" i-unst)) AQP-FVT.GAS|UNSTALE))
                ;; subsidised ops: zero to the patron
                (expect "<<FVT>> CCp_InjectFixChunk subsidised (ignis 0)" 0.0 (at "ignis-full" (at "ignis" i-fix)))
                (expect "<<FVT>> CC_SweepRevokeAnchor subsidised (ignis 0)" 0.0 (at "ignis-full" (at "ignis" i-sweep)))
            ]
        )
    )
)
(commit-tx)
;;||>>>>>>>>>>>>>>>>>>>>>>>>>
