;;||>>>>>>>>>>>>>>>>>>>>>>>>>
(print "")
(print "")
;;
;;==== AQP-INFO · DSA + MTX group cost-equality ====
(begin-tx "AQP-INFO-DSA - dsa + mtx cost equality")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(env-data { "gg": { "keys": ["gk"], "pred": "keys-all" } })
;;==== AQP-INFO-DSA - dsa + mtx cost equality · 01 · namespace ==== ===============================
(print "--- [AQP-INFO-DSA - dsa + mtx cost equality · 01 · namespace] ---")
(namespace "ouronet-ns")
(print "=== AQP-INFO DSA + MTX groups: info cost == execution cost source ===")
;;==== AQP-INFO-DSA - dsa + mtx cost equality · 02 · let / invocation ==== ========================
(print "--- [AQP-INFO-DSA - dsa + mtx cost equality · 02 · let / invocation] ---")
(let
    (
        (anhd:string KST.ANHD)
        (g:guard (read-keyset "gg"))
    )
    (let
        (
            (i-def:object (AQP-INFO.INFO_AQP-DSA|DefineDelegationVault anhd "FVT-x" "M-x" 2000))
            (i-open:object (AQP-INFO.INFO_AQP-DSA|OpenAgency anhd "FVT-x" "POOL-x" "T-x" 100 "DHOC-x" [-2]))
            (i-rec:object (AQP-INFO.INFO_AQP-DSA|RecomputeCapture anhd "FVT-x" "T-x"))
            (i-auth:object (AQP-INFO.INFO_AQP-DSA|SetOracleAuth anhd "FVT-x" g))
            (i-tog:object (AQP-INFO.INFO_AQP-DSA|ToggleExternalOracle false))
            ;;#P2: was called with (anhd false). It is a CHAIN-WIDE GOV switch and takes only
            ;;<on:bool> -- there is no patron, because there is nobody to bill. Another arity that
            ;;drifted while this suite was orphaned and nothing type-checked the call.
            (i-tog-unused:bool (= 1 1))
            (i-fee:object (AQP-INFO.INFO_AQP-DSA|SetAgencyFee anhd "FVT-x" "T-x" 200))
            (i-mtxsweep:object (AQP-INFO.INFO_AQP-MTX|2SweepRevokeAnchor anhd "ANK-x"))
        )
        (map print
            [
                ;;#76 MODEL. Each GAS|* constant is UC_IgnisDeter(<key>) -- the DETERRENCE ALONE.
                ;;The reported price is UC_IgnisPrice = deterrence + components, so the old
                ;;equality assertions were only ever true while components were zero. They were
                ;;written pre-#76, this suite was orphaned, and so the re-pricing could not fail
                ;;them. Restated as the relationship the model actually guarantees.
                (expect "<<DSA>> define-vault ignis-full is its GAS|DEFINE-VAULT deterrence PLUS components"
                    true (>= (at "ignis-full" (at "ignis" i-def)) AQP-DSA.GAS|DEFINE-VAULT))
                (expect "<<DSA>> define-vault the component surcharge is real, not a zero pass-through"
                    true (> (at "ignis-full" (at "ignis" i-def)) AQP-DSA.GAS|DEFINE-VAULT))
                (expect "<<DSA>> open-agency base ignis-full is its GAS|OPEN-AGENCY deterrence PLUS components"
                    true (>= (at "ignis-full" (at "ignis" i-open)) AQP-DSA.GAS|OPEN-AGENCY))
                (expect "<<DSA>> open-agency base the component surcharge is real, not a zero pass-through"
                    true (> (at "ignis-full" (at "ignis" i-open)) AQP-DSA.GAS|OPEN-AGENCY))
                (expect "<<DSA>> recompute-capture ignis-full is its GAS|RECOMPUTE-CAPTURE deterrence PLUS components"
                    true (>= (at "ignis-full" (at "ignis" i-rec)) AQP-DSA.GAS|RECOMPUTE-CAPTURE))
                (expect "<<DSA>> recompute-capture the component surcharge is real, not a zero pass-through"
                    true (> (at "ignis-full" (at "ignis" i-rec)) AQP-DSA.GAS|RECOMPUTE-CAPTURE))
                (expect "<<DSA>> set-oracle-auth ignis-full is its GAS|SET-ORACLE-AUTH deterrence PLUS components"
                    true (>= (at "ignis-full" (at "ignis" i-auth)) AQP-DSA.GAS|SET-ORACLE-AUTH))
                (expect "<<DSA>> set-oracle-auth the component surcharge is real, not a zero pass-through"
                    true (> (at "ignis-full" (at "ignis" i-auth)) AQP-DSA.GAS|SET-ORACLE-AUTH))
                (expect-failure "<<DSA>> FINDING: the fuel-royalty preview aborts on an unknown pool"
                    "No value found in table"
                    (AQP-INFO.INFO_AQP-DSA|FuelRoyalty anhd "FVT-x" "OURO-x" "W|a|b|c"))
                ;;FINDING (same shape again, third module). AQP-DSA::URCi_WithdrawRoyaltyFull
                ;;reaches RPS::UR_FVT|OwnerKonto, so the royalty-withdraw PREVIEW also aborts for an
                ;;FVT that does not exist. Twenty-two cost readers now, across AQP-SCORE, RPS and
                ;;AQP-DSA -- the pattern is the module family's, not one function's.
                (expect-failure "<<DSA>> FINDING: the withdraw-royalty preview aborts on an unknown FVT"
                    "No value found in table"
                    (AQP-INFO.INFO_AQP-DSA|WithdrawRoyalty anhd "FVT-x" "OURO-x"))
                (expect "<<DSA>> set-agency-fee ignis-full is its GAS|SET-AGENCY-FEE deterrence PLUS components"
                    true (>= (at "ignis-full" (at "ignis" i-fee)) AQP-DSA.GAS|SET-AGENCY-FEE))
                (expect "<<DSA>> set-agency-fee the component surcharge is real, not a zero pass-through"
                    true (> (at "ignis-full" (at "ignis" i-fee)) AQP-DSA.GAS|SET-AGENCY-FEE))
                (expect "<<DSA>> toggle-external-oracle GOV (ignis 0)" 0.0 (at "ignis-full" (at "ignis" i-tog)))
                ;;#76 MODEL. Each GAS|* constant is UC_IgnisDeter(<key>) -- the DETERRENCE ALONE.
                ;;The reported price is UC_IgnisPrice = deterrence + components, so the old
                ;;equality assertions were only ever true while components were zero. They were
                ;;written pre-#76, this suite was orphaned, and so the re-pricing could not fail
                ;;them. Restated as the relationship the model actually guarantees.
                (expect-failure "<<MTX>> FINDING: the 2-step inject preview aborts on an unknown FVT"
                    "No value found in table"
                    (AQP-INFO.INFO_AQP-MTX|2Inject anhd "FVT-x" "OURO-x" 100.0))
                (expect "<<MTX>> 2-sweep subsidised (ignis 0)" 0.0 (at "ignis-full" (at "ignis" i-mtxsweep)))
                ;;FUNCTION COVERAGE (G6) — the ZERO half of `INFO_AQP-POOL|AbortVacate`.
                ;;This preview quotes "Costs you nothing" for an op that visibly calls
                ;;`IGNIS::XE_CollectIgnis patron (VCT::C_AbortVacate pool-id)`. That is correct, because
                ;;`C_AbortVacate` returns `UC_EmptyOc` and collecting an empty cumulator collects
                ;;nothing — but it is exactly the shape that WAS a defect in three other previews
                ;;(`INFO_EQUITY|IssueCompany`, `INFO_SWP|ToggleFeeLock`, `INFO_ATS|ToggleParameterLock`,
                ;;all of which quoted a literal zero for a currency their op really charged). So the
                ;;zero is asserted rather than assumed.
                ;;
                ;;The other half of the proof — that the op really charges nothing when it runs — is
                ;;measured in `Stage_02/[6.2.5]_AQP-VCT.repl <<TX-VCT-L03>>`, against a live abort.
                ;;It cannot live here: this file has no vacate-in-progress pool.
                ;;
                ;;UPDATE — the proof is no longer split. `Stage_02/[6.5.1]_AQP-INFO-GROUNDTRUTH.repl
                ;;<<TX-INFO-GT-ABORT>>` now does BOTH halves in one place, because the drain blocks in
                ;;that file leave `InfoGt*DrPool` vacate-in-progress BY DESIGN (`CCp_BatchDrain*`
                ;;begins a vacate and deliberately does not finalize). That supplies a live abort
                ;;inside a chain that DOES load `AQP-INFO` — exactly what was missing when this note
                ;;was written. A stated impossibility is only ever true of the fixtures that existed
                ;;at the time; re-check it when the fixtures move.
                ;;The assertion below is kept: it is cheap, and it is the only check of this preview
                ;;that runs in chains which never reach the groundtruth file.
                (expect "<<POOL>> INFO_AQP-POOL|AbortVacate quotes zero IGNIS — measured against a live abort in [6.2.5] <<TX-VCT-L03>>"
                    0.0 (at "ignis-need" (at "ignis" (AQP-INFO.INFO_AQP-POOL|AbortVacate anhd "SfStakePool-98c486052a51"))))
                (expect "<<POOL>> ...and zero STOA too"
                    0.0 (at "stoa-need" (at "stoa" (AQP-INFO.INFO_AQP-POOL|AbortVacate anhd "SfStakePool-98c486052a51"))))
            ]
        )
    )
)
(commit-tx)
(print "")
(print "=== END aqp-info-tests.repl (ANK+SCORE+POOL+FVT+DSA+MTX groups green) ===")
