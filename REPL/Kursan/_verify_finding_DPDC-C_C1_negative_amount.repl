;;
;; REPL/Kursan/_verify_finding_DPDC-C_C1_negative_amount.repl
;; Scratch / adversarial-verification script for DPDC Audit finding #1C (DPDC-C · C1):
;;   "no floor/sign check on `amount` in Credit/Debit — a negative amount mints supply from nothing."
;; Not a canonical test — see REPL/Kursan/README.md. Probe only: does a real, signed
;; DPSF|C_TransferNonce call with a NEGATIVE amount increase the sender's own balance instead
;; of decreasing it (and/or corrupt the receiver's balance negative)?
;;
(load "../Stage00_Sanboxes.repl")
(load "../Stage01_Tester.repl")
(load "../Stage_02/[0.1]_Interfaces.repl")
(load "../Stage_02/[2.1]_DpdcCore.repl")
(load "../Stage_02/[2.2]_DemiPad.repl")
(load "../Stage_02/[2.3]_EarningPools.repl")
(load "../Stage_02/[3]_Talos.repl")
(load "../Stage_02/[4.0]_Sovereign-Executor.repl")

(begin-tx "PROBE-C1 - negative amount transfer")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(namespace "ouronet-ns")
(env-sigs [{ "key": "PK_AncientHodler", "caps": [] }])
(let
    (
        (ref-DPDC:module{DpdcV1} DPDC)
        (ref-TS02-C1:module{TalosStageTwo_ClientOneV1} TS02-C1)
        (id:string "DHOC-98c486052a51")
        (anhd:string KST.ANHD)
        (emma:string KST.EMMA)
    )
    (print (format "BEFORE anhd nonce1 supply = {}" [(ref-DPDC::UR_AccountNonceSupply anhd id true 1)]))
    (print (format "BEFORE anhd nonce2 supply = {}" [(ref-DPDC::UR_AccountNonceSupply anhd id true 2)]))
    (print (format "BEFORE emma nonce1 supply = {}" [(ref-DPDC::UR_AccountNonceSupply emma id true 1)]))
    (print (format "BEFORE emma nonce2 supply = {}" [(ref-DPDC::UR_AccountNonceSupply emma id true 2)]))
    (print "--- calling DPSF|C_TransferNonces anhd -> emma, [nonce1=100 (legit, keeps aggregate IGNIS fee positive), nonce2=-50 (the exploit leg)] — POST-FIX, must now be rejected ---")
    (print
        (expect-failure
            "POST-FIX <<DPDC C1>> negative-amount leg (nonce2=-50) rejected at UEV_AmountsForTransfer"
            (ref-TS02-C1::DPSF|C_TransferNonces anhd id anhd emma [1 2] [100 -50] false)
        )
    )
    (print (format "AFTER (rejected tx) anhd nonce1 supply = {}" [(ref-DPDC::UR_AccountNonceSupply anhd id true 1)]))
    (print (format "AFTER (rejected tx) anhd nonce2 supply = {}" [(ref-DPDC::UR_AccountNonceSupply anhd id true 2)]))
    (print (format "AFTER (rejected tx) emma nonce1 supply = {}" [(ref-DPDC::UR_AccountNonceSupply emma id true 1)]))
    (print (format "AFTER (rejected tx) emma nonce2 supply = {}" [(ref-DPDC::UR_AccountNonceSupply emma id true 2)]))
    (print "--- control: a normal, fully-legit transfer must still work post-fix ---")
    (print (format "LEGIT TRANSFER RESULT = {}"
        [(ref-TS02-C1::DPSF|C_TransferNonce anhd id anhd emma 1 25 false)]))
    (print (format "AFTER legit transfer anhd nonce1 supply = {}" [(ref-DPDC::UR_AccountNonceSupply anhd id true 1)]))
    (print (format "AFTER legit transfer emma nonce1 supply = {}" [(ref-DPDC::UR_AccountNonceSupply emma id true 1)]))
)
(commit-tx)
