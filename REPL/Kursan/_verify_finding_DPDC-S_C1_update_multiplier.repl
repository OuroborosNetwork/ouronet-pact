;; Verification for DPDC Audit finding #7C (DPDC-S · C1): C_UpdateSetMultiplier crashed unconditionally
;; on every call — a `let` type-annotation bug (current-multiplier bound :string against a :decimal
;; return). Fixed at the time by correcting the annotation to :decimal, proven below against a real,
;; genesis-defined set-class (Wonder Coach, Bronze = set-class 1, multiplier 1.0).
;;
;; SUPERSEDED by DPDC Audit #15H (2026-08-22): C_UpdateSetMultiplier (DPDC-S, plus the DPNF/DPSF Talos
;; wrappers, DPDC-S|C>MULTIPLIER, XI_Multiplier, XI_U|SetMultiplier) was removed entirely — score-multiplier
;; is now immutable after Define, same as the Set-Class recipe, so it can never go stale. The Update-path
;; proof below (second tx) documents what #7C fixed at the time but no longer reflects live code; kept for
;; the audit trail, not runnable as-is post-#15H. The baseline read (first tx) still works.
(load "../Stage00_Sanboxes.repl")
(load "../Stage01_Tester.repl")
(load "../Stage_02/[0.1]_Interfaces.repl")
(load "../Stage_02/[2.1]_DpdcCore.repl")
(load "../Stage_02/[2.2]_DemiPad.repl")
(load "../Stage_02/[2.3]_EarningPools.repl")
(load "../Stage_02/[3]_Talos.repl")
(load "../Stage_02/[4.0]_Sovereign-Executor.repl")

(begin-tx "PROBE-C7 - baseline read: Wonder Coach set-class 1 (Bronze) multiplier")
(namespace "ouronet-ns")
(let ((ref-DPDC-S:module{DpdcSetsV1} DPDC-S) (id:string "DHWC-98c486052a51"))
    (print (format "BEFORE multiplier = {}" [(ref-DPDC-S::UR_SetMultiplier id true 1)]))
)
(commit-tx)

