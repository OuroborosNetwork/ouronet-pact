;; Verification for DPDC Audit finding #7C (DPDC-S · C1): C_UpdateSetMultiplier crashes unconditionally
;; on every call — a `let` type-annotation bug (current-multiplier bound :string against a :decimal
;; return). Fix: annotation corrected to :decimal. This probe proves the function actually works now,
;; against a real, genesis-defined set-class (Wonder Coach, Bronze = set-class 1, multiplier 1.0).
(load "../Stage00_Sanboxes.repl")
(load "../Stage01_Tester.repl")
(load "../Stage_02/[0.1]_Interfaces.repl")
(load "../Stage_02/[2.1]_DpdcCore.repl")
(load "../Stage_02/[2.2]_DemiPad.repl")
(load "../Stage_02/[2.3]_EarningPools.repl")
(load "../Stage_02/[3]_Talos.repl")
(load "../Stage_02/[4.0]_Sovereign-Executor.repl")

(begin-tx "PROBE-C7 - baseline read: Wonder Coach set-class 1 (Bronze) multiplier")
(namespace "ouronet-ns")
(let ((ref-DPDC-S:module{DpdcSetsV1} DPDC-S) (id:string "DHWC-98c486052a51"))
    (print (format "BEFORE multiplier = {}" [(ref-DPDC-S::UR_SetMultiplier id true 1)]))
)
(commit-tx)

(begin-tx "PROBE-C7 - C_UpdateSetMultiplier on a real set-class, must now succeed")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(namespace "ouronet-ns")
(env-sigs [{ "key": "PK_AncientHodler", "caps": [] }])
(let
    (
        (ref-DPDC-S:module{DpdcSetsV1} DPDC-S)
        (ref-TS02-C1:module{TalosStageTwo_ClientOneV1} TS02-C1)
        (id:string "DHWC-98c486052a51")
    )
    (print (format "UPDATE RESULT = {}"
        [(ref-TS02-C1::DPSF|C_UpdateSetMultiplier KST.ANHD id 1 1.5)]))
    (print (format "AFTER multiplier = {}" [(ref-DPDC-S::UR_SetMultiplier id true 1)]))
    ;; control: "must differ from current" check should still correctly reject a same-value update
    (print
        (expect-failure
            "same-value update correctly rejected (current-multiplier now readable as decimal)"
            (ref-TS02-C1::DPSF|C_UpdateSetMultiplier KST.ANHD id 1 1.5)
        )
    )
)
(commit-tx)
