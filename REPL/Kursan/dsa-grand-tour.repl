;;|| NEXT >
;;|| GT-08 — the two chain-wide GOV oracle switches through Talos (A_SetOracleValidity / A_ToggleExternalOracle).
;;
(begin-tx "GT-08 - global GOV oracle switches (Talos)")
(namespace "ouronet-ns")
(env-gasmodel "table")(env-gaslimit 30000000)(env-gas 0)
(env-sigs [ { "key": "PK_AncientHodler", "caps": [] } ])
(print "--- [GT-08 - 01 - global oracle switches] ---")
(let
    (
        (ref-FVT:module{AcquisitionFarmsVaultsTreasuriesV1} AQP-FVT)
        (ref-TS02-C3:module{TalosStageTwo_ClientThreeV1} TS02-C3)
    )
    (ref-TS02-C3::A_AQP-DSA|SetOracleValidity 90000)
    (ref-TS02-C3::A_AQP-DSA|ToggleExternalOracle false)
    (map print
      [ (expect "<<GT-08>> oracle-validity set to 90000s (Talos GOV wrapper)" 90000 (ref-FVT::UR_OracleValidity))
        (expect "<<GT-08>> external-oracle switched OFF (Talos GOV wrapper)" false (ref-FVT::UR_ExternalOracle)) ])
    (ref-TS02-C3::A_AQP-DSA|ToggleExternalOracle true)
    (print (expect "<<GT-08>> external-oracle switched back ON" true (ref-FVT::UR_ExternalOracle))))
(env-sigs [])
(commit-tx)
(print "")
