;;
;;|| NEXT >
;;|| GT-05 — HETEROGENEOUS split all [1000 0 0] (every lane -> OURO raw), inject 5000, collect: fee two-track PROVEN
;;|| through the MULTIPLET collect branch. operator 1400 OURO (own 900 + fee 500, FIRST/independent), delegators 1800.
;;
(begin-tx "GT-05 - hetero split all-OURO + inject + collect (fee 10%)")
(namespace "ouronet-ns")
(env-gasmodel "table")(env-gaslimit 150000000)(env-gas 0)
(env-chain-data { "block-time": (time "2027-12-01T03:00:00Z") })
(env-sigs
  [ { "key": "PK_AncientHodler", "caps": [] }
    { "key": "PK_Emma", "caps": [] }
    { "key": "PK_Lumy", "caps": [] }
    { "key": "6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263"
    , "caps":
      [ (coin.TRANSFER "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263" "k:50d6c59b21e5e6e55baecaa75a1007de37576bde12d8230dc82459cc01b9484b" 1000000.0)
        (coin.TRANSFER "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263" "k:0cb30c0121ff919266121a99ff9359871818932211df94dae4137c29bc0e8f7e" 1000000.0)
        (coin.TRANSFER "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263" "c:XM-pkmuB5XUQlp87ZYSbfKt8qzmHY6O2EHAzMRVBt3k" 1000000.0)
        (coin.TRANSFER "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263" "c:iQQFWj6gWtpGEzhM_O5ekW1QtnQQy55R8BRPGhj_0FU" 1000000.0) ] } ])
(print "--- [GT-05 - 01 - set hetero split + inject + collect] ---")
(let
    (
        (anhd:string KST.ANHD) (emma:string KST.EMMA) (lumy:string KST.LUMY)
        (ouro:string "OURO-98c486052a51")
        (ref-U|DALOS:module{UtilityDalosV1} U|DALOS)
        (ref-SCR:module{AcquisitionScoresV1} AQP-SCORE)
        (ref-DPTF:module{DemiourgosPactTrueFungibleV1} DPTF)
        (ref-FVT:module{AcquisitionFarmsVaultsTreasuriesV1} AQP-FVT)
        (ref-TS02-C3:module{TalosStageTwo_ClientThreeV1} TS02-C3)
    )
    (let
        (
            (fvt-id:string  (ref-U|DALOS::UDC_Makeid "GtVault"))
            (bsid:string (ref-U|DALOS::UDC_Makeid (concat ["GtAgency" "Bronze"])))
            (ssid:string (ref-U|DALOS::UDC_Makeid (concat ["GtAgency" "Silver"])))
            (gsid:string (ref-U|DALOS::UDC_Makeid (concat ["GtAgency" "Golden"])))
        )
        (let ((triplet-id:string (ref-SCR::UC_ComputeTripletId bsid ssid gsid)))
            ;; heterogeneous, every lane -> token-0 (OURO) raw: the MULTIPLET collect degenerates to a plain OURO
            ;; transfer, so the exact two-track fee amounts are assertable while the hetero branch is exercised.
            (ref-TS02-C3::C_AQP-FVT|SetQualitySplit anhd fvt-id ouro "HETEROGENEOUS" [1000 0 0] [1000 0 0] [1000 0 0])
            (expect "<<GT-05>> mode is HETEROGENEOUS on the agency reward" "HETEROGENEOUS" (ref-FVT::UR_FVT-QS|Mode fvt-id ouro))
            (ref-TS02-C3::CC_AQP-FVT|Inject anhd fvt-id ouro 5000.0)
            ;; OPERATOR collects FIRST, independently of any delegator
            (let ((op0:decimal (ref-DPTF::UR_AccountSupply ouro anhd)))
                (ref-TS02-C3::CC_AQP-FVT|Collect anhd fvt-id 3 triplet-id ouro)
                (let ((op-got:decimal (- (ref-DPTF::UR_AccountSupply ouro anhd) op0)) (em0:decimal (ref-DPTF::UR_AccountSupply ouro emma)))
                    (ref-TS02-C3::CC_AQP-FVT|Collect emma fvt-id 3 triplet-id ouro)
                    (let ((em-got:decimal (- (ref-DPTF::UR_AccountSupply ouro emma) em0)) (lu0:decimal (ref-DPTF::UR_AccountSupply ouro lumy)))
                        (ref-TS02-C3::CC_AQP-FVT|Collect lumy fvt-id 3 triplet-id ouro)
                        (let ((lu-got:decimal (- (ref-DPTF::UR_AccountSupply ouro lumy) lu0)))
                            (print (format "<(op / emma / lumy OURO)> => {} / {} / {}" [op-got em-got lu-got]))
                            (map print
                              [ (expect "<<GT-05>> operator got 1400 OURO (own 900 + fee 500), hetero all-OURO" 1400.0 op-got)
                                (expect "<<GT-05>> EMMA got 1800 OURO (2000 net of 10%)" 1800.0 em-got)
                                (expect "<<GT-05>> LUMY got 1800 OURO" 1800.0 lu-got)
                                (expect "<<GT-05>> conservation op+emma+lumy = 5000" 5000.0 (+ op-got (+ em-got lu-got))) ]))))))
    )
)
(env-sigs [])
(commit-tx)
(print "")
