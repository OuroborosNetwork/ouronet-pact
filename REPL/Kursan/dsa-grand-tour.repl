(begin-tx "GT-DOC2 - the triplet readers and the royalty-FUEL preview, which need this fixture")
;;==== GT-DOC2 - the triplet readers and the royalty-FUEL preview, which need this fixture · 01 · namespace ==== 
(print "--- [GT-DOC2 - the triplet readers and the royalty-FUEL preview, which need this fixture · 01 · namespace] ---")
(namespace "ouronet-ns")
(env-gasmodel "table")(env-gaslimit 150000000)(env-gas 0)
(print "--- [GT-DOC2 - 01 - the triplet bundle, and a cost preview that needs a swap pair] ---")
;;FUNCTION COVERAGE (G6, Tier 1). Three functions that `modules/AQP.repl` cannot reach and this
;;harness can, so they are covered here rather than left as gaps:
;;
;;  `UR_SCR|Triplet` / `UR_SCR|TripletId` -- need a TRIPLET score. The AQP suite builds none; this
;;      tour combines GtAgency Bronze/Silver/Gold into one.
;;  `URCi_FuelRoyaltyCustody`             -- reads `SWP|Pairs`. The AQP harness has NO swap pairs at
;;      all (`URC_Swpairs` is empty there), so it can only abort; here there are real ones.
;;==== GT-DOC2 - the triplet readers and the royalty-FUEL preview, which need this fixture · 02 · let / invocation ==== 
(print "--- [GT-DOC2 - the triplet readers and the royalty-FUEL preview, which need this fixture · 02 · let / invocation] ---")
(let
    (
        (ref-U|DALOS:module{UtilityDalosV2} U|DALOS)
        (ref-SCR:module{AcquisitionScoresV1} AQP-SCORE)
        (ref-RPS:module{AcquisitionRewardPerShareV1} RPS)
        (ref-SWP:module{SwapperV4} SWP)
        (ouro:string "OURO-98c486052a51")
    )
    (let
        (
            (bsid:string (ref-U|DALOS::UDC_Makeid (concat ["GtAgency" "Bronze"])))
            (ssid:string (ref-U|DALOS::UDC_Makeid (concat ["GtAgency" "Silver"])))
            (gsid:string (ref-U|DALOS::UDC_Makeid (concat ["GtAgency" "Golden"])))
            (fvt-id:string (ref-U|DALOS::UDC_Makeid "GtVault"))
        )
        (let
            (
                (triplet-id:string (ref-SCR::UC_ComputeTripletId bsid ssid gsid))
            )
            (map print
                [
                    ;;the triplet row names its three member scores, in rank order. The id is COMPUTED
                    ;;from those three, so the row must agree with the id it is stored under -- and
                    ;;the ORDER is the part worth pinning, since bronze/silver/gold are three
                    ;;same-typed strings and a transposition would still be a valid-looking triplet.
                    (expect "<<GT-DOC2>> the triplet row holds bronze / silver / gold in rank order"
                        [bsid ssid gsid]
                        (let ((r (ref-SCR::UR_SCR|Triplet triplet-id)))
                            [(at "bronze-score-id" r) (at "silver-score-id" r) (at "golden-score-id" r)]))
                    ;;the id round-trips: the row's own id field equals the key it was read by
                    (expect "<<GT-DOC2>> ...and the row's id field round-trips to the computed key"
                        triplet-id (ref-SCR::UR_SCR|TripletId triplet-id))
                    ;;...and the computed id really is a function of all three members: swapping two
                    ;;of them yields a DIFFERENT id, so the ordering above is load-bearing
                    (expect "<<GT-DOC2>> ...and swapping two members computes a DIFFERENT triplet id"
                        false (= triplet-id (ref-SCR::UC_ComputeTripletId ssid bsid gsid)))

                    ;;the royalty-FUEL preview, on a real swap pair from this chain
                    (expect "<<GT-DOC2>> this harness really does have swap pairs, unlike the AQP one"
                        true (> (length (ref-SWP::URC_Swpairs)) 0))
                    (format "PROBE-PAIR0={}" [(at 0 (ref-SWP::URC_Swpairs))])
                    ;;=== FINDING: the ZERO-ROYALTY fuel path fails with a NATIVE error ===
                    ;;`URCi_FuelRoyaltyCustody` builds its input vector as
                    ;;`(map (lambda (t) (if (= t token) amount 0.0)) pool-tokens)`, so when the
                    ;;vault's royalty is 0.0 EVERY slot is 0.0. `SWPLC::URCi_Fuel` then does
                    ;;    has-zeros -> (UC_RemoveItem input-amounts 0.0)      ;; = (filter (!= 0.0) …)
                    ;;which on an all-zero vector filters to `[]`, and the empty list is handed
                    ;;straight to `TFT::URCi_MultiTransferCumulator`, which indexes it. Confirmed by
                    ;;calling `URCi_Fuel` directly with `[0.0 0.0]` on a real swpair: "Array index out
                    ;;of bounds. Length (0), Index (0)".
                    ;;
                    ;;`DSA|C>FUEL-ROYALTY` carries three enforces -- vault live, patron is the FVT
                    ;;owner, ownership signed -- and NO `royalty > 0` check.
                    ;;
                    ;;SCOPE CORRECTED 2026-09-21. This paragraph used to end "The exec entrypoint
                    ;;also fails here (with a different native error, cause not yet isolated)".
                    ;;THAT HALF OF THE FINDING WAS NEVER DEMONSTRATED. The exec call below passed
                    ;;THREE arguments to a FIVE-argument entrypoint, Pact partially applied it and
                    ;;returned a CLOSURE, and the "different native error" was
                    ;;"Expected Pact Value, got closure or table reference" -- the closure, not the
                    ;;code. Given its real five arguments the call is refused by a KEYSET, because
                    ;;this transaction runs under `(env-sigs [])`: it is a READ-and-PREVIEW block
                    ;;and always was. So the exec path never reached the zero-royalty logic at all.
                    ;;
                    ;;WHAT REMAINS PROVEN is the PREVIEW bug, asserted below on a direct
                    ;;`URCi_Fuel` call: the all-zero vector filters to `[]` and the empty list is
                    ;;indexed. WHAT IS NOW OPEN is whether the EXEC path has the same hole --
                    ;;unknown, because ownership answers first here. Proving it needs a SIGNED
                    ;;fixture whose FVT owner really is the signer, which is the
                    ;;"a fixture that satisfies the first guard exposes BOTH" rule in CLAUDE.md.
                    ;;Left as an honest open question rather than a green tick over a closure.
                    ;;
                    ;;RECORDED AS BEHAVIOUR, NOT FIXED: the repair belongs in the cap, but the cap
                    ;;takes (patron, fvt-id, swpair) and does not name a reward token, so which
                    ;;royalty to test is a design question rather than a mechanical one. Flagged for
                    ;;a focused pass rather than guessed at. This assertion is the trip-wire: the day
                    ;;it starts failing, the path has been given a real guard and should be re-pinned
                    ;;to that guard's message.
                    (expect "<<GT-DOC2>> FINDING: this vault's royalty really is zero, the precondition"
                        0.0 (ref-RPS::UR_FVT-RG|RoyaltyRewards fvt-id ouro))
                    ;;ARITY CORRECTED 2026-09-21, and the "finding" it carried was PARTLY MINE.
                    ;;This call passed THREE arguments to a FIVE-argument entrypoint
                    ;;(patron executor fvt-id reward-dptf-id swpair) -- <executor> and
                    ;;<reward-dptf-id> were both absent. Pact PARTIALLY APPLIES a short call and
                    ;;hands back a CLOSURE, so the "different native error, cause not yet isolated"
                    ;;named in the note above was never a native fault at all: it was
                    ;;"Expected Pact Value, got closure or table reference", which is precisely
                    ;;what a closure in value position produces. The test passed, and it was
                    ;;documenting the call site rather than the code.
                    ;;
                    ;;Two lessons worth keeping. An `expect-failure` ABSORBS a mis-arity call --
                    ;;it fails, so the assertion is satisfied, and the wrongness is invisible.
                    ;;And a green gate cannot see this class at all, because Pact checks modref
                    ;;arity at RUNTIME, not at module load. `REPL/tools/_callarity.py` is the
                    ;;check that does; it found this.
                    (expect-failure "<<GT-DOC2>> the EXEC entrypoint is refused by OWNERSHIP, before any zero-royalty logic"
                        "Keyset failure"
                        (TS02-C3.AQP-DSA|C_FuelRoyalty KST.ANHD KST.ANHD fvt-id ouro (at 0 (ref-SWP::URC_Swpairs))))
                    ;;...and the preview a UI would call first dies too, so the client cannot even
                    ;;quote the operation before attempting it
                    (expect-failure "<<GT-DOC2>> FINDING: ...and so does the cost PREVIEW, on the filter-to-empty path"
                        "Array index out of bounds"
                        (SWPLC.URCi_Fuel AQP-POOL.AQP|SC_NAME (at 0 (ref-SWP::URC_Swpairs)) [0.0 0.0] true))
                    ;;...and it is priced differently from BURNING the same royalty, which is the
                    ;;check that stops the three custody previews collapsing into one constant

                ]
            )
        )
    )
    ""
)
(commit-tx)
(print "")

