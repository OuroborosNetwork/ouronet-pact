;; ================================================================
;; FILE  REPL/Kursan/dsa-grand-tour.repl
;; ----------------------------------------------------------------
;; DSA GRAND TOUR — the WHOLE Delegated-Staking-Agencies lifecycle in ONE process,
;; on ONE agency, end to end. Unlike the focused dsa-* suites (each a separate
;; boot proving one slice), this drives every user-facing step in sequence:
;;
;;   create a delegation vault  ->  define a triplet (3 single models -> combine
;;   -> issue an operator score) ->  MULTIPLET_BASE OURO reward (ladder family)
;;   ->  open the agency (operator stakes, fee)  ->  delegators stake  ->  oracle
;;   authorize + write (capture)  ->  set a HETEROGENEOUS quality split  ->  inject
;;   ->  collect (operator FIRST + independently, fee two-track)  ->  reprice the
;;   split matrix  ->  reprice the fee (O(1))  ->  the global GOV oracle switches.
;;
;; The trick that lets fee + heterogeneous split be asserted together on one agency:
;; a MULTIPLET_BASE reward routes each collect through the quality-lane split, and a
;; matrix of all [1000 0 0] sends every lane to token-0 (OURO) RAW (no ATS Coil/Curl
;; conversion) — so the exact two-track fee amounts stay assertable while proving the
;; heterogeneous collect branch actually fires. A later reprice to [0 1000 0] proves
;; the reroute to token-1 (Auryn, via the Coil leg).
;;
;; Legend:  <(...)> op echo   <<GT-nn>> assertion tag
;; Source:  08_DSA.pact (whole module) + 05_FVT.pact (AgencyFee/QualitySplit/inject/
;;          collect) + 3_Talos/04_TS02-C3.pact (AQP-DSA| / AQP-FVT| wrappers)
;; ================================================================
(print "")
(print "================================================================")
(print "FILE  REPL/Kursan/dsa-grand-tour.repl  —  full DSA lifecycle, one agency")
(print "================================================================")
(load "../Stage00_Sanboxes.repl")
(load "../Stage01_Tester.repl")
;;#P2 REPAIR: this hand-rolled Stage-2 deploy block predated deploy-stage02.repl and no longer
;;provisions everything the suites below need -- notably KBN, which [5.4]_PopulateBunnies stopped
;;deploying itself once deploy-stage02 took it over. The run died partway through on
;;"Module KBN has no such member: A_Step01", so this file could not execute AT ALL. Its own
;;AQP-BOOT deploy + Step0 blocks are removed too: deploy-stage02.repl already does both.
(load "../deploy-stage02.repl")
(load "../Stage_02/[5.2]_PopulateBloodshed.repl")
(load "../Stage_02/[5.1]_PopulateNosferatu.repl")
(load "../Stage_02/[5.4]_PopulateBunnies.repl")
(begin-tx "GT-BOOT - Step4 core scores")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(namespace "ouronet-ns")
;;==== GT-BOOT - Step4 core scores · 01 · let / invocation ==== ===================================
(print "--- [GT-BOOT - Step4 core scores · 01 · let / invocation] ---")
(let
    (
        (patron:string KST.ANHD) (owner-konto:string KST.ANHD)
        (ref-DALOS:module{OuronetDalosV2} DALOS)
        (split-stoa:[decimal] (ref-DALOS::URC_SplitSTOAPrices patron (* 4.0 (ref-DALOS::UR_UsagePrice "smart"))))
    )
    (env-sigs
      [ { "key": "PK_AncientHodler", "caps": [] }
        { "key": "6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263"
        , "caps":
          [ (coin.TRANSFER "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263" "k:50d6c59b21e5e6e55baecaa75a1007de37576bde12d8230dc82459cc01b9484b" (at 2 split-stoa))
            (coin.TRANSFER "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263" "k:0cb30c0121ff919266121a99ff9359871818932211df94dae4137c29bc0e8f7e" (at 0 split-stoa))
            (coin.TRANSFER "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263" "c:XM-pkmuB5XUQlp87ZYSbfKt8qzmHY6O2EHAzMRVBt3k" (at 3 split-stoa))
            (coin.TRANSFER "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263" "c:iQQFWj6gWtpGEzhM_O5ekW1QtnQQy55R8BRPGhj_0FU" (at 1 split-stoa)) ] } ])
    (AQP-BOOT.C_Step4_CreateCoreScores patron owner-konto))
(env-sigs [])
(commit-tx)
