;; ================================================================
;; FILE  REPL/Kursan/dsa-grand-tour.repl
;; ----------------------------------------------------------------
;; DSA GRAND TOUR — the WHOLE Delegated-Staking-Agencies lifecycle in ONE process,
;; on ONE agency, end to end. Unlike the focused dsa-* suites (each a separate
;; boot proving one slice), this drives every user-facing step in sequence:
;;
;;   create a delegation vault  ->  define a triplet (3 single models -> combine
;;   -> issue an operator score) ->  MULTIPLET_BASE OURO reward (ladder family)
;;   ->  open the agency (operator stakes, fee)  ->  delegators stake  ->  oracle
;;   authorize + write (capture)  ->  set a HETEROGENEOUS quality split  ->  inject
;;   ->  collect (operator FIRST + independently, fee two-track)  ->  reprice the
;;   split matrix  ->  reprice the fee (O(1))  ->  the global GOV oracle switches.
;;
;; The trick that lets fee + heterogeneous split be asserted together on one agency:
;; a MULTIPLET_BASE reward routes each collect through the quality-lane split, and a
;; matrix of all [1000 0 0] sends every lane to token-0 (OURO) RAW (no ATS Coil/Curl
;; conversion) — so the exact two-track fee amounts stay assertable while proving the
;; heterogeneous collect branch actually fires. A later reprice to [0 1000 0] proves
;; the reroute to token-1 (Auryn, via the Coil leg).
;;
;; Legend:  <(...)> op echo   <<GT-nn>> assertion tag
;; Source:  07_DSA.pact (whole module) + 04_FVT.pact (AgencyFee/QualitySplit/inject/
;;          collect) + 3_Talos/04_TS02-C3.pact (AQP-DSA| / AQP-FVT| wrappers)
;; ================================================================
(print "")
(print "================================================================")
(print "FILE  REPL/Kursan/dsa-grand-tour.repl  —  full DSA lifecycle, one agency")
(print "================================================================")
(load "../Stage00_Sanboxes.repl")
(load "../Stage01_Tester.repl")
(load "../Stage_02/[0.1]_Interfaces.repl")
(load "../Stage_02/[2.1]_DpdcCore.repl")
(load "../Stage_02/[2.2]_DemiPad.repl")
(load "../Stage_02/[2.3]_EarningPools.repl")
(load "../Stage_02/[3]_Talos.repl")
(load "../Stage_02/[4.0]_Sovereign-Executor.repl")
(load "../Stage_02/[5.2]_PopulateBloodshed.repl")
(load "../Stage_02/[5.1]_PopulateNosferatu.repl")
(load "../Stage_02/[5.4]_PopulateBunnies.repl")
(begin-tx "GT-BOOT - AQP-BOOT module")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(namespace "ouronet-ns")
(env-sigs [{"key": "1a4e15d3c51e0b73e92644600487ba8eaae312e1a178b91801d54e13c1b350a5", "caps": []}])
(load "../../2_CITIZEN/5_VaultsMinter/04_AQP-BOOT.pact")
(commit-tx)
(begin-tx "GT-BOOT - Step0")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(namespace "ouronet-ns")
(env-sigs [{ "key": "PK_AncientHodler", "caps": [] }])
(AQP-BOOT.C_Step0_WireImcAndGovernor KST.ANHD)
(commit-tx)
(begin-tx "GT-BOOT - Step4 core scores")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(namespace "ouronet-ns")
(let
    (
        (patron:string KST.ANHD) (owner-konto:string KST.ANHD)
        (ref-DALOS:module{OuronetDalosV1} DALOS)
        (split-stoa:[decimal] (ref-DALOS::URC_SplitSTOAPrices patron (* 4.0 (ref-DALOS::UR_UsagePrice "smart"))))
    )
    (env-sigs
      [ { "key": "PK_AncientHodler", "caps": [] }
        { "key": "6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263"
        , "caps":
          [ (coin.TRANSFER "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263" "k:50d6c59b21e5e6e55baecaa75a1007de37576bde12d8230dc82459cc01b9484b" (at 2 split-stoa))
            (coin.TRANSFER "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263" "k:0cb30c0121ff919266121a99ff9359871818932211df94dae4137c29bc0e8f7e" (at 0 split-stoa))
            (coin.TRANSFER "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263" "c:XM-pkmuB5XUQlp87ZYSbfKt8qzmHY6O2EHAzMRVBt3k" (at 3 split-stoa))
            (coin.TRANSFER "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263" "c:iQQFWj6gWtpGEzhM_O5ekW1QtnQQy55R8BRPGhj_0FU" (at 1 split-stoa)) ] } ])
    (AQP-BOOT.C_Step4_CreateCoreScores patron owner-konto))
(env-sigs [])
(commit-tx)
(begin-tx "GT-BOOT - Step5 subsidiary scores")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(namespace "ouronet-ns")
(let
    (
        (patron:string KST.ANHD) (owner-konto:string KST.ANHD)
        (ref-DALOS:module{OuronetDalosV1} DALOS)
        (split-stoa:[decimal] (ref-DALOS::URC_SplitSTOAPrices patron (* 5.0 (ref-DALOS::UR_UsagePrice "smart"))))
    )
    (env-sigs
      [ { "key": "PK_AncientHodler", "caps": [] }
        { "key": "6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263"
        , "caps":
          [ (coin.TRANSFER "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263" "k:50d6c59b21e5e6e55baecaa75a1007de37576bde12d8230dc82459cc01b9484b" (at 2 split-stoa))
            (coin.TRANSFER "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263" "k:0cb30c0121ff919266121a99ff9359871818932211df94dae4137c29bc0e8f7e" (at 0 split-stoa))
            (coin.TRANSFER "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263" "c:XM-pkmuB5XUQlp87ZYSbfKt8qzmHY6O2EHAzMRVBt3k" (at 3 split-stoa))
            (coin.TRANSFER "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263" "c:iQQFWj6gWtpGEzhM_O5ekW1QtnQQy55R8BRPGhj_0FU" (at 1 split-stoa)) ] } ])
    (AQP-BOOT.C_Step5_CreateSubsidiaryScores patron owner-konto))
(env-sigs [])
(commit-tx)
;; full provisioning — this issues the chain-wide OURO->Auryn->Elite-Auryn MULTIPLET ladder family
(load "../Stage_02/[6.2.9]_AQP-BOOT-FULL.repl")
(print "")
;;
;;|| NEXT >
;;|| GT-01 — fragment 500 silver DHOC into -2 nonces; give 200k to EMMA + 200k to LUMY (ANHD keeps 100k).
;;
(begin-tx "GT-01 - fragment + distribute silver custodian frags")
(namespace "ouronet-ns")
(env-gasmodel "table")(env-gaslimit 90000000)(env-gas 0)
(env-chain-data { "block-time": (time "2027-12-01T00:00:00Z") })
(env-sigs
  [ { "key": "PK_AncientHodler", "caps": [] }
    { "key": "6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263"
    , "caps":
      [ (coin.TRANSFER "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263" "k:50d6c59b21e5e6e55baecaa75a1007de37576bde12d8230dc82459cc01b9484b" 1000000.0)
        (coin.TRANSFER "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263" "k:0cb30c0121ff919266121a99ff9359871818932211df94dae4137c29bc0e8f7e" 1000000.0)
        (coin.TRANSFER "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263" "c:XM-pkmuB5XUQlp87ZYSbfKt8qzmHY6O2EHAzMRVBt3k" 1000000.0)
        (coin.TRANSFER "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263" "c:iQQFWj6gWtpGEzhM_O5ekW1QtnQQy55R8BRPGhj_0FU" 1000000.0) ] } ])
(print "--- [GT-01 - 01 - fragment + distribute] ---")
(let
    (
        (anhd:string KST.ANHD) (emma:string KST.EMMA) (lumy:string KST.LUMY)
        (dhoc:string "DHOC-98c486052a51")
        (ref-DPDC:module{DpdcV1} DPDC)
        (ref-TS02-C1:module{TalosStageTwo_ClientOneV1} TS02-C1)
    )
    (ref-TS02-C1::C_DPSF|MakeFragments anhd anhd dhoc 2 500)
    (ref-TS02-C1::C_DPSF|TransferNonce anhd dhoc anhd emma -2 200000 false)
    (ref-TS02-C1::C_DPSF|TransferNonce anhd dhoc anhd lumy -2 200000 false)
    (map print
      [ (expect "<<GT-01>> ANHD keeps 100000 frag -2" 100000 (ref-DPDC::UR_AccountNonceSupply anhd dhoc true -2))
        (expect "<<GT-01>> EMMA holds 200000 frag -2" 200000 (ref-DPDC::UR_AccountNonceSupply emma dhoc true -2))
        (expect "<<GT-01>> LUMY holds 200000 frag -2" 200000 (ref-DPDC::UR_AccountNonceSupply lumy dhoc true -2)) ]))
(env-sigs [])
(commit-tx)
(print "")
;;
;;|| NEXT >
;;|| GT-02 — triplet model + operator score + class-0 vault with a MULTIPLET_BASE OURO reward + pool.
;;
(begin-tx "GT-02 - model + triplet + MULTIPLET vault + pool")
(namespace "ouronet-ns")
(env-gasmodel "table")(env-gaslimit 90000000)(env-gas 0)
(env-chain-data { "block-time": (time "2027-12-01T00:00:00Z") })
(env-sigs
  [ { "key": "PK_AncientHodler", "caps": [] }
    { "key": "6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263"
    , "caps":
      [ (coin.TRANSFER "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263" "k:50d6c59b21e5e6e55baecaa75a1007de37576bde12d8230dc82459cc01b9484b" 1000000.0)
        (coin.TRANSFER "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263" "k:0cb30c0121ff919266121a99ff9359871818932211df94dae4137c29bc0e8f7e" 1000000.0)
        (coin.TRANSFER "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263" "c:XM-pkmuB5XUQlp87ZYSbfKt8qzmHY6O2EHAzMRVBt3k" 1000000.0)
        (coin.TRANSFER "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263" "c:iQQFWj6gWtpGEzhM_O5ekW1QtnQQy55R8BRPGhj_0FU" 1000000.0) ] } ])
(print "--- [GT-02 - 01 - model + triplet + MULTIPLET vault + pool] ---")
(let
    (
        (anhd:string KST.ANHD)
        (dhoc:string "DHOC-98c486052a51")
        (ouro:string "OURO-98c486052a51")
        (ref-DALOS:module{OuronetDalosV1} DALOS)
        (ref-U|DALOS:module{UtilityDalosV1} U|DALOS)
        (ref-TS02-C3:module{TalosStageTwo_ClientThreeV1} TS02-C3)
    )
    (let
        (
            (bmid:string (ref-U|DALOS::UDC_Makeid "GtBronzeModel"))
            (smid:string (ref-U|DALOS::UDC_Makeid "GtSilverModel"))
            (gmid:string (ref-U|DALOS::UDC_Makeid "GtGoldModel"))
            (model-id:string (ref-U|DALOS::UDC_Makeid "GtTripletModel"))
            (fvt-id:string   (ref-U|DALOS::UDC_Makeid "GtVault"))
            (pool-id:string  (ref-U|DALOS::UDC_Makeid "GtPool"))
            (bsid:string (ref-U|DALOS::UDC_Makeid (concat ["GtAgency" "Bronze"])))
            (ssid:string (ref-U|DALOS::UDC_Makeid (concat ["GtAgency" "Silver"])))
            (gsid:string (ref-U|DALOS::UDC_Makeid (concat ["GtAgency" "Golden"])))
            ;; the chain-wide OURO ladder family from AQP-BOOT Step 10 (makes OURO a MULTIPLET_BASE reward)
            (family-id:string (concat ["F" "|" ouro "|" (ref-DALOS::UR_AurynID) "|" (ref-DALOS::UR_EliteAurynID)]))
        )
        ;; 1) three single score models (bronze/silver/gold) over the custodian frag nonces -> combine into a triplet
        (ref-TS02-C3::C_AQP-SCR|IssueSingleScoreModel anhd "GtBronzeModel" 3 dhoc 24 [-1] [1.0])
        (ref-TS02-C3::C_AQP-SCR|IssueSingleScoreModel anhd "GtSilverModel" 3 dhoc 24 [-2] [10.0])
        (ref-TS02-C3::C_AQP-SCR|IssueSingleScoreModel anhd "GtGoldModel"   3 dhoc 24 [-3] [100.0])
        (ref-TS02-C3::C_AQP-SCR|CombineTripletScoreModel anhd "GtTripletModel" bmid smid gmid)
        ;; 2) issue the OPERATOR's triplet score from the model
        (ref-TS02-C3::C_AQP-SCR|IssueScoreFromModel anhd anhd model-id "GtAgency")
        ;; 3) class-0 vault + MULTIPLET_BASE OURO reward (family, NOT BAR) + register it as a DSA delegation vault
        (ref-TS02-C3::C_AQP-FVT|Issue anhd "GtVault" anhd 0 ouro)
        (ref-TS02-C3::C_AQP-FVT|AddRewardLink anhd fvt-id ouro false family-id)
        (ref-TS02-C3::A_AQP-DSA|DefineDelegationVault anhd fvt-id model-id 2000)
        ;; 4) pool employing the 3 sub-scores (where operator + delegators stake their custodian frags)
        (ref-TS02-C3::C_AQP-POOL|Issue anhd "GtPool" dhoc 3)
        (ref-TS02-C3::C_AQP-POOL|AddScore anhd pool-id bsid)
        (ref-TS02-C3::C_AQP-POOL|AddScore anhd pool-id ssid)
        (ref-TS02-C3::C_AQP-POOL|AddScore anhd pool-id gsid)
        (map print
          [ (expect "<<GT-02>> vault is class-0 (DSA delegation vault)" 0 (AQP-FVT.UR_FVT|FvtClass fvt-id))
            (expect "<<GT-02>> OURO reward is MULTIPLET_BASE on the vault" "MULTIPLET_BASE" (AQP-FVT.UR_FVT-RG|RewardKind fvt-id ouro))
            (expect "<<GT-02>> DSA vault registered active" true (AQP-DSA.UR_DSA-TMP|Active fvt-id)) ]))
)
(env-sigs [])
(commit-tx)
(print "")
;;
;;|| NEXT >
;;|| GT-03 — open the agency: operator ANHD stakes its 100k -2 frags (=> 1000 quintessence, clears the gate), fee 10%.
