;;|| NEXT >
;;|| GT-06 — reprice the MATRIX to all [0 1000 0] (every lane -> token-1 Auryn via the ATS Coil leg); inject + collect:
;;|| proves the heterogeneous reroute. Everyone now receives Auryn (not OURO); operator's Auryn < a delegator's (own+fee 1400 < 1800).
;;
(begin-tx "GT-06 - reprice matrix to all-Auryn + inject + collect")
(namespace "ouronet-ns")
(env-gasmodel "table")(env-gaslimit 150000000)(env-gas 0)
(env-chain-data { "block-time": (time "2027-12-01T04:00:00Z") })
(env-sigs
  [ { "key": "PK_AncientHodler", "caps": [] }
    { "key": "PK_Emma", "caps": [] }
    { "key": "PK_Lumy", "caps": [] }
    { "key": "6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263"
    , "caps":
      [ (coin.TRANSFER "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263" "k:50d6c59b21e5e6e55baecaa75a1007de37576bde12d8230dc82459cc01b9484b" 1000000.0)
        (coin.TRANSFER "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263" "k:0cb30c0121ff919266121a99ff9359871818932211df94dae4137c29bc0e8f7e" 1000000.0)
        (coin.TRANSFER "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263" "c:XM-pkmuB5XUQlp87ZYSbfKt8qzmHY6O2EHAzMRVBt3k" 1000000.0)
        (coin.TRANSFER "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263" "c:iQQFWj6gWtpGEzhM_O5ekW1QtnQQy55R8BRPGhj_0FU" 1000000.0) ] } ])
(print "--- [GT-06 - 01 - reprice matrix to Auryn + inject + collect] ---")
(let
    (
        (anhd:string KST.ANHD) (emma:string KST.EMMA) (lumy:string KST.LUMY)
        (ouro:string "OURO-98c486052a51")
        (ref-U|DALOS:module{UtilityDalosV1} U|DALOS)
        (ref-DALOS:module{OuronetDalosV1} DALOS)
        (ref-SCR:module{AcquisitionScoresV1} AQP-SCORE)
        (ref-DPTF:module{DemiourgosPactTrueFungibleV1} DPTF)
        (ref-TS02-C3:module{TalosStageTwo_ClientThreeV1} TS02-C3)
    )
    (let
        (
            (fvt-id:string  (ref-U|DALOS::UDC_Makeid "GtVault"))
            (auryn:string (ref-DALOS::UR_AurynID))
            (bsid:string (ref-U|DALOS::UDC_Makeid (concat ["GtAgency" "Bronze"])))
            (ssid:string (ref-U|DALOS::UDC_Makeid (concat ["GtAgency" "Silver"])))
            (gsid:string (ref-U|DALOS::UDC_Makeid (concat ["GtAgency" "Golden"])))
        )
        (let ((triplet-id:string (ref-SCR::UC_ComputeTripletId bsid ssid gsid)))
            (ref-TS02-C3::C_AQP-FVT|SetQualitySplit anhd fvt-id ouro "HETEROGENEOUS" [0 1000 0] [0 1000 0] [0 1000 0])
            (ref-TS02-C3::CC_AQP-FVT|Inject anhd fvt-id ouro 5000.0)
            (let
                (
                    (op-o0:decimal (ref-DPTF::UR_AccountSupply ouro anhd)) (op-a0:decimal (ref-DPTF::UR_AccountSupply auryn anhd))
                    (em-a0:decimal (ref-DPTF::UR_AccountSupply auryn emma)) (lu-a0:decimal (ref-DPTF::UR_AccountSupply auryn lumy))
                )
                (ref-TS02-C3::CC_AQP-FVT|Collect anhd fvt-id 3 triplet-id ouro)
                (ref-TS02-C3::CC_AQP-FVT|Collect emma fvt-id 3 triplet-id ouro)
                (ref-TS02-C3::CC_AQP-FVT|Collect lumy fvt-id 3 triplet-id ouro)
                (let
                    (
                        (op-ouro:decimal (- (ref-DPTF::UR_AccountSupply ouro anhd) op-o0))
                        (op-auryn:decimal (- (ref-DPTF::UR_AccountSupply auryn anhd) op-a0))
                        (em-auryn:decimal (- (ref-DPTF::UR_AccountSupply auryn emma) em-a0))
                        (lu-auryn:decimal (- (ref-DPTF::UR_AccountSupply auryn lumy) lu-a0))
                    )
                    (print (format "<(op Auryn / OURO ; emma Auryn ; lumy Auryn)> => {} / {} ; {} ; {}" [op-auryn op-ouro em-auryn lu-auryn]))
                    (map print
                      [ (expect "<<GT-06>> operator got Auryn (matrix reroute to token-1)" true (> op-auryn 0.0))
                        (expect "<<GT-06>> operator got ~0 OURO now (nothing on token-0)" true (< (abs op-ouro) 0.000001))
                        (expect "<<GT-06>> EMMA got Auryn" true (> em-auryn 0.0))
                        (expect "<<GT-06>> LUMY got Auryn" true (> lu-auryn 0.0))
                        (expect "<<GT-06>> delegators symmetric (EMMA==LUMY Auryn)" em-auryn lu-auryn)
                        (expect "<<GT-06>> fee ordering preserved (operator 1400 < delegator 1800 => less Auryn)" true (< op-auryn em-auryn)) ])))
        )
    )
)
(env-sigs [])
(commit-tx)
(print "")
