;;
;;|| NEXT >
;;|| GT-02 — triplet model + operator score + class-0 vault with a MULTIPLET_BASE OURO reward + pool.
;;
(begin-tx "GT-02 - model + triplet + MULTIPLET vault + pool")
(namespace "ouronet-ns")
(env-gasmodel "table")(env-gaslimit 90000000)(env-gas 0)
(env-chain-data { "block-time": (time "2027-12-01T00:00:00Z") })
;;==== GT-02 - model + triplet + MULTIPLET vault + pool · 01 · env-sigs (caps) ==== ===============
(print "--- [GT-02 - model + triplet + MULTIPLET vault + pool · 01 · env-sigs (caps)] ---")
(env-sigs
  [ { "key": "PK_AncientHodler", "caps": [] }
    { "key": "6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263"
    , "caps":
      [ (coin.TRANSFER "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263" "k:50d6c59b21e5e6e55baecaa75a1007de37576bde12d8230dc82459cc01b9484b" 1000000.0)
        (coin.TRANSFER "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263" "k:0cb30c0121ff919266121a99ff9359871818932211df94dae4137c29bc0e8f7e" 1000000.0)
        (coin.TRANSFER "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263" "c:XM-pkmuB5XUQlp87ZYSbfKt8qzmHY6O2EHAzMRVBt3k" 1000000.0)
        (coin.TRANSFER "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263" "c:iQQFWj6gWtpGEzhM_O5ekW1QtnQQy55R8BRPGhj_0FU" 1000000.0) ] } ])
(print "--- [GT-02 - 01 - model + triplet + MULTIPLET vault + pool] ---")
;;==== GT-02 - model + triplet + MULTIPLET vault + pool · 02 · let / invocation ==== ==============
(print "--- [GT-02 - model + triplet + MULTIPLET vault + pool · 02 · let / invocation] ---")
(let
    (
        (anhd:string KST.ANHD)
        (dhoc:string "DHOC-98c486052a51")
        (ouro:string "OURO-98c486052a51")
        (ref-DALOS:module{OuronetDalosV2} DALOS)
        (ref-U|DALOS:module{UtilityDalosV2} U|DALOS)
        (ref-TS02-C3:module{TalosStageTwo_ClientThreeV1} TS02-C3)
    )
    (let
        (
            (bmid:string (ref-U|DALOS::UDC_Makeid "GtBronzeModel"))
            (smid:string (ref-U|DALOS::UDC_Makeid "GtSilverModel"))
            (gmid:string (ref-U|DALOS::UDC_Makeid "GtGoldModel"))
            (model-id:string (ref-U|DALOS::UDC_Makeid "GtTripletModel"))
            (fvt-id:string   (ref-U|DALOS::UDC_Makeid "GtVault"))
            (pool-id:string  (ref-U|DALOS::UDC_Makeid "GtPool"))
            (bsid:string (ref-U|DALOS::UDC_Makeid (concat ["GtAgency" "Bronze"])))
            (ssid:string (ref-U|DALOS::UDC_Makeid (concat ["GtAgency" "Silver"])))
            (gsid:string (ref-U|DALOS::UDC_Makeid (concat ["GtAgency" "Golden"])))
            ;; the chain-wide OURO ladder family from AQP-BOOT Step 10 (makes OURO a MULTIPLET_BASE reward)
            (family-id:string (concat ["F" "|" ouro "|" (ref-DALOS::UR_AurynID) "|" (ref-DALOS::UR_EliteAurynID)]))
        )
        ;; 1) three single score models (bronze/silver/gold) over the custodian frag nonces -> combine into a triplet
        (ref-TS02-C3::AQP-SCR|C_IssueSingleScoreModel anhd anhd "GtBronzeModel" 3 dhoc 24 [-1] [1.0] "|")
        (ref-TS02-C3::AQP-SCR|C_IssueSingleScoreModel anhd anhd "GtSilverModel" 3 dhoc 24 [-2] [10.0] "|")
        (ref-TS02-C3::AQP-SCR|C_IssueSingleScoreModel anhd anhd "GtGoldModel"   3 dhoc 24 [-3] [100.0] "|")
        (ref-TS02-C3::AQP-SCR|C_CombineTripletScoreModel anhd anhd "GtTripletModel" bmid smid gmid)
        ;; 2) issue the OPERATOR's triplet score from the model
        (ref-TS02-C3::AQP-SCR|C_IssueScoreFromModel anhd anhd model-id "GtAgency")
        ;; 3) class-0 vault + MULTIPLET_BASE OURO reward (family, NOT BAR) + register it as a DSA delegation vault
        (ref-TS02-C3::AQP-FVT|C_Issue anhd "GtVault" anhd 0 ouro)
        (ref-TS02-C3::AQP-FVT|C_AddRewardLink anhd (AQP-FVT.UR_FVT|OwnerKonto fvt-id) fvt-id ouro false family-id)
        (ref-TS02-C3::AQP-DSA|C_DefineDelegationVault anhd anhd fvt-id model-id 2000)
        ;; 4) pool employing the 3 sub-scores (where operator + delegators stake their custodian frags)
        (ref-TS02-C3::AQP-POOL|C_Issue anhd (AQP-POOL.URC_AqpOwnerKontoFromClassAndAsset 3 dhoc) "GtPool" dhoc 3)
        (ref-TS02-C3::AQP-POOL|C_AddScore anhd (AQP-POOL.URC_AqpOwnerKonto pool-id) pool-id bsid)
        (ref-TS02-C3::AQP-POOL|C_AddScore anhd (AQP-POOL.URC_AqpOwnerKonto pool-id) pool-id ssid)
        (ref-TS02-C3::AQP-POOL|C_AddScore anhd (AQP-POOL.URC_AqpOwnerKonto pool-id) pool-id gsid)
        (map print
          [ (expect "<<GT-02>> vault is class-0 (DSA delegation vault)" 0 (AQP-FVT.UR_FVT|FvtClass fvt-id))
            (expect "<<GT-02>> OURO reward is MULTIPLET_BASE on the vault" "MULTIPLET_BASE" (AQP-FVT.UR_FVT-RG|RewardKind fvt-id ouro))
            (expect "<<GT-02>> DSA vault registered active" true (AQP-DSA.UR_DSA-TMP|Active fvt-id)) ]))
)
(env-sigs [])
(commit-tx)

;;|| NEXT >
;;|| GT-02b — a triplet model cannot be built out of triplet models.
;;
(begin-tx "GT-02b - COMBINE-TRIPLET-SCORE-MODEL requires three SINGLE sub-models")
(env-gasmodel "table")(env-gaslimit 150000000)(env-gas 0)
(namespace "ouronet-ns")
;;==== GT-02b - COMBINE-TRIPLET-SCORE-MODEL requires three SINGLE sub-models · 01 · env-sigs (caps) ==== 
(print "--- [GT-02b - COMBINE-TRIPLET-SCORE-MODEL requires three SINGLE sub-models · 01 · env-sigs (caps)] ---")
(env-sigs [{ "key": "PK_AncientHodler", "caps": [] }])
(print "--- [GT-02b - 01 - the three sub-models must all be single] ---")
;;`02_SCORE.pact:1326`. GT-02 has just built the exact pair of fixtures this needs and nothing else
;;in the suite has: three SINGLE models and one TRIPLET model combined from them. So the guard costs
;;nothing here -- **check what the chain already has before building anything**.
;;
;;The rule stops a triplet being nested inside a triplet. A triplet model's score resolves through
;;its three sub-models' nonces; if a sub-model were itself a triplet the resolution would need to
;;recurse, and nothing downstream is written to recurse.
;;
;;ALL THREE SLOTS ARE DRIVEN. One would pin the message, but the `fold (and)` lists the three
;;positions separately, and a copy-paste slip in any one of them (a repeated `bronze-model-id`, say)
;;would leave a slot unchecked and still pass a single-slot test. Three assertions is the cheapest
;;way to make that class of typo visible.
;;==== GT-02b - COMBINE-TRIPLET-SCORE-MODEL requires three SINGLE sub-models · 02 · let / invocation ==== 
(print "--- [GT-02b - COMBINE-TRIPLET-SCORE-MODEL requires three SINGLE sub-models · 02 · let / invocation] ---")
(let
    (
        (ref-U|DALOS:module{UtilityDalosV2} U|DALOS)
        (ref-SCR:module{AcquisitionScoresV1} AQP-SCORE)
        (ref-TS02-C3:module{TalosStageTwo_ClientThreeV1} TS02-C3)
        (anhd:string KST.ANHD)
    )
    (let
        (
            (bmid:string (ref-U|DALOS::UDC_Makeid "GtBronzeModel"))
            (smid:string (ref-U|DALOS::UDC_Makeid "GtSilverModel"))
            (gmid:string (ref-U|DALOS::UDC_Makeid "GtGoldModel"))
            (tmid:string (ref-U|DALOS::UDC_Makeid "GtTripletModel"))
        )
        (map print
            [
                ;;the premise: three are single (1), the fourth is a triplet (3)
                (expect "<<GT-02b>> three single models and one triplet model exist"
                    [1 1 1 3]
                    [(ref-SCR::UR_SCR|ModelEntityType bmid) (ref-SCR::UR_SCR|ModelEntityType smid)
                     (ref-SCR::UR_SCR|ModelEntityType gmid) (ref-SCR::UR_SCR|ModelEntityType tmid)])
                ;;THE ITEM, in each of the three slots
                (expect-failure "<<GT-02b>> a TRIPLET model in the bronze slot is refused"
                    "The three sub-models must all be single"
                    (ref-TS02-C3::AQP-SCR|C_CombineTripletScoreModel anhd anhd "GtNestB" tmid smid gmid))
                (expect-failure "<<GT-02b>> ...in the silver slot"
                    "The three sub-models must all be single"
                    (ref-TS02-C3::AQP-SCR|C_CombineTripletScoreModel anhd anhd "GtNestS" bmid tmid gmid))
                (expect-failure "<<GT-02b>> ...and in the golden slot"
                    "The three sub-models must all be single"
                    (ref-TS02-C3::AQP-SCR|C_CombineTripletScoreModel anhd anhd "GtNestG" bmid smid tmid))
                ;;THE CONTRAST: the same call with the same three singles GT-02 used, under a fresh
                ;;name. Without it the three refusals are also consistent with the combine being
                ;;broken outright -- and the name has to be fresh, because "Model id already exists"
                ;;sits one enforce ABOVE the rule under test and would answer for it.
                (expect "<<GT-02b>> ...while three SINGLE models combine under a fresh name"
                    true (!= "" (format "{}"
                        [(ref-TS02-C3::AQP-SCR|C_CombineTripletScoreModel anhd anhd "GtNestOk" bmid smid gmid)])))
                (expect "<<GT-02b>> ...and the result is itself a TRIPLET model"
                    3 (ref-SCR::UR_SCR|ModelEntityType (ref-U|DALOS::UDC_Makeid "GtNestOk")))
            ]
        )
        ""
    )
)
(env-sigs [])
;;the extra model is discarded -- GT-02c checks it
(rollback-tx)

;;|| NEXT >
;;|| GT-02c — the probe model left no trace.
;;
(begin-tx "GT-02c - no leakage")
(namespace "ouronet-ns")
(print "--- [GT-02c - 01 - no leakage] ---")
;;A leaked GtNestOk would be harmless to this file but would make the model table's contents depend
;;on whether a guard test ran, which is exactly the kind of drift that makes a later count wrong.
(print
    (expect "<<GT-02c>> the probe model does not exist"
        false (AQP-SCORE.URC_ScoreEntityModelExists (U|DALOS.UDC_Makeid "GtNestOk"))))
(commit-tx)

;;|| NEXT >
;;|| GT-02d — the FVT twin of the score one-way door.
;;
(begin-tx "GT-02d - FVT control requires can-upgrade, which control itself can revoke")
(env-gasmodel "table")(env-gaslimit 150000000)(env-gas 0)
(namespace "ouronet-ns")
;;==== GT-02d - FVT control requires can-upgrade, which control itself can revoke · 01 · env-sigs (caps) ==== 
(print "--- [GT-02d - FVT control requires can-upgrade, which control itself can revoke · 01 · env-sigs (caps)] ---")
(env-sigs [{ "key": "PK_AncientHodler", "caps": [] }])
(print "--- [GT-02d - 01 - FVT|C>CONTROL-FVT requires can-upgrade true] ---")
;;`05_FVT.pact:772`, and it is the EXACT TWIN of `02_SCORE.pact:744`, pinned by
;;`modules/AQP.repl <<AQP-G39>>`. Same shape, same one-way door, different module: `C_Control` takes
;;the new can-upgrade as an argument, so it can write the flag that disables itself, and nothing can
;;write it back.
;;
;;PINNED SEPARATELY ON PURPOSE. The two messages differ ("Score control…" vs "FVT control update…"),
;;so one test cannot cover both -- and more to the point, "the score guard works" is not evidence
;;about the vault guard. A duplicated rule is exactly where a copy-paste slip survives review: the
;;code reads right in both places and only one of them was ever exercised.
;;==== GT-02d - FVT control requires can-upgrade, which control itself can revoke · 02 · let / invocation ==== 
(print "--- [GT-02d - FVT control requires can-upgrade, which control itself can revoke · 02 · let / invocation] ---")
(let
    (
        (ref-U|DALOS:module{UtilityDalosV2} U|DALOS)
        (ref-FVT:module{AcquisitionFarmsVaultsTreasuriesV1} AQP-FVT)
        (ref-TS02-C3:module{TalosStageTwo_ClientThreeV1} TS02-C3)
        (anhd:string KST.ANHD)
    )
    (let
        (
            (fvt:string (ref-U|DALOS::UDC_Makeid "GtVault"))
        )
        (map print
            [
                (expect "<<GT-02d>> the vault starts controllable"
                    true (ref-FVT::UR_FVT|CanUpgrade fvt))
                (expect "<<GT-02d>> a control call that sets can-upgrade FALSE is admitted"
                    true (!= "" (format "{}" [(ref-TS02-C3::AQP-FVT|C_Control anhd (AQP-FVT.UR_FVT|OwnerKonto fvt) fvt false true)])))
                (expect "<<GT-02d>> ...and the flag is now false"
                    false (ref-FVT::UR_FVT|CanUpgrade fvt))
                ;;THE ITEM
                (expect-failure "<<GT-02d>> ...so any further control call is refused"
                    "FVT control update requires can-upgrade true"
                    (ref-TS02-C3::AQP-FVT|C_Control anhd (AQP-FVT.UR_FVT|OwnerKonto fvt) fvt false false))
                ;;the one-way property: the owner cannot buy the capability back
                (expect-failure "<<GT-02d>> ...INCLUDING the call that would set it back to true"
                    "FVT control update requires can-upgrade true"
                    (ref-TS02-C3::AQP-FVT|C_Control anhd (AQP-FVT.UR_FVT|OwnerKonto fvt) fvt true true))
            ]
        )
        ""
    )
)
(env-sigs [])
;;IRREVERSIBLE by construction, so it must not be committed -- GT-02e checks it
(rollback-tx)

;;|| NEXT >
;;|| GT-02e — the renunciation left no trace.
;;
(begin-tx "GT-02e - no leakage")
(namespace "ouronet-ns")
(print "--- [GT-02e - 01 - no leakage] ---")
;;GtVault carries the whole rest of this file -- rewards, agency, collect, sweep. A leaked
;;can-upgrade=false could not be repaired by any later test, because the operation that repairs it
;;is the one the flag disables.
(print
    (expect "<<GT-02e>> GtVault is controllable again"
        true (AQP-FVT.UR_FVT|CanUpgrade (U|DALOS.UDC_Makeid "GtVault"))))
(commit-tx)
(print "")
;;
;;|| NEXT >
;;|| GT-03 — open the agency: operator ANHD stakes its 100k -2 frags (=> 1000 quintessence, clears the gate), fee 10%.
;;
(begin-tx "GT-03 - open agency (operator 1000, fee 100 per-mille)")
(namespace "ouronet-ns")
(env-gasmodel "table")(env-gaslimit 120000000)(env-gas 0)
(env-chain-data { "block-time": (time "2027-12-01T00:01:00Z") })
;;==== GT-03 - open agency (operator 1000, fee 100 per-mille) · 01 · env-sigs (caps) ==== =========
(print "--- [GT-03 - open agency (operator 1000, fee 100 per-mille) · 01 · env-sigs (caps)] ---")
(env-sigs
  [ { "key": "PK_AncientHodler", "caps": [] }
    { "key": "6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263"
    , "caps":
      [ (coin.TRANSFER "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263" "k:50d6c59b21e5e6e55baecaa75a1007de37576bde12d8230dc82459cc01b9484b" 1000000.0)
        (coin.TRANSFER "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263" "k:0cb30c0121ff919266121a99ff9359871818932211df94dae4137c29bc0e8f7e" 1000000.0)
        (coin.TRANSFER "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263" "c:XM-pkmuB5XUQlp87ZYSbfKt8qzmHY6O2EHAzMRVBt3k" 1000000.0)
        (coin.TRANSFER "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263" "c:iQQFWj6gWtpGEzhM_O5ekW1QtnQQy55R8BRPGhj_0FU" 1000000.0) ] } ])
(print "--- [GT-03 - 01 - open agency] ---")
;;==== GT-03 - open agency (operator 1000, fee 100 per-mille) · 02 · let / invocation ==== ========
(print "--- [GT-03 - open agency (operator 1000, fee 100 per-mille) · 02 · let / invocation] ---")
(let
    (
        (anhd:string KST.ANHD)
        (dhoc:string "DHOC-98c486052a51")
        (ref-U|DALOS:module{UtilityDalosV2} U|DALOS)
        (ref-SCR:module{AcquisitionScoresV1} AQP-SCORE)
        (ref-TS02-C3:module{TalosStageTwo_ClientThreeV1} TS02-C3)
    )
    (let
        (
            (fvt-id:string  (ref-U|DALOS::UDC_Makeid "GtVault"))
            (pool-id:string (ref-U|DALOS::UDC_Makeid "GtPool"))
            (bsid:string (ref-U|DALOS::UDC_Makeid (concat ["GtAgency" "Bronze"])))
            (ssid:string (ref-U|DALOS::UDC_Makeid (concat ["GtAgency" "Silver"])))
            (gsid:string (ref-U|DALOS::UDC_Makeid (concat ["GtAgency" "Golden"])))
        )
        (let ((triplet-id:string (ref-SCR::UC_ComputeTripletId bsid ssid gsid)))
            ;; atomic open: admit blank triplet member + operator-stake -2 frags + terminal gate; fee 100 per-mille
            (ref-TS02-C3::AQP-DSA|CC_OpenAgency anhd anhd fvt-id pool-id triplet-id 100 dhoc [-2])
            (map print
              [ (expect "<<GT-03>> agency Q = 1000 (operator own)" 1000.0 (AQP-DSA.URC_AgencyQuintessence triplet-id))
                (expect "<<GT-03>> operator recorded on the agency" anhd (AQP-DSA.UR_DSA-AGN|Operator fvt-id triplet-id))
                ;;`04_RPS.pact:587`, FVT|XE>ADMIT-DELEGATION's existence check -- and it is a guard
                ;;that was REPAIRED rather than written correctly the first time. Its own comment
                ;;records the history: the enforce used to sit BELOW a `let` whose bindings hard-read
                ;;SCR|T|Triplet keyed by <triplet-id>, so a triplet that did not exist aborted on
                ;;"row not found" and this message was unreachable for every input. It was hoisted
                ;;above the let, and `URC_TripletExists` is deliberately a with-default-read so it can
                ;;answer for a missing row -- it simply never got the chance.
                ;;
                ;;NOTHING PINNED IT AFTER THE REPAIR, which is the gap this closes. A hoist that is
                ;;never driven is indistinguishable from the bug it fixed.
                ;;Same transaction, same caller, same vault -- only the triplet id is wrong.
                (expect-failure "<<GT-03>> opening an agency on a triplet that was never issued is refused"
                    "Triplet must be issued in AQP-SCORE"
                    (ref-TS02-C3::AQP-DSA|CC_OpenAgency anhd anhd fvt-id pool-id
                        "NOSUCHTRIPLET-98c486052a51" 100 dhoc [-2])) ]))
    )
)
(env-sigs [])
(commit-tx)
(print "")
;;
;;|| NEXT >
;;|| GT-04 — delegators EMMA + LUMY each stake 2000 (Q -> 5000); owner authorizes oracle; oracle writes 10 nodes @ full uptime.
;;
(begin-tx "GT-04 - delegators stake + oracle authorize + write")
(namespace "ouronet-ns")
(env-gasmodel "table")(env-gaslimit 150000000)(env-gas 0)
(env-chain-data { "block-time": (time "2027-12-01T02:00:00Z") })
(env-data { "dsa-oracle": { "keys": ["gt-oracle-key"], "pred": "keys-all" } })
;;==== GT-04 - delegators stake + oracle authorize + write · 01 · env-sigs (caps) ==== ============
(print "--- [GT-04 - delegators stake + oracle authorize + write · 01 · env-sigs (caps)] ---")
(env-sigs
  [ { "key": "PK_AncientHodler", "caps": [] }
    { "key": "PK_Emma", "caps": [] }
    { "key": "PK_Lumy", "caps": [] }
    { "key": "gt-oracle-key", "caps": [] }
    { "key": "6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263"
    , "caps":
      [ (coin.TRANSFER "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263" "k:50d6c59b21e5e6e55baecaa75a1007de37576bde12d8230dc82459cc01b9484b" 1000000.0)
        (coin.TRANSFER "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263" "k:0cb30c0121ff919266121a99ff9359871818932211df94dae4137c29bc0e8f7e" 1000000.0)
        (coin.TRANSFER "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263" "c:XM-pkmuB5XUQlp87ZYSbfKt8qzmHY6O2EHAzMRVBt3k" 1000000.0)
        (coin.TRANSFER "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263" "c:iQQFWj6gWtpGEzhM_O5ekW1QtnQQy55R8BRPGhj_0FU" 1000000.0) ] } ])
(print "--- [GT-04 - 01 - delegators stake + oracle] ---")
;;==== GT-04 - delegators stake + oracle authorize + write · 02 · let / invocation ==== ===========
(print "--- [GT-04 - delegators stake + oracle authorize + write · 02 · let / invocation] ---")
(let
    (
        (anhd:string KST.ANHD) (emma:string KST.EMMA) (lumy:string KST.LUMY)
        (dhoc:string "DHOC-98c486052a51")
        (ref-U|DALOS:module{UtilityDalosV2} U|DALOS)
        (ref-SCR:module{AcquisitionScoresV1} AQP-SCORE)
        (ref-TS02-C3:module{TalosStageTwo_ClientThreeV1} TS02-C3)
    )
    (let
        (
            (fvt-id:string  (ref-U|DALOS::UDC_Makeid "GtVault"))
            (pool-id:string (ref-U|DALOS::UDC_Makeid "GtPool"))
            (bsid:string (ref-U|DALOS::UDC_Makeid (concat ["GtAgency" "Bronze"])))
            (ssid:string (ref-U|DALOS::UDC_Makeid (concat ["GtAgency" "Silver"])))
            (gsid:string (ref-U|DALOS::UDC_Makeid (concat ["GtAgency" "Golden"])))
        )
        (let ((triplet-id:string (ref-SCR::UC_ComputeTripletId bsid ssid gsid)))
            (ref-TS02-C3::AQP-POOL|CC_StakeSemiFungibleCollectable emma pool-id emma emma dhoc [-2])
            (ref-TS02-C3::AQP-POOL|CC_StakeSemiFungibleCollectable lumy pool-id lumy lumy dhoc [-2])
            (ref-TS02-C3::AQP-DSA|C_SetOracleAuth anhd anhd fvt-id (read-keyset "dsa-oracle"))
            ;;THE DEFECT THIS REFACTOR FIXED, PROVEN BOTH WAYS. Until 2026-09-20 all six
            ;;owner-gated DSA entrypoints ran `(enforce (= patron fvt-owner))` -- the GAS PAYER was
            ;;forced to BE the FVT owner, so no sponsor could ever pay for a vault owner's
            ;;operation and the gasless patron was unusable on this whole surface.
            (map print
              [ ;;EMMA sponsors; ANHD (the owner) acts. This call was IMPOSSIBLE before.
                (format "<(sponsored SetOracleAuth: patron=EMMA executor=ANHD)> => \"{}\""
                  [(ref-TS02-C3::AQP-DSA|C_SetOracleAuth emma anhd fvt-id (read-keyset "dsa-oracle"))])
                ;;...and the separation did not become a hole: paying does not confer authority.
                (expect-failure "<<GT-04-SPONSOR>> a sponsoring patron cannot name HIMSELF executor"
                  "Only the FVT owner may set the oracle authority"
                  (ref-TS02-C3::AQP-DSA|C_SetOracleAuth anhd emma fvt-id (read-keyset "dsa-oracle"))) ])
            (ref-TS02-C3::AQP-DSA|C_OracleWrite anhd fvt-id triplet-id 10 1000)
            (map print
              [ (expect "<<GT-04>> agency Q = 5000 (1000 op + 2000 + 2000)" 5000.0 (AQP-DSA.URC_AgencyQuintessence triplet-id))
                (expect "<<GT-04>> capture-units = 2 (min(5000/2000,10))" 2.0 (AQP-FVT.UR_FVT-SEL|CaptureUnits fvt-id triplet-id))
                (expect "<<GT-04>> capture-weight = 2 (full uptime)" 2.0 (AQP-FVT.UR_FVT-SEL|CaptureWeight fvt-id triplet-id)) ]))
    )
)
(env-sigs [])
(commit-tx)
(print "")

;;|| NEXT >
;;|| GT-04b — the COLLECTABLE half of the anchor-repair admission guard.
;;
(begin-tx "GT-04b - AQP|C>SYNC-COLLECTABLE-ANCHORS needs collectable stake to repair")
(env-gasmodel "table")(env-gaslimit 150000000)(env-gas 0)
(namespace "ouronet-ns")
;;==== GT-04b - AQP|C>SYNC-COLLECTABLE-ANCHORS needs collectable stake to repair · 01 · env-sigs (caps) ==== 
(print "--- [GT-04b - AQP|C>SYNC-COLLECTABLE-ANCHORS needs collectable stake to repair · 01 · env-sigs (caps)] ---")
(env-sigs [{ "key": "PK_AncientHodler", "caps": [] }])
(print "--- [GT-04b - 01 - the collectable sync guard, both directions] ---")
;;`03_AQP.pact:832`, the collectable twin of `03_AQP:820` (pinned by
;;`Kursan/AQP-scale-vacate.repl <<SCALE-VAC-SYNC>>`, on the TRUE-FUNGIBLE side). Both are
;;pool-agnostic ANK repair; one walks a beneficiary's DPTF stake, this one their collectable stake.
;;
;;PINNED HERE because GT-04 has just staked DHOC semi-fungible for EMMA and LUMY, and nothing else
;;in the suite gives a beneficiary collectable stake alongside an unstaked account to contrast with.
;;
;;THE TALOS WRAPPER DOES NOT SHADOW IT — checked rather than assumed. `AQP|C>SYNC-SEMI-FUNGIBLE-
;;ANCHORS` in `04_TS02-C3.pact:540` composes `P|TS` and nothing else, so the core cap's own enforce
;;is the first thing that can refuse. Two caps of nearly the same name, and only one carries the
;;rule; had the outer one duplicated it, this assertion would have pinned the wrong module.
;;==== GT-04b - AQP|C>SYNC-COLLECTABLE-ANCHORS needs collectable stake to repair · 02 · let / invocation ==== 
(print "--- [GT-04b - AQP|C>SYNC-COLLECTABLE-ANCHORS needs collectable stake to repair · 02 · let / invocation] ---")
(let
    (
        ;;BYTA, not ANHD. The first draft used the patron as the unstaked contrast and the precondition
        ;;assertion below caught it: ANHD is the AGENCY OPERATOR and stakes DHOC frags of its own, so
        ;;`URC_BenCollectableHasStake anhd dhoc true` is TRUE and the "refusal" quietly succeeded.
        ;;This is exactly the failure the architecture doc warns about -- trip the guard from the LIVE
        ;;state, never from a guessed constant -- and the only reason it was visible is that the
        ;;premise is asserted rather than assumed. An `expect-failure` that does not fail proves
        ;;nothing and nothing else flags it.
        (anhd:string KST.ANHD) (emma:string KST.EMMA) (byta:string KST.BYTA)
        (dhoc:string "DHOC-98c486052a51")
        (ref-AQP:module{AcquisitionPoolsV1} AQP-POOL)
        (ref-TS02-C3:module{TalosStageTwo_ClientThreeV1} TS02-C3)
    )
    (map print
        [
            ;;the premise, read live
            (expect "<<GT-04b>> EMMA holds DHOC collectable stake and BYTA does not"
                [true false]
                [(ref-AQP::URC_BenCollectableHasStake emma dhoc true)
                 (ref-AQP::URC_BenCollectableHasStake byta dhoc true)])
            ;;THE ITEM
            (expect-failure "<<GT-04b>> syncing a beneficiary with no collectable stake is refused"
                "No cross-pool collectable stake to sync"
                (ref-TS02-C3::AQP-POOL|C_SyncSemiFungibleAnchors anhd byta dhoc))
            ;;CONTRAST — same call, staked beneficiary
            (expect "<<GT-04b>> ...while a staked one is admitted"
                true (!= "" (format "{}"
                    [(ref-TS02-C3::AQP-POOL|C_SyncSemiFungibleAnchors anhd emma dhoc)])))
        ]
    )
    ""
)
(env-sigs [])
;;the admitted repair rewrites EMMA's anchors -- GT-04c checks it did not survive
(rollback-tx)

;;|| NEXT >
;;|| GT-04c — the anchor repair left no trace.
;;
(begin-tx "GT-04c - no leakage")
(namespace "ouronet-ns")
(print "--- [GT-04c - 01 - no leakage] ---")
;;GT-05 collects on exactly these delegator positions and asserts the payouts to the decimal. An
;;anchor rewrite that survived would move those numbers without failing anything that names it.
(print
    (expect "<<GT-04c>> EMMA still holds her DHOC collectable stake, unrepaired"
        true (AQP-POOL.URC_BenCollectableHasStake KST.EMMA "DHOC-98c486052a51" true)))
(commit-tx)
(print "")
