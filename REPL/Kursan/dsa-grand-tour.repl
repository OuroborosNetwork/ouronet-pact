(print "")
;;
;;NOT PINNED YET — the TRIPLET twins of the two guards GT-14 just closed.
;;
;;`05_FVT.pact:1948` "Non-mosaic FVT membership mode mismatch for triplet admission"
;;`05_FVT.pact:1957` "Farm triplet: lp-denominator and ghost weight required"
;;
;;These are `UEV_AddScoreEntityTripletContext`'s versions of the two GT-14 pins, and the recipe should
;;transfer almost unchanged -- the differences are known:
;;
;;  * the entity is a TRIPLET, so `URC_ResolveScoreEntitySwpair` takes CT_SCORE_ENTITY_TRIPLET (**3**,
;;    not 1) and resolves the pair through the triplet's SILVER score's pool rather than the score's own;
;;  * the membership mode that REFUSES a triplet is the mirror of GT-14's -- there, TRUE-TRIPLET refused a
;;    SCORE; here a score-only mode should refuse a TRIPLET;
;;  * the farm rule is the same shape, so `ghost-weight 0.0` should isolate it the same way once the
;;    triplet's silver score is class 0, pool-linked and not FVT-linked.
;;
;;WHAT TO REUSE FROM GT-14, because it is what cost the time:
;;    - `AQP-SCR|C_IssueLiquidityScore` needs precision 6 and BOTH multipliers > 0.0, and it is
;;      STOA-priced, so the four managed `coin.TRANSFER` caps must be in scope;
;;    - `mosaic` and `membership-mode` live in `RPS.FVT|T|RewardAggregate`, NOT `FVT|T|RPS|Global`
;;      (that one is the per-reward row; writing to it fails with a schema mismatch that helpfully
;;      prints the expected schema);
;;    - a deliberately WRONG write is a fast way to read a table's schema.
;;
;;The existing triplet on this chain (GtAgencyBronze/Silver/Golden) is class 3, so a class-0 triplet has to
;;be built the same way GT-14 built its score -- three liquidity scores plus `UC_ComputeTripletId`.

(print "")
(print "================================================================")
(begin-tx "GT-DOC1 - the fee reprices FUTURE injects ONLY, never a pending one")
(namespace "ouronet-ns")
(env-gasmodel "table")(env-gaslimit 150000000)(env-gas 0)
(env-chain-data { "block-time": (time "2027-12-01T05:00:00Z") })
;;==== GT-DOC1 - the fee reprices FUTURE injects ONLY, never a pending one · 01 · env-sigs (caps) ==== 
(print "--- [GT-DOC1 - the fee reprices FUTURE injects ONLY, never a pending one · 01 · env-sigs (caps)] ---")
(env-sigs
  [ { "key": "PK_AncientHodler", "caps": [] }
    { "key": "PK_Emma", "caps": [] }
    { "key": "PK_Lumy", "caps": [] }
    { "key": "6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263"
    , "caps":
      [ (coin.TRANSFER "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263" "k:50d6c59b21e5e6e55baecaa75a1007de37576bde12d8230dc82459cc01b9484b" 1000000.0)
        (coin.TRANSFER "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263" "k:0cb30c0121ff919266121a99ff9359871818932211df94dae4137c29bc0e8f7e" 1000000.0)
        (coin.TRANSFER "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263" "c:XM-pkmuB5XUQlp87ZYSbfKt8qzmHY6O2EHAzMRVBt3k" 1000000.0)
        (coin.TRANSFER "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263" "c:iQQFWj6gWtpGEzhM_O5ekW1QtnQQy55R8BRPGhj_0FU" 1000000.0) ] } ])
(print "--- [GT-DOC1 - 01 - change the fee AFTER an inject, before the collect] ---")
;;DOC-CLAIM VERIFICATION (`_docclaims.py` G5). `08_DSA.pact` DSA|C>SET-AGENCY-FEE:
;;
;;   "A fee change is O(1) — IT REPRICES ONLY FUTURE INJECTS (the fee is never baked into a
;;    stored weight)."
;;
;;GT-07 above already drives the forward half: set the fee, THEN inject, and the new rate applies.
;;What nothing tested is the half the sentence actually promises -- that a fee change does NOT
;;reach backwards into an inject that has already happened and is sitting uncollected. That is the
;;difference between a fee schedule and a retroactive one, and a delegator who injected under a 20%
;;operator cut would be silently charged 40% if it were wrong.
;;
;;THE ORDER IS THE TEST: inject at 20%, change the fee to 40% WITHOUT injecting, then collect. The
;;payouts must still be the 20% figures. If the fee were read at collect time -- or baked into the
;;stored weights by the setter -- the operator would take 2000 and the delegators 1200 each.
;;==== GT-DOC1 - the fee reprices FUTURE injects ONLY, never a pending one · 02 · let / invocation ==== 
(print "--- [GT-DOC1 - the fee reprices FUTURE injects ONLY, never a pending one · 02 · let / invocation] ---")
(let
    (
        (anhd:string KST.ANHD) (emma:string KST.EMMA) (lumy:string KST.LUMY)
        (ouro:string "OURO-98c486052a51")
        (ref-U|DALOS:module{UtilityDalosV2} U|DALOS)
        (ref-SCR:module{AcquisitionScoresV1} AQP-SCORE)
        (ref-DSA:module{DsaV1} AQP-DSA)
        (ref-DPTF:module{DemiourgosPactTrueFungibleV2} DPTF)
        (ref-TS02-C3:module{TalosStageTwo_ClientThreeV1} TS02-C3)
    )
    (let
        (
            (fvt-id:string  (ref-U|DALOS::UDC_Makeid "GtVault"))
            (bsid:string (ref-U|DALOS::UDC_Makeid (concat ["GtAgency" "Bronze"])))
            (ssid:string (ref-U|DALOS::UDC_Makeid (concat ["GtAgency" "Silver"])))
            (gsid:string (ref-U|DALOS::UDC_Makeid (concat ["GtAgency" "Golden"])))
        )
        (let ((triplet-id:string (ref-SCR::UC_ComputeTripletId bsid ssid gsid)))
            ;;precondition: the fee is the 20% GT-07 left behind
            (print (format "<(fee before)> => {}" [(ref-DSA::UR_DSA-AGN|FeePerMille fvt-id triplet-id)]))
            ;;1] inject 5000 while the fee is 20%
            (ref-TS02-C3::AQP-FVT|CC_Inject anhd anhd fvt-id ouro 5000.0)
            ;;2] NOW raise the fee to 40%, with the 5000 already injected and uncollected
            (ref-TS02-C3::AQP-DSA|C_SetAgencyFee anhd anhd fvt-id triplet-id 400)
            (map print
                [
                    (expect "<<GT-DOC1>> the fee really did change to 40% before anyone collected"
                        400 (ref-DSA::UR_DSA-AGN|FeePerMille fvt-id triplet-id))
                ]
            )
            ;;3] collect: the payouts must reflect the fee AT INJECT TIME (20%), not the new one
            (let ((op0:decimal (ref-DPTF::UR_AccountSupply ouro anhd)))
                (ref-TS02-C3::AQP-FVT|CC_Collect anhd anhd fvt-id 3 triplet-id ouro)
                (let ((op-got:decimal (- (ref-DPTF::UR_AccountSupply ouro anhd) op0)) (em0:decimal (ref-DPTF::UR_AccountSupply ouro emma)))
                    (ref-TS02-C3::AQP-FVT|CC_Collect emma emma fvt-id 3 triplet-id ouro)
                    (let ((em-got:decimal (- (ref-DPTF::UR_AccountSupply ouro emma) em0)) (lu0:decimal (ref-DPTF::UR_AccountSupply ouro lumy)))
                        (ref-TS02-C3::AQP-FVT|CC_Collect lumy lumy fvt-id 3 triplet-id ouro)
                        (let ((lu-got:decimal (- (ref-DPTF::UR_AccountSupply ouro lumy) lu0)))
                            (print (format "<(op / emma / lumy after a POST-inject fee change)> => {} / {} / {}" [op-got em-got lu-got]))
                            (map print
                              [ ;;THE CLAIM. 1800 is the 20% split; 2000 would be the 40% one.
                                (expect "<<GT-DOC1>> operator is paid at the fee that applied WHEN THE INJECT HAPPENED (20%), not 40%"
                                    1800.0 op-got)
                                (expect "<<GT-DOC1>> EMMA keeps her 20%-net share, not a retroactive 40% cut"
                                    1600.0 em-got)
                                (expect "<<GT-DOC1>> LUMY likewise"
                                    1600.0 lu-got)
                                ;;and the retroactive figures are genuinely different, so the three
                                ;;assertions above are discriminating and not a coincidence
                                (expect "<<GT-DOC1>> ...and 40% WOULD have paid the operator 2000, so those numbers do discriminate"
                                    true (!= 1800.0 2000.0))
                                (expect "<<GT-DOC1>> conservation still holds across the fee change"
                                    5000.0 (+ op-got (+ em-got lu-got))) ]))))))
    )
)
;;restore the fee GT-07 established, so anything appended after this sees the state it expects
(let
    (
        (ref-U|DALOS:module{UtilityDalosV2} U|DALOS)
        (ref-SCR:module{AcquisitionScoresV1} AQP-SCORE)
        (ref-TS02-C3:module{TalosStageTwo_ClientThreeV1} TS02-C3)
    )
    (let
        (
            (fvt-id:string (ref-U|DALOS::UDC_Makeid "GtVault"))
            (bsid:string (ref-U|DALOS::UDC_Makeid (concat ["GtAgency" "Bronze"])))
            (ssid:string (ref-U|DALOS::UDC_Makeid (concat ["GtAgency" "Silver"])))
            (gsid:string (ref-U|DALOS::UDC_Makeid (concat ["GtAgency" "Golden"])))
        )
        (ref-TS02-C3::AQP-DSA|C_SetAgencyFee KST.ANHD KST.ANHD fvt-id
            (ref-SCR::UC_ComputeTripletId bsid ssid gsid) 200)
    )
)
(env-sigs [])
(commit-tx)
