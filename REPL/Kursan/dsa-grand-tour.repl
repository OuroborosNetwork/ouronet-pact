            (ref-TS02-C3::CC_AQP-POOL|StakeSemiFungibleCollectable lumy pool-id lumy lumy dhoc [-2])
            (ref-TS02-C3::A_AQP-DSA|SetOracleAuth anhd fvt-id (read-keyset "dsa-oracle"))
