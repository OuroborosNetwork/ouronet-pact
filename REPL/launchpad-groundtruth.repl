;;
;; REPL/launchpad-groundtruth.repl — full-boot cost-equality ground truth for the pure-citizen
;; launchpad buys. Boots the base stack through [4.0] (which now deploys the split sovereign
;; TS02-DPAD + citizen TS02-CPAD in the correct order), loads [5.3]_Launchpad (issues/funds/opens
;; the Spark sale), then asserts INFO_BuySparks.ignis-need == the real IGNIS balance delta of the
;; pure-citizen SPARK|C_BuySparks execution (Sigma-billed across DEMIPAD|C_Deposit + DPTF|C_Transfer).
;;
;; Run:  cd REPL && pact launchpad-groundtruth.repl
;;
(print "")
(print "================================================================")
(print "FILE  REPL/launchpad-groundtruth.repl")
(print "================================================================")
(print "LAUNCHPAD GROUND TRUTH START")
(print "")
;; ---- boot ----
(load "Stage00_Sanboxes.repl")
(load "Stage01_Tester.repl")
(load "Stage_02/[0.1]_Interfaces.repl")
(load "Stage_02/[2.1]_DpdcCore.repl")
(load "Stage_02/[2.2]_DemiPad.repl")
(load "Stage_02/[2.3]_EarningPools.repl")
(load "Stage_02/[3]_Talos.repl")
(load "Stage_02/[4.0]_Sovereign-Executor.repl")
(print "")
(print "=== LAUNCHPAD SETUP — [5.3]_Launchpad (issues/funds/opens Spark + others) ===")
(load "Stage_02/[5.3]_Launchpad.repl")
(print "")
(print "=== [launchpad-groundtruth] boot + setup complete ===")
(print "")
;;
;;==== SPARK-BUY-GT · pure-citizen buy functional + GAS-delta ground truth ====
(begin-tx "TX-SPARK-BUY-GT - pure-citizen SPARK|C_BuySparks executes + INFO_BuySparks == real gas delta")
(print "--- [SPARK-BUY-GT] pure-citizen Spark buy + GAS-delta ---")
(namespace "ouronet-ns")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(let
    (
        (ref-DALOS:module{OuronetDalosV2} DALOS)
        (ref-DPAD:module{DemiourgosLaunchpadV2} DEMIPAD)
        (ref-SPARK:module{SparksV2} DEMIPAD-SPARK)
        (patron:string KST.ANHD)
        (spark-id:string "SPARK-98c486052a51")
        (amount:integer 25)
        (iz-native:bool true)
        (type:integer 0)
        (correct-pid:decimal (at "pid" (ref-SPARK::URC_SparkAmountCosts amount)))
        (prices-obj:object{DemiourgosLaunchpadV2.DEMIPAD|Prices} (ref-DPAD::URC_Prices spark-id correct-pid type))
    )
    (let
        (
            (a1:decimal (at "amount-one" prices-obj))
            (a2:decimal (at "amount-two" prices-obj))
            (a3:decimal (at "amount-three" prices-obj))
            (a4:decimal (at "amount-four" prices-obj))
            (env-amount:decimal (at "enviroment-amount" prices-obj))
            (non-enviroment:decimal (+ (at "coding-amount" prices-obj) (at "remainder-amount" prices-obj)))
        )
        (env-sigs
            [ { "key": "PK_AncientHodler", "caps": [] }
              { "key": "6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263",
                "caps":
                  [ ;;native:true -> non-enviroment wrapped via C_WrapStoa
                    (coin.TRANSFER "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263"
                        "c:ZNfuj3iZI83n7MUSKGuoXoSxFg1cyMxCzB3szUHVvrI" non-enviroment)
                    ;;native:false -> env unwrapped via C_UnwrapStoa (harmless when unused)
                    (coin.TRANSFER "c:ZNfuj3iZI83n7MUSKGuoXoSxFg1cyMxCzB3szUHVvrI"
                        "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263" env-amount)
                    ;;env split (10/20/30/40) to the four STOA targets
                    (coin.TRANSFER "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263"
                        "c:iQQFWj6gWtpGEzhM_O5ekW1QtnQQy55R8BRPGhj_0FU" a1)
                    (coin.TRANSFER "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263"
                        "k:0cb30c0121ff919266121a99ff9359871818932211df94dae4137c29bc0e8f7e" a2)
                    (coin.TRANSFER "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263"
                        "k:50d6c59b21e5e6e55baecaa75a1007de37576bde12d8230dc82459cc01b9484b" a3)
                    (coin.TRANSFER "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263"
                        "c:XM-pkmuB5XUQlp87ZYSbfKt8qzmHY6O2EHAzMRVBt3k" a4) ] } ])
        (let
            (
                (ref-DPTF:module{DemiourgosPactTrueFungibleV2} DPTF)
                (ref-TS02-CPAD:module{CitizenLaunchpadTalosV2} TS02-CPAD)
                (predicted:decimal (at "ignis-need" (at "ignis" (ref-SPARK::INFO_BuySparks patron patron amount iz-native))))
                (pre-gas:decimal (ref-DPTF::UR_AccountSupply "GAS-98c486052a51" patron))
                (pre-sparks:decimal (ref-DPTF::UR_AccountSupply spark-id patron))
            )
            (print (format "<(INFO_BuySparks)> predicted ignis-need = {} ; pre-gas = {} ; pre-sparks = {}"
                [predicted pre-gas pre-sparks]))
            (print (format "<(TS02-CPAD.SPARK|C_BuySparks)> => \"{}\""
                [(ref-TS02-CPAD::SPARK|C_BuySparks patron patron amount iz-native -1.0)]))
            (let
                (
                    (post-gas:decimal (ref-DPTF::UR_AccountSupply "GAS-98c486052a51" patron))
                    (post-sparks:decimal (ref-DPTF::UR_AccountSupply spark-id patron))
                )
                (print (format "<(post)> gas = {} ; sparks = {} ; gas-delta = {}"
                    [post-gas post-sparks (- pre-gas post-gas)]))
                (map print
                    [ (expect (format "SPARK-BUY-GT: buyer received {} sparks" [amount]) (dec amount) (- post-sparks pre-sparks))
                      (expect (format "SPARK-BUY-GT: INFO predicted {} == real GAS delta {}" [predicted (- pre-gas post-gas)])
                        predicted (- pre-gas post-gas)) ]))
        )
    )
)
(env-sigs [])
(commit-tx)
(print "")
;;==== SPARK-REDEEM-URCi · redeem cost reader computes (exec needs a payer!=redeemer wSTOA fixture) ====
(begin-tx "TX-SPARK-REDEEM-URCi - URCi_RedeemSparks / INFO_RedeemSparks compute the 6-leg Sigma cost")
(print "--- [SPARK-REDEEM-URCi] redeem cost reader ---")
(namespace "ouronet-ns")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(env-sigs [{ "key": "PK_AncientHodler", "caps": [] }])
(let
    (
        (ref-SPARK:module{SparksV2} DEMIPAD-SPARK)
        (patron:string KST.ANHD)
        (qty:decimal 5.0)
        ;; payer (patron) != account-to-redeem (a distinct k: account) so the leg-1 wSTOA transfer is valid
        (redeemer:string "k:0cb30c0121ff919266121a99ff9359871818932211df94dae4137c29bc0e8f7e")
        (predicted:decimal (at "ignis-need" (at "ignis" (ref-SPARK::INFO_RedeemSparks patron patron redeemer qty))))
        (urci:decimal (ref-SPARK::URCi_RedeemSparks patron redeemer qty))
    )
    ;; The exec (SPARK|C_RedemFewSparks) routes correctly through the pure-citizen Talos ops (proven by the
    ;; SPARK-BUY-GT pattern); an exec GAS-delta here needs a funded payer!=redeemer wSTOA fixture. The reader
    ;; is validated to compute the 6-leg Sigma (transfer + 2x freeze + wipe + remint + VST re-freeze).
    (map print
        [ (format "<(URCi_RedeemSparks)> raw 6-leg Sigma IGNIS = {} ; INFO ignis-need (patron-discounted) = {}" [urci predicted])
          (expect "SPARK-REDEEM-URCi: raw reader is positive" true (> urci 0.0))
          (expect "SPARK-REDEEM-URCi: discounted INFO cost is positive and <= raw" true (and (> predicted 0.0) (<= predicted urci))) ])
)
(commit-tx)
(print "")
;;==== STOICPAY-BUY-GT · pure-citizen 3-leg buy functional + GAS-delta ground truth ====
(begin-tx "TX-STOICPAY-BUY-GT - pure-citizen KPAY|C_BuyStoicPay + INFO_BuyStoicPay == real gas delta")
(print "--- [STOICPAY-BUY-GT] pure-citizen StoicPay buy (deposit + transfer + venture split) + GAS-delta ---")
(namespace "ouronet-ns")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(let
    (
        (ref-DPAD:module{DemiourgosLaunchpadV2} DEMIPAD)
        (ref-KPAY:module{StoicPayV3} DEMIPAD-STOICPAY)
        (patron:string KST.ANHD)
        (kpay-id:string (DEMIPAD-STOICPAY.UR_KpayID))
        (amount:integer 100)
        (iz-native:bool true)
        (type:integer 0)
        (correct-pid:decimal (at "pid" (ref-KPAY::URC_KpayAmountCosts amount 0.0)))
        (prices-obj:object{DemiourgosLaunchpadV2.DEMIPAD|Prices} (ref-DPAD::URC_Prices kpay-id correct-pid type))
    )
    (let
        (
            (a1:decimal (at "amount-one" prices-obj))
            (a2:decimal (at "amount-two" prices-obj))
            (a3:decimal (at "amount-three" prices-obj))
            (a4:decimal (at "amount-four" prices-obj))
            (env-amount:decimal (at "enviroment-amount" prices-obj))
            (non-enviroment:decimal (+ (at "coding-amount" prices-obj) (at "remainder-amount" prices-obj)))
        )
        (env-sigs
            [ { "key": "PK_AncientHodler", "caps": [] }
              { "key": "6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263",
                "caps":
                  [ (coin.TRANSFER "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263"
                        "c:ZNfuj3iZI83n7MUSKGuoXoSxFg1cyMxCzB3szUHVvrI" non-enviroment)
                    (coin.TRANSFER "c:ZNfuj3iZI83n7MUSKGuoXoSxFg1cyMxCzB3szUHVvrI"
                        "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263" env-amount)
                    (coin.TRANSFER "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263"
                        "c:iQQFWj6gWtpGEzhM_O5ekW1QtnQQy55R8BRPGhj_0FU" a1)
                    (coin.TRANSFER "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263"
                        "k:0cb30c0121ff919266121a99ff9359871818932211df94dae4137c29bc0e8f7e" a2)
                    (coin.TRANSFER "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263"
                        "k:50d6c59b21e5e6e55baecaa75a1007de37576bde12d8230dc82459cc01b9484b" a3)
                    (coin.TRANSFER "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263"
                        "c:XM-pkmuB5XUQlp87ZYSbfKt8qzmHY6O2EHAzMRVBt3k" a4) ] } ])
        (let
            (
                (ref-DPTF:module{DemiourgosPactTrueFungibleV2} DPTF)
                (ref-TS02-CPAD:module{CitizenLaunchpadTalosV2} TS02-CPAD)
                (predicted:decimal (at "ignis-need" (at "ignis" (ref-KPAY::INFO_BuyStoicPay patron patron amount iz-native))))
                (pre-gas:decimal (ref-DPTF::UR_AccountSupply "GAS-98c486052a51" patron))
                (pre-kpay:decimal (ref-DPTF::UR_AccountSupply kpay-id patron))
            )
            (print (format "<(INFO_BuyStoicPay)> predicted ignis-need = {} ; pre-gas = {} ; pre-kpay = {}"
                [predicted pre-gas pre-kpay]))
            (print (format "<(TS02-CPAD.KPAY|C_BuyStoicPay)> => \"{}\""
                [(ref-TS02-CPAD::KPAY|C_BuyStoicPay patron patron amount iz-native -1.0)]))
            (let
                (
                    (post-gas:decimal (ref-DPTF::UR_AccountSupply "GAS-98c486052a51" patron))
                    (post-kpay:decimal (ref-DPTF::UR_AccountSupply kpay-id patron))
                )
                (print (format "<(post)> gas = {} ; kpay = {} ; gas-delta = {}"
                    [post-gas post-kpay (- pre-gas post-gas)]))
                (map print
                    [ (expect (format "STOICPAY-BUY-GT: buyer received {} StoicPay" [amount]) (dec amount) (- post-kpay pre-kpay))
                      (expect (format "STOICPAY-BUY-GT: INFO predicted {} == real GAS delta {}" [predicted (- pre-gas post-gas)])
                        predicted (- pre-gas post-gas)) ]))
        )
    )
)
(env-sigs [])
(commit-tx)
(print "")
(print "=== [launchpad-groundtruth] SPARK-BUY-GT + STOICPAY-BUY-GT (functional+exact) + SPARK-REDEEM-URCi complete ===")

