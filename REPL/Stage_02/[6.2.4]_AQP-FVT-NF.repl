(begin-tx "TX-FVT-NF-02 - late NF anchor + C_SyncNonFungibleAnchors")
(print "")
(print "=== TX-FVT-NF-02 — C_SyncNonFungibleAnchors after late NF anchor ============")
(namespace "ouronet-ns")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(let
    (
        (patron:string KST.ANHD)
        (beneficiary-id:string KST.ANHD)
        (dpnf-id:string "DHB-98c486052a51")
        (boost-class-name:string "NfSyncBoost")
        (ref-DALOS:module{OuronetDalosV1} DALOS)
        (ref-U|DALOS:module{UtilityDalosV1} U|DALOS)
        (ref-TS02-C3:module{TalosStageTwo_ClientThreeV1} TS02-C3)
        (ref-AQP:module{AcquisitionPoolsV1} AQP-POOL)
        (ref-ANK:module{AcquisitionAnchorsV1} AQP-ANK)
        (anchor-id:string (ref-U|DALOS::UDC_Makeid "NfSyncAnchor"))
        (aa-pre:integer (ref-ANK::UR_AA|AnchorsActive dpnf-id))
        (need-pre:bool (ref-AQP::URC_BenDpnfAnchorsNeedSync beneficiary-id dpnf-id))
        (split-std:[decimal]
            (ref-DALOS::URC_SplitKDAPrices patron (* 2.0 (ref-DALOS::UR_UsagePrice "standard")))
        )
    )
    (print "--- [TX-FVT-NF-02 · 01 · issue NF set-class anchor on DHB class 0] ---")
    (print (format "<(need-sync/aa pre)> => \"{}\" / {}" [need-pre aa-pre]))
    (env-sigs
        [
            { "key": "PK_AncientHodler", "caps": [] }
            { "key": "6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263",
              "caps":
                [
                    (coin.TRANSFER "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263" "k:50d6c59b21e5e6e55baecaa75a1007de37576bde12d8230dc82459cc01b9484b" (at 2 split-std))
                    (coin.TRANSFER "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263" "k:0cb30c0121ff919266121a99ff9359871818932211df94dae4137c29bc0e8f7e" (at 0 split-std))
                    (coin.TRANSFER "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263" "c:XM-pkmuB5XUQlp87ZYSbfKt8qzmHY6O2EHAzMRVBt3k" (at 3 split-std))
                    (coin.TRANSFER "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263" "c:iQQFWj6gWtpGEzhM_O5ekW1QtnQQy55R8BRPGhj_0FU" (at 1 split-std))
                ]
            }
        ]
    )
    (print (format "<(AQP-ANK|C_IssueNonFungibleSetAnchor NfSyncAnchor)> => \"{}\"" [
        (ref-TS02-C3::AQP-ANK|C_IssueNonFungibleSetAnchor
            patron "NfSyncAnchor" dpnf-id true boost-class-name 3 50.0 0)
    ]))
    (let
        (
            (need-mid:bool (ref-AQP::URC_BenDpnfAnchorsNeedSync beneficiary-id dpnf-id))
            (aa-mid:integer (ref-ANK::UR_AA|AnchorsActive dpnf-id))
            (anchor-live:bool (ref-ANK::UR_ANK|State anchor-id))
        )
        (map print
            [
                (format "<(need-sync/aa after-issue)> => \"{}\" / {}" [need-mid aa-mid])
                (expect (format "<<TX-FVT-NF-02>> NF anchor live got={}" [anchor-live]) true anchor-live)
                (expect (format "<<TX-FVT-NF-02>> anchors-active increased got={} pre={}" [aa-mid aa-pre]) true (> aa-mid aa-pre))
                (expect (format "<<TX-FVT-NF-02>> need-sync true got={}" [need-mid]) true need-mid)
            ]
        )
        (print "--- [TX-FVT-NF-02 · 02 · C_SyncNonFungibleAnchors] ---")
        (env-sigs [{ "key": "PK_AncientHodler", "caps": [] }])
        (print (format "<(AQP-POOL|C_SyncNonFungibleAnchors)> => \"{}\"" [
            (ref-TS02-C3::AQP-POOL|C_SyncNonFungibleAnchors patron beneficiary-id dpnf-id)
        ]))
        (let
            (
                (need-post:bool (ref-AQP::URC_BenDpnfAnchorsNeedSync beneficiary-id dpnf-id))
                (sync-count:integer (ref-AQP::UR_AQP|BenDpnfLastAnkSyncCount beneficiary-id dpnf-id))
                (aa-now:integer (ref-ANK::UR_AA|AnchorsActive dpnf-id))
            )
            (map print
                [
                    (format "<(need-sync/sync-count/aa after-sync)> => \"{}\" / {} / {}" [need-post sync-count aa-now])
                    (expect (format "<<TX-FVT-NF-02>> need-sync false got={}" [need-post]) false need-post)
                    (expect (format "<<TX-FVT-NF-02>> sync-count==aa got={} expected={}" [sync-count aa-now]) aa-now sync-count)
                ]
            )
        )
    )
)
(env-sigs [])
(commit-tx)
(print "=== END TX-FVT-NF-02 =======================================================")
(print "")
;;||>>>>>>>>>>>>>>>>>>>>>>>>>
;;|| NEXT                   >
;;||>>>>>>>>>>>>>>>>>>>>>>>>>
(print "")
