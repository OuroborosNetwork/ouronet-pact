(begin-tx "ARW-SHAPE-02 - WHICH role gates the bulk op: recreate, not update")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(namespace "ouronet-ns")
;;==== ARW-SHAPE-02 · 01 · env-sigs (caps) ====
(print "--- [ARW-SHAPE-02 · 01 · env-sigs (caps)] ---")
(env-sigs [{ "key": "PK_AncientHodler", "caps": [] }])
;;==== ARW-SHAPE-02 · 02 · revoke role-update, keep role-recreate ====
(print "--- [ARW-SHAPE-02 · 02 · revoke role-update] ---")
;;  THE ONLY THING THAT CAN TELL THE TWO ROLES APART.
;;
;;  `UEV_RoleNftRecreateON` and `UEV_RoleNftUpdateON` emit the byte-identical
;;  refusal string, so a failing call cannot say which role it wanted. And the
;;  fixture owner holds BOTH, so any positive test passes under either reading --
;;  which is exactly how 20 emitted files came to name role-update.
;;
;;  So: turn role-update OFF, leave role-recreate ON, and run the same body. If it
;;  succeeds, role-update is provably NOT the gate. role-recreate has no toggle
;;  (`DPNF|C_MoveRecreateRole` is move-only), which is why the test is built this
;;  way round rather than the other.
(let
    (
        (ref-DPDC:module{DpdcV2} DPDC)
        (ref-TS02-C2:module{TalosStageTwo_ClientTwoV2} TS02-C2)
        (id:string "ARWQ-98c486052a51")
        (owner:string KST.ANHD)
    )
    (map print
        [
            (format "<(DPNF|C_ToggleUpdateRole off)> => [{}]"
                [(ref-TS02-C2::DPNF|C_ToggleUpdateRole owner owner owner id false)])
            (expect "<<ARW-SHAPE-02>> role-update is now OFF" false
                (ref-DPDC::UR_CA|R-Update id false owner))
            (expect "<<ARW-SHAPE-02>> role-recreate is still ON" true
                (ref-DPDC::UR_CA|R-Recreate id false owner))
        ]
    )
    ""
)
;;==== ARW-SHAPE-02 · 03 · the same body, on nonce 8, with role-update revoked ====
(print "--- [ARW-SHAPE-02 · 03 · the body still works] ---")
(let
    (
        (patron:string KST.ANHD)
        (executor:string (ouronet-ns.DPDC.UR_OwnerKonto "ARWQ-98c486052a51" false))
        (id:string "ARWQ-98c486052a51")
        (nonces:[integer]
            [
            8
            ]
        )
        (links:[[string]]
            [
              ["https://arweave.net/SELFTEST/512x512/0008.jpg" "https://arweave.net/SELFTEST/FULL/0008.jpg"]
            ]
        )
    )
    (ouronet-ns.TS02-C2.DPNF|C_UpdateNonces patron executor id nonces true
        (map
            (lambda (i:integer)
                (+
                    { "uri-primary"   : (ouronet-ns.DPDC-UDC.UDC_URI|Data (at 0 (at i links)) "|" "|" "|" "|" "|" "|")
                    , "uri-secondary" : (ouronet-ns.DPDC-UDC.UDC_URI|Data (at 1 (at i links)) "|" "|" "|" "|" "|" "|") }
                    (remove "uri-secondary"
                        (remove "uri-primary"
                            (ouronet-ns.DPDC.UR_NativeNonceData id false (at i nonces))
                        )
                    )
                )
            )
            (enumerate 0 (- (length links) 1))
        )
    )
)
;;==== ARW-SHAPE-02 · 04 · the verdict ====
(print "--- [ARW-SHAPE-02 · 04 · the verdict] ---")
(map print
    [
        (expect "<<ARW-SHAPE-02>> the bulk op SUCCEEDED without role-update, so role-update is NOT the gate"
            "https://arweave.net/SELFTEST/512x512/0008.jpg"
            (at "image" (at "uri-primary"
                (ouronet-ns.DPDC.UR_NativeNonceData "ARWQ-98c486052a51" false 8))))
    ]
)
(print "===^^^===")
(commit-tx)


;;||>>>>>>>>>>>>>>>>>>>>>>>>>
;;|| NEXT                   >
;;||>>>>>>>>>>>>>>>>>>>>>>>>>

(begin-tx "ARW-SHAPE-03 - the SFT half: DPSF via TS02-C1, nonce row AND set row")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(namespace "ouronet-ns")
;;==== ARW-SHAPE-03 · 01 · env-sigs (STOA fee caps) ====
(print "--- [ARW-SHAPE-03 · 01 · env-sigs (STOA fee caps)] ---")
(let
    (
        (ref-DALOS:module{OuronetDalosV2} DALOS)
        (owner:string KST.ANHD)
        (price:decimal (ref-DALOS::UR_UsagePrice "dpsf"))
        (split:[decimal] (ref-DALOS::URC_SplitSTOAPrices owner price))
        (t0:decimal (at 0 split))
        (t1:decimal (at 1 split))
        (t2:decimal (at 2 split))
        (t3:decimal (at 3 split))
    )
    (env-sigs
        [
            { "key": "PK_AncientHodler", "caps": [] }
            { "key": "6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263",
              "caps":
                [
                    (coin.TRANSFER "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263"
                        "k:50d6c59b21e5e6e55baecaa75a1007de37576bde12d8230dc82459cc01b9484b" t2)
                    (coin.TRANSFER "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263"
                        "k:0cb30c0121ff919266121a99ff9359871818932211df94dae4137c29bc0e8f7e" t0)
                    (coin.TRANSFER "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263"
                        "c:XM-pkmuB5XUQlp87ZYSbfKt8qzmHY6O2EHAzMRVBt3k" t3)
                    (coin.TRANSFER "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263"
                        "c:iQQFWj6gWtpGEzhM_O5ekW1QtnQQy55R8BRPGhj_0FU" t1)
                ]
            }
        ]
    )
)
;;==== ARW-SHAPE-03 · 02 · issue an SFT collection with a set-class ====
(print "--- [ARW-SHAPE-03 · 02 · issue SFT ARWS] ---")
(let
    (
        (ref-DPDC:module{DpdcV2} DPDC)
        (ref-DPDC-UDC:module{DpdcUdcV2} DPDC-UDC)
        (ref-TS02-C1:module{TalosStageTwo_ClientOneV2} TS02-C1)
        (owner:string KST.ANHD)
        (b:string "|")
    )
    (map print
        [
            (format "<(DPSF|C_Issue ArweaveShapeS/ARWS)> => [{}]"
                [(ref-TS02-C1::DPSF|C_Issue owner owner owner "ArweaveShapeS" "ARWS"
                    true true true true true true true true)])
        ]
    )
    (let
        (
;;  LOOKED UP BY TICKER, not hardcoded: this collection is minted in this
;;  transaction, so its id suffix is not knowable when this file is generated.
            (id:string
                (at 0
                    (filter
                        (lambda (i:string)
                            (= "ARWS" (ref-DPDC::UR_Ticker i true)))
                        (ref-DPDC::URH_OwnedCollectables owner true)
                    )
                )
            )
            (nd:object{DpdcUdcV2.DPDC|NonceData}
                (ref-DPDC-UDC::UDC_NonceData
                    5.0 7.0
                    "ARWS-NAME" "ARWS-DESC"
                    (ref-DPDC-UDC::UDC_NonceMetaData 42.0 [0]
                        { "Rarity" : "ARWS-RARITY" })
                    (ref-DPDC-UDC::UDC_URI|Type true false false false false false false)
                    (ref-DPDC-UDC::UDC_URI|Data "ipfs://sft-old-primary"   b b b b b b)
                    (ref-DPDC-UDC::UDC_URI|Data "ipfs://sft-old-secondary" b b b b b b)
                    (ref-DPDC-UDC::UDC_ZeroURI|Data)
                )
            )
        )
        (map print
            [
                (format "<(DPSF|C_Create 2 ARWS nonces)> => [{}]"
                    [(ref-TS02-C1::DPSF|C_Create owner
                        (ref-DPDC::UR_Verum5 id true) id [100 100]
                        [nd nd])])
                (expect "<<ARW-SHAPE-03>> ARWS has 2 native nonces" 2
                    (ref-DPDC::UR_NoncesUsed id true))
                (expect "<<ARW-SHAPE-03>> pre-state: nonce 1 uri-primary is on IPFS"
                    "ipfs://sft-old-primary"
                    (at "image" (at "uri-primary"
                        (ref-DPDC::UR_NativeNonceData id true 1))))
                (format "<(SFT collection id)> => [{}]" [id])
                ""
            ]
        )
    )
)
(print "===^^^===")
(commit-tx)

