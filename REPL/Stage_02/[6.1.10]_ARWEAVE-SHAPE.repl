(begin-tx "ARW-SHAPE-01 - the emitted DPNF|C_UpdateNonces read-overlay body")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(namespace "ouronet-ns")
;;==== ARW-SHAPE-01 · 01 · env-sigs (caps) ====
(print "--- [ARW-SHAPE-01 · 01 · env-sigs (caps)] ---")
(env-sigs [{ "key": "PK_AncientHodler", "caps": [] }])
;;==== ARW-SHAPE-01 · 02 · pre-state ====
(print "--- [ARW-SHAPE-01 · 02 · pre-state] ---")
(let
    (
        (nd:object{DpdcUdcV2.DPDC|NonceData}
            (ouronet-ns.DPDC.UR_NativeNonceData "ARWQ-98c486052a51" false 3))
    )
    (map print
        [
            (format "<(pre uri-primary)> => [{}]" [(at "image" (at "uri-primary" nd))])
;;  Non-vacuity: the slot really is on IPFS before the body runs, so the
;;  assertions below measure a CHANGE rather than agreeing with a coincidence.
            (expect "<<ARW-SHAPE-01>> pre-state: uri-primary is still the IPFS link"
                "ipfs://old-primary" (at "image" (at "uri-primary" nd)))
        ]
    )
    ""
)
;;==== ARW-SHAPE-01 · 03 · THE EMITTED BODY, rendered by emit_code ====
(print "--- [ARW-SHAPE-01 · 03 · the emitted body] ---")
(let
    (
        (patron:string KST.ANHD)
        (executor:string (ouronet-ns.DPDC.UR_OwnerKonto "ARWQ-98c486052a51" false))
        (id:string "ARWQ-98c486052a51")
        (nonces:[integer]
            [
            1 2 3 4 5 6 7
            ]
        )
        (links:[[string]]
            [
              ["https://arweave.net/SELFTEST/512x512/0001.jpg" "https://arweave.net/SELFTEST/FULL/0001.jpg"]
              ["https://arweave.net/SELFTEST/512x512/0002.jpg" "https://arweave.net/SELFTEST/FULL/0002.jpg"]
              ["https://arweave.net/SELFTEST/512x512/0003.jpg" "https://arweave.net/SELFTEST/FULL/0003.jpg"]
              ["https://arweave.net/SELFTEST/512x512/0004.jpg" "https://arweave.net/SELFTEST/FULL/0004.jpg"]
              ["https://arweave.net/SELFTEST/512x512/0005.jpg" "https://arweave.net/SELFTEST/FULL/0005.jpg"]
              ["https://arweave.net/SELFTEST/512x512/0006.jpg" "https://arweave.net/SELFTEST/FULL/0006.jpg"]
              ["https://arweave.net/SELFTEST/512x512/0007.jpg" "https://arweave.net/SELFTEST/FULL/0007.jpg"]
            ]
        )
    )
    (ouronet-ns.TS02-C2.DPNF|C_UpdateNonces patron executor id nonces true
        (map
            (lambda (i:integer)
                (+
                    { "uri-primary"   : (ouronet-ns.DPDC-UDC.UDC_URI|Data (at 0 (at i links)) "|" "|" "|" "|" "|" "|")
                    , "uri-secondary" : (ouronet-ns.DPDC-UDC.UDC_URI|Data (at 1 (at i links)) "|" "|" "|" "|" "|" "|") }
                    (remove "uri-secondary"
                        (remove "uri-primary"
                            (ouronet-ns.DPDC.UR_NativeNonceData id false (at i nonces))
                        )
                    )
                )
            )
            (enumerate 0 (- (length links) 1))
        )
    )
)
;;==== ARW-SHAPE-01 · 04 · assertions ====
(print "--- [ARW-SHAPE-01 · 04 · assertions] ---")
(let
    (
        (nd:object{DpdcUdcV2.DPDC|NonceData}
            (ouronet-ns.DPDC.UR_NativeNonceData "ARWQ-98c486052a51" false 3))
        (sib:object{DpdcUdcV2.DPDC|NonceData}
            (ouronet-ns.DPDC.UR_NativeNonceData "ARWQ-98c486052a51" false 8))
    )
    (map print
        [
;;  The two slots land, and they land in the RIGHT one. Primary is the 512x512 and
;;  secondary the FULL -- the convention every minter follows, and the exact thing
;;  the Bunny RGB Set got wrong by reading one binding twice (fixed 2026-10-02).
            (expect "<<ARW-SHAPE-01>> uri-primary is the 512x512 arweave link"
                "https://arweave.net/SELFTEST/512x512/0003.jpg"
                (at "image" (at "uri-primary" nd)))
            (expect "<<ARW-SHAPE-01>> uri-secondary is the FULL arweave link"
                "https://arweave.net/SELFTEST/FULL/0003.jpg"
                (at "image" (at "uri-secondary" nd)))
            (expect "<<ARW-SHAPE-01>> the two slots differ"
                false
                (= (at "image" (at "uri-primary" nd))
                   (at "image" (at "uri-secondary" nd))))
;;  THE READ-OVERLAY'S WHOLE JUSTIFICATION. `C_UpdateNonces` takes a FULL row, so a
;;  version of this that retyped the row by hand would pass every assertion above
;;  while silently blanking everything below -- across 15,586 rows, with no way to
;;  recover the originals. These are the ones that tell an overlay from a rewrite.
            (expect "<<ARW-SHAPE-01>> name survives the URI write"
                "ARW-NAME" (at "name" nd))
            (expect "<<ARW-SHAPE-01>> description survives"
                "ARW-DESC" (at "description" nd))
            (expect "<<ARW-SHAPE-01>> meta-data survives"
                "ARW-RARITY" (at "Rarity" (at "meta-data" (at "meta-data" nd))))
;;  `score` rides inside meta-data and is what AQP-SCORE reads for a per-nonce
;;  score definition. Losing it would silently rescore staked collectables.
            (expect "<<ARW-SHAPE-01>> meta-data score survives"
                42.0 (at "score" (at "meta-data" nd)))
            (expect "<<ARW-SHAPE-01>> royalty survives"
                5.0 (at "royalty" nd))
;;  `ignis` is the one that would actually hurt. Per DPDC Audit #26M its sibling
;;  `royalty` has NO on-chain consumer yet, while `ignis` IS read by DPDC-T's
;;  transfer pricing -- so a rewrite that dropped it would silently reprice every
;;  transfer of all 15,586 migrated nonces. (The field is `ignis`; `ignis-royalty`
;;  is what the first draft of this line guessed, and it does not exist.)
            (expect "<<ARW-SHAPE-01>> ignis survives -- DPDC-T prices transfers on it"
                7.0 (at "ignis" nd))
;;  asset-type too -- which the single-field C_UpdateNonceURI would have OVERWRITTEN
;;  from its own `ay` argument. Choosing the bulk op preserved it for free.
            (expect "<<ARW-SHAPE-01>> asset-type image flag survives"
                true (at "image" (at "asset-type" nd)))
;;  And the slot the round does NOT write stays as it was.
            (expect "<<ARW-SHAPE-01>> uri-tertiary is left alone"
                (at "uri-tertiary" sib) (at "uri-tertiary" nd))
;;  The control is nonce 8: INSIDE the fixture (which holds 8) but OUTSIDE the batch
;;  (which covers 1..7). A control outside the fixture proves nothing -- it aborts on
;;  a missing row instead, which is how this assertion was first written.
            (expect "<<ARW-SHAPE-01>> nonce 8, outside the batch, is still on IPFS"
                "ipfs://old-primary" (at "image" (at "uri-primary" sib)))
        ]
    )
    ""
)
(print "===^^^===")
(commit-tx)


