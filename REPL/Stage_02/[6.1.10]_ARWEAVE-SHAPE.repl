(begin-tx "ARW-SHAPE-04 - the emitted DPSF nonce body, rendered by emit_code")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(namespace "ouronet-ns")
;;==== ARW-SHAPE-04 · 01 · env-sigs (caps) ====
(print "--- [ARW-SHAPE-04 · 01 · env-sigs (caps)] ---")
(env-sigs [{ "key": "PK_AncientHodler", "caps": [] }])
;;==== ARW-SHAPE-04 · 02 · THE EMITTED SFT BODY (son=true -> TS02-C1) ====
(print "--- [ARW-SHAPE-04 · 02 · the emitted SFT body] ---")
(let
    (
;;  Rebound by TICKER each time, because a `let` cannot outlive its transaction and
;;  the suffix is not knowable when this file is generated.
        (SFT-ID:string
            (at 0
                (filter
                    (lambda (i:string) (= "ARWS" (ouronet-ns.DPDC.UR_Ticker i true)))
                    (ouronet-ns.DPDC.URH_OwnedCollectables KST.ANHD true)
                )
            )
        )
    )
    (let
        (
            (patron:string KST.ANHD)
            (executor:string (ouronet-ns.DPDC.UR_OwnerKonto SFT-ID true))
            (id:string SFT-ID)
            (nonces:[integer]
                [
                1 2
                ]
            )
            (links:[[string]]
                [
                  ["https://arweave.net/SELFTEST/512x512/s1.jpg" "https://arweave.net/SELFTEST/FULL/s1.jpg"]
                  ["https://arweave.net/SELFTEST/512x512/s2.jpg" "https://arweave.net/SELFTEST/FULL/s2.jpg"]
                ]
            )
        )
        (ouronet-ns.TS02-C1.DPSF|C_UpdateNonces patron executor id nonces true
            (map
                (lambda (i:integer)
                    (+
                        { "uri-primary"   : (ouronet-ns.DPDC-UDC.UDC_URI|Data (at 0 (at i links)) "|" "|" "|" "|" "|" "|")
                        , "uri-secondary" : (ouronet-ns.DPDC-UDC.UDC_URI|Data (at 1 (at i links)) "|" "|" "|" "|" "|" "|") }
                        (remove "uri-secondary"
                            (remove "uri-primary"
                                (ouronet-ns.DPDC.UR_NativeNonceData id true (at i nonces))
                            )
                        )
                    )
                )
                (enumerate 0 (- (length links) 1))
            )
        )
    )
)
;;==== ARW-SHAPE-04 · 03 · the nonce row really changed ====
(print "--- [ARW-SHAPE-04 · 03 · verdict] ---")
(let
    (
;;  Rebound by TICKER each time, because a `let` cannot outlive its transaction and
;;  the suffix is not knowable when this file is generated.
        (SFT-ID:string
            (at 0
                (filter
                    (lambda (i:string) (= "ARWS" (ouronet-ns.DPDC.UR_Ticker i true)))
                    (ouronet-ns.DPDC.URH_OwnedCollectables KST.ANHD true)
                )
            )
        )
    )
    (map print
        [
            (expect "<<ARW-SHAPE-04>> DPSF|C_UpdateNonces overlaid uri-primary on the NONCE row"
                "https://arweave.net/SELFTEST/512x512/s1.jpg"
                (at "image" (at "uri-primary"
                    (ouronet-ns.DPDC.UR_NativeNonceData SFT-ID true 1))))
            (expect "<<ARW-SHAPE-04>> and uri-secondary, which is the slot the .png census is about"
                "https://arweave.net/SELFTEST/FULL/s2.jpg"
                (at "image" (at "uri-secondary"
                    (ouronet-ns.DPDC.UR_NativeNonceData SFT-ID true 2))))
;;  CARRY-ACROSS: the read-overlay must leave every non-URI field alone. This is
;;  the whole justification for taking a full row and replacing two keys rather
;;  than retyping the row in the transaction.
            (expect "<<ARW-SHAPE-04>> name carried across untouched" "ARWS-NAME"
                (at "name" (ouronet-ns.DPDC.UR_NativeNonceData SFT-ID true 1)))
            (expect "<<ARW-SHAPE-04>> ignis royalty carried across untouched" 7.0
                (at "ignis" (ouronet-ns.DPDC.UR_NativeNonceData SFT-ID true 1)))
            ""
        ]
    )
)
(print "===^^^===")
(commit-tx)

(print "=== END FILE [6.1.10]_ARWEAVE-SHAPE.repl (emitted shape executes) ===")
