;;
;; REPL/Stage_02/[6.1.10]_ARWEAVE-SHAPE.repl -- the Deploy/4_Arweave emitted shape
;;   Legend (terminal observability): <(...)> echoes; (expect ...) lines print.
;;   Source: GENERATED by REPL/tools/_arweave.py --selftest. Do not hand-edit --
;;           the body in group 03 is rendered by `emit_code`, the SAME function
;;           that writes Deploy/4_Arweave/*.pact, so this suite proves the shape
;;           the owner actually signs rather than a retyped copy of it.
;;   Fixture: ITS OWN collection (ARWQ). Depends on no other suite -- see the note
;;           in _arweave.py:selftest_repl about why that matters here.
;;   REPL tests: ARW-SHAPE-01
;;
(print "")
(print "================================================================")
(print "FILE  REPL/Stage_02/[6.1.10]_ARWEAVE-SHAPE.repl  (Arweave URI migration shape)")
(print "================================================================")
(print "")
;;
(begin-tx "ARW-SHAPE-00 - own fixture: issue ARWQ and mint 8 nonces")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(namespace "ouronet-ns")
;;==== ARW-SHAPE-00 · 01 · env-sigs (STOA fee caps) ====
(print "--- [ARW-SHAPE-00 · 01 · env-sigs (STOA fee caps)] ---")
;;  Issuing a collection costs 250 STOA, so the patron needs KDA fuel granted in
;;  THIS transaction -- `env-sigs` does not carry across one. The first version of
;;  this suite omitted the block and died in `coin.transfer` inside
;;  `IGNIS.XB_MoveDalosFuel`, which reads as an IGNIS defect and is a missing
;;  signature.
;;
;;  Lifted from [6.1.4]_DPDC-NF TX-NF-001 · 01, where the same issue is paid for.
;;  The amounts are DERIVED (`URC_SplitSTOAPrices` over the live `dpnf` usage price)
;;  rather than written down, so a price change does not silently underfund this.
(let
    (
        (ref-DALOS:module{OuronetDalosV2} DALOS)
        (owner:string KST.ANHD)
        (dpnf-price:decimal (ref-DALOS::UR_UsagePrice "dpnf"))
        (split-dpnf:[decimal] (ref-DALOS::URC_SplitSTOAPrices owner dpnf-price))
        (t0:decimal (at 0 split-dpnf))
        (t1:decimal (at 1 split-dpnf))
        (t2:decimal (at 2 split-dpnf))
        (t3:decimal (at 3 split-dpnf))
    )
    (env-sigs
        [
            { "key": "PK_AncientHodler", "caps": [] }
            { "key": "6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263",
              "caps":
                [
                    (coin.TRANSFER "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263"
                        "k:50d6c59b21e5e6e55baecaa75a1007de37576bde12d8230dc82459cc01b9484b" t2)
                    (coin.TRANSFER "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263"
                        "k:0cb30c0121ff919266121a99ff9359871818932211df94dae4137c29bc0e8f7e" t0)
                    (coin.TRANSFER "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263"
                        "c:XM-pkmuB5XUQlp87ZYSbfKt8qzmHY6O2EHAzMRVBt3k" t3)
                    (coin.TRANSFER "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263"
                        "c:iQQFWj6gWtpGEzhM_O5ekW1QtnQQy55R8BRPGhj_0FU" t1)
                ]
            }
        ]
    )
)
;;==== ARW-SHAPE-00 · 02 · issue + mint with KNOWN field values ====
(print "--- [ARW-SHAPE-00 · 02 · issue + mint] ---")
;;  Every non-URI field gets a value named HERE, so the assertions in ARW-SHAPE-01
;;  compare against something this file controls. The two URI slots start on IPFS,
;;  which is also what makes the migration observable rather than assumed.
(let
    (
        (ref-DPDC:module{DpdcV2} DPDC)
        (ref-DPDC-UDC:module{DpdcUdcV2} DPDC-UDC)
        (ref-TS02-C2:module{TalosStageTwo_ClientTwoV2} TS02-C2)
        (owner:string KST.ANHD)
        (b:string "|")
    )
    (map print
        [
            (format "<(DPNF|C_Issue ArweaveShapeQ/ARWQ)> => [{}]"
                [(ref-TS02-C2::DPNF|C_Issue owner owner owner "ArweaveShapeQ" "ARWQ"
                    true true true true true true true true)])
        ]
    )
    (let
        (
            (id:string "ARWQ-98c486052a51")
            (nd:object{DpdcUdcV2.DPDC|NonceData}
                (ref-DPDC-UDC::UDC_NonceData
                    5.0
                    7.0
                    "ARW-NAME"
                    "ARW-DESC"
                    (ref-DPDC-UDC::UDC_NonceMetaData 42.0 [0]
                        { "Rarity" : "ARW-RARITY" })
                    (ref-DPDC-UDC::UDC_URI|Type true false false false false false false)
                    (ref-DPDC-UDC::UDC_URI|Data "ipfs://old-primary"   b b b b b b)
                    (ref-DPDC-UDC::UDC_URI|Data "ipfs://old-secondary" b b b b b b)
                    (ref-DPDC-UDC::UDC_ZeroURI|Data)
                )
            )
        )
        (map print
            [
                (format "<(DPNF|C_Create 8 ARWQ nonces)> => [{}]"
                    [(ref-TS02-C2::DPNF|C_Create owner
                        (ref-DPDC::UR_Verum5 id false) id (make-list 8 nd))])
                (expect "<<ARW-SHAPE-00>> ARWQ has 8 native nonces" 8
                    (ref-DPDC::UR_NoncesUsed id false))
;;  The role the BULK entrypoint actually needs: role-RECREATE, via
;;  DPDC-N|C>SET-DATA -> UEV_RoleNftRecreateON. Asserted here because the first
;;  draft of this round named role-update in all 20 emitted headers, and the
;;  mistake was INVISIBLE: the fixture owner holds every role, so an assertion on
;;  the wrong one passed and the body succeeded anyway. ARW-SHAPE-02 below is what
;;  actually distinguishes them.
                (expect "<<ARW-SHAPE-00>> owner holds role-recreate (gates the bulk op)"
                    true (ref-DPDC::UR_CA|R-Recreate id false
                        (ref-DPDC::UR_OwnerKonto id false)))
                (expect "<<ARW-SHAPE-00>> owner ALSO holds role-update -- which is why an assertion on it proves nothing"
                    true (ref-DPDC::UR_CA|R-Update id false
                        (ref-DPDC::UR_OwnerKonto id false)))
;;  And every nonce is a plain nonce, not a Set instance -- the condition
;;  UEV_NotSetInstance enforces, and the one precondition in every emitted file
;;  that cannot be checked offline.
                (expect "<<ARW-SHAPE-00>> nonce 3 is not a Set instance" 0
                    (ref-DPDC::UR_NonceClass id false 3))
                ""
            ]
        )
    )
)
(print "===^^^===")
(commit-tx)

