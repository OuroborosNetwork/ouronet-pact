(begin-tx "TX-SCORE-14 - three SCORE owner gates on entities the attacker does not own")
(print "")
(print "=== TX-SCORE-14 — SF-definition / triplet / NF-set owner gates ===============")
(namespace "ouronet-ns")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
;;==== TX-SCORE-14 · 01 · three shadows, three gates ==============================
(print "--- [TX-SCORE-14 · 01 · three shadows, three gates] ---")
;;Unlike TX-SCORE-12/13, these three gates read the owner OUT OF AN EXISTING ROW rather than taking it
;;as an argument, so the fixture has to be an entity ANHD already owns and the attack is "write to
;;someone else's score". All three fixtures are the boot scores created in TX-SCORE-08/09, and the
;;preconditions each gate's earlier `enforce` depends on are ASSERTED rather than assumed -- if a
;;future suite flips one of them, the precondition goes red instead of the refusal quietly becoming
;;vacuous again.
;;
;;a] `SCR|C>ISSUE-SF-SCORE-DEFINITION` -- earlier: score row exists, sft-equality FALSE, both lists
;;   non-empty and aligned, max nonce <= DPDC nonces-used. Then ownership. TheCodingDivision is the
;;   only class-3 fixture with sft-equality false AND a DPSF (DHCD) deep enough for nonce 11.
;;b] `SCR|C>ISSUE-TRIPLET` -- earlier: all three rows exist, pairwise distinct, same owner, same
;;   score-class, category not INVALID, none already in a triplet. Then ownership.
;;c] `SCR|XI>X_ISSUE-NF-SCORE-DEFINITION` -- composed only; the client op that reaches it here is
;;   `C_IssueNonFungibleSetScoreDefinition`. SET mode, not trait mode, ON PURPOSE: trait mode runs
;;   `UEV_NonFungibleScoreDefinitionTrait`, which reads nonce 1's metadata off the DPNF, and in the
;;   AQP-FAST profile KBN has no minted nonce at all (TX004 in `[6.2.1]` asserts zero). A trait-mode
;;   attack would die in that reader and never reach ownership. Set mode needs no nonce: with
;;   `UR_SetClassesUsed` at 0 the only in-range nonce-class is 0, which is what the gate call uses.
;;   Its shadow is the enforce IMMEDIATELY above the ownership line, inside the same defcap.
(env-sigs [{ "key": "PK_Emma", "caps": [] }])
(let
    (
        (attacker:string KST.EMMA)
        (victim:string KST.ANHD)
        (coding-id:string "TheCodingDivision-98c486052a51")
        (shareholder-id:string "DemiourgosShareholder-98c486052a51")
        (snakes-id:string "DemiourgosSnakes-98c486052a51")
        (bloodshed-id:string "Bloodshed-98c486052a51")
        (dhcd-id:string "DHCD-98c486052a51")
        (kbn-id:string "KBN-98c486052a51")
        (ref-SCR:module{AcquisitionScoresV1} AQP-SCORE)
        (ref-DPDC:module{DpdcV2} DPDC)
        (ref-TS02-C3:module{TalosStageTwo_ClientThreeV1} TS02-C3)
    )
    (map print
        [
            (expect "<<TX-SCORE-14>> the attacker is not the victim"
                false (= attacker victim))
            ;;--- a] SF score definition ------------------------------------------------------------
            (expect "<<TX-SCORE-14 SF-DEF>> TheCodingDivision is owned by the victim (SF-DEF precondition)"
                victim (ref-SCR::UR_SCR|ScoreOwnerKonto coding-id))
            (expect "<<TX-SCORE-14 SF-DEF>> ...and its sft-equality is false, which the guard requires"
                false (ref-SCR::UR_SCR|ScoreSftEquality coding-id))
            (expect "<<TX-SCORE-14 SF-DEF>> ...and DHCD is deep enough for nonce 11"
                true (>= (ref-DPDC::UR_NoncesUsed dhcd-id true) 11))
            (expect-failure "<<TX-SCORE-14 SF-DEF>> SHADOW: misaligned nonce/value lists are refused by the input enforce, NOT by ownership"
                "Invalid score/dpsf inputs: score must exist, sft-equality false, nonce/value lists aligned, and max nonce <= DPDC nonces-used"
                (ref-TS02-C3::AQP-SCR|C_IssueSemiFungibleScoreDefinition attacker coding-id dhcd-id [11] [1.0 2.0]))
            (expect-failure "<<TX-SCORE-14 SF-DEF>> GATE: aligned lists reach CAP_EnforceAccountOwnership, which refuses and names the victim"
                "Keyset failure (keys-all): [PK_Ancie...]"
                (ref-TS02-C3::AQP-SCR|C_IssueSemiFungibleScoreDefinition attacker coding-id dhcd-id [11] [1.0]))
            ;;--- b] triplet ------------------------------------------------------------------------
            (expect "<<TX-SCORE-14 TRIPLET>> all three trio members are class 3 (same-class conjunct)"
                [3 3 3] [(ref-SCR::UR_SCR|ScoreClass coding-id) (ref-SCR::UR_SCR|ScoreClass shareholder-id) (ref-SCR::UR_SCR|ScoreClass snakes-id)])
            (expect "<<TX-SCORE-14 TRIPLET>> ...and none of them is already in a triplet"
                [false false false] [(ref-SCR::UR_SCR|ScoreTriplet coding-id) (ref-SCR::UR_SCR|ScoreTriplet shareholder-id) (ref-SCR::UR_SCR|ScoreTriplet snakes-id)])
            (expect-failure "<<TX-SCORE-14 TRIPLET>> SHADOW: a non-distinct trio is refused by the bundle enforce, NOT by ownership"
                "SCR|C>ISSUE-TRIPLET: executor must be the scores' owner; scores must exist, be distinct, same owner and score-class, valid category, not already in a triplet"
                (ref-TS02-C3::AQP-SCR|C_IssueTriplet attacker attacker coding-id coding-id snakes-id))
            ;;SHADOW 2 (new, 2026-09-20) -- the `executor` guard added by the patron/executor refactor.
            ;;The attacker names HIMSELF as executor on a trio he does not own. Distinct, same class,
            ;;untripleted: every other conjunct passes, so this can ONLY be the executor conjunct.
            ;;Without this the new guard would be invisible -- the GATE case below deliberately
            ;;satisfies it, and a guard nothing ever fails on is indistinguishable from an absent one.
            (expect-failure "<<TX-SCORE-14 TRIPLET>> SHADOW2: naming YOURSELF executor over a trio you do not own is refused"
                "SCR|C>ISSUE-TRIPLET: executor must be the scores' owner"
                (ref-TS02-C3::AQP-SCR|C_IssueTriplet attacker attacker coding-id shareholder-id snakes-id))
            ;;GATE -- per CLAUDE.md, a fixture that SATISFIES the first guard exposes BOTH. The
            ;;attacker now claims to act AS the victim (executor = victim), so the executor conjunct
            ;;passes and the only thing left that can refuse is the ownership keyset. This is also
            ;;the more realistic attack: impersonation, not a malformed request.
            (expect-failure "<<TX-SCORE-14 TRIPLET>> GATE: claiming to BE the victim reaches CAP_EnforceAccountOwnership, which refuses and names him"
                "Keyset failure (keys-all): [PK_Ancie...]"
                (ref-TS02-C3::AQP-SCR|C_IssueTriplet attacker victim coding-id shareholder-id snakes-id))
            ;;--- c] NF set-mode score definition ----------------------------------------------------
            (expect "<<TX-SCORE-14 NF-SET>> Bloodshed is a class-4 score owned by the victim"
                [4 victim] [(ref-SCR::UR_SCR|ScoreClass bloodshed-id) (ref-SCR::UR_SCR|ScoreOwnerKonto bloodshed-id)])
            ;;SHADOW 1 -- the set-range enforce inside `UEV_NonFungibleScoreDefinitionSet`, which runs
            ;;before the composed cap is even entered. The out-of-range class is computed from the
            ;;LIVE `UR_SetClassesUsed` rather than hard-coded: the AQP-FAST profile mints no KBN
            ;;nonce-classes and the FULL profile mints some, and a literal here would silently start
            ;;testing the in-range branch on one of the two. (It did: the first draft asserted
            ;;"set-classes used = 0" and went red under `AQP-comprehensive.repl`.)
            (expect-failure "<<TX-SCORE-14 NF-SET>> SHADOW 1: an out-of-range nonce-class is refused by the set-range enforce, NOT by ownership"
                "Invalid DPNF set score definition (nonce-class="
                (ref-TS02-C3::AQP-SCR|C_IssueNonFungibleSetScoreDefinition attacker bloodshed-id kbn-id [(+ 1 (ref-DPDC::UR_SetClassesUsed kbn-id false))] [1.0]))
            ;;SHADOW 2 -- the enforce IMMEDIATELY above the ownership line, inside the target defcap.
            (expect-failure "<<TX-SCORE-14 NF-SET>> SHADOW 2: a class-3 score is refused by the class enforce one line above the gate"
                "Invalid score/dpnf: score must exist as DPNF (class 4) with matching score-id"
                (ref-TS02-C3::AQP-SCR|C_IssueNonFungibleSetScoreDefinition attacker coding-id kbn-id [0] [1.0]))
            ;;THE GATE. nonce-class 0 is in range for ANY value of `UR_SetClassesUsed`, so this call
            ;;clears both shadows in every profile.
            (expect-failure "<<TX-SCORE-14 NF-SET>> GATE: a class-4 score reaches CAP_EnforceAccountOwnership, which refuses and names the victim"
                "Keyset failure (keys-all): [PK_Ancie...]"
                (ref-TS02-C3::AQP-SCR|C_IssueNonFungibleSetScoreDefinition attacker bloodshed-id kbn-id [0] [1.0]))
            ;;...and every refusal was TOTAL: no triplet was marked, and nonce 11 still carries the
            ;;value TX-SCORE-11 left on it.
            (expect "<<TX-SCORE-14>> ...and no score was marked as belonging to a triplet"
                [false false false] [(ref-SCR::UR_SCR|ScoreTriplet coding-id) (ref-SCR::UR_SCR|ScoreTriplet shareholder-id) (ref-SCR::UR_SCR|ScoreTriplet snakes-id)])
            (expect "<<TX-SCORE-14>> ...and the SF definition for nonce 11 is untouched"
                75.0 (ref-SCR::UR_S-DEF|SFScoreNonceScoreValue coding-id dhcd-id 11))
        ]
    )
    ""
)
(print "")
(print (format "<(REPL|env-gas)> TX-SCORE-14 after rollback => \"{}\"" [(env-gas)]))
(env-sigs [])
(rollback-tx)
(print "")
(print "=== END TX-SCORE-14 ==========================================================")
(print "")
;;||>>>>>>>>>>>>>>>>>>>>>>>>>
;;|| NEXT                   >
;;||>>>>>>>>>>>>>>>>>>>>>>>>>
(print "")
(begin-tx "TX-SCORE-14b - the identical three writes, with the score owner signing, must WORK")
(print "")
(print "=== TX-SCORE-14b — SF-definition / triplet / NF-set non-vacuity controls =====")
(namespace "ouronet-ns")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
;;==== TX-SCORE-14b · 01 · non-vacuity ===========================================
(print "--- [TX-SCORE-14b · 01 · non-vacuity] ---")
;;The three calls below are byte-identical to TX-SCORE-14's three GATE lines except for the signature
;;and the patron. Each one must SUCCEED, and each is checked on STATE rather than on the return
;;string, so a wrapper that reported success without writing would not pass. Rolled back: the AQP
;;chain downstream of this file expects these scores untripleted and nonce 11 at 75.0.
(env-sigs [{ "key": "PK_AncientHodler", "caps": [] }])
(let
    (
        (patron:string KST.ANHD)
        (coding-id:string "TheCodingDivision-98c486052a51")
        (shareholder-id:string "DemiourgosShareholder-98c486052a51")
        (snakes-id:string "DemiourgosSnakes-98c486052a51")
        (bloodshed-id:string "Bloodshed-98c486052a51")
        (dhcd-id:string "DHCD-98c486052a51")
        (kbn-id:string "KBN-98c486052a51")
        (ref-SCR:module{AcquisitionScoresV1} AQP-SCORE)
        (ref-TS02-C3:module{TalosStageTwo_ClientThreeV1} TS02-C3)
    )
    (map print
        [
            (format "<(TS02-C3.AQP-SCR|C_IssueSemiFungibleScoreDefinition, owner signing)> => \"{}\"" [(ref-TS02-C3::AQP-SCR|C_IssueSemiFungibleScoreDefinition patron coding-id dhcd-id [11] [1.0])])
            (format "<(TS02-C3.AQP-SCR|C_IssueTriplet, owner signing)> => \"{}\"" [(ref-TS02-C3::AQP-SCR|C_IssueTriplet patron patron coding-id shareholder-id snakes-id)])
            (format "<(TS02-C3.AQP-SCR|C_IssueNonFungibleSetScoreDefinition, owner signing)> => \"{}\"" [(ref-TS02-C3::AQP-SCR|C_IssueNonFungibleSetScoreDefinition patron bloodshed-id kbn-id [0] [1.0])])
        ]
    )
    (map print
        [
            (expect "<<TX-SCORE-14b>> with the owner signing, the identical SF definition lands on nonce 11"
                1.0 (ref-SCR::UR_S-DEF|SFScoreNonceScoreValue coding-id dhcd-id 11))
            (expect "<<TX-SCORE-14b>> ...the identical triplet is bundled, and all three rows are marked"
                [true true true] [(ref-SCR::UR_SCR|ScoreTriplet coding-id) (ref-SCR::UR_SCR|ScoreTriplet shareholder-id) (ref-SCR::UR_SCR|ScoreTriplet snakes-id)])
            (expect "<<TX-SCORE-14b>> ...and the identical NF set-mode definition lands on nonce-class 0"
                1.0 (ref-SCR::UR_N-DEF|NFClassScoreTraitScoreValue bloodshed-id kbn-id 0))
        ]
    )
    ""
)
(print "")
(print (format "<(REPL|env-gas)> TX-SCORE-14b after rollback => \"{}\"" [(env-gas)]))
(env-sigs [])
(rollback-tx)
(print "")
(print "=== END TX-SCORE-14b · FILE [6.2.2]_AQP-SCORE.repl DONE =======================")
(print "=== AQP-FAST: TX-SCORE-01–09,11–14b run; FULL: restore TX-SCORE-10 + [6.2.1] TX006–007 ===")
(print "")
