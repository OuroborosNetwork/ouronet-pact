;;WHY AN AQP-FVT GATE LIVES IN THE SCORE SUITE. `FVT|C>ISSUE-FVT` belongs to `[6.2.4]_AQP-FVT.repl`,
;;which is not in this change's writable scope. It is placed here because it is the SAME CONSTRUCTION
;;as TX-SCORE-12 -- `CAP_EnforceAccountOwnership` applied to an owner-konto ARGUMENT at issuance, with
;;the identical fixture shape -- and because both suites run before the FVT one, so nothing downstream
;;can have latched. Move it to `[6.2.4]` when that file is next touched.
(begin-tx "TX-SCORE-13 - FVT|C>ISSUE-FVT: claiming an owner-konto you do not control")
(print "")
(print "=== TX-SCORE-13 — FVT|C>ISSUE-FVT owner gate (non-owner refused) =============")
(namespace "ouronet-ns")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
;;==== TX-SCORE-13 · 01 · two shadows, and the gate behind them ===================
(print "--- [TX-SCORE-13 · 01 · two shadows, and the gate behind them] ---")
;;FOUR checks run before `CAP_EnforceAccountOwnership owner-konto`:
;;  1] fvt-class in 0..2 AND fvt-name unused
;;  2] the common-denominator branch enforce (class 0 needs a native DPTF; classes 1-2 need "|")
;;  3] DPTF::UEV_id on the denominator (class-0 branch only)
;;  4] UEV_AutostakeIndex <fvt-name>
;;TWO of them are trippable from the client surface, and both are shown below before the fixture that
;;satisfies them -- so the gate assertion cannot be crediting either.
(env-sigs [{ "key": "PK_Emma", "caps": [] }])
(let
    (
        (attacker:string KST.EMMA)
        (victim:string KST.ANHD)
        (fvt-name:string "RtFvtOwnerProbe")
        (ref-U|DALOS:module{UtilityDalosV2} U|DALOS)
        (ref-TS02-C3:module{TalosStageTwo_ClientThreeV1} TS02-C3)
    )
    (map print
        [
            ;;NON-VACUITY OF THE FIXTURE. `URC_FvtExists` is reached by MODULE NAME rather than through
            ;;`ref-RPS::`, because it is NOT declared on `AcquisitionRewardPerShareV1` -- see the
            ;;FINDING note under TX-SCORE-13b.
            (expect "<<TX-SCORE-13>> the attacker is not the victim"
                false (= attacker victim))
            (expect "<<TX-SCORE-13>> the fvt-name is unused, so check (1) cannot be what refuses"
                false (RPS.URC_FvtExists (ref-U|DALOS::UDC_Makeid fvt-name)))
            ;;SHADOW 1 -- an out-of-band fvt-class trips check (1).
            (expect-failure "<<TX-SCORE-13>> SHADOW 1: fvt-class 3 is refused by the class/name enforce, NOT by ownership"
                "Invalid FVT issue: fvt-class must be 0..2 and fvt-name must be unused"
                (ref-TS02-C3::AQP-FVT|C_Issue attacker fvt-name victim 3 "|"))
            ;;SHADOW 2 -- a valid class with the wrong denominator trips check (2), one step closer.
            (expect-failure "<<TX-SCORE-13>> SHADOW 2: a vault with a DPTF denominator is refused by the denominator enforce, NOT by ownership"
                "Vault/Treasury FVT common-denominator must be |"
                (ref-TS02-C3::AQP-FVT|C_Issue attacker fvt-name victim 1 "OURO-98c486052a51"))
            ;;THE GATE. Class 1 with "|" satisfies all four; the message becomes a keyset failure
            ;;naming the VICTIM's key.
            (expect-failure "<<TX-SCORE-13>> GATE: a well-formed vault reaches CAP_EnforceAccountOwnership, which refuses and names the victim"
                "Keyset failure (keys-all): [PK_Ancie...]"
                (ref-TS02-C3::AQP-FVT|C_Issue attacker fvt-name victim 1 "|"))
            ;;...and the refusal was TOTAL.
            (expect "<<TX-SCORE-13>> ...and no FVT row was created by any of the three attempts"
                false (RPS.URC_FvtExists (ref-U|DALOS::UDC_Makeid fvt-name)))
        ]
    )
    ""
)
(print "")
(print (format "<(REPL|env-gas)> TX-SCORE-13 after rollback => \"{}\"" [(env-gas)]))
(env-sigs [])
(rollback-tx)
(print "")
(print "=== END TX-SCORE-13 ==========================================================")
(print "")
;;||>>>>>>>>>>>>>>>>>>>>>>>>>
;;|| NEXT                   >
;;||>>>>>>>>>>>>>>>>>>>>>>>>>
(print "")
(begin-tx "TX-SCORE-13b - the identical FVT issuance, with the named owner signing, must WORK")
(print "")
(print "=== TX-SCORE-13b — FVT|C>ISSUE-FVT non-vacuity control =======================")
(namespace "ouronet-ns")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
;;==== TX-SCORE-13b · 01 · non-vacuity ===========================================
(print "--- [TX-SCORE-13b · 01 · non-vacuity] ---")
;;FINDING, recorded here because this is where it bites: `FVT|C>ISSUE-FVT` calls
;;`(ref-RPS::URC_FvtExists fvt-id)` on a `module{AcquisitionRewardPerShareV1}` reference, and
;;`URC_FvtExists` is NOT among that interface's declared members (04_RPS.pact lines 1-84 declare
;;`URC_FvtRpsGlobalRowExists`, `URC_FvtScoreEntityLinkRowExists` and `URC_MultipletFamilyExists`, but
;;not this one). VERIFIED BY EXECUTION that this is not a load error: Pact 5.4 resolves a modref member
;;dynamically against the concrete module, so `ref-RPS::URC_FvtExists` simply works -- which is exactly
;;why nothing surfaces it. Nothing is broken today; what is broken is the repo's coupling contract,
;;"only the used interface members matter". A second implementer of `AcquisitionRewardPerShareV1` would
;;satisfy the type and fail at runtime on the very first conjunct of the FVT issuance guard. The
;;precondition above therefore calls the module directly, which is the honest form for a member that
;;is not on the interface. Reported, not fixed -- `.pact` sources are out of this change's scope.
(let
    (
        (patron:string KST.ANHD)
        (owner-konto:string KST.ANHD)
        (fvt-name:string "RtFvtOwnerProbe")
        (ref-DALOS:module{OuronetDalosV2} DALOS)
        (ref-U|DALOS:module{UtilityDalosV2} U|DALOS)
        (ref-RPS:module{AcquisitionRewardPerShareV1} RPS)
        (ref-TS02-C3:module{TalosStageTwo_ClientThreeV1} TS02-C3)
        (split-stoa:[decimal]
            (ref-DALOS::URC_SplitSTOAPrices KST.ANHD (ref-DALOS::UR_UsagePrice "smart"))
        )
    )
    (env-sigs
        [
            { "key": "PK_AncientHodler", "caps": [] }
            { "key": "6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263",
              "caps":
                [
                    (coin.TRANSFER "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263" "k:50d6c59b21e5e6e55baecaa75a1007de37576bde12d8230dc82459cc01b9484b" (at 2 split-stoa))
                    (coin.TRANSFER "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263" "k:0cb30c0121ff919266121a99ff9359871818932211df94dae4137c29bc0e8f7e" (at 0 split-stoa))
                    (coin.TRANSFER "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263" "c:XM-pkmuB5XUQlp87ZYSbfKt8qzmHY6O2EHAzMRVBt3k" (at 3 split-stoa))
                    (coin.TRANSFER "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263" "c:iQQFWj6gWtpGEzhM_O5ekW1QtnQQy55R8BRPGhj_0FU" (at 1 split-stoa))
                ]
            }
        ]
    )
    (print (format "<(TS02-C3.AQP-FVT|C_Issue, named owner signing)> => \"{}\"" [(ref-TS02-C3::AQP-FVT|C_Issue patron fvt-name owner-konto 1 "|")]))
    (map print
        [
            (expect "<<TX-SCORE-13b>> with the named owner signing, the identical issuance succeeds"
                owner-konto (ref-RPS::UR_FVT|OwnerKonto (ref-U|DALOS::UDC_Makeid fvt-name)))
        ]
    )
    ""
)
(print "")
(print (format "<(REPL|env-gas)> TX-SCORE-13b after rollback => \"{}\"" [(env-gas)]))
(env-sigs [])
(rollback-tx)
(print "")
(print "=== END TX-SCORE-13b =========================================================")
