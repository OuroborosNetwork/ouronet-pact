(print "")
;;RED-TEAM ADDITION 2026-09-17 — TX-SCORE-12 … TX-SCORE-14b.
;;
;;WHAT THESE FIVE BLOCKS ARE FOR. Five owner gates in the Stage-2 AQP issuance surface had never been
;;shown refusing anybody: `SCR|XI>ISSUE-SCORE`, `FVT|C>ISSUE-FVT`, `SCR|C>ISSUE-SF-SCORE-DEFINITION`,
;;`SCR|C>ISSUE-TRIPLET` and `SCR|XI>X_ISSUE-NF-SCORE-DEFINITION`. MEASURED, not assumed: every
;;pre-existing `expect-failure` in the tree that drives one of their client ops trips an ARGUMENT or
;;SHAPE guard and signs as the owner -- `<<AQP-G16>>` (precision / nft-score-model / lp-denominator),
;;`<<AQP-G18>>` (fvt-class / denominator / name reuse), `<<AQP-G17>>` and `<<TX-SCR L7#19>>` (list
;;alignment, negative values), `<<AQP-G14>>` / `<<GT-16>>` (triplet distinctness, denominator) and
;;`<<AQP-F11>>` (set-class range). Not one of them is an ownership refusal, so deleting the
;;`CAP_EnforceAccountOwnership` line from any of the five would not have turned one assertion red --
;;the exact condition DEFECT-LEDGER 7.2h exists to name, and a shadowed gate is indistinguishable
;;from an absent one from the outside.
;;
;;ALL FIVE SIT BEHIND A BUSINESS `enforce`, AND NONE OF THEM IS FIXED BY REORDERING. Ordering can
;;expose only ONE of two state-dependent guards at a time; a FIXTURE that satisfies the earlier guard
;;exposes BOTH. Each block below therefore does two things a naive attack cannot: it satisfies every
;;check that runs before ownership, and it proves it did so with a DIFFERENTIAL PAIR -- one call with
;;a bad business input showing the EARLIER check's message, then the same call with a good input
;;showing the OWNERSHIP message. The pair is what separates "refused" from "refused by this gate".
;;
;;THE ATTACKER IS EMMA. EMMA is an ordinary standard account and is NOT a member of the Demiurgoi
;;master keyset (ANHD + FLRN), so no refusal of hers can be confused with an admin decision. The
;;VICTIM is ANHD, who owns every AQP fixture in this file -- and ANHD is safe in the victim role: the
;;ambiguity CLAUDE.md warns about (ANHD being both an ordinary key and a Demiurgoi master) only bites
;;when ANHD is the ATTACKER, because then a SUCCESS could mean "admitted as admin". EMMA is also the
;;foreign signer `[6.2.10]` `TX-AQP-NEG-OWNER2` uses for the AQP family, so "a known non-owner" means
;;the same identity in both suites.
;;
;;EVERY REFUSAL BELOW NAMES `PK_Ancie...` -- ANHD's key, the VICTIM's -- and NOT `PK_Emma`. That is
;;what tells "the owner gate refused" apart from "the attacker's own signature was rejected", which
;;would pass while proving the opposite (RT-D-004's lesson).
;;
;;All five blocks end in `rollback-tx`: the attacks write nothing by construction, and the non-vacuity
;;controls write a score, an FVT, a definition row and a triplet which must NOT survive into the rest
;;of the AQP chain.
(print "")
(begin-tx "TX-SCORE-12 - SCR|XI>ISSUE-SCORE: claiming an owner-konto you do not control")
(print "")
(print "=== TX-SCORE-12 — SCR|XI>ISSUE-SCORE owner gate (non-owner refused) ==========")
(namespace "ouronet-ns")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
;;==== TX-SCORE-12 · 01 · the shadow, and the gate behind it ======================
(print "--- [TX-SCORE-12 · 01 · the shadow, and the gate behind it] ---")
;;`SCR|XI>ISSUE-SCORE` is the shared core of all five `SCR|C>ISSUE-*-SCORE` client caps; this block
;;reaches it through the SemiFungible one (score-class 3), which is the client op `[6.2.2]` already
;;drives in TX-SCORE-01. The gate is `CAP_EnforceAccountOwnership owner-konto`, and owner-konto is an
;;ARGUMENT: the attack is not "take someone's score" but "mint a new score in someone else's name".
;;
;;THREE checks run BEFORE the ownership call:
;;  1] the compound enforce on precision / score-class / the three multipliers / nft-score-model
;;  2] the lp-denominator enforce (BAR for classes 1-4; supplied by the class-3 wrapper, so it cannot
;;     be tripped from the client surface -- listed for completeness, not used as the shadow)
;;  3] UEV_AutostakeIndex <score-name>
;;The differential pair below trips (1) and then satisfies it.
(env-sigs [{ "key": "PK_Emma", "caps": [] }])
(let
    (
        (attacker:string KST.EMMA)
        (victim:string KST.ANHD)
        (score-name:string "RtScrOwnerProbe")
        (ref-U|DALOS:module{UtilityDalosV2} U|DALOS)
        (ref-SCR:module{AcquisitionScoresV1} AQP-SCORE)
        (ref-TS02-C3:module{TalosStageTwo_ClientThreeV1} TS02-C3)
    )
    (map print
        [
            ;;NON-VACUITY OF THE FIXTURE: the attacker is not the victim, and the name is free -- so
            ;;neither "same account" nor an insert collision can be what refuses below.
            (expect "<<TX-SCORE-12>> the attacker is not the victim"
                false (= attacker victim))
            (expect "<<TX-SCORE-12>> the score-name is unused, so nothing collides on insert"
                false (contains (ref-U|DALOS::UDC_Makeid score-name) (ref-SCR::URH_SCR|AllScoreIds)))
            ;;THE SHADOW, DEMONSTRATED. precision 2 is below the [3,24] band, so check (1) refuses
            ;;before ownership is ever consulted. A test written this way passes identically with
            ;;`CAP_EnforceAccountOwnership` deleted.
            (expect-failure "<<TX-SCORE-12>> SHADOW: precision 2 is refused by the argument enforce, NOT by ownership"
                "Invalid precision, score-class, mx-frozen, mx-sleeping, mx-hibernated or nft-score-model"
                (ref-TS02-C3::AQP-SCR|C_IssueSemiFungibleScore attacker victim score-name 2 true))
            ;;THE GATE. The identical call with precision 3. The message changes to a keyset failure
            ;;naming the VICTIM's key, so the refusal is attributable to the ownership call and to
            ;;nothing upstream of it.
            (expect-failure "<<TX-SCORE-12>> GATE: precision 3 reaches CAP_EnforceAccountOwnership, which refuses and names the victim"
                "Keyset failure (keys-all): [PK_Ancie...]"
                (ref-TS02-C3::AQP-SCR|C_IssueSemiFungibleScore attacker victim score-name 3 true))
            ;;AND THE PATRON IS NOT WHAT IS BEING TESTED. Same attack with the VICTIM named as patron
            ;;-- i.e. with the attacker not even paying -- is refused identically, because STOA and
            ;;IGNIS collection both happen INSIDE the `with-capability` body, strictly after the
            ;;defcap has already refused. Asserted rather than read off the call chain: eager `let`
            ;;bindings in Talos wrappers and core `C_`s routinely fire before the `with-capability`
            ;;that follows them, so "the gate runs first" is a claim that has to be executed.
            (expect-failure "<<TX-SCORE-12>> ...and naming the victim as patron changes nothing: the gate is upstream of billing"
                "Keyset failure (keys-all): [PK_Ancie...]"
                (ref-TS02-C3::AQP-SCR|C_IssueSemiFungibleScore victim victim score-name 3 true))
            ;;...and the refusal was TOTAL.
            (expect "<<TX-SCORE-12>> ...and no score row was created by any of the three attempts"
                false (contains (ref-U|DALOS::UDC_Makeid score-name) (ref-SCR::URH_SCR|AllScoreIds)))
        ]
    )
    ""
)
(print "")
(print (format "<(REPL|env-gas)> TX-SCORE-12 after rollback => \"{}\"" [(env-gas)]))
(env-sigs [])
(rollback-tx)
(print "")
(print "=== END TX-SCORE-12 ==========================================================")
(print "")
;;||>>>>>>>>>>>>>>>>>>>>>>>>>
;;|| NEXT                   >
;;||>>>>>>>>>>>>>>>>>>>>>>>>>
(print "")
(begin-tx "TX-SCORE-12b - the identical score issuance, with the named owner signing, must WORK")
(print "")
(print "=== TX-SCORE-12b — SCR|XI>ISSUE-SCORE non-vacuity control ====================")
(namespace "ouronet-ns")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
;;==== TX-SCORE-12b · 01 · non-vacuity ===========================================
(print "--- [TX-SCORE-12b · 01 · non-vacuity] ---")
;;An `expect-failure` proves a call was refused, never that the operation works when it should.
;;Without this control TX-SCORE-12 would still be green if the score-name, the class or the STOA
;;wiring were wrong in some way that refuses EVERYBODY -- the refusal would be real and the
;;attribution false. The call below differs from TX-SCORE-12's GATE line only in who signs.
(let
    (
        (patron:string KST.ANHD)
        (owner-konto:string KST.ANHD)
        (score-name:string "RtScrOwnerProbe")
        (ref-DALOS:module{OuronetDalosV2} DALOS)
        (ref-U|DALOS:module{UtilityDalosV2} U|DALOS)
        (ref-SCR:module{AcquisitionScoresV1} AQP-SCORE)
        (ref-TS02-C3:module{TalosStageTwo_ClientThreeV1} TS02-C3)
        (split-stoa:[decimal]
            (ref-DALOS::URC_SplitSTOAPrices KST.ANHD (ref-DALOS::UR_UsagePrice "smart"))
        )
    )
    (env-sigs
        [
            { "key": "PK_AncientHodler", "caps": [] }
            { "key": "6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263",
              "caps":
                [
                    (coin.TRANSFER "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263" "k:50d6c59b21e5e6e55baecaa75a1007de37576bde12d8230dc82459cc01b9484b" (at 2 split-stoa))
                    (coin.TRANSFER "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263" "k:0cb30c0121ff919266121a99ff9359871818932211df94dae4137c29bc0e8f7e" (at 0 split-stoa))
                    (coin.TRANSFER "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263" "c:XM-pkmuB5XUQlp87ZYSbfKt8qzmHY6O2EHAzMRVBt3k" (at 3 split-stoa))
                    (coin.TRANSFER "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263" "c:iQQFWj6gWtpGEzhM_O5ekW1QtnQQy55R8BRPGhj_0FU" (at 1 split-stoa))
                ]
            }
        ]
    )
    (print (format "<(TS02-C3.AQP-SCR|C_IssueSemiFungibleScore, named owner signing)> => \"{}\"" [(ref-TS02-C3::AQP-SCR|C_IssueSemiFungibleScore patron owner-konto score-name 3 true)]))
    (let
        (
            (score-id:string (ref-U|DALOS::UDC_Makeid score-name))
        )
        (map print
            [
                (expect "<<TX-SCORE-12b>> with the named owner signing, the identical issuance succeeds"
                    owner-konto (ref-SCR::UR_SCR|ScoreOwnerKonto score-id))
                (expect "<<TX-SCORE-12b>> ...and it is the class the attack asked for"
                    3 (ref-SCR::UR_SCR|ScoreClass score-id))
            ]
        )
    )
    ""
)
(print "")
(print (format "<(REPL|env-gas)> TX-SCORE-12b after rollback => \"{}\"" [(env-gas)]))
(env-sigs [])
(rollback-tx)
(print "")
(print "=== END TX-SCORE-12b =========================================================")
(print "")
