(begin-tx "TX-SCORE-11 - Score definition vectors (after boot scores)")
(print "")
(print "=== TX-SCORE-11 — Score definition vectors ===================================")
(namespace "ouronet-ns")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(env-sigs [{ "key": "PK_AncientHodler", "caps": [] }])
(let
    (
        (patron:string KST.ANHD)
        (ref-TS02-C3:module{TalosStageTwo_ClientThreeV1} TS02-C3)
        (wc-values:[decimal]
            (fold (+) []
                [(make-list 10 1.0) (make-list 10 2.0) (make-list 10 4.0) [15.0 28.0 52.0 114.0]]
            )
        )
    )
    ;;==== TX-SCORE-11 · 01 · score definitions ==============================================
    (print "--- [TX-SCORE-11 · 01 · score definitions] ---")
    (map print
        [
            (format "<(TS02-C3|C_IssueSFScoreDef TheCodingDivision nonces 1-10 val=1.0)> => \"{}\"" [(ref-TS02-C3::AQP-SCR|C_IssueSemiFungibleScoreDefinition patron "TheCodingDivision-98c486052a51" "DHCD-98c486052a51" (enumerate 1 10) (make-list 10 1.0))])
            (format "<(TS02-C3|C_IssueSFScoreDef TheCodingDivision nonce 11 val=10.0)> => \"{}\"" [(ref-TS02-C3::AQP-SCR|C_IssueSemiFungibleScoreDefinition patron "TheCodingDivision-98c486052a51" "DHCD-98c486052a51" [11] [10.0])])
            (format "<(TS02-C3|C_IssueSFScoreDef TheCodingDivision nonces 1-10 val=5.0)> => \"{}\"" [(ref-TS02-C3::AQP-SCR|C_IssueSemiFungibleScoreDefinition patron "TheCodingDivision-98c486052a51" "DHCD-98c486052a51" (enumerate 1 10) (make-list 10 5.0))])
            (format "<(TS02-C3|C_IssueSFScoreDef TheCodingDivision nonce 11 val=75.0)> => \"{}\"" [(ref-TS02-C3::AQP-SCR|C_IssueSemiFungibleScoreDefinition patron "TheCodingDivision-98c486052a51" "DHCD-98c486052a51" [11] [75.0])])
            (format "<(TS02-C3|C_IssueSFScoreDef WonderCoach nonces 1-34)> => \"{}\"" [(ref-TS02-C3::AQP-SCR|C_IssueSemiFungibleScoreDefinition patron "SubsidiaryWonderCoach-98c486052a51" "DHWC-98c486052a51" (enumerate 1 34) wc-values)])
            ;; L7 #19: a NEGATIVE score value in a definition must be rejected (mangles reward weighting).
            (expect-failure "<<TX-SCR L7#19>> negative SF nonce score value rejected at definition"
                "Nonce score value -5.0 must be non-negative and match score precision"
                (ref-TS02-C3::AQP-SCR|C_IssueSemiFungibleScoreDefinition patron "TheCodingDivision-98c486052a51" "DHCD-98c486052a51" [11] [-5.0]))
            ;;FULL> KBN Rarity vector — needs PopulateBunnies mint (nonce 1+ on chain)
            ;(format "<(TS02-C3|C_IssueNFScoreDef Bunnies KBN Rarity)> => \"{}\"" [(ref-TS02-C3::AQP-SCR|C_IssueNonFungibleScoreDefinition patron "SubsidiaryBunnies-98c486052a51" "KBN-98c486052a51" ["Rarity" "Rarity"] ["Legendary" "Common"] [2.0 160.0])])
        ]
    )
)
