;;
;; REPL/Stage_02/[6.4]_AQP-TRIPLET-DIAG.repl — OURO LP triplet: anchor promile × foreign boost-link
;; Run after AQP-BOOT Steps 2+6+7+8b (DHOuroLp + liquidity). Stakes rain bunnies then LP; prints all 3 scores.
;;
(print "")
(print "================================================================")
(print "FILE  REPL/Stage_02/[6.4]_AQP-TRIPLET-DIAG.repl")
(print "================================================================")
(print "")
;;
(begin-tx "TX-AQP-TD01 - Rain bunny anchors + LP stake → Silver/Bronze/Golden triples")
(print "")
(print "=== TX-AQP-TD01 — Ouroboros/Auryn/Elite-Auryn rain bunnies + DHOuroLp LP =====")
(namespace "ouronet-ns")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(let
    (
        (patron:string KST.ANHD)
        (owner:string KST.ANHD)
        (emma:string KST.EMMA)
        (kbn-id:string "KBN-98c486052a51")
        (ouro-rain-nonce:integer 30)
        (auryn-rain-nonce:integer 75)
        (elite-auryn-nonce:integer 175)
        (legendary-nonce:integer 25)
        (ref-U|DALOS:module{UtilityDalosV1} U|DALOS)
        (ref-DPDC:module{DpdcV1} DPDC)
        (ref-ANK:module{AcquisitionAnchorsV1} AQP-ANK)
        (ref-SWP:module{SwapperV3} SWP)
        (ref-DPTF:module{DemiourgosPactTrueFungibleV1} DPTF)
        (ref-TS02-C2:module{TalosStageTwo_ClientTwoV1} TS02-C2)
        (ref-TS02-C3:module{TalosStageTwo_ClientThreeV1} TS02-C3)
        (ref-SCR:module{AcquisitionScoresV1} AQP-SCORE)
        (ref-AQP:module{AcquisitionPoolsV1} AQP-POOL)
        (pool-id:string (ref-U|DALOS::UDC_Makeid "DHOuroLp"))
        (bunnies-pool:string (ref-U|DALOS::UDC_Makeid "DHBunnies"))
        (silver-id:string (ref-U|DALOS::UDC_Makeid "SilverSnakePower"))
        (bronze-id:string (ref-U|DALOS::UDC_Makeid "BronzeSnakePower"))
        (golden-id:string (ref-U|DALOS::UDC_Makeid "GoldenSnakePower"))
        (silver-bc:string silver-id)
        (bronze-bc:string bronze-id)
        (golden-bc:string golden-id)
        (swpair:string "W|DLK-98c486052a51|OURO-98c486052a51|DWK-98c486052a51")
        (lp-id:string (ref-SWP::UR_TokenLP swpair))
        (lp-bal:decimal (ref-DPTF::UR_AccountSupply lp-id owner))
        (pool-class:integer (try -1 (ref-AQP::UR_AQP|PoolAqpClass pool-id)))
    )
    (env-sigs
        [
            { "key": "PK_AncientHodler", "caps": [] }
            { "key": "PK_Emma", "caps": [] }
            { "key": "PK_Lumy", "caps": [] }
        ]
    )
  (if (and (>= pool-class 0) (> lp-bal 0.0))
      (let
          (
              (stake-amt:decimal (if (> lp-bal 100.0) 100.0 lp-bal))
              (rain-nonces:[integer] [ouro-rain-nonce auryn-rain-nonce elite-auryn-nonce])
              (emma-kbn:[integer] (ref-DPDC::URD_AccountNonces emma kbn-id false))
              (anhd-kbn:[integer] (ref-DPDC::URD_AccountNonces owner kbn-id false))
          )
          (map
              (lambda (n:integer)
                  (if (not (contains n anhd-kbn))
                      (if (contains n emma-kbn)
                          (print (format "<(transfer KBN nonce {} EMMA→ANHD)> => \"{}\"" [n
                              (ref-TS02-C2::DPNF|C_TransferNonce patron kbn-id emma owner n 1 false)
                          ]))
                          (print (format "NOTE: KBN nonce {} not on EMMA (may already be staked)" [n]))
                      )
                      true
                  )
              )
              rain-nonces
          )
          (let
              (
                  (anhd-unstaked:[integer] (ref-DPDC::URD_AccountNonces owner kbn-id false))
              )
              (map
                  (lambda (n:integer)
                      (if (contains n anhd-unstaked)
                          (print (format "<(C_StakeNonFungible DHBunnies nonce {})> => \"{}\"" [n
                              (ref-TS02-C3::AQP-POOL|CC_StakeNonFungibleCollectable
                                  patron bunnies-pool owner owner kbn-id [n]
                              )
                          ]))
                          (print (format "NOTE: KBN nonce {} already staked or unavailable" [n]))
                      )
                  )
                  rain-nonces
              )
          )
          (map print
              [
                  (format "<(AggregatePromile Bronze BC)> => \"{}\"" [(ref-ANK::UR_UB|AggregatePromile owner bronze-bc)])
                  (format "<(AggregatePromile Silver BC)> => \"{}\"" [(ref-ANK::UR_UB|AggregatePromile owner silver-bc)])
                  (format "<(AggregatePromile Golden BC)> => \"{}\"" [(ref-ANK::UR_UB|AggregatePromile owner golden-bc)])
                  (format "<(AurynRain per-anchor promile)> => \"{}\"" [(ref-ANK::UR_ANK-U|Promile owner (ref-U|DALOS::UDC_Makeid "AurynRain"))])
                  (format "<(OuroborosRain per-anchor promile)> => \"{}\"" [(ref-ANK::UR_ANK-U|Promile owner (ref-U|DALOS::UDC_Makeid "OuroborosRain"))])
                  (format "<(EliteAurynRain per-anchor promile)> => \"{}\"" [(ref-ANK::UR_ANK-U|Promile owner (ref-U|DALOS::UDC_Makeid "EliteAurynRain"))])
              ]
          )
          (print (format "<(CC_StakeTrueFungible DHOuroLp LP {})> => \"{}\"" [stake-amt
              (ref-TS02-C3::AQP-POOL|CC_StakeTrueFungible patron pool-id owner owner lp-id stake-amt)
          ]))
          (map print
              [
                  (format "<(Silver base/boost/deb)> => \"{} / {} / {}\"" [
                      (ref-SCR::UR_U-SCR|UserScoreBaseScore owner pool-id silver-id)
                      (ref-SCR::UR_U-SCR|UserScoreBoostedScore owner pool-id silver-id)
                      (ref-SCR::UR_U-SCR|UserScoreDebScore owner pool-id silver-id)
                  ])
                  (format "<(Bronze base/boost/deb)> => \"{} / {} / {}\" (boost-link to Silver, surplus-only)" [
                      (ref-SCR::UR_U-SCR|UserScoreBaseScore owner pool-id bronze-id)
                      (ref-SCR::UR_U-SCR|UserScoreBoostedScore owner pool-id bronze-id)
                      (ref-SCR::UR_U-SCR|UserScoreDebScore owner pool-id bronze-id)
                  ])
                  (format "<(Golden base/boost/deb)> => \"{} / {} / {}\" (boost-link to Silver, surplus-only)" [
                      (ref-SCR::UR_U-SCR|UserScoreBaseScore owner pool-id golden-id)
                      (ref-SCR::UR_U-SCR|UserScoreBoostedScore owner pool-id golden-id)
                      (ref-SCR::UR_U-SCR|UserScoreDebScore owner pool-id golden-id)
                  ])
                  (expect (format "<<TX-AQP-TD01>> Silver base>0 got={}" [(ref-SCR::UR_U-SCR|UserScoreBaseScore owner pool-id silver-id)])
                      true (> (ref-SCR::UR_U-SCR|UserScoreBaseScore owner pool-id silver-id) 0.0))
                  (expect (format "<<TX-AQP-TD01>> Silver deb>0 got={}" [(ref-SCR::UR_U-SCR|UserScoreDebScore owner pool-id silver-id)])
                      true (> (ref-SCR::UR_U-SCR|UserScoreDebScore owner pool-id silver-id) 0.0))
              ]
          )
          (let
              (
                  (b-boost:decimal (ref-SCR::UR_U-SCR|UserScoreBoostedScore owner pool-id bronze-id))
                  (g-boost:decimal (ref-SCR::UR_U-SCR|UserScoreBoostedScore owner pool-id golden-id))
              )
              (if (> b-boost 0.0)
                  (print (format "OK Bronze surplus boosted>0 got={}" [b-boost]))
                  (print "NOTE: Bronze boosted=0 — foreign surplus needs aggregate promile >500‰ on first LP leg (boot OuroborosRain=50‰ each)")
              )
              (if (> g-boost 0.0)
                  (print (format "OK Golden surplus boosted>0 got={}" [g-boost]))
                  (print "NOTE: Golden boosted=0 — foreign surplus needs aggregate promile >500‰ on first LP leg (boot EliteAurynRain=200‰ each)")
              )
          )
      )
      (print (format "SKIP TX-AQP-TD01: DHOuroLp not ready (lp-bal={} pool-class={})" [lp-bal pool-class]))
  )
)
(env-sigs [])
(commit-tx)
(print "")
(print "=== END [6.4]_AQP-TRIPLET-DIAG.repl =========================================")
