;;
;; REPL/Stage_02/[6.4]_AQP-TRIPLET-DIAG.repl — OURO LP triplet: anchor promile × foreign boost-link
;; Run after AQP-BOOT Steps 2+6+7+8b (DHOuroLp + liquidity). Stakes rain bunnies then LP; prints all 3 scores.
;;
(print "")
(print "================================================================")
(print "FILE  REPL/Stage_02/[6.4]_AQP-TRIPLET-DIAG.repl")
(print "================================================================")
(print "")
;;
(begin-tx "TX-AQP-TD01 - Rain bunny anchors + LP stake → Silver/Bronze/Golden triples")
(print "")
(print "=== TX-AQP-TD01 — Ouroboros/Auryn/Elite-Auryn rain bunnies + DHOuroLp LP =====")
(namespace "ouronet-ns")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
;;==== TX-AQP-TD01 - Rain bunny anchors + LP stake → Silver/Bronze/Golden triples · 01 · let / invocation ==== 
(print "--- [TX-AQP-TD01 - Rain bunny anchors + LP stake → Silver/Bronze/Golden triples · 01 · let / invocation] ---")
(let
    (
        (patron:string KST.ANHD)
        (owner:string KST.ANHD)
        (emma:string KST.EMMA)
        (kbn-id:string "KBN-98c486052a51")
        (ouro-rain-nonce:integer 30)
        (auryn-rain-nonce:integer 75)
        (elite-auryn-nonce:integer 175)
        (legendary-nonce:integer 25)
        (ref-U|DALOS:module{UtilityDalosV2} U|DALOS)
        (ref-DPDC:module{DpdcV2} DPDC)
        (ref-ANK:module{AcquisitionAnchorsV1} AQP-ANK)
        (ref-SWP:module{SwapperV4} SWP)
        (ref-DPTF:module{DemiourgosPactTrueFungibleV2} DPTF)
        (ref-TS02-C2:module{TalosStageTwo_ClientTwoV2} TS02-C2)
        (ref-TS02-C3:module{TalosStageTwo_ClientThreeV2} TS02-C3)
        (ref-SCR:module{AcquisitionScoresV2} AQP-SCORE)
        (ref-AQP:module{AcquisitionPoolsV1} AQP-POOL)
        (pool-id:string (ref-U|DALOS::UDC_Makeid "DHOuroLp"))
        (bunnies-pool:string (ref-U|DALOS::UDC_Makeid "DHBunnies"))
        (silver-id:string (ref-U|DALOS::UDC_Makeid "SilverSnakePower"))
        (bronze-id:string (ref-U|DALOS::UDC_Makeid "BronzeSnakePower"))
        (golden-id:string (ref-U|DALOS::UDC_Makeid "GoldenSnakePower"))
        (silver-bc:string silver-id)
        (bronze-bc:string bronze-id)
        (golden-bc:string golden-id)
        (swpair:string "W|DLK-98c486052a51|OURO-98c486052a51|DWK-98c486052a51")
        (lp-id:string (ref-SWP::UR_TokenLP swpair))
        (lp-bal:decimal (ref-DPTF::UR_AccountSupply lp-id owner))
        (pool-class:integer (try -1 (ref-AQP::UR_AQP|PoolAqpClass pool-id)))
    )
    (env-sigs
        [
            { "key": "PK_AncientHodler", "caps": [] }
            { "key": "PK_Emma", "caps": [] }
            { "key": "PK_Lumy", "caps": [] }
        ]
    )
  (if (and (>= pool-class 0) (> lp-bal 0.0))
      (let
          (
              (stake-amt:decimal (if (> lp-bal 100.0) 100.0 lp-bal))
              (rain-nonces:[integer] [ouro-rain-nonce auryn-rain-nonce elite-auryn-nonce])
              (emma-kbn:[integer] (ref-DPDC::URH_AccountNonces emma kbn-id false))
              (anhd-kbn:[integer] (ref-DPDC::URH_AccountNonces owner kbn-id false))
          )
          (map
              (lambda (n:integer)
                  (if (not (contains n anhd-kbn))
                      (if (contains n emma-kbn)
                          (print (format "<(transfer KBN nonce {} EMMA→ANHD)> => \"{}\"" [n
                              (ref-TS02-C2::DPNF|C_TransferNonce patron emma owner kbn-id n 1 false)
                          ]))
                          (print (format "NOTE: KBN nonce {} not on EMMA (may already be staked)" [n]))
                      )
                      true
                  )
              )
              rain-nonces
          )
          (let
              (
                  (anhd-unstaked:[integer] (ref-DPDC::URH_AccountNonces owner kbn-id false))
              )
              (map
                  (lambda (n:integer)
                      (if (contains n anhd-unstaked)
                          (print (format "<(C_StakeNonFungible DHBunnies nonce {})> => \"{}\"" [n
                              (ref-TS02-C3::AQP-POOL|CC_StakeNonFungibleCollectable
                                  patron owner owner bunnies-pool kbn-id [n]
                              )
                          ]))
                          (print (format "NOTE: KBN nonce {} already staked or unavailable" [n]))
                      )
                  )
                  rain-nonces
              )
          )
          (map print
              [
                  (format "<(AggregatePromile Bronze BC)> => \"{}\"" [(ref-ANK::UR_UB|AggregatePromile owner bronze-bc)])
                  (format "<(AggregatePromile Silver BC)> => \"{}\"" [(ref-ANK::UR_UB|AggregatePromile owner silver-bc)])
                  (format "<(AggregatePromile Golden BC)> => \"{}\"" [(ref-ANK::UR_UB|AggregatePromile owner golden-bc)])
                  (format "<(AurynRain per-anchor promile)> => \"{}\"" [(ref-ANK::UR_ANK-U|Promile owner (ref-U|DALOS::UDC_Makeid "AurynRain"))])
                  (format "<(OuroborosRain per-anchor promile)> => \"{}\"" [(ref-ANK::UR_ANK-U|Promile owner (ref-U|DALOS::UDC_Makeid "OuroborosRain"))])
                  (format "<(EliteAurynRain per-anchor promile)> => \"{}\"" [(ref-ANK::UR_ANK-U|Promile owner (ref-U|DALOS::UDC_Makeid "EliteAurynRain"))])
              ]
          )
          (print (format "<(CC_StakeTrueFungible DHOuroLp LP {})> => \"{}\"" [stake-amt
              (ref-TS02-C3::AQP-POOL|CC_StakeTrueFungible patron owner owner pool-id lp-id stake-amt)
          ]))
          (map print
              [
                  (format "<(Silver base/boost/deb)> => \"{} / {} / {}\"" [
                      (ref-SCR::UR_U-SCR|UserScoreBaseScore owner pool-id silver-id)
                      (ref-SCR::UR_U-SCR|UserScoreBoostedScore owner pool-id silver-id)
                      (ref-SCR::UR_U-SCR|UserScoreDebScore owner pool-id silver-id)
                  ])
                  (format "<(Bronze base/boost/deb)> => \"{} / {} / {}\" (boost-link to Silver, additive satellite)" [
                      (ref-SCR::UR_U-SCR|UserScoreBaseScore owner pool-id bronze-id)
                      (ref-SCR::UR_U-SCR|UserScoreBoostedScore owner pool-id bronze-id)
                      (ref-SCR::UR_U-SCR|UserScoreDebScore owner pool-id bronze-id)
                  ])
                  (format "<(Golden base/boost/deb)> => \"{} / {} / {}\" (boost-link to Silver, additive satellite)" [
                      (ref-SCR::UR_U-SCR|UserScoreBaseScore owner pool-id golden-id)
                      (ref-SCR::UR_U-SCR|UserScoreBoostedScore owner pool-id golden-id)
                      (ref-SCR::UR_U-SCR|UserScoreDebScore owner pool-id golden-id)
                  ])
                  (expect (format "<<TX-AQP-TD01>> Silver base>0 got={}" [(ref-SCR::UR_U-SCR|UserScoreBaseScore owner pool-id silver-id)])
                      true (> (ref-SCR::UR_U-SCR|UserScoreBaseScore owner pool-id silver-id) 0.0))
                  (expect (format "<<TX-AQP-TD01>> Silver deb>0 got={}" [(ref-SCR::UR_U-SCR|UserScoreDebScore owner pool-id silver-id)])
                      true (> (ref-SCR::UR_U-SCR|UserScoreDebScore owner pool-id silver-id) 0.0))
              ]
          )
          ;;==== TX-AQP-TD01 · 02 · ADDITIVE-SATELLITE REGRESSION (D1) ====
          (print "--- [TX-AQP-TD01 · 02 · additive-satellite regression] ---")
          ;;WHY THIS BLOCK EXISTS, 2026-10-09. What stood here was two `if`s that PRINTED either
          ;;"OK Bronze surplus boosted>0" or a NOTE claiming a satellite needs "aggregate promile
          ;;>500 permille" to register anything. The NOTE was not a caveat, it was the defect: the
          ;;pre-M3 "store only the surplus over the foreign base" rule subtracted the hub's WHOLE
          ;;base from a boost part that was ALREADY the increment, so the stored value clamped to 0
          ;;unless prom x deb > 1000 permille. Every satellite on mainnet read 0, and the matrix
          ;;recorded SCR-50 as PASS because the only thing it asserted was base = 0.
          ;;
          ;;So the lesson is not "assert more", it is that a conditional assertion is indistinguish-
          ;;able from an absent one. The fixture PRECONDITION is therefore asserted FIRST: if the
          ;;boot stops granting these boost classes a promile, THAT fails, loudly, instead of
          ;;silently excusing a zero. Owner ruling 2026-10-08: a satellite's boost is
          ;;hub-base x its OWN promile, deb-multiplied, with no subtraction.
          (let
              (
                  (b-boost:decimal (ref-SCR::UR_U-SCR|UserScoreBoostedScore owner pool-id bronze-id))
                  (g-boost:decimal (ref-SCR::UR_U-SCR|UserScoreBoostedScore owner pool-id golden-id))
                  (b-prom:decimal (ref-ANK::UR_UB|AggregatePromile owner bronze-bc))
                  (g-prom:decimal (ref-ANK::UR_UB|AggregatePromile owner golden-bc))
                  (hub-base:decimal (ref-SCR::UR_U-SCR|UserScoreBaseScore owner pool-id silver-id))
              )
              (map print
                  [
                      ;;PRECONDITION, asserted so it cannot become an excuse.
                      (expect (format "<<TX-AQP-TD-D1a>> fixture grants Bronze BC a promile got={}" [b-prom])
                          true (> b-prom 0.0))
                      (expect (format "<<TX-AQP-TD-D1b>> fixture grants Golden BC a promile got={}" [g-prom])
                          true (> g-prom 0.0))
                      (expect (format "<<TX-AQP-TD-D1c>> hub (Silver) carries the LP base got={}" [hub-base])
                          true (> hub-base 0.0))
                      ;;THE REGRESSION, IN TWO STRENGTHS. The `> 0` pair is what the old surplus
                      ;;subtraction failed: it clamped every satellite to 0 for any sane promile.
                      (expect (format "<<TX-AQP-TD-D1d>> Bronze additive satellite earns at all hub={} prom={} got={}" [hub-base b-prom b-boost])
                          true (> b-boost 0.0))
                      (expect (format "<<TX-AQP-TD-D1e>> Golden additive satellite earns at all hub={} prom={} got={}" [hub-base g-prom g-boost])
                          true (> g-boost 0.0))
                      ;;AND THE EXACT VALUES, which `> 0` cannot speak to -- that is how a MAGNITUDE
                      ;;error hides behind a presence check. It did: with the surplus subtraction gone
                      ;;but the ordering defect still in place, these two read 25 and 300 against a hub
                      ;;base of 400, because `base-for-boost` was hub-base + the satellite's OWN stake
                      ;;delta (500) rather than the hub base. Both passed `> 0` and both were wrong.
                      ;;Expected is computed from the live hub base and promile, not written as a
                      ;;literal, so the fixture can grow without the assertion going vacuous.
                      (expect (format "<<TX-AQP-TD-D1h>> Bronze boost == floor(HUB base x prom/1000) exactly hub={} prom={}" [hub-base b-prom])
                          (floor (* hub-base (/ b-prom 1000.0)) (ref-SCR::UR_SCR|ScorePrecision bronze-id))
                          b-boost)
                      (expect (format "<<TX-AQP-TD-D1i>> Golden boost == floor(HUB base x prom/1000) exactly hub={} prom={}" [hub-base g-prom])
                          (floor (* hub-base (/ g-prom 1000.0)) (ref-SCR::UR_SCR|ScorePrecision golden-id))
                          g-boost)
                      ;;A satellite still owns NO base -- that half of SCR-50 was always right.
                      (expect (format "<<TX-AQP-TD-D1f>> Bronze satellite holds no base got={}" [(ref-SCR::UR_U-SCR|UserScoreBaseScore owner pool-id bronze-id)])
                          0.0 (ref-SCR::UR_U-SCR|UserScoreBaseScore owner pool-id bronze-id))
                      (expect (format "<<TX-AQP-TD-D1g>> Golden satellite holds no base got={}" [(ref-SCR::UR_U-SCR|UserScoreBaseScore owner pool-id golden-id)])
                          0.0 (ref-SCR::UR_U-SCR|UserScoreBaseScore owner pool-id golden-id))
                  ]
              )
              ""
          )
      )
      (print (format "SKIP TX-AQP-TD01: DHOuroLp not ready (lp-bal={} pool-class={})" [lp-bal pool-class]))
  )
)
(env-sigs [])
(commit-tx)
(print "")
(print "=== END [6.4]_AQP-TRIPLET-DIAG.repl =========================================")
