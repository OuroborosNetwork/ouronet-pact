;;
;; REPL/Stage_02/[6.1.6]_DPOF.repl — DPOF tail-op coverage (#79 Phase 2)
;;   Reuses the COF DPOF from [6.1.5] (owner holds nonce 1, 1000 units). Deploys 3 accounts,
;;   transmits units to each, then exercises the uncovered DPOF ops: DPOF|A_DeployAccount,
;;   DPOF|C_Transmit, WipeSlim/WipeClean/WipeHeavy/WipePure, UpgradeBranding.
;;
(print "")
(print "================================================================")
(print "FILE  REPL/Stage_02/[6.1.6]_DPOF.repl  (DPOF tail ops)")
(print "================================================================")
(print "")

;;================================================================================
(begin-tx "TX-OF-001 - DPOF tail: deploy / transmit / wipes / branding on COF")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(namespace "ouronet-ns")
;;==== TX-OF-001 · 01 · env-sigs (STOA fee caps for UpgradeBranding) ====
(print "--- [TX-OF-001 · 01 · env-sigs] ---")
;;==== TX-OF-001 - DPOF tail: deploy / transmit / wipes / branding on COF · 01 · env-sigs (caps) ==== 
(print "--- [TX-OF-001 - DPOF tail: deploy / transmit / wipes / branding on COF · 01 · env-sigs (caps)] ---")
(env-sigs
    [
        { "key": "PK_AncientHodler", "caps": [] }
        { "key": "6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263",
          "caps":
            [
                (coin.TRANSFER "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263"
                    "k:50d6c59b21e5e6e55baecaa75a1007de37576bde12d8230dc82459cc01b9484b" 1000.0)
                (coin.TRANSFER "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263"
                    "k:0cb30c0121ff919266121a99ff9359871818932211df94dae4137c29bc0e8f7e" 1000.0)
                (coin.TRANSFER "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263"
                    "c:XM-pkmuB5XUQlp87ZYSbfKt8qzmHY6O2EHAzMRVBt3k" 1000.0)
                (coin.TRANSFER "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263"
                    "c:iQQFWj6gWtpGEzhM_O5ekW1QtnQQy55R8BRPGhj_0FU" 1000.0)
            ]
        }
    ]
)
;;==== TX-OF-001 · 02 · deploy / transmit / wipe / branding ====
(print "--- [TX-OF-001 · 02 · deploy / transmit / wipe / branding] ---")
;;==== TX-OF-001 - DPOF tail: deploy / transmit / wipes / branding on COF · 02 · let / invocation ==== 
(print "--- [TX-OF-001 - DPOF tail: deploy / transmit / wipes / branding on COF · 02 · let / invocation] ---")
(let
    (
        (ref-DPOF:module{DemiourgosPactOrtoFungibleV2} DPOF)
        (ref-TS01-A:module{TalosStageOne_AdminV2} TS01-A)
        (ref-TS01-C1:module{TalosStageOne_ClientOneV2} TS01-C1)
        (id:string "COF-98c486052a51")
        (patron:string KST.ANHD)
        (emma:string KST.EMMA)
        (lumy:string KST.LUMY)
        (orbr:string KST.OURBR)
    )
    ;; DPOF|A_DeployAccount: deploy 2 standard collection accounts (wipe needs a freezable acct)
    (ref-TS01-A::DPOF|A_DeployAccount patron id emma)
    (ref-TS01-A::DPOF|A_DeployAccount patron id lumy)
    ;; enable segmentation (Control's last flag `sg`) — Transmit requires it ON
    (ref-TS01-C1::DPOF|C_Control patron id true true true true true true true true)
    ;; DPOF|C_Transmit: move 300 units of nonce 1 to EMMA and LUMY (owner keeps 400)
    (ref-TS01-C1::DPOF|C_Transmit patron id [1] [300.0] patron emma false)
    (ref-TS01-C1::DPOF|C_Transmit patron id [1] [300.0] patron lumy false)
    ;; DPOF is single-holder-per-nonce: Transmit gave EMMA a NEW (segmented) nonce — read it.
    ;; EMMA: freeze -> WipeSlim (partial) -> WipeClean (empties its nonce list)
    (let ((en:integer (at 0 (ref-DPOF::URH_AccountNonces emma id))))
        (ref-TS01-C1::DPOF|C_ToggleFreezeAccount patron id emma true)
        (ref-TS01-C1::DPOF|C_WipeSlim patron id emma en 100.0)
        (ref-TS01-C1::DPOF|C_WipeClean patron id emma [en])
    )
    ;; LUMY: freeze -> WipeHeavy (empties whole account, no nonce number needed)
    (ref-TS01-C1::DPOF|C_ToggleFreezeAccount patron id lumy true)
    (ref-TS01-C1::DPOF|CC_WipeHeavy patron id lumy)
    ;; re-fund EMMA (unfreeze, transmit, refreeze) -> WipePure via the computed removable obj
    (ref-TS01-C1::DPOF|C_ToggleFreezeAccount patron id emma false)
    (ref-TS01-C1::DPOF|C_Transmit patron id [1] [300.0] patron emma false)
    (ref-TS01-C1::DPOF|C_ToggleFreezeAccount patron id emma true)
    (ref-TS01-C1::DPOF|C_WipePure patron id emma (ref-DPOF::URHC_WipePure emma id))
    ;; premium branding upgrade (STOA fee)
    ;;ORDER-DEPENDENCE FIX (G3), second site. BRD permits an upgrade only when under 15 days of
    ;;premium remain (04_BRD.pact:258). Whether that holds depends on how much chain time the
    ;;enclosing run has consumed, so an unconditional call aborts this file in any chain where the
    ;;flag is still fresh -- which is what the eight EXCLUDED Kursan harnesses hit.
    ;;
    ;;_gate.py's note attributes G3 to [6.1.4]_DPDC-NF.repl:333 alone. That site is real and fixed
    ;;the same way, but it is NOT the only one: with it conditional, the harnesses then failed HERE.
    ;;Same guard, same cause, two call sites.
    (let
        (
            (remaining:decimal
                (diff-time (BRD.UR_PremiumUntil id false) (at "block-time" (chain-data))))
        )
        (if (< remaining 1296000.0)
            (ref-TS01-C1::DPOF|C_UpgradeBranding patron id 1)
            (print (format "<<TX-OF-001>> UpgradeBranding SKIPPED — {} s premium remain (BRD allows under 1296000 s)"
                [remaining]))
        )
    )
    (print "<<TX-OF-001>> DPOF DeployAccount/Transmit/WipeSlim/Clean/Heavy/Pure/UpgradeBranding OK")
)
(print "===^^^===")
(commit-tx)
;;||>>>>>>>>>>>>>>>>>>>>>>>>>
;;|| NEXT                   >
;;||>>>>>>>>>>>>>>>>>>>>>>>>>
(print "")

;;================================================================================
(begin-tx "TX-OF-002 - DPOF Hydra wipe: seed math / plan build / 3 slices / replay reverts")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(namespace "ouronet-ns")
;;==== TX-OF-002 · 01 · env-sigs (caps) ====
(print "--- [TX-OF-002 · 01 · env-sigs] ---")
;;==== TX-OF-002 - DPOF Hydra wipe: seed math / plan build / 3 slices / replay reverts · 01 · env-sigs (caps) ==== 
(print "--- [TX-OF-002 - DPOF Hydra wipe: seed math / plan build / 3 slices / replay reverts · 01 · env-sigs (caps)] ---")
(env-sigs [ { "key": "PK_AncientHodler", "caps": [] } ])
;;==== TX-OF-002 · 02 · fund EMMA 6 nonces / freeze / plan asserts ====
(print "--- [TX-OF-002 · 02 · fund EMMA 6 nonces / freeze / plan asserts] ---")
;;==== TX-OF-002 - DPOF Hydra wipe: seed math / plan build / 3 slices / replay reverts · 02 · let / invocation ==== 
(print "--- [TX-OF-002 - DPOF Hydra wipe: seed math / plan build / 3 slices / replay reverts · 02 · let / invocation] ---")
(let
    (
        (ref-DPOF:module{DemiourgosPactOrtoFungibleV2} DPOF)
        (ref-TS01-C1:module{TalosStageOne_ClientOneV2} TS01-C1)
        (id:string "COF-98c486052a51")
        (patron:string KST.ANHD)
        (emma:string KST.EMMA)
    )
    ;; re-fund EMMA with SIX segmented nonces (6 transmits of 15.0 — owner's nonce 1 holds
    ;; only 100 units after TX-OF-001), then freeze for the wipe
    (ref-TS01-C1::DPOF|C_ToggleFreezeAccount patron id emma false)
    (map
        (lambda (i:integer) (ref-TS01-C1::DPOF|C_Transmit patron id [1] [15.0] patron emma false))
        (enumerate 1 6)
    )
    (ref-TS01-C1::DPOF|C_ToggleFreezeAccount patron id emma true)
    (let*
        (
            (full:object{DpofUdcV2.RemovableNonces} (ref-DPOF::URHC_WipePure emma id))
            (plan:object{DpofUdcV2.DPOF|WipeSlicePlan} (ref-DPOF::URHC_BuildWipeSlicePlan emma id 3))
            (slices:[object{DpofUdcV2.RemovableNonces}] (at "slices" plan))
            (s0:object{DpofUdcV2.RemovableNonces} (at 0 slices))
            (s1:object{DpofUdcV2.RemovableNonces} (at 1 slices))
            (s2:object{DpofUdcV2.RemovableNonces} (at 2 slices))
        )
        (map print
            [
                (expect "<<TX-OF-002>> seed: 6 nonces fit 1 slice" 1 (ref-DPOF::UC_ComputeMinWipeSliceCount 6))
                (expect "<<TX-OF-002>> seed: 1001 nonces need 2 slices (ceiling 1000, calibrated)" 2 (ref-DPOF::UC_ComputeMinWipeSliceCount 1001))
                (expect "<<TX-OF-002>> seed: 2001 nonces need 3 slices (ceiling 1000, calibrated)" 3 (ref-DPOF::UC_ComputeMinWipeSliceCount 2001))
                (expect "<<TX-OF-002>> plan: 3 slices over 6 nonces" 3 (at "slice-count" plan))
                (expect "<<TX-OF-002>> plan: slice widths 2/2/2" [2 2 2] (map (lambda (s:object{DpofUdcV2.RemovableNonces}) (length (at "r-nonces" s))) slices))
                (expect "<<TX-OF-002>> plan: disjoint slices cover the full set exactly"
                    (at "r-nonces" full)
                    (fold (lambda (acc:[integer] ns:[integer]) (+ acc ns)) []
                        (map (lambda (s:object{DpofUdcV2.RemovableNonces}) (at "r-nonces" s)) slices)))
                (expect "<<TX-OF-002>> plan: over-asking 100 slices clamps to 6 x 1-nonce slices" 6
                    (at "slice-count" (ref-DPOF::URHC_BuildWipeSlicePlan emma id 100)))
                ""
            ]
        )
        ;;==== TX-OF-002 · 03 · fire 3 slices (parallel in production) + replay negative ====
        (print "--- [TX-OF-002 · 03 · fire 3 slices + replay negative] ---")
        (ref-TS01-C1::DPOF|Cp_WipeSlice patron id emma s0)
        (map print
            [
                (expect "<<TX-OF-002>> after slice 0: 4 nonces remain" 4 (length (at "r-nonces" (ref-DPOF::URHC_WipePure emma id))))
                ""
            ]
        )
        (ref-TS01-C1::DPOF|Cp_WipeSlice patron id emma s1)
        (ref-TS01-C1::DPOF|Cp_WipeSlice patron id emma s2)
        (map print
            [
                (expect-failure "<<TX-OF-002>> replayed slice 0 REVERTS (live table is the completion ledger)"
                "Nonce 10 of DPOF COF-98c486052a51 is not owned by account"
                    (ref-TS01-C1::DPOF|Cp_WipeSlice patron id emma s0))
                (expect "<<TX-OF-002>> terminal: EMMA fully wiped (remains empty)" 0 (length (at "r-nonces" (ref-DPOF::URHC_WipePure emma id))))
                (expect "<<TX-OF-002>> terminal: EMMA account supply zeroed" 0.0 (ref-DPOF::UR_AccountSupply id emma))
                ""
            ]
        )
    )
)
(print "===^^^===")
(commit-tx)

;;||>>>>>>>>>>>>>>>>>>>>>>>>>
;;|| NEXT                   >
;;||>>>>>>>>>>>>>>>>>>>>>>>>>
;;
(begin-tx "TX-OF-003 - DPOF|C>DEBIT: the ownership gate behind partial transmit")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(namespace "ouronet-ns")
;;==== TX-OF-003 · 01 · the shadow, and the gate behind it ====
(print "--- [TX-OF-003 · 01 · the shadow, and the gate behind it] ---")
;;`DPOF|C>DEBIT` carries `CAP_EnforceAccountOwnership <sender>` and, until this block, had never
;;refused anybody anywhere in the tree. Delete that line and nothing turns red. It is reached only
;;THROUGH `DPOF|C>TRANSMIT` -- which has no ownership check of its own -- so a one-hop Talos->function
;;scan could not see it at all; it became visible only once `REPL/tools/_ownerobs.py` followed
;;`compose-capability` edges as well as call edges.
;;
;;WHY THIS SUITE AND NOT modules/DPOF.repl: `C_Transmit` needs `segmentation` ON, and the Stage-1
;;MOCKO fixture ships with it OFF -- so the attack there dies at `UEV_SegmentationState`, which would
;;have made a green test that proves nothing about ownership. COF already has segmentation enabled by
;;TX-OF-001, so the fixture is the real one rather than one manufactured for the attack.
;;
;;THE ATTACKER IS LUMY AND THE VICTIM IS ANHD. ANHD is both an ordinary account key and a Demiurgoi
;;master, which is only a problem when ANHD is the ATTACKER (a success could then mean "admitted
;;because they own the token"). As the VICTIM the ambiguity does not arise: LUMY demonstrably is not
;;ANHD, and the refusal names ANHD's key.
(env-sigs [{ "key": "PK_Lumy", "caps": [] }])
(let
    (
        (ref-DPOF:module{DemiourgosPactOrtoFungibleV2} DPOF)
        (ref-TS01-C1:module{TalosStageOne_ClientOneV2} TS01-C1)
        (id:string "COF-98c486052a51")
        (attacker:string KST.LUMY)
        (victim:string KST.ANHD)
    )
    (let
        (
            (supply-before:decimal (ref-DPOF::UR_NonceSupply id 1))
        )
        (map print
            [
                ;;NON-VACUITY of the fixture: there is something to steal, and the attacker is not the victim.
                (expect "<<TX-OF-003>> the victim holds nonce 1, so there is something to take"
                    true (> supply-before 0.0))
                (expect "<<TX-OF-003>> ...and the attacker is not the victim"
                    false (= attacker victim))
                ;;THE SHADOW, DEMONSTRATED. `DPOF|C>DEBIT` runs a length check, a uniqueness check and
                ;;an amount-vs-supply fold BEFORE it ever asks who the sender is. An over-supply amount
                ;;is therefore refused by the FOLD, and a test written that way would pass identically
                ;;with the ownership check deleted. This assertion exists to prove the shadow is real,
                ;;so that the next one can be shown to have escaped it.
                (expect-failure "<<TX-OF-003>> SHADOW: an over-supply amount is refused by the amount fold, NOT by ownership"
                    "Cannot Debit into the Negatives for Orto-Fungible COF-98c486052a51 Nonce 1 on Account"
                    (ref-TS01-C1::DPOF|C_Transmit attacker id [1] [999999.0] victim attacker false))
                ;;THE GATE. Same call, same signer, only the amount changed to one the fold accepts.
                ;;The message changes to name the VICTIM's key -- so the refusal is attributable to
                ;;`CAP_EnforceAccountOwnership sender` and to nothing upstream of it.
                (expect-failure "<<TX-OF-003>> GATE: a valid amount reaches ownership, which refuses and names the victim"
                    "Keyset failure (keys-all): [PK_Ancie...]"
                    (ref-TS01-C1::DPOF|C_Transmit attacker id [1] [10.0] victim attacker false))
                ;;...and the refusal was TOTAL.
                (expect "<<TX-OF-003>> ...and no supply moved"
                    supply-before (ref-DPOF::UR_NonceSupply id 1))
            ]
        )
    )
    ""
)
(env-sigs [])
(rollback-tx)
;;||>>>>>>>>>>>>>>>>>>>>>>>>>
;;|| NEXT                   >
;;||>>>>>>>>>>>>>>>>>>>>>>>>>
;;
(begin-tx "TX-OF-003b - the identical debit, with the holder signing, must WORK")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(namespace "ouronet-ns")
;;==== TX-OF-003b · 01 · non-vacuity ====
(print "--- [TX-OF-003b · 01 · non-vacuity] ---")
;;An `expect-failure` proves a call was refused, never that the operation works when it should. LUMY
;;is left FROZEN for COF by TX-OF-002's wipe tests, so the receiver leg would refuse this transfer
;;whoever signed it -- the unfreeze below is what makes the success attributable to the signature and
;;not to the fixture. (That freeze is also why the GATE assertion above is sound: `DPOF|C>DEBIT`
;;composes ahead of `DPOF|C>CREDIT`, so ownership refuses before the receiver's freeze is ever read.)
(env-sigs [{ "key": "PK_AncientHodler", "caps": [] }])
(let
    (
        (ref-TS01-C1:module{TalosStageOne_ClientOneV2} TS01-C1)
    )
    (ref-TS01-C1::DPOF|C_ToggleFreezeAccount KST.ANHD "COF-98c486052a51" KST.LUMY false)
    ""
)
(env-sigs [{ "key": "PK_Lumy", "caps": [] } { "key": "PK_AncientHodler", "caps": [] }])
(let
    (
        (ref-DPOF:module{DemiourgosPactOrtoFungibleV2} DPOF)
        (ref-TS01-C1:module{TalosStageOne_ClientOneV2} TS01-C1)
        (id:string "COF-98c486052a51")
    )
    (print (format "<(TS01-C1.DPOF|C_Transmit, holder signing, LUMY paying)> => \"{}\""
        [(ref-TS01-C1::DPOF|C_Transmit KST.LUMY id [1] [10.0] KST.ANHD KST.LUMY false)]))
    (map print
        [
            (expect "<<TX-OF-003>> with the holder signing, the identical debit succeeds"
                10.0 (ref-DPOF::UR_AccountSupply id KST.LUMY))
            (expect "<<TX-OF-003>> ...and it came out of the victim's balance"
                0.0 (ref-DPOF::UR_AccountSupply id KST.ANHD))
        ]
    )
    ""
)
(env-sigs [])
(rollback-tx)

(print "")
(print "=== END FILE [6.1.6]_DPOF.repl (7 DPOF tail ops + Hydra wipe) ===")
