;;   Intra-tx:   ;;==== <TX label> · mm · <slug> ====  + next-line (print "--- [<label> · mm · …] ---"); mm = 01.. within each (begin-tx …) (see OuronetInformational/ARCHITECTURE/REPL_AND_TESTS.md).
;;   format "{}": Talos / module echoes and (env-gas) — document additional prefixes in this file's (print …) lines as needed.
;;
(print "")
(print "================================================================")
(print "FILE  REPL/Stage_02/[6.2]_AQP.repl")
(print "================================================================")
(print "Legend (terminal observability): see ;; preface; echoes use <(…)> where helpful.")
(print "Source: ;;|| NEXT > between txs; ;;==== … · mm · … ==== + banner before each begin-tx.")
(print "")
;; 5 per-module suites — each is the single entry for its module and self-bundles its
;; sub-suites (see each file's ;;GAS> / ;;FULL> sections). Strict order: ANK→SCORE→POOL→FVT→VCT.
(load "[6.2.1]_AQP-ANK.repl")     ;; ANK  — anchors + boost classes
(load "[6.2.2]_AQP-SCORE.repl")   ;; SCR  — scores, links, weights, triplet bookkeeping
(load "[6.2.3]_AQP-POOL.repl")    ;; POOL — pool issue, score slots, custody trackers, sync
(load "[6.2.4]_AQP-FVT.repl")     ;; FVT  — self-loads FVT-OF/-DC/-NF (RPS inject/collect, stake flows)
(load "[6.2.5]_AQP-VCT.repl")     ;; VCT  — pool-owner vacate (Full + Legs), all asset kinds
(load "[6.2.10]_AQP-NEGATIVES.repl") ;; NEG  - IMC boundary + owner/state negatives (Track C)
(load "[6.2.11]_AQP-SPLIT-MODE.repl") ;; SPLIT - dual reward-split mode toggle (D1-G2, task #89)
(load "[6.2.12]_AQP-ANCHOR-TAIL.repl") ;; ANCHOR-TAIL - SetCommonDenominator + RotateOwnership (#79 Ph2)
(load "[6.2.13]_AQP-TRIPLET.repl") ;; TRIPLET - IssueTrueFungibleScore + IssueTriplet (#79 Ph2)

