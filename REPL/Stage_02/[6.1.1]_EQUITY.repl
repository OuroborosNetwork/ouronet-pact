                (ref-TS02-C1::DPSF|C_MorphEquity owner owner id 1 150 2)
            )
            (expect-failure
                "<<TX-EQUITY-003>> Morph with input nonce == output nonce rejected"
                "Input and Output Nonces must be different for Morphing"
                (ref-TS02-C1::DPSF|C_MorphEquity owner owner id 1 1000 1)
            )
            (expect-failure
                "<<TX-EQUITY-003>> Morph with an out-of-range nonce (9, only 1-8 valid) rejected"
                "Invalid Input or Output Nonces for Morphing"
                (ref-TS02-C1::DPSF|C_MorphEquity owner owner id 1 1000 9)
            )
            (expect-failure
                "<<TX-EQUITY-003>> Morph with an out-of-range nonce (0, only 1-8 valid) rejected"
                "Invalid Input or Output Nonces for Morphing"
                (ref-TS02-C1::DPSF|C_MorphEquity owner owner id 1 1000 0)
            )
        ]
    )
    ""
)
(commit-tx)
(print "")
(print "=== END TX-EQUITY-003 ==================================================")
(print "")
(print "")
