(print "")
(begin-tx "VCT-GAS-00b - deploy synth accounts 001..999")
(namespace "ouronet-ns")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(print "--- [VCT-GAS-00b · 01 · deploy synth accounts 001..999] ---")
(env-sigs [{ "key": "PK_AncientHodler", "caps": [] }])
(let
    (
        (batch:integer 100)
    )
    (map
        (lambda (b:integer)
            (let
                (
                    (start:integer (+ 1 (* b batch)))
                    (count:integer (if (= b 9) 99 batch))
                )
                (print (format "<(VCTGAS.XI_DeploySynthRange)> batch {} => \"{}\"" [b (VCTGAS.XI_DeploySynthRange start count)]))
            )
        )
        (enumerate 0 9)
    )
)
(env-sigs [])
(print (format "<(REPL|env-gas)> VCT-GAS-00b deploy => \"{}\"" [(env-gas)]))
(commit-tx)
