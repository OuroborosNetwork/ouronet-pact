;;
;; REPL/Stage_02/[6.2.6]_AQP-VCT-GAS.repl — vacate Legs gas ladder (2M target) per asset kind
;; Loaded by REPL/VCT-gas-sweep.repl. Synth accounts: KST.ANHD with last 3 chars → 001..N.
;;
(print "")
(print "================================================================")
(print "FILE  REPL/Stage_02/[6.2.6]_AQP-VCT-GAS.repl  ")
(print "================================================================")
(print "Legend: <<VCT-GAS-*>> legs/gas/fits-2M; <<VCT-GAS-DPTF-BULK>> bulk receivers; <<VCT-GAS-OF-7x>> multi-nonce.")
(print "Source: ;;|| NEXT > between txs; VCT-GAS module holds probe helpers + max table.")
(print "REPL tests: C_Vacate*Legs + DPTF|C_BulkTransfer + 7-owner multi-nonce OF vs env-gaslimit 2000000.")
(print "")
;;
(begin-tx "VCT-GAS-00 - VCT-GAS probe module + synth account deploy")
(namespace "ouronet-ns")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
;;==== VCT-GAS-00 · 01 · module ==== =============================================================
(print "--- [VCT-GAS-00 · 01 · VCT-GAS module] ---")
(env-enable-repl-natives true)
(env-sigs
    [{"key": "1a4e15d3c51e0b73e92644600487ba8eaae312e1a178b91801d54e13c1b350a5", "caps": []}]
)
(module VCTGAS GOVERNANCE
    @doc "REPL-only vacate slice gas probes — synth Ouronet accounts + per-kind leg ladders"
    (defcap GOVERNANCE () true)
    (defconst GAS-LIMIT 2000000)
    (defconst SYNTH-TEMPLATE KST.ANHD)
    (defconst SYNTH-GUARD (keyset-ref-guard "ouronet-ns.dh_master-keyset"))
    (defconst MAX-SYNTH 999)
    (defun UC_SmartSplit:[decimal] (patron:string)
        (let
            (
                (ref-DALOS:module{OuronetDalosV1} DALOS)
            )
            (ref-DALOS::URC_SplitKDAPrices patron (* 2.0 (ref-DALOS::UR_UsagePrice "smart")))
        )
    )
    (defschema vacate-chunk-payload
        pool-id:string
        asset-id:string
        vacate-kind:integer
        vacate-job-id:string
        owner-ids:[string]
        beneficiary-ids:[string]
        nonces-array:[[integer]]
        amounts-array:[[integer]]
        tf-amounts:[decimal]
    )
    (defun UC_ChunkNonceTotal:integer (nonces-array:[[integer]])
        (fold
            (+)
            0
            (map (lambda (ns:[integer]) (length ns)) nonces-array)
        )
    )
    (defun UC_ProbeSliceCount:integer (unit-count:integer vacate-kind:integer)
        (let ((ref-VCT:module{AcquisitionVacateV1} AQP-VCT))
            (ref-VCT::UC_ComputeMinSliceCount unit-count vacate-kind)
        )
    )
    (defun UC_Pad3:string (idx:integer)
        (if (< idx 10)
            (format "00{}" [idx])
            (if (< idx 100)
                (format "0{}" [idx])
                (format "{}" [idx])
            )
        )
    )
    (defun UC_SynthAccount:string (idx:integer)
        (let
            (
                (base:string SYNTH-TEMPLATE)
                (n:integer (length base))
            )
            (concat [(take (- n 3) base) (UC_Pad3 idx)])
        )
    )
    (defun UC_SynthAccounts:[string] (count:integer)
        (map UC_SynthAccount (enumerate 1 count))
    )
    (defun UC_KadenaForIdx:string (idx:integer)
        (format "k:vacgas-{}" [(int-to-str 10 idx)])
    )
    (defun XI_DeploySynthAccount:string (idx:integer)
        (let
            (
                (ref-TS01-A:module{TalosStageOne_AdminV1} TS01-A)
                (acct:string (UC_SynthAccount idx))
            )
            (ref-TS01-A::DALOS|A_DeployStandardAccount acct SYNTH-GUARD (UC_KadenaForIdx idx) acct)
        )
    )
    (defun XI_DeploySynthRange:string (start:integer count:integer)
        (fold
            (lambda (acc:integer idx:integer)
                (XI_DeploySynthAccount idx)
                idx
            )
            start
            (enumerate start (+ start (- count 1)))
        )
        (format "deployed {}..{}" [start (+ start (- count 1))])
    )
    (defun XI_RunVacateFromPayload:string
        (patron:string payload:object{vacate-chunk-payload})
        @doc "Measure one Legs batch (finalize=false — probes use fresh pools)."
        (let
            (
                (ref-TS02-C3:module{TalosStageTwo_ClientThreeV1} TS02-C3)
                (ref-VCT:module{AcquisitionVacateV1} AQP-VCT)
                (kind:integer (at "vacate-kind" payload))
                (pool-id:string (at "pool-id" payload))
                (asset-id:string (at "asset-id" payload))
            )
            (if (= kind AQP-VCT.VACATE-KIND-TF)
                (ref-TS02-C3::AQP-POOL|C_VacateTrueFungibleLegs
                    patron pool-id asset-id
                    (at "owner-ids" payload)
                    (at "beneficiary-ids" payload)
                    (at "tf-amounts" payload)
                    false
                )
                (if (= kind AQP-VCT.VACATE-KIND-OF)
                    (ref-TS02-C3::AQP-POOL|C_VacateOrtoFungibleLegs
                        patron pool-id asset-id
                        (at "owner-ids" payload)
                        (at "beneficiary-ids" payload)
                        (at "nonces-array" payload)
                        (ref-VCT::UC_ZeroIntAmountsMatrix (at "nonces-array" payload))
                        false
                    )
                    (if (= kind AQP-VCT.VACATE-KIND-DPSF)
                        (ref-TS02-C3::AQP-POOL|C_VacateSemiFungibleLegs
                            patron pool-id asset-id
                            (at "owner-ids" payload)
                            (at "beneficiary-ids" payload)
                            (at "nonces-array" payload)
                            (at "amounts-array" payload)
                            false
                        )
                        (ref-TS02-C3::AQP-POOL|C_VacateNonFungibleLegs
                            patron pool-id asset-id
                            (at "owner-ids" payload)
                            (at "beneficiary-ids" payload)
                            (at "nonces-array" payload)
                            (at "amounts-array" payload)
                            false
                        )
                    )
                )
            )
        )
    )
    (defun UC_MinDpnfNonceRow:object{DpdcUdcV1.DPDC|NonceData} (idx:integer)
        (let
            (
                (ref-DPDC-UDC:module{DpdcUdcV1} DPDC-UDC)
                (md:object{DpdcUdcV1.NonceMetaData} (ref-DPDC-UDC::UDC_NoMetaData))
                (i-asset-type:object{DpdcUdcV1.URI|Type}
                    (ref-DPDC-UDC::UDC_URI|Type true false false false false false false)
                )
                (zd:object{DpdcUdcV1.URI|Data} (ref-DPDC-UDC::UDC_ZeroURI|Data))
            )
            (ref-DPDC-UDC::UDC_NonceData
                0.0 0.0
                (format "GasProbe{}" [idx])
                "vct-gas-probe-dpnf"
                md i-asset-type zd zd zd
            )
        )
    )
    (defun UC_DpnfNonceRows:[object{DpdcUdcV1.DPDC|NonceData}] (count:integer)
        (map UC_MinDpnfNonceRow (enumerate 1 count))
    )
    (defun XI_DpsfProbeSetup:object{vacate-chunk-payload}
        (
            patron:string
            pool-id:string
            dpsf-id:string
            n:integer
        )
        (let
            (
                (ref-TS02-C1:module{TalosStageTwo_ClientOneV1} TS02-C1)
                (ref-TS02-C3:module{TalosStageTwo_ClientThreeV1} TS02-C3)
                (ref-VCT:module{AcquisitionVacateV1} AQP-VCT)
                (nonce:integer 1)
            )
            (fold
                (lambda (acc:bool idx:integer)
                    (let ((owner:string (UC_SynthAccount idx)))
                        (ref-TS02-C1::DPSF|C_TransferNonces patron dpsf-id patron owner [nonce] [1] false)
                        (ref-TS02-C3::AQP-POOL|C_StakeSemiFungibleCollectable patron pool-id owner owner dpsf-id [nonce])
                    )
                    true
                )
                true
                (enumerate 1 n)
            )
            (let
                (
                    (slice-count:integer (UC_ProbeSliceCount n AQP-VCT.VACATE-KIND-DPSF))
                )
                (let
                    (
                        (plan:object (ref-VCT::URDC_BuildVacateSlicePlan pool-id dpsf-id AQP-VCT.VACATE-KIND-DPSF slice-count))
                        (slice0:object (at 0 (at "slices" plan)))
                    )
                    {
                        "pool-id": pool-id,
                        "asset-id": dpsf-id,
                        "vacate-kind": AQP-VCT.VACATE-KIND-DPSF,
                        "vacate-job-id": "",
                        "owner-ids": (at "owner-ids" slice0),
                        "beneficiary-ids": (at "beneficiary-ids" slice0),
                        "nonces-array": (at "nonces-array" slice0),
                        "amounts-array": (at "amounts-array" slice0),
                        "tf-amounts": []
                    }
                )
            )
        )
    )
    (defun XI_DpsfProbeVacateChunk:string
        (
            patron:string
            pool-id:string
            dpsf-id:string
            n:integer
        )
        (XI_RunVacateFromPayload patron (XI_DpsfProbeSetup patron pool-id dpsf-id n))
    )
    (defun XI_TfProbeSetup:object{vacate-chunk-payload}
        (
            patron:string
            pool-id:string
            ouro-id:string
            n:integer
            stake-amt:decimal
        )
        (let
            (
                (ref-TS01-C1:module{TalosStageOne_ClientOneV1} TS01-C1)
                (ref-TS02-C3:module{TalosStageTwo_ClientThreeV1} TS02-C3)
                (ref-VCT:module{AcquisitionVacateV1} AQP-VCT)
            )
            (fold
                (lambda (acc:bool idx:integer)
                    (let ((owner:string (UC_SynthAccount idx)))
                        (ref-TS01-C1::DPTF|C_Transfer patron ouro-id patron owner stake-amt true)
                        (ref-TS02-C3::AQP-POOL|C_StakeTrueFungible patron pool-id owner owner ouro-id stake-amt)
                    )
                    true
                )
                true
                (enumerate 1 n)
            )
            (let
                (
                    (slice-count:integer (UC_ProbeSliceCount n AQP-VCT.VACATE-KIND-TF))
                )
                (let
                    (
                        (plan:object (ref-VCT::URDC_BuildVacateSlicePlan pool-id ouro-id AQP-VCT.VACATE-KIND-TF slice-count))
                        (slice0:object (at 0 (at "slices" plan)))
                    )
                    {
                        "pool-id": pool-id,
                        "asset-id": ouro-id,
                        "vacate-kind": AQP-VCT.VACATE-KIND-TF,
                        "vacate-job-id": "",
                        "owner-ids": (at "owner-ids" slice0),
                        "beneficiary-ids": (at "beneficiary-ids" slice0),
                        "nonces-array": [],
                        "amounts-array": [],
                        "tf-amounts": (at "amounts" slice0)
                    }
                )
            )
        )
    )
    (defun XI_TfProbeVacateChunk:string
        (
            patron:string
            pool-id:string
            ouro-id:string
            n:integer
            stake-amt:decimal
        )
        (XI_RunVacateFromPayload patron (XI_TfProbeSetup patron pool-id ouro-id n stake-amt))
    )
    (defun XI_OfProbeSetup:object{vacate-chunk-payload}
        (
            patron:string
            pool-id:string
            dpof-id:string
            n:integer
        )
        (let
            (
                (ref-TS01-C1:module{TalosStageOne_ClientOneV1} TS01-C1)
                (ref-TS02-C3:module{TalosStageTwo_ClientThreeV1} TS02-C3)
                (ref-DPOF:module{DemiourgosPactOrtoFungibleV1} DPOF)
                (ref-VCT:module{AcquisitionVacateV1} AQP-VCT)
            )
            (if (not (ref-DPOF::UR_R-AddQuantity dpof-id patron))
                (ref-TS01-C1::DPOF|C_ToggleAddQuantityRole patron dpof-id patron true)
                true
            )
            (if (ref-DPOF::UR_R-Frozen dpof-id patron)
                (ref-TS01-C1::DPOF|C_ToggleFreezeAccount patron dpof-id patron false)
                true
            )
            (fold
                (lambda (acc:bool idx:integer)
                    (let ((owner:string (UC_SynthAccount idx)))
                        (ref-TS01-C1::DPOF|C_Mint patron dpof-id patron 1.0 [{"vct-gas": true}])
                        (let
                            (
                                (patron-nonces:[integer] (ref-DPOF::URD_AccountNonces patron dpof-id))
                                (mint-nonce:integer (at (- (length patron-nonces) 1) patron-nonces))
                            )
                            (ref-TS01-C1::DPOF|C_Transfer patron dpof-id [mint-nonce] patron owner true)
                            (if (ref-DPOF::UR_R-Frozen dpof-id owner)
                                (ref-TS01-C1::DPOF|C_ToggleFreezeAccount patron dpof-id owner false)
                                true
                            )
                            (ref-TS02-C3::AQP-POOL|C_StakeOrtoFungible patron pool-id owner owner dpof-id [mint-nonce])
                        )
                    )
                    true
                )
                true
                (enumerate 1 n)
            )
            (let
                (
                    (slice-count:integer (UC_ProbeSliceCount n AQP-VCT.VACATE-KIND-OF))
                )
                (let
                    (
                        (plan:object (ref-VCT::URDC_BuildVacateSlicePlan pool-id dpof-id AQP-VCT.VACATE-KIND-OF slice-count))
                        (slice0:object (at 0 (at "slices" plan)))
                    )
                    {
                        "pool-id": pool-id,
                        "asset-id": dpof-id,
                        "vacate-kind": AQP-VCT.VACATE-KIND-OF,
                        "vacate-job-id": "",
                        "owner-ids": (at "owner-ids" slice0),
                        "beneficiary-ids": (at "beneficiary-ids" slice0),
                        "nonces-array": (at "nonces-array" slice0),
                        "amounts-array": [],
                        "tf-amounts": []
                    }
                )
            )
        )
    )
    (defun XI_OfProbeVacateChunk:string
        (
            patron:string
            pool-id:string
            dpof-id:string
            n:integer
        )
        (XI_RunVacateFromPayload patron (XI_OfProbeSetup patron pool-id dpof-id n))
    )
    (defun XI_DpnfProbeSetup:object{vacate-chunk-payload}
        (
            patron:string
            pool-id:string
            dpnf-id:string
            n:integer
        )
        (let
            (
                (ref-DPDC:module{DpdcV1} DPDC)
                (ref-TS02-C2:module{TalosStageTwo_ClientTwoV1} TS02-C2)
                (ref-TS02-C3:module{TalosStageTwo_ClientThreeV1} TS02-C3)
                (ref-VCT:module{AcquisitionVacateV1} AQP-VCT)
                (source:string KST.EMMA)
                (pre-count:integer (length (ref-DPDC::URD_AccountNonces source dpnf-id false)))
            )
            (ref-TS02-C2::DPNF|C_Create patron dpnf-id (UC_DpnfNonceRows n))
            (let
                (
                    (picked:[integer]
                        (take n (drop pre-count (ref-DPDC::URD_AccountNonces source dpnf-id false)))
                    )
                )
                (enforce (= (length picked) n)
                    (format "DPNF probe: created {} new {} nonces on EMMA" [n dpnf-id])
                )
                (fold
                    (lambda (acc:bool idx:integer)
                        (let
                            (
                                (owner:string (UC_SynthAccount idx))
                                (nonce:integer (at (- idx 1) picked))
                            )
                            (ref-TS02-C2::DPNF|C_TransferNonces patron dpnf-id source owner [nonce] [1] false)
                            (ref-TS02-C3::AQP-POOL|C_StakeNonFungibleCollectable patron pool-id owner owner dpnf-id [nonce])
                        )
                        true
                    )
                    true
                    (enumerate 1 n)
                )
            )
            (let
                (
                    (slice-count:integer (UC_ProbeSliceCount n AQP-VCT.VACATE-KIND-DPNF))
                )
                (let
                    (
                        (plan:object (ref-VCT::URDC_BuildVacateSlicePlan pool-id dpnf-id AQP-VCT.VACATE-KIND-DPNF slice-count))
                        (slice0:object (at 0 (at "slices" plan)))
                    )
                    {
                        "pool-id": pool-id,
                        "asset-id": dpnf-id,
                        "vacate-kind": AQP-VCT.VACATE-KIND-DPNF,
                        "vacate-job-id": "",
                        "owner-ids": (at "owner-ids" slice0),
                        "beneficiary-ids": (at "beneficiary-ids" slice0),
                        "nonces-array": (at "nonces-array" slice0),
                        "amounts-array": (at "amounts-array" slice0),
                        "tf-amounts": []
                    }
                )
            )
        )
    )
    (defun XI_DpnfProbeVacateChunk:string
        (
            patron:string
            pool-id:string
            dpnf-id:string
            n:integer
        )
        (XI_RunVacateFromPayload patron (XI_DpnfProbeSetup patron pool-id dpnf-id n))
    )
        (defun XI_ChunkPayloadFromPool:object{vacate-chunk-payload}
        (pool-id:string asset-id:string vacate-kind:integer)
        @doc "Offline plan slice-0 payload from live inventory (stateless Legs)."
        (let
            (
                (ref-VCT:module{AcquisitionVacateV1} AQP-VCT)
                (unit-count:integer (ref-VCT::URDC_VacateUnitCountForKind pool-id asset-id vacate-kind))
                (slice-count:integer (UC_ProbeSliceCount unit-count vacate-kind))
                (plan:object (ref-VCT::URDC_BuildVacateSlicePlan pool-id asset-id vacate-kind slice-count))
                (slice0:object (at 0 (at "slices" plan)))
            )
            (if (= vacate-kind AQP-VCT.VACATE-KIND-TF)
                {
                    "pool-id": pool-id,
                    "asset-id": asset-id,
                    "vacate-kind": vacate-kind,
                    "vacate-job-id": "",
                    "owner-ids": (at "owner-ids" slice0),
                    "beneficiary-ids": (at "beneficiary-ids" slice0),
                    "nonces-array": [],
                    "amounts-array": [],
                    "tf-amounts": (at "amounts" slice0)
                }
                {
                    "pool-id": pool-id,
                    "asset-id": asset-id,
                    "vacate-kind": vacate-kind,
                    "vacate-job-id": "",
                    "owner-ids": (at "owner-ids" slice0),
                    "beneficiary-ids": (at "beneficiary-ids" slice0),
                    "nonces-array": (at "nonces-array" slice0),
                    "amounts-array": (if (= vacate-kind AQP-VCT.VACATE-KIND-OF)
                        (ref-VCT::UC_ZeroIntAmountsMatrix (at "nonces-array" slice0))
                        (at "amounts-array" slice0)
                    ),
                    "tf-amounts": []
                }
            )
        )
    )
    (defun XI_MeasureVacateChunk:integer
        (patron:string payload:object{vacate-chunk-payload})
        (let ((g-before:integer (env-gas)))
            (XI_RunVacateFromPayload patron payload)
            (- (env-gas) g-before)
        )
    )
    (defun XI_ProbeDpsf:integer
        (patron:string dpsf-id:string ouro-id:string n:integer)
        (let
            (
                (ref-U|DALOS:module{UtilityDalosV1} U|DALOS)
                (ref-TS02-C3:module{TalosStageTwo_ClientThreeV1} TS02-C3)
                (pool-name:string (format "VctGasDpsf{}" [n]))
                (score-name:string (format "VctGasSfScore{}" [n]))
                (pool-id:string (ref-U|DALOS::UDC_Makeid pool-name))
                (fvt-id:string (ref-U|DALOS::UDC_Makeid (format "VctGasDpsfFvt{}" [n])))
            )
            (ref-TS02-C3::AQP-POOL|C_Issue patron pool-name dpsf-id 3)
            (ref-TS02-C3::AQP-SCR|C_IssueSemiFungibleScore patron patron score-name 3 true)
            (ref-TS02-C3::AQP-POOL|C_AddScore patron pool-id (ref-U|DALOS::UDC_Makeid score-name))
            (ref-TS02-C3::AQP-FVT|REPL_BootstrapVault patron fvt-id patron (ref-U|DALOS::UDC_Makeid score-name) ouro-id)
            (let
                (
                    (payload:object{vacate-chunk-payload} (XI_DpsfProbeSetup patron pool-id dpsf-id n))
                    (chunk-gas:integer (XI_MeasureVacateChunk patron payload))
                    (chunk-nonces:integer (UC_ChunkNonceTotal (at "nonces-array" payload)))
                )
                (print (format "<<VCT-GAS-DPSF>> staked={} chunk-nonces={} chunk-gas={} gas-per-nonce={} fits-2M={}"
                    [n chunk-nonces chunk-gas (/ chunk-gas chunk-nonces) (<= chunk-gas GAS-LIMIT)]))
                chunk-gas
            )
        )
    )
    (defun XI_ProbeTf:integer
        (patron:string ouro-id:string n:integer stake-amt:decimal)
        (let
            (
                (ref-U|DALOS:module{UtilityDalosV1} U|DALOS)
                (ref-TS02-C3:module{TalosStageTwo_ClientThreeV1} TS02-C3)
                (pool-name:string (format "VctGasTf{}" [n]))
                (score-name:string (format "VctGasTfScore{}" [n]))
                (pool-id:string (ref-U|DALOS::UDC_Makeid pool-name))
                (fvt-id:string (ref-U|DALOS::UDC_Makeid (format "VctGasTfFvt{}" [n])))
                (score-id:string (ref-U|DALOS::UDC_Makeid score-name))
            )
            (ref-TS02-C3::AQP-POOL|C_Issue patron pool-name ouro-id 1)
            (ref-TS02-C3::AQP-SCR|C_IssueTrueFungibleScore patron patron score-name 12 1.0)
            (ref-TS02-C3::AQP-POOL|C_AddScore patron pool-id score-id)
            (ref-TS02-C3::AQP-FVT|REPL_BootstrapVault patron fvt-id patron score-id ouro-id)
            (let
                (
                    (payload:object{vacate-chunk-payload} (XI_TfProbeSetup patron pool-id ouro-id n stake-amt))
                    (chunk-gas:integer (XI_MeasureVacateChunk patron payload))
                    (chunk-legs:integer (length (at "owner-ids" payload)))
                )
                (print (format "<<VCT-GAS-TF>> staked={} chunk-legs={} chunk-gas={} gas-per-leg={} fits-2M={}"
                    [n chunk-legs chunk-gas (/ chunk-gas chunk-legs) (<= chunk-gas GAS-LIMIT)]))
                chunk-gas
            )
        )
    )
    (defun XI_ProbeOf:integer
        (patron:string dpof-id:string ouro-id:string n:integer)
        (let
            (
                (ref-U|DALOS:module{UtilityDalosV1} U|DALOS)
                (ref-TS02-C3:module{TalosStageTwo_ClientThreeV1} TS02-C3)
                (pool-name:string (format "VctGasOf{}" [n]))
                (score-name:string (format "VctGasOfScore{}" [n]))
                (pool-id:string (ref-U|DALOS::UDC_Makeid pool-name))
                (fvt-id:string (ref-U|DALOS::UDC_Makeid (format "VctGasOfFvt{}" [n])))
            )
            (ref-TS02-C3::AQP-SCR|C_IssueOrtoFungibleScore patron patron score-name 12 1.0 1.0)
            (ref-TS02-C3::AQP-POOL|C_Issue patron pool-name dpof-id 2)
            (ref-TS02-C3::AQP-POOL|C_AddScore patron pool-id (ref-U|DALOS::UDC_Makeid score-name))
            (ref-TS02-C3::AQP-FVT|REPL_BootstrapVault patron fvt-id patron (ref-U|DALOS::UDC_Makeid score-name) ouro-id)
            (let
                (
                    (payload:object{vacate-chunk-payload} (XI_OfProbeSetup patron pool-id dpof-id n))
                    (chunk-gas:integer (XI_MeasureVacateChunk patron payload))
                    (chunk-nonces:integer (UC_ChunkNonceTotal (at "nonces-array" payload)))
                )
