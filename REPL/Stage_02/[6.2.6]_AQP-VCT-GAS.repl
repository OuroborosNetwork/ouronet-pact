            (ref-TS02-C3::AQP-SCR|C_IssueOrtoFungibleScore patron patron score-name 12 1.0 1.0)
            (ref-TS02-C3::AQP-POOL|C_Issue patron pool-name dpof-id 2)
            (ref-TS02-C3::AQP-POOL|C_AddScore patron pool-id (ref-U|DALOS::UDC_Makeid score-name))
            (ref-TS02-C3::AQP-FVT|REPL_BootstrapVault patron fvt-id patron (ref-U|DALOS::UDC_Makeid score-name) ouro-id)
            (let
