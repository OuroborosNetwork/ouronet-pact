(begin-tx "TX-BOOT-08 - AQP-BOOT Step8 Issue FVT entities")
(print "")
(print "=== TX-BOOT-08 — Step8 Issue FVT entities (OuroLpFarm when DHOuroLp exists) =====")
(namespace "ouronet-ns")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
;;==== TX-BOOT-08 - AQP-BOOT Step8 Issue FVT entities · 01 · let / invocation ==== ================
(print "--- [TX-BOOT-08 - AQP-BOOT Step8 Issue FVT entities · 01 · let / invocation] ---")
(let
    (
        (patron:string KST.ANHD)
        (owner-konto:string KST.ANHD)
        (ref-U|DALOS:module{UtilityDalosV2} U|DALOS)
        (ref-AQP:module{AcquisitionPoolsV1} AQP-POOL)
        (pool-ouro-lp:string (ref-U|DALOS::UDC_Makeid "DHOuroLp"))
        (farm-skip:string
            (if (try false (!= (ref-AQP::UR_AQP|PoolAqpClass pool-ouro-lp) -1))
