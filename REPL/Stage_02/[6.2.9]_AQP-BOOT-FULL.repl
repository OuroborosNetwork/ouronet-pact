(begin-tx "TX-BOOT-08b - Seed OURO SWP liquidity for OuroLpFarm ghost weight")
(print "")
(print "=== TX-BOOT-08b — Add liquidity to W|DLK|OURO|DWK when StoaValue=0 ============")
(namespace "ouronet-ns")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(let
    (
        (patron:string KST.ANHD)
        (swpair:string "W|DLK-98c486052a51|OURO-98c486052a51|DWK-98c486052a51")
        (ref-SWP:module{SwapperV3} SWP)
        (ref-TS01-C3:module{TalosStageOne_ClientThreeV3} TS01-C3)
        (stoa-pre:decimal (ref-SWP::UR_StoaValue swpair))
    )
    (env-sigs [{ "key": "PK_AncientHodler", "caps": [] }])
    (print (format "<(SWP|UR_StoaValue pre-seed)> => \"{}\"" [stoa-pre]))
    (if (= stoa-pre 0.0)
        (let
            (
                (stoa-post:decimal (ref-SWP::UR_StoaValue swpair))
            )
            (print (format "<(SWP|C_AddLiquidity OURO pool)> => \"{}\"" [
                (ref-TS01-C3::SWP|C_AddLiquidity patron patron swpair [300.0 500.0 200.0])
            ]))
            (print (format "<(SWP|UR_StoaValue post-seed)> => \"{}\"" [(ref-SWP::UR_StoaValue swpair)]))
        )
        (print "NOTE: OURO pool already has StoaValue > 0 — seed skipped")
    )
)
(env-sigs [])
(commit-tx)
(print "")
