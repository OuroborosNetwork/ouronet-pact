(begin-tx "TX-BOOT-1314 - Custodians delegated-staking vault + its first agency")
(print "")
(print "=== TX-BOOT-1314 — Steps 13+14: the Custodians DSA vault, opened end to end ======")
(namespace "ouronet-ns")
(env-gasmodel "table")(env-gaslimit 100000000)(env-gas 0)
;;ADDED 2026-09-19 with C_Step13_CreateCustodiansVault / CC_Step14_OpenCustodiansAgency.
;;
;;WHY THIS RUNS THE REAL FUNCTIONS AND DOES NOT HAND-ROLL THEM. TX-BOOT-07/07b hand-rolled
;;C_Step7 and drifted from it, which is how the missing Bloodshed link survived for months.
;;These two steps are driven through their actual entrypoints, so the suite cannot diverge
;;from what deployment does.
;;
;;THE COLLECTION IS REAL, not a fixture invention: [4.0]_Sovereign-Executor issues
;;"OuronetCustodians" (DHOC) with nonce 1 Bronze / 2 Silver / 3 Golden / 4 OG Founder, and its
;;own descriptions say each of the first three is "a third of Ouronet Financial Ownership"
;;spread over 10000 / 1000 / 100 units. That is a 1:10:100 per-unit ratio, which is exactly
;;what BOOT|CUSTODIANS_VALUE_* encode -- so each tier is worth 10000 quintessence and the whole
;;collection 30000.
;;
;;THE OPERATOR STAKES WHOLE GOLDEN NONCE 3 -- 100 units x 100.0 = 10000 quintessence, which is
;;exactly unit-score/2 and therefore exactly the open gate. Staking whole (not fragment) nonces
;;is the point: it proves BOOT|CUSTODIANS_NONCES_* listing the positive nonce alongside its
;;negative actually works. The DSA fixtures in Kursan/ only ever stake fragments, so a
;;whole-nonce stake would score ZERO under their model shape and no test would notice.
(let
    (
        (patron:string KST.ANHD)
        (ref-U|DALOS:module{UtilityDalosV2} U|DALOS)
        (ref-DALOS:module{OuronetDalosV2} DALOS)
        (dhoc-id:string "DHOC-98c486052a51")
        (ouro-id:string "OURO-98c486052a51")
        (split-smart:[decimal]
            (DALOS.URC_SplitSTOAPrices patron (* 12.0 (DALOS.UR_UsagePrice "smart")))
        )
    )
    (env-sigs
        [
            { "key": "PK_AncientHodler", "caps": [] }
            { "key": "6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263",
              "caps":
                [
                    (coin.TRANSFER "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263" "k:50d6c59b21e5e6e55baecaa75a1007de37576bde12d8230dc82459cc01b9484b" (at 2 split-smart))
                    (coin.TRANSFER "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263" "k:0cb30c0121ff919266121a99ff9359871818932211df94dae4137c29bc0e8f7e" (at 0 split-smart))
                    (coin.TRANSFER "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263" "c:XM-pkmuB5XUQlp87ZYSbfKt8qzmHY6O2EHAzMRVBt3k" (at 3 split-smart))
                    (coin.TRANSFER "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263" "c:iQQFWj6gWtpGEzhM_O5ekW1QtnQQy55R8BRPGhj_0FU" (at 1 split-smart))
                ]
            }
        ]
    )
    ;;==== TX-BOOT-1314 · 01 · Step 13 — build the vault ====
    (print "--- [TX-BOOT-1314 · 01 · Step 13 build the vault] ---")
    (print (format "<(AQP-BOOT.C_Step13_CreateCustodiansVault)> => \"{}\""
        [(AQP-BOOT.C_Step13_CreateCustodiansVault patron patron dhoc-id ouro-id
            (concat ["F" "|" ouro-id "|" (ref-DALOS::UR_AurynID) "|" (ref-DALOS::UR_EliteAurynID)]))]))
    ;;==== TX-BOOT-1314 · 02 · Step 14 — open the first agency ====
    (print "--- [TX-BOOT-1314 · 02 · Step 14 open the first agency] ---")
    (print (format "<(AQP-BOOT.CC_Step14_OpenCustodiansAgency)> => \"{}\""
        [(AQP-BOOT.CC_Step14_OpenCustodiansAgency patron "OuronetPrime" dhoc-id [3] 100)]))
    ;;==== TX-BOOT-1314 · 03 · assertions ====
    (print "--- [TX-BOOT-1314 · 03 · assertions] ---")
    (let
        (
            (fvt-id:string (ref-U|DALOS::UDC_Makeid "CustodiansVault"))
            (triplet-id:string
                (AQP-SCORE.UC_ComputeTripletId
                    (ref-U|DALOS::UDC_Makeid "OuronetPrimeBronze")
                    (ref-U|DALOS::UDC_Makeid "OuronetPrimeSilver")
                    (ref-U|DALOS::UDC_Makeid "OuronetPrimeGolden")))
        )
        (map print
            [
            (expect "<<TX-BOOT-13>> the Custodians vault is a class-0 FVT (DSA refuses anything else)"
                0 (RPS.UR_FVT|FvtClass fvt-id))
            (expect "<<TX-BOOT-13>> unit-score is 20000, so the agency gate is 10000"
                20000 (AQP-DSA.UR_DSA-TMP|UnitScore fvt-id))
            (expect "<<TX-BOOT-13>> the DSA template is active"
                true (AQP-DSA.UR_DSA-TMP|Active fvt-id))
            ;;The split is the economic heart of this vault: bronze 20/40/40, silver 40/30/30,
            ;;golden 60/20/20 across the OURO|AURYN|ELITEAURYN ladder. Read back from RPS, not
            ;;trusted from Step 13's echo -- the echo is formatted by the same call that wrote it.
            (expect "<<TX-BOOT-13>> HETEROGENEOUS quality split is registered"
                "HETEROGENEOUS" (RPS.UR_FVT-QS|Mode fvt-id ouro-id))
            (expect "<<TX-BOOT-13>> bronze lane splits 20% OURO / 40% Auryn / 40% Elite-Auryn"
                [200 400 400] (RPS.UR_FVT-QS|BronzeSplit fvt-id ouro-id))
            (expect "<<TX-BOOT-13>> golden lane splits 60% / 20% / 20%"
                [600 200 200] (RPS.UR_FVT-QS|GoldSplit fvt-id ouro-id))
            ;;Step 14: the agency exists, and its quintessence is the WHOLE-nonce stake scoring
            ;;correctly. 100 golden units x 100.0 = 10000 = exactly unit-score/2, the open gate.
            (expect "<<TX-BOOT-14>> the first agency's operator is recorded"
                KST.ANHD (AQP-DSA.UR_DSA-AGN|Operator fvt-id triplet-id))
            ;;100 whole golden x 100 000 = 10 000 000 quintessence = 500 capture units at
            ;;unit-score 20000. Whole nonces are staked deliberately: every DSA fixture in
            ;;Kursan/ stakes fragment negatives only, and a fragment-only model scores a whole
            ;;nonce ZERO with nothing to catch it.
            (expect "<<TX-BOOT-14>> 100 WHOLE golden Custodians = 10,000,000 quintessence"
                10000000.0 (AQP-DSA.URC_AgencyQuintessence triplet-id))
            (expect "<<TX-BOOT-14>> the OG boost class exists and the golden score links to it"
                (AQP-SCORE.UR_SCR|ScoreBoostClassLink (U|DALOS.UDC_Makeid "OuronetPrimeGolden"))
                (U|DALOS.UDC_Makeid "CustodiansOgBoost"))
            ]
        )
    )
    ""
)
(commit-tx)
(env-sigs [])

;;||>>>>>>>>>>>>>>>>>>>>>>>>>
;;|| NEXT                   >
;;||>>>>>>>>>>>>>>>>>>>>>>>>>
(print "")
(print "")
;;
(begin-tx "TX-BOOT-15-DSA - second agency, inject, collect: does the Custodians vault actually pay?")
(print "")
(print "=== TX-BOOT-15-DSA — a SECOND agency, an inject, and two collects ================")
(namespace "ouronet-ns")
(env-gasmodel "table")(env-gaslimit 200000000)(env-gas 0)
;;ADDED 2026-09-19. The point of this block is stated plainly: everything before it proves the
;;Custodians vault was BUILT correctly (rows exist, classes are right, splits are registered).
;;None of that proves it PAYS. This runs the economic loop end to end on the code that is
;;actually going to be deployed:
;;
;;    a second agency, by a DIFFERENT operator, through the PUBLIC path
;;    -> an oracle write that turns quintessence into capture
;;    -> an inject
;;    -> a collect by each operator
;;
;;WHY THE SECOND AGENCY USES THE PUBLIC PATH AND NOT CC_Step14. CC_Step14 is
;;GOV|AQP_BOOT_ADMIN-gated, which is correct for the FIRST agency and wrong for every other
;;one -- real operators must never hold that key. So EMMA opens hers the way a real operator
;;will: C_IssueScoreFromModel against the SAME triplet model, three boost-class links, three
;;C_AddScore, then AQP-DSA|CC_OpenAgency. If that sequence works here, the documented
;;instruction in Deploy/3_Assets/15 is true; if it does not, that instruction is a lie.
;;
;;WHY CAPTURE MUST BE ORACLED FIRST. capture-units = min(floor(Q / unit-score), NODES), and
;;`nodes` starts at 0 -- so an agency with millions of quintessence earns NOTHING until an
;;oracle reports node count. That is the single most surprising property of this vault and the
;;most likely operational mistake, so it is exercised rather than described.
(env-data { "dsa-oracle": { "keys": ["dsa-oracle-key"], "pred": "keys-all" } })
(let
    (
        (patron:string KST.ANHD)
        (ref-U|DALOS:module{UtilityDalosV2} U|DALOS)
        (ref-DALOS:module{OuronetDalosV2} DALOS)
        (dhoc-id:string "DHOC-98c486052a51")
        (split-smart:[decimal]
            (DALOS.URC_SplitSTOAPrices patron (* 12.0 (DALOS.UR_UsagePrice "smart")))
        )
    )
    (env-sigs
        [
            { "key": "PK_AncientHodler", "caps": [] }
            { "key": "PK_Emma", "caps": [] }
            { "key": "dsa-oracle-key", "caps": [] }
            ;;EMMA's OWN gas-station caps. Without these the hijack probe below dies in
            ;;coin.TRANSFER -- BEFORE the ownership check it is supposed to exercise -- and would
            ;;have "passed" as an expect-failure while proving nothing about the guard. The whole
            ;;point of that probe is that it must fail at the RIGHT enforce.
            { "key": "ecaeae048b6e4b1d4cd9b5ba41041b39e05ac3a7b32f495a12823cb1c5ad0f48",
              "caps":
                [
                    (coin.TRANSFER "k:ecaeae048b6e4b1d4cd9b5ba41041b39e05ac3a7b32f495a12823cb1c5ad0f48" "k:50d6c59b21e5e6e55baecaa75a1007de37576bde12d8230dc82459cc01b9484b" 1000000.0)
                    (coin.TRANSFER "k:ecaeae048b6e4b1d4cd9b5ba41041b39e05ac3a7b32f495a12823cb1c5ad0f48" "k:0cb30c0121ff919266121a99ff9359871818932211df94dae4137c29bc0e8f7e" 1000000.0)
                    (coin.TRANSFER "k:ecaeae048b6e4b1d4cd9b5ba41041b39e05ac3a7b32f495a12823cb1c5ad0f48" "c:XM-pkmuB5XUQlp87ZYSbfKt8qzmHY6O2EHAzMRVBt3k" 1000000.0)
                    (coin.TRANSFER "k:ecaeae048b6e4b1d4cd9b5ba41041b39e05ac3a7b32f495a12823cb1c5ad0f48" "c:iQQFWj6gWtpGEzhM_O5ekW1QtnQQy55R8BRPGhj_0FU" 1000000.0)
                ]
            }
            { "key": "6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263",
              "caps":
                [
                    (coin.TRANSFER "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263" "k:50d6c59b21e5e6e55baecaa75a1007de37576bde12d8230dc82459cc01b9484b" (at 2 split-smart))
                    (coin.TRANSFER "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263" "k:0cb30c0121ff919266121a99ff9359871818932211df94dae4137c29bc0e8f7e" (at 0 split-smart))
                    (coin.TRANSFER "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263" "c:XM-pkmuB5XUQlp87ZYSbfKt8qzmHY6O2EHAzMRVBt3k" (at 3 split-smart))
                    (coin.TRANSFER "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263" "c:iQQFWj6gWtpGEzhM_O5ekW1QtnQQy55R8BRPGhj_0FU" (at 1 split-smart))
                ]
            }
        ]
    )
    ;;==== TX-BOOT-15-DSA · 01 · fund EMMA with bronze Custodians ====
    (print "--- [TX-BOOT-15-DSA · 01 · fund EMMA] ---")
    (print (format "<(transfer 20 whole bronze to EMMA)> => \"{}\""
        [(TS02-C1.DPSF|C_TransferNonce patron patron KST.EMMA dhoc-id 1 20 false)]))
    ;;==== TX-BOOT-15-DSA · 02 · EMMA opens agency #2 via the PUBLIC path ====
    (print "--- [TX-BOOT-15-DSA · 02 · EMMA opens agency 2, public path] ---")
    (let
        (
            (emma:string KST.EMMA)
            (fvt-id:string (ref-U|DALOS::UDC_Makeid "CustodiansVault"))
            (pool-id:string (ref-U|DALOS::UDC_Makeid "CustodiansPool"))
            (model-id:string (ref-U|DALOS::UDC_Makeid "CustodiansQuintessenceTriplet"))
            (og-class:string (ref-U|DALOS::UDC_Makeid "CustodiansOgBoost"))
        )
        (print (format "<(EMMA C_IssueScoreFromModel)> => \"{}\""
            [(TS02-C3.AQP-SCR|C_IssueScoreFromModel emma emma model-id "EmmaAgency")]))
        (let
            (
                (eb:string (ref-U|DALOS::UDC_Makeid "EmmaAgencyBronze"))
                (es:string (ref-U|DALOS::UDC_Makeid "EmmaAgencySilver"))
                (eg:string (ref-U|DALOS::UDC_Makeid "EmmaAgencyGolden"))
            )
            (TS02-C3.AQP-SCR|C_CreateScoreBoostClassLink emma eb og-class)
            (TS02-C3.AQP-SCR|C_CreateScoreBoostClassLink emma es og-class)
            (TS02-C3.AQP-SCR|C_CreateScoreBoostClassLink emma eg og-class)
            (TS02-C3.AQP-POOL|C_AddScore emma (AQP-POOL.URC_AqpOwnerKonto pool-id) pool-id eb)
            (TS02-C3.AQP-POOL|C_AddScore emma (AQP-POOL.URC_AqpOwnerKonto pool-id) pool-id es)
            (TS02-C3.AQP-POOL|C_AddScore emma (AQP-POOL.URC_AqpOwnerKonto pool-id) pool-id eg)
            ;;20 whole bronze x 1000 = 20 000 quintessence -- twice the 10 000 gate.
            (print (format "<(EMMA CC_OpenAgency, stake 20 whole bronze)> => \"{}\""
                [(TS02-C3.AQP-DSA|CC_OpenAgency emma emma fvt-id pool-id
                    (AQP-SCORE.UC_ComputeTripletId eb es eg) 100 dhoc-id [1])]))
            (print (format "<(EMMA agency quintessence)> => {}"
                [(AQP-DSA.URC_AgencyQuintessence (AQP-SCORE.UC_ComputeTripletId eb es eg))]))
            ;;==== TX-BOOT-15-DSA · 03 · oracle: quintessence becomes CAPTURE ====
            (print "--- [TX-BOOT-15-DSA · 03 · oracle] ---")
            (let
                (
                    (anhd-triplet:string (AQP-SCORE.UC_ComputeTripletId
                        (ref-U|DALOS::UDC_Makeid "OuronetPrimeBronze")
                        (ref-U|DALOS::UDC_Makeid "OuronetPrimeSilver")
                        (ref-U|DALOS::UDC_Makeid "OuronetPrimeGolden")))
                    (emma-triplet:string (AQP-SCORE.UC_ComputeTripletId eb es eg))
                )
                ;;capture BEFORE any oracle write -- this is the operational trap, proven not told
                (print (format "<(capture before oracle)> anhd={} emma={}"
                    [(AQP-DSA.URC_CaptureUnits fvt-id anhd-triplet)
                     (AQP-DSA.URC_CaptureUnits fvt-id emma-triplet)]))
                (TS02-C3.AQP-DSA|C_SetOracleAuth patron patron fvt-id (read-keyset "dsa-oracle"))
                ;;ANHD holds 10,000,000 q = 500 units of capacity but is capped by nodes=2.
                ;;EMMA holds 20,000 q = 1 unit and runs 1 node. So the CAP binds for ANHD and
                ;;the STAKE binds for EMMA -- both sides of min(floor(Q/unit), nodes) exercised.
                (TS02-C3.AQP-DSA|C_OracleWrite patron fvt-id anhd-triplet 2 1000)
                (TS02-C3.AQP-DSA|C_OracleWrite patron fvt-id emma-triplet 1 1000)
                (print (format "<(capture after oracle)> anhd={} emma={}"
                    [(AQP-DSA.URC_CaptureUnits fvt-id anhd-triplet)
                     (AQP-DSA.URC_CaptureUnits fvt-id emma-triplet)]))
                ;;==== TX-BOOT-15-DSA · 04 · inject, then both operators collect ====
                (print "--- [TX-BOOT-15-DSA · 04 · inject and collect] ---")
                (let
                    (
                        (ouro:string "OURO-98c486052a51")
                        (auryn:string (ref-DALOS::UR_AurynID))
                        (elite:string (ref-DALOS::UR_EliteAurynID))
                    )
                    ;;==== TX-BOOT-15-DSA · 03b · THE OG ANCHOR: nonce 4 = 1000 golden + 5% on ALL ====
                    ;;The end functionality being proven, in one place: staking Custodians nonce 4
                    ;;must (a) add 1000 quintessence of the GOLDEN type and (b) boost the user's
                    ;;bronze, silver AND golden scores by 5%. Nothing extra is defined for this --
                    ;;ONE anchor in ONE boost class, with all three scores linked to that class by
                    ;;the MODEL. Three anchors are NOT needed: a boost class aggregates the promile
                    ;;of every anchor in it, and a score linked to the class picks up that
                    ;;aggregate, so one anchor reaches all three scores.
                    (print "--- [TX-BOOT-15-DSA · 03b · OG anchor] ---")
                    (let
                        (
                            (og-class:string (ref-U|DALOS::UDC_Makeid "CustodiansOgBoost"))
                            (q-before:decimal (AQP-DSA.URC_AgencyQuintessence emma-triplet))
                        )
                        (print (format "<(EMMA promile BEFORE nonce-4 stake)> => {}"
                            [(AQP-ANK.UR_UB|AggregatePromile KST.EMMA og-class)]))
                        ;;ONE unit, so the assertion below pins the CONFIGURED rate exactly:
                        ;;BOOT|CUSTODIANS_OG_PROMILE = 50.0 promile = 5%. Staking two gave 100.0
                        ;;(10%) on an earlier run -- SF anchor promile is
                        ;;`conform-amount x ank-promile` (01_ANK.pact URC_SemiFungibleAnchorPromile),
                        ;;i.e. it SCALES PER UNIT HELD and is not a flat per-holder grant.
                        (TS02-C1.DPSF|C_TransferNonce patron patron KST.EMMA dhoc-id 4 1 false)
                        (print (format "<(EMMA stakes 1x nonce 4)> => \"{}\""
                            [(TS02-C3.AQP-POOL|CC_StakeSemiFungibleCollectable KST.EMMA pool-id KST.EMMA KST.EMMA dhoc-id [4])]))
                        (print (format "<(EMMA promile AFTER)> => {}   <(q before)> => {}   <(q after)> => {}"
                            [(AQP-ANK.UR_UB|AggregatePromile KST.EMMA og-class)
                             q-before
                             (AQP-DSA.URC_AgencyQuintessence emma-triplet)]))
                        (print (format "<(EMMA boosted scores)> bronze={} silver={} golden={}"
                            [(AQP-SCORE.UR_U-SCR|UserScoreBoostedScore KST.EMMA pool-id eb)
                             (AQP-SCORE.UR_U-SCR|UserScoreBoostedScore KST.EMMA pool-id es)
                             (AQP-SCORE.UR_U-SCR|UserScoreBoostedScore KST.EMMA pool-id eg)]))
                        (print (format "<(EMMA base scores)> bronze={} silver={} golden={}"
                            [(AQP-SCORE.UR_U-SCR|UserScoreBaseScore KST.EMMA pool-id eb)
                             (AQP-SCORE.UR_U-SCR|UserScoreBaseScore KST.EMMA pool-id es)
                             (AQP-SCORE.UR_U-SCR|UserScoreBaseScore KST.EMMA pool-id eg)]))
                        (map print
                            [
                            ;;The end functionality, asserted rather than eyeballed. EMMA never
                            ;;called C_CreateScoreBoostClassLink -- she opened through the PUBLIC
                            ;;path. The boost reaches her scores because the VAULT's model carries
                            ;;the class, which is the whole point of the 2026-09-19 change.
                            (expect "<<TX-BOOT-OG1>> staking ONE nonce 4 grants exactly 5% (50 promile)"
                                50.0 (AQP-ANK.UR_UB|AggregatePromile KST.EMMA og-class))
                            (expect "<<TX-BOOT-OG2>> nonce 4 also adds 1000 GOLDEN quintessence"
                                1000.0 (- (AQP-DSA.URC_AgencyQuintessence emma-triplet) q-before))
                            ;;5% of the 20000 bronze base -- proving the boost reaches a lane the
                            ;;anchored nonce does not itself score into.
                            (expect "<<TX-BOOT-OG3>> the BRONZE score is boosted 5%, from an anchor on a GOLDEN nonce"
                                1000.0 (AQP-SCORE.UR_U-SCR|UserScoreBoostedScore KST.EMMA pool-id eb))
                            ]
                        )
                    )
                    ;;==== TX-BOOT-15-DSA · 03c · ONE anchor, TWO different triplets ====
                    ;;THE QUESTION: with N agencies each holding its OWN triplet id, does a single
                    ;;anchor definition reach all of them, or does each agency need its own?
                    ;;
                    ;;EMMA's boost above landed on HER triplet. ANHD runs a DIFFERENT agency with a
                    ;;DIFFERENT triplet id and different score ids. If one anchor serves both, the
                    ;;same nonce-4 stake must boost his scores too -- with no second anchor, no
                    ;;second boost class, and nothing defined per agency.
                    (print "--- [TX-BOOT-15-DSA · 03c · one anchor, two triplets] ---")
                    (let
                        (
                            (og-class:string (ref-U|DALOS::UDC_Makeid "CustodiansOgBoost"))
                            (ag:string (ref-U|DALOS::UDC_Makeid "OuronetPrimeGolden"))
                            (ab:string (ref-U|DALOS::UDC_Makeid "OuronetPrimeBronze"))
                        )
                        (print (format "<(ANHD promile BEFORE)> => {}"
                            [(AQP-ANK.UR_UB|AggregatePromile patron og-class)]))
                        (print (format "<(ANHD stakes 1x nonce 4)> => \"{}\""
                            [(TS02-C3.AQP-POOL|CC_StakeSemiFungibleCollectable patron pool-id patron patron dhoc-id [4])]))
                        (map print
                            [
                            ;;ANSWERED: ONE anchor definition reaches EVERY agency. ANHD's triplet
                            ;;is a different id with different score ids from EMMA's, and neither
                            ;;the anchor nor the boost class was touched between them. No per-agency
                            ;;anchor, no per-triplet class -- the link rides on the vault's MODEL,
                            ;;so every score any agency ever mints carries it.
                            ;;
                            ;;5200 rather than 50 is CORRECT AND INTENDED. SF anchor promile is
                            ;;`units x ank-promile` (01_ANK.pact URC_SemiFungibleAnchorPromile), and
                            ;;more units SHOULD mean more boost -- that is what an anchor is for.
                            ;;There is deliberately no per-user cap. ANHD holds 104 OG SFTs because
                            ;;he holds the whole collection in this fixture; in practice a holder
                            ;;has 2 or 3, i.e. 10-15%. Pinned at the real number so a change in the
                            ;;promile MODEL shows up here as a failure rather than as drift.
                            (expect "<<TX-BOOT-OG4>> the SAME anchor reaches a SECOND agency's triplet -- no per-agency definition"
                                5200.0 (AQP-ANK.UR_UB|AggregatePromile patron og-class))
                            (expect "<<TX-BOOT-OG5>> ...boost = units x promile, UNCAPPED: 104 OG SFTs = 520% of base"
                                52540800.0 (AQP-SCORE.UR_U-SCR|UserScoreBoostedScore patron pool-id ag))
                            ]
                        )
                        (print (format "<(ANHD boosted)> golden={} bronze={}   <(EMMA boosted bronze)> => {}"
                            [(AQP-SCORE.UR_U-SCR|UserScoreBoostedScore patron pool-id ag)
                             (AQP-SCORE.UR_U-SCR|UserScoreBoostedScore patron pool-id ab)
                             (AQP-SCORE.UR_U-SCR|UserScoreBoostedScore KST.EMMA pool-id eb)]))
                    )
                    ;;==== TX-BOOT-15-DSA · 03d · the boost class is now OWNED ====
                    ;;THE HOLE THIS CLOSES. Issuing an anchor is gated on CAP_OwnerOrCreator of the
                    ;;ANCHORED ASSET -- but when attaching to an EXISTING class that is the
                    ;;attacker's OWN asset, so it gated nothing about the class being joined. A
                    ;;BoostClass had no owner field at all, so anyone holding any anchorable asset
                    ;;could attach it to CustodiansOgBoost and hand THEIR holders a boost inside
                    ;;THIS vault's scoring. Seven slots, one used: six free grants.
                    ;;
                    ;;EMMA owns a DPSF collection of her own here, so she is a realistic attacker
                    ;;rather than a strawman: the only thing that stops her is the new owner check.
                    (print "--- [TX-BOOT-15-DSA · 03d · boost class ownership] ---")
                    (env-sigs [])
                    (map print
                        [
                        (expect "<<TX-BOOT-OG6>> the OG boost class records ANHD as its owner"
                            patron (at "class-owner" (AQP-ANK.UR_BC|Data (ref-U|DALOS::UDC_Makeid "CustodiansOgBoost"))))
                        ;;OG7 probes UEV_IssueAnchor DIRECTLY rather than through
                        ;;C_IssueSemiFungibleAnchor, and that is deliberate. Going through the
                        ;;client would reach CAP_OwnerOrCreator(dhoc) FIRST -- EMMA does not own the
                        ;;Custodians collection, so she would be refused by the OLD guard and the
                        ;;test would prove nothing about the new one. Two guards that both refuse
                        ;;her are indistinguishable from the outside.
                        ;;
                        ;;UEV_IssueAnchor is unprotected and carries ONLY the class checks, so
                        ;;calling it isolates the ownership enforce added on 2026-09-19. The class
                        ;;is owned by ANHD; this runs where ANHD has not signed, so it must refuse.
                        ;;A first attempt at this test PASSED FOR THE WRONG REASON TWICE -- once
                        ;;dying in coin.TRANSFER before reaching any guard, once SUCCEEDING because
                        ;;ANHD's key happened to be in env-sigs for the enclosing transaction.
                        ;;The message names the CLASS OWNER's keyset (PK_AncientHodler), which is
                        ;;what makes this specific: it is ANHD's guard being demanded, not a generic
                        ;;refusal. That string is the evidence the right enforce fired.
                        (expect-failure "<<TX-BOOT-OG7>> attaching to a boost class you do not own is refused"
                            "Keyset failure (keys-all): [PK_Ancie"
                            (AQP-ANK.UEV_IssueAnchor dhoc-id (ref-U|DALOS::UDC_Makeid "CustodiansOgBoost")))
                        ]
                    )
                    ;;ANHD back in scope for the inject/collect below.
                    (env-sigs [{ "key": "PK_AncientHodler", "caps": [] } { "key": "PK_Emma", "caps": [] }])
                    ;;DIAGNOSTIC: the triplet LANES, which is what the quality split actually
                    ;;routes on. Printed before the inject so the payout can be read against them.
                    (print (format "<(lanes ANHD)> => {}"
                        [(RPS.URC_ComputeTripletLanes patron pool-id anhd-triplet)]))
                    (print (format "<(lanes EMMA)> => {}"
                        [(RPS.URC_ComputeTripletLanes KST.EMMA pool-id emma-triplet)]))
                    (print (format "<(inject 3000 OURO)> => \"{}\""
                        [(TS02-C3.AQP-FVT|CC_Inject patron patron fvt-id ouro 3000.0)]))
                    (let
                        (
                            (a0:decimal (DPTF.UR_AccountSupply ouro patron))
                            (e0:decimal (DPTF.UR_AccountSupply ouro KST.EMMA))
                            (a0a:decimal (DPTF.UR_AccountSupply auryn patron))
                            (e0a:decimal (DPTF.UR_AccountSupply auryn KST.EMMA))
                            (a0e:decimal (DPTF.UR_AccountSupply elite patron))
                            (e0e:decimal (DPTF.UR_AccountSupply elite KST.EMMA))
                        )
                        (print (format "<(ANHD collect)> => \"{}\""
                            [(TS02-C3.AQP-FVT|CC_Collect patron patron fvt-id 3 anhd-triplet ouro)]))
                        (print (format "<(EMMA collect)> => \"{}\""
                            [(TS02-C3.AQP-FVT|CC_Collect KST.EMMA KST.EMMA fvt-id 3 emma-triplet ouro)]))
                        (print (format "<(ANHD gained)> ouro={} auryn={} elite={}"
                            [(- (DPTF.UR_AccountSupply ouro patron) a0)
                             (- (DPTF.UR_AccountSupply auryn patron) a0a)
                             (- (DPTF.UR_AccountSupply elite patron) a0e)]))
                        (print (format "<(EMMA gained)> ouro={} auryn={} elite={}"
                            [(- (DPTF.UR_AccountSupply ouro KST.EMMA) e0)
                             (- (DPTF.UR_AccountSupply auryn KST.EMMA) e0a)
                             (- (DPTF.UR_AccountSupply elite KST.EMMA) e0e)]))
                    )
                )
            )
        )
    )
)
;;ROLLED BACK, not committed. Everything above is an ECONOMIC EXPERIMENT -- a second agency,
;;an oracle write, a 3000 OURO inject and two collects -- and its whole purpose is to answer
;;"does this pay?", not to seed state. Committing it changed the chain for every suite that
;;loads this file: Kursan/dsa-grand-tour.repl's GT-09 royalty probe, which expects disposal to
;;fail with "dispo capabilities exceeded!" because its vault never funded custody, started
;;SUCCEEDING -- the inject here had funded the shared custody it draws from. That is a real
;;property worth knowing (royalty disposal is not isolated per vault), and it is exactly why an
;;experiment of this size must not persist. Steps 13/14 in TX-BOOT-1314 above DO commit: they
;;are the vault itself, which downstream suites are entitled to see.
(rollback-tx)
(env-sigs [])

(begin-tx "TX-BOOT-S2GAS - the Stage Two daily emission, and what it costs")
(print "")
(print "=== TX-BOOT-S2GAS — AA_OuroMinterStageTwo gas =================================")
(namespace "ouronet-ns")
(env-gasmodel "table")(env-gaslimit 150000000)(env-gas 0)
;;ADDED 2026-09-20. The question that opened this whole line of work was "how much does the Stage
;;Two emission cost, and does it fit?" -- and it could not be answered until three things landed:
;;DSP moved to Stage 2 (it referenced TS02-C3 and would not compile in Stage 1), Band 3 gave inject
;;a named executor (so the dispenser can hold the emission while the gasless patron pays), and the
;;Custodians vault existed to inject into.
;;
;;MEASURED: ~966k gas, about 48% of a 2M block, against Stage One's ~135k. Seven times the cost,
;;and half a block for ONE transaction.
;;
;;THE ASSERTION IS A BAND, NOT A NUMBER, and deliberately so. Four of the six legs are CC_Inject,
;;the HEAVY enforced-fresh variant: each scans the FVT's present users and fixes every stale one, so
;;the cost scales with STAKER COUNT. This fixture has a handful. The figure here is a FLOOR, not a
;;ceiling, and on a busy chain this transaction does not fit -- which is what the AA_ prefix says
;;and why MTX|n|C_Inject exists as the documented spike fallback.
;;   upper bound  fits one block at all
;;   lower bound  catches a regression that silently SKIPS legs -- a cheaper emission is a broken
;;                one, and without a floor that reads as an improvement
(env-sigs
    [   { "key": "PK_AOZ", "caps": [] }
        { "key": "PK_AncientHodler", "caps": [] }
        { "key": "PK_DSP", "caps": [] }
    ])
(let
    (
        (ref-U|DALOS:module{UtilityDalosV2} U|DALOS)
    )
    (env-gas 0)
    (print (format "<(AA_OuroMinterStageTwo)> => {}"
        [(DSP.AA_OuroMinterStageTwo
            [(ref-U|DALOS::UDC_Makeid "CustodiansVault")
             (ref-U|DALOS::UDC_Makeid "CompanySharesTreasury")
             (ref-U|DALOS::UDC_Makeid "OuroLpFarm")
             (ref-U|DALOS::UDC_Makeid "SubsidiaryTreasury")])]))
    (let ((g:integer (env-gas)))
        (print (format ">>>>>>> STAGE TWO EMISSION COSTS {} GAS <<<<<<<" [g]))
        (map print
            [
            (expect "<<TX-BOOT-S2GAS>> the Stage Two emission fits inside one 2M block"
                true (< g 2000000))
            (expect "<<TX-BOOT-S2GAS>> ...and it is NOT suspiciously cheap (all six legs ran)"
                true (> g 500000))
            ]
        )
    )
    ""
)
(rollback-tx)
(env-sigs [])

(begin-tx "TX-BOOT-13-SPLIT - dual reward-split ECONOMIC flip on OuroLpFarm (task #89 / D1-G2)")
(print "")
(print "=== TX-BOOT-13-SPLIT — the SAME member's W_i flips STAKED<->TVL on the real LP farm ==")
(namespace "ouronet-ns")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
;;==== TX-BOOT-13-SPLIT - dual reward-split ECONOMIC flip on OuroLpFarm (task #89 / D1-G2) · 01 · env-sigs (caps) ==== 
(print "--- [TX-BOOT-13-SPLIT - dual reward-split ECONOMIC flip on OuroLpFarm (task #89 / D1-G2) · 01 · env-sigs (caps)] ---")
(env-sigs [{ "key": "PK_AncientHodler", "caps": [] }])
;; The OuroLpFarm has a live LP triplet member (Step11) on a seeded swpair (Step08b, StoaValue > 0).
;; URC_MemberLevel2Weight is the mode-aware Level-2 W_i: SPLIT|STAKED => member staked value;
;; SPLIT|TVL => whole-pool TVL. Proven here on ONE real member: the weight changes with the mode,
;; TVL mode == UR_StoaValue, and restoring STAKED returns the staked weight (switch re-weights only
;; future injects). let* binds run in order, so the two C_SetSplitMode writes sequence the reads.
(let*
    (
        (patron:string KST.ANHD)
        (ref-U|DALOS:module{UtilityDalosV2} U|DALOS)
        (ref-FVT:module{AcquisitionFarmsVaultsTreasuriesV1} AQP-FVT)
        (ref-SWP:module{SwapperV4} SWP)
        (ref-TS02-C3:module{TalosStageTwo_ClientThreeV1} TS02-C3)
        (farm-id:string (ref-U|DALOS::UDC_Makeid "OuroLpFarm"))
        (members:[string] (ref-FVT::URH_FvtEnabledScoreEntityIdsForFvt farm-id))
        (m:string (at 0 members))
        (mtype:integer (ref-FVT::UR_FVT-SEL|ScoreEntityType farm-id m))
        (swp:string (ref-FVT::UR_FVT-SEL|Swpair farm-id m))
        (tvl:decimal (ref-SWP::UR_StoaValue swp))
        ;; default mode (SPLIT|STAKED) — member staked value
        (w-staked:decimal (ref-FVT::URC_MemberLevel2Weight farm-id mtype m swp))
        ;; flip to SPLIT|TVL — whole-pool TVL
        (set-tvl:string (ref-TS02-C3::AQP-FVT|C_SetSplitMode patron (AQP-FVT.UR_FVT|OwnerKonto farm-id) farm-id "SPLIT|TVL"))
        (w-tvl:decimal (ref-FVT::URC_MemberLevel2Weight farm-id mtype m swp))
        ;; restore SPLIT|STAKED
        (set-staked:string (ref-TS02-C3::AQP-FVT|C_SetSplitMode patron (AQP-FVT.UR_FVT|OwnerKonto farm-id) farm-id "SPLIT|STAKED"))
        (w-restored:decimal (ref-FVT::URC_MemberLevel2Weight farm-id mtype m swp))
    )
    (map print
        [
            (format "<(farm member)> => {} type={} swpair={}" [m mtype swp])
            (format "<(URC_MemberLevel2Weight)> STAKED={} TVL={} (StoaValue={})" [w-staked w-tvl tvl])
            (expect
                (format "<<TX-BOOT-13-SPLIT>> seeded swpair TVL > 0 got={}" [tvl]) true (> tvl 0.0))
            (expect
                (format "<<TX-BOOT-13-SPLIT>> SPLIT|TVL W_i == whole-pool TVL got={} expected={}" [w-tvl tvl]) tvl w-tvl)
            (expect
                (format "<<TX-BOOT-13-SPLIT>> SAME member W_i differs by mode (STAKED {} != TVL {})" [w-staked w-tvl]) true (!= w-staked w-tvl))
            (expect
                (format "<<TX-BOOT-13-SPLIT>> restoring SPLIT|STAKED returns the staked W_i got={} expected={}" [w-restored w-staked]) w-staked w-restored)
        ]
    )
)
(env-sigs [])
(commit-tx)
;;||>>>>>>>>>>>>>>>>>>>>>>>>>
;;|| NEXT                   >
;;||>>>>>>>>>>>>>>>>>>>>>>>>>
(print "")
(print "=== END TX-BOOT-13-SPLIT ==================================================")
(print "")
(print "=== END [6.2.9]_AQP-BOOT-FULL.repl =========================================")
(print "")
;;
(begin-tx "TX-BOOT-G1 - the AddScoreEntity context validators, probed against the boot fixture")
(print "")
(print "=== TX-BOOT-G1 — UEV_AddScoreEntity{Score,Triplet}Context ======================")
(namespace "ouronet-ns")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
;;==== TX-BOOT-G1 · 01 · admission guards ==== ====================================================
(print "--- [TX-BOOT-G1 · 01 · admission guards] ---")
;;P3.3. These two validators carry ten guards between them and were the largest unpinned cluster
;;in the suite. They are only reachable where a FARM (class 0), a TREASURY (class 1) and a real
;;TRIPLET all exist at once -- which is here, and nowhere else. That is the whole reason this
;;block lives in the boot suite rather than in modules/AQP.repl: the fixture already exists, so
;;the guards cost nothing beyond asking.
;;
;;What is reachable, and what is not, is stated explicitly below rather than left as silence.
;;==== TX-BOOT-G1 - the AddScoreEntity context validators, probed against the boot fixture · 01 · env-sigs (caps) ==== 
(print "--- [TX-BOOT-G1 - the AddScoreEntity context validators, probed against the boot fixture · 01 · env-sigs (caps)] ---")
(env-sigs [{ "key": "PK_AncientHodler", "caps": [] }])
;;==== TX-BOOT-G1 - the AddScoreEntity context validators, probed against the boot fixture · 02 · let / invocation ==== 
(print "--- [TX-BOOT-G1 - the AddScoreEntity context validators, probed against the boot fixture · 02 · let / invocation] ---")
(let
    (
        (ref-U|DALOS:module{UtilityDalosV2} U|DALOS)
        (ref-RPS:module{AcquisitionRewardPerShareV1} RPS)
        (ref-SCR:module{AcquisitionScoresV1} AQP-SCORE)
    )
    (let
        (
            (farm:string     (ref-U|DALOS::UDC_Makeid "OuroLpFarm"))
            (treasury:string (ref-U|DALOS::UDC_Makeid "CodingDivisionTreasury"))
            (silver:string   (ref-U|DALOS::UDC_Makeid "SilverSnakePower"))
            (triplet:string
                (concat ["T" "|" (ref-U|DALOS::UDC_Makeid "BronzeSnakePower")
                             "|" (ref-U|DALOS::UDC_Makeid "SilverSnakePower")
                             "|" (ref-U|DALOS::UDC_Makeid "GoldenSnakePower")]))
        )
        (map print
            [
                ;;PRECONDITIONS, asserted. Every rejection below depends on the farm being class
                ;;0, the treasury class 1 and the triplet categorised LP; if any of those were
                ;;wrong the tests would still fail, just for a different reason, and would read
                ;;as passes.
                (expect "<<TX-BOOT-G1>> OuroLpFarm is a class-0 FARM"
                    0 (ref-RPS::UR_FVT|FvtClass farm))
                ;;class 2 = TREASURY. CORRECTED 2026-09-19 with the admission-rule fix: this
                ;;read 1 because Step8 issued the four Treasury-named entities at fvt-class 1,
                ;;which only worked because the rule was inverted (vault admitted SF/NF).
                (expect "<<TX-BOOT-G1>> CodingDivisionTreasury is a class-2 TREASURY"
                    2 (ref-RPS::UR_FVT|FvtClass treasury))
                (expect "<<TX-BOOT-G1>> the boot triplet exists and is categorised LP"
                    ["LP" true]
                    [(ref-SCR::UR_SCR|TripletCategory triplet) (ref-SCR::URC_TripletExists triplet)])
                ;;--- CATEGORY vs CLASS. An LP triplet belongs to a farm, not to a treasury, and
                ;;this is the guard that says so. It is the ONLY one of the triplet family whose
                ;;rejecting input is a straight mismatch between two live rows.
                (expect-failure "<<TX-BOOT-G1>> an LP triplet cannot be admitted to a class-1 treasury"
                    "Triplet category must match FVT class"
                    (AQP-FVT.UEV_AddScoreEntityTripletContext treasury triplet "|" 0.0))
                ;;--- ALREADY ADMITTED. Step11 wired this triplet to this farm, so asking again
                ;;must be refused -- re-admission would double-count the triplet's weight in the
                ;;farm's reward share, which is the whole reason the row-exists check is in the
                ;;fold rather than left to an insert collision.
                (expect-failure "<<TX-BOOT-G1>> ...and the triplet already wired to the farm cannot be re-admitted"
                    "Invalid AddScoreEntity triplet: row exists, links, or swpair mismatch"
                    (AQP-FVT.UEV_AddScoreEntityTripletContext farm triplet "OURO-98c486052a51" 1.0))
                ;;--- the SCORE twin of the same rule. SilverSnakePower is already linked to an
                ;;FVT, so its fvt-link is not BAR and the fold refuses it.
                (expect-failure "<<TX-BOOT-G1>> a score already linked to an FVT cannot be admitted again"
                    "Invalid AddScoreEntity score: row exists, links, class, or swpair mismatch"
                    (AQP-FVT.UEV_AddScoreEntityScoreContext farm silver "OURO-98c486052a51" 1.0))
                ;;--- FINDING: the unlinked-to-pool case never reaches its own guard.
                ;;
                ;;The fold in UEV_AddScoreEntityScoreContext contains (!= aqpool-link BAR) -- a
                ;;score that belongs to no pool should be refused with the named message. It
                ;;never is. The `let` above the enforce binds
                ;;    expected-swpair = (URC_ResolveScoreEntitySwpair …)
                ;;which HARD-READS the pool table using that same aqpool-link, so a score whose
                ;;link is BAR aborts on a raw table miss for key "|" before any enforce runs.
                ;;
                ;;Same shape as the PYTHIA degradation recorded at [6.10]_PYTHIA <<TX007e-03>>:
                ;;the guard is live for its real case and unhelpful for the case a caller is most
                ;;likely to hit. Pinned AS IT BEHAVES, so that fixing it (bind the swpair lazily,
                ;;or hoist the link check above the let) has to update this line deliberately.
                ;;REPOINTED 2026-09-19. This used the `Bloodshed` score precisely BECAUSE it was
                ;;pool-less -- which it only was through a fixture bug: this file hand-rolled
                ;;C_Step7 and omitted the Bloodshed->DHBloodshed link that C_Step7 makes. With
                ;;that fixed, every created score is employed, so the probe needs an id that was
                ;;never created at all. That is a better premise anyway: it depends on a score
                ;;being absent by construction rather than on another block's omission.
                (expect-failure "<<TX-BOOT-G1>> FINDING: a pool-less score aborts in a table read, not its own guard"
                    "No value found in table"
                    (AQP-FVT.UEV_AddScoreEntityScoreContext
                        farm (ref-U|DALOS::UDC_Makeid "NeverIssuedProbeScore") "OURO-98c486052a51" 1.0))
                ;;--- NOT PINNED, recorded rather than left silent:
                ;;  "Score owner must match FVT owner" / "...Non-mosaic FVT locked to score
                ;;      membership only" — every FVT in this suite is mosaic and owned by the same
                ;;      konto, so neither has a reachable state here.
                ;;  "Non-mosaic FVT membership mode mismatch for triplet admission" — needs a
                ;;      NON-mosaic FVT and a real triplet in the SAME suite. modules/AQP.repl has
                ;;      the first (TfMosaicVault, mode SCORE) and no triplet; this suite has the
                ;;      triplet and no non-mosaic FVT. One C_IssueFvt with mosaic=false here would
                ;;      close it.
                ;;  "Farm score/triplet: lp-denominator and ghost weight required" and the
                ;;      vault/treasury twin — these sit BELOW the fold, so reaching them needs an
                ;;      entity that passes it: unlinked, pool-attached, class-matched. No such
                ;;      score exists in any suite; it needs a freshly issued one.
            ]
        )
        ""
    )
)
(env-sigs [])
(print "")
(print "===^^^===")
(commit-tx)
;;||>>>>>>>>>>>>>>>>>>>>>>>>>
;;|| NEXT                   >
;;||>>>>>>>>>>>>>>>>>>>>>>>>>
(print "")
(print "")
;;
(begin-tx "TX-BOOT-G2 - UEV_SetCommonDenominatorContext, which needs the class-0 FARM")
(print "")
(print "=== TX-BOOT-G2 — common-denominator guards on OuroLpFarm ======================")
(namespace "ouronet-ns")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
;;==== TX-BOOT-G2 · 01 · common denominator ==== ==================================================
(print "--- [TX-BOOT-G2 · 01 · common denominator] ---")
;;Both guards sit behind "SetCommonDenominator applies to farm (class 0) FVT only", and OuroLpFarm
;;is the only class-0 farm in any suite — so this block lives here for the same reason TX-BOOT-G1
;;does: the fixture exists here and nowhere else.
;;
;;The two guards are ordered, and the order is the point. The IMMUTABILITY check runs first: once
;;score entities are linked, the denominator is frozen, because every linked score's weight is
;;expressed in it and re-denominating would silently restate all of them. Only if no links exist
;;does the shape check get to object to the id itself.
;;
;;OuroLpFarm has linked entities (TX-BOOT-11 wired its triplet), so BOTH inputs below trip the
;;immutability guard — a valid-looking denominator and a BAR one alike. That is asserted rather
;;than assumed, and it is why the shape guard is recorded as unreachable here instead of claimed.
;;==== TX-BOOT-G2 - UEV_SetCommonDenominatorContext, which needs the class-0 FARM · 01 · env-sigs (caps) ==== 
(print "--- [TX-BOOT-G2 - UEV_SetCommonDenominatorContext, which needs the class-0 FARM · 01 · env-sigs (caps)] ---")
(env-sigs [{ "key": "PK_AncientHodler", "caps": [] }])
;;==== TX-BOOT-G2 - UEV_SetCommonDenominatorContext, which needs the class-0 FARM · 02 · let / invocation ==== 
(print "--- [TX-BOOT-G2 - UEV_SetCommonDenominatorContext, which needs the class-0 FARM · 02 · let / invocation] ---")
(let
    (
        (ref-U|DALOS:module{UtilityDalosV2} U|DALOS)
        (ref-RPS:module{AcquisitionRewardPerShareV1} RPS)
    )
    (let
        (
            (farm:string (ref-U|DALOS::UDC_Makeid "OuroLpFarm"))
        )
        (map print
            [
                (expect "<<TX-BOOT-G2>> OuroLpFarm is the class-0 farm"
                    0 (ref-RPS::UR_FVT|FvtClass farm))
                (expect "<<TX-BOOT-G2>> ...and it already carries linked score entities"
                    true (> (ref-RPS::UR_FVT|MemberLinkCount farm) 0))
                (expect-failure "<<TX-BOOT-G2>> re-denominating a farm that has linked entities is refused"
                    "Cannot change common-denominator after ScoreEntityLink rows exist"
                    (AQP-FVT.UEV_SetCommonDenominatorContext farm "OURO-98c486052a51"))
                ;;same guard answers for a malformed id too, because it runs FIRST
                (expect-failure "<<TX-BOOT-G2>> ...and the same guard answers even for a malformed id"
                    "Cannot change common-denominator after ScoreEntityLink rows exist"
                    (AQP-FVT.UEV_SetCommonDenominatorContext farm "|"))
            ]
        )
        ""
    )
)
;;NOT PINNED: "common-denominator must be a full native DPTF id" needs a class-0 farm with ZERO
;;linked entities. OuroLpFarm is the only farm and it is linked, so the immutability guard above
;;always answers first. Issuing a second, unlinked farm would close it.
(env-sigs [])
(print "")
(print "===^^^===")
(commit-tx)

;;||>>>>>>>>>>>>>>>>>>>>>>>>>
;;|| NEXT                   >
;;||>>>>>>>>>>>>>>>>>>>>>>>>>
(print "")
(begin-tx "TX-BOOT-GV - C_IssueGenericEarningVault, one-call vault, proven then rolled back")
(print "")
(print "=== TX-BOOT-GV — generic earning vault (stake TF, earn TF) ======================")
(namespace "ouronet-ns")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
;;ADDED 2026-09-19 with C_IssueGenericEarningVault.
;;
;;The function does in one call what a Vault needs: score (class 1), pool (aqp-class 1), pool-score
;;link, FVT (fvt-class 1), score admission, reward link. Six operations, four class constants, and
;;every one of them silent to get wrong -- which is the whole reason it exists.
;;
;;Rolled back: it mints three entities and this suite's later blocks must not see them.
(let
    (
        (patron:string KST.ANHD)
        (split-smart:[decimal]
            (DALOS.URC_SplitSTOAPrices patron (* 6.0 (DALOS.UR_UsagePrice "smart")))
        )
    )
    (env-sigs
        [
            { "key": "PK_AncientHodler", "caps": [] }
            { "key": "6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263",
              "caps":
                [
                    (coin.TRANSFER "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263" "k:50d6c59b21e5e6e55baecaa75a1007de37576bde12d8230dc82459cc01b9484b" (at 2 split-smart))
                    (coin.TRANSFER "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263" "k:0cb30c0121ff919266121a99ff9359871818932211df94dae4137c29bc0e8f7e" (at 0 split-smart))
                    (coin.TRANSFER "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263" "c:XM-pkmuB5XUQlp87ZYSbfKt8qzmHY6O2EHAzMRVBt3k" (at 3 split-smart))
                    (coin.TRANSFER "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263" "c:iQQFWj6gWtpGEzhM_O5ekW1QtnQQy55R8BRPGhj_0FU" (at 1 split-smart))
                ]
            }
        ]
    )
    (map print
        [
        ;;GV1 drives the TALOS entrypoint -- the one Deploy/3_Assets/13 actually sends, and the
        ;;one a user would call. GV2 drives the AQP-BOOT delegate, so the forwarding path cannot
        ;;rot unnoticed. Two vaults, two names: the three entities each mints share a branding
        ;;table, so reusing a name would collide on the second insert.
        (expect
            "<<AQP-BOOT-GV1>> TS02-C3 AQP-FVT|C_IssueGenericEarningVault completes in one call"
            true
            (!= "" (TS02-C3.AQP-FVT|C_IssueGenericEarningVault
                        KST.ANHD KST.ANHD "TestVault"
                        "OURO-98c486052a51" "AURYN-98c486052a51"))
        )
        (expect
            "<<AQP-BOOT-GV2>> the AQP-BOOT delegate still forwards to it"
            true
            (!= "" (AQP-BOOT.C_IssueGenericEarningVault
                        KST.ANHD KST.ANHD "TestVaultB"
                        "OURO-98c486052a51" "AURYN-98c486052a51"))
        )
        ]
    )
    ""
)
(env-sigs [])
(rollback-tx)
