            [1 1 1 1]
            [(RPS.UR_FVT|EnabledRewardCount sub-treasury-id)
             (RPS.UR_FVT|EnabledRewardCount coding-treasury-id)
             (RPS.UR_FVT|EnabledRewardCount snakes-treasury-id)
             (RPS.UR_FVT|EnabledRewardCount shares-treasury-id)])
        ]
    )
)
