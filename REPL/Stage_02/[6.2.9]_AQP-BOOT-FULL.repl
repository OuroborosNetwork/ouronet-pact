(begin-tx "TX-BOOT-07b - AQP-BOOT Step7 DPNF pools (bloodshed/nosferatu/bunnies)")
(print "")
(print "=== TX-BOOT-07b — DPNF pools (ANHD patron + PK_Lumy owner guard) ===========")
(namespace "ouronet-ns")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
;;==== TX-BOOT-07b - AQP-BOOT Step7 DPNF pools (bloodshed/nosferatu/bunnies) · 01 · let / invocation ==== 
(print "--- [TX-BOOT-07b - AQP-BOOT Step7 DPNF pools (bloodshed/nosferatu/bunnies) · 01 · let / invocation] ---")
(let
    (
        (patron:string KST.ANHD)
        (ref-DALOS:module{OuronetDalosV2} DALOS)
        (ref-U|DALOS:module{UtilityDalosV2} U|DALOS)
        (ref-TS02-C3:module{TalosStageTwo_ClientThreeV1} TS02-C3)
        (split-smart:[decimal]
            (ref-DALOS::URC_SplitSTOAPrices patron (* 6.0 (ref-DALOS::UR_UsagePrice "smart")))
        )
        (pool-bloodshed:string (ref-U|DALOS::UDC_Makeid "DHBloodshed"))
        (pool-nosferatu:string (ref-U|DALOS::UDC_Makeid "DHNosferatu"))
        (pool-bunnies:string (ref-U|DALOS::UDC_Makeid "DHBunnies"))
        (score-bloodshed:string (ref-U|DALOS::UDC_Makeid "Bloodshed"))
        (score-sub-bloodshed:string (ref-U|DALOS::UDC_Makeid "SubsidiaryBloodshed"))
        (score-sub-nosferatu:string (ref-U|DALOS::UDC_Makeid "SubsidiaryNosferatu"))
        (score-sub-bunnies:string (ref-U|DALOS::UDC_Makeid "SubsidiaryBunnies"))
    )
    (env-sigs
        [
            { "key": "PK_AncientHodler", "caps": [] }
            { "key": "PK_Emma", "caps": [] }
            { "key": "PK_Lumy", "caps": [] }
            { "key": "6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263",
              "caps":
                [
                    (coin.TRANSFER "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263" "k:50d6c59b21e5e6e55baecaa75a1007de37576bde12d8230dc82459cc01b9484b" (at 2 split-smart))
                    (coin.TRANSFER "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263" "k:0cb30c0121ff919266121a99ff9359871818932211df94dae4137c29bc0e8f7e" (at 0 split-smart))
                    (coin.TRANSFER "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263" "c:XM-pkmuB5XUQlp87ZYSbfKt8qzmHY6O2EHAzMRVBt3k" (at 3 split-smart))
                    (coin.TRANSFER "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263" "c:iQQFWj6gWtpGEzhM_O5ekW1QtnQQy55R8BRPGhj_0FU" (at 1 split-smart))
                ]
            }
        ]
    )
    (ref-TS02-C3::AQP-POOL|C_Issue patron (AQP-POOL.URC_AqpOwnerKontoFromClassAndAsset 4 "DHB-98c486052a51") "DHBloodshed" "DHB-98c486052a51" 4)
    ;;BOTH Bloodshed scores, matching C_Step7 exactly. Owner ruling 2026-09-19: "bloodshed would
    ;;have two scores" and "staking bloodshed assets determines the pure bloodshed score, and we
    ;;need to be able to earn stuff via that score alone."
    ;;
    ;;This block hand-rolls what C_Step7 does and had DRIFTED from it, attaching only the
    ;;subsidiary -- so every downstream assertion ran against a DHBloodshed pool that deployment
    ;;would not produce. Restoring the line exposed the real gap it had been hiding: attaching
    ;;`Bloodshed` makes it EMPLOYED, and Step 9 admitted it to no FVT, so every stake aborted at
    ;;05_FVT.pact:1031. Fixed properly by giving it the treasury it never had -- see
    ;;BOOT|FVT_BLOODSHED_TREASURY in 04_AQP-BOOT.pact.
    (ref-TS02-C3::AQP-POOL|C_AddScore patron (AQP-POOL.URC_AqpOwnerKonto pool-bloodshed) pool-bloodshed score-bloodshed)
    (ref-TS02-C3::AQP-POOL|C_AddScore patron (AQP-POOL.URC_AqpOwnerKonto pool-bloodshed) pool-bloodshed score-sub-bloodshed)
    (ref-TS02-C3::AQP-POOL|C_Issue patron (AQP-POOL.URC_AqpOwnerKontoFromClassAndAsset 4 "DHN-98c486052a51") "DHNosferatu" "DHN-98c486052a51" 4)
    (ref-TS02-C3::AQP-POOL|C_AddScore patron (AQP-POOL.URC_AqpOwnerKonto pool-nosferatu) pool-nosferatu score-sub-nosferatu)
    (ref-TS02-C3::AQP-POOL|C_Issue patron (AQP-POOL.URC_AqpOwnerKontoFromClassAndAsset 4 "KBN-98c486052a51") "DHBunnies" "KBN-98c486052a51" 4)
    (ref-TS02-C3::AQP-POOL|C_AddScore patron (AQP-POOL.URC_AqpOwnerKonto pool-bunnies) pool-bunnies score-sub-bunnies)
    (print "AQP-BOOT Step7 DPNF pools done.")
)
(env-sigs [])
(commit-tx)
;;||>>>>>>>>>>>>>>>>>>>>>>>>>
;;|| NEXT                   >
;;||>>>>>>>>>>>>>>>>>>>>>>>>>
(print "")
(print "")
