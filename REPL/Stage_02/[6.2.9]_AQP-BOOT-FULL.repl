(print "")
(print "=== TX-BOOT-01 — Step1 BunnySet (requires KBN nonces 1+ from PopulateBunnies) =====")
(namespace "ouronet-ns")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(env-sigs
    [
        { "key": "PK_AncientHodler", "caps": [] }
        { "key": "PK_Lumy", "caps": [] }
    ]
)
(let
    (
        (patron:string KST.LUMY)
        (kbn-id:string "KBN-98c486052a51")
    )
    (print (format "<(AQP-BOOT|C_Step1_CreateBunnySet patron=LUMY)> => \"{}\"" [(AQP-BOOT.C_Step1_CreateBunnySet patron kbn-id)]))
)
(env-sigs [])
(commit-tx)
