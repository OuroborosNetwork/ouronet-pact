(begin-tx "TX-BOOT-07 - AQP-BOOT Step7 ANHD DPSF + OURO LP pools")
(print "")
(print "=== TX-BOOT-07 — ANHD pools (coding / company / wondercoach / ouro-lp) =========")
(namespace "ouronet-ns")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(let
    (
        (patron:string KST.ANHD)
        (ref-DALOS:module{OuronetDalosV1} DALOS)
        (ref-U|DALOS:module{UtilityDalosV1} U|DALOS)
        (ref-TS02-C3:module{TalosStageTwo_ClientThreeV1} TS02-C3)
        (ref-SWP:module{SwapperV3} SWP)
        (split-smart:[decimal]
            (ref-DALOS::URC_SplitKDAPrices patron (* 8.0 (ref-DALOS::UR_UsagePrice "smart")))
        )
        (swpair:string "W|DLK-98c486052a51|OURO-98c486052a51|DWK-98c486052a51")
        (ouro-lp-asset-id:string (ref-SWP::UR_TokenLP swpair))
        (pool-coding:string (ref-U|DALOS::UDC_Makeid "DHCodingDivision"))
        (pool-company:string (ref-U|DALOS::UDC_Makeid "DHCompany"))
        (pool-wondercoach:string (ref-U|DALOS::UDC_Makeid "DHWonderCoach"))
        (pool-ouro-lp:string (ref-U|DALOS::UDC_Makeid "DHOuroLp"))
        (score-coding:string (ref-U|DALOS::UDC_Makeid "TheCodingDivision"))
        (score-sub-coding:string (ref-U|DALOS::UDC_Makeid "SubsidiaryCodingDivision"))
        (score-company-share:string (ref-U|DALOS::UDC_Makeid "DemiourgosShareholder"))
        (score-company-snakes:string (ref-U|DALOS::UDC_Makeid "DemiourgosSnakes"))
        (score-sub-wondercoach:string (ref-U|DALOS::UDC_Makeid "SubsidiaryWonderCoach"))
        (score-silver:string (ref-U|DALOS::UDC_Makeid "SilverSnakePower"))
        (score-bronze:string (ref-U|DALOS::UDC_Makeid "BronzeSnakePower"))
        (score-golden:string (ref-U|DALOS::UDC_Makeid "GoldenSnakePower"))
    )
    (env-sigs
        [
            { "key": "PK_AncientHodler", "caps": [] }
            { "key": "6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263",
              "caps":
                [
                    (coin.TRANSFER "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263" "k:50d6c59b21e5e6e55baecaa75a1007de37576bde12d8230dc82459cc01b9484b" (at 2 split-smart))
                    (coin.TRANSFER "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263" "k:0cb30c0121ff919266121a99ff9359871818932211df94dae4137c29bc0e8f7e" (at 0 split-smart))
                    (coin.TRANSFER "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263" "c:XM-pkmuB5XUQlp87ZYSbfKt8qzmHY6O2EHAzMRVBt3k" (at 3 split-smart))
                    (coin.TRANSFER "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263" "c:iQQFWj6gWtpGEzhM_O5ekW1QtnQQy55R8BRPGhj_0FU" (at 1 split-smart))
                ]
            }
        ]
    )
    (print (format "<(ouro-lp-asset-id from SWP)> => \"{}\"" [ouro-lp-asset-id]))
    (ref-TS02-C3::AQP-POOL|C_Issue patron "DHCodingDivision" "DHCD-98c486052a51" 3)
    (ref-TS02-C3::AQP-POOL|C_AddScore patron pool-coding score-coding)
    (ref-TS02-C3::AQP-POOL|C_AddScore patron pool-coding score-sub-coding)
    (ref-TS02-C3::AQP-POOL|C_Issue patron "DHCompany" "E|DH-98c486052a51" 3)
    (ref-TS02-C3::AQP-POOL|C_AddScore patron pool-company score-company-share)
    (ref-TS02-C3::AQP-POOL|C_AddScore patron pool-company score-company-snakes)
    (ref-TS02-C3::AQP-POOL|C_Issue patron "DHWonderCoach" "DHWC-98c486052a51" 3)
    (ref-TS02-C3::AQP-POOL|C_AddScore patron pool-wondercoach score-sub-wondercoach)
    (let
        (
            (lp-uev-ok:bool
                (try false
                    (= ouro-lp-asset-id (ref-SWP::UR_TokenLP (ref-SWP::UR_GetLpSwpair ouro-lp-asset-id)))
                )
            )
        )
        (if lp-uev-ok
            (do
                (print (format "<(AQP-POOL|C_Issue DHOuroLp lp-id={})>" [ouro-lp-asset-id]))
                (ref-TS02-C3::AQP-POOL|C_Issue patron "DHOuroLp" ouro-lp-asset-id 0)
                (ref-TS02-C3::AQP-POOL|C_AddScore patron pool-ouro-lp score-silver)
                (ref-TS02-C3::AQP-POOL|C_AddScore patron pool-ouro-lp score-bronze)
                (ref-TS02-C3::AQP-POOL|C_AddScore patron pool-ouro-lp score-golden)
                (print "AQP-BOOT Step7 ANHD pools done (incl. DHOuroLp).")
            )
            (print (format "NOTE: DHOuroLp skipped — SWP|LP tracker roundtrip failed for {}" [ouro-lp-asset-id]))
        )
    )
)
(env-sigs [])
(commit-tx)
(print "")
