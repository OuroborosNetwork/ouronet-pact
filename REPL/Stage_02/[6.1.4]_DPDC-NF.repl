;;
;; REPL/Stage_02/[6.1.4]_DPDC-NF.repl — DPNF (NFT) client-op coverage (#79 Phase 1b)
;;   Canonical integration layout (OuronetInformational/ARCHITECTURE/REPL_AND_TESTS.md).
;;   Mints a fresh NFT collection (owner ANHD, creator EMMA) then exercises the DPNF
;;   client wrappers that had no coverage. Batch 1: owner/creator-level ops (toggles,
;;   role moves, nonce updates, branding). Sets/fragments/wipes/transfers = later batches.
;;
(print "")
(print "================================================================")
(print "FILE  REPL/Stage_02/[6.1.4]_DPDC-NF.repl  (DPNF NFT coverage)")
(print "================================================================")
(print "")

;;================================================================================
(begin-tx "TX-NF-001 - Issue fresh NFT (owner ANHD, creator EMMA) + create 8 nonces")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(namespace "ouronet-ns")
;;==== TX-NF-001 · 01 · env-sigs (STOA fee caps) ====
(print "--- [TX-NF-001 · 01 · env-sigs] ---")
(let
    (
        (ref-DALOS:module{OuronetDalosV2} DALOS)
        (owner:string KST.ANHD)
        (dpnf-price:decimal (ref-DALOS::UR_UsagePrice "dpnf"))
        (split-dpnf:[decimal] (ref-DALOS::URC_SplitSTOAPrices owner dpnf-price))
        (t0:decimal (at 0 split-dpnf))
        (t1:decimal (at 1 split-dpnf))
        (t2:decimal (at 2 split-dpnf))
        (t3:decimal (at 3 split-dpnf))
    )
    (env-sigs
        [
            { "key": "PK_AncientHodler", "caps": [] }
            { "key": "6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263",
              "caps":
                [
                    (coin.TRANSFER "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263"
                        "k:50d6c59b21e5e6e55baecaa75a1007de37576bde12d8230dc82459cc01b9484b" t2)
                    (coin.TRANSFER "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263"
                        "k:0cb30c0121ff919266121a99ff9359871818932211df94dae4137c29bc0e8f7e" t0)
                    (coin.TRANSFER "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263"
                        "c:XM-pkmuB5XUQlp87ZYSbfKt8qzmHY6O2EHAzMRVBt3k" t3)
                    (coin.TRANSFER "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263"
                        "c:iQQFWj6gWtpGEzhM_O5ekW1QtnQQy55R8BRPGhj_0FU" t1)
                ]
            }
        ]
    )
)
;;==== TX-NF-001 · 02 · issue + create native nonces ====
(print "--- [TX-NF-001 · 02 · issue + create] ---")
(let
    (
        (ref-DPDC:module{DpdcV2} DPDC)
        (ref-DPDC-UDC:module{DpdcUdcV2} DPDC-UDC)
        (ref-TS02-C2:module{TalosStageTwo_ClientTwoV2} TS02-C2)
        (owner:string KST.ANHD)
        (type:object{DpdcUdcV2.URI|Type} (ref-DPDC-UDC::UDC_URI|Type true false false false false false false))
    )
    (map print
        [
            ;; owner=creator=ANHD so ANHD holds the create-role; role toggles below auto-deploy EMMA.
            (format "<(C_DPNF|Issue CoverageNF/CNF)> => \"{}\""
                [(ref-TS02-C2::C_DPNF|Issue owner owner owner "CoverageNF" "CNF" true true true true true true true true)])
        ]
    )
    (let
        (
            (nft-id:string "CNF-98c486052a51")
            (nd:object{DpdcUdcV2.DPDC|NonceData}
                (ref-DPDC-UDC::UDC_NonceData
                    0.0 0.0 "N" "N" (ref-DPDC-UDC::UDC_NoMetaData) type
                    (ref-DPDC-UDC::UDC_ZeroURI|Data) (ref-DPDC-UDC::UDC_ZeroURI|Data) (ref-DPDC-UDC::UDC_ZeroURI|Data)
                )
            )
        )
        (map print
            [
                (format "<(C_DPNF|Create 8 NFT nonces)> => \"{}\""
                    [(ref-TS02-C2::C_DPNF|Create owner nft-id (make-list 8 nd))])
                (expect "<<TX-NF-001>> CNF has 8 native nonces created" 8 (ref-DPDC::UR_NoncesUsed nft-id false))
                ""
            ]
        )
    )
)
(print "===^^^===")
(commit-tx)
;;||>>>>>>>>>>>>>>>>>>>>>>>>>
;;|| NEXT                   >
;;||>>>>>>>>>>>>>>>>>>>>>>>>>
(print "")

;;================================================================================
(begin-tx "TX-NF-002 - DPNF role toggles / pause / role moves (owner + creator EMMA)")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(namespace "ouronet-ns")
;;==== TX-NF-002 · 01 · env-sigs (caps) ====
(print "--- [TX-NF-002 · 01 · env-sigs] ---")
(env-sigs [ { "key": "PK_AncientHodler", "caps": [] } ])
;;==== TX-NF-002 · 02 · toggles + moves ====
(print "--- [TX-NF-002 · 02 · toggles + moves] ---")
(let
    (
        (ref-DPDC:module{DpdcV2} DPDC)
        (ref-TS02-C2:module{TalosStageTwo_ClientTwoV2} TS02-C2)
        (id:string "CNF-98c486052a51")
        (patron:string KST.ANHD)
        (emma:string KST.EMMA)
        (orbr:string KST.OURBR)
        (t:bool true)
        (f:bool false)
    )
    ;; pause on/off
    (ref-TS02-C2::C_DPNF|TogglePause patron id t)
    (ref-TS02-C2::C_DPNF|TogglePause patron id f)
    ;; per-account role toggles on a standard account (EMMA) — on then off
    (ref-TS02-C2::C_DPNF|ToggleBurnRole patron id emma t)
    (ref-TS02-C2::C_DPNF|ToggleBurnRole patron id emma f)
    ;; exemption role requires a SMART account (Ouroboros)
    (ref-TS02-C2::C_DPNF|ToggleExemptionRole patron id orbr t)
    (ref-TS02-C2::C_DPNF|ToggleExemptionRole patron id orbr f)
    (ref-TS02-C2::C_DPNF|ToggleUpdateRole patron id emma t)
    (ref-TS02-C2::C_DPNF|ToggleUpdateRole patron id emma f)
    (ref-TS02-C2::C_DPNF|ToggleModifyCreatorRole patron id emma t)
    (ref-TS02-C2::C_DPNF|ToggleModifyCreatorRole patron id emma f)
    (ref-TS02-C2::C_DPNF|ToggleModifyRoyaltiesRole patron id emma t)
    (ref-TS02-C2::C_DPNF|ToggleModifyRoyaltiesRole patron id emma f)
    ;; singleton role moves: owner -> EMMA -> owner (round-trip so owner keeps them)
    (ref-TS02-C2::C_DPNF|MoveCreateRole patron id emma)
    (ref-TS02-C2::C_DPNF|MoveCreateRole patron id patron)
    (ref-TS02-C2::C_DPNF|MoveRecreateRole patron id emma)
    (ref-TS02-C2::C_DPNF|MoveRecreateRole patron id patron)
    (ref-TS02-C2::C_DPNF|MoveSetUriRole patron id emma)
    (ref-TS02-C2::C_DPNF|MoveSetUriRole patron id patron)
    (print "<<TX-NF-002>> all DPNF pause/role toggles + role moves executed OK (owner + EMMA)")
)
(print "===^^^===")
(commit-tx)
;;||>>>>>>>>>>>>>>>>>>>>>>>>>
;;|| NEXT                   >
;;||>>>>>>>>>>>>>>>>>>>>>>>>>
(print "")

;;================================================================================
(print "")
(print "=== END FILE [6.1.4]_DPDC-NF.repl (batch 1: issue/create + role toggles + role moves) ===")
