;;
;; REPL/Stage_02/[6.1.4]_DPDC-NF.repl — DPNF (NFT) client-op coverage (#79 Phase 1b)
;;   Canonical integration layout (OuronetInformational/ARCHITECTURE/REPL_AND_TESTS.md).
;;   Mints a fresh NFT collection (owner ANHD, creator EMMA) then exercises the DPNF
;;   client wrappers that had no coverage. Batch 1: owner/creator-level ops (toggles,
;;   role moves, nonce updates, branding). Sets/fragments/wipes/transfers = later batches.
;;
(print "")
(print "================================================================")
(print "FILE  REPL/Stage_02/[6.1.4]_DPDC-NF.repl  (DPNF NFT coverage)")
(print "================================================================")
(print "")

;;================================================================================
(begin-tx "TX-NF-001 - Issue fresh NFT (owner ANHD, creator EMMA) + create 8 nonces")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(namespace "ouronet-ns")
;;==== TX-NF-001 · 01 · env-sigs (STOA fee caps) ====
(print "--- [TX-NF-001 · 01 · env-sigs] ---")
(let
    (
        (ref-DALOS:module{OuronetDalosV2} DALOS)
        (owner:string KST.ANHD)
        (dpnf-price:decimal (ref-DALOS::UR_UsagePrice "dpnf"))
        (split-dpnf:[decimal] (ref-DALOS::URC_SplitSTOAPrices owner dpnf-price))
        (t0:decimal (at 0 split-dpnf))
        (t1:decimal (at 1 split-dpnf))
        (t2:decimal (at 2 split-dpnf))
        (t3:decimal (at 3 split-dpnf))
    )
    (env-sigs
        [
            { "key": "PK_AncientHodler", "caps": [] }
            { "key": "6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263",
              "caps":
                [
                    (coin.TRANSFER "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263"
                        "k:50d6c59b21e5e6e55baecaa75a1007de37576bde12d8230dc82459cc01b9484b" t2)
                    (coin.TRANSFER "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263"
                        "k:0cb30c0121ff919266121a99ff9359871818932211df94dae4137c29bc0e8f7e" t0)
                    (coin.TRANSFER "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263"
                        "c:XM-pkmuB5XUQlp87ZYSbfKt8qzmHY6O2EHAzMRVBt3k" t3)
                    (coin.TRANSFER "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263"
                        "c:iQQFWj6gWtpGEzhM_O5ekW1QtnQQy55R8BRPGhj_0FU" t1)
                ]
            }
        ]
    )
)
;;==== TX-NF-001 · 02 · issue + create native nonces ====
(print "--- [TX-NF-001 · 02 · issue + create] ---")
(let
    (
        (ref-DPDC:module{DpdcV2} DPDC)
        (ref-DPDC-UDC:module{DpdcUdcV2} DPDC-UDC)
        (ref-TS02-C2:module{TalosStageTwo_ClientTwoV2} TS02-C2)
        (owner:string KST.ANHD)
        (type:object{DpdcUdcV2.URI|Type} (ref-DPDC-UDC::UDC_URI|Type true false false false false false false))
    )
    (map print
        [
            ;; owner=creator=ANHD so ANHD holds the create-role; role toggles below auto-deploy EMMA.
            (format "<(C_DPNF|Issue CoverageNF/CNF)> => \"{}\""
                [(ref-TS02-C2::C_DPNF|Issue owner owner owner "CoverageNF" "CNF" true true true true true true true true)])
        ]
    )
    (let
        (
            (nft-id:string "CNF-98c486052a51")
            (nd:object{DpdcUdcV2.DPDC|NonceData}
                (ref-DPDC-UDC::UDC_NonceData
                    0.0 0.0 "N" "N" (ref-DPDC-UDC::UDC_NoMetaData) type
                    (ref-DPDC-UDC::UDC_ZeroURI|Data) (ref-DPDC-UDC::UDC_ZeroURI|Data) (ref-DPDC-UDC::UDC_ZeroURI|Data)
                )
            )
        )
        (map print
            [
                (format "<(C_DPNF|Create 8 NFT nonces)> => \"{}\""
                    [(ref-TS02-C2::C_DPNF|Create owner nft-id (make-list 8 nd))])
                (expect "<<TX-NF-001>> CNF has 8 native nonces created" 8 (ref-DPDC::UR_NoncesUsed nft-id false))
                ""
            ]
        )
    )
)
(print "===^^^===")
(commit-tx)
;;||>>>>>>>>>>>>>>>>>>>>>>>>>
;;|| NEXT                   >
;;||>>>>>>>>>>>>>>>>>>>>>>>>>
(print "")

;;================================================================================
(begin-tx "TX-NF-002 - DPNF role toggles / pause / role moves (owner + creator EMMA)")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(namespace "ouronet-ns")
;;==== TX-NF-002 · 01 · env-sigs (caps) ====
(print "--- [TX-NF-002 · 01 · env-sigs] ---")
(env-sigs [ { "key": "PK_AncientHodler", "caps": [] } ])
;;==== TX-NF-002 · 02 · toggles + moves ====
(print "--- [TX-NF-002 · 02 · toggles + moves] ---")
(let
    (
        (ref-DPDC:module{DpdcV2} DPDC)
        (ref-TS02-C2:module{TalosStageTwo_ClientTwoV2} TS02-C2)
        (id:string "CNF-98c486052a51")
        (patron:string KST.ANHD)
        (emma:string KST.EMMA)
        (orbr:string KST.OURBR)
        (t:bool true)
        (f:bool false)
    )
    ;; pause on/off
    (ref-TS02-C2::C_DPNF|TogglePause patron id t)
    (ref-TS02-C2::C_DPNF|TogglePause patron id f)
    ;; per-account role toggles on a standard account (EMMA) — on then off
    (ref-TS02-C2::C_DPNF|ToggleBurnRole patron id emma t)
    (ref-TS02-C2::C_DPNF|ToggleBurnRole patron id emma f)
    ;; exemption role requires a SMART account (Ouroboros)
    (ref-TS02-C2::C_DPNF|ToggleExemptionRole patron id orbr t)
    (ref-TS02-C2::C_DPNF|ToggleExemptionRole patron id orbr f)
    (ref-TS02-C2::C_DPNF|ToggleUpdateRole patron id emma t)
    (ref-TS02-C2::C_DPNF|ToggleUpdateRole patron id emma f)
    (ref-TS02-C2::C_DPNF|ToggleModifyCreatorRole patron id emma t)
    (ref-TS02-C2::C_DPNF|ToggleModifyCreatorRole patron id emma f)
    (ref-TS02-C2::C_DPNF|ToggleModifyRoyaltiesRole patron id emma t)
    (ref-TS02-C2::C_DPNF|ToggleModifyRoyaltiesRole patron id emma f)
    ;; singleton role moves: owner -> EMMA -> owner (round-trip so owner keeps them)
    (ref-TS02-C2::C_DPNF|MoveCreateRole patron id emma)
    (ref-TS02-C2::C_DPNF|MoveCreateRole patron id patron)
    (ref-TS02-C2::C_DPNF|MoveRecreateRole patron id emma)
    (ref-TS02-C2::C_DPNF|MoveRecreateRole patron id patron)
    (ref-TS02-C2::C_DPNF|MoveSetUriRole patron id emma)
    (ref-TS02-C2::C_DPNF|MoveSetUriRole patron id patron)
    (print "<<TX-NF-002>> all DPNF pause/role toggles + role moves executed OK (owner + EMMA)")
)
(print "===^^^===")
(commit-tx)
;;||>>>>>>>>>>>>>>>>>>>>>>>>>
;;|| NEXT                   >
;;||>>>>>>>>>>>>>>>>>>>>>>>>>
(print "")

;;================================================================================
;;================================================================================
(begin-tx "TX-NF-003 - DPNF native-nonce updates (nos=true = native)")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(namespace "ouronet-ns")
;;==== TX-NF-003 · 01 · env-sigs (caps) ====
(print "--- [TX-NF-003 · 01 · env-sigs] ---")
(env-sigs [ { "key": "PK_AncientHodler", "caps": [] } ])
;;==== TX-NF-003 · 02 · updates ====
(print "--- [TX-NF-003 · 02 · updates] ---")
(let
    (
        (ref-DPDC-UDC:module{DpdcUdcV2} DPDC-UDC)
        (ref-TS02-C2:module{TalosStageTwo_ClientTwoV2} TS02-C2)
        (id:string "CNF-98c486052a51")
        (patron:string KST.ANHD)
        (type:object{DpdcUdcV2.URI|Type} (ref-DPDC-UDC::UDC_URI|Type true false false false false false false))
        (nd2:object{DpdcUdcV2.DPDC|NonceData}
            (ref-DPDC-UDC::UDC_NonceData
                0.0 5.0 "Updated" "Updated nonce" (ref-DPDC-UDC::UDC_NoMetaData) type
                (ref-DPDC-UDC::UDC_ZeroURI|Data) (ref-DPDC-UDC::UDC_ZeroURI|Data) (ref-DPDC-UDC::UDC_ZeroURI|Data)
            )
        )
    )
    ;; bulk update native nonces 1..2 (nos=true → native, not fragment)
    (ref-TS02-C2::C_DPNF|UpdateNonces patron id patron [1 2] true [nd2 nd2])
    ;; single-field native updates (nos=true)
    (ref-TS02-C2::C_DPNF|UpdateNonceIgnisRoyalty patron id patron 3 true 2.0)
    (ref-TS02-C2::C_DPNF|RemoveNonceScore patron id patron 4 true)
    (print "<<TX-NF-003>> DPNF UpdateNonces + UpdateNonceIgnisRoyalty + RemoveNonceScore executed OK")
)
(print "===^^^===")
(commit-tx)
;;||>>>>>>>>>>>>>>>>>>>>>>>>>
;;|| NEXT                   >
;;||>>>>>>>>>>>>>>>>>>>>>>>>>
(print "")

;;================================================================================
(begin-tx "TX-NF-004 - DPNF burn / respawn / bulk-transfer")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(namespace "ouronet-ns")
;;==== TX-NF-004 · 01 · env-sigs (caps) ====
(print "--- [TX-NF-004 · 01 · env-sigs] ---")
(env-sigs [ { "key": "PK_AncientHodler", "caps": [] } ])
;;==== TX-NF-004 · 02 · burn / respawn / transfer ====
(print "--- [TX-NF-004 · 02 · burn / respawn / transfer] ---")
(let
    (
        (ref-DPDC:module{DpdcV2} DPDC)
        (ref-TS02-C2:module{TalosStageTwo_ClientTwoV2} TS02-C2)
        (id:string "CNF-98c486052a51")
        (patron:string KST.ANHD)
        (emma:string KST.EMMA)
    )
    ;; bulk-transfer nonces 5 and 6 (amount 1 each) to EMMA (single receiver)
    (ref-TS02-C2::C_DPNF|BulkTransfer patron id [[5 6]] [[1 1]] patron [emma] false)
    (map print
        [
            (expect "<<TX-NF-004>> EMMA holds NFT nonce 6 after bulk-transfer" 1 (ref-DPDC::UR_AccountNonceSupply emma id false 6))
            ""
        ]
    )
    ;; NOTE (batch 3): C_DPNF|Burn/Respawn have a not-yet-pinned precondition on C_BurnNFT
    ;; (role/flag/state) — deferred with wipes/sets/fragments.
)
(print "===^^^===")
(commit-tx)
;;================================================================================
(begin-tx "TX-NF-005 - DPNF set-class definitions + admin (composite/hybrid/rename/toggle/fragment)")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(namespace "ouronet-ns")
;;==== TX-NF-005 · 01 · env-sigs (caps) ====
(print "--- [TX-NF-005 · 01 · env-sigs] ---")
(env-sigs [ { "key": "PK_AncientHodler", "caps": [] } ])
;;==== TX-NF-005 · 02 · define + admin ====
(print "--- [TX-NF-005 · 02 · define + admin] ---")
(let
    (
        (ref-DPDC-UDC:module{DpdcUdcV2} DPDC-UDC)
        (ref-TS02-C2:module{TalosStageTwo_ClientTwoV2} TS02-C2)
        (id:string "CNF-98c486052a51")
        (patron:string KST.ANHD)
        (type:object{DpdcUdcV2.URI|Type} (ref-DPDC-UDC::UDC_URI|Type true false false false false false false))
        (nd:object{DpdcUdcV2.DPDC|NonceData}
            (ref-DPDC-UDC::UDC_NonceData
                0.0 0.0 "N" "N" (ref-DPDC-UDC::UDC_NoMetaData) type
                (ref-DPDC-UDC::UDC_ZeroURI|Data) (ref-DPDC-UDC::UDC_ZeroURI|Data) (ref-DPDC-UDC::UDC_ZeroURI|Data)
            )
        )
    )
    ;; primordial fixture (set-class 1): positions [1 2] / [3 4]
    (ref-TS02-C2::C_DPNF|DefinePrimordialSet patron id "CNF-P1" 1.0
        [(ref-DPDC-UDC::UDC_DPDC|AllowedNonceForSetPosition [1 2]) (ref-DPDC-UDC::UDC_DPDC|AllowedNonceForSetPosition [3 4])] nd)
    ;; composite (set-class 2): references set-class 1
    (ref-TS02-C2::C_DPNF|DefineCompositeSet patron id "CNF-C1" 1.0
        [(ref-DPDC-UDC::UDC_DPDC|AllowedClassForSetPosition 1)] nd)
    ;; hybrid (set-class 3): primordial nonces [5 6] (NFT positions need >1 element) + composite set-class 1
    (ref-TS02-C2::C_DPNF|DefineHybridSet patron id "CNF-H1" 1.0
        [(ref-DPDC-UDC::UDC_DPDC|AllowedNonceForSetPosition [5 6])] [(ref-DPDC-UDC::UDC_DPDC|AllowedClassForSetPosition 1)] nd)
    ;; admin on set-class 1
    (ref-TS02-C2::C_DPNF|RenameSet patron id 1 "CNF-P1-Renamed")
    ;; newly-defined sets are active → toggle off then back on (mirrors [6.1.3])
    (ref-TS02-C2::C_DPNF|ToggleSet patron id 1 false)
    (ref-TS02-C2::C_DPNF|ToggleSet patron id 1 true)
    (ref-TS02-C2::C_DPNF|EnableSetClassFragmentation patron id 1 nd)
    (print "<<TX-NF-005>> DPNF DefinePrimordial/Composite/Hybrid + Rename/Toggle/EnableSetClassFragmentation OK")
)
(print "===^^^===")
(commit-tx)
;;||>>>>>>>>>>>>>>>>>>>>>>>>>
;;|| NEXT                   >
;;||>>>>>>>>>>>>>>>>>>>>>>>>>
(print "")

;;================================================================================
(begin-tx "TX-NF-006 - DPNF set-nonce updaters (set-class 1, nos=true native)")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(namespace "ouronet-ns")
;;==== TX-NF-006 · 01 · env-sigs (caps) ====
(print "--- [TX-NF-006 · 01 · env-sigs] ---")
(env-sigs [ { "key": "PK_AncientHodler", "caps": [] } ])
;;==== TX-NF-006 · 02 · set-nonce updates ====
(print "--- [TX-NF-006 · 02 · set-nonce updates] ---")
(let
    (
        (ref-DPDC-UDC:module{DpdcUdcV2} DPDC-UDC)
        (ref-TS02-C2:module{TalosStageTwo_ClientTwoV2} TS02-C2)
        (id:string "CNF-98c486052a51")
        (patron:string KST.ANHD)
        (sc:integer 1)
        (type:object{DpdcUdcV2.URI|Type} (ref-DPDC-UDC::UDC_URI|Type true false false false false false false))
        (nd2:object{DpdcUdcV2.DPDC|NonceData}
            (ref-DPDC-UDC::UDC_NonceData
                0.0 3.0 "SetUpd" "Set nonce updated" (ref-DPDC-UDC::UDC_NoMetaData) type
                (ref-DPDC-UDC::UDC_ZeroURI|Data) (ref-DPDC-UDC::UDC_ZeroURI|Data) (ref-DPDC-UDC::UDC_ZeroURI|Data)
            )
        )
    )
    (ref-TS02-C2::C_DPNF|UpdateSetNonce patron id patron sc true nd2)
    (ref-TS02-C2::C_DPNF|UpdateSetNonces patron id patron [sc] true [nd2])
    (ref-TS02-C2::C_DPNF|UpdateSetNonceRoyalty patron id patron sc true 3.0)
    (ref-TS02-C2::C_DPNF|UpdateSetNonceIgnisRoyalty patron id patron sc true 2.0)
    (ref-TS02-C2::C_DPNF|UpdateSetNonceName patron id patron sc true "SetName")
    (ref-TS02-C2::C_DPNF|UpdateSetNonceDescription patron id patron sc true "SetDesc")
    (ref-TS02-C2::C_DPNF|UpdateSetNonceScore patron id patron sc true 5.0)
    (ref-TS02-C2::C_DPNF|UpdateSetNonceMetaData patron id patron sc true (ref-DPDC-UDC::UDC_NoMetaData))
    (ref-TS02-C2::C_DPNF|UpdateSetNonceURI patron id patron sc true type
        (ref-DPDC-UDC::UDC_ZeroURI|Data) (ref-DPDC-UDC::UDC_ZeroURI|Data) (ref-DPDC-UDC::UDC_ZeroURI|Data))
    (ref-TS02-C2::C_DPNF|RemoveSetNonceScore patron id patron sc true)
    (print "<<TX-NF-006>> DPNF all 10 UpdateSetNonce* + RemoveSetNonceScore executed OK")
)
(print "===^^^===")
(commit-tx)
;;================================================================================
(begin-tx "TX-NF-007 - DPNF premium branding upgrade (STOA fee)")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(namespace "ouronet-ns")
;;==== TX-NF-007 · 01 · env-sigs (STOA fee caps) ====
(print "--- [TX-NF-007 · 01 · env-sigs] ---")
(env-sigs
    [
        { "key": "PK_AncientHodler", "caps": [] }
        { "key": "6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263",
          "caps":
            [
                (coin.TRANSFER "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263"
                    "k:50d6c59b21e5e6e55baecaa75a1007de37576bde12d8230dc82459cc01b9484b" 1000.0)
                (coin.TRANSFER "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263"
                    "k:0cb30c0121ff919266121a99ff9359871818932211df94dae4137c29bc0e8f7e" 1000.0)
                (coin.TRANSFER "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263"
                    "c:XM-pkmuB5XUQlp87ZYSbfKt8qzmHY6O2EHAzMRVBt3k" 1000.0)
                (coin.TRANSFER "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263"
                    "c:iQQFWj6gWtpGEzhM_O5ekW1QtnQQy55R8BRPGhj_0FU" 1000.0)
            ]
        }
    ]
)
;;==== TX-NF-007 · 02 · branding ====
(print "--- [TX-NF-007 · 02 · branding] ---")
(let
    (
        (ref-TS02-C2:module{TalosStageTwo_ClientTwoV2} TS02-C2)
        (id:string "CNF-98c486052a51")
        (patron:string KST.ANHD)
    )
    (map print
        [
            (format "<(C_DPNF|UpgradeBranding CNF 1 month)> => \"{}\""
                [(ref-TS02-C2::C_DPNF|UpgradeBranding patron id 1)])
            ""
        ]
    )
)
(print "===^^^===")
