;; TX-FVT-07 — Partial then full TF unstake: tracker/rollup/SCORE/RPS cleanup
(begin-tx "TX-FVT-07 - Partial + full CC_UnstakeTrueFungible")
(print "")
(print "=== TX-FVT-07 — TF unstake (partial 40 then full remainder) =================")
(namespace "ouronet-ns")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(let
    (
        (patron:string KST.ANHD)
        (owner-id:string KST.ANHD)
        (beneficiary-id:string KST.ANHD)
        (ouro-id:string "OURO-98c486052a51")
        (score-name:string "TfStakeScore")
        (fvt-name:string "TfStakeVault")
        (pool-name:string "TfStakePool")
        (partial-amt:decimal 40.0)
        (ref-U|DALOS:module{UtilityDalosV2} U|DALOS)
        (ref-DPTF:module{DemiourgosPactTrueFungibleV2} DPTF)
        (ref-TS02-C3:module{TalosStageTwo_ClientThreeV2} TS02-C3)
        (ref-AQP:module{AcquisitionPoolsV2} AQP-POOL)
        (ref-SCR:module{AcquisitionScoresV2} AQP-SCORE)
        (ref-FVT:module{AcquisitionFarmsVaultsTreasuriesV2} AQP-FVT)
        (score-id:string (ref-U|DALOS::UDC_Makeid score-name))
        (fvt-id:string (ref-U|DALOS::UDC_Makeid fvt-name))
        (pool-id:string (ref-U|DALOS::UDC_Makeid pool-name))
        (tracker-pre:decimal (ref-AQP::UR_AQP|DPTFTrackerBalance pool-id ouro-id owner-id beneficiary-id))
        (ouro-pre:decimal (ref-DPTF::UR_AccountSupply ouro-id owner-id))
        (unclaimed-pre:integer (ref-FVT::UR_FVT-RG|UnclaimedCount fvt-id ouro-id))
    )
    (print "--- [TX-FVT-07 · 01 · partial unstake 40] ---")
    (enforce (>= tracker-pre 100.0) "TX-FVT-07 expects ≥100 staked from TX-FVT-03")
    (env-sigs [{ "key": "PK_AncientHodler", "caps": [] }])
    (print (format "<(CC_AQP-POOL|UnstakeTrueFungible {})> => \"{}\"" [partial-amt
        (ref-TS02-C3::CC_AQP-POOL|UnstakeTrueFungible patron pool-id owner-id beneficiary-id ouro-id partial-amt)
    ]))
    (let
        (
            (tracker-mid:decimal (ref-AQP::UR_AQP|DPTFTrackerBalance pool-id ouro-id owner-id beneficiary-id))
            (rollup-mid:decimal (ref-AQP::UR_AQP|BenDptfTotalBalance beneficiary-id ouro-id))
            (deb-mid:decimal (ref-SCR::UR_U-SCR|UserScoreDebScore beneficiary-id pool-id score-id))
            (base-mid:decimal (ref-SCR::UR_U-SCR|UserScoreBaseScore beneficiary-id pool-id score-id))
            (last-rps-mid:decimal (ref-FVT::UR_FVT-RU|LastRps beneficiary-id fvt-id score-id ouro-id))
            (g-mid:decimal (ref-FVT::UR_FVT-RG|CurrentRps fvt-id ouro-id))
            (ouro-mid:decimal (ref-DPTF::UR_AccountSupply ouro-id owner-id))
            (remain:decimal (- tracker-pre partial-amt))
        )
        (map print
            [
                (format "<(partial tracker/deb/ouro)> => \"{} {} {}\"" [tracker-mid deb-mid ouro-mid])
                (expect (format "<<TX-FVT-07>> tracker after partial got={} expected={}" [tracker-mid remain]) remain tracker-mid)
                (expect (format "<<TX-FVT-07>> rollup after partial got={} expected={}" [rollup-mid remain]) remain rollup-mid)
                (expect (format "<<TX-FVT-07>> deb after partial got={} expected={}" [deb-mid remain]) remain deb-mid)
                (expect (format "<<TX-FVT-07>> base after partial got={} expected={}" [base-mid remain]) remain base-mid)
                (expect (format "<<TX-FVT-07>> last-rps still == G got={} expected={}" [last-rps-mid g-mid]) g-mid last-rps-mid)
                (expect (format "<<TX-FVT-07>> OURO restored +40 got={} expected={}" [ouro-mid (+ ouro-pre partial-amt)]) (+ ouro-pre partial-amt) ouro-mid)
            ]
        )
        (print "--- [TX-FVT-07 · 02 · full remainder unstake] ---")
        (print (format "<(CC_AQP-POOL|UnstakeTrueFungible remainder {})> => \"{}\"" [remain
            (ref-TS02-C3::CC_AQP-POOL|UnstakeTrueFungible patron pool-id owner-id beneficiary-id ouro-id remain)
        ]))
        (let
            (
                (tracker-z:decimal (ref-AQP::UR_AQP|DPTFTrackerBalance pool-id ouro-id owner-id beneficiary-id))
                (rollup-z:decimal (ref-AQP::UR_AQP|BenDptfTotalBalance beneficiary-id ouro-id))
                (deb-z:decimal (ref-SCR::UR_U-SCR|UserScoreDebScore beneficiary-id pool-id score-id))
                (base-z:decimal (ref-SCR::UR_U-SCR|UserScoreBaseScore beneficiary-id pool-id score-id))
                (total-deb-z:decimal (ref-SCR::UR_SCR|ScoreTotalDebScore score-id))
                (unclaimed-z:integer (ref-FVT::UR_FVT-RG|UnclaimedCount fvt-id ouro-id))
                (ouro-z:decimal (ref-DPTF::UR_AccountSupply ouro-id owner-id))
                (last-rps-z:decimal (ref-FVT::UR_FVT-RU|LastRps beneficiary-id fvt-id score-id ouro-id))
                (g-z:decimal (ref-FVT::UR_FVT-RG|CurrentRps fvt-id ouro-id))
            )
            (map print
                [
                    (format "<(full-exit tracker/deb/unclaimed)> => \"{} {} {}\"" [tracker-z deb-z unclaimed-z])
                    (expect (format "<<TX-FVT-07>> tracker cleared got={}" [tracker-z]) 0.0 tracker-z)
                    (expect (format "<<TX-FVT-07>> rollup cleared got={}" [rollup-z]) 0.0 rollup-z)
                    (expect (format "<<TX-FVT-07>> user deb cleared got={}" [deb-z]) 0.0 deb-z)
                    (expect (format "<<TX-FVT-07>> user base cleared got={}" [base-z]) 0.0 base-z)
                    (expect (format "<<TX-FVT-07>> score total-deb cleared got={}" [total-deb-z]) 0.0 total-deb-z)
                    (expect (format "<<TX-FVT-07>> last-rps==G after exit got={} expected={}" [last-rps-z g-z]) g-z last-rps-z)
                    (expect (format "<<TX-FVT-07>> unclaimed decremented got={} pre={}" [unclaimed-z unclaimed-pre]) true (< unclaimed-z unclaimed-pre))
                    (expect (format "<<TX-FVT-07>> full OURO restored got={} expected={}" [ouro-z (+ ouro-pre tracker-pre)]) (+ ouro-pre tracker-pre) ouro-z)
                ]
            )
        )
    )
)
(print "")
(print (format "<(REPL|env-gas)> TX-FVT-07 after commit => \"{}\"" [(env-gas)]))
(print "")
(env-sigs [])
(commit-tx)
(print "")
(print "=== END TX-FVT-07 ==========================================================")
(print "")
;;||>>>>>>>>>>>>>>>>>>>>>>>>>
;;|| NEXT                   >
;;||>>>>>>>>>>>>>>>>>>>>>>>>>
(print "")
;;
;; TX-FVT-08 — Mosaic toggle + non-mosaic SCORE membership lock on first AddScoreEntity
(begin-tx "TX-FVT-08 - Mosaic / non-mosaic SCORE membership")
(print "")
(print "=== TX-FVT-08 — Mosaic policy + SCORE membership-mode lock ==================")
(namespace "ouronet-ns")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(let
    (
        (patron:string KST.ANHD)
        (owner-konto:string KST.ANHD)
        (ouro-id:string "OURO-98c486052a51")
        (score-name:string "TfMosaicScore")
        (fvt-name:string "TfMosaicVault")
        (pool-name:string "TfMosaicPool")
        (ref-DALOS:module{OuronetDalosV2} DALOS)
        (ref-U|DALOS:module{UtilityDalosV2} U|DALOS)
        (ref-U|CT:module{OuronetConstantsV2} U|CT)
        (ref-TS02-C3:module{TalosStageTwo_ClientThreeV2} TS02-C3)
        (ref-FVT:module{AcquisitionFarmsVaultsTreasuriesV2} AQP-FVT)
        (score-id:string (ref-U|DALOS::UDC_Makeid score-name))
        (fvt-id:string (ref-U|DALOS::UDC_Makeid fvt-name))
        (pool-id:string (ref-U|DALOS::UDC_Makeid pool-name))
        (mode-bar:string "BAR")
        (bar:string (ref-U|CT::CT_BAR))
        (split-smart:[decimal]
            (ref-DALOS::URC_SplitSTOAPrices patron (* 3.0 (ref-DALOS::UR_UsagePrice "smart")))
        )
    )
    (print "--- [TX-FVT-08 · 01 · issue score + pool + vault] ---")
    (env-sigs
        [
            { "key": "PK_AncientHodler", "caps": [] }
            { "key": "6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263",
              "caps":
                [
                    (coin.TRANSFER "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263" "k:50d6c59b21e5e6e55baecaa75a1007de37576bde12d8230dc82459cc01b9484b" (at 2 split-smart))
                    (coin.TRANSFER "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263" "k:0cb30c0121ff919266121a99ff9359871818932211df94dae4137c29bc0e8f7e" (at 0 split-smart))
                    (coin.TRANSFER "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263" "c:XM-pkmuB5XUQlp87ZYSbfKt8qzmHY6O2EHAzMRVBt3k" (at 3 split-smart))
                    (coin.TRANSFER "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263" "c:iQQFWj6gWtpGEzhM_O5ekW1QtnQQy55R8BRPGhj_0FU" (at 1 split-smart))
                ]
            }
        ]
    )
    (print (format "<(C_IssueTrueFungibleScore TfMosaicScore)> => \"{}\"" [
        (ref-TS02-C3::C_AQP-SCR|IssueTrueFungibleScore patron owner-konto score-name 12 1.0)
    ]))
    (print (format "<(C_Issue pool + AddScore)> => \"{}\"" [
        (ref-TS02-C3::C_AQP-POOL|Issue patron pool-name ouro-id 1)
    ]))
    (print (format "<(C_AddScore)> => \"{}\"" [(ref-TS02-C3::C_AQP-POOL|AddScore patron pool-id score-id)]))
    (print (format "<(C_Issue vault)> => \"{}\"" [(ref-TS02-C3::C_AQP-FVT|Issue patron fvt-name patron 1 "|")]))
    (let
        (
            (mosaic-default:bool (ref-FVT::UR_FVT|Mosaic fvt-id))
            (mode-default:string (ref-FVT::UR_FVT|MembershipMode fvt-id))
        )
        (map print
            [
                (expect (format "<<TX-FVT-08>> default mosaic=true got={}" [mosaic-default]) true mosaic-default)
                (expect (format "<<TX-FVT-08>> default mode=BAR got={}" [mode-default]) mode-bar mode-default)
            ]
        )
    )
    (print "--- [TX-FVT-08 · 02 · SetMosaic false then true (no links)] ---")
    (env-sigs [{ "key": "PK_AncientHodler", "caps": [] }])
    (print (format "<(C_SetMosaic false)> => \"{}\"" [(ref-TS02-C3::C_AQP-FVT|SetMosaic patron fvt-id false)]))
    (let
        (
            (m1:bool (ref-FVT::UR_FVT|Mosaic fvt-id))
            (mode1:string (ref-FVT::UR_FVT|MembershipMode fvt-id))
        )
        (map print
            [
                (expect (format "<<TX-FVT-08>> mosaic false got={}" [m1]) false m1)
                (expect (format "<<TX-FVT-08>> mode reset BAR got={}" [mode1]) mode-bar mode1)
            ]
        )
    )
    (print (format "<(C_SetMosaic true)> => \"{}\"" [(ref-TS02-C3::C_AQP-FVT|SetMosaic patron fvt-id true)]))
    (print (format "<(C_SetMosaic false again)> => \"{}\"" [(ref-TS02-C3::C_AQP-FVT|SetMosaic patron fvt-id false)]))
    (print "--- [TX-FVT-08 · 03 · reward + AddScoreEntity locks SCORE mode] ---")
    (print (format "<(C_AddRewardLink)> => \"{}\"" [
        (ref-TS02-C3::C_AQP-FVT|AddRewardLink patron fvt-id ouro-id false bar)
    ]))
    (print (format "<(C_AddScoreEntity type=1)> => \"{}\"" [
        (ref-TS02-C3::C_AQP-FVT|AddScoreEntity patron fvt-id 1 score-id)
    ]))
    (let
        (
            (mosaic-locked:bool (ref-FVT::UR_FVT|Mosaic fvt-id))
            (mode-locked:string (ref-FVT::UR_FVT|MembershipMode fvt-id))
        )
        (map print
            [
                (expect (format "<<TX-FVT-08>> mosaic still false got={}" [mosaic-locked]) false mosaic-locked)
                (expect (format "<<TX-FVT-08>> membership-mode SCORE got={}" [mode-locked]) "SCORE" mode-locked)
            ]
        )
    )
    (print "--- [TX-FVT-08 · 04 · SetMosaic with links must fail] ---")
    (map print
        [
            (expect-failure "<<TX-FVT-08>> SetMosaic blocked while ScoreEntityLink rows exist"
                (ref-TS02-C3::C_AQP-FVT|SetMosaic patron fvt-id true))
        ]
    )
)
(print "")
(print (format "<(REPL|env-gas)> TX-FVT-08 after commit => \"{}\"" [(env-gas)]))
(print "")
(env-sigs [])
(commit-tx)
(print "")
(print "=== END TX-FVT-08 ==========================================================")
(print "")
;;||>>>>>>>>>>>>>>>>>>>>>>>>>
;;|| NEXT                   >
;;||>>>>>>>>>>>>>>>>>>>>>>>>>
(print "")
