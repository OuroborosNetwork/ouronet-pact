;; TX-FVT-05 — Vault inject / collect / second-collect idempotence (score-entity type 1, PLAIN)
(begin-tx "TX-FVT-05 - Vault inject + collect + second collect=0")
(print "")
(print "=== TX-FVT-05 — Vault inject/collect/second-collect (TfStakeVault) ===========")
(namespace "ouronet-ns")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(let
    (
        (patron:string KST.ANHD)
        (owner-id:string KST.ANHD)
        (beneficiary-id:string KST.ANHD)
        (ouro-id:string "OURO-98c486052a51")
        (score-name:string "TfStakeScore")
        (fvt-name:string "TfStakeVault")
        (pool-name:string "TfStakePool")
        (inject-amt:decimal 50.0)
        (ref-U|DALOS:module{UtilityDalosV1} U|DALOS)
        (ref-DPTF:module{DemiourgosPactTrueFungibleV1} DPTF)
        (ref-TS02-C3:module{TalosStageTwo_ClientThreeV1} TS02-C3)
        (ref-SCR:module{AcquisitionScoresV1} AQP-SCORE)
        (ref-FVT:module{AcquisitionFarmsVaultsTreasuriesV1} AQP-FVT)
        (score-id:string (ref-U|DALOS::UDC_Makeid score-name))
        (fvt-id:string (ref-U|DALOS::UDC_Makeid fvt-name))
        (pool-id:string (ref-U|DALOS::UDC_Makeid pool-name))
        (ouro-pre:decimal (ref-DPTF::UR_AccountSupply ouro-id patron))
        (ar-pre:decimal (ref-FVT::UR_FVT-RG|AvailableRewards fvt-id ouro-id))
        (g-pre:decimal (ref-FVT::UR_FVT-RG|CurrentRps fvt-id ouro-id))
    )
    (print "--- [TX-FVT-05 · 01 · inject OURO into vault] ---")
    (enforce (>= ouro-pre inject-amt) "TX-FVT-05: patron needs OURO for inject")
    (env-sigs [{ "key": "PK_AncientHodler", "caps": [] }])
    (print (format "<(TS02-C3.AQP-FVT|C_Inject amount={})> => \"{}\"" [inject-amt
        (ref-TS02-C3::AQP-FVT|C_Inject patron fvt-id ouro-id inject-amt)
    ]))
    (let
        (
            (g-post:decimal (ref-FVT::UR_FVT-RG|CurrentRps fvt-id ouro-id))
            (ar-post:decimal (ref-FVT::UR_FVT-RG|AvailableRewards fvt-id ouro-id))
            (ouro-after-inject:decimal (ref-DPTF::UR_AccountSupply ouro-id patron))
        )
        (map print
            [
                (format "<(pre G/AR)> => \"{} {}\"" [g-pre ar-pre])
                (format "<(post-inject G/AR)> => \"{} {}\"" [g-post ar-post])
                (expect (format "<<TX-FVT-05>> G increased got={} pre={}" [g-post g-pre]) true (> g-post g-pre))
                (expect (format "<<TX-FVT-05>> available-rewards got={} expected={}" [ar-post (+ ar-pre inject-amt)]) (+ ar-pre inject-amt) ar-post)
                (expect (format "<<TX-FVT-05>> inject debited OURO got={} expected={}" [ouro-after-inject (- ouro-pre inject-amt)]) (- ouro-pre inject-amt) ouro-after-inject)
            ]
        )
        (print "--- [TX-FVT-05 · 02 · collect once] ---")
        (print (format "<(TS02-C3.AQP-FVT|C_Collect type=1)> => \"{}\"" [
            (ref-TS02-C3::AQP-FVT|C_Collect patron fvt-id 1 score-id ouro-id)
        ]))
        (let
            (
                (ouro-after-collect:decimal (ref-DPTF::UR_AccountSupply ouro-id patron))
                (payout:decimal (- ouro-after-collect ouro-after-inject))
                (pending:decimal (ref-FVT::UR_FVT-RU|PendingRewards beneficiary-id fvt-id score-id ouro-id))
                (last-rps:decimal (ref-FVT::UR_FVT-RU|LastRps beneficiary-id fvt-id score-id ouro-id))
                (g-now:decimal (ref-FVT::UR_FVT-RG|CurrentRps fvt-id ouro-id))
                (ar-after:decimal (ref-FVT::UR_FVT-RG|AvailableRewards fvt-id ouro-id))
                (deb-user:decimal (ref-SCR::UR_U-SCR|UserScoreDebScore beneficiary-id pool-id score-id))
                (deb-total:decimal (ref-SCR::UR_SCR|ScoreTotalDebScore score-id))
            )
            (map print
                [
                    (format "<(collect payout)> => \"{}\" deb={}/{} AR={}" [payout deb-user deb-total ar-after])
                    (expect (format "<<TX-FVT-05>> collect payout>0 got={}" [payout]) true (> payout 0.0))
                    (expect (format "<<TX-FVT-05>> pending zeroed got={}" [pending]) 0.0 pending)
                    (expect (format "<<TX-FVT-05>> last-rps==G got={} expected={}" [last-rps g-now]) g-now last-rps)
                    (expect (format "<<TX-FVT-05>> available-rewards decreased got={} pre-inject-ar={}" [ar-after (+ ar-pre inject-amt)]) true (< ar-after (+ ar-pre inject-amt)))
                    (expect (format "<<TX-FVT-05>> payout <= inject got={} inject={}" [payout inject-amt]) true (<= payout inject-amt))
                ]
            )
            (print "--- [TX-FVT-05 · 03 · second collect idempotent] ---")
            (let
                (
                    (ouro-before-2:decimal (ref-DPTF::UR_AccountSupply ouro-id patron))
                )
                (print (format "<(TS02-C3.AQP-FVT|C_Collect second)> => \"{}\"" [
                    (ref-TS02-C3::AQP-FVT|C_Collect patron fvt-id 1 score-id ouro-id)
                ]))
                (let
                    (
                        (payout-2:decimal (- (ref-DPTF::UR_AccountSupply ouro-id patron) ouro-before-2))
                    )
                    (map print
                        [
                            (expect (format "<<TX-FVT-05>> second collect payout=0 got={}" [payout-2]) 0.0 payout-2)
                        ]
                    )
                )
            )
        )
    )
)
(print "")
(print (format "<(REPL|env-gas)> TX-FVT-05 after commit => \"{}\"" [(env-gas)]))
(print "")
(env-sigs [])
(commit-tx)
(print "")
(print "=== END TX-FVT-05 ==========================================================")
(print "")
;;||>>>>>>>>>>>>>>>>>>>>>>>>>
;;|| NEXT                   >
;;||>>>>>>>>>>>>>>>>>>>>>>>>>
(print "")
