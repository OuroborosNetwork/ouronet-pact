        (bar:string (ref-U|CT::CT_BAR))
        (split-smart:[decimal]
            (ref-DALOS::URC_SplitKDAPrices patron (* 3.0 (ref-DALOS::UR_UsagePrice "smart")))
        )
    )
    (print "--- [TX-FVT-08 · 01 · issue score + pool + vault] ---")
    (env-sigs
        [
            { "key": "PK_AncientHodler", "caps": [] }
            { "key": "6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263",
              "caps":
                [
                    (coin.TRANSFER "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263" "k:50d6c59b21e5e6e55baecaa75a1007de37576bde12d8230dc82459cc01b9484b" (at 2 split-smart))
                    (coin.TRANSFER "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263" "k:0cb30c0121ff919266121a99ff9359871818932211df94dae4137c29bc0e8f7e" (at 0 split-smart))
                    (coin.TRANSFER "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263" "c:XM-pkmuB5XUQlp87ZYSbfKt8qzmHY6O2EHAzMRVBt3k" (at 3 split-smart))
                    (coin.TRANSFER "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263" "c:iQQFWj6gWtpGEzhM_O5ekW1QtnQQy55R8BRPGhj_0FU" (at 1 split-smart))
                ]
            }
        ]
    )
    (print (format "<(C_IssueTrueFungibleScore TfMosaicScore)> => \"{}\"" [
        (ref-TS02-C3::AQP-SCR|C_IssueTrueFungibleScore patron owner-konto score-name 12 1.0)
    ]))
    (print (format "<(C_Issue pool + AddScore)> => \"{}\"" [
        (ref-TS02-C3::AQP-POOL|C_Issue patron pool-name ouro-id 1)
    ]))
    (print (format "<(C_AddScore)> => \"{}\"" [(ref-TS02-C3::AQP-POOL|C_AddScore patron pool-id score-id)]))
    (print (format "<(C_Issue vault)> => \"{}\"" [(ref-TS02-C3::AQP-FVT|C_Issue patron fvt-name patron 1 "|")]))
    (let
        (
            (mosaic-default:bool (ref-FVT::UR_FVT|Mosaic fvt-id))
            (mode-default:string (ref-FVT::UR_FVT|MembershipMode fvt-id))
        )
        (map print
            [
                (expect (format "<<TX-FVT-08>> default mosaic=true got={}" [mosaic-default]) true mosaic-default)
                (expect (format "<<TX-FVT-08>> default mode=BAR got={}" [mode-default]) mode-bar mode-default)
            ]
        )
    )
    (print "--- [TX-FVT-08 · 02 · SetMosaic false then true (no links)] ---")
    (env-sigs [{ "key": "PK_AncientHodler", "caps": [] }])
    (print (format "<(C_SetMosaic false)> => \"{}\"" [(ref-TS02-C3::AQP-FVT|C_SetMosaic patron fvt-id false)]))
    (let
        (
            (m1:bool (ref-FVT::UR_FVT|Mosaic fvt-id))
            (mode1:string (ref-FVT::UR_FVT|MembershipMode fvt-id))
        )
        (map print
            [
                (expect (format "<<TX-FVT-08>> mosaic false got={}" [m1]) false m1)
                (expect (format "<<TX-FVT-08>> mode reset BAR got={}" [mode1]) mode-bar mode1)
            ]
        )
    )
    (print (format "<(C_SetMosaic true)> => \"{}\"" [(ref-TS02-C3::AQP-FVT|C_SetMosaic patron fvt-id true)]))
    (print (format "<(C_SetMosaic false again)> => \"{}\"" [(ref-TS02-C3::AQP-FVT|C_SetMosaic patron fvt-id false)]))
    (print "--- [TX-FVT-08 · 03 · reward + AddScoreEntity locks SCORE mode] ---")
    (print (format "<(C_AddRewardLink)> => \"{}\"" [
        (ref-TS02-C3::AQP-FVT|C_AddRewardLink patron fvt-id ouro-id false bar)
    ]))
    (print (format "<(C_AddScoreEntity type=1)> => \"{}\"" [
        (ref-TS02-C3::AQP-FVT|C_AddScoreEntity patron fvt-id 1 score-id)
    ]))
    (let
        (
            (mosaic-locked:bool (ref-FVT::UR_FVT|Mosaic fvt-id))
            (mode-locked:string (ref-FVT::UR_FVT|MembershipMode fvt-id))
        )
        (map print
            [
                (expect (format "<<TX-FVT-08>> mosaic still false got={}" [mosaic-locked]) false mosaic-locked)
                (expect (format "<<TX-FVT-08>> membership-mode SCORE got={}" [mode-locked]) "SCORE" mode-locked)
            ]
        )
    )
    (print "--- [TX-FVT-08 · 04 · SetMosaic with links must fail] ---")
    (map print
        [
            (expect-failure "<<TX-FVT-08>> SetMosaic blocked while ScoreEntityLink rows exist"
                (ref-TS02-C3::AQP-FVT|C_SetMosaic patron fvt-id true))
        ]
    )
)
(print "")
(print (format "<(REPL|env-gas)> TX-FVT-08 after commit => \"{}\"" [(env-gas)]))
(print "")
(env-sigs [])
(commit-tx)
(print "")
(print "=== END TX-FVT-08 ==========================================================")
(print "")
;;||>>>>>>>>>>>>>>>>>>>>>>>>>
;;|| NEXT                   >
;;||>>>>>>>>>>>>>>>>>>>>>>>>>
(print "")
;;
;; TX-FVT-09 — Multi-staker vault inject/collect fairness (ANHD 60 + EMMA 40)
(begin-tx "TX-FVT-09 - Multi-staker vault inject/collect fairness")
(print "")
(print "=== TX-FVT-09 — Two stakers share vault inject by deb weight ===============")
(namespace "ouronet-ns")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(let
    (
        (patron:string KST.ANHD)
        (anhd:string KST.ANHD)
        (emma:string KST.EMMA)
        (ouro-id:string "OURO-98c486052a51")
        (score-name:string "TfStakeScore")
        (fvt-name:string "TfStakeVault")
        (pool-name:string "TfStakePool")
        (stake-a:decimal 60.0)
        (stake-e:decimal 40.0)
        (inject-amt:decimal 100.0)
        (ref-U|DALOS:module{UtilityDalosV1} U|DALOS)
        (ref-DPTF:module{DemiourgosPactTrueFungibleV1} DPTF)
        (ref-TS01-C1:module{TalosStageOne_ClientOneV1} TS01-C1)
        (ref-TS02-C3:module{TalosStageTwo_ClientThreeV1} TS02-C3)
        (ref-SCR:module{AcquisitionScoresV1} AQP-SCORE)
        (ref-FVT:module{AcquisitionFarmsVaultsTreasuriesV1} AQP-FVT)
        (score-id:string (ref-U|DALOS::UDC_Makeid score-name))
        (fvt-id:string (ref-U|DALOS::UDC_Makeid fvt-name))
        (pool-id:string (ref-U|DALOS::UDC_Makeid pool-name))
        (emma-ouro:decimal (ref-DPTF::UR_AccountSupply ouro-id emma))
        (anhd-ouro:decimal (ref-DPTF::UR_AccountSupply ouro-id anhd))
    )
    (print "--- [TX-FVT-09 · 01 · dual stake ANHD 60 + EMMA 40] ---")
    (enforce (>= anhd-ouro (+ stake-a (+ stake-e inject-amt))) "TX-FVT-09: ANHD needs OURO for fund+stake+inject")
    (env-sigs
        [
            { "key": "PK_AncientHodler", "caps": [] }
            { "key": "PK_Emma", "caps": [] }
        ]
    )
    (if (< emma-ouro stake-e)
        (print (format "<(DPTF C_Transfer OURO ANHD→EMMA {})> => \"{}\"" [stake-e
            (ref-TS01-C1::DPTF|C_Transfer patron ouro-id anhd emma stake-e true)
        ]))
        true
    )
    (print (format "<(C_StakeTrueFungible ANHD {})> => \"{}\"" [stake-a
        (ref-TS02-C3::AQP-POOL|C_StakeTrueFungible patron pool-id anhd anhd ouro-id stake-a)
    ]))
    (print (format "<(C_StakeTrueFungible EMMA {})> => \"{}\"" [stake-e
        (ref-TS02-C3::AQP-POOL|C_StakeTrueFungible patron pool-id emma emma ouro-id stake-e)
    ]))
    (let
        (
            (deb-a:decimal (ref-SCR::UR_U-SCR|UserScoreDebScore anhd pool-id score-id))
            (deb-e:decimal (ref-SCR::UR_U-SCR|UserScoreDebScore emma pool-id score-id))
            (deb-tot:decimal (ref-SCR::UR_SCR|ScoreTotalDebScore score-id))
        )
        (map print
            [
                (format "<(deb ANHD/EMMA/total)> => \"{} {} {}\"" [deb-a deb-e deb-tot])
                (expect (format "<<TX-FVT-09>> ANHD deb got={} expected={}" [deb-a stake-a]) stake-a deb-a)
                (expect (format "<<TX-FVT-09>> EMMA deb got={} expected={}" [deb-e stake-e]) stake-e deb-e)
                (expect (format "<<TX-FVT-09>> total deb got={} expected={}" [deb-tot (+ stake-a stake-e)]) (+ stake-a stake-e) deb-tot)
            ]
        )
        (print "--- [TX-FVT-09 · 02 · inject + both collect] ---")
        (let
            (
                (ouro-a-pre:decimal (ref-DPTF::UR_AccountSupply ouro-id anhd))
                (ouro-e-pre:decimal (ref-DPTF::UR_AccountSupply ouro-id emma))
            )
            (print (format "<(C_Inject {})> => \"{}\"" [inject-amt
                (ref-TS02-C3::AQP-FVT|C_Inject patron fvt-id ouro-id inject-amt)
            ]))
            (print (format "<(C_Collect ANHD)> => \"{}\"" [
                (ref-TS02-C3::AQP-FVT|C_Collect anhd fvt-id 1 score-id ouro-id)
            ]))
            (print (format "<(C_Collect EMMA)> => \"{}\"" [
                (ref-TS02-C3::AQP-FVT|C_Collect emma fvt-id 1 score-id ouro-id)
            ]))
            (let
                (
                    (pay-a:decimal (- (ref-DPTF::UR_AccountSupply ouro-id anhd) (- ouro-a-pre inject-amt)))
                    (pay-e:decimal (- (ref-DPTF::UR_AccountSupply ouro-id emma) ouro-e-pre))
                    (pay-sum:decimal
                        (+
                            (- (ref-DPTF::UR_AccountSupply ouro-id anhd) (- ouro-a-pre inject-amt))
                            (- (ref-DPTF::UR_AccountSupply ouro-id emma) ouro-e-pre)
                        )
                    )
                    (exp-a:decimal (floor (* inject-amt (/ stake-a (+ stake-a stake-e))) 24))
                    (exp-e:decimal (floor (* inject-amt (/ stake-e (+ stake-a stake-e))) 24))
                    (ar-left:decimal (ref-FVT::UR_FVT-RG|AvailableRewards fvt-id ouro-id))
                )
                (map print
                    [
                        (format "<(payouts ANHD/EMMA/sum AR)> => \"{} {} {} {}\"" [pay-a pay-e pay-sum ar-left])
                        (format "<(expected ~ANHD/~EMMA)> => \"{} {}\"" [exp-a exp-e])
                        (expect (format "<<TX-FVT-09>> ANHD payout>0 got={}" [pay-a]) true (> pay-a 0.0))
                        (expect (format "<<TX-FVT-09>> EMMA payout>0 got={}" [pay-e]) true (> pay-e 0.0))
                        (expect (format "<<TX-FVT-09>> ANHD payout≈60% got={} ~{}" [pay-a exp-a]) true (and (>= pay-a (- exp-a 0.000001)) (<= pay-a (+ exp-a 0.000001))))
                        (expect (format "<<TX-FVT-09>> EMMA payout≈40% got={} ~{}" [pay-e exp-e]) true (and (>= pay-e (- exp-e 0.000001)) (<= pay-e (+ exp-e 0.000001))))
                        (expect (format "<<TX-FVT-09>> sum payouts <= inject got={} inject={}" [pay-sum inject-amt]) true (<= pay-sum inject-amt))
                        (expect (format "<<TX-FVT-09>> available-rewards residual small got={}" [ar-left]) true (< ar-left 0.01))
                    ]
                )
            )
        )
    )
)
(print "")
(print (format "<(REPL|env-gas)> TX-FVT-09 after commit => \"{}\"" [(env-gas)]))
(print "")
(env-sigs [])
(commit-tx)
(print "")
(print "=== END TX-FVT-09 ==========================================================")
(print "")
