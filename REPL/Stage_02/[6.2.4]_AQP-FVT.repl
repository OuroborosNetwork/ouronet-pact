;; TX-FVT-05 — Vault inject / collect / second-collect idempotence (score-entity type 1, PLAIN)
(begin-tx "TX-FVT-05 - Vault inject + collect + second collect=0")
(print "")
(print "=== TX-FVT-05 — Vault inject/collect/second-collect (TfStakeVault) ===========")
(namespace "ouronet-ns")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(let
    (
        (patron:string KST.ANHD)
        (owner-id:string KST.ANHD)
        (beneficiary-id:string KST.ANHD)
        (ouro-id:string "OURO-98c486052a51")
        (score-name:string "TfStakeScore")
        (fvt-name:string "TfStakeVault")
        (pool-name:string "TfStakePool")
        (inject-amt:decimal 50.0)
        (ref-U|DALOS:module{UtilityDalosV2} U|DALOS)
        (ref-DPTF:module{DemiourgosPactTrueFungibleV2} DPTF)
        (ref-TS02-C3:module{TalosStageTwo_ClientThreeV2} TS02-C3)
        (ref-SCR:module{AcquisitionScoresV2} AQP-SCORE)
        (ref-FVT:module{AcquisitionFarmsVaultsTreasuriesV2} AQP-FVT)
        (score-id:string (ref-U|DALOS::UDC_Makeid score-name))
        (fvt-id:string (ref-U|DALOS::UDC_Makeid fvt-name))
        (pool-id:string (ref-U|DALOS::UDC_Makeid pool-name))
        (ouro-pre:decimal (ref-DPTF::UR_AccountSupply ouro-id patron))
        (ar-pre:decimal (ref-FVT::UR_FVT-RG|AvailableRewards fvt-id ouro-id))
        (g-pre:decimal (ref-FVT::UR_FVT-RG|CurrentRps fvt-id ouro-id))
    )
    (print "--- [TX-FVT-05 · 01 · inject OURO into vault] ---")
    (enforce (>= ouro-pre inject-amt) "TX-FVT-05: patron needs OURO for inject")
    (env-sigs [{ "key": "PK_AncientHodler", "caps": [] }])
    (print (format "<(TS02-C3.CC_AQP-FVT|Inject amount={})> => \"{}\"" [inject-amt
        (ref-TS02-C3::CC_AQP-FVT|Inject patron fvt-id ouro-id inject-amt)
    ]))
    (let
        (
            (g-post:decimal (ref-FVT::UR_FVT-RG|CurrentRps fvt-id ouro-id))
            (ar-post:decimal (ref-FVT::UR_FVT-RG|AvailableRewards fvt-id ouro-id))
            (ouro-after-inject:decimal (ref-DPTF::UR_AccountSupply ouro-id patron))
        )
        (map print
            [
                (format "<(pre G/AR)> => \"{} {}\"" [g-pre ar-pre])
                (format "<(post-inject G/AR)> => \"{} {}\"" [g-post ar-post])
                (expect (format "<<TX-FVT-05>> G increased got={} pre={}" [g-post g-pre]) true (> g-post g-pre))
                (expect (format "<<TX-FVT-05>> available-rewards got={} expected={}" [ar-post (+ ar-pre inject-amt)]) (+ ar-pre inject-amt) ar-post)
                (expect (format "<<TX-FVT-05>> inject debited OURO got={} expected={}" [ouro-after-inject (- ouro-pre inject-amt)]) (- ouro-pre inject-amt) ouro-after-inject)
            ]
        )
        (print "--- [TX-FVT-05 · 02 · collect once + FULL-cost ground truth (plain reward)] ---")
        ;; GROUND TRUTH: FULL reconstructed collect reader (URCi_CollectFull = payout transfer leg + forced-fix + gas)
        ;; through OI|UDC_DynamicIgnisCost == the REAL IGNIS the patron pays for the Talos CC_Collect. Plain (non-triplet)
        ;; OURO reward, instant-injected lane (no live stream) → payout is drift-free, so reader == exec exactly.
        (let
            (
                (ref-I|OURONET:module{OuronetInfoV2} IGNIS)
                (predicted:decimal
                    (at "ignis-need"
                        (ref-I|OURONET::OI|UDC_DynamicIgnisCost patron
                            (AQP-FVT.URCi_CollectFull patron fvt-id 1 score-id ouro-id))))
                (pre-gas:decimal (ref-DPTF::UR_AccountSupply "GAS-98c486052a51" patron))
            )
            (print (format "<(URCi_CollectFull plain→ignis-need)> = {} ; patron pre-gas = {}" [predicted pre-gas]))
            (print (format "<(TS02-C3.CC_AQP-FVT|Collect type=1)> => \"{}\"" [
                (ref-TS02-C3::CC_AQP-FVT|Collect patron fvt-id 1 score-id ouro-id)
            ]))
            (let ((post-gas:decimal (ref-DPTF::UR_AccountSupply "GAS-98c486052a51" patron)))
                (map print
                    [ (format "<(post-gas)> = {} ; real IGNIS delta = {}" [post-gas (- pre-gas post-gas)])
                      (expect (format "<<TX-FVT-05-COLLECT-GT>> INFO full-cost {} == real IGNIS delta {}"
                          [predicted (- pre-gas post-gas)])
                        predicted (- pre-gas post-gas)) ])))
        (let
            (
                (ouro-after-collect:decimal (ref-DPTF::UR_AccountSupply ouro-id patron))
                (payout:decimal (- ouro-after-collect ouro-after-inject))
                (pending:decimal (ref-FVT::UR_FVT-RU|PendingRewards beneficiary-id fvt-id score-id ouro-id))
                (last-rps:decimal (ref-FVT::UR_FVT-RU|LastRps beneficiary-id fvt-id score-id ouro-id))
                (g-now:decimal (ref-FVT::UR_FVT-RG|CurrentRps fvt-id ouro-id))
                (ar-after:decimal (ref-FVT::UR_FVT-RG|AvailableRewards fvt-id ouro-id))
                (deb-user:decimal (ref-SCR::UR_U-SCR|UserScoreDebScore beneficiary-id pool-id score-id))
                (deb-total:decimal (ref-SCR::UR_SCR|ScoreTotalDebScore score-id))
            )
            (map print
                [
                    (format "<(collect payout)> => \"{}\" deb={}/{} AR={}" [payout deb-user deb-total ar-after])
                    (expect (format "<<TX-FVT-05>> collect payout>0 got={}" [payout]) true (> payout 0.0))
                    (expect (format "<<TX-FVT-05>> pending zeroed got={}" [pending]) 0.0 pending)
                    (expect (format "<<TX-FVT-05>> last-rps==G got={} expected={}" [last-rps g-now]) g-now last-rps)
                    (expect (format "<<TX-FVT-05>> available-rewards decreased got={} pre-inject-ar={}" [ar-after (+ ar-pre inject-amt)]) true (< ar-after (+ ar-pre inject-amt)))
                    (expect (format "<<TX-FVT-05>> payout <= inject got={} inject={}" [payout inject-amt]) true (<= payout inject-amt))
                ]
            )
            (print "--- [TX-FVT-05 · 03 · second collect idempotent] ---")
            (let
                (
                    (ouro-before-2:decimal (ref-DPTF::UR_AccountSupply ouro-id patron))
                )
                (print (format "<(TS02-C3.CC_AQP-FVT|Collect second)> => \"{}\"" [
                    (ref-TS02-C3::CC_AQP-FVT|Collect patron fvt-id 1 score-id ouro-id)
                ]))
                (let
                    (
                        (payout-2:decimal (- (ref-DPTF::UR_AccountSupply ouro-id patron) ouro-before-2))
                    )
                    (map print
                        [
                            (expect (format "<<TX-FVT-05>> second collect payout=0 got={}" [payout-2]) 0.0 payout-2)
                        ]
                    )
                )
            )
        )
    )
)
(print "")
(print (format "<(REPL|env-gas)> TX-FVT-05 after commit => \"{}\"" [(env-gas)]))
(print "")
(env-sigs [])
(commit-tx)
(print "")
(print "=== END TX-FVT-05 ==========================================================")
(print "")
;;||>>>>>>>>>>>>>>>>>>>>>>>>>
;;|| NEXT                   >
;;||>>>>>>>>>>>>>>>>>>>>>>>>>
(print "")
;;
;; TX-FVT-05b — Streamed inject (linear vesting) smoke: CC_InjectStream 240 OURO over 24h; the sole staker (ANHD)
;;   collects ~half at +12h and the exact remainder at +24h (finish flush → stream pruned). Proves the drip's
;;   time-based release, the exact-remainder flush, and compaction. Block-time driven via env-chain-data.
(begin-tx "TX-FVT-05b - streamed inject linear vesting smoke")
(print "")
(print "=== TX-FVT-05b — CC_InjectStream 240 OURO / 24h → collect @12h (~120) + @24h (~120) ===")
(namespace "ouronet-ns")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(let
    (
        (patron:string KST.ANHD)
        (ouro-id:string "OURO-98c486052a51")
        (ref-U|DALOS:module{UtilityDalosV2} U|DALOS)
        (ref-DPTF:module{DemiourgosPactTrueFungibleV2} DPTF)
        (ref-TS02-C3:module{TalosStageTwo_ClientThreeV2} TS02-C3)
        (score-id:string (ref-U|DALOS::UDC_Makeid "TfStakeScore"))
        (fvt-id:string (ref-U|DALOS::UDC_Makeid "TfStakeVault"))
        (pool-id:string (ref-U|DALOS::UDC_Makeid "TfStakePool"))
        (t0:time (time "2026-09-01T00:00:00Z"))
    )
    ;;==== TX-FVT-05b · 01 · inject stream at T0 ====
    (print "--- [TX-FVT-05b · 01 · CC_InjectStream 240 / 24h @ T0] ---")
    (env-chain-data { "block-time": t0 })
    (env-sigs [{ "key": "PK_AncientHodler", "caps": [] }])
    (let ((ouro-pre:decimal (ref-DPTF::UR_AccountSupply ouro-id patron)))
        (print (format "<(CC_AQP-FVT|InjectStream)> => \"{}\"" [(ref-TS02-C3::CC_AQP-FVT|InjectStream patron fvt-id ouro-id 240.0 86400)]))
        (map print
            [ (expect "<<05b>> stream-count = 1 after inject" 1 (AQP-FVT.UR_FVT-RG|StreamCount fvt-id ouro-id))
              (expect "<<05b>> stream-unreleased = 240 after inject" 240.0 (AQP-FVT.UR_FVT-RG|StreamUnreleased fvt-id ouro-id))
              (expect "<<05b>> URC_StreamStatus active-count = 1" 1 (at "active-count" (AQP-FVT.URC_StreamStatus fvt-id ouro-id)))
              (expect "<<05b>> URC_StreamStatus unreleased = 240" 240.0 (at "unreleased" (AQP-FVT.URC_StreamStatus fvt-id ouro-id)))
              (expect (format "<<05b>> inject debited 240 got={}" [(- ouro-pre (ref-DPTF::UR_AccountSupply ouro-id patron))]) 240.0 (- ouro-pre (ref-DPTF::UR_AccountSupply ouro-id patron))) ]))
    (env-sigs [])
    ;;==== TX-FVT-05b · 02 · collect at T0+12h → ~half (120) released to sole staker ====
    (print "--- [TX-FVT-05b · 02 · collect @ T0+12h → ~120] ---")
    (env-chain-data { "block-time": (add-time t0 43200) })
    (env-sigs [{ "key": "PK_AncientHodler", "caps": [] }])
    ;; URC_LiveClaimable must PROJECT ~120 (pre-collect, read-only) and match the actual collect payout below
    (let ((live:decimal (AQP-FVT.URC_LiveClaimable patron fvt-id pool-id 1 score-id ouro-id)))
        (map print
            [ (format "<<05b>> URC_LiveClaimable @12h (pre-collect) = {}" [live])
              (expect (format "<<05b>> URC_LiveClaimable projects ~120 @12h got={}" [live]) true (and (> live 119.99) (< live 120.01))) ]))
    (let ((ouro-pre:decimal (ref-DPTF::UR_AccountSupply ouro-id patron)))
        (print (format "<(CC_Collect @12h)> => \"{}\"" [(ref-TS02-C3::CC_AQP-FVT|Collect patron fvt-id 1 score-id ouro-id)]))
        (let ((payout:decimal (- (ref-DPTF::UR_AccountSupply ouro-id patron) ouro-pre)))
            (map print
                [ (format "<<05b>> payout @12h = {}" [payout])
                  (expect (format "<<05b>> ~half (120) released @12h got={}" [payout]) true (and (> payout 119.99) (< payout 120.01)))
                  (expect "<<05b>> stream still active @12h" 1 (AQP-FVT.UR_FVT-RG|StreamCount fvt-id ouro-id)) ])))
    (env-sigs [])
    ;;==== TX-FVT-05b · 03 · collect at T0+24h (finish) → remaining ~120, stream pruned ====
    (print "--- [TX-FVT-05b · 03 · collect @ T0+24h (finish) → ~120 + prune] ---")
    (env-chain-data { "block-time": (add-time t0 86400) })
    (env-sigs [{ "key": "PK_AncientHodler", "caps": [] }])
    (let ((ouro-pre:decimal (ref-DPTF::UR_AccountSupply ouro-id patron)))
        (print (format "<(CC_Collect @24h)> => \"{}\"" [(ref-TS02-C3::CC_AQP-FVT|Collect patron fvt-id 1 score-id ouro-id)]))
        (let
            (
                (payout:decimal (- (ref-DPTF::UR_AccountSupply ouro-id patron) ouro-pre))
                (unreleased:decimal (AQP-FVT.UR_FVT-RG|StreamUnreleased fvt-id ouro-id))
            )
            (map print
                [ (format "<<05b>> payout @24h = {} ; stream-unreleased = {}" [payout unreleased])
                  (expect (format "<<05b>> remaining ~120 released @24h got={}" [payout]) true (and (> payout 119.99) (< payout 120.01)))
                  (expect "<<05b>> stream pruned @24h (count 0)" 0 (AQP-FVT.UR_FVT-RG|StreamCount fvt-id ouro-id))
                  (expect (format "<<05b>> stream-unreleased flushed to ~0 got={}" [unreleased]) true (< unreleased 0.0000001)) ])))
    (env-sigs [])
)
(commit-tx)
(print "")
(print "=== END TX-FVT-05b =========================================================")
(print "")
;;||>>>>>>>>>>>>>>>>>>>>>>>>>
;;|| NEXT                   >
;;||>>>>>>>>>>>>>>>>>>>>>>>>>
(print "")
