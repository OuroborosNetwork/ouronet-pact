    (print (format "<(TS02-C3.AQP-FVT|C_ToggleScoreEntityLink off)> => \"{}\"" [(ref-TS02-C3::AQP-FVT|C_ToggleScoreEntityLink patron fvt-id 1 score-id false)]))
    (print (format "<(TS02-C3.AQP-FVT|C_ToggleScoreEntityLink on)> => \"{}\"" [(ref-TS02-C3::AQP-FVT|C_ToggleScoreEntityLink patron fvt-id 1 score-id true)]))
    (print "--- [TX-FVT-04 · 02 · post-toggle reads + expect] ---")
