;;
;; REPL/Stage_02/[6.2.4]_AQP-FVT.repl — canonical integration layout (OuronetInformational/ARCHITECTURE/REPL_AND_TESTS.md)
;;   Inter-tx:   ;;|| NEXT >  (same three lines as REPL/Stage_01/[2.2]_Core.repl)
;;   Intra-tx:   ;;==== TX-FVT-nn · mm · <slug> ====  + next-line (print "--- [TX-FVT-nn · mm · …] ---"); mm = 01.. within each (begin-tx …)
;;   format "{}": Talos / module echoes and (env-gas) — document additional prefixes in this file's (print …) lines as needed.
;;
(print "")
(print "================================================================")
(print "FILE  REPL/Stage_02/[6.2.4]_AQP-FVT.repl")
(print "================================================================")
(print "Legend (terminal observability): see ;; preface; echoes use <(…)> where helpful.")
(print "Source: ;;|| NEXT > between txs; ;;==== TX-FVT-nn · mm · … ==== + banner before each begin-tx.")
(print "")
(print "Requires full chain: REPL/Z.repl (Stage 01 DPTF issuance + Stage 02 AQP deploy + [6.2.1]–[6.2.3]).")
(print "TX004 in [6.2.1] strips OURO TF anchors — TX-FVT-01 re-issues one anchor for stake ANK leg.")
(print "FVT lifecycle: C_Issue / C_AddRewardLink / C_AddScoreEntity via Talos AQP-FVT|C_* shells.")
(print "REPL tests: (map print [(expect (format \"<<TX-FVT-nn>> …\" […]) expected actual) …])")
(print "")
(print "===================AQP-FVT TF Stake Test File==========================")
;;
;; TX-FVT-01 — Re-issue one OURO TF anchor (post TX004 strip) + issue class-1 TF score
(begin-tx "TX-FVT-01 - TF anchor + TrueFungible score bootstrap")
(print "")
(print "=== TX-FVT-01 — TF anchor + TrueFungible score ============================")
(namespace "ouronet-ns")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(let
    (
        (patron:string KST.ANHD)
        (owner-konto:string KST.ANHD)
        (ouro-id:string "OURO-98c486052a51")
        (score-name:string "TfStakeScore")
        (boost-class-name:string "TfStakeBoost")
        (ref-DALOS:module{OuronetDalosV2} DALOS)
        (ref-U|DALOS:module{UtilityDalosV2} U|DALOS)
        (ref-TS02-C3:module{TalosStageTwo_ClientThreeV2} TS02-C3)
        (ref-SCR:module{AcquisitionScoresV2} AQP-SCORE)
        (ref-ANK:module{AcquisitionAnchorsV2} AQP-ANK)
        (score-id:string (ref-U|DALOS::UDC_Makeid score-name))
        (anchor-id:string (ref-U|DALOS::UDC_Makeid "TfStakeAnchor"))
        (split-std:[decimal]
            (ref-DALOS::URC_SplitSTOAPrices patron (* 2.0 (ref-DALOS::UR_UsagePrice "standard")))
        )
        (split-smart:[decimal]
            (ref-DALOS::URC_SplitSTOAPrices patron (ref-DALOS::UR_UsagePrice "smart"))
        )
    )
    ;;==== TX-FVT-01 · 01 · env-sigs (standard×2 anchor + smart score) — REPL ======
    (print "--- [TX-FVT-01 · 01 · env-sigs + fee splits] ---")
    (env-sigs
        [
            { "key": "PK_AncientHodler", "caps": [] }
            { "key": "6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263",
              "caps":
                [
                    (coin.TRANSFER
                        "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263"
                        "k:50d6c59b21e5e6e55baecaa75a1007de37576bde12d8230dc82459cc01b9484b"
                        (+ (at 2 split-std) (at 2 split-smart))
                    )
                    (coin.TRANSFER
                        "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263"
                        "k:0cb30c0121ff919266121a99ff9359871818932211df94dae4137c29bc0e8f7e"
                        (+ (at 0 split-std) (at 0 split-smart))
                    )
                    (coin.TRANSFER
                        "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263"
                        "c:XM-pkmuB5XUQlp87ZYSbfKt8qzmHY6O2EHAzMRVBt3k"
                        (+ (at 3 split-std) (at 3 split-smart))
                    )
                    (coin.TRANSFER
                        "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263"
                        "c:iQQFWj6gWtpGEzhM_O5ekW1QtnQQy55R8BRPGhj_0FU"
                        (+ (at 1 split-std) (at 1 split-smart))
                    )
                ]
            }
        ]
    )
    ;;==== TX-FVT-01 · 02 · issue TF anchor on OURO — REPL ==========================
    (print "--- [TX-FVT-01 · 02 · C_IssueTrueFungibleAnchor on OURO] ---")
    (print (format "<(TS02-C3.C_AQP-ANK|IssueTrueFungibleAnchor TfStakeAnchor)> => \"{}\"" [(ref-TS02-C3::C_AQP-ANK|IssueTrueFungibleAnchor patron "TfStakeAnchor" ouro-id true boost-class-name 3 500.0 5000.0)]))
    ;;==== TX-FVT-01 · 03 · issue class-1 TF score — REPL ===========================
    (print "--- [TX-FVT-01 · 03 · C_IssueTrueFungibleScore] ---")
    (print (format "<(TS02-C3.C_AQP-SCR|IssueTrueFungibleScore TfStakeScore)> => \"{}\"" [(ref-TS02-C3::C_AQP-SCR|IssueTrueFungibleScore patron owner-konto score-name 12 1.0)]))
    ;;==== TX-FVT-01 · 04 · post-issue reads + expect — REPL ========================
    (print "--- [TX-FVT-01 · 04 · post-issue reads + expect] ---")
    (let
        (
            (v-class:integer (ref-SCR::UR_SCR|ScoreClass score-id))
            (anchor-live:bool (ref-ANK::UR_ANK|State anchor-id))
        )
        (map print
            [
                (format "<(AQP-SCORE|UR_SCR|ScoreClass TfStakeScore)> => \"{}\"" [v-class])
                (format "<(AQP-ANK|UR_ANK|State TfStakeAnchor)> => \"{}\"" [anchor-live])
            ]
        )
        (map print
            [
                (expect (format "<<TX-FVT-01 expect>> score class got={} expected=1" [v-class]) 1 v-class)
                (expect (format "<<TX-FVT-01 expect>> anchor issued and active got={} expected=true" [anchor-live]) true anchor-live)
            ]
        )
    )
)
(print "")
(print (format "<(REPL|env-gas)> TX-FVT-01 after commit => \"{}\"" [(env-gas)]))
(print "")
(env-sigs [])
(commit-tx)
(print "")
(print "=== END TX-FVT-01 ==========================================================")
(print "")
;;||>>>>>>>>>>>>>>>>>>>>>>>>>
;;|| NEXT                   >
;;||>>>>>>>>>>>>>>>>>>>>>>>>>
(print "")
;;
;; TX-FVT-02 — Seed vault FVT + class-1 OURO pool + employ score
(begin-tx "TX-FVT-02 - Vault FVT seed + class-1 pool + employ score")
(print "")
(print "=== TX-FVT-02 — Vault FVT seed + class-1 pool + employ score ==============")
(namespace "ouronet-ns")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(let
    (
        (patron:string KST.ANHD)
        (owner-konto:string KST.ANHD)
        (ouro-id:string "OURO-98c486052a51")
        (score-name:string "TfStakeScore")
        (fvt-name:string "TfStakeVault")
        (pool-name:string "TfStakePool")
        (fvt-class:integer 1)
        (ref-DALOS:module{OuronetDalosV2} DALOS)
        (ref-U|DALOS:module{UtilityDalosV2} U|DALOS)
        (ref-TS02-C3:module{TalosStageTwo_ClientThreeV2} TS02-C3)
        (ref-SCR:module{AcquisitionScoresV2} AQP-SCORE)
        (ref-AQP:module{AcquisitionPoolsV2} AQP-POOL)
        (ref-FVT:module{AcquisitionFarmsVaultsTreasuriesV2} AQP-FVT)
        (score-id:string (ref-U|DALOS::UDC_Makeid score-name))
        (fvt-id:string (ref-U|DALOS::UDC_Makeid fvt-name))
        (pool-id:string (ref-U|DALOS::UDC_Makeid pool-name))
        (aqp-class:integer 1)
        (split-stoa:[decimal]
            (ref-DALOS::URC_SplitSTOAPrices patron (* 3.0 (ref-DALOS::UR_UsagePrice "smart")))
        )
    )
    ;;==== TX-FVT-02 · 01 · env-sigs (smart pool issue) — REPL =====================
    (print "--- [TX-FVT-02 · 01 · env-sigs + smart fee split] ---")
    (env-sigs
        [
            { "key": "PK_AncientHodler", "caps": [] }
            { "key": "6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263",
              "caps":
                [
                    (coin.TRANSFER
                        "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263"
                        "k:50d6c59b21e5e6e55baecaa75a1007de37576bde12d8230dc82459cc01b9484b"
                        (at 2 split-stoa)
                    )
                    (coin.TRANSFER
                        "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263"
                        "k:0cb30c0121ff919266121a99ff9359871818932211df94dae4137c29bc0e8f7e"
                        (at 0 split-stoa)
                    )
                    (coin.TRANSFER
                        "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263"
                        "c:XM-pkmuB5XUQlp87ZYSbfKt8qzmHY6O2EHAzMRVBt3k"
                        (at 3 split-stoa)
                    )
                    (coin.TRANSFER
                        "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263"
                        "c:iQQFWj6gWtpGEzhM_O5ekW1QtnQQy55R8BRPGhj_0FU"
                        (at 1 split-stoa)
                    )
                ]
            }
        ]
    )
    ;;==== TX-FVT-02 · 02 · issue class-1 pool on OURO + C_AddScore — REPL ===========
    (print "--- [TX-FVT-02 · 02 · C_Issue class-1 pool + C_AddScore] ---")
    (print (format "<(TS02-C3.C_AQP-POOL|Issue class=1 OURO)> => \"{}\"" [(ref-TS02-C3::C_AQP-POOL|Issue patron pool-name ouro-id aqp-class)]))
    (print (format "<(TS02-C3.C_AQP-POOL|AddScore)> => \"{}\"" [(ref-TS02-C3::C_AQP-POOL|AddScore patron pool-id score-id)]))
    ;;==== TX-FVT-02 · 03 · C_Issue vault + C_AddRewardLink + C_AddScoreEntity — REPL =====
    (print "--- [TX-FVT-02 · 03 · C_Issue vault + C_AddRewardLink + C_AddScoreEntity] ---")
    (print (format "<(TS02-C3.C_AQP-FVT|Issue class=1 vault)> => \"{}\"" [(ref-TS02-C3::C_AQP-FVT|Issue patron fvt-name patron fvt-class "|")]))
    (print (format "<(TS02-C3.C_AQP-FVT|AddRewardLink OURO)> => \"{}\"" [(let ((ref-U|CT:module{OuronetConstantsV2} U|CT)) (ref-TS02-C3::C_AQP-FVT|AddRewardLink patron fvt-id ouro-id false (ref-U|CT::CT_BAR)))]))
    (print (format "<(TS02-C3.C_AQP-FVT|AddScoreEntity)> => \"{}\"" [(ref-TS02-C3::C_AQP-FVT|AddScoreEntity patron fvt-id 1 score-id)]))
    ;;==== TX-FVT-02 · 04 · pre-stake readiness reads + expect — REPL ===============
    (print "--- [TX-FVT-02 · 04 · FVT stake-ready reads + expect] ---")
    (let
        (
            (aqpool-link:string (ref-SCR::UR_SCR|ScoreAqpoolLink score-id))
            (fvt-link:string (ref-SCR::UR_SCR|ScoreFvtLink score-id))
            (pool-class:integer (ref-AQP::UR_AQP|PoolAqpClass pool-id))
            (pool-score:string (ref-AQP::UR_AQP|PoolScorePrimary pool-id))
            (sl-enabled:bool (ref-FVT::UR_FVT-SEL|Enabled fvt-id score-id))
            (reward-count:integer (ref-FVT::UR_FVT|EnabledRewardCount fvt-id))
            (fvt-ready:bool (ref-FVT::URC_PoolEmployedScoresFvtStakeReady pool-id))
        )
        (map print
            [
                (format "<(AQP-SCORE|UR_SCR|ScoreAqpoolLink)> => \"{}\"" [aqpool-link])
                (format "<(AQP-SCORE|UR_SCR|ScoreFvtLink)> => \"{}\"" [fvt-link])
                (format "<(AQP-POOL|UR_AQP|PoolAqpClass)> => \"{}\"" [pool-class])
                (format "<(AQP-POOL|UR_AQP|PoolScorePrimary)> => \"{}\"" [pool-score])
                (format "<(AQP-FVT|UR_FVT-SEL|Enabled)> => \"{}\"" [sl-enabled])
                (format "<(AQP-FVT|UR_FVT|EnabledRewardCount)> => \"{}\"" [reward-count])
                (format "<(AQP-FVT|URC_PoolEmployedScoresFvtStakeReady)> => \"{}\"" [fvt-ready])
            ]
        )
        (map print
            [
                (expect (format "<<TX-FVT-02 expect>> aqpool-link got={} expected={}" [aqpool-link pool-id]) pool-id aqpool-link)
                (expect (format "<<TX-FVT-02 expect>> fvt-link got={} expected={}" [fvt-link fvt-id]) fvt-id fvt-link)
                (expect (format "<<TX-FVT-02 expect>> pool class got={} expected=1" [pool-class]) 1 pool-class)
                (expect (format "<<TX-FVT-02 expect>> employed score got={} expected={}" [pool-score score-id]) score-id pool-score)
                (expect (format "<<TX-FVT-02 expect>> ScoreLink enabled got={} expected=true" [sl-enabled]) true sl-enabled)
                (expect (format "<<TX-FVT-02 expect>> enabled-reward-count got={} expected=1" [reward-count]) 1 reward-count)
                (expect (format "<<TX-FVT-02 expect>> URC_PoolEmployedScoresFvtStakeReady got={} expected=true" [fvt-ready]) true fvt-ready)
            ]
        )
    )
)
(print "")
(print (format "<(REPL|env-gas)> TX-FVT-02 after commit => \"{}\"" [(env-gas)]))
(print "")
(env-sigs [])
(commit-tx)
(print "")
(print "=== END TX-FVT-02 ==========================================================")
(print "")
;;||>>>>>>>>>>>>>>>>>>>>>>>>>
;;|| NEXT                   >
;;||>>>>>>>>>>>>>>>>>>>>>>>>>
(print "")
;;
;; TX-FVT-03 — Stake OURO through Talos → FVT::CC_TrueFungibleStakeFlow
(begin-tx "TX-FVT-03 - CC_StakeTrueFungible end-to-end")
(print "")
(print "=== TX-FVT-03 — CC_StakeTrueFungible (full ico1..ico5 recipe) =================")
(namespace "ouronet-ns")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(let
    (
        (patron:string KST.ANHD)
        (owner-id:string KST.ANHD)
        (beneficiary-id:string KST.ANHD)
        (ouro-id:string "OURO-98c486052a51")
        (score-name:string "TfStakeScore")
        (fvt-name:string "TfStakeVault")
        (pool-name:string "TfStakePool")
        (stake-amount:decimal 100.0)
        (ref-U|DALOS:module{UtilityDalosV2} U|DALOS)
        (ref-DPTF:module{DemiourgosPactTrueFungibleV2} DPTF)
        (ref-TS02-C3:module{TalosStageTwo_ClientThreeV2} TS02-C3)
        (ref-AQP:module{AcquisitionPoolsV2} AQP-POOL)
        (ref-SCR:module{AcquisitionScoresV2} AQP-SCORE)
        (ref-FVT:module{AcquisitionFarmsVaultsTreasuriesV2} AQP-FVT)
        (ref-ANK:module{AcquisitionAnchorsV2} AQP-ANK)
        (score-id:string (ref-U|DALOS::UDC_Makeid score-name))
        (fvt-id:string (ref-U|DALOS::UDC_Makeid fvt-name))
        (pool-id:string (ref-U|DALOS::UDC_Makeid pool-name))
        (pre-ouro:decimal (ref-DPTF::UR_AccountSupply ouro-id owner-id))
    )
    ;;==== TX-FVT-03 · 01 · pre-stake OURO balance echo — REPL ======================
    (print "--- [TX-FVT-03 · 01 · pre-stake OURO balance] ---")
    (print (format "<(DPTF|UR_AccountSupply OURO owner)> pre-stake => \"{}\"" [pre-ouro]))
    (enforce (>= pre-ouro stake-amount) "patron needs OURO balance for stake test")
    ;;==== TX-FVT-03 · 02 · env-sigs + CC_StakeTrueFungible — REPL =================
    (print "--- [TX-FVT-03 · 02 · env-sigs + CC_StakeTrueFungible] ---")
    (env-sigs [{ "key": "PK_AncientHodler", "caps": [] }])
    (print (format "<(TS02-C3.CC_AQP-POOL|StakeTrueFungible amount={})> => \"{}\"" [stake-amount (ref-TS02-C3::CC_AQP-POOL|StakeTrueFungible patron pool-id owner-id beneficiary-id ouro-id stake-amount)]))
    ;;==== TX-FVT-03 · 03 · post-stake reads + expect — REPL =======================
    (print "--- [TX-FVT-03 · 03 · post-stake reads + expect] ---")
    (let
        (
            (tracker-bal:decimal (ref-AQP::UR_AQP|DPTFTrackerBalance pool-id ouro-id owner-id beneficiary-id))
            (rollup-bal:decimal (ref-AQP::UR_AQP|BenDptfTotalBalance beneficiary-id ouro-id))
            (deb-user:decimal (ref-SCR::UR_U-SCR|UserScoreDebScore beneficiary-id pool-id score-id))
            (base-user:decimal (ref-SCR::UR_U-SCR|UserScoreBaseScore beneficiary-id pool-id score-id))
            (last-rps:decimal (ref-FVT::UR_FVT-RU|LastRps beneficiary-id fvt-id score-id ouro-id))
            (member-li:decimal (ref-FVT::UR_FVT-RM|MemberDebRps fvt-id score-id ouro-id))
            (post-ouro:decimal (ref-DPTF::UR_AccountSupply ouro-id owner-id))
            (sync-count:integer (ref-AQP::UR_AQP|BenDptfLastAnkSyncCount beneficiary-id ouro-id))
            (unclaimed:integer (ref-FVT::UR_FVT-RG|UnclaimedCount fvt-id ouro-id))
        )
        (map print
            [
                (format "<(AQP-POOL|UR_AQP|DPTFTrackerBalance)> => \"{}\"" [tracker-bal])
                (format "<(AQP-POOL|UR_AQP|BenDptfTotalBalance)> => \"{}\"" [rollup-bal])
                (format "<(AQP-SCORE|UR_U-SCR|UserScoreDebScore)> => \"{}\"" [deb-user])
                (format "<(AQP-SCORE|UR_U-SCR|UserScoreBaseScore)> => \"{}\"" [base-user])
                (format "<(AQP-FVT|UR_FVT-RU|LastRps)> => \"{}\"" [last-rps])
                (format "<(AQP-FVT|UR_FVT-RM|MemberDebRps L_i)> => \"{}\"" [member-li])
                (format "<(AQP-POOL|UR_AQP|BenDptfLastAnkSyncCount)> => \"{}\"" [sync-count])
                (format "<(DPTF|UR_AccountSupply OURO owner)> post-stake => \"{}\"" [post-ouro])
                (format "<(AQP-FVT|UR_FVT-RG|UnclaimedCount)> => \"{}\"" [unclaimed])
            ]
        )
        (map print
            [
                (expect (format "<<TX-FVT-03 expect>> tracker balance got={} expected={}" [tracker-bal stake-amount]) stake-amount tracker-bal)
                (expect (format "<<TX-FVT-03 expect>> beneficiary rollup got={} expected={}" [rollup-bal stake-amount]) stake-amount rollup-bal)
                (expect (format "<<TX-FVT-03 expect>> user deb-score got={} expected={}" [deb-user stake-amount]) stake-amount deb-user)
                (expect (format "<<TX-FVT-03 expect>> user base-score got={} expected={}" [base-user stake-amount]) stake-amount base-user)
                (expect (format "<<TX-FVT-03 expect>> last-rps == member L_i got={} expected={}" [last-rps member-li]) member-li last-rps)
                (expect (format "<<TX-FVT-03 expect>> OURO debited got={} expected={}" [post-ouro (- pre-ouro stake-amount)]) (- pre-ouro stake-amount) post-ouro)
                (expect (format "<<TX-FVT-03 expect>> ank sync count stamped got={} expected>=0" [sync-count]) true (>= sync-count 0))
                (expect (format "<<TX-FVT-03 expect>> unclaimed-count after first stake got={} expected=1" [unclaimed]) 1 unclaimed)
                (expect (format "<<TX-FVT-03 expect>> need-sync false after stake got={}" [(ref-AQP::URC_BenDptfAnchorsNeedSync beneficiary-id ouro-id)]) false (ref-AQP::URC_BenDptfAnchorsNeedSync beneficiary-id ouro-id))
                (expect (format "<<TX-FVT-03 expect>> sync-count==anchors-active got={} expected={}" [sync-count (ref-ANK::UR_AA|AnchorsActive ouro-id)]) (ref-ANK::UR_AA|AnchorsActive ouro-id) sync-count)
            ]
        )
    )
)
(print "")
(print (format "<(REPL|env-gas)> TX-FVT-03 after commit => \"{}\"" [(env-gas)]))
(print "")
(env-sigs [])
(commit-tx)
(print "")
(print "=== END TX-FVT-03 ==========================================================")
(print "")
;;||>>>>>>>>>>>>>>>>>>>>>>>>>
;;|| NEXT                   >
;;||>>>>>>>>>>>>>>>>>>>>>>>>>
(print "")
