;; TX-FVT-06 — Sync repair while staked (issue 2nd OURO TF anchor → C_SyncTrueFungibleAnchors)
(begin-tx "TX-FVT-06 - TF anchor sync repair while staked")
(print "")
(print "=== TX-FVT-06 — C_SyncTrueFungibleAnchors after late TF anchor ==============")
(namespace "ouronet-ns")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(let
    (
        (patron:string KST.ANHD)
        (beneficiary-id:string KST.ANHD)
        (ouro-id:string "OURO-98c486052a51")
        (boost-class-name:string "TfStakeBoost2")
        (ref-DALOS:module{OuronetDalosV2} DALOS)
        (ref-U|DALOS:module{UtilityDalosV2} U|DALOS)
        (ref-TS02-C3:module{TalosStageTwo_ClientThreeV2} TS02-C3)
        (ref-AQP:module{AcquisitionPoolsV2} AQP-POOL)
        (ref-ANK:module{AcquisitionAnchorsV2} AQP-ANK)
        (anchor2-id:string (ref-U|DALOS::UDC_Makeid "TfStakeAnchor2"))
        (sync-needed-pre:bool (ref-AQP::URC_BenDptfAnchorsNeedSync beneficiary-id ouro-id))
        (aa-pre:integer (ref-ANK::UR_AA|AnchorsActive ouro-id))
        (split-std:[decimal]
            (ref-DALOS::URC_SplitSTOAPrices patron (* 2.0 (ref-DALOS::UR_UsagePrice "standard")))
        )
    )
    (print "--- [TX-FVT-06 · 01 · issue 2nd OURO TF anchor while staked] ---")
    (print (format "<(need-sync pre-issue)> => \"{}\" aa={}" [sync-needed-pre aa-pre]))
    (env-sigs
        [
            { "key": "PK_AncientHodler", "caps": [] }
            { "key": "6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263",
              "caps":
                [
                    (coin.TRANSFER "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263" "k:50d6c59b21e5e6e55baecaa75a1007de37576bde12d8230dc82459cc01b9484b" (at 2 split-std))
                    (coin.TRANSFER "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263" "k:0cb30c0121ff919266121a99ff9359871818932211df94dae4137c29bc0e8f7e" (at 0 split-std))
                    (coin.TRANSFER "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263" "c:XM-pkmuB5XUQlp87ZYSbfKt8qzmHY6O2EHAzMRVBt3k" (at 3 split-std))
                    (coin.TRANSFER "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263" "c:iQQFWj6gWtpGEzhM_O5ekW1QtnQQy55R8BRPGhj_0FU" (at 1 split-std))
                ]
            }
        ]
    )
    (print (format "<(C_AQP-ANK|IssueTrueFungibleAnchor TfStakeAnchor2)> => \"{}\"" [
        (ref-TS02-C3::C_AQP-ANK|IssueTrueFungibleAnchor patron "TfStakeAnchor2" ouro-id true boost-class-name 3 250.0 5000.0)
    ]))
    (let
        (
            (need-after-issue:bool (ref-AQP::URC_BenDptfAnchorsNeedSync beneficiary-id ouro-id))
            (aa-post:integer (ref-ANK::UR_AA|AnchorsActive ouro-id))
            (anchor2-live:bool (ref-ANK::UR_ANK|State anchor2-id))
        )
        (map print
            [
                (format "<(need-sync after-issue)> => \"{}\" aa={}" [need-after-issue aa-post])
                (expect (format "<<TX-FVT-06>> 2nd anchor live got={}" [anchor2-live]) true anchor2-live)
                (expect (format "<<TX-FVT-06>> anchors-active increased got={} pre={}" [aa-post aa-pre]) true (> aa-post aa-pre))
                (expect (format "<<TX-FVT-06>> need-sync true after late anchor got={}" [need-after-issue]) true need-after-issue)
            ]
        )
        (print "--- [TX-FVT-06 · 02 · C_SyncTrueFungibleAnchors + FULL-cost ground truth] ---")
        (env-sigs [{ "key": "PK_AncientHodler", "caps": [] }])
        ;; GROUND TRUTH: the FULL reconstructed reader (URCi_SyncTrueFungibleAnchorsFull, ico-ank + ico-meta + ico-gas)
        ;; run through the SAME OI|UDC_DynamicIgnisCost path AQP-INFO uses == the REAL IGNIS the patron pays for the
        ;; Talos exec (which bills the concatenated exec cumulator). Proves reader == exec (INFO no longer understated).
        (let
            (
                (ref-I|OURONET:module{OuronetInfoV2} IGNIS)
                (ref-DPTF2:module{DemiourgosPactTrueFungibleV2} DPTF)
                (predicted:decimal
                    (at "ignis-need"
                        (ref-I|OURONET::OI|UDC_DynamicIgnisCost patron
                            (AQP-POOL.URCi_SyncTrueFungibleAnchorsFull beneficiary-id ouro-id))))
                (pre-gas:decimal (ref-DPTF2::UR_AccountSupply "GAS-98c486052a51" patron))
            )
            (print (format "<(URCi_SyncTrueFungibleAnchorsFull→ignis-need)> = {} ; patron pre-gas = {}" [predicted pre-gas]))
            (print (format "<(C_AQP-POOL|SyncTrueFungibleAnchors)> => \"{}\"" [
                (ref-TS02-C3::C_AQP-POOL|SyncTrueFungibleAnchors patron beneficiary-id ouro-id)
            ]))
            (let ((post-gas:decimal (ref-DPTF2::UR_AccountSupply "GAS-98c486052a51" patron)))
                (map print
                    [ (format "<(post-gas)> = {} ; real IGNIS delta = {}" [post-gas (- pre-gas post-gas)])
                      (expect (format "<<TX-FVT-06-GT>> INFO full-cost {} == real IGNIS delta {}"
                          [predicted (- pre-gas post-gas)])
                        predicted (- pre-gas post-gas)) ])))
        (let
            (
                (need-after-sync:bool (ref-AQP::URC_BenDptfAnchorsNeedSync beneficiary-id ouro-id))
                (sync-count:integer (ref-AQP::UR_AQP|BenDptfLastAnkSyncCount beneficiary-id ouro-id))
                (aa-now:integer (ref-ANK::UR_AA|AnchorsActive ouro-id))
            )
            (map print
                [
                    (format "<(need-sync after-sync)> => \"{}\" sync-count={} aa={}" [need-after-sync sync-count aa-now])
                    (expect (format "<<TX-FVT-06>> need-sync false after sync got={}" [need-after-sync]) false need-after-sync)
                    (expect (format "<<TX-FVT-06>> sync-count==anchors-active got={} expected={}" [sync-count aa-now]) aa-now sync-count)
                ]
            )
        )
    )
)
(print "")
(print (format "<(REPL|env-gas)> TX-FVT-06 after commit => \"{}\"" [(env-gas)]))
(print "")
(env-sigs [])
(commit-tx)
(print "")
(print "=== END TX-FVT-06 ==========================================================")
(print "")
