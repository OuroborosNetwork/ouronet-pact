    (print (format "<(TS02-C3.C_AQP-FVT|ToggleScoreEntityLink on)> => \"{}\"" [(ref-TS02-C3::C_AQP-FVT|ToggleScoreEntityLink patron fvt-id 1 score-id true)]))
    (print "--- [TX-FVT-04 · 02 · post-toggle reads + expect] ---")
