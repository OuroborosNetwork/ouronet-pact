;; TX-FVT-09 — Multi-staker vault inject/collect fairness (ANHD 60 + EMMA 40)
(begin-tx "TX-FVT-09 - Multi-staker vault inject/collect fairness")
(print "")
(print "=== TX-FVT-09 — Two stakers share vault inject by deb weight ===============")
(namespace "ouronet-ns")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(let
    (
        (patron:string KST.ANHD)
        (anhd:string KST.ANHD)
        (emma:string KST.EMMA)
        (ouro-id:string "OURO-98c486052a51")
        (score-name:string "TfStakeScore")
        (fvt-name:string "TfStakeVault")
        (pool-name:string "TfStakePool")
        (stake-a:decimal 60.0)
        (stake-e:decimal 40.0)
        (inject-amt:decimal 100.0)
        (ref-U|DALOS:module{UtilityDalosV2} U|DALOS)
        (ref-DPTF:module{DemiourgosPactTrueFungibleV2} DPTF)
        (ref-TS01-C1:module{TalosStageOne_ClientOneV2} TS01-C1)
        (ref-TS02-C3:module{TalosStageTwo_ClientThreeV2} TS02-C3)
        (ref-SCR:module{AcquisitionScoresV2} AQP-SCORE)
        (ref-FVT:module{AcquisitionFarmsVaultsTreasuriesV2} AQP-FVT)
        (score-id:string (ref-U|DALOS::UDC_Makeid score-name))
        (fvt-id:string (ref-U|DALOS::UDC_Makeid fvt-name))
        (pool-id:string (ref-U|DALOS::UDC_Makeid pool-name))
        (emma-ouro:decimal (ref-DPTF::UR_AccountSupply ouro-id emma))
        (anhd-ouro:decimal (ref-DPTF::UR_AccountSupply ouro-id anhd))
    )
    (print "--- [TX-FVT-09 · 01 · dual stake ANHD 60 + EMMA 40] ---")
    (enforce (>= anhd-ouro (+ stake-a (+ stake-e inject-amt))) "TX-FVT-09: ANHD needs OURO for fund+stake+inject")
    (env-sigs
        [
            { "key": "PK_AncientHodler", "caps": [] }
            { "key": "PK_Emma", "caps": [] }
        ]
    )
    (if (< emma-ouro stake-e)
        (print (format "<(DPTF C_Transfer OURO ANHD→EMMA {})> => \"{}\"" [stake-e
            (ref-TS01-C1::C_DPTF|Transfer patron ouro-id anhd emma stake-e true)
        ]))
        true
    )
    (print (format "<(CC_StakeTrueFungible ANHD {})> => \"{}\"" [stake-a
        (ref-TS02-C3::CC_AQP-POOL|StakeTrueFungible patron pool-id anhd anhd ouro-id stake-a)
    ]))
    (print (format "<(CC_StakeTrueFungible EMMA {})> => \"{}\"" [stake-e
        (ref-TS02-C3::CC_AQP-POOL|StakeTrueFungible patron pool-id emma emma ouro-id stake-e)
    ]))
    (let
        (
            (deb-a:decimal (ref-SCR::UR_U-SCR|UserScoreDebScore anhd pool-id score-id))
            (deb-e:decimal (ref-SCR::UR_U-SCR|UserScoreDebScore emma pool-id score-id))
            (deb-tot:decimal (ref-SCR::UR_SCR|ScoreTotalDebScore score-id))
        )
        (map print
            [
                (format "<(deb ANHD/EMMA/total)> => \"{} {} {}\"" [deb-a deb-e deb-tot])
                (expect (format "<<TX-FVT-09>> ANHD deb got={} expected={}" [deb-a stake-a]) stake-a deb-a)
                (expect (format "<<TX-FVT-09>> EMMA deb got={} expected={}" [deb-e stake-e]) stake-e deb-e)
                (expect (format "<<TX-FVT-09>> total deb got={} expected={}" [deb-tot (+ stake-a stake-e)]) (+ stake-a stake-e) deb-tot)
            ]
        )
        (print "--- [TX-FVT-09 · 02 · inject + both collect] ---")
        (let
            (
                (ouro-a-pre:decimal (ref-DPTF::UR_AccountSupply ouro-id anhd))
                (ouro-e-pre:decimal (ref-DPTF::UR_AccountSupply ouro-id emma))
            )
            (print (format "<(C_Inject {})> => \"{}\"" [inject-amt
                (ref-TS02-C3::CC_AQP-FVT|Inject patron fvt-id ouro-id inject-amt)
            ]))
            (print (format "<(CC_Collect ANHD)> => \"{}\"" [
                (ref-TS02-C3::CC_AQP-FVT|Collect anhd fvt-id 1 score-id ouro-id)
            ]))
            (print (format "<(CC_Collect EMMA)> => \"{}\"" [
                (ref-TS02-C3::CC_AQP-FVT|Collect emma fvt-id 1 score-id ouro-id)
            ]))
            (let
                (
                    (pay-a:decimal (- (ref-DPTF::UR_AccountSupply ouro-id anhd) (- ouro-a-pre inject-amt)))
                    (pay-e:decimal (- (ref-DPTF::UR_AccountSupply ouro-id emma) ouro-e-pre))
                    (pay-sum:decimal
                        (+
                            (- (ref-DPTF::UR_AccountSupply ouro-id anhd) (- ouro-a-pre inject-amt))
                            (- (ref-DPTF::UR_AccountSupply ouro-id emma) ouro-e-pre)
                        )
                    )
                    (exp-a:decimal (floor (* inject-amt (/ stake-a (+ stake-a stake-e))) 24))
                    (exp-e:decimal (floor (* inject-amt (/ stake-e (+ stake-a stake-e))) 24))
                    (ar-left:decimal (ref-FVT::UR_FVT-RG|AvailableRewards fvt-id ouro-id))
                )
                (map print
                    [
                        (format "<(payouts ANHD/EMMA/sum AR)> => \"{} {} {} {}\"" [pay-a pay-e pay-sum ar-left])
                        (format "<(expected ~ANHD/~EMMA)> => \"{} {}\"" [exp-a exp-e])
                        (expect (format "<<TX-FVT-09>> ANHD payout>0 got={}" [pay-a]) true (> pay-a 0.0))
                        (expect (format "<<TX-FVT-09>> EMMA payout>0 got={}" [pay-e]) true (> pay-e 0.0))
                        (expect (format "<<TX-FVT-09>> ANHD payout≈60% got={} ~{}" [pay-a exp-a]) true (and (>= pay-a (- exp-a 0.000001)) (<= pay-a (+ exp-a 0.000001))))
                        (expect (format "<<TX-FVT-09>> EMMA payout≈40% got={} ~{}" [pay-e exp-e]) true (and (>= pay-e (- exp-e 0.000001)) (<= pay-e (+ exp-e 0.000001))))
                        (expect (format "<<TX-FVT-09>> sum payouts <= inject got={} inject={}" [pay-sum inject-amt]) true (<= pay-sum inject-amt))
                        (expect (format "<<TX-FVT-09>> available-rewards residual small got={}" [ar-left]) true (< ar-left 0.01))
                    ]
                )
            )
        )
    )
)
(print "")
(print (format "<(REPL|env-gas)> TX-FVT-09 after commit => \"{}\"" [(env-gas)]))
(print "")
(env-sigs [])
(commit-tx)
(print "")
(print "=== END TX-FVT-09 ==========================================================")
(print "")
;;||>>>>>>>>>>>>>>>>>>>>>>>>>
;;|| NEXT                   >
;;||>>>>>>>>>>>>>>>>>>>>>>>>>
(print "")
;;
(begin-tx "TX-FVT-10 - M5 non-self TF stake/unstake (owner ANHD, foreign beneficiary EMMA)")
(print "")
(print "=== TX-FVT-10 — M5 foreign-beneficiary TF stake/unstake (no stranding) ======")
(namespace "ouronet-ns")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(env-sigs [{ "key": "PK_AncientHodler", "caps": [] }])
(let
    (
        (patron:string KST.ANHD)
        (owner-id:string KST.ANHD)
        (foreign-ben:string KST.EMMA)
        (ouro-id:string "OURO-98c486052a51")
        (score-name:string "TfStakeScore")
        (pool-name:string "TfStakePool")
        (stake-amount:decimal 50.0)
        (ref-U|DALOS:module{UtilityDalosV2} U|DALOS)
        (ref-DPTF:module{DemiourgosPactTrueFungibleV2} DPTF)
        (ref-TS02-C3:module{TalosStageTwo_ClientThreeV2} TS02-C3)
        (ref-AQP:module{AcquisitionPoolsV2} AQP-POOL)
        (ref-SCR:module{AcquisitionScoresV2} AQP-SCORE)
        (score-id:string (ref-U|DALOS::UDC_Makeid score-name))
        (pool-id:string (ref-U|DALOS::UDC_Makeid pool-name))
        ;; Deltas (robust to FVT-09's ANHD self-stake leftover in TfStakePool):
        (pre-owner-supply:decimal (ref-DPTF::UR_AccountSupply ouro-id owner-id))
        (pre-ben-bal:decimal (ref-AQP::UR_AQP|DPTFTrackerBalance pool-id ouro-id owner-id foreign-ben))
        (pre-emma-deb:decimal (ref-SCR::UR_U-SCR|UserScoreDebScore foreign-ben pool-id score-id))
        (pre-anhd-deb:decimal (ref-SCR::UR_U-SCR|UserScoreDebScore owner-id pool-id score-id))
    )
    (enforce (>= pre-owner-supply stake-amount) "TX-FVT-10: owner needs OURO for the non-self proof")
    (ref-TS02-C3::C_AQP-POOL|EnablePoolStake patron pool-id)
    ;;==== TX-FVT-10 · 01 · owner ANHD stakes FOR foreign beneficiary EMMA ====
    (print "--- [TX-FVT-10 · 01 · stake owner=ANHD, beneficiary=EMMA] ---")
    (ref-TS02-C3::CC_AQP-POOL|StakeTrueFungible patron pool-id owner-id foreign-ben ouro-id stake-amount)
    (let
        (
            (post-ben-bal:decimal (ref-AQP::UR_AQP|DPTFTrackerBalance pool-id ouro-id owner-id foreign-ben))
            (post-emma-deb:decimal (ref-SCR::UR_U-SCR|UserScoreDebScore foreign-ben pool-id score-id))
            (post-anhd-deb:decimal (ref-SCR::UR_U-SCR|UserScoreDebScore owner-id pool-id score-id))
        )
        (map print
            [
                (format "<(TX-FVT-10 (owner,EMMA) row Δ / EMMA deb Δ / ANHD deb Δ)> => {} / {} / {}" [(- post-ben-bal pre-ben-bal) (- post-emma-deb pre-emma-deb) (- post-anhd-deb pre-anhd-deb)])
                (expect (format "<<TX-FVT-10>> stake landed at (owner, FOREIGN beneficiary EMMA) row Δ={} expected={}" [(- post-ben-bal pre-ben-bal) stake-amount]) stake-amount (- post-ben-bal pre-ben-bal))
                (expect (format "<<TX-FVT-10>> FOREIGN beneficiary EMMA earns weight (deb up) Δ={}" [(- post-emma-deb pre-emma-deb)]) true (> post-emma-deb pre-emma-deb))
                (expect (format "<<TX-FVT-10>> owner ANHD earns NOTHING from a non-self stake (deb unchanged) got={} pre={}" [post-anhd-deb pre-anhd-deb]) pre-anhd-deb post-anhd-deb)
            ]
        )
    )
    ;;==== TX-FVT-10 · 02 · non-self unstake removes EMMA's weight + clears the foreign row ====
    (print "--- [TX-FVT-10 · 02 · unstake owner=ANHD, beneficiary=EMMA] ---")
    (ref-TS02-C3::CC_AQP-POOL|UnstakeTrueFungible patron pool-id owner-id foreign-ben ouro-id stake-amount)
    (let
        (
            (post2-ben-bal:decimal (ref-AQP::UR_AQP|DPTFTrackerBalance pool-id ouro-id owner-id foreign-ben))
            (post2-emma-deb:decimal (ref-SCR::UR_U-SCR|UserScoreDebScore foreign-ben pool-id score-id))
        )
        (map print
            [
                (format "<(TX-FVT-10 post ben-bal / EMMA deb)> => {} / {}" [post2-ben-bal post2-emma-deb])
                (expect (format "<<TX-FVT-10>> foreign tracker back to pre after non-self unstake got={} expected={}" [post2-ben-bal pre-ben-bal]) pre-ben-bal post2-ben-bal)
                (expect (format "<<TX-FVT-10>> EMMA weight removed on unstake (deb back to pre) got={} expected={}" [post2-emma-deb pre-emma-deb]) pre-emma-deb post2-emma-deb)
            ]
        )
    )
)
(env-sigs [])
(commit-tx)
(print "=== END TX-FVT-10 ==========================================================")
(print "")
