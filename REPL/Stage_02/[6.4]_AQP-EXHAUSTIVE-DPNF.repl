(begin-tx "TX-AQP-NF03 - DHBunnies KBN NF stake + SubsidiaryBunnies deb")
(print "")
(print "=== TX-AQP-NF03 — EMMA stakes KBN bunny on DHBunnies pool (creator/creator) =====")
(namespace "ouronet-ns")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(let
    (
        (patron:string KST.ANHD)
        (owner:string KST.EMMA)
        (beneficiary:string KST.EMMA)
        (kbn-id:string "KBN-98c486052a51")
        (ref-U|DALOS:module{UtilityDalosV2} U|DALOS)
        (ref-DPDC:module{DpdcV2} DPDC)
        (ref-TS02-C3:module{TalosStageTwo_ClientThreeV2} TS02-C3)
        (ref-SCR:module{AcquisitionScoresV2} AQP-SCORE)
        (pool-id:string (ref-U|DALOS::UDC_Makeid "DHBunnies"))
        (score-id:string (ref-U|DALOS::UDC_Makeid "SubsidiaryBunnies"))
        (nonces:[integer] (ref-DPDC::URH_AccountNonces owner kbn-id false))
    )
    (env-sigs
        [
            { "key": "PK_AncientHodler", "caps": [] }
            { "key": "PK_Emma", "caps": [] }
            { "key": "PK_Lumy", "caps": [] }
        ]
    )
    (if (> (length nonces) 0)
        (let
            (
                (stake-nonce:integer (at 0 nonces))
            )
            (print (format "<(C_StakeNonFungible KBN bunny nonce={})> => \"{}\"" [stake-nonce
                (ref-TS02-C3::AQP-POOL|CC_StakeNonFungibleCollectable patron pool-id owner beneficiary kbn-id [stake-nonce])
            ]))
            (let
                (
                    (deb:decimal (ref-SCR::UR_U-SCR|UserScoreDebScore beneficiary pool-id score-id))
                    (total:decimal (ref-SCR::UR_SCR|ScoreTotalDebScore score-id))
                )
                (map print
                    [
                        (format "<(SubsidiaryBunnies deb)> => \"{}\" <(total)> => \"{}\"" [deb total])
                    ]
                )
            )
        )
        (print "SKIP TX-AQP-NF03: EMMA has no KBN nonces (PopulateBunnies mints to collection creator)")
    )
)
(env-sigs [])
(commit-tx)
(print "")
;;
(begin-tx "TX-AQP-NF04 - Subsidiary treasury Auryn inject after DPNF denominators")
(print "")
(print "=== TX-AQP-NF04 — SubsidiaryTreasury inject after NF + SF denominators ======")
(namespace "ouronet-ns")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(let
    (
        (patron:string KST.ANHD)
        (auryn-id:string "AURYN-98c486052a51")
        (ref-U|DALOS:module{UtilityDalosV2} U|DALOS)
        (ref-TS02-C3:module{TalosStageTwo_ClientThreeV2} TS02-C3)
        (ref-FVT:module{AcquisitionFarmsVaultsTreasuriesV2} AQP-FVT)
        (ref-SCR:module{AcquisitionScoresV2} AQP-SCORE)
        (fvt-id:string (ref-U|DALOS::UDC_Makeid "SubsidiaryTreasury"))
        (sub-bunnies:string (ref-U|DALOS::UDC_Makeid "SubsidiaryBunnies"))
        (inject-amt:decimal 100.0)
        (total-bunnies:decimal (ref-SCR::UR_SCR|ScoreTotalDebScore sub-bunnies))
        ;; #12a: this injects into the SAME SubsidiaryTreasury/AURYN as [6.3] TX-AQP-C04, so available-rewards
        ;; already carries that accumulation. Assert the DELTA of THIS inject == inject-amt (proves no leak),
        ;; not an absolute (which wrongly assumed a fresh treasury).
        (ar-before:decimal (ref-FVT::UR_FVT-RG|AvailableRewards fvt-id auryn-id))
    )
    (env-sigs [{ "key": "PK_AncientHodler", "caps": [] }])
    (if (> total-bunnies 0.0)
        (do
            (print (format "<(C_Inject Auryn subsidiary {})> => \"{}\"" [inject-amt
                (ref-TS02-C3::AQP-FVT|CC_Inject patron fvt-id auryn-id inject-amt)
            ]))
            (let
                (
                    (ar:decimal (ref-FVT::UR_FVT-RG|AvailableRewards fvt-id auryn-id))
                    (denom:decimal (ref-FVT::URC_InjectDenominator fvt-id))
                )
                (map print
                    [
                        (format "<(subsidiary inject denominator)> => \"{}\"" [denom])
                        (format "<(NF04 available-rewards before/after)> => {} / {}" [ar-before ar])
                        (expect (format "<<TX-AQP-NF04>> available-rewards DELTA == inject got={} expected={}" [(- ar ar-before) inject-amt]) inject-amt (- ar ar-before))
                    ]
                )
            )
        )
        (print "NOTE: TX-AQP-NF04 inject skipped — SubsidiaryBunnies total-deb=0")
    )
)
(env-sigs [])
(commit-tx)
(print "")
;;||>>>>>>>>>>>>>>>>>>>>>>>>>
;;|| NEXT                   >
;;||>>>>>>>>>>>>>>>>>>>>>>>>>
(print "")
(begin-tx "TX-AQP-NF-NEGDEF - negative NF trait definition score rejected (L7 #19)")
(print "")
(print "=== TX-AQP-NF-NEGDEF — negative NF trait score value rejected at definition (#19) ==")
(namespace "ouronet-ns")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
;; SubsidiaryBunnies (class-4 DPNF NF score, owner ANHD, precision 6; AQP-BOOT Step 5) + KBN DPNF (nonce 1
;; minted by PopulateBunnies) exist here. UEV_NonFungibleScoreDefinitionTrait enforces, per trait, the fold
;; [iz-key-present (>= l4 2) (<= l4 256) precision-conform (>= v 0.0)]. The precondition assert below proves
;; "Rarity" IS a key in KBN nonce-1 metadata (iz-key-present = true); with value "Common" (len 6) and a
;; precision-6-conform score, the ONLY condition that can reject v=-1.0 is the L7 #19 non-negativity guard
;; (02_SCORE.pact:2722) — non-vacuous by construction. Completes #19 def-score coverage across all three
;; surviving guards: SF nonce ([6.2.2]), NF set-class ([6.2.10]), NF trait (here).
(env-sigs [{ "key": "PK_AncientHodler", "caps": [] }])
(let
    (
        (patron:string KST.ANHD)
        (kbn-id:string "KBN-98c486052a51")
        (ref-U|DALOS:module{UtilityDalosV2} U|DALOS)
        (ref-DPDC:module{DpdcV2} DPDC)
        (ref-TS02-C3:module{TalosStageTwo_ClientThreeV2} TS02-C3)
        (score-id:string (ref-U|DALOS::UDC_Makeid "SubsidiaryBunnies"))
        (nonce1-meta:object (ref-DPDC::UR_N|RawMetaData (ref-DPDC::UR_NativeNonceData kbn-id false 1)))
    )
    (map print
        [
            (expect
                "<<TX-AQP-NF-NEGDEF>> precondition: KBN nonce-1 metadata has trait key 'Rarity' (iz-key-present true)"
                true (contains "Rarity" nonce1-meta))
            (expect-failure
                (format "<<TX-AQP-NF-NEGDEF>> negative NF trait score value (-1.0) rejected at definition (#19)" [])
                (ref-TS02-C3::AQP-SCR|C_IssueNonFungibleScoreDefinition patron score-id kbn-id ["Rarity"] ["Common"] [-1.0]))
        ]
    )
)
(env-sigs [])
(commit-tx)
(print "=== END TX-AQP-NF-NEGDEF ====================================================")
(print "")
;;||>>>>>>>>>>>>>>>>>>>>>>>>>
;;|| NEXT                   >
;;||>>>>>>>>>>>>>>>>>>>>>>>>>
(print "")
(begin-tx "TX-AQP-M1 - DPNF model-1 point-read scoring correctness (#FP0 validation)")
(print "")
(print "=== TX-AQP-M1 — model-1 NF trait scoring via TraitKeys aggregate + point reads (#FP0) ==")
(namespace "ouronet-ns")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
;; #FP0 validation. KBN (PopulateBunnies) nonce 1 = {Rarity:Common, Background:"Movie Set", ...},
;; nonce 25 = {Rarity:Legendary, Background:"Legendary Photo Shoot", ...}, both ANHD-owned. We issue a
;; model-1 (definition) NF score on KBN, define trait scores, and assert the point-read raw base delta:
;;   Rarity Common=50, Rarity Legendary=9999, Background "Movie Set"=10.
;; nonce1 => Common(50)+Movie Set(10) = 60  (Legendary EXCLUDED — proves per-nonce point-read of the
;;           CORRECT (key,value) def, not a sum-over-all-defs scan; and that the TraitKeys aggregate was
;;           populated with Rarity+Background at def-issuance).
;; nonce25 => Legendary(9999)+"Legendary Photo Shoot"(undefined=>0) = 9999 (proves it picks Legendary for
;;           THIS nonce, and undefined (key,value) => 0). No class def => class-part = 0 (class-rev 0 branch).
(let
    (
        (patron:string KST.ANHD)
        (owner-id:string KST.ANHD)
        (kbn-id:string "KBN-98c486052a51")
        (ref-DALOS:module{OuronetDalosV2} DALOS)
        (ref-U|DALOS:module{UtilityDalosV2} U|DALOS)
        (ref-TS02-C3:module{TalosStageTwo_ClientThreeV2} TS02-C3)
        (ref-SCR:module{AcquisitionScoresV2} AQP-SCORE)
        (score-id:string (ref-U|DALOS::UDC_Makeid "M1Probe"))
        (split-smart:[decimal]
            (ref-DALOS::URC_SplitSTOAPrices patron (* 2.0 (ref-DALOS::UR_UsagePrice "smart")))
        )
    )
    ;; issue the model-1 (definition-mode) class-4 NF score on KBN, precision 6 (STOA smart fee → coin caps)
    (env-sigs
        [
            { "key": "PK_AncientHodler", "caps": [] }
            { "key": "6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263",
              "caps":
                [
                    (coin.TRANSFER "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263" "k:50d6c59b21e5e6e55baecaa75a1007de37576bde12d8230dc82459cc01b9484b" (at 2 split-smart))
                    (coin.TRANSFER "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263" "k:0cb30c0121ff919266121a99ff9359871818932211df94dae4137c29bc0e8f7e" (at 0 split-smart))
                    (coin.TRANSFER "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263" "c:XM-pkmuB5XUQlp87ZYSbfKt8qzmHY6O2EHAzMRVBt3k" (at 3 split-smart))
                    (coin.TRANSFER "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263" "c:iQQFWj6gWtpGEzhM_O5ekW1QtnQQy55R8BRPGhj_0FU" (at 1 split-smart))
                ]
            }
        ]
    )
    (print (format "<(AQP-SCR|C_IssueNonFungibleScore M1Probe model=1)> => \"{}\"" [
        (ref-TS02-C3::AQP-SCR|C_IssueNonFungibleScore patron owner-id "M1Probe" 6 1)]))
    ;; trait definitions (IGNIS only → plain ANHD sig)
    (env-sigs [{ "key": "PK_AncientHodler", "caps": [] }])
    (print (format "<(AQP-SCR|C_IssueNonFungibleScoreDefinition Rarity/Background)> => \"{}\"" [
        (ref-TS02-C3::AQP-SCR|C_IssueNonFungibleScoreDefinition patron score-id kbn-id
            ["Rarity" "Rarity" "Background"] ["Common" "Legendary" "Movie Set"] [50.0 9999.0 10.0])]))
    ;;==== TX-AQP-M1 · 01 · point-read scoring assertions ====
    (print "--- [TX-AQP-M1 · 01 · point-read scoring assertions] ---")
    (map print
        [
            (expect (format "<<TX-AQP-M1>> nonce1 (Common 50 + Movie Set 10) base = 60.0 got={}" [(ref-SCR::URC_SignedBaseDeltaForDpnfStake score-id kbn-id [1] [1] true)])
                60.0 (ref-SCR::URC_SignedBaseDeltaForDpnfStake score-id kbn-id [1] [1] true))
            (expect (format "<<TX-AQP-M1>> nonce25 (Legendary 9999) base = 9999.0 got={}" [(ref-SCR::URC_SignedBaseDeltaForDpnfStake score-id kbn-id [25] [1] true)])
                9999.0 (ref-SCR::URC_SignedBaseDeltaForDpnfStake score-id kbn-id [25] [1] true))
            (expect (format "<<TX-AQP-M1>> batch [1,25] = 60 + 9999 = 10059.0 got={}" [(ref-SCR::URC_SignedBaseDeltaForDpnfStake score-id kbn-id [1 25] [1 1] true)])
                10059.0 (ref-SCR::URC_SignedBaseDeltaForDpnfStake score-id kbn-id [1 25] [1 1] true))
            (expect (format "<<TX-AQP-M1>> nonce1 unstake (direction false) = -60.0 got={}" [(ref-SCR::URC_SignedBaseDeltaForDpnfStake score-id kbn-id [1] [1] false)])
                -60.0 (ref-SCR::URC_SignedBaseDeltaForDpnfStake score-id kbn-id [1] [1] false))
        ]
    )
)
(env-sigs [])
(commit-tx)
(print "=== END TX-AQP-M1 ===========================================================")
(print "")
(print "=== END [6.4]_AQP-EXHAUSTIVE-DPNF.repl ======================================")
