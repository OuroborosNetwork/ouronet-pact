;;
;; REPL/Stage_02/[6.4]_AQP-EXHAUSTIVE-DPNF.repl — Bloodshed / Nosferatu / Bunnies pool NF stakes
;; Requires full population ([5.1]/[5.2]/[5.4]) + AQP-BOOT Step7b DPNF pools.
;;
(print "")
(print "================================================================")
(print "FILE  REPL/Stage_02/[6.4]_AQP-EXHAUSTIVE-DPNF.repl")
(print "================================================================")
(print "")
;;
(begin-tx "TX-AQP-NF01 - DHBloodshed NF stake + subsidiary score deb")
(print "")
(print "=== TX-AQP-NF01 — EMMA stakes DHB nonce on DHBloodshed pool ================")
(namespace "ouronet-ns")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(let
    (
        (patron:string KST.ANHD)
        (owner:string KST.EMMA)
        (beneficiary:string KST.EMMA)
        (dhb-id:string "DHB-98c486052a51")
        (ref-U|DALOS:module{UtilityDalosV1} U|DALOS)
        (ref-DPDC:module{DpdcV1} DPDC)
        (ref-TS02-C3:module{TalosStageTwo_ClientThreeV1} TS02-C3)
        (ref-SCR:module{AcquisitionScoresV1} AQP-SCORE)
        (pool-id:string (ref-U|DALOS::UDC_Makeid "DHBloodshed"))
        (score-main:string (ref-U|DALOS::UDC_Makeid "Bloodshed"))
        (score-sub:string (ref-U|DALOS::UDC_Makeid "SubsidiaryBloodshed"))
        (nonces:[integer] (ref-DPDC::URD_AccountNonces owner dhb-id false))
        (stake-nonce:integer (at 0 nonces))
    )
    (env-sigs
        [
            { "key": "PK_AncientHodler", "caps": [] }
            { "key": "PK_Emma", "caps": [] }
            { "key": "PK_Lumy", "caps": [] }
        ]
    )
    (enforce (> (length nonces) 0) "EMMA needs DHB nonces from PopulateBloodshed")
    (print (format "<(C_StakeNonFungible DHB nonce={})> => \"{}\"" [stake-nonce
        (ref-TS02-C3::AQP-POOL|C_StakeNonFungibleCollectable patron pool-id owner beneficiary dhb-id [stake-nonce])
    ]))
    (let
        (
            (deb-main:decimal (ref-SCR::UR_U-SCR|UserScoreDebScore beneficiary pool-id score-main))
            (deb-sub:decimal (ref-SCR::UR_U-SCR|UserScoreDebScore beneficiary pool-id score-sub))
        )
        (print (format "<(SubsidiaryBloodshed deb)> => \"{}\"" [deb-sub]))
        (print "<<TX-AQP-NF01>> stake ok; deb scoring may need ANK sync on DPNF class")
    )
)
(env-sigs [])
(commit-tx)
(print "")
