;;
;; REPL/Stage_02/[6.2.7]_AQP-DEB-MTX.repl — AQP deb-staleness conservation + MTX defpacts (inject + sweep).
;; TEST BODY ONLY: assumes full deploy + AQP-BOOT + [6.2.1-3] + [6.2.9] boot-full + [6.4] PREP/BOOT-POOLS/RPS/COLLECT
;; are already loaded (by deb-staleness-proof.repl or AQP-comprehensive.repl). Covers M3 #12 deb refresh/mirror,
;; present-flag transitions, CC_Inject forced-fix, MTX|2|C_Inject + MTX|2|C_SweepRevokeAnchor defpacts.
;; NOTE: SWEEP01/02 RETIRE the AurynRain anchor — load this AFTER any AurynRain-dependent suite.
;;
;; ============================================================================
;; TX-AQP-DEB01 — M3 #12 deb-staleness: collect refresh + total-deb mirror resync
;; Reuses the CL02 vault/treasury (class-1) singular position: ANHD staked in
;; SubsidiaryWonderCoach of SubsidiaryTreasury. deb-score = (base+boost)×Elite-DEB.
;; We MOVE ANHD's live Elite-DEB (transfer EliteAuryn away → TFT hook re-snapshots
;; deb DOWN), which does NOT touch the stored SCORE deb-score → staleness. Then a
;; collect must (a) refresh the stored deb-score to the live deb and (b) resync the
;; FVT total-deb mirror by the SAME delta (conservation). The mirror-delta assertion
;; FAILS on the pre-fix PHASE 6 (refresh without XI_SyncFvtTotalDebMirrors).
;; ============================================================================
(begin-tx "TX-AQP-DEB01a - snapshot fresh pre-state")
(namespace "ouronet-ns")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(let
    (
        (anhd:string KST.ANHD)
        (ref-U|DALOS:module{UtilityDalosV2} U|DALOS)
        (ref-DALOS:module{OuronetDalosV2} DALOS)
        (ref-SCR:module{AcquisitionScoresV2} AQP-SCORE)
        (ref-FVT:module{AcquisitionFarmsVaultsTreasuriesV2} AQP-FVT)
        (pool-id:string (ref-U|DALOS::UDC_Makeid "DHWonderCoach"))
        (score-id:string (ref-U|DALOS::UDC_Makeid "SubsidiaryWonderCoach"))
        (fvt-id:string (ref-U|DALOS::UDC_Makeid "SubsidiaryTreasury"))
    )
    (map print
        [
            (format "<(DEB01 pre elite-deb)> => {}" [(ref-DALOS::UR_Elite-DEB anhd)])
            (format "<(DEB01 pre stored-deb-score)> => {}" [(ref-SCR::UR_U-SCR|UserScoreDebScore anhd pool-id score-id)])
            (format "<(DEB01 pre mirror)> => {}" [(ref-FVT::UR_FVT|TotalDebScore fvt-id)])
            (expect "<<TX-AQP-DEB01>> pre: score is FRESH (not stale)"
                false (ref-SCR::URC_U-SCR|UserScoreDebStale anhd pool-id score-id))
            ;; 2c presence: ANHD staked in this treasury (CL02) -> must be marked present, and enumerable
            (expect "<<TX-AQP-DEB01>> presence: ANHD marked present in the FVT (stake-side ADD)"
                true (ref-FVT::UR_FVT-UP|IsPresent fvt-id anhd))
            (expect "<<TX-AQP-DEB01>> presence: ANHD enumerated by URH_FvtPresentUsers"
                true (contains anhd (ref-FVT::URH_FvtPresentUsers fvt-id)))
            ;; 2c removal DECISION logic (what XI_RecomputeFvtPresence writes on unstake):
            (expect "<<TX-AQP-DEB01>> still-present: TRUE for the staked user (ANHD)"
                true (ref-FVT::URC_FvtUserStillPresent fvt-id anhd))
            (expect "<<TX-AQP-DEB01>> still-present: FALSE for an unstaked/absent account"
                false (ref-FVT::URC_FvtUserStillPresent fvt-id "Ѻ.absent-never-staked-here"))
        ]
    )
)
(commit-tx)
(print "")
;;
(begin-tx "TX-AQP-DEB01b - move ANHD Elite-DEB DOWN (transfer EliteAuryn away) => staleness")
(namespace "ouronet-ns")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(env-sigs [{ "key": "PK_AncientHodler", "caps": [] }])
(let
    (
        (anhd:string KST.ANHD)
        (emma:string KST.EMMA)
        (ref-U|DALOS:module{UtilityDalosV2} U|DALOS)
        (ref-DALOS:module{OuronetDalosV2} DALOS)
        (ref-DPTF:module{DemiourgosPactTrueFungibleV2} DPTF)
        (ref-SCR:module{AcquisitionScoresV2} AQP-SCORE)
        (ref-FVT:module{AcquisitionFarmsVaultsTreasuriesV2} AQP-FVT)
        (ref-TS01-C1:module{TalosStageOne_ClientOneV2} TS01-C1)
        (pool-id:string (ref-U|DALOS::UDC_Makeid "DHWonderCoach"))
        (score-id:string (ref-U|DALOS::UDC_Makeid "SubsidiaryWonderCoach"))
        (fvt-id:string (ref-U|DALOS::UDC_Makeid "SubsidiaryTreasury"))
        (ea-id:string (ref-DALOS::UR_EliteAurynID))
        (deb-pre:decimal (ref-DALOS::UR_Elite-DEB anhd))
        (stored-pre:decimal (ref-SCR::UR_U-SCR|UserScoreDebScore anhd pool-id score-id))
        (mirror-pre:decimal (ref-FVT::UR_FVT|TotalDebScore fvt-id))
        (ea-bal:decimal (ref-DPTF::UR_AccountSupply ea-id anhd))
    )
    ;; drop ANHD's EliteAuryn to ~1% of holdings → live deb falls a tier or more
    (ref-TS01-C1::DPTF|C_Transfer anhd ea-id anhd emma (floor (* ea-bal 0.99) 4) false)
    (let
        (
            (deb-post:decimal (ref-DALOS::UR_Elite-DEB anhd))
            (stored-still:decimal (ref-SCR::UR_U-SCR|UserScoreDebScore anhd pool-id score-id))
            (mirror-still:decimal (ref-FVT::UR_FVT|TotalDebScore fvt-id))
        )
        (map print
            [
                (format "<(DEB01 post-move elite-deb)> => {} (was {})" [deb-post deb-pre])
                (expect (format "<<TX-AQP-DEB01>> live Elite-DEB dropped got={} pre={}" [deb-post deb-pre]) true (< deb-post deb-pre))
                (expect "<<TX-AQP-DEB01>> score now STALE (stored deb ≠ live)"
                    true (ref-SCR::URC_U-SCR|UserScoreDebStale anhd pool-id score-id))
                (expect (format "<<TX-AQP-DEB01>> stored deb-score UNCHANGED by the EliteAuryn move got={} pre={}" [stored-still stored-pre]) stored-pre stored-still)
                (expect (format "<<TX-AQP-DEB01>> mirror UNCHANGED by the EliteAuryn move got={} pre={}" [mirror-still mirror-pre]) mirror-pre mirror-still)
            ]
        )
    )
)
(commit-tx)
(print "")
;;
(begin-tx "TX-AQP-DEB01c - collect => PHASE 6 refresh + mirror resync (conservation)")
(namespace "ouronet-ns")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(env-sigs [{ "key": "PK_AncientHodler", "caps": [] }])
(let
    (
        (anhd:string KST.ANHD)
        (ref-U|DALOS:module{UtilityDalosV2} U|DALOS)
        (ref-DALOS:module{OuronetDalosV2} DALOS)
        (ref-SCR:module{AcquisitionScoresV2} AQP-SCORE)
        (ref-FVT:module{AcquisitionFarmsVaultsTreasuriesV2} AQP-FVT)
        (ref-TS02-C3:module{TalosStageTwo_ClientThreeV2} TS02-C3)
        (pool-id:string (ref-U|DALOS::UDC_Makeid "DHWonderCoach"))
        (score-id:string (ref-U|DALOS::UDC_Makeid "SubsidiaryWonderCoach"))
        (fvt-id:string (ref-U|DALOS::UDC_Makeid "SubsidiaryTreasury"))
        (auryn-id:string "AURYN-98c486052a51")
        (deb-live:decimal (ref-DALOS::UR_Elite-DEB anhd))
        (stored-pre:decimal (ref-SCR::UR_U-SCR|UserScoreDebScore anhd pool-id score-id))
        (mirror-pre:decimal (ref-FVT::UR_FVT|TotalDebScore fvt-id))
    )
    (print (format "<(DEB01 CC_Collect treasury Auryn)> => \"{}\""
        [(ref-TS02-C3::AQP-FVT|CC_Collect anhd fvt-id 1 score-id auryn-id)]))
    (let
        (
            (stored-post:decimal (ref-SCR::UR_U-SCR|UserScoreDebScore anhd pool-id score-id))
            (mirror-post:decimal (ref-FVT::UR_FVT|TotalDebScore fvt-id))
        )
        (map print
            [
                (format "<(DEB01 post-collect stored-deb)> => {} (was {})" [stored-post stored-pre])
                (format "<(DEB01 post-collect mirror)> => {} (was {})" [mirror-post mirror-pre])
                (format "<(DEB01 Δmirror vs Δstored)> => {} vs {}" [(- mirror-post mirror-pre) (- stored-post stored-pre)])
                ;; (a) staleness cleared
                (expect "<<TX-AQP-DEB01>> post-collect: score FRESH again"
                    false (ref-SCR::URC_U-SCR|UserScoreDebStale anhd pool-id score-id))
                ;; (b) stored deb-score actually moved to the live deb (dropped)
                (expect (format "<<TX-AQP-DEB01>> stored deb-score refreshed DOWN got={} pre={}" [stored-post stored-pre]) true (< stored-post stored-pre))
                ;; (c) CONSERVATION / the fix: mirror moved by EXACTLY the stored-deb delta
                (expect (format "<<TX-AQP-DEB01>> mirror resynced by Δdeb: Δmirror={} Δstored={}" [(- mirror-post mirror-pre) (- stored-post stored-pre)])
                    (- stored-post stored-pre) (- mirror-post mirror-pre))
            ]
        )
    )
)
(commit-tx)
;; ============================================================================
;; TX-AQP-DEB03 — end-to-end presence FLIP (false→true→false) on a REAL unstake.
;; EMMA is a fresh account absent from SubsidiaryTreasury. Give her one DHWC nonce,
;; she stakes it (→ her ONLY position in the FVT → present true), then fully
;; unstakes (→ recompute finds no remaining position → present flips false).
;; ============================================================================
(begin-tx "TX-AQP-DEB03a - fund EMMA with a DHWC nonce; confirm she starts ABSENT")
(namespace "ouronet-ns")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(env-sigs [{ "key": "PK_AncientHodler", "caps": [] }])
(let
    (
        (anhd:string KST.ANHD)
        (emma:string KST.EMMA)
        (ref-U|DALOS:module{UtilityDalosV2} U|DALOS)
        (ref-DPDC:module{DpdcV2} DPDC)
        (ref-FVT:module{AcquisitionFarmsVaultsTreasuriesV2} AQP-FVT)
        (ref-TS02-C1:module{TalosStageTwo_ClientOneV2} TS02-C1)
        (fvt-id:string (ref-U|DALOS::UDC_Makeid "SubsidiaryTreasury"))
        (dhwc-id:string "DHWC-98c486052a51")
        (nonce:integer 2)
        (amt:integer (ref-DPDC::UR_AccountNonceSupply anhd dhwc-id true nonce))
    )
    (expect "<<TX-AQP-DEB03>> EMMA ABSENT from the FVT before any stake"
        false (ref-FVT::UR_FVT-UP|IsPresent fvt-id emma))
    (ref-TS02-C1::DPSF|C_TransferNonce anhd dhwc-id anhd emma nonce amt false)
    (expect "<<TX-AQP-DEB03>> EMMA still ABSENT after receiving the nonce (no stake yet)"
        false (ref-FVT::UR_FVT-UP|IsPresent fvt-id emma))
)
(commit-tx)
(print "")
;;
(begin-tx "TX-AQP-DEB03b - EMMA stakes (present→true) then FULLY unstakes (present→false)")
(namespace "ouronet-ns")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(env-sigs [{ "key": "PK_Emma", "caps": [] }])
(let
    (
        (emma:string KST.EMMA)
        (ref-U|DALOS:module{UtilityDalosV2} U|DALOS)
        (ref-DPDC:module{DpdcV2} DPDC)
        (ref-FVT:module{AcquisitionFarmsVaultsTreasuriesV2} AQP-FVT)
        (ref-TS02-C3:module{TalosStageTwo_ClientThreeV2} TS02-C3)
        (pool-id:string (ref-U|DALOS::UDC_Makeid "DHWonderCoach"))
        (fvt-id:string (ref-U|DALOS::UDC_Makeid "SubsidiaryTreasury"))
        (dhwc-id:string "DHWC-98c486052a51")
        (nonce:integer 2)
        (amt:integer (ref-DPDC::UR_AccountNonceSupply emma dhwc-id true nonce))
    )
    ;; STAKE — EMMA's only position in the FVT
    (ref-TS02-C3::AQP-POOL|CC_StakeSemiFungibleCollectable emma pool-id emma emma dhwc-id [nonce])
    (let
        (
            (present-after-stake:bool (ref-FVT::UR_FVT-UP|IsPresent fvt-id emma))
            (enum-after-stake:bool (contains emma (ref-FVT::URH_FvtPresentUsers fvt-id)))
        )
        ;; FULL UNSTAKE — drops EMMA's last (only) position
        (ref-TS02-C3::AQP-POOL|CC_UnstakeSemiFungibleCollectable emma pool-id emma emma dhwc-id [nonce] [amt])
        (let
            (
                (present-after-unstake:bool (ref-FVT::UR_FVT-UP|IsPresent fvt-id emma))
                (still-present:bool (ref-FVT::URC_FvtUserStillPresent fvt-id emma))
                (enum-after-unstake:bool (contains emma (ref-FVT::URH_FvtPresentUsers fvt-id)))
            )
            (map print
                [
                    (format "<(DEB03 present after stake / after unstake)> => {} / {}" [present-after-stake present-after-unstake])
                    (expect "<<TX-AQP-DEB03>> FLIP UP: EMMA present=TRUE after stake" true present-after-stake)
                    (expect "<<TX-AQP-DEB03>> FLIP UP: EMMA enumerated after stake" true enum-after-stake)
                    (expect "<<TX-AQP-DEB03>> still-present recompute = FALSE after full unstake" false still-present)
                    (expect "<<TX-AQP-DEB03>> FLIP DOWN: EMMA present=FALSE after full unstake" false present-after-unstake)
                    (expect "<<TX-AQP-DEB03>> FLIP DOWN: EMMA no longer enumerated" false enum-after-unstake)
                ]
            )
        )
    )
)
(commit-tx)
(print "")
;;
;; ============================================================================
;; TX-AQP-DEB04 — MULTI-MEMBER partial-unstake invariant. ANHD is present in
;; SubsidiaryTreasury via THREE members (Bunnies, CodingDivision, WonderCoach).
;; Unstaking ONE whole member (WonderCoach, via DHWC) must KEEP is-present=true,
;; because the recompute scans ALL members and finds Bunnies + CodingDivision
;; still staked. This is the case EMMA (single position) could not show; together
;; they prove: partial unstake → stays true, last unstake → flips false.
;; ============================================================================
(begin-tx "TX-AQP-DEB04 - partial unstake of one member keeps present=true")
(namespace "ouronet-ns")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(env-sigs [{ "key": "PK_AncientHodler", "caps": [] }])
(let
    (
        (anhd:string KST.ANHD)
        (ref-U|DALOS:module{UtilityDalosV2} U|DALOS)
        (ref-SCR:module{AcquisitionScoresV2} AQP-SCORE)
        (ref-AQP:module{AcquisitionPoolsV2} AQP-POOL)
        (ref-FVT:module{AcquisitionFarmsVaultsTreasuriesV2} AQP-FVT)
        (ref-TS02-C3:module{TalosStageTwo_ClientThreeV2} TS02-C3)
        (pool-id:string (ref-U|DALOS::UDC_Makeid "DHWonderCoach"))
        (fvt-id:string (ref-U|DALOS::UDC_Makeid "SubsidiaryTreasury"))
        (score-id:string (ref-U|DALOS::UDC_Makeid "SubsidiaryWonderCoach"))
        (dhwc-id:string "DHWC-98c486052a51")
        (nonce:integer (at "nonce" (at 0 (ref-AQP::URH_AQP|BenDpsfActiveNonceSupplies anhd dhwc-id))))
        (amt:integer (round (ref-AQP::UR_AQP|DPSFTrackerBalance pool-id dhwc-id anhd anhd nonce)))
    )
    (expect "<<TX-AQP-DEB04>> ANHD present BEFORE (3 members)"
        true (ref-FVT::UR_FVT-UP|IsPresent fvt-id anhd))
    (expect "<<TX-AQP-DEB04>> ANHD WonderCoach weight >0 before"
        true (> (ref-SCR::UR_U-SCR|UserScoreDebScore anhd pool-id score-id) 0.0))
    ;; fully unstake ONLY the WonderCoach member
    (ref-TS02-C3::AQP-POOL|CC_UnstakeSemiFungibleCollectable anhd pool-id anhd anhd dhwc-id [nonce] [amt])
    (let
        (
            (wc-after:decimal (ref-SCR::UR_U-SCR|UserScoreDebScore anhd pool-id score-id))
        )
        (map print
            [
                (format "<(DEB04 WonderCoach weight after unstake)> => {}" [wc-after])
                (expect "<<TX-AQP-DEB04>> WonderCoach position fully zeroed" 0.0 wc-after)
                ;; THE KEY ASSERTION — still present because Bunnies + CodingDivision remain
                (expect "<<TX-AQP-DEB04>> MULTI-MEMBER: ANHD STILL present=TRUE after one member unstaked"
                    true (ref-FVT::UR_FVT-UP|IsPresent fvt-id anhd))
                (expect "<<TX-AQP-DEB04>> still-present recompute = TRUE (other members remain)"
                    true (ref-FVT::URC_FvtUserStillPresent fvt-id anhd))
                (expect "<<TX-AQP-DEB04>> ANHD still enumerated by URH_FvtPresentUsers"
                    true (contains anhd (ref-FVT::URH_FvtPresentUsers fvt-id)))
            ]
        )
    )
)
(commit-tx)
(print "")
;; ============================================================================
;; TX-AQP-DEB05 — FULL multi-member walk on ONE user (the exact scenario asked).
;; EMMA (fresh) enters TWO members of SubsidiaryTreasury: WonderCoach (DHWC) and
;; SubsidiaryBunnies (KBN NFT). Then unstake them one at a time:
;;   member 1 (WonderCoach) out → STILL present (Bunnies remains)  → true
;;   member 2 (Bunnies, last) out → present flips                  → false
;; ============================================================================
(begin-tx "TX-AQP-DEB05a - EMMA enters TWO members (DHWC WonderCoach + KBN Bunnies)")
(namespace "ouronet-ns")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(env-sigs [{ "key": "PK_Emma", "caps": [] }])
(let
    (
        (emma:string KST.EMMA)
        (ref-U|DALOS:module{UtilityDalosV2} U|DALOS)
        (ref-FVT:module{AcquisitionFarmsVaultsTreasuriesV2} AQP-FVT)
        (ref-TS02-C3:module{TalosStageTwo_ClientThreeV2} TS02-C3)
        (wc-pool:string (ref-U|DALOS::UDC_Makeid "DHWonderCoach"))
        (bunnies-pool:string (ref-U|DALOS::UDC_Makeid "DHBunnies"))
        (fvt-id:string (ref-U|DALOS::UDC_Makeid "SubsidiaryTreasury"))
        (dhwc-id:string "DHWC-98c486052a51")
        (kbn-id:string "KBN-98c486052a51")
    )
    (expect "<<TX-AQP-DEB05>> EMMA absent before the 2-member setup"
        false (ref-FVT::UR_FVT-UP|IsPresent fvt-id emma))
    (ref-TS02-C3::AQP-POOL|CC_StakeSemiFungibleCollectable emma wc-pool emma emma dhwc-id [2])
    (let ((after-wc:bool (ref-FVT::UR_FVT-UP|IsPresent fvt-id emma)))
        (ref-TS02-C3::AQP-POOL|CC_StakeNonFungibleCollectable emma bunnies-pool emma emma kbn-id [1])
        (let ((after-both:bool (ref-FVT::UR_FVT-UP|IsPresent fvt-id emma)))
            (map print
                [
                    (format "<(DEB05 present after WonderCoach / after Bunnies)> => {} / {}" [after-wc after-both])
                    (expect "<<TX-AQP-DEB05>> present after WonderCoach stake" true after-wc)
                    (expect "<<TX-AQP-DEB05>> present after Bunnies stake too" true after-both)
                ]
            )
        )
    )
)
(commit-tx)
(print "")
;;
