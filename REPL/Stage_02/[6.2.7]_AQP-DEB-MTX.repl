;;
;; ============================================================================
;; TX-AQP-DEB09 — M4 #13: score boost/deb config is re-settable ONLY while the
;; score is EMPTY (nzs-count = 0). A populated score (ANHD staked in Bunnies)
;; must REJECT any (re)configuration; the operator has to vacate to reconfigure.
;; Positive nzs==0 side is covered by all DEB01–DEB08 setup (config set on fresh
;; scores). Here we prove the NEW negative guard on a live, populated score.
;; ============================================================================
(begin-tx "TX-AQP-DEB09 - populated score rejects boost/deb (re)config (M4 #13)")
(namespace "ouronet-ns")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(env-sigs [{ "key": "PK_AncientHodler", "caps": [] }])
(let
    (
        (anhd:string KST.ANHD)
        (ref-U|DALOS:module{UtilityDalosV2} U|DALOS)
        (ref-SCR:module{AcquisitionScoresV2} AQP-SCORE)
        (ref-TS02-C3:module{TalosStageTwo_ClientThreeV2} TS02-C3)
        (bunnies-score:string (ref-U|DALOS::UDC_Makeid "SubsidiaryBunnies"))
        (wc-score:string (ref-U|DALOS::UDC_Makeid "SubsidiaryWonderCoach"))
    )
    (let
        (
            (nzs-bunnies:integer (ref-SCR::UR_SCR|ScoreNzsCount bunnies-score))
            (nzs-wc:integer (ref-SCR::UR_SCR|ScoreNzsCount wc-score))
        )
        (map print
            [
                (format "<(DEB09 nzs Bunnies / WonderCoach)> => {} / {}" [nzs-bunnies nzs-wc])
                ;; Bunnies is populated (ANHD staked) ⟹ nzs > 0
                (expect "<<TX-AQP-DEB09>> Bunnies score is POPULATED (nzs-count > 0)"
                    true (> nzs-bunnies 0))
                ;; WonderCoach was populated earlier (ANHD + EMMA) then fully vacated by the DEB04/DEB05
                ;; unstakes ⟹ nzs back to 0 — the exact "vacate to reconfigure" state.
                (expect "<<TX-AQP-DEB09>> WonderCoach score is VACATED (nzs-count = 0)"
                    0 nzs-wc)
                ;; M4 #13 core: (re)configuring a populated score is BLOCKED — must vacate first.
                (expect-failure
                    "<<TX-AQP-DEB09>> boost-link on a POPULATED score must fail (nzs>0 ⇒ vacate to reconfigure)"
                    (ref-TS02-C3::AQP-SCR|C_CreateScoreBoostLink anhd bunnies-score wc-score))
                (expect-failure
                    "<<TX-AQP-DEB09>> enable-deb-boost on a POPULATED score must fail (nzs>0 ⇒ vacate to reconfigure)"
                    (ref-TS02-C3::AQP-SCR|C_EnableDebBoost anhd bunnies-score))
            ]
        )
        ;; M4 #13 re-settable side: the SAME config on the VACATED WonderCoach (nzs=0) SUCCEEDS,
        ;; and the boost-link slot actually moves to Bunnies — proving reconfigure-after-vacate.
        (ref-TS02-C3::AQP-SCR|C_CreateScoreBoostLink anhd wc-score bunnies-score)
        (map print
            [
                (format "<(DEB09 WonderCoach boost-link after re-set)> => {}"
                    [(ref-SCR::UR_SCR|ScoreBoostLink wc-score)])
                (expect "<<TX-AQP-DEB09>> RE-SETTABLE: vacated score accepts config; boost-link moved to Bunnies"
                    bunnies-score (ref-SCR::UR_SCR|ScoreBoostLink wc-score))
            ]
        )
    )
)
(commit-tx)
(print "")
;;
;; ============================================================================
;; TX-AQP-DEB10 — ESCROW-ON-EMPTY (zombie/limbo) inject. Drive CodingDivisionTreasury
;; (class 1, single member TheCodingDivision, reward Wstoa) to ZERO total-deb by
;; unstaking BOTH stakers (ANHD nonce5 + LUMY nonce5). Then:
;;   (b) inject twice at zero total ⟹ NO revert; zombie accrues by amount each; G and
;;       available-rewards UNTOUCHED (escrow isolated from the M1 dust sweep).
;;   (c) re-stake ANHD (sole staker) ⟹ next inject FLUSHES amount + zombie: zombie→0,
;;       G jumps by eff/denom, and ANHD collects the WHOLE escrowed sum + flush amount.
;; Proves: injected-at-zero rewards are held, counted, and paid to whoever is staked
;; when the first non-zero inject lands — NOT lost, NOT swept by a prior cohort.
;; ============================================================================
(begin-tx "TX-AQP-DEB10a - empty CodingDivisionTreasury (unstake ANHD + LUMY) => total-deb 0")
(namespace "ouronet-ns")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(env-sigs [{ "key": "PK_AncientHodler", "caps": [] } { "key": "PK_Lumy", "caps": [] }])
(let
    (
        (anhd:string KST.ANHD)
        (lumy:string KST.LUMY)
        (ref-U|DALOS:module{UtilityDalosV2} U|DALOS)
        (ref-AQP:module{AcquisitionPoolsV2} AQP-POOL)
        (ref-FVT:module{AcquisitionFarmsVaultsTreasuriesV2} AQP-FVT)
        (ref-TS02-C3:module{TalosStageTwo_ClientThreeV2} TS02-C3)
        (pool-id:string (ref-U|DALOS::UDC_Makeid "DHCodingDivision"))
        (fvt-id:string (ref-U|DALOS::UDC_Makeid "CodingDivisionTreasury"))
        (dhcd-id:string "DHCD-98c486052a51")
        (amt-anhd:integer (round (ref-AQP::UR_AQP|DPSFTrackerBalance pool-id dhcd-id anhd anhd 5)))
        (amt-lumy:integer (round (ref-AQP::UR_AQP|DPSFTrackerBalance pool-id dhcd-id lumy lumy 5)))
    )
    (ref-TS02-C3::AQP-POOL|CC_UnstakeSemiFungibleCollectable anhd pool-id anhd anhd dhcd-id [5] [amt-anhd])
    (ref-TS02-C3::AQP-POOL|CC_UnstakeSemiFungibleCollectable anhd pool-id lumy lumy dhcd-id [5] [amt-lumy])
    (map print
        [
            (format "<(DEB10a unstaked ANHD/LUMY nonce5)> => {} / {}" [amt-anhd amt-lumy])
            (format "<(DEB10a inject denominator after empty)> => {}" [(ref-FVT::URC_InjectDenominator fvt-id)])
            (expect "<<TX-AQP-DEB10>> CodingDivisionTreasury now EMPTY (inject denominator = 0)"
                0.0 (ref-FVT::URC_InjectDenominator fvt-id))
        ]
    )
)
(commit-tx)
(print "")
