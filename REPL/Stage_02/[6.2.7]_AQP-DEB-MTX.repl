(print "")
;;
(begin-tx "TX-AQP-DEB10c - re-stake ANHD, inject => FLUSH amount+zombie to the current staker")
(namespace "ouronet-ns")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(env-sigs [{ "key": "PK_AncientHodler", "caps": [] }])
(let
    (
        (anhd:string KST.ANHD)
        (ref-U|DALOS:module{UtilityDalosV2} U|DALOS)
        (ref-DALOS:module{OuronetDalosV2} DALOS)
        (ref-DPTF:module{DemiourgosPactTrueFungibleV2} DPTF)
        (ref-FVT:module{AcquisitionFarmsVaultsTreasuriesV2} AQP-FVT)
        (ref-TS02-C3:module{TalosStageTwo_ClientThreeV2} TS02-C3)
        (pool-id:string (ref-U|DALOS::UDC_Makeid "DHCodingDivision"))
        (score-id:string (ref-U|DALOS::UDC_Makeid "TheCodingDivision"))
        (fvt-id:string (ref-U|DALOS::UDC_Makeid "CodingDivisionTreasury"))
        (wstoa-id:string (ref-DALOS::UR_WrappedStoaID))
        (dhcd-id:string "DHCD-98c486052a51")
    )
    ;; ANHD re-enters as the SOLE staker (LUMY stays out).
    (ref-TS02-C3::AQP-POOL|CC_StakeSemiFungibleCollectable anhd pool-id anhd anhd dhcd-id [5])
    (let
        (
            (zb-pre:decimal (ref-FVT::UR_FVT-RG|ZombieRewards fvt-id wstoa-id))
            (denom:decimal (ref-FVT::URC_InjectDenominator fvt-id))
        )
        ;; The first NON-zero inject: R_eff = 5 (this amount) + 25 (escrow) = 30, distributed to ANHD.
        (ref-TS02-C3::AQP-FVT|CC_Inject anhd fvt-id wstoa-id 5.0)
        (let
            (
                (zb-post:decimal (ref-FVT::UR_FVT-RG|ZombieRewards fvt-id wstoa-id))
                ;; measure the COLLECT payout in isolation: balance immediately before vs after the collect.
                (wstoa-pre-collect:decimal (ref-DPTF::UR_AccountSupply wstoa-id anhd))
            )
            (ref-TS02-C3::AQP-FVT|CC_Collect anhd fvt-id 1 score-id wstoa-id)
            (let
                (
                    (payout:decimal (- (ref-DPTF::UR_AccountSupply wstoa-id anhd) wstoa-pre-collect))
                )
                (map print
                    [
                        (format "<(DEB10c denom after restake / zombie pre-flush)> => {} / {}" [denom zb-pre])
                        (format "<(DEB10c zombie after flush)> => {} (expected 0)" [zb-post])
                        (format "<(DEB10c ANHD collect payout)> => {} (expected 30 = 5 flush + 25 escrow)" [payout])
                        (expect "<<TX-AQP-DEB10>> re-stake made the vault non-empty (denominator > 0)" true (> denom 0.0))
                        (expect "<<TX-AQP-DEB10>> escrow was 25 before the flush" 25.0 zb-pre)
                        (expect "<<TX-AQP-DEB10>> FLUSH zeroed the zombie" 0.0 zb-post)
                        ;; the money shot: the sole staker present at the flush collects the WHOLE escrowed sum + flush.
                        (expect "<<TX-AQP-DEB10>> sole staker collects flush + full escrow = 30 Wstoa" 30.0 payout)
                    ]
                )
            )
        )
    )
)
(commit-tx)
(print "")
;;
;; ============================================================================
;; TX-AQP-DEB11 — FARM enforced-fresh inject (guard-removal proof). OuroLpFarm is a
;; class-0 mosaic farm carrying a deb-based member (SilverSnakePower). Bumping ANHD's
;; Elite-DEB stales his farm member; CC_Inject on the FARM must FIX every stale present
;; user before distributing — proving the enforced-fresh path is no longer
;; vault/treasury-only. Asserts: (a) ZERO stale present users remain (enforced-fresh
;; guarantee on a farm), (b) the farm inject flushed available-rewards by the amount.
;; ============================================================================
(begin-tx "TX-AQP-DEB11 - CC_Inject on a class-0 FARM: fix stale members then inject")
(namespace "ouronet-ns")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(env-sigs [{ "key": "PK_AncientHodler", "caps": [] } { "key": "PK_Emma", "caps": [] }])
(let
    (
        (anhd:string KST.ANHD)
        (emma:string KST.EMMA)
        (ref-U|DALOS:module{UtilityDalosV2} U|DALOS)
        (ref-DALOS:module{OuronetDalosV2} DALOS)
        (ref-DPTF:module{DemiourgosPactTrueFungibleV2} DPTF)
        (ref-SCR:module{AcquisitionScoresV2} AQP-SCORE)
        (ref-FVT:module{AcquisitionFarmsVaultsTreasuriesV2} AQP-FVT)
        (ref-TS01-C1:module{TalosStageOne_ClientOneV2} TS01-C1)
        (ref-TS02-C3:module{TalosStageTwo_ClientThreeV2} TS02-C3)
        (farm-id:string (ref-U|DALOS::UDC_Makeid "OuroLpFarm"))
        (silver-score:string (ref-U|DALOS::UDC_Makeid "SilverSnakePower"))
        (ouro-pool:string (ref-SCR::UR_SCR|ScoreAqpoolLink silver-score))
        (ouro-id:string "OURO-98c486052a51")
        (ea-id:string (ref-DALOS::UR_EliteAurynID))
        (inject-amt:decimal 50.0)
    )
    ;; 1] re-stale ANHD's farm member: pull EliteAuryn back from EMMA → Elite-DEB moves → stale
    (let ((emma-ea:decimal (ref-DPTF::UR_AccountSupply ea-id emma)))
        (if (> emma-ea 0.0)
            (ref-TS01-C1::DPTF|C_Transfer emma ea-id emma anhd (floor (* emma-ea 0.99) 4) false)
            true))
    (let
        (
            (class:integer (ref-FVT::UR_FVT|FvtClass farm-id))
            (stale-pre:[string] (ref-FVT::URH_FvtStalePresentUsers farm-id))
            (silver-stale-pre:bool (ref-SCR::URC_U-SCR|UserScoreDebStale anhd ouro-pool silver-score))
            (silver-deb-pre:decimal (ref-SCR::UR_U-SCR|UserScoreDebScore anhd ouro-pool silver-score))
            (ar-pre:decimal (ref-FVT::UR_FVT-RG|AvailableRewards farm-id ouro-id))
        )
        (expect "<<TX-AQP-DEB11>> OuroLpFarm is class 0 (farm)" 0 class)
        (let
            (
                (r:string (ref-TS02-C3::AQP-FVT|CC_Inject anhd farm-id ouro-id inject-amt))
            )
            (let
                (
                    (stale-post:[string] (ref-FVT::URH_FvtStalePresentUsers farm-id))
                    (silver-stale-post:bool (ref-SCR::URC_U-SCR|UserScoreDebStale anhd ouro-pool silver-score))
                    (silver-deb-post:decimal (ref-SCR::UR_U-SCR|UserScoreDebScore anhd ouro-pool silver-score))
                    (ar-post:decimal (ref-FVT::UR_FVT-RG|AvailableRewards farm-id ouro-id))
                )
                (map print
                    [
                        (format "<(DEB11 farm CC_Inject)> => \"{}\"" [r])
                        (format "<(DEB11 stale present users pre/post)> => {} / {}" [(length stale-pre) (length stale-post)])
                        (format "<(DEB11 SilverSnakePower stale pre/post)> => {} / {}" [silver-stale-pre silver-stale-post])
                        (format "<(DEB11 SilverSnakePower deb pre/post)> => {} / {}" [silver-deb-pre silver-deb-post])
                        (format "<(DEB11 farm available-rewards pre/post)> => {} / {}" [ar-pre ar-post])
                        ;; (a) enforced-fresh guarantee, now on a FARM: ZERO stale present users remain
                        (expect "<<TX-AQP-DEB11>> enforced-fresh: NO stale present users remain on the farm" 0 (length stale-post))
                        ;; (b) the farm inject actually distributed: available-rewards flushed by the amount
                        (expect (format "<<TX-AQP-DEB11>> farm inject flushed available-rewards +{} ({}->{})" [inject-amt ar-pre ar-post]) inject-amt (- ar-post ar-pre))
                    ]
                )
            )
        )
    )
)
(commit-tx)
(print "")
;;
;; ============================================================================
;; TX-AQP-DEB12 — the MTX|2|C_Inject DEFPACT on the class-0 FARM. Proves the 2-step
;; enforced-fresh spike-fallback path is no longer vault/treasury-only: step 0 scans
;; (0 stale ≤ N_FIX) → fixes all + injects (terminal) on the farm; step 1 = no-op.
;; ============================================================================
(begin-tx "TX-AQP-DEB12a - MTX defpact step 0 on the FARM (Talos MTX-AQP|2|C_Inject)")
(namespace "ouronet-ns")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(env-hash (hash "deb12-farm-mtx-inject"))
(env-sigs [{ "key": "PK_AncientHodler", "caps": [] }])
(let
    (
        (anhd:string KST.ANHD)
        (ref-U|DALOS:module{UtilityDalosV2} U|DALOS)
        (ref-FVT:module{AcquisitionFarmsVaultsTreasuriesV2} AQP-FVT)
        (ref-TS02-C3:module{TalosStageTwo_ClientThreeV2} TS02-C3)
        (farm-id:string (ref-U|DALOS::UDC_Makeid "OuroLpFarm"))
        (ouro-id:string "OURO-98c486052a51")
        (defpact-amt:decimal 20.0)
        (ar-pre:decimal (ref-FVT::UR_FVT-RG|AvailableRewards farm-id ouro-id))
    )
    (map print
        [
            (format "<(DEB12 MTX-AQP|2|C_Inject farm step 0)> => \"{}\""
                [(ref-TS02-C3::MTX-AQP|2|C_Inject anhd farm-id ouro-id defpact-amt)])
            ;; the defpact ran the shared inject-core on the farm ⟹ available-rewards flushed by the amount
            (expect (format "<<TX-AQP-DEB12>> farm defpact flushed available-rewards +{} ({}->{})" [defpact-amt ar-pre (ref-FVT::UR_FVT-RG|AvailableRewards farm-id ouro-id)])
                defpact-amt (- (ref-FVT::UR_FVT-RG|AvailableRewards farm-id ouro-id) ar-pre))
        ]
    )
)
(commit-tx)
(print "")
(begin-tx "TX-AQP-DEB12b - continue-pact (farm defpact step 1 = no-op, already injected)")
(namespace "ouronet-ns")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(env-sigs [{ "key": "PK_AncientHodler", "caps": [] }])
(print (format "<(DEB12 continue-pact 1)> => \"{}\""
    [(continue-pact 1 false (hash "deb12-farm-mtx-inject"))]))
(commit-tx)
(print "")
;;
;; ============================================================================
;; TX-AQP-DEB13 — REVERSE INDEX (sweep phase 1). The H4 lock counter is now the
;; length of an enumerable set boost-class → [score-ids] (single source of truth).
;; The boot linked SilverSnakePower's score to its boost-class, so the set must
;; enumerate that score — this is what the re-score sweep (phase 3) will walk.
;; ============================================================================
(begin-tx "TX-AQP-DEB13 - reverse index boost-class -> [score-ids] is enumerable + count = length")
(namespace "ouronet-ns")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(let
    (
        (ref-U|DALOS:module{UtilityDalosV2} U|DALOS)
        (ref-ANK:module{AcquisitionAnchorsV2} AQP-ANK)
        (silver-score:string (ref-U|DALOS::UDC_Makeid "SilverSnakePower"))
        (silver-class:string (ref-U|DALOS::UDC_Makeid "SilverSnakePower"))
    )
    (let
        (
            (links:[string] (ref-ANK::UR_BC|ScoreLinks silver-class))
            (cnt:integer (ref-ANK::UR_BC|ScoreLinkCount silver-class))
        )
        (map print
            [
                (format "<(DEB13 UR_BC|ScoreLinks SilverSnakePower class)> => {}" [links])
                (format "<(DEB13 lock count vs set length)> => {} vs {}" [cnt (length links)])
                ;; (a) the reverse index ENUMERATES the linked score — the sweep walks this set
                (expect "<<TX-AQP-DEB13>> reverse index CONTAINS the linked score (SilverSnakePower)"
                    true (contains silver-score links))
                ;; (b) the #9 lock count is the single-source length (no separate count field)
                (expect (format "<<TX-AQP-DEB13>> lock count == length of the reverse-index set ({}=={})" [cnt (length links)])
                    (length links) cnt)
                ;; (c) non-empty for an employed class ⟹ revoke lock armed (behavior preserved)
                (expect "<<TX-AQP-DEB13>> reverse index NON-EMPTY for an employed class (lock armed)"
                    true (> cnt 0))
            ]
        )
    )
)
(commit-tx)
(print "")
;; TX-AQP-SWEEP01 (re-score sweep end-to-end) — PENDING: CC_SweepRevokeAnchor is built and its pipeline executes
;; (pre-state read OK: agg-promile 100, lane 20, links=[silver], pool unfrozen), but the swept-revoke's authorization
;; — ANK|XE>SWEEP-REVOKE → CAP_Owner(anchor) → DPDC CAP_OwnerOrCreator(asset) — is not satisfied by the test signer.
;; The sweep's authorization model (who/how signs to retire an EMPLOYED anchor whose asset is staked) needs an owner
;; decision before this proof lands. See SWEEP-VACATE-DESIGN.md.
;;
;; ============================================================================
;; TX-AQP-SWEEP01 — PAGINATED RE-SCORE SWEEP end-to-end (Phase 3 closeout). Retire
;; the EMPLOYED AurynRain anchor (SilverSnakePower boost-class, promile 100, employed
;; by the SnakePower TRUE-triplet in OuroLpFarm where ANHD stakes) via the 2-step
;; MTX|2|C_SweepRevokeAnchor defpact. Auth: the anchor owner == the anchored-asset
;; (KBN) owner == LUMY, who signs. Step 0 (here) XE_SweepBegin FREEZES the pool +
;; swept-REMOVES the anchor (skipping the #9 lock), then XI_SweepRecomputeWindow
;; RECOMPUTES every present holder's aggregate-promile + triplet lanes; ANHD is the
;; only present holder (≤ N_SWEEP) so step 0 is TERMINAL → XE_SweepEnd UNFREEZES.
;; Step 1 (continue-pact, SWEEP02) is a no-op. Proves the paginated path reaches the
;; same end-state as the single-tx CC_SweepRevokeAnchor, across defpact steps.
;; ============================================================================
(begin-tx "TX-AQP-SWEEP01 - MTX|2|C_SweepRevokeAnchor defpact step 0 retires an employed anchor")
(namespace "ouronet-ns")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
;; force a known pact-id so continue-pact in SWEEP02 matches
(env-hash (hash "sweep-mtx-defpact"))
(env-sigs [{ "key": "PK_Lumy", "caps": [] }])
(let
    (
        (lumy:string KST.LUMY)
        (anhd:string KST.ANHD)
        (ref-U|DALOS:module{UtilityDalosV2} U|DALOS)
        (ref-ANK:module{AcquisitionAnchorsV2} AQP-ANK)
        (ref-SCR:module{AcquisitionScoresV2} AQP-SCORE)
        (ref-AQP:module{AcquisitionPoolsV2} AQP-POOL)
        (ref-FVT:module{AcquisitionFarmsVaultsTreasuriesV2} AQP-FVT)
        (ref-TS02-C3:module{TalosStageTwo_ClientThreeV2} TS02-C3)
        (anchor-id:string (ref-U|DALOS::UDC_Makeid "AurynRain"))
        (silver-class:string (ref-U|DALOS::UDC_Makeid "SilverSnakePower"))
        (silver-score:string (ref-U|DALOS::UDC_Makeid "SilverSnakePower"))
        (farm-id:string (ref-U|DALOS::UDC_Makeid "OuroLpFarm"))
        (ouro-pool:string (ref-U|DALOS::UDC_Makeid "DHOuroLp"))
        (triplet-id:string (ref-SCR::UR_SCR|ScoreTripletId silver-score))
    )
    (let
        (
            (agg-pre:decimal (ref-ANK::UR_UB|AggregatePromile anhd silver-class))
            (lane-pre:decimal (ref-FVT::UR_FVT-SEL|TotalLaneWeight farm-id triplet-id))
            (links-pre:[string] (ref-ANK::UR_BC|ScoreLinks silver-class))
            (frozen-pre:bool (ref-AQP::UR_AQP|PoolSweepInProgress ouro-pool))
        )
        (map print
            [
                (format "<(SWEEP01 pre: agg-promile / lane-weight)> => {} / {}" [agg-pre lane-pre])
                (format "<(SWEEP01 pre: silver-class links / pool frozen)> => {} / {}" [links-pre frozen-pre])
                (expect "<<TX-SWEEP01>> pre: ANHD has silver-class aggregate-promile (AurynRain employed)" true (> agg-pre 0.0))
                (expect "<<TX-SWEEP01>> pre: pool NOT sweep-frozen" false frozen-pre)
            ]
        )
        ;; THE PAGINATED SWEEP — the anchor owner (LUMY = KBN asset owner) retires the employed AurynRain
        ;; anchor via the 2-step defpact. ANHD is the only present holder (≤ N_SWEEP) ⇒ step 0 is terminal.
        (print (format "<(SWEEP01 MTX-AQP|2|C_SweepRevokeAnchor step 0)> => \"{}\""
            [(ref-TS02-C3::MTX-AQP|2|C_SweepRevokeAnchor lumy anchor-id)]))
        (let
            (
                (agg-post:decimal (ref-ANK::UR_UB|AggregatePromile anhd silver-class))
                (lane-post:decimal (ref-FVT::UR_FVT-SEL|TotalLaneWeight farm-id triplet-id))
                (links-post:[string] (ref-ANK::UR_BC|ScoreLinks silver-class))
                (frozen-post:bool (ref-AQP::UR_AQP|PoolSweepInProgress ouro-pool))
            )
            (map print
                [
                    (format "<(SWEEP01 post: agg-promile / lane-weight)> => {} / {}" [agg-post lane-post])
                    (format "<(SWEEP01 post: silver-class links / pool frozen)> => {} / {}" [links-post frozen-post])
                    ;; (a) the holder's aggregate-promile DROPPED (AurynRain removed from silver-class)
                    (expect (format "<<TX-SWEEP01>> aggregate-promile DROPPED {}->{}" [agg-pre agg-post]) true (< agg-post agg-pre))
                    ;; (b) the TRUE-triplet lanes refolded DOWN (silver promile gone ⇒ lower lane weight)
                    (expect (format "<<TX-SWEEP01>> total-lane-weight refolded DOWN {}->{}" [lane-pre lane-post]) true (< lane-post lane-pre))
                    ;; (c) the reverse-index set is UNCHANGED (revoke does NOT unlink scores — design)
                    (expect "<<TX-SWEEP01>> reverse-index set UNCHANGED by anchor revoke" links-pre links-post)
                    ;; (d) the pool was UNFROZEN after the sweep completed
                    (expect "<<TX-SWEEP01>> pool UNFROZEN after sweep" false frozen-post)
                ]
            )
        )
    )
)
(commit-tx)
(print "")
;;
;; TX-AQP-SWEEP02 — continue-pact 1 completes the defpact (step 1 = no-op; step 0 was terminal).
;; Idempotence across the step boundary: the anchor STAYS retired and the pool STAYS unfrozen — step 1
;; must not re-freeze, re-revoke, or re-recompute.
(begin-tx "TX-AQP-SWEEP02 - continue-pact 1 (defpact step 1 = no-op) + idempotence")
(namespace "ouronet-ns")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(env-sigs [{ "key": "PK_Lumy", "caps": [] }])
(print (format "<(SWEEP02 continue-pact 1)> => \"{}\"" [(continue-pact 1 false (hash "sweep-mtx-defpact"))]))
(let
    (
        (ref-U|DALOS:module{UtilityDalosV2} U|DALOS)
        (ref-ANK:module{AcquisitionAnchorsV2} AQP-ANK)
        (ref-AQP:module{AcquisitionPoolsV2} AQP-POOL)
        (anchor-id:string (ref-U|DALOS::UDC_Makeid "AurynRain"))
        (ouro-pool:string (ref-U|DALOS::UDC_Makeid "DHOuroLp"))
    )
    (map print
        [
            (expect "<<TX-SWEEP02>> anchor STAYS retired after step 1 no-op" false (ref-ANK::UR_ANK|State anchor-id))
            (expect "<<TX-SWEEP02>> pool STAYS unfrozen after step 1 no-op" false (ref-AQP::UR_AQP|PoolSweepInProgress ouro-pool))
        ]
    )
)
(commit-tx)
(print "")
(print "=== deb-staleness-proof END ===")
