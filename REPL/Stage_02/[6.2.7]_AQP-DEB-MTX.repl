        (fvt-id:string (ref-U|DALOS::UDC_Makeid "SubsidiaryTreasury"))
        (dhwc-id:string "DHWC-98c486052a51")
        (amt:integer (round (ref-AQP::UR_AQP|DPSFTrackerBalance wc-pool dhwc-id emma emma 2)))
    )
    (ref-TS02-C3::AQP-POOL|CC_UnstakeSemiFungibleCollectable emma wc-pool emma emma dhwc-id [2] [amt])
