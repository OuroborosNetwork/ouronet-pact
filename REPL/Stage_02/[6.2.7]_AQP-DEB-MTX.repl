        ]
    )
)
(commit-tx)
(print "")
;;
(begin-tx "TX-AQP-DEB05c - unstake member 2 (Bunnies, the LAST): present flips FALSE")
(namespace "ouronet-ns")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(env-sigs [{ "key": "PK_Emma", "caps": [] }])
(let
    (
        (emma:string KST.EMMA)
        (ref-U|DALOS:module{UtilityDalosV2} U|DALOS)
        (ref-FVT:module{AcquisitionFarmsVaultsTreasuriesV2} AQP-FVT)
        (ref-TS02-C3:module{TalosStageTwo_ClientThreeV2} TS02-C3)
        (bunnies-pool:string (ref-U|DALOS::UDC_Makeid "DHBunnies"))
        (fvt-id:string (ref-U|DALOS::UDC_Makeid "SubsidiaryTreasury"))
        (kbn-id:string "KBN-98c486052a51")
    )
    (ref-TS02-C3::AQP-POOL|CC_UnstakeNonFungibleCollectable emma bunnies-pool emma emma kbn-id [1] [1])
    (map print
        [
            (format "<(DEB05 present after unstaking Bunnies — the last)> => {}" [(ref-FVT::UR_FVT-UP|IsPresent fvt-id emma)])
            (expect "<<TX-AQP-DEB05>> FLIP: EMMA present=FALSE after the LAST member out"
                false (ref-FVT::UR_FVT-UP|IsPresent fvt-id emma))
            (expect "<<TX-AQP-DEB05>> still-present recompute = FALSE (all members gone)"
                false (ref-FVT::URC_FvtUserStillPresent fvt-id emma))
            (expect "<<TX-AQP-DEB05>> EMMA no longer enumerated"
                false (contains emma (ref-FVT::URH_FvtPresentUsers fvt-id)))
        ]
    )
)
(commit-tx)
(print "")
;;
;; ============================================================================
;; TX-AQP-DEB06 — CC_Inject (enforced-fresh inject). DEB01 moved ANHD's Elite-DEB
;; 4.29→1.39, so his Bunnies + CodingDivision scores in SubsidiaryTreasury are
;; STALE (stored on the 4.29 basis). CC_Inject must fix EVERY stale present user
;; before injecting, so the divisor is live. Proves: stale→fresh + mirror resynced
;; by EXACTLY the fix deltas + the inject advanced G on the fresh divisor.
;; ============================================================================
(begin-tx "TX-AQP-DEB06 - CC_Inject fixes stale stakers then injects on a fresh divisor")
(namespace "ouronet-ns")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(env-sigs [{ "key": "PK_AncientHodler", "caps": [] }])
(let
    (
        (anhd:string KST.ANHD)
        (ref-U|DALOS:module{UtilityDalosV2} U|DALOS)
        (ref-SCR:module{AcquisitionScoresV2} AQP-SCORE)
        (ref-FVT:module{AcquisitionFarmsVaultsTreasuriesV2} AQP-FVT)
        (ref-TS02-C3:module{TalosStageTwo_ClientThreeV2} TS02-C3)
        (fvt-id:string (ref-U|DALOS::UDC_Makeid "SubsidiaryTreasury"))
        (auryn-id:string "AURYN-98c486052a51")
        (bunnies-score:string (ref-U|DALOS::UDC_Makeid "SubsidiaryBunnies"))
        (coding-score:string (ref-U|DALOS::UDC_Makeid "SubsidiaryCodingDivision"))
        (bunnies-pool:string (ref-SCR::UR_SCR|ScoreAqpoolLink bunnies-score))
        (coding-pool:string (ref-SCR::UR_SCR|ScoreAqpoolLink coding-score))
        (inject-amt:decimal 10.0)
        (bunnies-pre:decimal (ref-SCR::UR_U-SCR|UserScoreDebScore anhd bunnies-pool bunnies-score))
        (coding-pre:decimal (ref-SCR::UR_U-SCR|UserScoreDebScore anhd coding-pool coding-score))
        (mirror-pre:decimal (ref-FVT::UR_FVT|TotalDebScore fvt-id))
        (g-pre:decimal (ref-FVT::UR_FVT-RG|CurrentRps fvt-id auryn-id))
    )
    (expect "<<TX-AQP-DEB06>> pre: ANHD Bunnies score STALE" true (ref-SCR::URC_U-SCR|UserScoreDebStale anhd bunnies-pool bunnies-score))
    (expect "<<TX-AQP-DEB06>> pre: ANHD CodingDivision score STALE" true (ref-SCR::URC_U-SCR|UserScoreDebStale anhd coding-pool coding-score))
    (print (format "<(DEB06 CC_Inject)> => \"{}\"" [(ref-TS02-C3::AQP-FVT|CC_Inject anhd fvt-id auryn-id inject-amt)]))
    (let
        (
            (bunnies-post:decimal (ref-SCR::UR_U-SCR|UserScoreDebScore anhd bunnies-pool bunnies-score))
            (coding-post:decimal (ref-SCR::UR_U-SCR|UserScoreDebScore anhd coding-pool coding-score))
            (mirror-post:decimal (ref-FVT::UR_FVT|TotalDebScore fvt-id))
            (g-post:decimal (ref-FVT::UR_FVT-RG|CurrentRps fvt-id auryn-id))
        )
        (map print
            [
                (format "<(DEB06 Bunnies deb pre/post)> => {} / {}" [bunnies-pre bunnies-post])
                (format "<(DEB06 CodingDivision deb pre/post)> => {} / {}" [coding-pre coding-post])
                (format "<(DEB06 mirror pre/post, G pre/post)> => {}/{}  {}/{}" [mirror-pre mirror-post g-pre g-post])
                ;; (a) every stale present user is now FRESH (the enforced-fresh guarantee)
                (expect "<<TX-AQP-DEB06>> post: ANHD Bunnies FRESH" false (ref-SCR::URC_U-SCR|UserScoreDebStale anhd bunnies-pool bunnies-score))
                (expect "<<TX-AQP-DEB06>> post: ANHD CodingDivision FRESH" false (ref-SCR::URC_U-SCR|UserScoreDebStale anhd coding-pool coding-score))
                ;; (b) refreshed DOWN (4.29-basis → 1.39-basis)
                (expect (format "<<TX-AQP-DEB06>> Bunnies refreshed DOWN {}->{}" [bunnies-pre bunnies-post]) true (< bunnies-post bunnies-pre))
                (expect (format "<<TX-AQP-DEB06>> CodingDivision refreshed DOWN {}->{}" [coding-pre coding-post]) true (< coding-post coding-pre))
                ;; (c) CONSERVATION of the fix: mirror moved by EXACTLY the sum of the two fix deltas
                (expect (format "<<TX-AQP-DEB06>> mirror resynced by Σ fix deltas Δm={} Σ={}" [(- mirror-post mirror-pre) (+ (- bunnies-post bunnies-pre) (- coding-post coding-pre))])
                    (+ (- bunnies-post bunnies-pre) (- coding-post coding-pre)) (- mirror-post mirror-pre))
                ;; (d) the inject happened — G advanced on the now-FRESH divisor
                (expect (format "<<TX-AQP-DEB06>> inject advanced G {}->{}" [g-pre g-post]) true (> g-post g-pre))
            ]
        )
    )
)
(commit-tx)
(print "")
;;
;; ============================================================================
;; TX-AQP-DEB07 — 2e IGNIS penalty. DEB06's CC_Inject FORCE-fixed ANHD's 2 stale
;; scores (Bunnies + CodingDivision) on the auryn lane → forced-fix-count = 2.
;; At his next auryn collect he pays 2 × RATE non-discountable IGNIS and the count
;; is zeroed. (Self-fixing at collect, PHASE 6, is never penalized.)
;; ============================================================================
(begin-tx "TX-AQP-DEB07 - forced-fix count recorded by CC_Inject; collect charges + zeroes it")
(namespace "ouronet-ns")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(env-sigs [{ "key": "PK_AncientHodler", "caps": [] }])
(let
    (
        (anhd:string KST.ANHD)
        (ref-U|DALOS:module{UtilityDalosV2} U|DALOS)
        (ref-FVT:module{AcquisitionFarmsVaultsTreasuriesV2} AQP-FVT)
        (ref-TS02-C3:module{TalosStageTwo_ClientThreeV2} TS02-C3)
        (fvt-id:string (ref-U|DALOS::UDC_Makeid "SubsidiaryTreasury"))
        (auryn-id:string "AURYN-98c486052a51")
        (bunnies-score:string (ref-U|DALOS::UDC_Makeid "SubsidiaryBunnies"))
        (ffc-pre:integer (ref-FVT::UR_FVT-FFC|Count fvt-id auryn-id anhd))
    )
    (map print
        [
            (format "<(DEB07 forced-fix-count before collect)> => {}" [ffc-pre])
            ;; CC_Inject (DEB06) forced 2 fixes for ANHD on the auryn lane
            (expect "<<TX-AQP-DEB07>> CC_Inject recorded 2 forced fixes for ANHD (Bunnies + CodingDivision)" 2 ffc-pre)
            (format "<(DEB07 CC_Collect Bunnies auryn)> => \"{}\""
                [(ref-TS02-C3::AQP-FVT|CC_Collect anhd fvt-id 1 bunnies-score auryn-id)])
            ;; the collect charged count×RATE non-discountable IGNIS and ZEROED the count
            (expect "<<TX-AQP-DEB07>> forced-fix count ZEROED after collect (penalty charged)"
                0 (ref-FVT::UR_FVT-FFC|Count fvt-id auryn-id anhd))
        ]
    )
)
(commit-tx)
(print "")
;;
;; ============================================================================
;; TX-AQP-DEB08 — the MTX|2|C_Inject DEFPACT end-to-end (via Talos + continue-pact).
;; Re-stale ANHD (move his deb again), then run the 2-step enforced-fresh inject:
;; step 0 (Talos MTX-AQP|2|C_Inject) scans, finds S ≤ N_FIX → fixes all + injects
;; (terminal); continue-pact 1 resumes {injected:true} → no-op. Proves the defpact
;; path fixes stale stakers + injects on a fresh divisor, same as CC_Inject.
;; ============================================================================
(begin-tx "TX-AQP-DEB08a - re-stale ANHD (move deb again) for the MTX defpact run")
(namespace "ouronet-ns")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(env-sigs [{ "key": "PK_AncientHodler", "caps": [] }])
(let
    (
        (anhd:string KST.ANHD)
        (emma:string KST.EMMA)
        (ref-U|DALOS:module{UtilityDalosV2} U|DALOS)
        (ref-DALOS:module{OuronetDalosV2} DALOS)
        (ref-DPTF:module{DemiourgosPactTrueFungibleV2} DPTF)
        (ref-SCR:module{AcquisitionScoresV2} AQP-SCORE)
        (ref-TS01-C1:module{TalosStageOne_ClientOneV2} TS01-C1)
        (bunnies-pool:string (ref-SCR::UR_SCR|ScoreAqpoolLink (ref-U|DALOS::UDC_Makeid "SubsidiaryBunnies")))
        (bunnies-score:string (ref-U|DALOS::UDC_Makeid "SubsidiaryBunnies"))
        (ea-id:string (ref-DALOS::UR_EliteAurynID))
        (ea-bal:decimal (ref-DPTF::UR_AccountSupply ea-id anhd))
        (deb-pre:decimal (ref-DALOS::UR_Elite-DEB anhd))
    )
    (ref-TS01-C1::DPTF|C_Transfer anhd ea-id anhd emma (floor (* ea-bal 0.99) 4) false)
    (map print
        [
            (format "<(DEB08 elite-deb {} -> {})> " [deb-pre (ref-DALOS::UR_Elite-DEB anhd)])
            (expect (format "<<TX-AQP-DEB08>> ANHD deb moved again got={} pre={}" [(ref-DALOS::UR_Elite-DEB anhd) deb-pre]) true (< (ref-DALOS::UR_Elite-DEB anhd) deb-pre))
            (expect "<<TX-AQP-DEB08>> ANHD Bunnies re-STALE" true (ref-SCR::URC_U-SCR|UserScoreDebStale anhd bunnies-pool bunnies-score))
        ]
    )
)
(commit-tx)
