        (wstoa-id:string (ref-DALOS::UR_WrappedStoaID))
    )
    (let
        (
            (g-pre:decimal (ref-FVT::UR_FVT-RG|CurrentRps fvt-id wstoa-id))
            (ar-pre:decimal (ref-FVT::UR_FVT-RG|AvailableRewards fvt-id wstoa-id))
            (zb-pre:decimal (ref-FVT::UR_FVT-RG|ZombieRewards fvt-id wstoa-id))
        )
        (ref-TS02-C3::AQP-FVT|CC_Inject anhd fvt-id wstoa-id 10.0)
        (ref-TS02-C3::AQP-FVT|CC_Inject anhd fvt-id wstoa-id 15.0)
        (let
            (
                (g-post:decimal (ref-FVT::UR_FVT-RG|CurrentRps fvt-id wstoa-id))
                (ar-post:decimal (ref-FVT::UR_FVT-RG|AvailableRewards fvt-id wstoa-id))
                (zb-post:decimal (ref-FVT::UR_FVT-RG|ZombieRewards fvt-id wstoa-id))
            )
            (map print
                [
                    (format "<(DEB10b zombie pre/post)> => {} / {} (expected +25)" [zb-pre zb-post])
                    (format "<(DEB10b G pre/post)> => {} / {} (must be equal)" [g-pre g-post])
                    (format "<(DEB10b available pre/post)> => {} / {} (must be equal)" [ar-pre ar-post])
                    (expect "<<TX-AQP-DEB10>> zero-inject did NOT revert; escrow accrued 10+15=25"
                        (+ zb-pre 25.0) zb-post)
                    (expect "<<TX-AQP-DEB10>> escrow did NOT advance G (no distribution while empty)"
                        g-pre g-post)
                    (expect "<<TX-AQP-DEB10>> escrow did NOT bump available-rewards (isolated from dust sweep)"
                        ar-pre ar-post)
                ]
