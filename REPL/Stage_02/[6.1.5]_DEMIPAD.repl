;;
;; REPL/Stage_02/[6.1.5]_DEMIPAD.repl — DEMIPAD launchpad Fuel/Retrieve coverage (#79 Phase 1c / #95)
;;   Canonical integration layout. Reuses the CNF NFT collection from [6.1.4] (owner still holds
;;   nonce 2) as a known-state NF asset. Registers it to the launchpad, fuels it in, then retrieves.
;;   TF/OF/SF legs + Withdraw (needs the buy flow) follow in later batches.
;;
(print "")
(print "================================================================")
(print "FILE  REPL/Stage_02/[6.1.5]_DEMIPAD.repl  (DEMIPAD launchpad)")
(print "================================================================")
(print "")

;;================================================================================
(begin-tx "TX-DP-001 - register CNF (NF) to launchpad, fuel a nonce, retrieve it")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(namespace "ouronet-ns")
;;==== TX-DP-001 · 01 · env-sigs (caps) ====
(print "--- [TX-DP-001 · 01 · env-sigs] ---")
(env-sigs [ { "key": "PK_AncientHodler", "caps": [] } ])
;;==== TX-DP-001 · 02 · register / fuel / retrieve ====
(print "--- [TX-DP-001 · 02 · register / fuel / retrieve] ---")
(let
    (
        (ref-DPDC:module{DpdcV2} DPDC)
        (ref-TS02-DPAD:module{TalosStageTwo_DemiPadV2} TS02-DPAD)
        (id:string "CNF-98c486052a51")
        (patron:string KST.ANHD)
    )
    ;; NF fungibility flags = [false false]; register deploys the launchpad's NF account for CNF
    (ref-TS02-DPAD::A_RegisterAssetToLaunchpad patron id [false false])
    ;; fuel nonce 2 (amount 1) into the launchpad (owner holds CNF nonce 2 from [6.1.4])
    (ref-TS02-DPAD::C_DEMIPAD|FuelNonFungible patron patron id [2] [1])
    ;; allow retrieval, then retrieve nonce 2 back to the owner
    (ref-TS02-DPAD::A_ToggleRetrieval id true)
    (ref-TS02-DPAD::C_DEMIPAD|RetrieveNonFungible patron patron id [2] [1])
    (map print
        [
            (expect "<<TX-DP-001>> owner holds CNF nonce 2 again after retrieve" 1 (ref-DPDC::UR_AccountNonceSupply patron id false 2))
            ""
        ]
    )
)
(print "===^^^===")
(commit-tx)
;;================================================================================
(begin-tx "TX-DP-002 - SF (TSFS) register / fuel / retrieve")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(namespace "ouronet-ns")
;;==== TX-DP-002 · 01 · env-sigs (caps) ====
(print "--- [TX-DP-002 · 01 · env-sigs] ---")
(env-sigs [ { "key": "PK_AncientHodler", "caps": [] } ])
;;==== TX-DP-002 · 02 · SF fuel / retrieve ====
(print "--- [TX-DP-002 · 02 · SF fuel / retrieve] ---")
(let
    (
        (ref-DPDC:module{DpdcV2} DPDC)
        (ref-TS02-DPAD:module{TalosStageTwo_DemiPadV2} TS02-DPAD)
        (id:string "TSFS-98c486052a51")
        (patron:string KST.ANHD)
    )
    ;; SF fungibility = [false true]; fuel 100 units of nonce 5, then retrieve them
    (ref-TS02-DPAD::A_RegisterAssetToLaunchpad patron id [false true])
    (ref-TS02-DPAD::C_DEMIPAD|FuelSemiFungible patron patron id [5] [100])
    (ref-TS02-DPAD::A_ToggleRetrieval id true)
    (ref-TS02-DPAD::C_DEMIPAD|RetrieveSemiFungible patron patron id [5] [100])
    (print "<<TX-DP-002>> SF FuelSemiFungible + RetrieveSemiFungible OK")
)
(print "===^^^===")
(commit-tx)
;;||>>>>>>>>>>>>>>>>>>>>>>>>>
;;|| NEXT                   >
;;||>>>>>>>>>>>>>>>>>>>>>>>>>
(print "")

;;================================================================================
(begin-tx "TX-DP-003 - TF (OURO) register / fuel / retrieve")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(namespace "ouronet-ns")
;;==== TX-DP-003 · 01 · env-sigs (caps) ====
(print "--- [TX-DP-003 · 01 · env-sigs] ---")
(env-sigs [ { "key": "PK_AncientHodler", "caps": [] } ])
;;==== TX-DP-003 · 02 · TF fuel / retrieve ====
(print "--- [TX-DP-003 · 02 · TF fuel / retrieve] ---")
(let
    (
        (ref-TS02-DPAD:module{TalosStageTwo_DemiPadV2} TS02-DPAD)
        (id:string "OURO-98c486052a51")
        (patron:string KST.ANHD)
    )
    ;; TF fungibility = [true true]; fuel 100 OURO, then retrieve it
    (ref-TS02-DPAD::A_RegisterAssetToLaunchpad patron id [true true])
    (ref-TS02-DPAD::C_DEMIPAD|FuelTrueFungible patron patron id 100.0)
    (ref-TS02-DPAD::A_ToggleRetrieval id true)
    (ref-TS02-DPAD::C_DEMIPAD|RetrieveTrueFungible patron patron id 100.0)
    (print "<<TX-DP-003>> TF FuelTrueFungible + RetrieveTrueFungible OK")
)
(print "===^^^===")
(commit-tx)
;;================================================================================
(begin-tx "TX-DP-004 - OF: issue fresh DPOF, mint, register, fuel, retrieve")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(namespace "ouronet-ns")
;;==== TX-DP-004 · 01 · env-sigs (STOA fee caps for DPOF issue) ====
(print "--- [TX-DP-004 · 01 · env-sigs] ---")
(env-sigs
    [
        { "key": "PK_AncientHodler", "caps": [] }
        { "key": "6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263",
          "caps":
            [
                (coin.TRANSFER "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263"
                    "k:50d6c59b21e5e6e55baecaa75a1007de37576bde12d8230dc82459cc01b9484b" 1000.0)
                (coin.TRANSFER "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263"
                    "k:0cb30c0121ff919266121a99ff9359871818932211df94dae4137c29bc0e8f7e" 1000.0)
                (coin.TRANSFER "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263"
                    "c:XM-pkmuB5XUQlp87ZYSbfKt8qzmHY6O2EHAzMRVBt3k" 1000.0)
                (coin.TRANSFER "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263"
                    "c:iQQFWj6gWtpGEzhM_O5ekW1QtnQQy55R8BRPGhj_0FU" 1000.0)
            ]
        }
    ]
)
;;==== TX-DP-004 · 02 · issue / mint / register / fuel / retrieve ====
(print "--- [TX-DP-004 · 02 · OF issue/mint/fuel/retrieve] ---")
(let
    (
        (ref-DPOF:module{DemiourgosPactOrtoFungibleV2} DPOF)
        (ref-TS01-C1:module{TalosStageOne_ClientOneV2} TS01-C1)
        (ref-TS02-DPAD:module{TalosStageTwo_DemiPadV2} TS02-DPAD)
        (id:string "COF-98c486052a51")
        (patron:string KST.ANHD)
    )
    ;; issue a fresh DPOF (list args); grant the owner the add-quantity role, then mint a nonce
    (ref-TS01-C1::C_DPOF|Issue patron patron ["CoverageOF"] ["COF"] [2] [true] [true] [true] [true] [true] [true] [true])
    (ref-TS01-C1::C_DPOF|ToggleAddQuantityRole patron id patron true)
    (ref-TS01-C1::C_DPOF|Mint patron id patron 1000.0 [{"cov": "of"}])
    ;; OF fungibility = [true false]; fuel nonce 1 into the launchpad, then retrieve it
    (ref-TS02-DPAD::A_RegisterAssetToLaunchpad patron id [true false])
    (ref-TS02-DPAD::C_DEMIPAD|FuelOrtoFungible patron patron id [1])
    (ref-TS02-DPAD::A_ToggleRetrieval id true)
    (ref-TS02-DPAD::C_DEMIPAD|RetrieveOrtoFungible patron patron id [1])
    (print "<<TX-DP-004>> OF FuelOrtoFungible + RetrieveOrtoFungible OK")
)
(print "===^^^===")
(commit-tx)
(print "")
(print "=== END FILE [6.1.5]_DEMIPAD.repl (batches 1-4: all 8 Fuel*/Retrieve* covered) ===")
;; TODO (#101): Deposit + Withdraw (buy flow: price object + buyer), StoicPay gate (StageZZ).
