(begin-tx "TX-DEP-01 - DEMIPAD|C_Deposit: the royalty split, measured")
(namespace "ouronet-ns")
(env-gasmodel "table")(env-gaslimit 100000000)(env-gas 0)
(print "=== TX-DEP-01 — DEMIPAD|C_Deposit (type 0, native STOA) ==================")
;;==== TX-DEP-01 · 01 · env-sigs (caps) ==== =======================================================
(print "--- [TX-DEP-01 · 01 · env-sigs (caps)] ---")
;; DEMIPAD|C_Deposit is the keystone of the whole launchpad: every citizen sale
;; (Spark/Snakes/Custodians/StoicPay/StoicIco) moves the buyer's money through it, and
;; NOTHING had ever called it. It is also where the launchpad's economics actually live --
;; the 15% royalty and its 10/20/30/40 environment split are described in DEMIPAD's module
;; @doc and were, until this test, described NOWHERE ELSE and checked by nothing.
;;
;; It was never called because of a PRICE-PATH DEPENDENCY, and that is worth recording as a
;; property of the system rather than a quirk of the harness. URC_Prices converts dollars to
;; tokens through SWPI::URC_OuroPrimordialPrice, which reads the primordial OURO pool. With
;; no pool, UR_PoolTokenSupplies is handed the BAR sentinel "|" and the call dies with
;;      No value found in table ouronet-ns.SWP_SWP|Pairs for key: |
;; -- a raw table miss naming neither DEMIPAD nor the missing precondition. So a deposit is
;; only reachable AFTER pools exist. ZALL already loads [6.3]_SWP long before this file, so
;; the state is there; modules/LAUNCHPAD.repl had to be taught to load the same prerequisites
;; to stay genuinely standalone.
;;
;; SIGNING SHAPE, which is itself the reason this is fiddly: TWO different signers are
;; required. PK_Emma unscoped satisfies the OURONET account guard (CAP_EnforceAccountOwnership
;; inside LIQUID|C>X_WRAPPER); the raw STOA pubkey, scoped, installs the managed coin.TRANSFER
;; capabilities. Signing only one of them fails in a place that does not mention the other.
(env-sigs
    [ { "key": "PK_AncientHodler", "caps": [] }
    , { "key": "PK_Emma", "caps": [] }
    , { "key": "ecaeae048b6e4b1d4cd9b5ba41041b39e05ac3a7b32f495a12823cb1c5ad0f48", "caps":
        ;;Granted at the EXACT split amounts, not a round ceiling. A managed cap caps the
        ;;transfer, so exact grants make this signature block a second, independent statement
        ;;of what the split must be: if the contract ever moves a different amount to any
        ;;receiver, the capability itself refuses before any assertion below runs.
        [ (coin.TRANSFER "k:ecaeae048b6e4b1d4cd9b5ba41041b39e05ac3a7b32f495a12823cb1c5ad0f48" "c:ZNfuj3iZI83n7MUSKGuoXoSxFg1cyMxCzB3szUHVvrI" 95.0)
        , (coin.TRANSFER "k:ecaeae048b6e4b1d4cd9b5ba41041b39e05ac3a7b32f495a12823cb1c5ad0f48" "c:iQQFWj6gWtpGEzhM_O5ekW1QtnQQy55R8BRPGhj_0FU" 0.5)
        , (coin.TRANSFER "k:ecaeae048b6e4b1d4cd9b5ba41041b39e05ac3a7b32f495a12823cb1c5ad0f48" "k:0cb30c0121ff919266121a99ff9359871818932211df94dae4137c29bc0e8f7e" 1.0)
        , (coin.TRANSFER "k:ecaeae048b6e4b1d4cd9b5ba41041b39e05ac3a7b32f495a12823cb1c5ad0f48" "k:50d6c59b21e5e6e55baecaa75a1007de37576bde12d8230dc82459cc01b9484b" 1.5)
        , (coin.TRANSFER "k:ecaeae048b6e4b1d4cd9b5ba41041b39e05ac3a7b32f495a12823cb1c5ad0f48" "c:XM-pkmuB5XUQlp87ZYSbfKt8qzmHY6O2EHAzMRVBt3k" 2.0)
        ] }
    ])
;;==== TX-DEP-01 · 02 · let / invocation ==== ======================================================
(print "--- [TX-DEP-01 · 02 · let / invocation] ---")
(let*
    (
        (ref-TS02-DPAD:module{TalosStageTwo_DemiPadV2} TS02-DPAD)
        (ref-DPAD:module{DemiourgosLaunchpadV2} DEMIPAD)
        (ref-DPTF:module{DemiourgosPactTrueFungibleV2} DPTF)
        (ref-DALOS:module{OuronetDalosV2} DALOS)
        (ref-U|CT|DIA:module{DiaStoaPidV2} U|CT)
        (ref-I|OURONET:module{OuronetInfoV2} IGNIS)
        (ref-coin:module{stoa-ns.fungible-v1} coin)
        (asset:string "DHOC-98c486052a51")
        (dollars:decimal 10.0)
        (buyer:string KST.EMMA)
        (buyer-stoa:string (ref-DALOS::UR_AccountStoa KST.EMMA))
        (wstoa:string (ref-DALOS::UR_WrappedStoaID))
        (lpad-sc:string (ref-DPAD::GOV|DEMIPAD|SC_NAME))
        (stoa-price:decimal (ref-U|CT|DIA::UR_STOA-PID|Price))
        ;;The split the contract will apply, read BEFORE the deposit so the assertions
        ;;compare exec against the contract's own declared intent, not against my arithmetic.
        (prices:object (ref-DPAD::URC_Prices asset dollars 0))
        (env-amt:decimal (at "enviroment-amount" prices))
        (cod-amt:decimal (at "coding-amount" prices))
        (rem-amt:decimal (at "remainder-amount" prices))
        (r1:string (at "receiver-one" prices))
        (a1:decimal (at "amount-one" prices))
        (a2:decimal (at "amount-two" prices))
        (a3:decimal (at "amount-three" prices))
        (a4:decimal (at "amount-four" prices))
        ;;Gross in TOKENS is not a constant: it is dollars / the live STOA price. Deriving it
        ;;keeps this test correct if the locked price ever moves, instead of pinning 100.0.
        (gross:decimal (/ dollars stoa-price))
        (buyer-before:decimal (ref-coin::get-balance buyer-stoa))
        (gas-station-before:decimal (ref-coin::get-balance (ref-DALOS::GOV|DALOS|SC_STOA-NAME)))
        (funds-before:decimal (ref-DPAD::UR_WSTOA|Funds asset))
        (resident-before:decimal (ref-DPAD::UR_WSTOA))
        (sc-before:decimal (ref-DPTF::UR_AccountSupply wstoa lpad-sc))
    )
    (map print
        [
            ;;THE SPLIT, against DEMIPAD's own module @doc. Until now these numbers existed
            ;;only in prose.
            (expect "<<TX-DEP-01>> royalty is 15% of gross (doc: 'starts at 15%')"
                (* gross 0.15) (+ env-amt cod-amt))
            (expect "<<TX-DEP-01>> the environment takes exactly ONE THIRD of the royalty"
                (/ (+ env-amt cod-amt) 3.0) env-amt)
            (expect "<<TX-DEP-01>> the coding-division pot takes the other TWO THIRDS"
                (* (/ (+ env-amt cod-amt) 3.0) 2.0) cod-amt)
            (expect "<<TX-DEP-01>> the seller's remainder is gross minus royalty"
                (- gross (+ env-amt cod-amt)) rem-amt)
            ;;The environment third splits 10/20/30/40 (doc: gas station / treasury /
            ;;maintenance / liquid staking).
            (expect "<<TX-DEP-01>> environment split is 10% to the gas station"
                (* env-amt 0.10) a1)
            (expect "<<TX-DEP-01>> environment split is 20% to the treasury"
                (* env-amt 0.20) a2)
            (expect "<<TX-DEP-01>> environment split is 30% to launchpad maintenance"
                (* env-amt 0.30) a3)
            (expect "<<TX-DEP-01>> environment split is 40% to liquid staking"
                (* env-amt 0.40) a4)
            (expect "<<TX-DEP-01>> the four environment legs sum back to the environment third"
                env-amt (+ (+ a1 a2) (+ a3 a4)))
            ;;STRUCTURAL: receiver-one is not an arbitrary address, it IS the Ouronet gas
            ;;station. Pinning the identity means a future edit that repoints the 10% leg
            ;;fails here rather than silently paying a stranger.
            (expect "<<TX-DEP-01>> receiver-one IS the Ouronet gas station account"
                (ref-DALOS::GOV|DALOS|SC_STOA-NAME) r1)
        ]
    )
    (let
        (
            (msg:string (ref-TS02-DPAD::DEMIPAD|C_Deposit KST.ANHD buyer asset dollars 0 false -1.0))
        )
        (print (format "<(TS02-DPAD.DEMIPAD|C_Deposit)> => \"{}\"" [msg]))
        (map print
            [
                (expect "<<TX-DEP-01>> the deposit reports the dollar amount and the asset"
                    (format "Succesfuly deposited {} $ worth against {} into Demipad from {}."
                        [dollars asset (ref-I|OURONET::OI|UC_ShortAccount buyer)]) msg)
                ;;THE BUYER PAYS THE GROSS, not the remainder: royalty comes out of the
                ;;deposit, it is not added on top.
                (expect "<<TX-DEP-01>> the buyer is debited the full gross in native STOA"
                    (- buyer-before gross) (ref-coin::get-balance buyer-stoa))
                (expect "<<TX-DEP-01>> $10 at the live STOA price is the token amount actually moved"
                    gross (- buyer-before (ref-coin::get-balance buyer-stoa)))
                ;;The gas station's 10% leg really lands.
                (expect "<<TX-DEP-01>> the gas station received its 10% environment leg"
                    (+ gas-station-before a1)
                    (ref-coin::get-balance (ref-DALOS::GOV|DALOS|SC_STOA-NAME)))
                ;;Ledger: the seller can withdraw the remainder, and only the remainder.
                (expect "<<TX-DEP-01>> the seller ledger is credited the remainder"
                    (+ funds-before rem-amt) (ref-DPAD::UR_WSTOA|Funds asset))
                ;;Resident: the coding-division two-thirds is retained in the pad (the doc's
                ;;"until acquisition pools are live, retained as Resident WSTOA").
                (expect "<<TX-DEP-01>> the coding two-thirds is retained as resident WSTOA"
                    (+ resident-before cod-amt) (ref-DPAD::UR_WSTOA))
                ;;CONSERVATION, and the one that would catch a phantom credit: everything the
                ;;pad OWES (seller ledger + resident) must equal what it HOLDS.
                (expect "<<TX-DEP-01>> the pad HOLDS exactly what it OWES (ledger + resident)"
                    (+ sc-before (+ rem-amt cod-amt)) (ref-DPTF::UR_AccountSupply wstoa lpad-sc))
                (expect "<<TX-DEP-01>> and that equals the non-environment 95% of the deposit"
                    (- gross env-amt) (+ rem-amt cod-amt))
                (expect "<<TX-DEP-01>> dollars raised is recorded in DOLLARS, not tokens"
                    dollars (ref-DPAD::UR_TotalDollarzRaised asset))
            ]
        )
        ""
    )
)
(print "")
(print "")
;;==== TX-DEP-01 · 03 · gas echo ==== ==============================================================
(print "--- [TX-DEP-01 · 03 · gas echo] ---")
(format "<<<<<<<TX-DEP-01 DEMIPAD|C_Deposit ==> {} GAS>>>>>>>" [(env-gas)])
(print "")
(print "===^^^===")
(env-sigs [])
(commit-tx)
;;||>>>>>>>>>>>>>>>>>>>>>>>>>
;;|| NEXT                   >
;;||>>>>>>>>>>>>>>>>>>>>>>>>>
(begin-tx "TX-DEP-02 - DEMIPAD|C_Withdraw: the seller takes the remainder")
(namespace "ouronet-ns")
(env-gasmodel "table")(env-gaslimit 100000000)(env-gas 0)
(print "=== TX-DEP-02 — DEMIPAD|C_Withdraw (type 1, WSTOA) ======================")
;;==== TX-DEP-02 · 01 · the withdraw gate ==== =====================================================
(print "--- [TX-DEP-02 · 01 · the withdraw gate] ---")
;; The other half of the deposit: what TX-DEP-01 credited to the seller ledger, C_Withdraw
;; pays out. Three guards on DEMIPAD|C>WITHDRAW, probed before the happy path so each one is
;; isolated against a ledger that is known to be NON-empty.
(env-sigs [{ "key": "PK_AncientHodler", "caps": [] }])
(let
    (
        (ref-TS02-DPAD:module{TalosStageTwo_DemiPadV2} TS02-DPAD)
        (ref-DPAD:module{DemiourgosLaunchpadV2} DEMIPAD)
        (asset:string "DHOC-98c486052a51")
    )
    (map print
        [
            ;;TYPE. Deposits accept type 0 (native STOA); WITHDRAWALS do not -- funds are held
            ;;wrapped, so there is no native-STOA balance to pay out.
            ;;
            ;;FINDING -- PROVABLY DEAD ENFORCE. The message you get is "Invalid Read Type",
            ;;NOT the "Invalid Withdrawal type" that DEMIPAD|C>WITHDRAW raises. C_Withdraw
            ;;binds (UR_Funds asset-id type) BEFORE entering with-capability, and UR_Funds
            ;;opens with the IDENTICAL predicate:
            ;;
            ;;    UR_Funds            (enforce (contains type [1 2 3]) "Invalid Read Type")
            ;;    DEMIPAD|C>WITHDRAW  (enforce iz-type                 "Invalid Withdrawal type")
            ;;                        where iz-type = (contains type [1 2 3])
            ;;
            ;;Same predicate, and the reader runs first. So for EVERY input the cap's enforce
            ;;is unreachable: type in [1 2 3] passes both, type outside it dies in UR_Funds.
            ;;This is not "hard to test" -- it is untestable by construction, which is the
            ;;definition in REPL_TEST_ARCHITECTURE.md Rule 3, and the duplicate-validation
            ;;case CLAUDE.md warns about (do not repeat the same check in defcap and reader).
            ;;Left in place pending the owner's call: removing it is a core-code change, and
            ;;the argument for keeping it is defence-in-depth if C_Withdraw is ever refactored
            ;;to stop reading first. Either way the message a caller actually sees today is
            ;;the one asserted here, so this test tracks reality rather than intent.
            (expect-failure "<<TX-DEP-02>> FINDING: type 0 dies in UR_Funds, so the cap's own type enforce is unreachable"
                "Invalid Read Type"
                (ref-TS02-DPAD::DEMIPAD|C_Withdraw KST.ANHD asset 0 KST.EMMA))
            ;;The same shadowing for every other out-of-range type -- so the deadness is a
            ;;property of the pair of functions, not an artefact of the value 0.
            (expect-failure "<<TX-DEP-02>> ...and the same shadowing holds for any other out-of-range type"
                "Invalid Read Type"
                (ref-TS02-DPAD::DEMIPAD|C_Withdraw KST.ANHD asset 99 KST.EMMA))
            ;;EMPTY LEDGER. Aimed at SSTOA, which this sale never took, so the ONLY reason it
            ;;fails is the zero balance -- not the type, not the destination, not access.
            (expect-failure "<<TX-DEP-02>> withdrawing a currency the sale never took is rejected"
                "There is nothing to retrieve for Asset-Id DHOC-98c486052a51 and Token Type 2 (SSTOA)"
                (ref-TS02-DPAD::DEMIPAD|C_Withdraw KST.ANHD asset 2 KST.EMMA))
            ;;And the WSTOA ledger really is non-empty, so the rejection above was about SSTOA
            ;;alone. Without this the test above would pass just as well on a dead launchpad.
            (expect "<<TX-DEP-02>> ...while the WSTOA ledger IS funded"
                true (> (ref-DPAD::UR_WSTOA|Funds asset) 0.0))
        ]
    )
    ""
)
(print "")
;;==== TX-DEP-02 · 02 · the payout ==== ============================================================
(print "--- [TX-DEP-02 · 02 · the payout] ---")
(let*
    (
        (ref-TS02-DPAD:module{TalosStageTwo_DemiPadV2} TS02-DPAD)
        (ref-DPAD:module{DemiourgosLaunchpadV2} DEMIPAD)
        (ref-DPTF:module{DemiourgosPactTrueFungibleV2} DPTF)
        (ref-DALOS:module{OuronetDalosV2} DALOS)
        (asset:string "DHOC-98c486052a51")
        (dest:string KST.EMMA)
        (wstoa:string (ref-DALOS::UR_WrappedStoaID))
        (lpad-sc:string (ref-DPAD::GOV|DEMIPAD|SC_NAME))
        (owed:decimal (ref-DPAD::UR_WSTOA|Funds asset))
        (resident:decimal (ref-DPAD::UR_WSTOA))
        (dest-before:decimal (ref-DPTF::UR_AccountSupply wstoa dest))
        (sc-before:decimal (ref-DPTF::UR_AccountSupply wstoa lpad-sc))
    )
    (ref-TS02-DPAD::DEMIPAD|C_Withdraw KST.ANHD asset 1 dest)
    (map print
        [
            (expect "<<TX-DEP-02>> the destination receives the whole seller ledger"
                (+ dest-before owed) (ref-DPTF::UR_AccountSupply wstoa dest))
            (expect "<<TX-DEP-02>> the pad pays out exactly what it owed"
                (- sc-before owed) (ref-DPTF::UR_AccountSupply wstoa lpad-sc))
            (expect "<<TX-DEP-02>> the seller ledger is zeroed, not decremented"
                0.0 (ref-DPAD::UR_WSTOA|Funds asset))
            ;;THE IMPORTANT ONE. The withdrawal must NOT touch the resident coding-division
            ;;pot, which lives in the same account. A payout that swept the SC balance instead
            ;;of the ledger amount would look identical on the destination side and silently
            ;;drain the pot -- so this is asserted separately from the balance maths above.
            (expect "<<TX-DEP-02>> the resident coding pot is untouched by the seller payout"
                resident (ref-DPAD::UR_WSTOA))
            (expect "<<TX-DEP-02>> ...and the pad still HOLDS what it still OWES"
                (ref-DPAD::UR_WSTOA) (ref-DPTF::UR_AccountSupply wstoa lpad-sc))
            ;;DOUBLE-WITHDRAW. Now that the ledger is zero, the same call that just succeeded
            ;;is rejected -- the guard is a live balance check, not a one-shot flag.
            (expect-failure "<<TX-DEP-02>> a second withdrawal finds nothing to retrieve"
                "There is nothing to retrieve for Asset-Id DHOC-98c486052a51 and Token Type 1 (WSTOA)"
                (ref-TS02-DPAD::DEMIPAD|C_Withdraw KST.ANHD asset 1 dest))
            ;;Dollars raised is a CUMULATIVE sale record, not a balance: paying the seller out
            ;;must not erase the history of what was raised.
            (expect "<<TX-DEP-02>> dollars-raised survives the payout (it is history, not a balance)"
                10.0 (ref-DPAD::UR_TotalDollarzRaised asset))
        ]
    )
    ""
)
(print "")
(print "")
;;==== TX-DEP-02 · 03 · gas echo ==== ==============================================================
(print "--- [TX-DEP-02 · 03 · gas echo] ---")
(format "<<<<<<<TX-DEP-02 DEMIPAD|C_Withdraw ==> {} GAS>>>>>>>" [(env-gas)])
(print "")
(print "===^^^===")
(env-sigs [])
(commit-tx)
;;||>>>>>>>>>>>>>>>>>>>>>>>>>
;;|| NEXT                   >
;;||>>>>>>>>>>>>>>>>>>>>>>>>>
(begin-tx "TX-ACQ-01 - fuel the pad: fragment a DHOC nonce and transmit it for sale")
(namespace "ouronet-ns")
(env-gasmodel "table")(env-gaslimit 100000000)(env-gas 0)
(print "=== TX-ACQ-01 — fuel the Custodians sale ================================")
;;==== TX-ACQ-01 · 01 · fragment + fuel ==== =======================================================
(print "--- [TX-ACQ-01 · 01 · fragment + fuel] ---")
;; "Fuel Assets for Sale must be done separately" -- the Custodians init above says so, and
;; separately never happened, which is why all four citizen sales sat at zero coverage. This
;; establishes the missing fixture.
;;
;; Custodians sells FRAGMENT nonces: UEV_AcquisitionNonce admits only [-3 -2 -1]
;; (Bronze/Silver/Golden). Fragments are minted by DPDC-F, which "locks a native nonce,
;; credits 1000x negative fragment nonces" -- so native nonce N becomes fragment nonce -N at
;; 1000x the count. ANHD holds DHOC nonce 1, and [6.1]_DPDC already enabled fragmentation on
;; it, so C_MakeFragments is the only step needed.
(env-sigs [{ "key": "PK_AncientHodler", "caps": [] }])
(let
    (
        (ref-DPDC:module{DpdcV2} DPDC)
        (ref-TS02-C1:module{TalosStageTwo_ClientOneV2} TS02-C1)
        (ref-TS02-DPAD:module{TalosStageTwo_DemiPadV2} TS02-DPAD)
        (ref-DPAD:module{DemiourgosLaunchpadV2} DEMIPAD)
        (owner:string KST.ANHD)
        (asset:string "DHOC-98c486052a51")
    )
    (let
        (
            (lpad:string (ref-DPAD::GOV|DEMIPAD|SC_NAME))
            (native-before:integer (ref-DPDC::UR_AccountNonceSupply KST.ANHD asset true 1))
        )
        (map print
            [
                ;;The pad starts holding NONE. -1 is DPDC's "holds none" sentinel, not 0 --
                ;;asserting 0 here would silently pass on a different failure.
                (expect "<<TX-ACQ-01>> the pad holds no fragments before fuelling (-1 sentinel)"
                    -1 (ref-DPDC::UR_AccountNonceSupply lpad asset true -1))
            ]
        )
        (ref-TS02-C1::DPSF|C_MakeFragments owner owner asset 1 10)
        (map print
            [
                ;;1000x, and the native units are LOCKED (spent), not copied.
                (expect "<<TX-ACQ-01>> fragmenting 10 native units credits 10,000 fragments at nonce -1"
                    10000 (ref-DPDC::UR_AccountNonceSupply owner asset true -1))
                (expect "<<TX-ACQ-01>> ...and the 10 native units are consumed, not duplicated"
                    (- native-before 10) (ref-DPDC::UR_AccountNonceSupply owner asset true 1))
            ]
        )
        (ref-TS02-DPAD::DEMIPAD|C_FuelSemiFungible owner owner asset [-1] [10000])
        (map print
            [
                (expect "<<TX-ACQ-01>> the pad now holds the fragments"
                    10000 (ref-DPDC::UR_AccountNonceSupply lpad asset true -1))
                (expect "<<TX-ACQ-01>> ...transferred out of the owner, not minted"
                    0 (ref-DPDC::UR_AccountNonceSupply owner asset true -1))
                ;;The sale's own availability reader must agree with the raw DPDC supply, or
                ;;the supply cap in CUSTODIANS|ACQUIRE guards the wrong number.
                (expect "<<TX-ACQ-01>> the sale's availability reader agrees with DPDC's supply"
                    10000 (DEMIPAD-CUSTODIANS.UR_NonceSaleAvailability -1))
            ]
        )
        ""
    )
)
(print "")
(print "===^^^===")
(env-sigs [])
(commit-tx)
;;||>>>>>>>>>>>>>>>>>>>>>>>>>
;;|| NEXT                   >
;;||>>>>>>>>>>>>>>>>>>>>>>>>>
(begin-tx "TX-ACQ-02 - CUSTODIANS|C_Acquire: the first citizen sale ever executed")
(namespace "ouronet-ns")
(env-gasmodel "table")(env-gaslimit 100000000)(env-gas 0)
(print "=== TX-ACQ-02 — CUSTODIANS|C_Acquire ===================================")
;;==== TX-ACQ-02 · 01 · quote the sale the way a client must ==== ==================================
(print "--- [TX-ACQ-02 · 01 · quote the sale the way a client must] ---")
;; URC_Acquire is the documented client entry: it returns the coin.TRANSFER capability
;; DESCRIPTIONS the UI must sign. Quote first, then sign exactly those, then submit.
(let
    (
        (ref-DPAD:module{DemiourgosLaunchpadV2} DEMIPAD)
        (ref-U|CT|DIA:module{DiaStoaPidV2} U|CT)
        (asset:string "DHOC-98c486052a51")
    )
    (let
        (
            (costs:object (DEMIPAD-CUSTODIANS.URC_NonceAmountCosts -1 10))
            (unit:decimal (at "quintessence-price" (ref-DPAD::UR_Price asset)))
            (stoa-price:decimal (ref-U|CT|DIA::UR_STOA-PID|Price))
        )
        (map print
            [
                ;;Price is per FRAGMENT and quoted in dollars; the token leg is that divided by
                ;;the live STOA price. Both derived, so a price move does not falsify the test.
                (expect "<<TX-ACQ-02>> 10 fragments cost 10x the quintessence price, in dollars"
                    (* unit 10.0) (at "pid" costs))
                (expect "<<TX-ACQ-02>> the token leg is the dollar cost at the live STOA price"
                    (/ (at "pid" costs) stoa-price) (at "wstoa" costs))
                ;;FINDING -- UNGUARDED NEGATIVE SLIPPAGE. URC_Acquire pads each signed cap by
                ;;UC_SlippageFactor = (1 + slippage/100), and that helper has NO non-negative
                ;;guard. A negative slippage therefore SHRINKS the ceilings below the true
                ;;cost, so the transaction can only ever fail -- at the coin layer, with
                ;;"Managed capability not installed", naming neither DEMIPAD nor slippage.
                ;;
                ;;What makes this more than theoretical: the value most likely to be passed by
                ;;mistake is -1.0, because that is the documented "slippage off" SENTINEL for
                ;;C_Acquire's <max-cost> -- the sibling argument in the very same call. The
                ;;same number means "off" in one and "-1%" in the other. (Variant 2, genuinely
                ;;slippage-off, is the separate install-based CAP_Acquire.) One
                ;;(enforce (>= slippage 0.0)) in UC_SlippageFactor removes the trap.
                (expect "<<TX-ACQ-02>> FINDING: a NEGATIVE slippage silently shrinks the signed caps below cost"
                    true
                    (< (ref-DPAD::UC_SlippageFactor -1.0) 1.0))
                (expect "<<TX-ACQ-02>> ...while 0.0 is the documented 'exact caps' value"
                    1.0 (ref-DPAD::UC_SlippageFactor 0.0))
            ]
        )
        ""
    )
)
;;==== TX-ACQ-02 · 02 · FINDING probe, isolated in a rolled-back tx ==== ===========================
(print "--- [TX-ACQ-02 · 02 · FINDING probe, isolated in a rolled-back tx] ---")
(env-sigs
    [ { "key": "PK_AncientHodler", "caps": [] }
    , { "key": "PK_Emma", "caps": [] }
    , { "key": "ecaeae048b6e4b1d4cd9b5ba41041b39e05ac3a7b32f495a12823cb1c5ad0f48", "caps":
        [ (coin.TRANSFER "k:ecaeae048b6e4b1d4cd9b5ba41041b39e05ac3a7b32f495a12823cb1c5ad0f48" "c:ZNfuj3iZI83n7MUSKGuoXoSxFg1cyMxCzB3szUHVvrI" 142.5)
        , (coin.TRANSFER "k:ecaeae048b6e4b1d4cd9b5ba41041b39e05ac3a7b32f495a12823cb1c5ad0f48" "c:iQQFWj6gWtpGEzhM_O5ekW1QtnQQy55R8BRPGhj_0FU" 0.75)
        , (coin.TRANSFER "k:ecaeae048b6e4b1d4cd9b5ba41041b39e05ac3a7b32f495a12823cb1c5ad0f48" "k:0cb30c0121ff919266121a99ff9359871818932211df94dae4137c29bc0e8f7e" 1.5)
        , (coin.TRANSFER "k:ecaeae048b6e4b1d4cd9b5ba41041b39e05ac3a7b32f495a12823cb1c5ad0f48" "k:50d6c59b21e5e6e55baecaa75a1007de37576bde12d8230dc82459cc01b9484b" 2.25)
        , (coin.TRANSFER "k:ecaeae048b6e4b1d4cd9b5ba41041b39e05ac3a7b32f495a12823cb1c5ad0f48" "c:XM-pkmuB5XUQlp87ZYSbfKt8qzmHY6O2EHAzMRVBt3k" 3.0)
        ] }
    ])
;;FINDING -- THE CREATOR CANNOT BE THE PATRON. DPDC's collectable transfer pays an IGNIS
;;royalty from the PATRON to the collection's CREATOR. ANHD created DHOC, so with ANHD as
;;patron the leg becomes a self-payment and IGNIS|C>ROYALTY rejects it with "Sender and
;;Receiver must be different" -- naming neither royalty nor the collection. This is a real
;;operational shape, not a contrivance: the launchpad operator paying gas for their own sale
;;IS the creator. UC_CleanseAggregatedRoyalties already drops ZERO-royalty entries; dropping
;;creator == patron entries the same way would close it.
;;
;;WHY THIS PROBE LIVES ALONE IN A ROLLED-BACK TRANSACTION -- a REPL hazard worth stating
;;plainly, because it silently cost me two assertions before I noticed. `expect-failure`
;;CATCHES the abort but does NOT roll back writes already applied: there is no savepoint.
;;The sale moves the buyer's money (C_Deposit) BEFORE the collectable leg that fails here, so
;;the caught failure leaves the buyer debited and the dollar ledger advanced. Run inline, the
;;happy-path assertions below then saw a DOUBLE debit (300 STOA, not 150) and a doubled
;;ledger -- failing for a reason that had nothing to do with what they test.
;;
;;On-chain this cannot happen: a failed transaction reverts entirely. It is purely an
;;artefact of catching mid-transaction. The remedy is structural -- give any expect-failure
;;on a STATE-MUTATING op its own transaction and end it with (rollback-tx), never
;;(commit-tx). Recorded as Rule 9 in REPL_TEST_ARCHITECTURE.md; the suite has 22 other
;;expect-failure sites on C_/A_ ops that need the same audit, and used (rollback-tx) in
;;exactly zero places before this one.
(let
    (
        (ref-CPAD:module{CitizenLaunchpadTalosV2} TS02-CPAD)
    )
    (map print
        [
            (expect-failure "<<TX-ACQ-02>> FINDING: the collection creator cannot patron a sale of their own collection"
                "Sender and Receiver must be different"
                (ref-CPAD::CUSTODIANS|C_Acquire KST.ANHD KST.EMMA -1 10 true -1.0))
        ]
    )
    ""
)
(env-sigs [])
;;ROLLBACK, not commit -- discards whatever the caught failure left half-written.
(rollback-tx)
;;||>>>>>>>>>>>>>>>>>>>>>>>>>
;;|| NEXT                   >
;;||>>>>>>>>>>>>>>>>>>>>>>>>>
(begin-tx "TX-ACQ-02b - CUSTODIANS|C_Acquire: the first citizen sale ever executed")
(namespace "ouronet-ns")
(env-gasmodel "table")(env-gaslimit 100000000)(env-gas 0)
;;==== TX-ACQ-02b · 01 · sign the quoted caps and buy ==== =========================================
(print "--- [TX-ACQ-02b · 01 · sign the quoted caps and buy] ---")
;;These five caps are exactly what URC_Acquire returns at slippage 0.0 for 10 fragments
;;($15 = 150 wSTOA): the 142.5 non-environment leg plus the 0.75/1.5/2.25/3.0 environment
;;split. Granted at the exact amounts, so the signature block independently restates the
;;economics TX-DEP-01 measured.
(env-sigs
    [ { "key": "PK_AncientHodler", "caps": [] }
    , { "key": "PK_Emma", "caps": [] }
    , { "key": "ecaeae048b6e4b1d4cd9b5ba41041b39e05ac3a7b32f495a12823cb1c5ad0f48", "caps":
        [ (coin.TRANSFER "k:ecaeae048b6e4b1d4cd9b5ba41041b39e05ac3a7b32f495a12823cb1c5ad0f48" "c:ZNfuj3iZI83n7MUSKGuoXoSxFg1cyMxCzB3szUHVvrI" 142.5)
        , (coin.TRANSFER "k:ecaeae048b6e4b1d4cd9b5ba41041b39e05ac3a7b32f495a12823cb1c5ad0f48" "c:iQQFWj6gWtpGEzhM_O5ekW1QtnQQy55R8BRPGhj_0FU" 0.75)
        , (coin.TRANSFER "k:ecaeae048b6e4b1d4cd9b5ba41041b39e05ac3a7b32f495a12823cb1c5ad0f48" "k:0cb30c0121ff919266121a99ff9359871818932211df94dae4137c29bc0e8f7e" 1.5)
        , (coin.TRANSFER "k:ecaeae048b6e4b1d4cd9b5ba41041b39e05ac3a7b32f495a12823cb1c5ad0f48" "k:50d6c59b21e5e6e55baecaa75a1007de37576bde12d8230dc82459cc01b9484b" 2.25)
        , (coin.TRANSFER "k:ecaeae048b6e4b1d4cd9b5ba41041b39e05ac3a7b32f495a12823cb1c5ad0f48" "c:XM-pkmuB5XUQlp87ZYSbfKt8qzmHY6O2EHAzMRVBt3k" 3.0)
        ] }
    ])
(let
    (
        (ref-CPAD:module{CitizenLaunchpadTalosV2} TS02-CPAD)
        (ref-DPDC:module{DpdcV2} DPDC)
        (ref-DPAD:module{DemiourgosLaunchpadV2} DEMIPAD)
        (ref-DALOS:module{OuronetDalosV2} DALOS)
        (ref-coin:module{stoa-ns.fungible-v1} coin)
        (asset:string "DHOC-98c486052a51")
        (buyer:string KST.EMMA)
    )
    (let
        (
            (lpad:string (ref-DPAD::GOV|DEMIPAD|SC_NAME))
            (buyer-stoa:string (ref-DALOS::UR_AccountStoa KST.EMMA))
        )
        (let
            (
                (pad-before:integer (ref-DPDC::UR_AccountNonceSupply lpad asset true -1))
                (buyer-frags-before:integer (ref-DPDC::UR_AccountNonceSupply buyer asset true -1))
                (buyer-stoa-before:decimal (ref-coin::get-balance buyer-stoa))
                (raised-before:decimal (ref-DPAD::UR_TotalDollarzRaised asset))
                (cost-pid:decimal (at "pid" (DEMIPAD-CUSTODIANS.URC_NonceAmountCosts -1 10)))
                (cost-tok:decimal (at "wstoa" (DEMIPAD-CUSTODIANS.URC_NonceAmountCosts -1 10)))
            )
            (map print
                [
                    ;;Proves the rollback above actually took: had the caught failure's writes
                    ;;survived, the buyer would already hold fragments and the pad would be short.
                    (expect "<<TX-ACQ-02b>> the rolled-back probe left NO fragments with the buyer"
                        -1 buyer-frags-before)
                    (expect "<<TX-ACQ-02b>> ...and the pad's stock is still whole"
                        10000 pad-before)
                ]
            )
            (let
                (
                    (r (ref-CPAD::CUSTODIANS|C_Acquire buyer buyer -1 10 true -1.0))
                )
                (print (format "<(TS02-CPAD.CUSTODIANS|C_Acquire)> => \"{}\"" [r]))
                (map print
                    [
                        ;;FINDING -- the wrapper DISCARDS the sale's own result. Its last form is
                        ;;(XB_DynamicFuelSTOA), whose value is a bare true, so the caller cannot
                        ;;tell what was bought. CLAUDE.md's Talos rule asks for "a clear format
                        ;;result string explaining the branch taken". KPAY|C_BuyStoicPay in the
                        ;;SAME file does it correctly -- it binds acquisition-text and returns
                        ;;that after the refuel. SPARK|C_BuySparks and SNAKES|C_Acquire share the
                        ;;defect: 3 of the 4 refuel-carrying sale wrappers.
                        (expect "<<TX-ACQ-02b>> FINDING: the wrapper returns the refuel's bare true, discarding the sale result"
                            true r)
                        ;;THE SALE ITSELF.
                        (expect "<<TX-ACQ-02b>> the buyer receives exactly the fragments bought"
                            10 (ref-DPDC::UR_AccountNonceSupply buyer asset true -1))
                        (expect "<<TX-ACQ-02b>> the pad's stock drops by exactly that many"
                            (- pad-before 10) (ref-DPDC::UR_AccountNonceSupply lpad asset true -1))
                        ;;PAID IN NATIVE STOA (iz-native true), at the quoted token cost.
                        (expect "<<TX-ACQ-02b>> the buyer pays the quoted token cost in native STOA"
                            (- buyer-stoa-before cost-tok) (ref-coin::get-balance buyer-stoa))
                        ;;The sale routes its money through DEMIPAD|C_Deposit, so the dollar
                        ;;ledger must advance by the quoted dollars -- this is what ties the
                        ;;citizen sale to the sovereign launchpad accounting.
                        (expect "<<TX-ACQ-02b>> the sale is recorded in the launchpad's dollar ledger"
                            (+ raised-before cost-pid) (ref-DPAD::UR_TotalDollarzRaised asset))
                    ]
                )
                ""
            )
        )
    )
)
;;==== TX-ACQ-02b · 02 · the supply cap, against a stocked pad ==== ================================
(print "--- [TX-ACQ-02b · 02 · the supply cap, against a stocked pad] ---")
;;The pre-existing #3H test proves over-supply is rejected on an EMPTY pad, where any
;;non-zero request exceeds availability. That is a weaker statement than it looks. Now that
;;the pad genuinely holds stock, re-run the cap at the boundary: one more than available.
(let
    (
        (ref-CPAD:module{CitizenLaunchpadTalosV2} TS02-CPAD)
        (ref-DPAD:module{DemiourgosLaunchpadV2} DEMIPAD)
    )
    (let
        (
            (avail:integer (DEMIPAD-CUSTODIANS.UR_NonceSaleAvailability -1))
            (raised:decimal (ref-DPAD::UR_TotalDollarzRaised "DHOC-98c486052a51"))
        )
        (map print
            [
                (expect "<<TX-ACQ-02b>> the pad is genuinely stocked, so the cap is tested against real supply"
                    true (> avail 0))
                (expect-failure "<<TX-ACQ-02b>> buying one more than the pad holds is rejected"
                    "Insufficient Assets for Acquisiton"
                    (ref-CPAD::CUSTODIANS|C_Acquire KST.EMMA KST.EMMA -1 (+ avail 1) true -1.0))
                ;;And a nonce outside the Bronze/Silver/Golden set is rejected by its own guard,
                ;;not by the supply cap -- distinct message, so the two are not conflated.
                (expect-failure "<<TX-ACQ-02b>> a non-acquisition nonce is rejected by its own named guard"
                    "Invalid Custodian Acquisition Nonce"
                    (ref-CPAD::CUSTODIANS|C_Acquire KST.EMMA KST.EMMA 1 1 true -1.0))
            ]
        )
        ;;RULE 9 DISCHARGE. Both rejections above are expect-failures on a MUTATING op inside a
        ;;COMMITTED transaction, which is exactly the shape that silently corrupted TX-ACQ-02b
        ;;before the rollback fix. They are safe here for a specific, checkable reason: both
        ;;fire inside CUSTODIANS|ACQUIRE, which C_Acquire opens BEFORE any money or asset
        ;;moves, so nothing was written to leave behind. Asserted rather than assumed -- that
        ;;is the whole point of the rule.
        (map print
            [
                (expect "<<TX-ACQ-02b>> the two rejections left the pad's stock untouched"
                    avail (DEMIPAD-CUSTODIANS.UR_NonceSaleAvailability -1))
                (expect "<<TX-ACQ-02b>> ...and the dollar ledger untouched"
                    raised (ref-DPAD::UR_TotalDollarzRaised "DHOC-98c486052a51"))
            ]
        )
        ""
    )
)
(print "")
(print "")
;;==== TX-ACQ-02b · 03 · gas echo ==== =============================================================
(print "--- [TX-ACQ-02b · 03 · gas echo] ---")
(format "<<<<<<<TX-ACQ-02 CUSTODIANS|C_Acquire ==> {} GAS>>>>>>>" [(env-gas)])
(print "")
(print "===^^^===")
(env-sigs [])
(commit-tx)
;;||>>>>>>>>>>>>>>>>>>>>>>>>>
;;|| NEXT                   >
;;||>>>>>>>>>>>>>>>>>>>>>>>>>
(begin-tx "TX-ACQ-03 - SNAKES|C_Acquire: the Shareholders sale")
(namespace "ouronet-ns")
(env-gasmodel "table")(env-gaslimit 100000000)(env-gas 0)
(print "=== TX-ACQ-03 — SNAKES|C_Acquire (E|DH shares) =========================")
;;==== TX-ACQ-03 · 01 · fuel the share sale ==== ===================================================
(print "--- [TX-ACQ-03 · 01 · fuel the share sale] ---")
;; The Custodians twin, on a different asset model. Snakes sells EQUITY SHARES from the
;; E|DH collection at a flat price-per-share, so there is no fragmentation step: ANHD already
;; holds nonce-1 shares (minted by C_MorphEquity in [6.1]_DPDC) and they go straight into the
;; pad.
;;
;; ONE REAL ASYMMETRY BETWEEN THE TWINS, worth stating because it looks like an omission and
;; is not quite one. Custodians guards its nonce explicitly:
;;      CUSTODIANS|ACQUIRE -> (UEV_AcquisitionNonce nonce)  ;; enforces [-3 -2 -1]
;; SNAKES|ACQUIRE has NO nonce guard at all -- only the supply cap. It is still safe, but
;; only implicitly: UR_NonceSaleAvailability returns DPDC's -1 "holds none" sentinel for a
;; nonce the pad never stocked, and (<= amount -1) is false for every positive amount. So an
;; invalid nonce IS rejected -- by the SUPPLY message, not a nonce message. Asserted below,
;; because the two failure modes being indistinguishable is exactly the kind of thing a
;; caller debugging a bad nonce would waste time on.
(env-sigs [{ "key": "PK_AncientHodler", "caps": [] }])
(let
    (
        (ref-DPDC:module{DpdcV2} DPDC)
        (ref-TS02-DPAD:module{TalosStageTwo_DemiPadV2} TS02-DPAD)
        (ref-DPAD:module{DemiourgosLaunchpadV2} DEMIPAD)
        (owner:string KST.ANHD)
        (asset:string "E|DH-98c486052a51")
    )
    (let
        (
            (lpad:string (ref-DPAD::GOV|DEMIPAD|SC_NAME))
            (owner-before:integer (ref-DPDC::UR_AccountNonceSupply KST.ANHD asset true 1))
        )
        (map print
            [
                (expect "<<TX-ACQ-03>> the pad holds no shares before fuelling (-1 sentinel)"
                    -1 (ref-DPDC::UR_AccountNonceSupply lpad asset true 1))
                (expect "<<TX-ACQ-03>> the owner has shares to sell"
                    true (> owner-before 100))
            ]
        )
        (ref-TS02-DPAD::DEMIPAD|C_FuelSemiFungible owner owner asset [1] [100])
        (map print
            [
                (expect "<<TX-ACQ-03>> the pad now holds the shares"
                    100 (ref-DPDC::UR_AccountNonceSupply lpad asset true 1))
                (expect "<<TX-ACQ-03>> ...moved out of the owner, not minted"
                    (- owner-before 100) (ref-DPDC::UR_AccountNonceSupply owner asset true 1))
                (expect "<<TX-ACQ-03>> the sale's availability reader agrees with DPDC"
                    100 (DEMIPAD-SNAKES.UR_NonceSaleAvailability 1))
            ]
        )
        ""
    )
)
(print "")
(print "===^^^===")
(env-sigs [])
(commit-tx)
;;||>>>>>>>>>>>>>>>>>>>>>>>>>
;;|| NEXT                   >
;;||>>>>>>>>>>>>>>>>>>>>>>>>>
(begin-tx "TX-ACQ-03b - SNAKES|C_Acquire: buy two shares")
(namespace "ouronet-ns")
(env-gasmodel "table")(env-gaslimit 100000000)(env-gas 0)
;;==== TX-ACQ-03b · 01 · quote ==== ================================================================
(print "--- [TX-ACQ-03b · 01 · quote] ---")
(let
    (
        (ref-DPAD:module{DemiourgosLaunchpadV2} DEMIPAD)
        (ref-U|CT|DIA:module{DiaStoaPidV2} U|CT)
        (asset:string "E|DH-98c486052a51")
    )
    (let
        (
            (costs:object (DEMIPAD-SNAKES.URC_NonceAmountCosts 1 2))
            (unit:decimal (at "price-per-share-in-dollars" (ref-DPAD::UR_Price asset)))
            (stoa-price:decimal (ref-U|CT|DIA::UR_STOA-PID|Price))
        )
        (map print
            [
                ;;Note the price KEY differs from Custodians' "quintessence-price": each sale
                ;;defines its own price object shape against the same DEMIPAD|Price slot.
                (expect "<<TX-ACQ-03b>> 2 shares cost twice the per-share dollar price"
                    (* unit 2.0) (at "pid" costs))
                (expect "<<TX-ACQ-03b>> the token leg is that at the live STOA price"
                    (/ (at "pid" costs) stoa-price) (at "wstoa" costs))
            ]
        )
        ""
    )
)
;;==== TX-ACQ-03b · 02 · sign the quoted caps and buy ==== =========================================
(print "--- [TX-ACQ-03b · 02 · sign the quoted caps and buy] ---")
;;$20 = 200 wSTOA. Royalty 15% = 30 (env 10, coding 20), remainder 170, non-environment 190.
;;Environment legs 10/20/30/40 of 10.0 = 1.0/2.0/3.0/4.0. Exact grants, as in TX-DEP-01.
(env-sigs
    [ { "key": "PK_AncientHodler", "caps": [] }
    , { "key": "PK_Emma", "caps": [] }
    , { "key": "ecaeae048b6e4b1d4cd9b5ba41041b39e05ac3a7b32f495a12823cb1c5ad0f48", "caps":
        [ (coin.TRANSFER "k:ecaeae048b6e4b1d4cd9b5ba41041b39e05ac3a7b32f495a12823cb1c5ad0f48" "c:ZNfuj3iZI83n7MUSKGuoXoSxFg1cyMxCzB3szUHVvrI" 190.0)
        , (coin.TRANSFER "k:ecaeae048b6e4b1d4cd9b5ba41041b39e05ac3a7b32f495a12823cb1c5ad0f48" "c:iQQFWj6gWtpGEzhM_O5ekW1QtnQQy55R8BRPGhj_0FU" 1.0)
        , (coin.TRANSFER "k:ecaeae048b6e4b1d4cd9b5ba41041b39e05ac3a7b32f495a12823cb1c5ad0f48" "k:0cb30c0121ff919266121a99ff9359871818932211df94dae4137c29bc0e8f7e" 2.0)
        , (coin.TRANSFER "k:ecaeae048b6e4b1d4cd9b5ba41041b39e05ac3a7b32f495a12823cb1c5ad0f48" "k:50d6c59b21e5e6e55baecaa75a1007de37576bde12d8230dc82459cc01b9484b" 3.0)
        , (coin.TRANSFER "k:ecaeae048b6e4b1d4cd9b5ba41041b39e05ac3a7b32f495a12823cb1c5ad0f48" "c:XM-pkmuB5XUQlp87ZYSbfKt8qzmHY6O2EHAzMRVBt3k" 4.0)
        ] }
    ])
(let
    (
        (ref-CPAD:module{CitizenLaunchpadTalosV2} TS02-CPAD)
        (ref-DPDC:module{DpdcV2} DPDC)
        (ref-DPAD:module{DemiourgosLaunchpadV2} DEMIPAD)
        (ref-DALOS:module{OuronetDalosV2} DALOS)
        (ref-coin:module{stoa-ns.fungible-v1} coin)
        (asset:string "E|DH-98c486052a51")
        (buyer:string KST.EMMA)
    )
    (let
        (
            (lpad:string (ref-DPAD::GOV|DEMIPAD|SC_NAME))
            (buyer-stoa:string (ref-DALOS::UR_AccountStoa KST.EMMA))
        )
        (let
            (
                (pad-before:integer (ref-DPDC::UR_AccountNonceSupply lpad asset true 1))
                (stoa-before:decimal (ref-coin::get-balance buyer-stoa))
                (raised-before:decimal (ref-DPAD::UR_TotalDollarzRaised asset))
                (cost-pid:decimal (at "pid" (DEMIPAD-SNAKES.URC_NonceAmountCosts 1 2)))
                (cost-tok:decimal (at "wstoa" (DEMIPAD-SNAKES.URC_NonceAmountCosts 1 2)))
            )
            (let
                (
                    (r (ref-CPAD::SNAKES|C_Acquire buyer buyer 1 2 true -1.0))
                )
                (print (format "<(TS02-CPAD.SNAKES|C_Acquire)> => \"{}\"" [r]))
                (map print
                    [
                        ;;Same wrapper defect as Custodians: the sale's own result is discarded
                        ;;in favour of the refuel's bare true.
                        (expect "<<TX-ACQ-03b>> FINDING: SNAKES|C_Acquire also returns the refuel's bare true"
                            true r)
                        (expect "<<TX-ACQ-03b>> the buyer receives the shares"
                            2 (ref-DPDC::UR_AccountNonceSupply buyer asset true 1))
                        (expect "<<TX-ACQ-03b>> the pad's stock drops by exactly that many"
                            (- pad-before 2) (ref-DPDC::UR_AccountNonceSupply lpad asset true 1))
                        (expect "<<TX-ACQ-03b>> the buyer pays the quoted token cost in native STOA"
                            (- stoa-before cost-tok) (ref-coin::get-balance buyer-stoa))
                        (expect "<<TX-ACQ-03b>> the sale reaches the launchpad's dollar ledger"
                            (+ raised-before cost-pid) (ref-DPAD::UR_TotalDollarzRaised asset))
                    ]
                )
                ""
            )
        )
    )
)
;;==== TX-ACQ-03b · 03 · the missing nonce guard ==== ==============================================
(print "--- [TX-ACQ-03b · 03 · the missing nonce guard] ---")
(let
    (
        (ref-CPAD:module{CitizenLaunchpadTalosV2} TS02-CPAD)
        (ref-DPAD:module{DemiourgosLaunchpadV2} DEMIPAD)
        (asset:string "E|DH-98c486052a51")
    )
    (let
        (
            (avail:integer (DEMIPAD-SNAKES.UR_NonceSaleAvailability 1))
            (raised:decimal (ref-DPAD::UR_TotalDollarzRaised asset))
        )
        (map print
            [
                ;;A nonce the pad never stocked reports the -1 sentinel...
                (expect "<<TX-ACQ-03b>> an unstocked nonce reports the 'holds none' sentinel"
                    -1 (DEMIPAD-SNAKES.UR_NonceSaleAvailability 77))
                ;;...so the supply cap rejects it. Safe, but the message is about SUPPLY, not
                ;;about the nonce -- the Custodians twin would say "Invalid ... Acquisition
                ;;Nonce" here. Pinning both makes the asymmetry visible instead of folklore.
                (expect-failure "<<TX-ACQ-03b>> FINDING: a bad nonce is rejected by the SUPPLY cap, since Snakes has no nonce guard"
                    "Insufficient Assets for Acquisiton"
                    (ref-CPAD::SNAKES|C_Acquire KST.EMMA KST.EMMA 77 1 true -1.0))
                (expect-failure "<<TX-ACQ-03b>> over-buying real stock gives the SAME message, so the two are indistinguishable"
                    "Insufficient Assets for Acquisiton"
                    (ref-CPAD::SNAKES|C_Acquire KST.EMMA KST.EMMA 1 (+ avail 1) true -1.0))
                ;;RULE 9 discharge: both fire inside SNAKES|ACQUIRE before any write.
                (expect "<<TX-ACQ-03b>> the two rejections left the pad's stock untouched"
                    avail (DEMIPAD-SNAKES.UR_NonceSaleAvailability 1))
                (expect "<<TX-ACQ-03b>> ...and the dollar ledger untouched"
                    raised (ref-DPAD::UR_TotalDollarzRaised asset))
            ]
        )
        ""
    )
)
(print "")
(print "")
;;==== TX-ACQ-03b · 04 · gas echo ==== =============================================================
(print "--- [TX-ACQ-03b · 04 · gas echo] ---")
(format "<<<<<<<TX-ACQ-03b SNAKES|C_Acquire ==> {} GAS>>>>>>>" [(env-gas)])
(print "")
(print "===^^^===")
(env-sigs [])
(commit-tx)
