;;==== TX-01 - Initialise Shareholders · 02 · let / invocation ==== ===============================
(print "--- [TX-01 - Initialise Shareholders · 02 · let / invocation] ---")
(let
    (
        (ref-TS02-DPAD:module{TalosStageTwo_DemiPadV1} TS02-DPAD)
        (patron:string KST.ANHD)
        (shareholders-id "E|DH-98c486052a51")
        (s-key:string DEMIPAD-SNAKES.SNAKES|INFO)
    )
    [
        ;;REPL-VARIANT:
        (acquire-module-admin ouronet-ns.DEMIPAD-SNAKES)
        ;;MAIN-NET VARIANT
        ;;(acquire-module-admin n_7d40ccda457e374d8eb07b658fd38c282c545038.DEMIPAD-SNAKES)
        (insert  DEMIPAD-SNAKES.SNAKES|T|Properties s-key
            {"asset-id"     : shareholders-id}
        )
        ;;Register Shareholders Collection To Launchpad
        (ref-TS02-DPAD::A_RegisterAssetToLaunchpad patron shareholders-id [false true])
        (ref-TS02-DPAD::A_DefinePrice shareholders-id 
            {"price-per-share-in-dollars"   : 10.0}
        )
        (ref-TS02-DPAD::A_ToggleRetrieval shareholders-id true)
        (ref-TS02-DPAD::A_ToggleOpenForBusiness shareholders-id true)
        ;;Fuel Assets for Sale must be done separately
    ]
)


