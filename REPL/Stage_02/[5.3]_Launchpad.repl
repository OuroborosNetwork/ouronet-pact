;;==== TX-01 - Initialise Movie Booster aka Spark · 01 · env-sigs (caps) ==== =====================
(print "--- [TX-01 - Initialise Movie Booster aka Spark · 01 · env-sigs (caps)] ---")
(env-sigs
    [
        { "key": "PK_AncientHodler", "caps": [] }
        { "key": "PK_LPAD", "caps": [] }
    ]
)
;;==== TX-01 - Initialise Movie Booster aka Spark · 02 · let / invocation ==== ====================
(print "--- [TX-01 - Initialise Movie Booster aka Spark · 02 · let / invocation] ---")
(let
    (
        (ref-DALOS:module{OuronetDalosV1} DALOS)
        (split-kda:[decimal]
            (ref-DALOS::URC_SplitKDAPrices
                KST.ANHD
                (* (ref-DALOS::UR_UsagePrice "dptf") 2.0)
            )
        )
    )
    (env-sigs
        [
            { "key": "PK_AncientHodler", "caps": [] }
        ]
    )
    (let
        (
            (ref-VST:module{VestingV1} VST)
            (ref-DPTF:module{DemiourgosPactTrueFungibleV1} DPTF)
            (ref-TS01-C1:module{TalosStageOne_ClientOneV1} TS01-C1)
            (ref-TS01-C2:module{TalosStageOne_ClientTwoV1} TS01-C2)
            (ref-TS02-DPAD:module{TalosStageTwo_DemiPadV1} TS02-DPAD)
            (ref-DPAD:module{DemiourgosLaunchpadV1} DEMIPAD)
            (ref-SPARK:module{SparksV1} DEMIPAD-SPARK)
            (patron:string KST.ANHD)
            
            (s-key:string DEMIPAD-SPARK.SPARK|INFO)
            (lpad-sc:string (ref-DPAD::GOV|DEMIPAD|SC_NAME))
            (SparkID:string "SPARK-98c486052a51")
            (FrozenSparkID:string "F|SPARK-98c486052a51")
            (vst-sc:string (ref-VST::GOV|VST|SC_NAME))
            (tr:bool (ref-DPTF::UR_AccountRoleTransfer FrozenSparkID vst-sc))
        )
        [
            ;;Check Role
            (format "Frozen Token Role on VST|SC_NAME after issue is {}" [tr])
            ;;Permissions
            (ref-TS01-C1::DPTF|C_Mint patron SparkID lpad-sc 35000.0 true)
            (ref-TS01-C1::DPTF|C_ToggleMintRole patron SparkID lpad-sc true)
            (ref-TS01-C1::DPTF|C_ToggleBurnRole patron SparkID lpad-sc true)
            ;;REPL-VARIANT:
            (acquire-module-admin ouronet-ns.DEMIPAD-SPARK)
            ;;MAIN-NET VARIANT
            ;;(acquire-module-admin n_7d40ccda457e374d8eb07b658fd38c282c545038.SPARK)
            (insert DEMIPAD-SPARK.SPARK|T|Properties s-key
                {"spark-id"            : SparkID}
            )
            ;;Register Spark To Launchpad
            (ref-TS02-DPAD::A_RegisterAssetToLaunchpad patron SparkID [true true])
            (ref-TS02-DPAD::A_DefinePrice SparkID 
                {"pid"      : 1.01
                ,"boost"    : 400.0
                ,"id"       : SparkID}
            )
            (ref-TS02-DPAD::A_ToggleRetrieval SparkID true)
            (ref-TS02-DPAD::A_ToggleOpenForBusiness SparkID true)
        ]
    )
)

