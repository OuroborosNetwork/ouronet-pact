(begin-tx "TX-01 - Initialise Movie Booster aka Spark")
(namespace "ouronet-ns")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
;;==== TX-01 - Initialise Movie Booster aka Spark · 01 · env-sigs (caps) ==== =====================
(print "--- [TX-01 - Initialise Movie Booster aka Spark · 01 · env-sigs (caps)] ---")
(env-sigs
    [
        { "key": "PK_AncientHodler", "caps": [] }
        { "key": "PK_LPAD", "caps": [] }
    ]
)
;;==== TX-01 - Initialise Movie Booster aka Spark · 02 · let / invocation ==== ====================
(print "--- [TX-01 - Initialise Movie Booster aka Spark · 02 · let / invocation] ---")
(let
    (
        (ref-DALOS:module{OuronetDalosV1} DALOS)
        (split-kda:[decimal]
            (ref-DALOS::URC_SplitKDAPrices
                KST.ANHD
                (ref-DALOS::UR_UsagePrice "dptf")
            )
        )
    )
    (env-sigs
        [
            { "key": "PK_AncientHodler", "caps": [] }
        ]
    )
    (let
        (
            (ref-P|DPAD:module{OuronetPolicyV1} DEMIPAD)
            (ref-P|KPAY:module{OuronetPolicyV1} DEMIPAD-STOICPAY)
            (ref-P|TS02-DPAD:module{OuronetPolicyV1} TS02-DPAD)
            ;;
            (ref-U|G:module{OuronetGuardsV1} U|G)
            (ref-TS01-C1:module{TalosStageOne_ClientOneV1} TS01-C1)
            (ref-DPAD:module{DemiourgosLaunchpadV1} DEMIPAD)
            (ref-TS02-DPAD:module{TalosStageTwo_DemiPadV1} TS02-DPAD)
            ;;
            ;;
            (mg:guard (create-capability-guard (TS02-DPAD.P|TALOS-SUMMONER)))
            ;;
            (patron:string KST.ANHD)
            (KpayID:string "KPAY-98c486052a51")
            (lpad-sc:string (ref-DPAD::GOV|DEMIPAD|SC_NAME))
            (s-key:string DEMIPAD-STOICPAY.KPAY|INFO)
        )
        [
            ;;Backward IMC
            (ref-P|KPAY::P|A_Define)
            ;;Forward IMC
            ;(ref-P|KPAY::P|A_AddIMP mg)    ;;Needed on Mainnet
            ;;Governor
            (ref-TS01-C1::DALOS|C_RotateGovernor
                KST.ANHD
                lpad-sc
                (ref-U|G::UEV_GuardOfAny
                    [
                        (create-capability-guard (DEMIPAD.DEMIPAD|GOV))
                        (ref-P|DPAD::P|UR "SPARK|RemoteGov")
                        (ref-P|DPAD::P|UR "SNAKES|RemoteGov")
                        (ref-P|DPAD::P|UR "CUSTODIANS|RemoteGov")
                        (ref-P|DPAD::P|UR "KPAY|RemoteGov")
                    ]
                )
            )
            ;;
            ;;
            ;;Permissions
            (ref-TS01-C1::DPTF|C_Mint patron KpayID lpad-sc 250000000.0 true)
            (ref-TS01-C1::DPTF|C_ToggleBurnRole patron KpayID lpad-sc true)
            ;;REPL-VARIANT:
            (acquire-module-admin ouronet-ns.DEMIPAD-STOICPAY)
            ;;MAIN-NET VARIANT
            ;;(acquire-module-admin n_7d40ccda457e374d8eb07b658fd38c282c545038.DEMIPAD-STOICPAY)
            (insert DEMIPAD-STOICPAY.KPAY|T|Properties s-key
                {"asset-id"            : KpayID}
            )
            ;;Register KPAY To Launchpad
            (ref-TS02-DPAD::A_RegisterAssetToLaunchpad patron KpayID [true true])
            ;;Defines the starting point, which is the base for the price and ending period.
            (ref-TS02-DPAD::A_DefinePrice KpayID
                {"starting-time" : (at "block-time" (chain-data))}
                ;{"starting-time": (time "2030-10-25T18:00:00Z")}
            )
            (ref-TS02-DPAD::A_ToggleOpenForBusiness KpayID true)
        ]
    )
)


(print "")
(print "")
