(begin-tx "TX-3H4H - Custodians #3H (supply cap enforced) + #4H (availability reader resolves)")
(namespace "ouronet-ns")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(print "=== TX-3H/4H — Custodians acquire now guarded: #3H supply cap enforced + #4H reader fixed ===")
(env-sigs [{ "key": "PK_AncientHodler", "caps": [] } { "key": "PK_Emma", "caps": [] }])
(let
    (
        (buyer:string KST.EMMA)
    )
    (map print
        [
            ;; #4H: UR_NonceSaleAvailability now RESOLVES. Pre-fix it read the non-existent
            ;;      GOV|LAUNCHPAD|SC_NAME → runtime "Unbound free variable". -1 = the pad holds none of
            ;;      nonce -1 yet (collection not fueled), which is a valid resolved value (not a crash).
            (format "<<TX-4H>> UR_NonceSaleAvailability(-1) => {}" [(DEMIPAD-CUSTODIANS.UR_NonceSaleAvailability -1)])
            (expect "#4H: UR_NonceSaleAvailability resolves (>= -1, no unbound crash)"
                true (>= (DEMIPAD-CUSTODIANS.UR_NonceSaleAvailability -1) -1))
            ;; #3H: C_Acquire now OPENS CUSTODIANS|ACQUIRE, so the per-nonce supply cap fires — an
            ;;      over-supply acquire is rejected. Pre-fix the cap was never opened, so this enforce
            ;;      was skipped entirely and the acquire proceeded past it (oversell / unguarded).
            (expect-failure "#3H: over-supply Custodian acquire REJECTED by the CUSTODIANS|ACQUIRE supply cap"
                "Insufficient Assets for Acquisiton"
                (DEMIPAD-CUSTODIANS.C_Acquire buyer buyer -1 999999999 false -1.0))
            ""
        ]
    )
)
(env-sigs [])
(commit-tx)
;;||>>>>>>>>>>>>>>>>>>>>>>>>>
;;|| NEXT                   >
;;||>>>>>>>>>>>>>>>>>>>>>>>>>
(begin-tx "TX-7M - #7M collectable transmit routes to the cap matching the asset kind (SF vs NF)")
(namespace "ouronet-ns")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(print "=== TX-7M — #7M: NF/SF transmit now opens the matching fungibility cap (was hardcoded SEMI) ===")
(env-sigs [{ "key": "PK_AncientHodler", "caps": [] }])
;; The fix makes X_TransmitCollectables open the NON cap for son=false (NF) and the SEMI cap for son=true
;; (SF). The cap that discriminates is UEV_AssetFungibility: SEMI enforces [false true], NON enforces
;; [false false]. Proven on the registered SF custodians (DHOC, [false true]): the SEMI check accepts it,
;; the NON check rejects it — so post-fix an SF routed through the NF entry (son=false → NON cap) is
;; blocked (the pre-fix type-mismatched transfer), while the SF path (son=true → SEMI cap) still works.
;; The NF direction is the exact mirror: a [false false] asset passes the NON cap and fails the SEMI cap,
;; which is why the pre-fix hardcoded-SEMI path made real NF assets un-fuelable (dead feature).
(let
    (
        (sf-id:string "DHOC-98c486052a51")   ;; custodians, registered Semi-Fungible [false true]
    )
    (map print
        [
            (expect "#7M: SF asset passes the Semi-Fungible cap check [false true] (son=true path)"
                true (DEMIPAD.UEV_AssetFungibility sf-id [false true]))
            (expect-failure "#7M: SF asset REJECTED by the Non-Fungible cap check [false false] (son=false path now blocks the type mismatch)"
                (DEMIPAD.UEV_AssetFungibility sf-id [false false]))
            ""
        ]
    )
)
(env-sigs [])
(commit-tx)






;;||>>>>>>>>>>>>>>>>>>>>>>>>>
;;|| NEXT                   >
;;||>>>>>>>>>>>>>>>>>>>>>>>>>
(begin-tx "TX-8M - #8M direct-injection is hard-blocked (no phantom funds) even with the admin flag ON")
(namespace "ouronet-ns")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(print "=== TX-8M — #8M: direct-injection hard-blocked at the deposit cap regardless of UR_DirectInjection ===")
(env-sigs [{ "key": "PK_AncientHodler", "caps": [] }])
;; #8M: direct-injection was a flag-gated, unbuilt feature. The OLD deposit cap only rejected it
;;      while UR_DirectInjection was OFF; flipping the admin flag ON let direct-injection=true pass
;;      the cap, and C_Deposit then credited the seller ledger (funds-*) via XI_DepositForAsset
;;      WITHOUT any tokens entering custody (ico3 = EOC) — phantom funds, later drainable through
;;      C_Withdraw against OTHER sellers' proceeds in the shared launchpad account.
;;      FIX: the block is now the unprotected UEV_DirectInjection, composed by DEMIPAD|C>DEPOSIT,
;;      rejecting direct-injection UNCONDITIONALLY (true stub — no admin flag can enable it), and the
;;      ledger credit (XI_DepositForAsset) is additionally guarded on (not direct-injection).
;;      PROOF (mirrors #7M's UEV_AssetFungibility style — the C_ entry is P|UEV_IMC-gated so we assert
;;      the composed check directly): turn the admin flag ON, then show UEV_DirectInjection STILL
;;      rejects a direct-injection request, and passes a normal (non-direct) deposit.
(let
    (
        (pkey:string DEMIPAD.PP)
    )
    [
        ;;REPL-VARIANT: flip the admin direct-injection flag ON to prove the hard-block ignores it
        (acquire-module-admin ouronet-ns.DEMIPAD)
        (update DEMIPAD.DEMIPAD|T|Properties pkey {"direct-injection" : true})
        (map print
            [
                (expect "#8M · precondition: admin direct-injection flag is turned ON"
                    true (DEMIPAD.UR_DirectInjection))
                ;; Post-fix the check is unconditional: direct-injection=true is rejected even with the
                ;; admin flag ON — so no deposit can ever credit seller funds without tokens in custody.
                (expect-failure
                    "#8M: UEV_DirectInjection REJECTS a direct-injection request even with the flag ON (hard-block, no phantom funds)"
                    "Direct Injection is not yet available"
                    (DEMIPAD.UEV_DirectInjection true))
                ;; Control: a normal (non-direct) deposit request passes the check untouched.
                (expect "#8M · control: a non-direct deposit request passes UEV_DirectInjection"
                    true (DEMIPAD.UEV_DirectInjection false))
                ""
            ]
        )
        ;;restore the flag to its initialised value
        (update DEMIPAD.DEMIPAD|T|Properties pkey {"direct-injection" : false})
    ]
)
(env-sigs [])
(commit-tx)
;;||>>>>>>>>>>>>>>>>>>>>>>>>>
;;|| NEXT                   >
;;||>>>>>>>>>>>>>>>>>>>>>>>>>
(begin-tx "TX-9M - #9M UC_NonceQuintessence is pure (no hidden enforce); nonce validation stays on the cap")
(namespace "ouronet-ns")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(print "=== TX-9M — #9M: UC_NonceQuintessence made pure; CUSTODIANS|ACQUIRE still enforces the nonce ===")
(env-sigs [{ "key": "PK_AncientHodler", "caps": [] } { "key": "PK_Emma", "caps": [] }])
;; #9M: UC_NonceQuintessence was prefixed UC_ (pure compute, no enforce) but called
;;      UEV_ConditionalAcquisitionNonce (an enforce) through a validation:bool arg — a contract violation
;;      (a "pure" call could abort a tx). FIX: made it a pure nonce->quintessence mapping (no arg, no
;;      enforce). Nonce validity was ALREADY enforced on the mutation path by the CUSTODIANS|ACQUIRE cap
;;      (UEV_AcquisitionNonce), so no enforcement is lost. The now-dead UEV_ConditionalAcquisitionNonce
;;      was removed.
(let
    (
        (buyer:string KST.EMMA)
    )
    (map print
        [
            ;; (a) pure mapping for the three fragment nonces
            (expect "#9M: UC_NonceQuintessence(-1 Bronze) = 1"   1   (DEMIPAD-CUSTODIANS.UC_NonceQuintessence -1))
            (expect "#9M: UC_NonceQuintessence(-2 Silver) = 10"  10  (DEMIPAD-CUSTODIANS.UC_NonceQuintessence -2))
            (expect "#9M: UC_NonceQuintessence(-3 Golden) = 100" 100 (DEMIPAD-CUSTODIANS.UC_NonceQuintessence -3))
            ;; (b) purity: an out-of-range nonce returns a value and does NOT throw (pre-fix, validation=true
            ;;     would enforce/abort here — a pure function must never do that)
            (expect "#9M: UC_NonceQuintessence is pure — out-of-range nonce returns a value, no enforce/abort"
                100 (DEMIPAD-CUSTODIANS.UC_NonceQuintessence 5))
            ;; (c) validation preserved where it matters: the acquire cap still rejects an invalid nonce
            (expect-failure "#9M: C_Acquire still validates the nonce via CUSTODIANS|ACQUIRE (invalid nonce rejected)"
                "Invalid Custodian Acquisition Nonce"
                (DEMIPAD-CUSTODIANS.C_Acquire buyer buyer 5 1 false -1.0))
            ""
        ]
    )
)
(env-sigs [])
(commit-tx)
;;||>>>>>>>>>>>>>>>>>>>>>>>>>
;;|| NEXT                   >
;;||>>>>>>>>>>>>>>>>>>>>>>>>>
(begin-tx "TX-10M - #10M UR_NonceSaleAvailability is a pure read; nonce enforce relocated to the cap")
(namespace "ouronet-ns")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(print "=== TX-10M — #10M: UR_NonceSaleAvailability made a pure read; CUSTODIANS|ACQUIRE enforces the nonce ===")
(env-sigs [{ "key": "PK_AncientHodler", "caps": [] } { "key": "PK_Emma", "caps": [] }])
;; #10M: Custodians UR_NonceSaleAvailability was a UR_ (table-read prefix, must not enforce) but ran
;;       (UEV_AcquisitionNonce nonce) before its DPDC supply read — where the Snakes twin does not. The
;;       enforce was RELOCATED (not removed) into the CUSTODIANS|ACQUIRE cap, so the UR is now a pure read
;;       and nonce validation + the exact "Invalid Custodian Acquisition Nonce" error stay on the mutation
;;       path (identical behavior). Interlocks with #9M: this is the same enforce the cap relies on.
(let
    (
        (buyer:string KST.EMMA)
    )
    (map print
        [
            ;; (a) UR is now a pure read: an out-of-range nonce resolves to the DPDC "holds none" sentinel
            ;;     (-1) with NO enforce/abort (pre-fix this UR_ threw "Invalid Custodian Acquisition Nonce"
            ;;     on nonce 5 — a UR_ must never abort)
            (expect "#10M: UR_NonceSaleAvailability is a pure read — out-of-range nonce returns supply sentinel (no abort)"
                -1 (DEMIPAD-CUSTODIANS.UR_NonceSaleAvailability 5))
            ;; (b) a valid fragment nonce also reads as a pure read (>= -1; launchpad holds none until fueled)
            (expect "#10M: UR_NonceSaleAvailability(-1) resolves as a pure read"
                true (>= (DEMIPAD-CUSTODIANS.UR_NonceSaleAvailability -1) -1))
            ;; (c) validation preserved: the cap (now holding UEV_AcquisitionNonce) still rejects an invalid nonce
            (expect-failure "#10M: C_Acquire still validates the nonce via CUSTODIANS|ACQUIRE (enforce relocated to cap)"
                "Invalid Custodian Acquisition Nonce"
                (DEMIPAD-CUSTODIANS.C_Acquire buyer buyer 5 1 false -1.0))
            ""
        ]
    )
)
(env-sigs [])
(commit-tx)
