(begin-tx "TX-01 - Initialise Launchpad Properties Table")
(namespace "ouronet-ns")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
;;==== TX-01 - Initialise Launchpad Properties Table · 01 · env-sigs (caps) ==== ==================
(print "--- [TX-01 - Initialise Launchpad Properties Table · 01 · env-sigs (caps)] ---")
(env-sigs
    [
        { "key": "PK_AncientHodler", "caps": [] }
        { "key": "PK_LPAD", "caps": [] }
    ]
)





;;==== TX-01 - Initialise Launchpad Properties Table · 02 · let / invocation ==== =================
(print "--- [TX-01 - Initialise Launchpad Properties Table · 02 · let / invocation] ---")
(let
    (
        (ref-U|G:module{OuronetGuardsV1} U|G)
        (ref-TFT:module{TrueFungibleTransferV1} TFT)
        (ref-TS01-C1:module{TalosStageOne_ClientOneV1} TS01-C1)
        (ref-P|DPAD:module{OuronetPolicyV1} DEMIPAD)
        (ref-P|SPARK:module{OuronetPolicyV1} DEMIPAD-SPARK)
        (ref-P|SNAKES:module{OuronetPolicyV1} DEMIPAD-SNAKES)
        (ref-P|CUSTODIANS:module{OuronetPolicyV1} DEMIPAD-CUSTODIANS)
        (ref-P|TS02-DPAD:module{OuronetPolicyV1} TS02-DPAD)
        (ref-DPAD:module{DemiourgosLaunchpadV1} DEMIPAD)
        (lpad-sc:string (ref-DPAD::GOV|DEMIPAD|SC_NAME))
        (pkey:string DEMIPAD.PP)
    )
    [
        ;;REPL-VARIANT:
        (acquire-module-admin ouronet-ns.DEMIPAD)
        ;;MAIN-NET VARIANT
        ;;(acquire-module-admin n_7d40ccda457e374d8eb07b658fd38c282c545038.DEMIPAD)
        (insert DEMIPAD.DEMIPAD|T|Properties pkey
            {"direct-injection" : false
            ,"resident-wkda"    : 0.0
            ,"resident-lkda"    : 0.0
            ,"resident-ouro"    : 0.0}
        )
        ;;IMC
        (ref-P|DPAD::P|A_Define)
        (ref-P|SPARK::P|A_Define)
        (ref-P|SNAKES::P|A_Define)
        (ref-P|CUSTODIANS::P|A_Define)
        (ref-P|TS02-DPAD::P|A_Define)
        ;;
        ;;Governor
        (ref-TS01-C1::DALOS|C_RotateGovernor
            KST.ANHD
            lpad-sc
            (ref-U|G::UEV_GuardOfAny
                [
                    (create-capability-guard (DEMIPAD.DEMIPAD|GOV))
                    (ref-P|DPAD::P|UR "SPARK|RemoteGov")
                    (ref-P|DPAD::P|UR "SNAKES|RemoteGov")
                    (ref-P|DPAD::P|UR "CUSTODIANS|RemoteGov")
                ]
            )
        )
    ]
)

(print "")
(print "")
;;==== TX-01 - Initialise Launchpad Properties Table · 03 · gas echo ==== =========================
(print "--- [TX-01 - Initialise Launchpad Properties Table · 03 · gas echo] ---")
(format "<<<<<<<Init Launchpad (1-75) Costs {} GAS>>>>>>>" [(env-gas)])
(print "")
(print "")
(print "===^^^===")
(env-sigs [])
(commit-tx)
