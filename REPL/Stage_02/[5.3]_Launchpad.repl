(print "--- [TX-01 - Initialise Movie Booster aka Spark · 03 · gas echo] ---")
(format "<<<<<<<Init Spark Costs {} GAS>>>>>>>" [(env-gas)])
(print "")
(print "")
(print "===^^^===")
(env-sigs [])
(commit-tx)