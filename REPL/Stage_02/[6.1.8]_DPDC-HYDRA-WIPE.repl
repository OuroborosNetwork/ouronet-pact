(begin-tx "TX-HW-005 - Unfreeze mid-campaign: slice 1 REVERTS, refreeze, slice 1 lands")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(namespace "ouronet-ns")
;;==== TX-HW-005 · 01 · env-sigs (caps) ====
(print "--- [TX-HW-005 · 01 · env-sigs] ---")
(env-sigs [ { "key": "PK_AncientHodler", "caps": [] } ])
;;==== TX-HW-005 · 02 · freeze negative + slice 1 ====
(print "--- [TX-HW-005 · 02 · freeze negative + slice 1] ---")
(let
    (
        (ref-DPDC-MNG:module{DpdcManagementV2} DPDC-MNG)
        (ref-TS02-C2:module{TalosStageTwo_ClientTwoV2} TS02-C2)
        (id:string "CNF-98c486052a51")
        (patron:string KST.ANHD)
        (emma:string KST.EMMA)
    )
    (ref-TS02-C2::DPNF|C_ToggleFreezeAccount patron id emma false)
