(begin-tx "TX-HW-004 - Replay slice 0 REVERTS (idempotency: live table = completion ledger)")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(namespace "ouronet-ns")
;;==== TX-HW-004 · 01 · env-sigs (caps) ====
(print "--- [TX-HW-004 · 01 · env-sigs] ---")
(env-sigs [ { "key": "PK_AncientHodler", "caps": [] } ])
;;==== TX-HW-004 · 02 · replay negative ====
(print "--- [TX-HW-004 · 02 · replay negative] ---")
(let
    (
        (ref-DPDC-MNG:module{DpdcManagementV2} DPDC-MNG)
        (ref-TS02-C2:module{TalosStageTwo_ClientTwoV2} TS02-C2)
        (id:string "CNF-98c486052a51")
        (patron:string KST.ANHD)
        (emma:string KST.EMMA)
    )
    (map print
        [
            (expect-failure "<<TX-HW-004>> replayed slice 0 REVERTS (wiped nonces fail 0 < amount)"
                (ref-TS02-C2::DPNF|Cp_WipeSlice patron emma id
                    (ref-DPDC-MNG::UDC_RemovableNonces [9 10 11 12] [1 1 1 1])))
            (expect "<<TX-HW-004>> nothing changed: still 8 nonces"
                8 (length (at "r-nonces" (ref-DPDC-MNG::URHC_WipePure emma id false))))
            ""
        ]
    )
)
(print "===^^^===")
(commit-tx)
;;||>>>>>>>>>>>>>>>>>>>>>>>>>
;;|| NEXT                   >
;;||>>>>>>>>>>>>>>>>>>>>>>>>>
