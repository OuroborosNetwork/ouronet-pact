;;================================================================================
;; SFT (son=true) Hydra wipe — closes the coverage gap left by [6.1]_DPDC.repl TX 005b,
;; whose SFT wipe block is entirely commented out (SFT multi-nonce wipes had ZERO live
;; coverage). Self-contained: creates its OWN fresh nonces on the DHCD SFT collection, so it
;; depends on no prior suite's balances and leaves earlier state untouched.
(begin-tx "TX-HW-007 - SFT Hydra wipe: fresh nonces, 2 slices, replay reverts, terminal empty")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(namespace "ouronet-ns")
;;==== TX-HW-007 · 01 · env-sigs (caps) ====
(print "--- [TX-HW-007 · 01 · env-sigs] ---")
(env-sigs [ { "key": "PK_AncientHodler", "caps": [] } ])
;;==== TX-HW-007 · 02 · create 8 SFT nonces / fund LUMY / freeze ====
(print "--- [TX-HW-007 · 02 · create 8 SFT nonces / fund LUMY / freeze] ---")
(let
    (
        (ref-DPDC:module{DpdcV2} DPDC)
        (ref-DPDC-UDC:module{DpdcUdcV2} DPDC-UDC)
        (ref-DPDC-MNG:module{DpdcManagementV2} DPDC-MNG)
        (ref-TS02-C1:module{TalosStageTwo_ClientOneV2} TS02-C1)
        (id:string "DHCD-98c486052a51")
        (patron:string KST.ANHD)
        (lumy:string KST.LUMY)
    )
    (let*
        (
            (type:object{DpdcUdcV2.URI|Type} (ref-DPDC-UDC::UDC_URI|Type true false false false false false false))
            (nd:object{DpdcUdcV2.DPDC|NonceData}
                (ref-DPDC-UDC::UDC_NonceData
                    0.0 0.0 "S" "S" (ref-DPDC-UDC::UDC_NoMetaData) type
                    (ref-DPDC-UDC::UDC_ZeroURI|Data) (ref-DPDC-UDC::UDC_ZeroURI|Data) (ref-DPDC-UDC::UDC_ZeroURI|Data)
                )
            )
            ;;8 FRESH nonces of 100 units each, appended after whatever DHCD already holds
            (before:integer (ref-DPDC::UR_NoncesUsed id true))
            (fresh:[integer] (map (lambda (i:integer) (+ before i)) (enumerate 1 8)))
        )
        (ref-TS02-C1::DPSF|C_Create patron id (make-list 8 100) (make-list 8 nd))
        ;;LUMY starts UNfrozen on DHCD (no prior suite freezes it here), so fund then freeze —
        ;;a defensive unfreeze would abort, since unfreezing enforces the account IS frozen.
        (ref-TS02-C1::DPSF|C_BulkTransfer patron id
            [fresh] [(make-list 8 100)] patron [lumy] false)
        (ref-TS02-C1::DPSF|C_ToggleFreezeAccount patron id lumy true)
        (map print
            [
                (expect "<<TX-HW-007>> LUMY holds 8 wipeable SFT nonces"
                    8 (length (at "r-nonces" (ref-DPDC-MNG::URHC_WipePure lumy id true))))
                ""
            ]
        )
        ;;==== TX-HW-007 · 03 · plan 2 slices, fire both, replay negative, terminal ====
        (print "--- [TX-HW-007 · 03 · plan 2 slices / fire / replay / terminal] ---")
        (let*
            (
                (plan:object{DpdcManagementV2.DPDC-MNG|WipeSlicePlan}
                    (ref-DPDC-MNG::URHC_BuildWipeSlicePlan lumy id true 2))
                (sl:[object{DpdcManagementV2.RemovableNonces}] (at "slices" plan))
                (s0:object{DpdcManagementV2.RemovableNonces} (at 0 sl))
                (s1:object{DpdcManagementV2.RemovableNonces} (at 1 sl))
            )
            (ref-TS02-C1::DPSF|Cp_WipeSlice patron lumy id s0)
            (map print
                [
                    (expect "<<TX-HW-007>> plan: 2 slices of 4 over 8 SFT nonces"
                        [4 4] (map (lambda (x:object{DpdcManagementV2.RemovableNonces}) (length (at "r-nonces" x))) sl))
                    (expect "<<TX-HW-007>> after slice 0: 4 SFT nonces remain"
                        4 (length (at "r-nonces" (ref-DPDC-MNG::URHC_WipePure lumy id true))))
                    (expect-failure "<<TX-HW-007>> replayed SFT slice 0 REVERTS (live table = completion ledger)"
                        (ref-TS02-C1::DPSF|Cp_WipeSlice patron lumy id s0))
                    ""
                ]
            )
            (ref-TS02-C1::DPSF|Cp_WipeSlice patron lumy id s1)
            (map print
                [
                    (expect "<<TX-HW-007>> terminal: LUMY has NO wipeable SFT nonces left"
                        0 (length (at "r-nonces" (ref-DPDC-MNG::URHC_WipePure lumy id true))))
                    ""
                ]
            )
        )
    )
    ;;RESTORE STATE: this tx froze LUMY to run the campaign; later suites (e.g. [6.1]_DPDC
    ;;TX 007's DPSF|C_TransferNonce) expect it UNfrozen. A test must leave the world as it
    ;;found it — the wipe is done, so unfreeze.
    (ref-TS02-C1::DPSF|C_ToggleFreezeAccount patron id lumy false)
    (print "<<TX-HW-007>> SFT multi-nonce Hydra wipe OK (closes the [6.1]_DPDC TX 005b gap)")
)
(print "===^^^===")
(env-sigs [])
(commit-tx)
(print "")
(print "=== END FILE [6.1.8]_DPDC-HYDRA-WIPE.repl (DPNF + DPSF Hydra wipe campaigns) ===")
