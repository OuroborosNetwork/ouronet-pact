;;   Intra-tx:   ;;==== <TX label> · mm · <slug> ====  + next-line (print "--- [<label> · mm · …] ---"); mm = 01.. within each (begin-tx …) (see OuronetInformational/ARCHITECTURE/REPL_AND_TESTS.md).
;;   format "{}": Talos / module echoes and (env-gas) — document additional prefixes in this file's (print …) lines as needed.
;;
(print "")
(print "================================================================")
(print "FILE  REPL/Stage_02/[3]_Talos.repl")
(print "================================================================")
(print "Legend (terminal observability): see ;; preface; echoes use <(…)> where helpful.")
(print "Source: ;;|| NEXT > between txs; ;;==== … · mm · … ==== + banner before each begin-tx.")
(print "")
;;
;;
;;================================================================================
;;                                                                              ;;
;;                      [3 TXs]                                                 ;;
;;              1.1     NONE ==> [REPL] Pre-Loads execs;                        ;;
;;              1.2     NONE ==> LIVE Pre-Loads execs [only comment]            ;;
;;              2       TS02-C1, TS01-C2                                        ;;
;;              3       NONE ==> [REPL] Post-Loads execs                        ;;
;;                                                                              ;;
;;                                                                              ;;
;;================================================================================
;;
;;
(print "")
(begin-tx "TX-01 [2.1] - TS02-C1 Module")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(namespace "ouronet-ns")
;;==== TX-01 [2.1] - TS02-C1 Module · 01 · env-sigs (caps) ==== ===================================
(print "--- [TX-01 [2.1] - TS02-C1 Module · 01 · env-sigs (caps)] ---")
(env-sigs
  [{"key": "1a4e15d3c51e0b73e92644600487ba8eaae312e1a178b91801d54e13c1b350a5", "caps": []}])
;;==== TX-01 [2.1] - TS02-C1 Module · 02 · load module ==== =======================================
(print "--- [TX-01 [2.1] - TS02-C1 Module · 02 · load module] ---")
(load "../../1_SOVEREIGN/STAGE_02/3_Talos/01_TS02-C1.pact")
;;==== TX-01 [2.1] - TS02-C1 Module · 03 · gas echo ==== ==========================================
(print "--- [TX-01 [2.1] - TS02-C1 Module · 03 · gas echo] ---")
(format "<<<<<<<TS02-C1 Costs {} GAS>>>>>>>" [(env-gas)])
(print "")
(commit-tx)
