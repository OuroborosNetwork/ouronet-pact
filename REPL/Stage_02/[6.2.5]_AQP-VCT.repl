                    (coin.TRANSFER "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263" "c:iQQFWj6gWtpGEzhM_O5ekW1QtnQQy55R8BRPGhj_0FU" 50.0)
                    (coin.TRANSFER "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263" "Ѻ.éXødVțrřĄθ7ΛдUŒjeßćιiXTПЗÚĞqŸœÈэαLżØôćmч₱ęãΛě$êůáØCЗшõyĂźςÜãθΘзШË¥şEÈnxΞЗÚÏÛjDVЪжγÏŽнăъçùαìrпцДЖöŃȘâÿřh£1vĎO£κнβдłпČлÿáZiĐą8ÊHÂßĎЩmEBцÄĎвЙßÌ5Ï7ĘŘùrÑckeñëδšПχÌàî" 50.0)
                ]
            }
        ]
    )
    (print (format "<(TS02-C3.AQP-SCR|C_IssueNonFungibleScore)> => \"{}\"" [
        (ref-TS02-C3::AQP-SCR|C_IssueNonFungibleScore patron owner-id score-name 6 0)
    ]))
    (print (format "<(TS02-C3.AQP-POOL|C_Issue class=4 DHB)> => \"{}\"" [
        (ref-TS02-C3::AQP-POOL|C_Issue patron pool-name dpnf-id aqp-class)
    ]))
    (print (format "<(TS02-C3.AQP-POOL|C_AddScore)> => \"{}\"" [
        (ref-TS02-C3::AQP-POOL|C_AddScore patron pool-id score-id)
    ]))
    (print (format "<(TS02-C3.AQP-FVT|REPL_BootstrapVault)> => \"{}\"" [
        (ref-TS02-C3::AQP-FVT|REPL_BootstrapVault patron fvt-id patron score-id ouro-id)
    ]))
    (print "--- [TX-VCT-DPNF01 · mint DHB + transfer EMMA→ANHD] ---")
    (print (format "<(DPNF|C_Create 1)> => \"{}\"" [
        (ref-TS02-C2::DPNF|C_Create patron dpnf-id (VacateDpnfProbe.UC_DpnfNonceRows 1))
    ]))
    (let
        (
            (stake-nonce:integer (at pre-count (ref-DPDC::URD_AccountNonces source dpnf-id false)))
            (pre-supply:integer 1)
        )
        (print (format "<(DPNF|C_TransferNonces nonce {})> => \"{}\"" [stake-nonce
            (ref-TS02-C2::DPNF|C_TransferNonces patron dpnf-id source owner-id [stake-nonce] [1] false)
        ]))
        (print (format "<(TS02-C3.AQP-POOL|C_StakeNonFungibleCollectable nonce {})> => \"{}\"" [
            stake-nonce
            (ref-TS02-C3::AQP-POOL|C_StakeNonFungibleCollectable patron pool-id owner-id beneficiary-id dpnf-id [stake-nonce])
        ]))
        (let
            (
                (tracker-pre:decimal (ref-AQP::UR_AQP|DPNFTrackerBalance pool-id dpnf-id owner-id beneficiary-id stake-nonce))
            )
            (enforce (> tracker-pre 0.0) "TX-VCT-DPNF01: tracker must hold stake")
            ;; L7 #19: the probe nonce is UNSCORED (DPDC sentinel -1.0). Model-0 must treat that as 0, so staking
            ;; it yields base = 0 (never a negative weight). Pre-fix this was -1.0.
            (map print
                [(expect "<<TX-VCT-DPNF01 L7#19>> unscored nonce (sentinel -1.0) contributes base 0, not negative"
                    0.0 (ref-SCR::UR_U-SCR|UserScoreBaseScore beneficiary-id pool-id score-id))])
            (print (format "<(TS02-C3.AQP-POOL|CC_FullVacate agnostic class-4)> => \"{}\"" [
                (ref-TS02-C3::AQP-POOL|CC_FullVacate patron pool-id)
            ]))
            (let
                (
                    (tracker-post:decimal (ref-AQP::UR_AQP|DPNFTrackerBalance pool-id dpnf-id owner-id beneficiary-id stake-nonce))
                    (deb-user:decimal (ref-SCR::UR_U-SCR|UserScoreDebScore beneficiary-id pool-id score-id))
                    (post-supply:integer (ref-DPDC::UR_AccountNonceSupply owner-id dpnf-id false stake-nonce))
                    (inv-post:integer (at "leg-count" (ref-VCT::URH_VacateCollectableInventory pool-id dpnf-id false)))
                )
                (map print
                    [
                        (expect (format "<<TX-VCT-DPNF01 expect>> tracker cleared got={} expected=0" [tracker-post]) 0.0 tracker-post)
                        (expect (format "<<TX-VCT-DPNF01 expect>> deb-score cleared got={} expected=0" [deb-user]) 0.0 deb-user)
                        (expect (format "<<TX-VCT-DPNF01 expect>> supply restored got={} expected={}" [post-supply pre-supply]) pre-supply post-supply)
                        (expect (format "<<TX-VCT-DPNF01 expect>> inventory empty got={} expected=0" [inv-post]) 0 inv-post)
                    ]
                )
            )
        )
    )
)
(env-sigs [])
(commit-tx)
(print "=== END TX-VCT-DPNF01 ======================================================")
(print "")
