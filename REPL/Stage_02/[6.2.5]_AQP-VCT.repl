(begin-tx "TX-VCT-L06 - OF Legs multi-batch two owners")
(print "")
(print "=== TX-VCT-L06 — OF Legs: 2 owners → N=2 finalize=false then finalize =====")
(namespace "ouronet-ns")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(let
    (
        (patron:string KST.ANHD)
        (owner-a:string KST.ANHD)
        (owner-b:string KST.EMMA)
        (beneficiary-a:string KST.ANHD)
        (beneficiary-b:string KST.EMMA)
        (dpof-id:string "MVST-98c486052a51")
        (pool-name:string "OfStakePool")
        (vacate-kind-of:integer 2)
        (nonce-a:integer 1)
        (ref-U|DALOS:module{UtilityDalosV1} U|DALOS)
        (ref-DPOF:module{DemiourgosPactOrtoFungibleV1} DPOF)
        (ref-TS01-C1:module{TalosStageOne_ClientOneV1} TS01-C1)
        (ref-TS02-C3:module{TalosStageTwo_ClientThreeV1} TS02-C3)
        (ref-AQP:module{AcquisitionPoolsV1} AQP-POOL)
        (ref-VCT:module{AcquisitionVacateV1} AQP-VCT)
        (pool-id:string (ref-U|DALOS::UDC_Makeid pool-name))
    )
    (env-sigs
        [
            { "key": "PK_AncientHodler", "caps": [] }
            { "key": "PK_Emma", "caps": [] }
        ]
    )
    (if (ref-DPOF::UR_R-Frozen dpof-id owner-a)
        (ref-TS01-C1::DPOF|C_ToggleFreezeAccount patron dpof-id owner-a false)
        true
    )
    (if (ref-DPOF::UR_R-Frozen dpof-id owner-b)
        (ref-TS01-C1::DPOF|C_ToggleFreezeAccount patron dpof-id owner-b false)
        true
    )
    (if (not (ref-DPOF::UR_R-AddQuantity dpof-id patron))
        (ref-TS01-C1::DPOF|C_ToggleAddQuantityRole patron dpof-id patron true)
        true
    )
    (print (format "<(TS02-C3.AQP-POOL|C_EnablePoolStake)> => \"{}\"" [
        (ref-TS02-C3::AQP-POOL|C_EnablePoolStake patron pool-id)
    ]))
    ;; Owner-a: existing nonce-a. Owner-b: mint → transfer → stake (2 owner-rows for N=2).
    (print (format "<(TS02-C3.AQP-POOL|C_StakeOrtoFungible owner-a)> => \"{}\"" [
        (ref-TS02-C3::AQP-POOL|C_StakeOrtoFungible patron pool-id owner-a beneficiary-a dpof-id [nonce-a])
    ]))
    (print (format "<(DPOF|C_Mint L06 emma)> => \"{}\"" [
        (ref-TS01-C1::DPOF|C_Mint patron dpof-id patron 1.0 [{"vct-l06": true}])
    ]))
    (let
        (
            (patron-nonces:[integer] (ref-DPOF::URD_AccountNonces patron dpof-id))
            (nonce-b:integer (at (- (length patron-nonces) 1) patron-nonces))
        )
        (print (format "<(DPOF|C_Transfer nonce-b={} → EMMA)> => \"{}\"" [
            nonce-b
            (ref-TS01-C1::DPOF|C_Transfer patron dpof-id [nonce-b] patron owner-b true)
        ]))
        (print (format "<(TS02-C3.AQP-POOL|C_StakeOrtoFungible owner-b)> => \"{}\"" [
            (ref-TS02-C3::AQP-POOL|C_StakeOrtoFungible patron pool-id owner-b beneficiary-b dpof-id [nonce-b])
        ]))
    )
    (let
        (
            (plan2:object (ref-VCT::URHC_BuildVacateSlicePlan pool-id dpof-id vacate-kind-of 2))
        )
        (enforce (= 2 (at "slice-count" plan2)) "TX-VCT-L06: expected 2 slices")
        (let
            (
                (slice0:object (at 0 (at "slices" plan2)))
                (slice1:object (at 1 (at "slices" plan2)))
            )
            (enforce (= 1 (length (at "owner-ids" slice0))) "TX-VCT-L06: slice0 owner-count")
            (enforce (= 1 (length (at "owner-ids" slice1))) "TX-VCT-L06: slice1 owner-count")
            (print (format "<(TS02-C3.AQP-POOL|CC_BatchVacateOrtoFungible batch0 partial)> => \"{}\"" [
                (ref-TS02-C3::AQP-POOL|CC_BatchVacateOrtoFungible
                    patron pool-id dpof-id
                    (at "owner-ids" slice0)
                    (at "beneficiary-ids" slice0)
                    (at "nonces-array" slice0)
                )
            ]))
            (let
                (
                    (vip:bool (ref-VCT::UR_VacateInProgress pool-id))
                    (remaining:integer (at "leg-count" (ref-VCT::URH_VacateOfInventory pool-id dpof-id)))
                )
                (map print
                    [
                        (expect (format "<<TX-VCT-L06 expect>> vacate begun got={}" [vip]) true vip)
                        (expect (format "<<TX-VCT-L06 expect>> remaining after batch0 got={} expected=1" [remaining]) 1 remaining)
                    ]
                )
            )
            (print (format "<(TS02-C3.AQP-POOL|CC_BatchVacateOrtoFungible batch1 drains → auto-finalize)> => \"{}\"" [
                (ref-TS02-C3::AQP-POOL|CC_BatchVacateOrtoFungible
                    patron pool-id dpof-id
                    (at "owner-ids" slice1)
                    (at "beneficiary-ids" slice1)
                    (at "nonces-array" slice1)
                )
            ]))
            (let
                (
                    (inv-post:integer (at "leg-count" (ref-VCT::URH_VacateOfInventory pool-id dpof-id)))
                    (vacate-in-progress:bool (ref-VCT::UR_VacateInProgress pool-id))
                    (stake-enabled:bool (ref-AQP::UR_AQP|PoolStakeEnabled pool-id))
                )
                (map print
                    [
                        (expect (format "<<TX-VCT-L06 expect>> inventory empty got={}" [inv-post]) 0 inv-post)
                        (expect (format "<<TX-VCT-L06 expect>> vacate cleared got={}" [vacate-in-progress]) false vacate-in-progress)
                        (expect (format "<<TX-VCT-L06 expect>> stake re-enabled got={}" [stake-enabled]) true stake-enabled)
                    ]
                )
            )
        )
    )
)
(env-sigs [])
(commit-tx)
(print "=== END TX-VCT-L06 =========================================================")
