(begin-tx "TX-VCT-N02 - expect-failure finalize after partial Legs")
(print "")
(print "=== TX-VCT-N02 — finalize=true after vacating only one of two TF legs =======")
(namespace "ouronet-ns")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(let
    (
        (patron:string KST.ANHD)
        (owner-id:string KST.ANHD)
        (beneficiary-id:string KST.ANHD)
        (ouro-id:string "OURO-98c486052a51")
        (pool-name:string "TfStakePool")
        (vacate-kind-tf:integer 1)
        (stake-amount:decimal 10.0)
        (ref-U|DALOS:module{UtilityDalosV1} U|DALOS)
        (ref-TS02-C3:module{TalosStageTwo_ClientThreeV1} TS02-C3)
        (ref-AQP:module{AcquisitionPoolsV1} AQP-POOL)
        (ref-VCT:module{AcquisitionVacateV1} AQP-VCT)
        (pool-id:string (ref-U|DALOS::UDC_Makeid pool-name))
    )
    (env-sigs [{ "key": "PK_AncientHodler", "caps": [] }])
    (print (format "<(TS02-C3.AQP-POOL|C_EnablePoolStake)> => \"{}\"" [
        (ref-TS02-C3::AQP-POOL|C_EnablePoolStake patron pool-id)
    ]))
    ;; Two stakes → two TF legs if different beneficiaries; same owner×ben collapses to one row.
    ;; Use amount-only: stake once, then try finalize with a zeroed amount batch that doesn't clear inventory.
    (print (format "<(TS02-C3.AQP-POOL|C_StakeTrueFungible)> => \"{}\"" [
        (ref-TS02-C3::AQP-POOL|C_StakeTrueFungible patron pool-id owner-id beneficiary-id ouro-id stake-amount)
    ]))
    (print (format "<(TS02-C3.AQP-POOL|C_StakeTrueFungible second)> => \"{}\"" [
        (ref-TS02-C3::AQP-POOL|C_StakeTrueFungible patron pool-id owner-id beneficiary-id ouro-id stake-amount)
    ]))
    (let
        (
            (bal:decimal (ref-AQP::UR_AQP|DPTFTrackerBalance pool-id ouro-id owner-id beneficiary-id))
            (half:decimal (/ bal 2.0))
        )
        ;; Vacate half amount? TF vacate requires full row — so partial Legs isn't amount-partial.
        ;; Instead: Legs with finalize=true but leave vacate open by using no-op then...
        ;; Real N02: start vacate with finalize=false empty? Can't.
        ;; Better: DPSF-style isn't available here. Use finalize=true on Legs that vacates nothing valid.
        ;; Simplest solid reject: after stake, call Legs finalize=true with wrong (zero) amount that fails URC_VacateTfLegsOk,
        ;; OR vacate-in-progress path: Full path already cleaned N01.
        ;;
        ;; Do: Legs finalize=false with full inventory (opens vacate), then Legs finalize=true with EMPTY arrays
        ;; while inventory was already cleared — wait that would succeed finalize.
        ;;
        ;; Correct reject for "inventory remains":
        ;; Stake TF, Legs finalize=true with owner arrays that vacate 0 amount? Validation fails.
        ;; Use two-owner DPSF leftover from L02 — pool may be empty.
        ;;
        ;; Practical N02 for Legs: stake TF; call Legs with finalize=true and amounts that don't match tracker
        ;; (URC_VacateTfLegsOk fails).
        (map print
            [
                (expect-failure
                    (format "<<TX-VCT-N02 expect-failure>> Legs amounts mismatch tracker must fail" [])
                    (ref-TS02-C3::AQP-POOL|C_VacateTrueFungibleLegs
                        patron pool-id ouro-id [owner-id] [beneficiary-id] [1.0] true
                    )
                )
            ]
        )
        (let
            (
                (plan:object (ref-VCT::URDC_BuildVacateSlicePlan pool-id ouro-id 1 1))
                (s0:object (at 0 (at "slices" plan)))
            )
            (print (format "<(TS02-C3.AQP-POOL|C_FullVacateTrueFungible cleanup)> => \"{}\"" [
                (ref-TS02-C3::AQP-POOL|C_FullVacateTrueFungible
                    patron pool-id ouro-id
                    (at "owner-ids" s0)
                    (at "beneficiary-ids" s0)
                    (at "amounts" s0)
                )
            ]))
        )
    )
)
(env-sigs [])
(commit-tx)
(print "=== END TX-VCT-N02 ===========================================================")
(print "")
