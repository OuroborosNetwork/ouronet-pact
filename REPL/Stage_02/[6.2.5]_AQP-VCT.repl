(begin-tx "TX-VCT-L01 - C_ResliceVacate before any chunk (new VacateJobID)")
(print "")
(print "=== TX-VCT-L01 — Reslice before chunks =====================================")
(namespace "ouronet-ns")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(let
    (
        (patron:string KST.ANHD)
        (owner-id:string KST.ANHD)
        (beneficiary-id:string KST.ANHD)
        (dpof-id:string "MVST-98c486052a51")
        (pool-name:string "OfStakePool")
        (vacate-kind-of:integer 2)
        (stake-nonce:integer 1)
        (ref-U|DALOS:module{UtilityDalosV1} U|DALOS)
        (ref-DPOF:module{DemiourgosPactOrtoFungibleV1} DPOF)
        (ref-TS01-C1:module{TalosStageOne_ClientOneV1} TS01-C1)
        (ref-TS02-C3:module{TalosStageTwo_ClientThreeV1} TS02-C3)
        (ref-AQP:module{AcquisitionPoolsV1} AQP-POOL)
        (ref-VCT:module{AcquisitionVacateV1} AQP-VCT)
        (pool-id:string (ref-U|DALOS::UDC_Makeid pool-name))
    )
    (env-sigs [{ "key": "PK_AncientHodler", "caps": [] }])
    (if (ref-DPOF::UR_R-Frozen dpof-id owner-id)
        (ref-TS01-C1::DPOF|C_ToggleFreezeAccount patron dpof-id owner-id false)
        true
    )
    (print (format "<(TS02-C3.AQP-POOL|C_EnablePoolStake)> => \"{}\"" [
        (ref-TS02-C3::AQP-POOL|C_EnablePoolStake patron pool-id)
    ]))
    (print (format "<(TS02-C3.AQP-POOL|C_StakeOrtoFungible)> => \"{}\"" [
        (ref-TS02-C3::AQP-POOL|C_StakeOrtoFungible patron pool-id owner-id beneficiary-id dpof-id [stake-nonce])
    ]))
    (print (format "<(TS02-C3.AQP-POOL|C_BeginVacate slice-count 3)> => \"{}\"" [
        (ref-TS02-C3::AQP-POOL|C_BeginVacate patron pool-id dpof-id vacate-kind-of 3)
    ]))
    (let
        (
            (old-job:object (ref-VCT::URDC_ActiveJobForPool pool-id))
            (old-job-id:string (at "vacate-job-id" old-job))
        )
        (print (format "<(TS02-C3.AQP-POOL|C_ResliceVacate slice-count 1)> => \"{}\"" [
            (ref-TS02-C3::AQP-POOL|C_ResliceVacate patron old-job-id 1)
        ]))
        (let
            (
                (old-job-row:object (ref-VCT::UR_Job old-job-id))
                (new-job:object (ref-VCT::URDC_ActiveJobForPool pool-id))
                (new-job-id:string (at "vacate-job-id" new-job))
                (plan:object (ref-VCT::URDC_BuildVacateSlicePlan pool-id dpof-id vacate-kind-of 1))
                (slice0:object (at 0 (at "slices" plan)))
            )
            (print (format "<(VCT|old-job-id new-job-id)> => {} / {}" [old-job-id new-job-id]))
            (print (format "<(TS02-C3.AQP-POOL|C_VacateChunkOrtoFungible)> => \"{}\"" [
                (ref-TS02-C3::AQP-POOL|C_VacateChunkOrtoFungible
                    patron new-job-id 0
                    (at "owner-ids" slice0)
                    (at "beneficiary-ids" slice0)
                    (at "nonces-array" slice0)
                )
            ]))
            (let
                (
                    (tracker-post:decimal (ref-AQP::UR_AQP|DPOFTrackerBalance pool-id dpof-id owner-id beneficiary-id stake-nonce))
                    (new-job-row:object (ref-VCT::UR_Job new-job-id))
                )
                (map print
                    [
                        (expect (format "<<TX-VCT-L01 expect>> old job resliced got={} expected=true" [(at "resliced" old-job-row)]) true (at "resliced" old-job-row))
                        (expect (format "<<TX-VCT-L01 expect>> new job finalized got={} expected=true" [(at "finalized" new-job-row)]) true (at "finalized" new-job-row))
                        (expect (format "<<TX-VCT-L01 expect>> tracker cleared got={} expected=0" [tracker-post]) 0.0 tracker-post)
                    ]
                )
            )
        )
    )
)
(env-sigs [])
(commit-tx)
(print "=== END TX-VCT-L01 =========================================================")
(print "")
