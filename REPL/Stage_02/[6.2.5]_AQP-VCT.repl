(begin-tx "TX-VCT-L04b - only the pool OWNER may vacate / abort / enable (owner-gate negatives)")
(print "")
(print "=== TX-VCT-L04b — non-owner CC_FullVacate / C_AbortVacate / C_EnablePoolStake rejected ==")
;; Regression guard for the owner-gate fix: CAP_VctVacatePoolOwner was a defcap bare-called inside the
;; VCT|C>* caps, which no-opped the owner enforce — a non-owner could vacate OR abort any pool. It is now
;; a defun (runs the enforce). EMMA is NOT the SfStakePool owner (owner = ANHD); all three must fail.
(namespace "ouronet-ns")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(env-sigs [{ "key": "PK_Emma", "caps": [] }])
(let
    (
        (foreign:string KST.EMMA)
        (pool-name:string "SfStakePool")
        (ref-U|DALOS:module{UtilityDalosV1} U|DALOS)
        (ref-TS02-C3:module{TalosStageTwo_ClientThreeV1} TS02-C3)
        (pool-id:string (ref-U|DALOS::UDC_Makeid pool-name))
    )
    (map print
        [
            (expect-failure
                (format "<<TX-VCT-L04b expect-failure>> non-owner CC_FullVacate rejected (pool-owner gate)" [])
                (ref-TS02-C3::AQP-POOL|CC_FullVacate foreign pool-id))
            (expect-failure
                (format "<<TX-VCT-L04b expect-failure>> non-owner C_AbortVacate rejected (pool-owner gate)" [])
                (ref-TS02-C3::AQP-POOL|C_AbortVacate foreign pool-id))
            (expect-failure
                (format "<<TX-VCT-L04b expect-failure>> non-owner C_EnablePoolStake rejected (pool-owner gate)" [])
                (ref-TS02-C3::AQP-POOL|C_EnablePoolStake foreign pool-id))
        ]
    )
)
(env-sigs [])
(commit-tx)
(print "=== END TX-VCT-L04b =========================================================")
(print "")
