    (print (format "<(TS02-C3.AQP-SCR|C_IssueNonFungibleScore)> => \"{}\"" [
        (ref-TS02-C3::AQP-SCR|C_IssueNonFungibleScore patron owner-id score-name 6 0)
    ]))
    (print (format "<(TS02-C3.AQP-POOL|C_Issue class=4 KBN)> => \"{}\"" [
        (ref-TS02-C3::AQP-POOL|C_Issue patron pool-name dpnf-id aqp-class)
    ]))
    (print (format "<(TS02-C3.AQP-POOL|C_AddScore)> => \"{}\"" [
        (ref-TS02-C3::AQP-POOL|C_AddScore patron pool-id score-id)
    ]))
    (print (format "<(TS02-C3.AQP-FVT|REPL_BootstrapVault)> => \"{}\"" [
        (ref-TS02-C3::AQP-FVT|REPL_BootstrapVault patron fvt-id patron score-id ouro-id)
    ]))
    (print "--- [TX-VCT-DPNF03 · mint KBN + transfer EMMA→ANHD] ---")
    (print (format "<(DPNF|C_Create 1)> => \"{}\"" [
        (ref-TS02-C2::DPNF|C_Create patron dpnf-id (VacateDpnfProbe.UC_DpnfNonceRows 1))
    ]))
    (let
        (
            (stake-nonce:integer (at pre-count (ref-DPDC::URD_AccountNonces source dpnf-id false)))
            (pre-supply:integer 1)
        )
        (print (format "<(DPNF|C_TransferNonces nonce {})> => \"{}\"" [stake-nonce
            (ref-TS02-C2::DPNF|C_TransferNonces patron dpnf-id source owner-id [stake-nonce] [1] false)
        ]))
        (print (format "<(TS02-C3.AQP-POOL|C_StakeNonFungibleCollectable)> => \"{}\"" [
            (ref-TS02-C3::AQP-POOL|C_StakeNonFungibleCollectable patron pool-id owner-id beneficiary-id dpnf-id [stake-nonce])
        ]))
        (print (format "<(TS02-C3.AQP-POOL|C_BeginVacate slice-count 1)> => \"{}\"" [
            (ref-TS02-C3::AQP-POOL|C_BeginVacate patron pool-id dpnf-id vacate-kind-dpnf 1)
        ]))
        (let
            (
                (active-job:object (ref-VCT::URDC_ActiveJobForPool pool-id))
                (vacate-job-id:string (at "vacate-job-id" active-job))
                (plan:object (ref-VCT::URDC_BuildVacateSlicePlan pool-id dpnf-id vacate-kind-dpnf 1))
                (slice0:object (at 0 (at "slices" plan)))
            )
            (print (format "<(TS02-C3.AQP-POOL|C_VacateChunkCollectable KBN slice 0)> => \"{}\"" [
                (ref-TS02-C3::AQP-POOL|C_VacateChunkCollectable
                    patron vacate-job-id 0
                    (at "owner-ids" slice0)
                    (at "beneficiary-ids" slice0)
                    (at "nonces-array" slice0)
                    (at "amounts-array" slice0)
                )
            ]))
            (let
                (
                    (tracker-post:decimal (ref-AQP::UR_AQP|DPNFTrackerBalance pool-id dpnf-id owner-id beneficiary-id stake-nonce))
                    (post-supply:integer (ref-DPDC::UR_AccountNonceSupply owner-id dpnf-id false stake-nonce))
                    (job:object (ref-VCT::UR_Job vacate-job-id))
                )
                (map print
                    [
                        (expect (format "<<TX-VCT-DPNF03 expect>> tracker cleared got={} expected=0" [tracker-post]) 0.0 tracker-post)
                        (expect (format "<<TX-VCT-DPNF03 expect>> supply restored got={} expected={}" [post-supply pre-supply]) pre-supply post-supply)
                        (expect (format "<<TX-VCT-DPNF03 expect>> job finalized got={} expected=true" [(at "finalized" job)]) true (at "finalized" job))
                    ]
                )
            )
        )
    )
)
(env-sigs [])
(commit-tx)
(print "=== END TX-VCT-DPNF03 ======================================================")
(print "")
