            (ref-TS02-C2::DPNF|C_TransferNonces patron dpnf-id source owner-id [stake-nonce] [1] false)
        ]))
        (print (format "<(TS02-C3.AQP-POOL|C_StakeNonFungibleCollectable)> => \"{}\"" [
            (ref-TS02-C3::AQP-POOL|C_StakeNonFungibleCollectable patron pool-id owner-id beneficiary-id dpnf-id [stake-nonce])
        ]))
        (let
            (
                (plan:object (ref-VCT::URDC_BuildVacateSlicePlan pool-id dpnf-id vacate-kind-dpnf 1))
                (slice0:object (at 0 (at "slices" plan)))
            )
            (print (format "<(TS02-C3.AQP-POOL|C_VacateNonFungibleLegs KBN finalize)> => \"{}\"" [
                (ref-TS02-C3::AQP-POOL|C_VacateNonFungibleLegs
                    patron pool-id dpnf-id
                    (at "owner-ids" slice0)
                    (at "beneficiary-ids" slice0)
                    (at "nonces-array" slice0)
                    (at "amounts-array" slice0)
                    true
                )
            ]))
            (let
                (
                    (tracker-post:decimal (ref-AQP::UR_AQP|DPNFTrackerBalance pool-id dpnf-id owner-id beneficiary-id stake-nonce))
                    (post-supply:integer (ref-DPDC::UR_AccountNonceSupply owner-id dpnf-id false stake-nonce))
                    (vacate-in-progress:bool (ref-VCT::UR_VacateInProgress pool-id))
                    (stake-enabled:bool (ref-AQP::UR_AQP|PoolStakeEnabled pool-id))
                )
                (map print
                    [
                        (expect (format "<<TX-VCT-DPNF03 expect>> tracker cleared got={} expected=0" [tracker-post]) 0.0 tracker-post)
                        (expect (format "<<TX-VCT-DPNF03 expect>> supply restored got={} expected={}" [post-supply pre-supply]) pre-supply post-supply)
                        (expect (format "<<TX-VCT-DPNF03 expect>> vacate-in-progress cleared got={} expected=false" [vacate-in-progress]) false vacate-in-progress)
                        (expect (format "<<TX-VCT-DPNF03 expect>> stake re-enabled got={} expected=true" [stake-enabled]) true stake-enabled)
                    ]
                )
            )
        )
    )
)
(env-sigs [])
(commit-tx)
(print "=== END TX-VCT-DPNF03 ======================================================")
(print "")
