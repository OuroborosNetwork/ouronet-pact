                (expect (format "<<TX-VCT-RESUME-C>> pool fully vacated — 0 legs got={}" [remaining]) 0 remaining)
                (expect (format "<<TX-VCT-RESUME-C>> campaign AUTO-FINALIZED (vacate-in-progress cleared) got={}" [vip]) false vip)
                (expect (format "<<TX-VCT-RESUME-C>> stake RE-ENABLED on finalize got={}" [stake-enabled]) true stake-enabled)
            ]
