(begin-tx "TX-VCT-N01 - expect-failure finalize while inventory remains")
(print "")
(print "=== TX-VCT-N01 — empty Legs arrays rejected (batch validation) ===============")
(namespace "ouronet-ns")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(let
    (
        (patron:string KST.ANHD)
        (owner-id:string KST.ANHD)
        (beneficiary-id:string KST.ANHD)
        (ouro-id:string "OURO-98c486052a51")
        (pool-name:string "TfStakePool")
        (vacate-kind-tf:integer 1)
        (stake-amount:decimal 25.0)
        (ref-U|DALOS:module{UtilityDalosV1} U|DALOS)
        (ref-TS02-C3:module{TalosStageTwo_ClientThreeV1} TS02-C3)
        (ref-VCT:module{AcquisitionVacateV1} AQP-VCT)
        (pool-id:string (ref-U|DALOS::UDC_Makeid pool-name))
    )
    (env-sigs [{ "key": "PK_AncientHodler", "caps": [] }])
    (print (format "<(TS02-C3.AQP-POOL|C_EnablePoolStake)> => \"{}\"" [
        (ref-TS02-C3::AQP-POOL|C_EnablePoolStake patron pool-id)
    ]))
    (print (format "<(TS02-C3.AQP-POOL|C_StakeTrueFungible)> => \"{}\"" [
        (ref-TS02-C3::AQP-POOL|C_StakeTrueFungible patron pool-id owner-id beneficiary-id ouro-id stake-amount)
    ]))
    (map print
        [
            (expect-failure
                (format "<<TX-VCT-N01 expect-failure>> finalize with empty legs while inventory remains" [])
                (ref-TS02-C3::AQP-POOL|C_VacateTrueFungibleLegs
                    patron pool-id ouro-id [] [] [] true
                )
            )
        ]
    )
    ;; Empty legs may fail earlier on batch validation — also cover partial vacate + bad finalize:
    ;; stake stays; clean up with FullVacate so later tests see empty inventory.
    (let
        (
            (plan:object (ref-VCT::URDC_BuildVacateSlicePlan pool-id ouro-id 1 1))
            (s0:object (at 0 (at "slices" plan)))
        )
        (print (format "<(TS02-C3.AQP-POOL|C_FullVacateTrueFungible cleanup)> => \"{}\"" [
            (ref-TS02-C3::AQP-POOL|C_FullVacateTrueFungible
                patron pool-id ouro-id
                (at "owner-ids" s0)
                (at "beneficiary-ids" s0)
                (at "amounts" s0)
            )
        ]))
    )
)
(env-sigs [])
(commit-tx)
(print "=== END TX-VCT-N01 ===========================================================")
(print "")
