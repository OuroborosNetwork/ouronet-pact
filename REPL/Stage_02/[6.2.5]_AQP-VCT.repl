;;
;; REPL/Stage_02/[6.2.5]_AQP-VCT.repl — comprehensive VCT vacate tests (all asset kinds + lifecycle)
;; Architecture: Full (1 tx) + Stateless Legs (N txs; auto-begin; finalize on last).
;; Loaded by REPL/VCT-comprehensive.repl / aqp-deploy-gate after [6.2]_AQP.repl.
;;
(print "")
(print "================================================================")
(print "FILE  REPL/Stage_02/[6.2.5]_AQP-VCT.repl")
(print "================================================================")
(print "Legend: <<TX-VCT-*>> expect lines; <(Talos…)> echoes; URDC_BuildVacateSlicePlan = offline split helper")
(print "DPNF tests mint probe NFTs via VacateDpnfProbe (AQP-FAST — no Populate* required).")
(print "")
;;
(begin-tx "TX-VCT-00 - deploy VacateDpnfProbe helpers")
(namespace "ouronet-ns")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(env-enable-repl-natives true)
(env-sigs
    [{"key": "1a4e15d3c51e0b73e92644600487ba8eaae312e1a178b91801d54e13c1b350a5", "caps": []}]
)
(module VacateDpnfProbe GOV
    (defcap GOV () true)
    (defun UC_MinDpnfNonceRow:object{DpdcUdcV1.DPDC|NonceData} (idx:integer)
        (let
            (
                (ref-DPDC-UDC:module{DpdcUdcV1} DPDC-UDC)
                (md:object{DpdcUdcV1.NonceMetaData} (ref-DPDC-UDC::UDC_NoMetaData))
                (i-asset-type:object{DpdcUdcV1.URI|Type}
                    (ref-DPDC-UDC::UDC_URI|Type true false false false false false false)
                )
                (zd:object{DpdcUdcV1.URI|Data} (ref-DPDC-UDC::UDC_ZeroURI|Data))
            )
            (ref-DPDC-UDC::UDC_NonceData
                0.0 0.0
                (format "VacateDpnfProbe{}" [idx])
                "vct-vacate-probe-dpnf"
                md i-asset-type zd zd zd
            )
        )
    )
    (defun UC_DpnfNonceRows:[object{DpdcUdcV1.DPDC|NonceData}] (count:integer)
        (map UC_MinDpnfNonceRow (enumerate 1 count))
    )
)
(env-sigs [])
(commit-tx)
(print "")
;;
(begin-tx "TX-VCT-TF01 - C_FullVacateTrueFungible")
(print "")
(print "=== TX-VCT-TF01 — Full TF vacate (TfStakePool stake from TX-FVT-03) =========")
(namespace "ouronet-ns")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(let
    (
        (patron:string KST.ANHD)
        (owner-id:string KST.ANHD)
        (beneficiary-id:string KST.ANHD)
        (ouro-id:string "OURO-98c486052a51")
        (score-name:string "TfStakeScore")
        (fvt-name:string "TfStakeVault")
        (pool-name:string "TfStakePool")
        (ref-U|DALOS:module{UtilityDalosV1} U|DALOS)
        (ref-DPTF:module{DemiourgosPactTrueFungibleV1} DPTF)
        (ref-TS02-C3:module{TalosStageTwo_ClientThreeV1} TS02-C3)
        (ref-AQP:module{AcquisitionPoolsV1} AQP-POOL)
        (ref-SCR:module{AcquisitionScoresV1} AQP-SCORE)
        (ref-FVT:module{AcquisitionFarmsVaultsTreasuriesV1} AQP-FVT)
        (ref-VCT:module{AcquisitionVacateV1} AQP-VCT)
        (score-id:string (ref-U|DALOS::UDC_Makeid score-name))
        (fvt-id:string (ref-U|DALOS::UDC_Makeid fvt-name))
        (pool-id:string (ref-U|DALOS::UDC_Makeid pool-name))
        (tracker-pre:decimal (ref-AQP::UR_AQP|DPTFTrackerBalance pool-id ouro-id owner-id beneficiary-id))
        (pre-supply:decimal (ref-DPTF::UR_AccountSupply ouro-id owner-id))
    )
    ;; TX-FVT-07 may have fully unstaked — restake so vacate has inventory.
    (if (<= tracker-pre 0.0)
        (let
            (
                (restake-amt:decimal 100.0)
            )
            (enforce (>= pre-supply restake-amt) "TX-VCT-TF01: need OURO to restake after TX-FVT-07")
            (print "--- [TX-VCT-TF01 · 00 · restake after FVT-07 full exit] ---")
            (env-sigs [{ "key": "PK_AncientHodler", "caps": [] }])
            (print (format "<(C_StakeTrueFungible restake {})> => \"{}\"" [restake-amt
                (ref-TS02-C3::AQP-POOL|C_StakeTrueFungible patron pool-id owner-id beneficiary-id ouro-id restake-amt)
            ]))
        )
        true
    )
    (let
        (
            (tracker-work:decimal (ref-AQP::UR_AQP|DPTFTrackerBalance pool-id ouro-id owner-id beneficiary-id))
            (pre-supply-work:decimal (ref-DPTF::UR_AccountSupply ouro-id owner-id))
        )
        (enforce (> tracker-work 0.0) "TX-VCT-TF01: need TF stake inventory")
        (print (format "<(pre tracker/supply)> => {} / {}" [tracker-work pre-supply-work]))
        (env-sigs [{ "key": "PK_AncientHodler", "caps": [] }])
        (let
            (
                (plan:object (ref-VCT::URDC_BuildVacateSlicePlan pool-id ouro-id 1 1))
                (s0:object (at 0 (at "slices" plan)))
            )
            (print (format "<(TS02-C3.AQP-POOL|C_FullVacateTrueFungible)> => \"{}\"" [
                (ref-TS02-C3::AQP-POOL|C_FullVacateTrueFungible
                    patron pool-id ouro-id
                    (at "owner-ids" s0)
                    (at "beneficiary-ids" s0)
                    (at "amounts" s0)
                )
            ]))
        )
        (let
            (
                (tracker-post:decimal (ref-AQP::UR_AQP|DPTFTrackerBalance pool-id ouro-id owner-id beneficiary-id))
                (deb-user:decimal (ref-SCR::UR_U-SCR|UserScoreDebScore beneficiary-id pool-id score-id))
                (unclaimed:integer (ref-FVT::UR_FVT-RG|UnclaimedCount fvt-id ouro-id))
                (post-supply:decimal (ref-DPTF::UR_AccountSupply ouro-id owner-id))
                (inv-post:integer (at "leg-count" (ref-VCT::URD_VacateTfInventory pool-id ouro-id)))
            )
            (map print
                [
                    (expect (format "<<TX-VCT-TF01 expect>> tracker cleared got={} expected=0" [tracker-post]) 0.0 tracker-post)
                    (expect (format "<<TX-VCT-TF01 expect>> deb-score cleared got={} expected=0" [deb-user]) 0.0 deb-user)
                    (expect (format "<<TX-VCT-TF01 expect>> unclaimed-count got={} expected=0" [unclaimed]) 0 unclaimed)
                    (expect (format "<<TX-VCT-TF01 expect>> supply restored got={} expected={}" [post-supply (+ pre-supply-work tracker-work)]) (+ pre-supply-work tracker-work) post-supply)
                    (expect (format "<<TX-VCT-TF01 expect>> vacate inventory empty got={} expected=0" [inv-post]) 0 inv-post)
                ]
            )
        )
    )
)
(env-sigs [])
(commit-tx)
(print "=== END TX-VCT-TF01 ========================================================")
(print "")
;;
(begin-tx "TX-VCT-TF02 - C_VacateTrueFungibleLegs finalize")
(print "")
(print "=== TX-VCT-TF02 — TF Legs vacate (1 batch finalize=true) ===================")
(namespace "ouronet-ns")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(let
    (
        (patron:string KST.ANHD)
        (owner-id:string KST.ANHD)
        (beneficiary-id:string KST.ANHD)
        (ouro-id:string "OURO-98c486052a51")
        (score-name:string "TfStakeScore")
        (pool-name:string "TfStakePool")
        (vacate-kind-tf:integer 1)
        (stake-amount:decimal 50.0)
        (ref-U|DALOS:module{UtilityDalosV1} U|DALOS)
        (ref-DPTF:module{DemiourgosPactTrueFungibleV1} DPTF)
        (ref-TS02-C3:module{TalosStageTwo_ClientThreeV1} TS02-C3)
        (ref-AQP:module{AcquisitionPoolsV1} AQP-POOL)
        (ref-SCR:module{AcquisitionScoresV1} AQP-SCORE)
        (ref-VCT:module{AcquisitionVacateV1} AQP-VCT)
        (score-id:string (ref-U|DALOS::UDC_Makeid score-name))
        (pool-id:string (ref-U|DALOS::UDC_Makeid pool-name))
    )
    (env-sigs [{ "key": "PK_AncientHodler", "caps": [] }])
    (print (format "<(TS02-C3.AQP-POOL|C_EnablePoolStake)> => \"{}\"" [
        (ref-TS02-C3::AQP-POOL|C_EnablePoolStake patron pool-id)
    ]))
    (print (format "<(TS02-C3.AQP-POOL|C_StakeTrueFungible)> => \"{}\"" [
        (ref-TS02-C3::AQP-POOL|C_StakeTrueFungible patron pool-id owner-id beneficiary-id ouro-id stake-amount)
    ]))
    (let
        (
            (pre-supply:decimal (ref-DPTF::UR_AccountSupply ouro-id owner-id))
            (plan:object (ref-VCT::URDC_BuildVacateSlicePlan pool-id ouro-id vacate-kind-tf 1))
            (slice0:object (at 0 (at "slices" plan)))
        )
        (print (format "<(TS02-C3.AQP-POOL|C_VacateTrueFungibleLegs finalize)> => \"{}\"" [
            (ref-TS02-C3::AQP-POOL|C_VacateTrueFungibleLegs
                patron pool-id ouro-id
                (at "owner-ids" slice0)
                (at "beneficiary-ids" slice0)
                (at "amounts" slice0)
                true
            )
        ]))
        (let
            (
                (tracker-post:decimal (ref-AQP::UR_AQP|DPTFTrackerBalance pool-id ouro-id owner-id beneficiary-id))
                (deb-user:decimal (ref-SCR::UR_U-SCR|UserScoreDebScore beneficiary-id pool-id score-id))
                (post-supply:decimal (ref-DPTF::UR_AccountSupply ouro-id owner-id))
                (vacate-in-progress:bool (ref-VCT::UR_VacateInProgress pool-id))
                (stake-enabled:bool (ref-AQP::UR_AQP|PoolStakeEnabled pool-id))
            )
            (map print
                [
                    (expect (format "<<TX-VCT-TF02 expect>> tracker cleared got={} expected=0" [tracker-post]) 0.0 tracker-post)
                    (expect (format "<<TX-VCT-TF02 expect>> deb-score cleared got={} expected=0" [deb-user]) 0.0 deb-user)
                    (expect (format "<<TX-VCT-TF02 expect>> supply restored got={} expected={}" [post-supply (+ pre-supply stake-amount)]) (+ pre-supply stake-amount) post-supply)
                    (expect (format "<<TX-VCT-TF02 expect>> vacate-in-progress cleared got={} expected=false" [vacate-in-progress]) false vacate-in-progress)
                    (expect (format "<<TX-VCT-TF02 expect>> stake re-enabled got={} expected=true" [stake-enabled]) true stake-enabled)
                ]
            )
        )
    )
)
(env-sigs [])
(commit-tx)
(print "=== END TX-VCT-TF02 ========================================================")
(print "")
;;
(begin-tx "TX-VCT-L01 - OF Legs continue after re-split (finalize)")
(print "")
(print "=== TX-VCT-L01 — OF Legs: plan→vacate→finalize (re-split style) ============")
(namespace "ouronet-ns")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(let
    (
        (patron:string KST.ANHD)
        (owner-id:string KST.ANHD)
        (beneficiary-id:string KST.ANHD)
        (dpof-id:string "MVST-98c486052a51")
        (pool-name:string "OfStakePool")
        (vacate-kind-of:integer 2)
        (stake-nonce:integer 1)
        (ref-U|DALOS:module{UtilityDalosV1} U|DALOS)
        (ref-DPOF:module{DemiourgosPactOrtoFungibleV1} DPOF)
        (ref-TS01-C1:module{TalosStageOne_ClientOneV1} TS01-C1)
        (ref-TS02-C3:module{TalosStageTwo_ClientThreeV1} TS02-C3)
        (ref-AQP:module{AcquisitionPoolsV1} AQP-POOL)
        (ref-VCT:module{AcquisitionVacateV1} AQP-VCT)
        (pool-id:string (ref-U|DALOS::UDC_Makeid pool-name))
    )
    (env-sigs [{ "key": "PK_AncientHodler", "caps": [] }])
    (if (ref-DPOF::UR_R-Frozen dpof-id owner-id)
        (ref-TS01-C1::DPOF|C_ToggleFreezeAccount patron dpof-id owner-id false)
        true
    )
    (print (format "<(TS02-C3.AQP-POOL|C_EnablePoolStake)> => \"{}\"" [
        (ref-TS02-C3::AQP-POOL|C_EnablePoolStake patron pool-id)
    ]))
    (print (format "<(TS02-C3.AQP-POOL|C_StakeOrtoFungible)> => \"{}\"" [
        (ref-TS02-C3::AQP-POOL|C_StakeOrtoFungible patron pool-id owner-id beneficiary-id dpof-id [stake-nonce])
    ]))
    (let
        (
            (plan:object (ref-VCT::URDC_BuildVacateSlicePlan pool-id dpof-id vacate-kind-of 1))
            (slice0:object (at 0 (at "slices" plan)))
            (zero-amts:[[integer]] (ref-VCT::UC_ZeroIntAmountsMatrix (at "nonces-array" slice0)))
        )
        (print (format "<(TS02-C3.AQP-POOL|C_VacateOrtoFungibleLegs finalize)> => \"{}\"" [
            (ref-TS02-C3::AQP-POOL|C_VacateOrtoFungibleLegs
                patron pool-id dpof-id
                (at "owner-ids" slice0)
                (at "beneficiary-ids" slice0)
                (at "nonces-array" slice0)
                zero-amts
                true
            )
        ]))
        (let
            (
                (tracker-post:decimal (ref-AQP::UR_AQP|DPOFTrackerBalance pool-id dpof-id owner-id beneficiary-id stake-nonce))
                (vacate-in-progress:bool (ref-VCT::UR_VacateInProgress pool-id))
                (stake-enabled:bool (ref-AQP::UR_AQP|PoolStakeEnabled pool-id))
            )
            (map print
                [
                    (expect (format "<<TX-VCT-L01 expect>> tracker cleared got={} expected=0" [tracker-post]) 0.0 tracker-post)
                    (expect (format "<<TX-VCT-L01 expect>> vacate-in-progress cleared got={} expected=false" [vacate-in-progress]) false vacate-in-progress)
                    (expect (format "<<TX-VCT-L01 expect>> stake re-enabled got={} expected=true" [stake-enabled]) true stake-enabled)
                ]
            )
        )
    )
)
(env-sigs [])
(commit-tx)
(print "=== END TX-VCT-L01 =========================================================")
(print "")
;;
(begin-tx "TX-VCT-L02 - DPSF Legs partial then continue finalize")
(print "")
(print "=== TX-VCT-L02 — DPSF Legs: batch0 finalize=false → re-plan → finalize =====")
(namespace "ouronet-ns")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(let
    (
        (patron:string KST.ANHD)
        (owner-a:string KST.ANHD)
        (owner-b:string KST.EMMA)
        (beneficiary-a:string KST.ANHD)
        (beneficiary-b:string KST.EMMA)
        (dpsf-id:string "DHCD-98c486052a51")
        (pool-name:string "SfStakePool")
        (vacate-kind-dpsf:integer 3)
        (nonce-a:integer 1)
        (nonce-b:integer 2)
        (ref-U|DALOS:module{UtilityDalosV1} U|DALOS)
        (ref-DPDC:module{DpdcV1} DPDC)
        (ref-TS02-C1:module{TalosStageTwo_ClientOneV2} TS02-C1)
        (ref-TS02-C3:module{TalosStageTwo_ClientThreeV1} TS02-C3)
        (ref-AQP:module{AcquisitionPoolsV1} AQP-POOL)
        (ref-VCT:module{AcquisitionVacateV1} AQP-VCT)
        (pool-id:string (ref-U|DALOS::UDC_Makeid pool-name))
    )
    (env-sigs
        [
            { "key": "PK_AncientHodler", "caps": [] }
            { "key": "PK_Emma", "caps": [] }
        ]
    )
    (let
        (
            (amt-b:integer (ref-DPDC::UR_AccountNonceSupply owner-a dpsf-id true nonce-b))
        )
        (if (> amt-b 0)
            (ref-TS02-C1::DPSF|C_TransferNonces patron dpsf-id owner-a owner-b [nonce-b] [amt-b] false)
            true
        )
    )
    (print (format "<(TS02-C3.AQP-POOL|C_EnablePoolStake)> => \"{}\"" [
        (ref-TS02-C3::AQP-POOL|C_EnablePoolStake patron pool-id)
    ]))
    (print (format "<(TS02-C3.AQP-POOL|C_StakeSemiFungibleCollectable owner-a)> => \"{}\"" [
        (ref-TS02-C3::AQP-POOL|C_StakeSemiFungibleCollectable patron pool-id owner-a beneficiary-a dpsf-id [nonce-a])
    ]))
    (print (format "<(TS02-C3.AQP-POOL|C_StakeSemiFungibleCollectable owner-b)> => \"{}\"" [
        (ref-TS02-C3::AQP-POOL|C_StakeSemiFungibleCollectable patron pool-id owner-b beneficiary-b dpsf-id [nonce-b])
    ]))
    (let
        (
            (plan2:object (ref-VCT::URDC_BuildVacateSlicePlan pool-id dpsf-id vacate-kind-dpsf 2))
            (slice0:object (at 0 (at "slices" plan2)))
        )
        (print (format "<(TS02-C3.AQP-POOL|C_VacateSemiFungibleLegs batch0 no-finalize)> => \"{}\"" [
            (ref-TS02-C3::AQP-POOL|C_VacateSemiFungibleLegs
                patron pool-id dpsf-id
                (at "owner-ids" slice0)
                (at "beneficiary-ids" slice0)
                (at "nonces-array" slice0)
                (at "amounts-array" slice0)
                false
            )
        ]))
        (let
            (
                (vip:bool (ref-VCT::UR_VacateInProgress pool-id))
                (stake-off:bool (ref-AQP::UR_AQP|PoolStakeEnabled pool-id))
                (remaining:integer (at "leg-count" (ref-VCT::URD_VacateCollectableInventory pool-id dpsf-id true)))
            )
            (map print
                [
                    (expect (format "<<TX-VCT-L02 expect>> vacate begun got={} expected=true" [vip]) true vip)
                    (expect (format "<<TX-VCT-L02 expect>> stake disabled got={} expected=false" [stake-off]) false stake-off)
                    (expect (format "<<TX-VCT-L02 expect>> remaining legs after batch0 got={} expected=1" [remaining]) 1 remaining)
                ]
            )
        )
        (let
            (
                (plan1:object (ref-VCT::URDC_BuildVacateSlicePlan pool-id dpsf-id vacate-kind-dpsf 1))
                (slice0n:object (at 0 (at "slices" plan1)))
            )
            (print (format "<(TS02-C3.AQP-POOL|C_VacateSemiFungibleLegs finalize)> => \"{}\"" [
                (ref-TS02-C3::AQP-POOL|C_VacateSemiFungibleLegs
                    patron pool-id dpsf-id
                    (at "owner-ids" slice0n)
                    (at "beneficiary-ids" slice0n)
                    (at "nonces-array" slice0n)
                    (at "amounts-array" slice0n)
                    true
                )
            ]))
            (let
                (
                    (tracker-b-post:decimal (ref-AQP::UR_AQP|DPSFTrackerBalance pool-id dpsf-id owner-b beneficiary-b nonce-b))
                    (vacate-in-progress:bool (ref-VCT::UR_VacateInProgress pool-id))
                    (stake-enabled:bool (ref-AQP::UR_AQP|PoolStakeEnabled pool-id))
                )
                (map print
                    [
                        (expect (format "<<TX-VCT-L02 expect>> owner-b tracker cleared got={} expected=0" [tracker-b-post]) 0.0 tracker-b-post)
                        (expect (format "<<TX-VCT-L02 expect>> vacate-in-progress cleared got={} expected=false" [vacate-in-progress]) false vacate-in-progress)
                        (expect (format "<<TX-VCT-L02 expect>> stake re-enabled got={} expected=true" [stake-enabled]) true stake-enabled)
                    ]
                )
            )
        )
    )
)
(env-sigs [])
(commit-tx)
(print "=== END TX-VCT-L02 =========================================================")
(print "")
;;
(begin-tx "TX-VCT-L03 - C_AbortVacate mid Legs")
(print "")
(print "=== TX-VCT-L03 — Abort vacate-in-progress (stake stays disabled) ===========")
(namespace "ouronet-ns")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(let
    (
        (patron:string KST.ANHD)
        (owner-id:string KST.ANHD)
        (beneficiary-id:string KST.ANHD)
        (dpof-id:string "MVST-98c486052a51")
        (pool-name:string "OfStakePool")
        (vacate-kind-of:integer 2)
        (stake-nonce:integer 1)
        (ref-U|DALOS:module{UtilityDalosV1} U|DALOS)
        (ref-DPOF:module{DemiourgosPactOrtoFungibleV1} DPOF)
        (ref-TS01-C1:module{TalosStageOne_ClientOneV1} TS01-C1)
        (ref-TS02-C3:module{TalosStageTwo_ClientThreeV1} TS02-C3)
        (ref-AQP:module{AcquisitionPoolsV1} AQP-POOL)
        (ref-VCT:module{AcquisitionVacateV1} AQP-VCT)
        (pool-id:string (ref-U|DALOS::UDC_Makeid pool-name))
    )
    (env-sigs [{ "key": "PK_AncientHodler", "caps": [] }])
    (if (ref-DPOF::UR_R-Frozen dpof-id owner-id)
        (ref-TS01-C1::DPOF|C_ToggleFreezeAccount patron dpof-id owner-id false)
        true
    )
    (print (format "<(TS02-C3.AQP-POOL|C_EnablePoolStake)> => \"{}\"" [
        (ref-TS02-C3::AQP-POOL|C_EnablePoolStake patron pool-id)
    ]))
    (print (format "<(TS02-C3.AQP-POOL|C_StakeOrtoFungible)> => \"{}\"" [
        (ref-TS02-C3::AQP-POOL|C_StakeOrtoFungible patron pool-id owner-id beneficiary-id dpof-id [stake-nonce])
    ]))
    (let
        (
            (plan:object (ref-VCT::URDC_BuildVacateSlicePlan pool-id dpof-id vacate-kind-of 1))
            (slice0:object (at 0 (at "slices" plan)))
            (zero-amts:[[integer]] (ref-VCT::UC_ZeroIntAmountsMatrix (at "nonces-array" slice0)))
        )
        ;; Vacate inventory but leave vacate-in-progress open (finalize=false).
        (print (format "<(TS02-C3.AQP-POOL|C_VacateOrtoFungibleLegs no-finalize)> => \"{}\"" [
            (ref-TS02-C3::AQP-POOL|C_VacateOrtoFungibleLegs
                patron pool-id dpof-id
                (at "owner-ids" slice0)
                (at "beneficiary-ids" slice0)
                (at "nonces-array" slice0)
                zero-amts
                false
            )
        ]))
        (print (format "<(TS02-C3.AQP-POOL|C_AbortVacate)> => \"{}\"" [
            (ref-TS02-C3::AQP-POOL|C_AbortVacate patron pool-id)
        ]))
        (let
            (
                (vacate-in-progress:bool (ref-VCT::UR_VacateInProgress pool-id))
                (stake-enabled:bool (ref-AQP::UR_AQP|PoolStakeEnabled pool-id))
            )
            (map print
                [
                    (expect (format "<<TX-VCT-L03 expect>> vacate-in-progress cleared got={} expected=false" [vacate-in-progress]) false vacate-in-progress)
                    (expect (format "<<TX-VCT-L03 expect>> stake stays disabled got={} expected=false" [stake-enabled]) false stake-enabled)
                ]
            )
        )
    )
)
(env-sigs [])
(commit-tx)
(print "=== END TX-VCT-L03 =========================================================")
(print "")
