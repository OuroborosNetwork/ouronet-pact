;;
;; REPL/Stage_02/[6.2.5]_AQP-VCT.repl — comprehensive VCT vacate tests (all asset kinds + lifecycle)
;; Architecture: Full (1 tx) + Stateless Legs (N txs; auto-begin; finalize on last).
;; Loaded by REPL/VCT-comprehensive.repl / aqp-deploy-gate after [6.2]_AQP.repl.
;;
(print "")
(print "================================================================")
(print "FILE  REPL/Stage_02/[6.2.5]_AQP-VCT.repl")
(print "================================================================")
(print "Legend: <<TX-VCT-*>> expect lines; <(Talos…)> echoes; URHC_BuildVacateSlicePlan = offline split helper")
(print "DPNF tests mint probe NFTs via VacateDpnfProbe (AQP-FAST — no Populate* required).")
(print "")
;;
(begin-tx "TX-VCT-00 - deploy VacateDpnfProbe helpers")
(namespace "ouronet-ns")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(env-enable-repl-natives true)
(env-sigs
    [{"key": "1a4e15d3c51e0b73e92644600487ba8eaae312e1a178b91801d54e13c1b350a5", "caps": []}]
)
(module VacateDpnfProbe GOV
    (defcap GOV () true)
    (defun UC_MinDpnfNonceRow:object{DpdcUdcV1.DPDC|NonceData} (idx:integer)
        (let
            (
                (ref-DPDC-UDC:module{DpdcUdcV1} DPDC-UDC)
                (md:object{DpdcUdcV1.NonceMetaData} (ref-DPDC-UDC::UDC_NoMetaData))
                (i-asset-type:object{DpdcUdcV1.URI|Type}
                    (ref-DPDC-UDC::UDC_URI|Type true false false false false false false)
                )
                (zd:object{DpdcUdcV1.URI|Data} (ref-DPDC-UDC::UDC_ZeroURI|Data))
            )
            (ref-DPDC-UDC::UDC_NonceData
                0.0 0.0
                (format "VacateDpnfProbe{}" [idx])
                "vct-vacate-probe-dpnf"
                md i-asset-type zd zd zd
            )
        )
    )
    (defun UC_DpnfNonceRows:[object{DpdcUdcV1.DPDC|NonceData}] (count:integer)
        (map UC_MinDpnfNonceRow (enumerate 1 count))
    )
)
(env-sigs [])
(commit-tx)
(print "")
;;
(begin-tx "TX-VCT-TF01b - REHAUL: XB_VacateTrueFungible (pool-id only, on-chain scan)")
(print "")
(print "=== TX-VCT-TF01b — REHAUL TF vacate: input is JUST the pool-id (legs scanned on-chain) ===")
(namespace "ouronet-ns")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(env-sigs [{ "key": "PK_AncientHodler", "caps": [] }])
(let
    (
        (patron:string KST.ANHD)
        (owner-id:string KST.ANHD)
        (beneficiary-id:string KST.ANHD)
        (ouro-id:string "OURO-98c486052a51")
        (score-name:string "TfStakeScore")
        (pool-name:string "TfStakePool")
        (ref-U|DALOS:module{UtilityDalosV1} U|DALOS)
        (ref-DPTF:module{DemiourgosPactTrueFungibleV1} DPTF)
        (ref-TS02-C3:module{TalosStageTwo_ClientThreeV1} TS02-C3)
        (ref-AQP:module{AcquisitionPoolsV1} AQP-POOL)
        (ref-SCR:module{AcquisitionScoresV1} AQP-SCORE)
        (ref-VCT:module{AcquisitionVacateV1} AQP-VCT)
        (score-id:string (ref-U|DALOS::UDC_Makeid score-name))
        (pool-id:string (ref-U|DALOS::UDC_Makeid pool-name))
    )
    ;; re-stake 100 OURO so the rehaul path has inventory to scan + vacate
    (print (format "<(restake 100 for rehaul vacate)> => \"{}\""
        [(ref-TS02-C3::AQP-POOL|C_StakeTrueFungible patron pool-id owner-id beneficiary-id ouro-id 100.0)]))
    (let
        (
            (tracker-work:decimal (ref-AQP::UR_AQP|DPTFTrackerBalance pool-id ouro-id owner-id beneficiary-id))
            (pre-supply-work:decimal (ref-DPTF::UR_AccountSupply ouro-id owner-id))
        )
        (enforce (> tracker-work 0.0) "TX-VCT-TF01b: need TF stake inventory")
        (print (format "<(pre tracker/supply)> => {} / {}" [tracker-work pre-supply-work]))
        ;; THE REHAUL VACATE — pool-id ONLY; VCT scans the legs on-chain (no UI-supplied arrays)
        (print (format "<(AQP-POOL|XB_VacateTrueFungible pool-id-only)> => \"{}\""
            [(ref-TS02-C3::AQP-POOL|XB_VacateTrueFungible patron pool-id)]))
        (let
            (
                (tracker-post:decimal (ref-AQP::UR_AQP|DPTFTrackerBalance pool-id ouro-id owner-id beneficiary-id))
                (deb-user:decimal (ref-SCR::UR_U-SCR|UserScoreDebScore beneficiary-id pool-id score-id))
                (post-supply:decimal (ref-DPTF::UR_AccountSupply ouro-id owner-id))
                (inv-post:integer (at "leg-count" (ref-VCT::URH_VacateTfInventory pool-id ouro-id)))
            )
            (map print
                [
                    (format "<(post tracker/supply/inv)> => {} / {} / {}" [tracker-post post-supply inv-post])
                    (expect (format "<<TX-VCT-TF01b>> REHAUL tracker cleared got={}" [tracker-post]) 0.0 tracker-post)
                    (expect (format "<<TX-VCT-TF01b>> REHAUL deb-score cleared got={}" [deb-user]) 0.0 deb-user)
                    (expect (format "<<TX-VCT-TF01b>> REHAUL supply restored got={} exp={}" [post-supply (+ pre-supply-work tracker-work)]) (+ pre-supply-work tracker-work) post-supply)
                    (expect (format "<<TX-VCT-TF01b>> REHAUL vacate inventory empty got={}" [inv-post]) 0 inv-post)
                ]
            )
        )
    )
)
(env-sigs [])
(commit-tx)
(print "=== END TX-VCT-TF01b =======================================================")
(print "")
;;
(begin-tx "TX-VCT-CC01 - REHAUL: CC_FullVacate agnostic (class-1 pool, pool-id only)")
(print "")
(print "=== TX-VCT-CC01 — REHAUL agnostic full vacate: CC_FullVacate(pool-id) on class-1 ===")
(namespace "ouronet-ns")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(env-sigs [{ "key": "PK_AncientHodler", "caps": [] }])
(let
    (
        (patron:string KST.ANHD)
        (owner-id:string KST.ANHD)
        (beneficiary-id:string KST.ANHD)
        (ouro-id:string "OURO-98c486052a51")
        (pool-name:string "TfStakePool")
        (ref-U|DALOS:module{UtilityDalosV1} U|DALOS)
        (ref-TS02-C3:module{TalosStageTwo_ClientThreeV1} TS02-C3)
        (ref-AQP:module{AcquisitionPoolsV1} AQP-POOL)
        (ref-VCT:module{AcquisitionVacateV1} AQP-VCT)
        (pool-id:string (ref-U|DALOS::UDC_Makeid pool-name))
    )
    (enforce (= 1 (ref-AQP::UR_AQP|PoolAqpClass pool-id)) "TX-VCT-CC01: expected a class-1 pool")
    ;; re-stake 100 OURO so the agnostic dispatcher has native-TF inventory to scan + vacate
    (print (format "<(restake 100 for CC_FullVacate)> => \"{}\""
        [(ref-TS02-C3::AQP-POOL|C_StakeTrueFungible patron pool-id owner-id beneficiary-id ouro-id 100.0)]))
    (let
        (
            (tracker-pre:decimal (ref-AQP::UR_AQP|DPTFTrackerBalance pool-id ouro-id owner-id beneficiary-id))
        )
        (enforce (> tracker-pre 0.0) "TX-VCT-CC01: need TF stake inventory")
        (print (format "<(pre native-TF tracker)> => {}" [tracker-pre]))
        ;; THE AGNOSTIC REHAUL VACATE — JUST the pool-id; VCT reads aqp-class, dispatches the family branch,
        ;; vacates the native TF (satellites derived from asset-id). Real Z|-satellite drain proven by [6.4] CL05.
        (print (format "<(AQP-POOL|CC_FullVacate pool-id-only)> => \"{}\""
            [(ref-TS02-C3::AQP-POOL|CC_FullVacate patron pool-id)]))
        (let
            (
                (tracker-post:decimal (ref-AQP::UR_AQP|DPTFTrackerBalance pool-id ouro-id owner-id beneficiary-id))
                (inv-post:integer (at "leg-count" (ref-VCT::URH_VacateTfInventory pool-id ouro-id)))
            )
            (map print
                [
                    (format "<(post tracker/inv)> => {} / {}" [tracker-post inv-post])
                    (expect (format "<<TX-VCT-CC01>> CC_FullVacate native TF cleared got={}" [tracker-post]) 0.0 tracker-post)
                    (expect (format "<<TX-VCT-CC01>> CC_FullVacate TF inventory empty got={}" [inv-post]) 0 inv-post)
                ]
            )
        )
    )
)
(env-sigs [])
(commit-tx)
(print "=== END TX-VCT-CC01 ========================================================")
(print "")
;;
(begin-tx "TX-VCT-CC02 - REHAUL: CC_FullVacate empty-lane no-op (already-empty pool)")
(print "")
(print "=== TX-VCT-CC02 — empty-lane guard: CC_FullVacate on an ALREADY-EMPTY pool must no-op ===")
(namespace "ouronet-ns")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(env-sigs [{ "key": "PK_AncientHodler", "caps": [] }])
(let
    (
        (patron:string KST.ANHD)
        (pool-name:string "TfStakePool")
        (ref-U|DALOS:module{UtilityDalosV1} U|DALOS)
        (ref-TS02-C3:module{TalosStageTwo_ClientThreeV1} TS02-C3)
        (ref-AQP:module{AcquisitionPoolsV1} AQP-POOL)
        (pool-id:string (ref-U|DALOS::UDC_Makeid pool-name))
    )
    ;; CC01 already emptied TfStakePool → all TF + DPOF lanes are empty. Pre-fix, a full vacate over an empty
    ;; TF lane hit a 0.0 debit → UEV_Amount abort (finding #2). The empty-guard must make this a clean no-op.
    (let
        (
            (owner-id:string KST.ANHD)
            (ouro-id:string "OURO-98c486052a51")
            ;; native DPTF lane empty via point-read (lanes are asset-id-derived — no scan reader).
            (native-tf-bal:decimal (ref-AQP::UR_AQP|DPTFTrackerBalance pool-id ouro-id owner-id owner-id))
        )
        (map print
            [
                (expect (format "<<TX-VCT-CC02>> native TF lane empty got={}" [native-tf-bal]) 0.0 native-tf-bal)
            ]
        )
        ;; the proof: this call must SUCCEED (return a string), not abort on the empty native lane
        (print (format "<(AQP-POOL|CC_FullVacate on empty pool)> => \"{}\"" [
            (ref-TS02-C3::AQP-POOL|CC_FullVacate patron pool-id)
        ]))
    )
)
(env-sigs [])
(commit-tx)
(print "=== END TX-VCT-CC02 ========================================================")
(print "")
