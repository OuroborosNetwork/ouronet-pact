(begin-tx "TX-VCT-N02 - expect-failure double BeginVacate on same pool")
(print "")
(print "=== TX-VCT-N02 — Second BeginVacate while session open must fail =============")
(namespace "ouronet-ns")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(let
    (
        (patron:string KST.ANHD)
        (owner-id:string KST.ANHD)
        (beneficiary-id:string KST.ANHD)
        (ouro-id:string "OURO-98c486052a51")
        (pool-name:string "TfStakePool")
        (vacate-kind-tf:integer 1)
        (stake-amount:decimal 10.0)
        (ref-U|DALOS:module{UtilityDalosV1} U|DALOS)
        (ref-TS02-C3:module{TalosStageTwo_ClientThreeV1} TS02-C3)
        (ref-VCT:module{AcquisitionVacateV1} AQP-VCT)
        (pool-id:string (ref-U|DALOS::UDC_Makeid pool-name))
    )
    (env-sigs [{ "key": "PK_AncientHodler", "caps": [] }])
    (print (format "<(TS02-C3.AQP-POOL|C_EnablePoolStake)> => \"{}\"" [
        (ref-TS02-C3::AQP-POOL|C_EnablePoolStake patron pool-id)
    ]))
    (print (format "<(TS02-C3.AQP-POOL|C_StakeTrueFungible)> => \"{}\"" [
        (ref-TS02-C3::AQP-POOL|C_StakeTrueFungible patron pool-id owner-id beneficiary-id ouro-id stake-amount)
    ]))
    (print (format "<(TS02-C3.AQP-POOL|C_BeginVacate first)> => \"{}\"" [
        (ref-TS02-C3::AQP-POOL|C_BeginVacate patron pool-id ouro-id vacate-kind-tf 1)
    ]))
    (map print
        [
            (expect-failure
                (format "<<TX-VCT-N02 expect-failure>> second BeginVacate while session open" [])
                (ref-TS02-C3::AQP-POOL|C_BeginVacate patron pool-id ouro-id vacate-kind-tf 1)
            )
        ]
    )
    (let
        (
            (active-job:object (ref-VCT::URDC_ActiveJobForPool pool-id))
            (vacate-job-id:string (at "vacate-job-id" active-job))
        )
        (print (format "<(TS02-C3.AQP-POOL|C_AbortVacate cleanup)> => \"{}\"" [
            (ref-TS02-C3::AQP-POOL|C_AbortVacate patron vacate-job-id)
        ]))
    )
)
(env-sigs [])
(commit-tx)
(print "=== END TX-VCT-N02 ===========================================================")
