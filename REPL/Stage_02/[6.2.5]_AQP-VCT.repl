(print "=== TX-VCT-DPNF01 — DPNF full vacate (DHB mint probe) ======================")
(namespace "ouronet-ns")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(let
    (
        (patron:string KST.ANHD)
        (owner-id:string KST.ANHD)
        (beneficiary-id:string KST.ANHD)
        (source:string KST.EMMA)
        (dpnf-id:string "DHB-98c486052a51")
        (ouro-id:string "OURO-98c486052a51")
        (score-name:string "DhbVacateScore")
        (fvt-name:string "DhbVacateVault")
        (pool-name:string "DhbVacatePool")
        (ref-DALOS:module{OuronetDalosV1} DALOS)
        (ref-U|DALOS:module{UtilityDalosV1} U|DALOS)
        (ref-DPDC:module{DpdcV1} DPDC)
        (ref-TS02-C2:module{TalosStageTwo_ClientTwoV1} TS02-C2)
        (ref-TS02-C3:module{TalosStageTwo_ClientThreeV1} TS02-C3)
        (ref-AQP:module{AcquisitionPoolsV1} AQP-POOL)
