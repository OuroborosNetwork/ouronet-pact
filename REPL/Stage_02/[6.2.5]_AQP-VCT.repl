            (bal-c:decimal (ref-AQP::UR_AQP|DPTFTrackerBalance pool-id ouro-id owner-id ben-c))
            (vip:bool (ref-VCT::UR_VacateInProgress pool-id))
            (stake-enabled:bool (ref-AQP::UR_AQP|PoolStakeEnabled pool-id))
            (remaining:integer (at "leg-count" (ref-VCT::URH_VacateTfInventory pool-id ouro-id)))
        )
        (map print
