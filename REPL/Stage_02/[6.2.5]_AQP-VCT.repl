                        (expect (format "<<TX-VCT-DPNF02 expect>> tracker cleared got={} expected=0" [tracker-post]) 0.0 tracker-post)
                        (expect (format "<<TX-VCT-DPNF02 expect>> supply restored got={} expected={}" [post-supply pre-supply]) pre-supply post-supply)
                        (expect (format "<<TX-VCT-DPNF02 expect>> vacate-in-progress cleared got={} expected=false" [vacate-in-progress]) false vacate-in-progress)
                        (expect (format "<<TX-VCT-DPNF02 expect>> stake re-enabled got={} expected=true" [stake-enabled]) true stake-enabled)
                    ]
                )
            )
        )
    )
)
(env-sigs [])
