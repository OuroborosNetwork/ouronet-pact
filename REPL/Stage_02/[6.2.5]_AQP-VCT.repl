(begin-tx "TX-VCT-L02 - C_ResliceVacate after partial chunk")
(print "")
(print "=== TX-VCT-L02 — Reslice after slice 0 processed =========================")
(namespace "ouronet-ns")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(let
    (
        (patron:string KST.ANHD)
        (owner-a:string KST.ANHD)
        (owner-b:string KST.EMMA)
        (beneficiary-a:string KST.ANHD)
        (beneficiary-b:string KST.EMMA)
        (dpsf-id:string "DHCD-98c486052a51")
        (pool-name:string "SfStakePool")
        (vacate-kind-dpsf:integer 3)
        (nonce-a:integer 1)
        (nonce-b:integer 2)
        (ref-U|DALOS:module{UtilityDalosV1} U|DALOS)
        (ref-DPDC:module{DpdcV1} DPDC)
        (ref-TS02-C1:module{TalosStageTwo_ClientOneV2} TS02-C1)
        (ref-TS02-C3:module{TalosStageTwo_ClientThreeV1} TS02-C3)
        (ref-AQP:module{AcquisitionPoolsV1} AQP-POOL)
        (ref-VCT:module{AcquisitionVacateV1} AQP-VCT)
        (pool-id:string (ref-U|DALOS::UDC_Makeid pool-name))
    )
    (env-sigs
        [
            { "key": "PK_AncientHodler", "caps": [] }
            { "key": "PK_Emma", "caps": [] }
        ]
    )
    (let
        (
            (amt-b:integer (ref-DPDC::UR_AccountNonceSupply owner-a dpsf-id true nonce-b))
        )
        (if (> amt-b 0)
            (ref-TS02-C1::DPSF|C_TransferNonces patron dpsf-id owner-a owner-b [nonce-b] [amt-b] false)
            true
        )
    )
    (print (format "<(TS02-C3.AQP-POOL|C_EnablePoolStake)> => \"{}\"" [
        (ref-TS02-C3::AQP-POOL|C_EnablePoolStake patron pool-id)
    ]))
    (print (format "<(TS02-C3.AQP-POOL|C_StakeSemiFungibleCollectable owner-a)> => \"{}\"" [
        (ref-TS02-C3::AQP-POOL|C_StakeSemiFungibleCollectable patron pool-id owner-a beneficiary-a dpsf-id [nonce-a])
    ]))
    (print (format "<(TS02-C3.AQP-POOL|C_StakeSemiFungibleCollectable owner-b)> => \"{}\"" [
        (ref-TS02-C3::AQP-POOL|C_StakeSemiFungibleCollectable patron pool-id owner-b beneficiary-b dpsf-id [nonce-b])
    ]))
    (print (format "<(TS02-C3.AQP-POOL|C_BeginVacate slice-count 2)> => \"{}\"" [
        (ref-TS02-C3::AQP-POOL|C_BeginVacate patron pool-id dpsf-id vacate-kind-dpsf 2)
    ]))
    (let
        (
            (old-job:object (ref-VCT::URDC_ActiveJobForPool pool-id))
            (old-job-id:string (at "vacate-job-id" old-job))
            (plan2:object (ref-VCT::URDC_BuildVacateSlicePlan pool-id dpsf-id vacate-kind-dpsf 2))
            (slice0:object (at 0 (at "slices" plan2)))
        )
        (print (format "<(TS02-C3.AQP-POOL|C_VacateChunkCollectable slice 0)> => \"{}\"" [
            (ref-TS02-C3::AQP-POOL|C_VacateChunkCollectable
                patron old-job-id 0
                (at "owner-ids" slice0)
                (at "beneficiary-ids" slice0)
                (at "nonces-array" slice0)
                (at "amounts-array" slice0)
            )
        ]))
        (print (format "<(TS02-C3.AQP-POOL|C_ResliceVacate slice-count 1)> => \"{}\"" [
            (ref-TS02-C3::AQP-POOL|C_ResliceVacate patron old-job-id 1)
        ]))
        (let
            (
                (old-job-row:object (ref-VCT::UR_Job old-job-id))
                (new-job:object (ref-VCT::URDC_ActiveJobForPool pool-id))
                (new-job-id:string (at "vacate-job-id" new-job))
                (plan1:object (ref-VCT::URDC_BuildVacateSlicePlan pool-id dpsf-id vacate-kind-dpsf 1))
                (slice0n:object (at 0 (at "slices" plan1)))
            )
            (print (format "<(TS02-C3.AQP-POOL|C_VacateChunkCollectable new job slice 0)> => \"{}\"" [
                (ref-TS02-C3::AQP-POOL|C_VacateChunkCollectable
                    patron new-job-id 0
                    (at "owner-ids" slice0n)
                    (at "beneficiary-ids" slice0n)
                    (at "nonces-array" slice0n)
                    (at "amounts-array" slice0n)
                )
            ]))
            (let
                (
                    (tracker-b-post:decimal (ref-AQP::UR_AQP|DPSFTrackerBalance pool-id dpsf-id owner-b beneficiary-b nonce-b))
                    (new-job-row:object (ref-VCT::UR_Job new-job-id))
                )
                (map print
                    [
                        (expect (format "<<TX-VCT-L02 expect>> old job resliced got={} expected=true" [(at "resliced" old-job-row)]) true (at "resliced" old-job-row))
                        (expect (format "<<TX-VCT-L02 expect>> new job finalized got={} expected=true" [(at "finalized" new-job-row)]) true (at "finalized" new-job-row))
                        (expect (format "<<TX-VCT-L02 expect>> owner-b tracker cleared got={} expected=0" [tracker-b-post]) 0.0 tracker-b-post)
                    ]
                )
            )
        )
    )
)
(env-sigs [])
(commit-tx)
(print "=== END TX-VCT-L02 =========================================================")
(print "")
