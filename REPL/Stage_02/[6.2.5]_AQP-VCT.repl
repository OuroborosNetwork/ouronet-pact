(begin-tx "TX-VCT-N01 - expect-failure empty batch arrays rejected")
(print "")
(print "=== TX-VCT-N01 — empty batch arrays rejected (gas-ok requires l>0) ===========")
(namespace "ouronet-ns")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(let
    (
        (patron:string KST.ANHD)
        (owner-id:string KST.ANHD)
        (beneficiary-id:string KST.ANHD)
        (ouro-id:string "OURO-98c486052a51")
        (pool-name:string "TfStakePool")
        (vacate-kind-tf:integer 1)
        (stake-amount:decimal 25.0)
        (ref-U|DALOS:module{UtilityDalosV1} U|DALOS)
        (ref-TS02-C3:module{TalosStageTwo_ClientThreeV1} TS02-C3)
        (ref-VCT:module{AcquisitionVacateV1} AQP-VCT)
        (pool-id:string (ref-U|DALOS::UDC_Makeid pool-name))
    )
    (env-sigs [{ "key": "PK_AncientHodler", "caps": [] }])
    (print (format "<(TS02-C3.AQP-POOL|C_EnablePoolStake)> => \"{}\"" [
        (ref-TS02-C3::AQP-POOL|C_EnablePoolStake patron pool-id)
    ]))
    (print (format "<(TS02-C3.AQP-POOL|C_StakeTrueFungible)> => \"{}\"" [
        (ref-TS02-C3::AQP-POOL|C_StakeTrueFungible patron pool-id owner-id beneficiary-id ouro-id stake-amount)
    ]))
    (map print
        [
            (expect-failure
                (format "<<TX-VCT-N01 expect-failure>> empty batch arrays rejected (gas-ok requires l>0)" [])
                (ref-TS02-C3::AQP-POOL|CC_BatchVacateTrueFungible
                    patron pool-id ouro-id [] [] []
                )
            )
        ]
    )
    ;; Empty arrays fail batch validation (gas-ok requires l>0). The stake stays — clean up with
    ;; CC_FullVacate so later TfStakePool tests see empty inventory.
    (print (format "<(TS02-C3.AQP-POOL|CC_FullVacate cleanup)> => \"{}\"" [
        (ref-TS02-C3::AQP-POOL|CC_FullVacate patron pool-id)
    ]))
)
(env-sigs [])
(commit-tx)
(print "=== END TX-VCT-N01 ===========================================================")
(print "")
;;
(begin-tx "TX-VCT-N02 - expect-failure batch amount mismatch vs tracker")
(print "")
(print "=== TX-VCT-N02 — batch per-leg amount must match tracker (else rejected) ====")
(namespace "ouronet-ns")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(let
    (
        (patron:string KST.ANHD)
        (owner-id:string KST.ANHD)
        (beneficiary-id:string KST.ANHD)
        (ouro-id:string "OURO-98c486052a51")
        (pool-name:string "TfStakePool")
        (vacate-kind-tf:integer 1)
        (stake-amount:decimal 10.0)
        (ref-U|DALOS:module{UtilityDalosV1} U|DALOS)
        (ref-TS02-C3:module{TalosStageTwo_ClientThreeV1} TS02-C3)
        (ref-AQP:module{AcquisitionPoolsV1} AQP-POOL)
        (ref-VCT:module{AcquisitionVacateV1} AQP-VCT)
        (pool-id:string (ref-U|DALOS::UDC_Makeid pool-name))
    )
    (env-sigs [{ "key": "PK_AncientHodler", "caps": [] }])
    (print (format "<(TS02-C3.AQP-POOL|C_EnablePoolStake)> => \"{}\"" [
        (ref-TS02-C3::AQP-POOL|C_EnablePoolStake patron pool-id)
    ]))
    ;; Two stakes → two TF legs if different beneficiaries; same owner×ben collapses to one row.
    ;; Use amount-only: stake once, then try finalize with a zeroed amount batch that doesn't clear inventory.
    (print (format "<(TS02-C3.AQP-POOL|C_StakeTrueFungible)> => \"{}\"" [
        (ref-TS02-C3::AQP-POOL|C_StakeTrueFungible patron pool-id owner-id beneficiary-id ouro-id stake-amount)
    ]))
    (print (format "<(TS02-C3.AQP-POOL|C_StakeTrueFungible second)> => \"{}\"" [
        (ref-TS02-C3::AQP-POOL|C_StakeTrueFungible patron pool-id owner-id beneficiary-id ouro-id stake-amount)
    ]))
    (let
        (
            (bal:decimal (ref-AQP::UR_AQP|DPTFTrackerBalance pool-id ouro-id owner-id beneficiary-id))
            (half:decimal (/ bal 2.0))
        )
        ;; The UI-supplied per-leg amount must match the live tracker balance (URC_VacateTfLegBalancesOk).
        ;; A batch that claims a wrong amount ([1.0] vs the real staked total) is rejected by the LEGS cap.
        (map print
            [
                (expect-failure
                    (format "<<TX-VCT-N02 expect-failure>> batch amount mismatch vs tracker must fail" [])
                    (ref-TS02-C3::AQP-POOL|CC_BatchVacateTrueFungible
                        patron pool-id ouro-id [owner-id] [beneficiary-id] [1.0]
                    )
                )
            ]
        )
        (print (format "<(TS02-C3.AQP-POOL|CC_FullVacate cleanup)> => \"{}\"" [
            (ref-TS02-C3::AQP-POOL|CC_FullVacate patron pool-id)
        ]))
    )
)
(env-sigs [])
(commit-tx)
(print "=== END TX-VCT-N02 ===========================================================")
(print "")
;;
(begin-tx "TX-VCT-P01 - offline plan helpers (URD + URDC + UC)")
(print "")
(print "=== TX-VCT-P01 — UI offline plan smoke (no vacate writes) ==================")
(namespace "ouronet-ns")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(let
    (
        (patron:string KST.ANHD)
        (owner-id:string KST.ANHD)
        (beneficiary-id:string KST.ANHD)
        (ouro-id:string "OURO-98c486052a51")
        (pool-name:string "TfStakePool")
        (vacate-kind-tf:integer 1)
        (stake-amount:decimal 12.0)
        (ref-U|DALOS:module{UtilityDalosV1} U|DALOS)
        (ref-TS02-C3:module{TalosStageTwo_ClientThreeV1} TS02-C3)
        (ref-VCT:module{AcquisitionVacateV1} AQP-VCT)
        (pool-id:string (ref-U|DALOS::UDC_Makeid pool-name))
    )
    (env-sigs [{ "key": "PK_AncientHodler", "caps": [] }])
    (print (format "<(TS02-C3.AQP-POOL|C_EnablePoolStake)> => \"{}\"" [
        (ref-TS02-C3::AQP-POOL|C_EnablePoolStake patron pool-id)
    ]))
    (print (format "<(TS02-C3.AQP-POOL|C_StakeTrueFungible)> => \"{}\"" [
        (ref-TS02-C3::AQP-POOL|C_StakeTrueFungible patron pool-id owner-id beneficiary-id ouro-id stake-amount)
    ]))
    (let
        (
            (inv:object (ref-VCT::URH_VacateTfInventory pool-id ouro-id))
            (units:integer (ref-VCT::URHC_VacateUnitCountForKind pool-id ouro-id vacate-kind-tf))
            (min-n:integer (ref-VCT::UC_ComputeMinSliceCount units vacate-kind-tf))
            (plan:object (ref-VCT::URHC_BuildVacateSlicePlan pool-id ouro-id vacate-kind-tf min-n))
        )
        (map print
            [
                (expect (format "<<TX-VCT-P01 expect>> leg-count>0 got={}" [(at "leg-count" inv)]) true (> (at "leg-count" inv) 0))
                (expect (format "<<TX-VCT-P01 expect>> units=leg-count got={} expected={}" [units (at "leg-count" inv)]) (at "leg-count" inv) units)
                (expect (format "<<TX-VCT-P01 expect>> min-slice-count>=1 got={}" [min-n]) true (>= min-n 1))
                (expect (format "<<TX-VCT-P01 expect>> plan.slice-count=min-n got={} expected={}" [(at "slice-count" plan) min-n]) min-n (at "slice-count" plan))
                (expect (format "<<TX-VCT-P01 expect>> plan.slices length got={}" [(length (at "slices" plan))]) min-n (length (at "slices" plan)))
                (expect (format "<<TX-VCT-P01 expect>> vacate still idle got={}" [(ref-VCT::UR_VacateInProgress pool-id)]) false (ref-VCT::UR_VacateInProgress pool-id))
            ]
        )
    )
    (print (format "<(TS02-C3.AQP-POOL|CC_FullVacate cleanup)> => \"{}\"" [
        (ref-TS02-C3::AQP-POOL|CC_FullVacate patron pool-id)
    ]))
)
(env-sigs [])
(commit-tx)
(print "=== END TX-VCT-P01 ===========================================================")
(print "")
