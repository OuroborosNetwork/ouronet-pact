(begin-tx "TX-VCT-RESUME-B - RE-INITIATE round 2, tx 1 of 2 (continue from frozen state)")
(print "")
(print "=== TX-VCT-RESUME-B — Round 2 tx1: UI re-reads remaining, drains EMMA; STILL frozen ==")
(namespace "ouronet-ns")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(env-sigs [{ "key": "PK_AncientHodler", "caps": [] }])
(let
    (
        (patron:string KST.ANHD)
        (owner-id:string KST.ANHD)
        (ben-b:string KST.EMMA)
        (ben-c:string KST.LUMY)
        (ouro-id:string "OURO-98c486052a51")
        (pool-name:string "ResumeVacPool")
        (amt:decimal 20.0)
        (ref-U|DALOS:module{UtilityDalosV1} U|DALOS)
        (ref-TS02-C3:module{TalosStageTwo_ClientThreeV1} TS02-C3)
        (ref-AQP:module{AcquisitionPoolsV1} AQP-POOL)
        (ref-VCT:module{AcquisitionVacateV1} AQP-VCT)
        (pool-id:string (ref-U|DALOS::UDC_Makeid pool-name))
    )
    ;; UI re-reads the remaining inventory (2 legs) and constructs a fresh round.
    (let ((remaining-pre:integer (at "leg-count" (ref-VCT::URH_VacateTfInventory pool-id ouro-id))))
        (enforce (= remaining-pre 2) "TX-VCT-RESUME-B: expected 2 legs left from the failed round")
        (print "--- [TX-VCT-RESUME-B · 01 · new-round batch continues the SAME frozen campaign] ---")
        ;; This batch's XI_EnsureVacateBegun sees vacate-in-progress already true → no-op (continue).
        (ref-TS02-C3::AQP-POOL|CC_BatchVacateTrueFungible patron pool-id ouro-id [owner-id] [ben-b] [amt])
        (let
            (
                (bal-b:decimal (ref-AQP::UR_AQP|DPTFTrackerBalance pool-id ouro-id owner-id ben-b))
                (bal-c:decimal (ref-AQP::UR_AQP|DPTFTrackerBalance pool-id ouro-id owner-id ben-c))
                (vip:bool (ref-VCT::UR_VacateInProgress pool-id))
                (stake-enabled:bool (ref-AQP::UR_AQP|PoolStakeEnabled pool-id))
                (remaining:integer (at "leg-count" (ref-VCT::URH_VacateTfInventory pool-id ouro-id)))
            )
            (map print
                [
                    (expect (format "<<TX-VCT-RESUME-B>> EMMA leg drained got={}" [bal-b]) 0.0 bal-b)
                    (expect (format "<<TX-VCT-RESUME-B>> LUMY leg STILL staked got={}" [bal-c]) amt bal-c)
                    (expect (format "<<TX-VCT-RESUME-B>> campaign STILL frozen (1 leg left) got={}" [vip]) true vip)
                    (expect (format "<<TX-VCT-RESUME-B>> stake STILL disabled got={}" [stake-enabled]) false stake-enabled)
                    (expect (format "<<TX-VCT-RESUME-B>> 1 leg remains got={}" [remaining]) 1 remaining)
                ]
            )
        )
    )
)
(env-sigs [])
(commit-tx)
(print "=== END TX-VCT-RESUME-B =====================================================")
(print "")
