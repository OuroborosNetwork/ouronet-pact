(begin-tx "TX-VCT-N03 - finalize=true with leftover inventory (UI-trust semantics)")
(print "")
(print "=== TX-VCT-N03 — partial Legs + finalize=true SUCCEEDS (UI must not do this) =")
(namespace "ouronet-ns")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(let
    (
        (patron:string KST.ANHD)
        (owner-a:string KST.ANHD)
        (owner-b:string KST.EMMA)
        (beneficiary-a:string KST.ANHD)
        (beneficiary-b:string KST.EMMA)
        (ouro-id:string "OURO-98c486052a51")
        (pool-name:string "TfStakePool")
        (vacate-kind-tf:integer 1)
        (stake-amount:decimal 7.0)
        (ref-U|DALOS:module{UtilityDalosV1} U|DALOS)
        (ref-TS02-C3:module{TalosStageTwo_ClientThreeV1} TS02-C3)
        (ref-AQP:module{AcquisitionPoolsV1} AQP-POOL)
        (ref-VCT:module{AcquisitionVacateV1} AQP-VCT)
        (ref-DPTF:module{DemiourgosPactTrueFungibleV1} DPTF)
        (ref-TS01-C1:module{TalosStageOne_ClientOneV1} TS01-C1)
        (pool-id:string (ref-U|DALOS::UDC_Makeid pool-name))
    )
    (env-sigs [{ "key": "PK_AncientHodler", "caps": [] }])
    (let
        (
            (emma-bal:decimal (ref-DPTF::UR_AccountSupply ouro-id owner-b))
        )
        (if (< emma-bal stake-amount)
            (ref-TS01-C1::DPTF|C_Transfer patron ouro-id owner-a owner-b stake-amount true)
            true
        )
    )
    (print (format "<(TS02-C3.AQP-POOL|C_EnablePoolStake)> => \"{}\"" [
        (ref-TS02-C3::AQP-POOL|C_EnablePoolStake patron pool-id)
    ]))
    (print (format "<(TS02-C3.AQP-POOL|C_StakeTrueFungible owner-a)> => \"{}\"" [
        (ref-TS02-C3::AQP-POOL|C_StakeTrueFungible patron pool-id owner-a beneficiary-a ouro-id stake-amount)
    ]))
    (env-sigs
        [
            { "key": "PK_AncientHodler", "caps": [] }
            { "key": "PK_Emma", "caps": [] }
        ]
    )
    (print (format "<(TS02-C3.AQP-POOL|C_StakeTrueFungible owner-b)> => \"{}\"" [
        (ref-TS02-C3::AQP-POOL|C_StakeTrueFungible patron pool-id owner-b beneficiary-b ouro-id stake-amount)
    ]))
    (env-sigs [{ "key": "PK_AncientHodler", "caps": [] }])
    (let
        (
            (plan2:object (ref-VCT::URDC_BuildVacateSlicePlan pool-id ouro-id vacate-kind-tf 2))
            (slice0:object (at 0 (at "slices" plan2)))
        )
        ;; Finalize on first slice only, but leftover inventory remains. Post-fix (audit H3 / #6) the on-chain
        ;; guard HONOURS finalize only when the pool is truly empty — so vacate STAYS in progress and stake
        ;; STAYS disabled here (previously the chain trusted the UI and wrongly cleared/re-enabled).
        (print (format "<(TS02-C3.AQP-POOL|C_VacateTrueFungibleLegs finalize-early)> => \"{}\"" [
            (ref-TS02-C3::AQP-POOL|C_VacateTrueFungibleLegs
                patron pool-id ouro-id
                (at "owner-ids" slice0)
                (at "beneficiary-ids" slice0)
                (at "amounts" slice0)
                true
            )
        ]))
        (let
            (
                (remaining:integer (at "leg-count" (ref-VCT::URD_VacateTfInventory pool-id ouro-id)))
                (vacate-in-progress:bool (ref-VCT::UR_VacateInProgress pool-id))
                (stake-enabled:bool (ref-AQP::UR_AQP|PoolStakeEnabled pool-id))
            )
            (map print
                [
                    (expect (format "<<TX-VCT-N03 expect>> leftover inventory got={} expected=1" [remaining]) 1 remaining)
                    (expect (format "<<TX-VCT-N03 expect>> vacate STAYS in progress with leftover (H3/#6) got={}" [vacate-in-progress]) true vacate-in-progress)
                    (expect (format "<<TX-VCT-N03 expect>> stake STAYS disabled with leftover (H3/#6) got={}" [stake-enabled]) false stake-enabled)
                ]
            )
        )
        (let
            (
                (plan:object (ref-VCT::URDC_BuildVacateSlicePlan pool-id ouro-id 1 1))
                (s0:object (at 0 (at "slices" plan)))
            )
            (print (format "<(TS02-C3.AQP-POOL|C_FullVacateTrueFungible cleanup)> => \"{}\"" [
                (ref-TS02-C3::AQP-POOL|C_FullVacateTrueFungible
                    patron pool-id ouro-id
                    (at "owner-ids" s0)
                    (at "beneficiary-ids" s0)
                    (at "amounts" s0)
                )
            ]))
        )
    )
)
(env-sigs [])
(commit-tx)
(print "=== END TX-VCT-N03 ===========================================================")
(print "")
;;
(begin-tx "TX-VCT-L06 - OF Legs multi-batch two owners")
(print "")
(print "=== TX-VCT-L06 — OF Legs: 2 owners → N=2 finalize=false then finalize =====")
(namespace "ouronet-ns")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(let
    (
        (patron:string KST.ANHD)
        (owner-a:string KST.ANHD)
        (owner-b:string KST.EMMA)
        (beneficiary-a:string KST.ANHD)
        (beneficiary-b:string KST.EMMA)
        (dpof-id:string "MVST-98c486052a51")
        (pool-name:string "OfStakePool")
        (vacate-kind-of:integer 2)
        (nonce-a:integer 1)
        (ref-U|DALOS:module{UtilityDalosV1} U|DALOS)
        (ref-DPOF:module{DemiourgosPactOrtoFungibleV1} DPOF)
        (ref-TS01-C1:module{TalosStageOne_ClientOneV1} TS01-C1)
        (ref-TS02-C3:module{TalosStageTwo_ClientThreeV1} TS02-C3)
        (ref-AQP:module{AcquisitionPoolsV1} AQP-POOL)
        (ref-VCT:module{AcquisitionVacateV1} AQP-VCT)
        (pool-id:string (ref-U|DALOS::UDC_Makeid pool-name))
    )
    (env-sigs
        [
            { "key": "PK_AncientHodler", "caps": [] }
            { "key": "PK_Emma", "caps": [] }
        ]
    )
    (if (ref-DPOF::UR_R-Frozen dpof-id owner-a)
        (ref-TS01-C1::DPOF|C_ToggleFreezeAccount patron dpof-id owner-a false)
        true
    )
    (if (ref-DPOF::UR_R-Frozen dpof-id owner-b)
        (ref-TS01-C1::DPOF|C_ToggleFreezeAccount patron dpof-id owner-b false)
        true
    )
    (if (not (ref-DPOF::UR_R-AddQuantity dpof-id patron))
        (ref-TS01-C1::DPOF|C_ToggleAddQuantityRole patron dpof-id patron true)
        true
    )
    (print (format "<(TS02-C3.AQP-POOL|C_EnablePoolStake)> => \"{}\"" [
        (ref-TS02-C3::AQP-POOL|C_EnablePoolStake patron pool-id)
    ]))
    ;; Owner-a: existing nonce-a. Owner-b: mint → transfer → stake (2 owner-rows for N=2).
    (print (format "<(TS02-C3.AQP-POOL|C_StakeOrtoFungible owner-a)> => \"{}\"" [
        (ref-TS02-C3::AQP-POOL|C_StakeOrtoFungible patron pool-id owner-a beneficiary-a dpof-id [nonce-a])
    ]))
    (print (format "<(DPOF|C_Mint L06 emma)> => \"{}\"" [
        (ref-TS01-C1::DPOF|C_Mint patron dpof-id patron 1.0 [{"vct-l06": true}])
    ]))
    (let
        (
            (patron-nonces:[integer] (ref-DPOF::URD_AccountNonces patron dpof-id))
            (nonce-b:integer (at (- (length patron-nonces) 1) patron-nonces))
        )
        (print (format "<(DPOF|C_Transfer nonce-b={} → EMMA)> => \"{}\"" [
            nonce-b
            (ref-TS01-C1::DPOF|C_Transfer patron dpof-id [nonce-b] patron owner-b true)
        ]))
        (print (format "<(TS02-C3.AQP-POOL|C_StakeOrtoFungible owner-b)> => \"{}\"" [
            (ref-TS02-C3::AQP-POOL|C_StakeOrtoFungible patron pool-id owner-b beneficiary-b dpof-id [nonce-b])
        ]))
    )
    (let
        (
            (plan2:object (ref-VCT::URDC_BuildVacateSlicePlan pool-id dpof-id vacate-kind-of 2))
        )
        (enforce (= 2 (at "slice-count" plan2)) "TX-VCT-L06: expected 2 slices")
        (let
            (
                (slice0:object (at 0 (at "slices" plan2)))
                (slice1:object (at 1 (at "slices" plan2)))
                (z0:[[integer]] (ref-VCT::UC_ZeroIntAmountsMatrix (at "nonces-array" (at 0 (at "slices" plan2)))))
                (z1:[[integer]] (ref-VCT::UC_ZeroIntAmountsMatrix (at "nonces-array" (at 1 (at "slices" plan2)))))
            )
            (enforce (= 1 (length (at "owner-ids" slice0))) "TX-VCT-L06: slice0 owner-count")
            (enforce (= 1 (length (at "owner-ids" slice1))) "TX-VCT-L06: slice1 owner-count")
            (print (format "<(TS02-C3.AQP-POOL|C_VacateOrtoFungibleLegs batch0)> => \"{}\"" [
                (ref-TS02-C3::AQP-POOL|C_VacateOrtoFungibleLegs
                    patron pool-id dpof-id
                    (at "owner-ids" slice0)
                    (at "beneficiary-ids" slice0)
                    (at "nonces-array" slice0)
                    z0
                    false
                )
            ]))
            (let
                (
                    (vip:bool (ref-VCT::UR_VacateInProgress pool-id))
                    (remaining:integer (at "leg-count" (ref-VCT::URD_VacateOfInventory pool-id dpof-id)))
                )
                (map print
                    [
                        (expect (format "<<TX-VCT-L06 expect>> vacate begun got={}" [vip]) true vip)
                        (expect (format "<<TX-VCT-L06 expect>> remaining after batch0 got={} expected=1" [remaining]) 1 remaining)
                    ]
                )
            )
            (print (format "<(TS02-C3.AQP-POOL|C_VacateOrtoFungibleLegs finalize)> => \"{}\"" [
                (ref-TS02-C3::AQP-POOL|C_VacateOrtoFungibleLegs
                    patron pool-id dpof-id
                    (at "owner-ids" slice1)
                    (at "beneficiary-ids" slice1)
                    (at "nonces-array" slice1)
                    z1
                    true
                )
            ]))
            (let
                (
                    (inv-post:integer (at "leg-count" (ref-VCT::URD_VacateOfInventory pool-id dpof-id)))
                    (vacate-in-progress:bool (ref-VCT::UR_VacateInProgress pool-id))
                    (stake-enabled:bool (ref-AQP::UR_AQP|PoolStakeEnabled pool-id))
                )
                (map print
                    [
                        (expect (format "<<TX-VCT-L06 expect>> inventory empty got={}" [inv-post]) 0 inv-post)
                        (expect (format "<<TX-VCT-L06 expect>> vacate cleared got={}" [vacate-in-progress]) false vacate-in-progress)
                        (expect (format "<<TX-VCT-L06 expect>> stake re-enabled got={}" [stake-enabled]) true stake-enabled)
                    ]
                )
            )
        )
    )
)
(env-sigs [])
(commit-tx)
(print "=== END TX-VCT-L06 =========================================================")
(print "")
(print "=== END FILE [6.2.5]_AQP-VCT.repl ============================================")
