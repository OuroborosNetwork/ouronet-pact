(begin-tx "TX-VCT-L05 - TF Legs multi-batch two owners")
(print "")
(print "=== TX-VCT-L05 — TF Legs: 2 owners → N=2 finalize=false then finalize =====")
(namespace "ouronet-ns")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(let
    (
        (patron:string KST.ANHD)
        (owner-a:string KST.ANHD)
        (owner-b:string KST.EMMA)
        (beneficiary-a:string KST.ANHD)
        (beneficiary-b:string KST.EMMA)
        (ouro-id:string "OURO-98c486052a51")
        (pool-name:string "TfStakePool")
        (vacate-kind-tf:integer 1)
        (stake-amount:decimal 8.0)
        (ref-U|DALOS:module{UtilityDalosV1} U|DALOS)
        (ref-TS02-C3:module{TalosStageTwo_ClientThreeV1} TS02-C3)
        (ref-AQP:module{AcquisitionPoolsV1} AQP-POOL)
        (ref-VCT:module{AcquisitionVacateV1} AQP-VCT)
        (ref-DPTF:module{DemiourgosPactTrueFungibleV1} DPTF)
        (ref-TS01-C1:module{TalosStageOne_ClientOneV1} TS01-C1)
        (pool-id:string (ref-U|DALOS::UDC_Makeid pool-name))
    )
    (env-sigs [{ "key": "PK_AncientHodler", "caps": [] }])
    ;; Fund EMMA if needed (gate/Z usually leaves her with OURO; top-up from ANHD otherwise).
    (let
        (
            (emma-bal:decimal (ref-DPTF::UR_AccountSupply ouro-id owner-b))
        )
        (if (< emma-bal stake-amount)
            (ref-TS01-C1::DPTF|C_Transfer patron ouro-id owner-a owner-b stake-amount true)
            true
        )
    )
    (print (format "<(TS02-C3.AQP-POOL|C_EnablePoolStake)> => \"{}\"" [
        (ref-TS02-C3::AQP-POOL|C_EnablePoolStake patron pool-id)
    ]))
    (print (format "<(TS02-C3.AQP-POOL|C_StakeTrueFungible owner-a)> => \"{}\"" [
        (ref-TS02-C3::AQP-POOL|C_StakeTrueFungible patron pool-id owner-a beneficiary-a ouro-id stake-amount)
    ]))
    ;; Patron IGNIS + EMMA owner: both keys (same pattern as TX-VCT-L02).
    (env-sigs
        [
            { "key": "PK_AncientHodler", "caps": [] }
            { "key": "PK_Emma", "caps": [] }
        ]
    )
    (print (format "<(TS02-C3.AQP-POOL|C_StakeTrueFungible owner-b)> => \"{}\"" [
        (ref-TS02-C3::AQP-POOL|C_StakeTrueFungible patron pool-id owner-b beneficiary-b ouro-id stake-amount)
    ]))
    (env-sigs [{ "key": "PK_AncientHodler", "caps": [] }])
    (let
        (
            (plan2:object (ref-VCT::URHC_BuildVacateSlicePlan pool-id ouro-id vacate-kind-tf 2))
            (slice0:object (at 0 (at "slices" plan2)))
            (slice1:object (at 1 (at "slices" plan2)))
        )
        (enforce (= 2 (at "slice-count" plan2)) "TX-VCT-L05: expected 2 slices")
        (print (format "<(TS02-C3.AQP-POOL|CC_BatchVacateTrueFungible batch0 partial)> => \"{}\"" [
            (ref-TS02-C3::AQP-POOL|CC_BatchVacateTrueFungible
                patron pool-id ouro-id
                (at "owner-ids" slice0)
                (at "beneficiary-ids" slice0)
                (at "amounts" slice0)
            )
        ]))
        (let
            (
                (vip:bool (ref-VCT::UR_VacateInProgress pool-id))
                (remaining:integer (at "leg-count" (ref-VCT::URH_VacateTfInventory pool-id ouro-id)))
            )
            (map print
                [
                    (expect (format "<<TX-VCT-L05 expect>> vacate begun got={}" [vip]) true vip)
                    (expect (format "<<TX-VCT-L05 expect>> remaining after batch0 got={} expected=1" [remaining]) 1 remaining)
                ]
            )
        )
        (print (format "<(TS02-C3.AQP-POOL|CC_BatchVacateTrueFungible batch1 drains → auto-finalize)> => \"{}\"" [
            (ref-TS02-C3::AQP-POOL|CC_BatchVacateTrueFungible
                patron pool-id ouro-id
                (at "owner-ids" slice1)
                (at "beneficiary-ids" slice1)
                (at "amounts" slice1)
            )
        ]))
        (let
            (
                (inv-post:integer (at "leg-count" (ref-VCT::URH_VacateTfInventory pool-id ouro-id)))
                (vacate-in-progress:bool (ref-VCT::UR_VacateInProgress pool-id))
                (stake-enabled:bool (ref-AQP::UR_AQP|PoolStakeEnabled pool-id))
            )
            (map print
                [
                    (expect (format "<<TX-VCT-L05 expect>> inventory empty got={}" [inv-post]) 0 inv-post)
                    (expect (format "<<TX-VCT-L05 expect>> vacate cleared got={}" [vacate-in-progress]) false vacate-in-progress)
                    (expect (format "<<TX-VCT-L05 expect>> stake re-enabled got={}" [stake-enabled]) true stake-enabled)
                ]
            )
        )
    )
)
(env-sigs [])
(commit-tx)
(print "=== END TX-VCT-L05 =========================================================")
(print "")
