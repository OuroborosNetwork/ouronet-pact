                (expect (format "<<TX-VCT-P01 expect>> plan.slices length got={}" [(length (at "slices" plan))]) min-n (length (at "slices" plan)))
                (expect (format "<<TX-VCT-P01 expect>> vacate still idle got={}" [(ref-VCT::UR_VacateInProgress pool-id)]) false (ref-VCT::UR_VacateInProgress pool-id))
            ]
        )
    )
