(begin-tx "TX-VCT-L01b - REHAUL: XB_VacateOrtoFungible (pool-id + dpof only, on-chain scan)")
(print "")
(print "=== TX-VCT-L01b — REHAUL OF vacate: pool-id + dpof only (legs scanned on-chain) ===")
(namespace "ouronet-ns")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(env-sigs [{ "key": "PK_AncientHodler", "caps": [] }])
(let
    (
        (patron:string KST.ANHD)
        (owner-id:string KST.ANHD)
        (beneficiary-id:string KST.ANHD)
        (dpof-id:string "MVST-98c486052a51")
        (pool-name:string "OfStakePool")
        (stake-nonce:integer 1)
        (ref-U|DALOS:module{UtilityDalosV1} U|DALOS)
        (ref-DPOF:module{DemiourgosPactOrtoFungibleV1} DPOF)
        (ref-TS01-C1:module{TalosStageOne_ClientOneV1} TS01-C1)
        (ref-TS02-C3:module{TalosStageTwo_ClientThreeV1} TS02-C3)
        (ref-AQP:module{AcquisitionPoolsV1} AQP-POOL)
        (pool-id:string (ref-U|DALOS::UDC_Makeid pool-name))
    )
    ;; re-enable stake + re-stake the OF nonce so the rehaul path has inventory to scan
    (if (ref-DPOF::UR_R-Frozen dpof-id owner-id)
        (ref-TS01-C1::DPOF|C_ToggleFreezeAccount patron dpof-id owner-id false) true)
    (ref-TS02-C3::AQP-POOL|C_EnablePoolStake patron pool-id)
    (print (format "<(restake OF nonce {})> => \"{}\"" [stake-nonce
        (ref-TS02-C3::AQP-POOL|C_StakeOrtoFungible patron pool-id owner-id beneficiary-id dpof-id [stake-nonce])]))
    (let ((tracker-pre:decimal (ref-AQP::UR_AQP|DPOFTrackerBalance pool-id dpof-id owner-id beneficiary-id stake-nonce)))
        (enforce (> tracker-pre 0.0) "TX-VCT-L01b: need OF stake inventory")
        (print (format "<(pre OF tracker)> => {}" [tracker-pre]))
        ;; THE REHAUL VACATE — pool-id + dpof only; VCT scans + resolves amounts on-chain
        (print (format "<(AQP-POOL|XB_VacateOrtoFungible)> => \"{}\""
            [(ref-TS02-C3::AQP-POOL|XB_VacateOrtoFungible patron pool-id dpof-id)]))
        (let ((tracker-post:decimal (ref-AQP::UR_AQP|DPOFTrackerBalance pool-id dpof-id owner-id beneficiary-id stake-nonce)))
            (map print
                [
                    (format "<(post OF tracker)> => {}" [tracker-post])
                    (expect (format "<<TX-VCT-L01b>> REHAUL OF tracker cleared got={}" [tracker-post]) 0.0 tracker-post)
                ]
            )
        )
    )
)
(env-sigs [])
(commit-tx)
(print "=== END TX-VCT-L01b ========================================================")
(print "")
;;
(begin-tx "TX-VCT-L02 - DPSF Legs partial then continue finalize")
(print "")
(print "=== TX-VCT-L02 — DPSF Legs: batch0 finalize=false → re-plan → finalize =====")
(namespace "ouronet-ns")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(let
    (
        (patron:string KST.ANHD)
        (owner-a:string KST.ANHD)
        (owner-b:string KST.EMMA)
        (beneficiary-a:string KST.ANHD)
        (beneficiary-b:string KST.EMMA)
        (dpsf-id:string "DHCD-98c486052a51")
        (pool-name:string "SfStakePool")
        (vacate-kind-dpsf:integer 3)
        (nonce-a:integer 1)
        (nonce-b:integer 2)
        (ref-U|DALOS:module{UtilityDalosV1} U|DALOS)
        (ref-DPDC:module{DpdcV1} DPDC)
        (ref-TS02-C1:module{TalosStageTwo_ClientOneV2} TS02-C1)
        (ref-TS02-C3:module{TalosStageTwo_ClientThreeV1} TS02-C3)
        (ref-AQP:module{AcquisitionPoolsV1} AQP-POOL)
        (ref-VCT:module{AcquisitionVacateV1} AQP-VCT)
        (pool-id:string (ref-U|DALOS::UDC_Makeid pool-name))
    )
    (env-sigs
        [
            { "key": "PK_AncientHodler", "caps": [] }
            { "key": "PK_Emma", "caps": [] }
        ]
    )
    (let
        (
            (amt-b:integer (ref-DPDC::UR_AccountNonceSupply owner-a dpsf-id true nonce-b))
        )
        (if (> amt-b 0)
            (ref-TS02-C1::DPSF|C_TransferNonces patron dpsf-id owner-a owner-b [nonce-b] [amt-b] false)
            true
        )
    )
    (print (format "<(TS02-C3.AQP-POOL|C_EnablePoolStake)> => \"{}\"" [
        (ref-TS02-C3::AQP-POOL|C_EnablePoolStake patron pool-id)
    ]))
    (print (format "<(TS02-C3.AQP-POOL|C_StakeSemiFungibleCollectable owner-a)> => \"{}\"" [
        (ref-TS02-C3::AQP-POOL|C_StakeSemiFungibleCollectable patron pool-id owner-a beneficiary-a dpsf-id [nonce-a])
    ]))
    (print (format "<(TS02-C3.AQP-POOL|C_StakeSemiFungibleCollectable owner-b)> => \"{}\"" [
        (ref-TS02-C3::AQP-POOL|C_StakeSemiFungibleCollectable patron pool-id owner-b beneficiary-b dpsf-id [nonce-b])
    ]))
    (let
        (
            (plan2:object (ref-VCT::URHC_BuildVacateSlicePlan pool-id dpsf-id vacate-kind-dpsf 2))
            (slice0:object (at 0 (at "slices" plan2)))
        )
        (print (format "<(TS02-C3.AQP-POOL|CC_BatchVacateCollectables batch0 partial)> => \"{}\"" [
            (ref-TS02-C3::AQP-POOL|CC_BatchVacateCollectables
                patron pool-id dpsf-id true
                (at "owner-ids" slice0)
                (at "beneficiary-ids" slice0)
                (at "nonces-array" slice0)
                (at "amounts-array" slice0)
            )
        ]))
        (let
            (
                (vip:bool (ref-VCT::UR_VacateInProgress pool-id))
                (stake-off:bool (ref-AQP::UR_AQP|PoolStakeEnabled pool-id))
                (remaining:integer (at "leg-count" (ref-VCT::URH_VacateCollectableInventory pool-id dpsf-id true)))
            )
            (map print
                [
                    (expect (format "<<TX-VCT-L02 expect>> vacate begun got={} expected=true" [vip]) true vip)
                    (expect (format "<<TX-VCT-L02 expect>> stake disabled got={} expected=false" [stake-off]) false stake-off)
                    (expect (format "<<TX-VCT-L02 expect>> remaining legs after batch0 got={} expected=1" [remaining]) 1 remaining)
                ]
            )
        )
        (let
            (
                (plan1:object (ref-VCT::URHC_BuildVacateSlicePlan pool-id dpsf-id vacate-kind-dpsf 1))
                (slice0n:object (at 0 (at "slices" plan1)))
            )
            (print (format "<(TS02-C3.AQP-POOL|CC_BatchVacateCollectables batch1 drains → auto-finalize)> => \"{}\"" [
                (ref-TS02-C3::AQP-POOL|CC_BatchVacateCollectables
                    patron pool-id dpsf-id true
                    (at "owner-ids" slice0n)
                    (at "beneficiary-ids" slice0n)
                    (at "nonces-array" slice0n)
                    (at "amounts-array" slice0n)
                )
            ]))
            (let
                (
                    (tracker-b-post:decimal (ref-AQP::UR_AQP|DPSFTrackerBalance pool-id dpsf-id owner-b beneficiary-b nonce-b))
                    (vacate-in-progress:bool (ref-VCT::UR_VacateInProgress pool-id))
                    (stake-enabled:bool (ref-AQP::UR_AQP|PoolStakeEnabled pool-id))
                )
                (map print
                    [
                        (expect (format "<<TX-VCT-L02 expect>> owner-b tracker cleared got={} expected=0" [tracker-b-post]) 0.0 tracker-b-post)
                        (expect (format "<<TX-VCT-L02 expect>> vacate-in-progress cleared got={} expected=false" [vacate-in-progress]) false vacate-in-progress)
                        (expect (format "<<TX-VCT-L02 expect>> stake re-enabled got={} expected=true" [stake-enabled]) true stake-enabled)
                    ]
                )
            )
        )
    )
)
(env-sigs [])
(commit-tx)
(print "=== END TX-VCT-L02 =========================================================")
(print "")
;;
(begin-tx "TX-VCT-L02b - REHAUL: XB_VacateSemiFungible (pool-id + dpsf only, on-chain scan)")
(print "")
(print "=== TX-VCT-L02b — REHAUL DPSF vacate: pool-id + dpsf only (whole collection) ===")
(namespace "ouronet-ns")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(let
    (
        (patron:string KST.ANHD)
        (owner-a:string KST.ANHD)
        (owner-b:string KST.EMMA)
        (beneficiary-a:string KST.ANHD)
        (beneficiary-b:string KST.EMMA)
        (dpsf-id:string "DHCD-98c486052a51")
        (pool-name:string "SfStakePool")
        (nonce-a:integer 1)
        (nonce-b:integer 2)
        (ref-U|DALOS:module{UtilityDalosV1} U|DALOS)
        (ref-TS02-C3:module{TalosStageTwo_ClientThreeV1} TS02-C3)
        (ref-AQP:module{AcquisitionPoolsV1} AQP-POOL)
        (ref-VCT:module{AcquisitionVacateV1} AQP-VCT)
        (pool-id:string (ref-U|DALOS::UDC_Makeid pool-name))
    )
    (env-sigs
        [
            { "key": "PK_AncientHodler", "caps": [] }
            { "key": "PK_Emma", "caps": [] }
        ]
    )
    ;; re-enable stake + re-stake both owners' nonces so the rehaul path has a full collection to scan
    (ref-TS02-C3::AQP-POOL|C_EnablePoolStake patron pool-id)
    (print (format "<(restake SF owner-a)> => \"{}\""
        [(ref-TS02-C3::AQP-POOL|C_StakeSemiFungibleCollectable patron pool-id owner-a beneficiary-a dpsf-id [nonce-a])]))
    (print (format "<(restake SF owner-b)> => \"{}\""
        [(ref-TS02-C3::AQP-POOL|C_StakeSemiFungibleCollectable patron pool-id owner-b beneficiary-b dpsf-id [nonce-b])]))
    (let ((legs-pre:integer (at "leg-count" (ref-VCT::URH_VacateCollectableInventory pool-id dpsf-id true))))
        (enforce (> legs-pre 0) "TX-VCT-L02b: need SF stake inventory")
        (print (format "<(pre SF legs)> => {}" [legs-pre]))
        ;; THE REHAUL VACATE — pool-id + dpsf only; whole collection scanned + amounts read on-chain
        (print (format "<(AQP-POOL|XB_VacateSemiFungible)> => \"{}\""
            [(ref-TS02-C3::AQP-POOL|XB_VacateSemiFungible patron pool-id dpsf-id)]))
        (let
            (
                (tracker-a:decimal (ref-AQP::UR_AQP|DPSFTrackerBalance pool-id dpsf-id owner-a beneficiary-a nonce-a))
                (tracker-b:decimal (ref-AQP::UR_AQP|DPSFTrackerBalance pool-id dpsf-id owner-b beneficiary-b nonce-b))
                (legs-post:integer (at "leg-count" (ref-VCT::URH_VacateCollectableInventory pool-id dpsf-id true)))
            )
            (map print
                [
                    (expect (format "<<TX-VCT-L02b>> owner-a SF tracker cleared got={}" [tracker-a]) 0.0 tracker-a)
                    (expect (format "<<TX-VCT-L02b>> owner-b SF tracker cleared got={}" [tracker-b]) 0.0 tracker-b)
                    (expect (format "<<TX-VCT-L02b>> SF inventory emptied got={}" [legs-post]) 0 legs-post)
                ]
            )
        )
    )
)
(env-sigs [])
(commit-tx)
(print "=== END TX-VCT-L02b ========================================================")
(print "")
;;
(begin-tx "TX-VCT-L03 - C_AbortVacate mid batch (partial → abort)")
(print "")
(print "=== TX-VCT-L03 — Abort a vacate campaign mid-batch (stake stays disabled) ===")
(namespace "ouronet-ns")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(let
    (
        (patron:string KST.ANHD)
        (owner-a:string KST.ANHD)
        (owner-b:string KST.EMMA)
        (beneficiary-a:string KST.ANHD)
        (beneficiary-b:string KST.EMMA)
        (dpsf-id:string "DHCD-98c486052a51")
        (pool-name:string "SfStakePool")
        (vacate-kind-dpsf:integer 3)
        (nonce-a:integer 1)
        (nonce-b:integer 2)
        (ref-U|DALOS:module{UtilityDalosV1} U|DALOS)
        (ref-TS02-C3:module{TalosStageTwo_ClientThreeV1} TS02-C3)
        (ref-AQP:module{AcquisitionPoolsV1} AQP-POOL)
        (ref-VCT:module{AcquisitionVacateV1} AQP-VCT)
        (pool-id:string (ref-U|DALOS::UDC_Makeid pool-name))
    )
    (env-sigs
        [
            { "key": "PK_AncientHodler", "caps": [] }
            { "key": "PK_Emma", "caps": [] }
        ]
    )
    ;; SfStakePool is empty + stake-enabled after L02b. Re-stake two owner legs (ANHD n1 + EMMA n2) so a
    ;; PARTIAL batch can open a vacate campaign without draining the pool — the leftover leg keeps it open.
    (ref-TS02-C3::AQP-POOL|C_EnablePoolStake patron pool-id)
    (print (format "<(restake SF owner-a)> => \"{}\""
        [(ref-TS02-C3::AQP-POOL|C_StakeSemiFungibleCollectable patron pool-id owner-a beneficiary-a dpsf-id [nonce-a])]))
    (print (format "<(restake SF owner-b)> => \"{}\""
        [(ref-TS02-C3::AQP-POOL|C_StakeSemiFungibleCollectable patron pool-id owner-b beneficiary-b dpsf-id [nonce-b])]))
    (let
        (
            (plan:object (ref-VCT::URHC_BuildVacateSlicePlan pool-id dpsf-id vacate-kind-dpsf 2))
            (slice0:object (at 0 (at "slices" plan)))
        )
        (enforce (= 2 (at "slice-count" plan)) "TX-VCT-L03: expected 2 slices")
        ;; PARTIAL batch: drain slice0 only. VIP opens (freeze); auto-finalize does NOT fire (leftover leg).
        (print (format "<(TS02-C3.AQP-POOL|CC_BatchVacateCollectables partial slice0)> => \"{}\"" [
            (ref-TS02-C3::AQP-POOL|CC_BatchVacateCollectables
                patron pool-id dpsf-id true
                (at "owner-ids" slice0)
                (at "beneficiary-ids" slice0)
                (at "nonces-array" slice0)
                (at "amounts-array" slice0)
            )
        ]))
        (let
            (
                (vip-mid:bool (ref-VCT::UR_VacateInProgress pool-id))
                (remaining:integer (at "leg-count" (ref-VCT::URH_VacateCollectableInventory pool-id dpsf-id true)))
            )
            (map print
                [
                    (expect (format "<<TX-VCT-L03 expect>> vacate begun by partial batch got={} expected=true" [vip-mid]) true vip-mid)
                    (expect (format "<<TX-VCT-L03 expect>> leftover leg after partial got={} expected=1" [remaining]) 1 remaining)
                ]
            )
        )
        ;; Abort the campaign: VIP clears, but stake STAYS disabled (ops must re-enable — see L04).
        (print (format "<(TS02-C3.AQP-POOL|C_AbortVacate)> => \"{}\"" [
            (ref-TS02-C3::AQP-POOL|C_AbortVacate patron pool-id)
        ]))
        (let
            (
                (vacate-in-progress:bool (ref-VCT::UR_VacateInProgress pool-id))
                (stake-enabled:bool (ref-AQP::UR_AQP|PoolStakeEnabled pool-id))
            )
            (map print
                [
                    (expect (format "<<TX-VCT-L03 expect>> vacate-in-progress cleared got={} expected=false" [vacate-in-progress]) false vacate-in-progress)
                    (expect (format "<<TX-VCT-L03 expect>> stake stays disabled got={} expected=false" [stake-enabled]) false stake-enabled)
                ]
            )
        )
    )
)
(env-sigs [])
(commit-tx)
(print "=== END TX-VCT-L03 =========================================================")
(print "")
