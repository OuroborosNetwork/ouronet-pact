;;
;; REPL/Stage_02/[6.4]_AQP-TRIPLET-COLLECT.repl — farm triplet MULTIPLET_BASE inject/collect
;; Requires: AQP-BOOT Steps 7–11 (OuroLpFarm + triplet ScoreEntityLink + OURO reward).
;;
(print "")
(print "================================================================")
(print "FILE  REPL/Stage_02/[6.4]_AQP-TRIPLET-COLLECT.repl")
(print "================================================================")
(print "")
;;
(begin-tx "TX-AQP-CL03 - Farm triplet MULTIPLET_BASE OURO collect")
(print "")
(print "=== TX-AQP-CL03 — OuroLpFarm: triplet Tier-2 + MULTIPLET_BASE OURO collect =========")
(namespace "ouronet-ns")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
;;==== TX-AQP-CL03 - Farm triplet MULTIPLET_BASE OURO collect · 01 · let / invocation ==== ========
(print "--- [TX-AQP-CL03 - Farm triplet MULTIPLET_BASE OURO collect · 01 · let / invocation] ---")
(let
    (
        (patron:string KST.ANHD)
        (owner:string KST.ANHD)
        (emma:string KST.EMMA)
        (ouro-id:string "OURO-98c486052a51")
        (kbn-id:string "KBN-98c486052a51")
        (auryn-rain-nonce:integer 75)
        (ref-U|DALOS:module{UtilityDalosV2} U|DALOS)
        (ref-DALOS:module{OuronetDalosV2} DALOS)
        (ref-DPDC:module{DpdcV2} DPDC)
        (ref-ANK:module{AcquisitionAnchorsV1} AQP-ANK)
        (ref-SWP:module{SwapperV4} SWP)
        (ref-DPTF:module{DemiourgosPactTrueFungibleV2} DPTF)
        (ref-TS01-C3:module{TalosStageOne_ClientThreeV4} TS01-C3)
        (ref-TS02-C2:module{TalosStageTwo_ClientTwoV2} TS02-C2)
        (ref-TS02-C3:module{TalosStageTwo_ClientThreeV2} TS02-C3)
        (ref-SCR:module{AcquisitionScoresV2} AQP-SCORE)
        (ref-FVT:module{AcquisitionFarmsVaultsTreasuriesV1} AQP-FVT)
        (ref-AQP:module{AcquisitionPoolsV1} AQP-POOL)
        (pool-id:string (ref-U|DALOS::UDC_Makeid "DHOuroLp"))
        (bunnies-pool:string (ref-U|DALOS::UDC_Makeid "DHBunnies"))
        (silver-score:string (ref-U|DALOS::UDC_Makeid "SilverSnakePower"))
        (bronze-score:string (ref-U|DALOS::UDC_Makeid "BronzeSnakePower"))
        (golden-score:string (ref-U|DALOS::UDC_Makeid "GoldenSnakePower"))
        (triplet-id:string (concat ["T" "|" bronze-score "|" silver-score "|" golden-score]))
        (auryn-id:string (ref-DALOS::UR_AurynID))
        (elite-auryn-id:string (ref-DALOS::UR_EliteAurynID))
        (farm-id:string (ref-U|DALOS::UDC_Makeid "OuroLpFarm"))
        (swpair:string "W|DLK-98c486052a51|OURO-98c486052a51|DWK-98c486052a51")
        (lp-id:string (ref-SWP::UR_TokenLP swpair))
        (inject-amt:decimal 100.0)
        (farm-class:integer (try -1 (ref-FVT::UR_FVT|FvtClass farm-id)))
        (pool-class:integer (try -1 (ref-AQP::UR_AQP|PoolAqpClass pool-id)))
        (lp-bal:decimal (ref-DPTF::UR_AccountSupply lp-id owner))
    )
    (env-sigs
        [
            { "key": "PK_AncientHodler", "caps": [] }
            { "key": "PK_Emma", "caps": [] }
            { "key": "PK_Lumy", "caps": [] }
        ]
    )
    (if (and (= farm-class 0) (>= pool-class 0))
        (let
            (
                (lp-bal-work:decimal lp-bal)
            )
            (if (< lp-bal-work 100.0)
                (let
                    (
                        (stoa-pre:decimal (ref-SWP::UR_StoaValue swpair))
                    )
                    (print (format "<(seed LP: StoaValue pre)> => \"{}\" lp-bal={}" [stoa-pre lp-bal-work]))
                    (print (format "<(SWP|C_AddLiquidity seed)> => \"{}\"" [
                        (ref-TS01-C3::SWP|C_AddLiquidity patron patron swpair [50.0 50.0 50.0])
                    ]))
                    (print (format "<(post-seed lp-bal)> => \"{}\"" [(ref-DPTF::UR_AccountSupply lp-id owner)]))
                )
                true
            )
            (let
                (
                    (lp-bal-final:decimal (ref-DPTF::UR_AccountSupply lp-id owner))
                    (stake-amt:decimal
                        (if (> lp-bal-final 100.0) 100.0 lp-bal-final)
                    )
                )
                (enforce (>= lp-bal-final stake-amt) "CL03: patron needs LP balance after seed")
                (let
                    (
                        (anhd-kbn:[integer] (ref-DPDC::URH_AccountNonces owner kbn-id false))
                        (prom-pre:decimal (ref-ANK::UR_UB|AggregatePromile owner silver-score))
                    )
                    (if (= prom-pre 0.0)
                        (let
                            (
                                (emma-kbn:[integer] (ref-DPDC::URH_AccountNonces emma kbn-id false))
                            )
                            (if (not (contains auryn-rain-nonce anhd-kbn))
                                (enforce (contains auryn-rain-nonce emma-kbn) "CL03: EMMA must hold Auryn Rain KBN nonce 75")
                                true
                            )
                            (if (not (contains auryn-rain-nonce anhd-kbn))
                                (print (format "<(DPNF transfer AurynRain nonce {} EMMA→ANHD)> => \"{}\"" [auryn-rain-nonce
                                    (ref-TS02-C2::DPNF|C_TransferNonce patron emma owner kbn-id auryn-rain-nonce 1 false)
                                ]))
                                true
                            )
                            (print (format "<(C_StakeNonFungible DHBunnies KBN nonce {})> => \"{}\"" [auryn-rain-nonce
                                (ref-TS02-C3::AQP-POOL|CC_StakeNonFungibleCollectable
                                    patron owner owner bunnies-pool kbn-id [auryn-rain-nonce]
                                )
                            ]))
                        )
                        true
                    )
                    (let
                        (
                            (prom-post:decimal (ref-ANK::UR_UB|AggregatePromile owner silver-score))
                        )
                        (print (format "<(SilverSnakePower promile ANHD)> => \"{}\"" [prom-post]))
                        (enforce (> prom-post 0.0) "CL03 needs SilverSnakePower promile — Auryn Rain KBN stake on DHBunnies")
                    )
                )
                (print (format "<(CC_StakeTrueFungible DHOuroLp LP {})> => \"{}\"" [stake-amt
                    (ref-TS02-C3::AQP-POOL|CC_StakeTrueFungible patron owner owner pool-id lp-id stake-amt)
                ]))
                (let
                    (
                        (deb:decimal (ref-SCR::UR_U-SCR|UserScoreDebScore owner pool-id silver-score))
                        (base-s:decimal (ref-SCR::UR_U-SCR|UserScoreBaseScore owner pool-id silver-score))
                        (boosted-s:decimal (ref-SCR::UR_U-SCR|UserScoreBoostedScore owner pool-id silver-score))
                        (base-deb-s:decimal (ref-SCR::UR_U-SCR|UserScoreBaseDebScore owner pool-id silver-score))
                        (boosted-deb-s:decimal (ref-SCR::UR_U-SCR|UserScoreBoostedDebScore owner pool-id silver-score))
                        (entity-weight:decimal (ref-FVT::URC_ScoreEntityUserWeight owner farm-id pool-id 3 triplet-id))
                        (denom:decimal (ref-FVT::URC_InjectDenominator farm-id))
                        (ghost-s:decimal (ref-FVT::UR_FVT|TotalGhostTvlWeight farm-id))
                        (w-i:decimal (ref-FVT::UR_FVT-SEL|GhostTvlWeight farm-id triplet-id))
                    )
                    (map print
                        [
                            (format "<(SilverSnakePower deb)> => \"{}\"" [deb])
                            (format "<(triplet entity-weight)> => \"{}\"" [entity-weight])
                            (format "<(farm S W_i denom)> => \"{} {} {}\"" [ghost-s w-i denom])
                        ]
                    )
                    (expect (format "<<TX-AQP-CL03>> LP deb>0 got={}" [deb]) true (> deb 0.0))
                    ;; M3: boost is additive — boosted-score is the boost PART, and deb-score = (base+boost)×deb,
                    ;; so the base is NEVER dropped ⇒ deb-score ≥ base + boosted. (Pre-M3 deb-score = boost part only,
                    ;; which is < base+boosted, so this assertion fails before the fix and passes after.)
                    (map print
                        [
                            (format "<(M3 silver base/boosted/deb)> => \"{} {} {}\"" [base-s boosted-s deb])
                            (format "<(M3 silver base-deb/boosted-deb)> => \"{} {}\"" [base-deb-s boosted-deb-s])
                            (expect (format "<<TX-AQP-CL03>> M3 deb-score includes base: deb({}) >= base({})+boost({})"
                                [deb base-s boosted-s])
                                true
                                (>= deb (- (+ base-s boosted-s) 0.000001)))
                            ;; M3 5-field decomposition: base-deb + boosted-deb == deb-score exactly.
                            (expect (format "<<TX-AQP-CL03>> M3 decomposition sums: base-deb({})+boosted-deb({})==deb({})"
                                [base-deb-s boosted-deb-s deb])
                                deb
                                (+ base-deb-s boosted-deb-s))
                        ]
                    )
                    (expect (format "<<TX-AQP-CL03>> entity-weight>0 got={}" [entity-weight]) true (> entity-weight 0.0))
                    (expect (format "<<TX-AQP-CL03>> farm ghost S>0 got={}" [ghost-s]) true (> ghost-s 0.0))
                    (expect (format "<<TX-AQP-CL03>> inject denom>0 got={}" [denom]) true (> denom 0.0))
                    (print (format "<(C_Inject OURO farm {})> => \"{}\"" [inject-amt
                        (ref-TS02-C3::AQP-FVT|CC_Inject patron patron farm-id ouro-id inject-amt)
                    ]))
                    (let
                        (
                            (g-post:decimal (ref-FVT::UR_FVT-RG|CurrentRps farm-id ouro-id))
                            (li-pre:decimal (ref-FVT::UR_FVT-RM|MemberDebRps farm-id triplet-id ouro-id))
                            (claimable:decimal (ref-FVT::URC_CollectClaimableRewards owner pool-id farm-id 3 triplet-id ouro-id))
                            (ouro-pre:decimal (ref-DPTF::UR_AccountSupply ouro-id owner))
                            (auryn-pre:decimal (ref-DPTF::UR_AccountSupply auryn-id owner))
                            (elite-pre:decimal (ref-DPTF::UR_AccountSupply elite-auryn-id owner))
                        )
                        (print (format "<(pre-collect G L_i claimable)> => \"{} {} {}\"" [g-post li-pre claimable]))
                        ;; Split-at-inject (audit LP redesign / Stage 2): farms no longer bump the global G
                        ;; (it stays 0); the injection is split into each member's Tier-1 index L_i (member-deb-rps).
                        (map print
                          [
                            (expect (format "<<TX-AQP-CL03>> farm G stays 0 (split-at-inject) got={}" [g-post]) 0.0 g-post)
                            (expect (format "<<TX-AQP-CL03>> member L_i advanced by inject got={}" [li-pre]) true (> li-pre 0.0))
                          ])
                        (print (format "<(CC_Collect farm triplet OURO)> => \"{}\"" [
                            (ref-TS02-C3::AQP-FVT|CC_Collect owner owner farm-id 3 triplet-id ouro-id)
                        ]))
                        (let
                            (
                                (ouro-post:decimal (ref-DPTF::UR_AccountSupply ouro-id owner))
                                (auryn-post:decimal (ref-DPTF::UR_AccountSupply auryn-id owner))
                                (elite-post:decimal (ref-DPTF::UR_AccountSupply elite-auryn-id owner))
                                (payout-ouro:decimal (- ouro-post ouro-pre))
                                (payout-auryn:decimal (- auryn-post auryn-pre))
                                (payout-elite:decimal (- elite-post elite-pre))
                                (payout-total:decimal (+ payout-ouro (+ payout-auryn payout-elite)))
                                (li-post:decimal (ref-FVT::UR_FVT-RM|MemberDebRps farm-id triplet-id ouro-id))
                                (last-rps:decimal (ref-FVT::UR_FVT-RU|LastRps owner farm-id triplet-id ouro-id))
                                (g-i:decimal (ref-FVT::UR_FVT-RM|LastFarmRpsG farm-id triplet-id ouro-id))
                            )
                            (map print
                                [
                                    (format "<(lane payouts ouro/auryn/elite)> => \"{} {} {}\"" [payout-ouro payout-auryn payout-elite])
                                    (format "<(post-collect G g_i L_i last-rps)> => \"{} {} {} {}\"" [g-post g-i li-post last-rps])
                                    (expect (format "<<TX-AQP-CL03>> multiplet payout>0 got={}" [payout-total]) true (> payout-total 0.0))
                                    (expect (format "<<TX-AQP-CL03>> L_i>0 got={}" [li-post]) true (> li-post 0.0))
                                    (expect (format "<<TX-AQP-CL03>> last-rps==L_i got={} expected={}" [last-rps li-post]) li-post last-rps)
                                    (expect (format "<<TX-AQP-CL03>> g_i==G got={} expected={}" [g-i g-post]) g-post g-i)
                                ]
                            )
                        )
                    )
                )
            )
        )
        (print (format "SKIP TX-AQP-CL03: OuroLpFarm/DHOuroLp not provisioned (farm-class={} pool-class={})" [farm-class pool-class]))
    )
)
(env-sigs [])
(commit-tx)
(print "")
;;||>>>>>>>>>>>>>>>>>>>>>>>>>
;;|| NEXT                   >
;;||>>>>>>>>>>>>>>>>>>>>>>>>>
(print "")
;;
;; TX-AQP-CL04 — Multi-staker farm fairness: EMMA joins LP stake → inject → both collect by W_user
(begin-tx "TX-AQP-CL04 - Farm multi-staker inject/collect fairness")
(print "")
(print "=== TX-AQP-CL04 — OuroLpFarm: two stakers share inject by W_user =============")
(namespace "ouronet-ns")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
;;==== TX-AQP-CL04 - Farm multi-staker inject/collect fairness · 01 · let / invocation ==== =======
(print "--- [TX-AQP-CL04 - Farm multi-staker inject/collect fairness · 01 · let / invocation] ---")
(let
    (
        (patron:string KST.ANHD)
        (anhd:string KST.ANHD)
        (emma:string KST.EMMA)
        (ouro-id:string "OURO-98c486052a51")
        (inject-amt:decimal 100.0)
        (stake-e:decimal 40.0)
        (ref-U|DALOS:module{UtilityDalosV2} U|DALOS)
        (ref-DALOS:module{OuronetDalosV2} DALOS)
        (ref-SWP:module{SwapperV4} SWP)
        (ref-DPTF:module{DemiourgosPactTrueFungibleV2} DPTF)
        (ref-TS01-C1:module{TalosStageOne_ClientOneV2} TS01-C1)
        (ref-TS01-C3:module{TalosStageOne_ClientThreeV4} TS01-C3)
        (ref-TS02-C3:module{TalosStageTwo_ClientThreeV2} TS02-C3)
        (ref-FVT:module{AcquisitionFarmsVaultsTreasuriesV1} AQP-FVT)
        (ref-AQP:module{AcquisitionPoolsV1} AQP-POOL)
        (pool-id:string (ref-U|DALOS::UDC_Makeid "DHOuroLp"))
        (silver-score:string (ref-U|DALOS::UDC_Makeid "SilverSnakePower"))
        (bronze-score:string (ref-U|DALOS::UDC_Makeid "BronzeSnakePower"))
        (golden-score:string (ref-U|DALOS::UDC_Makeid "GoldenSnakePower"))
        (triplet-id:string (concat ["T" "|" bronze-score "|" silver-score "|" golden-score]))
        (auryn-id:string (ref-DALOS::UR_AurynID))
        (elite-auryn-id:string (ref-DALOS::UR_EliteAurynID))
        (farm-id:string (ref-U|DALOS::UDC_Makeid "OuroLpFarm"))
        (swpair:string "W|DLK-98c486052a51|OURO-98c486052a51|DWK-98c486052a51")
        (lp-id:string (ref-SWP::UR_TokenLP swpair))
        (farm-class:integer (try -1 (ref-FVT::UR_FVT|FvtClass farm-id)))
        (pool-class:integer (try -1 (ref-AQP::UR_AQP|PoolAqpClass pool-id)))
    )
    (env-sigs
        [
            { "key": "PK_AncientHodler", "caps": [] }
            { "key": "PK_Emma", "caps": [] }
            { "key": "PK_Lumy", "caps": [] }
        ]
    )
    (if (and (= farm-class 0) (>= pool-class 0))
        (let
            (
                (ref-DPDC:module{DpdcV2} DPDC)
                (ref-ANK:module{AcquisitionAnchorsV1} AQP-ANK)
                (kbn-id:string "KBN-98c486052a51")
                (bunnies-pool:string (ref-U|DALOS::UDC_Makeid "DHBunnies"))
                (bronze-bc:string (ref-U|DALOS::UDC_Makeid "BronzeSnakePower"))
                (silver-bc:string (ref-U|DALOS::UDC_Makeid "SilverSnakePower"))
                (golden-bc:string (ref-U|DALOS::UDC_Makeid "GoldenSnakePower"))
                (emma-kbn:[integer] (ref-DPDC::URH_AccountNonces emma kbn-id false))
                (bunny-nonce:integer 85)
                (lp-anhd:decimal (ref-DPTF::UR_AccountSupply lp-id anhd))
                (lp-emma:decimal (ref-DPTF::UR_AccountSupply lp-id emma))
            )
            ;; #9 (H4) revoke-lock armed: the triplet's boost-classes are score-linked, so ANK has bumped
            ;; their score-link-count > 0 → any anchor in them is now revoke-locked (proves the SCORE→ANK wiring).
            (let
                (
                    (slc-b:integer (ref-ANK::UR_BC|ScoreLinkCount bronze-bc))
                    (slc-s:integer (ref-ANK::UR_BC|ScoreLinkCount silver-bc))
                    (slc-g:integer (ref-ANK::UR_BC|ScoreLinkCount golden-bc))
                )
                (map print
                    [
                        (format "<(#9 revoke-lock: BoostClass score-link-count B/S/G)> => \"{} {} {}\"" [slc-b slc-s slc-g])
                        (expect "<<TX-AQP-CL04>> #9 lock armed — triplet boost-classes are score-linked (Σ count>0)"
                            true (> (+ slc-b (+ slc-s slc-g)) 0))
                    ]
                )
            )
            (print "--- [TX-AQP-CL04 · 01 · EMMA AurynRain bunny stake (promile → W_user)] ---")
            (enforce (contains bunny-nonce emma-kbn) "CL04: EMMA needs Auryn Rain KBN nonce 85 from PopulateBunnies")
            (print (format "<(C_StakeNonFungible DHBunnies EMMA nonce {})> => \"{}\"" [bunny-nonce
                (ref-TS02-C3::AQP-POOL|CC_StakeNonFungibleCollectable
                    patron emma emma bunnies-pool kbn-id [bunny-nonce]
                )
            ]))
            (let
                (
                    (prom-b:decimal (ref-ANK::UR_UB|AggregatePromile emma bronze-bc))
                    (prom-s:decimal (ref-ANK::UR_UB|AggregatePromile emma silver-bc))
                    (prom-g:decimal (ref-ANK::UR_UB|AggregatePromile emma golden-bc))
                    (prom-sum:decimal (+ prom-b (+ prom-s prom-g)))
                )
                (print (format "<(EMMA promile B/S/G)> => \"{} {} {}\"" [prom-b prom-s prom-g]))
                (enforce (> prom-sum 0.0) "CL04: EMMA bunny must hit Bronze/Silver/Golden SnakePower promile")
            )
            (print "--- [TX-AQP-CL04 · 02 · fund EMMA LP + stake] ---")
            (if (< lp-emma stake-e)
                (let
                    (
                        (need:decimal (- stake-e lp-emma))
                    )
                    (if (< lp-anhd need)
                        (print (format "<(SWP|C_AddLiquidity seed for EMMA)> => \"{}\"" [
                            (ref-TS01-C3::SWP|C_AddLiquidity patron patron swpair [30.0 30.0 30.0])
                        ]))
                        true
                    )
                    (let
                        (
                            (lp-anhd2:decimal (ref-DPTF::UR_AccountSupply lp-id anhd))
                            (xfer:decimal (if (> lp-anhd2 need) need lp-anhd2))
                        )
                        (enforce (>= xfer need) "CL04: ANHD needs LP to fund EMMA stake")
                        (print (format "<(DPTF C_Transfer LP ANHD→EMMA {})> => \"{}\"" [xfer
                            (ref-TS01-C1::DPTF|C_Transfer patron anhd emma lp-id xfer true)
                        ]))
                    )
                )
                true
            )
            (print (format "<(CC_StakeTrueFungible EMMA LP {})> => \"{}\"" [stake-e
                (ref-TS02-C3::AQP-POOL|CC_StakeTrueFungible patron emma emma pool-id lp-id stake-e)
            ]))
            (let
                (
                    (w-a:decimal (ref-FVT::URC_ScoreEntityUserWeight anhd farm-id pool-id 3 triplet-id))
                    (w-e:decimal (ref-FVT::URC_ScoreEntityUserWeight emma farm-id pool-id 3 triplet-id))
                    ;; divisor is now the maintained snapshot aggregate (point-read), not the retired staker scan
                    (w-sum:decimal (ref-FVT::UR_FVT-SEL|TotalLaneWeight farm-id triplet-id))
                    (base-e:decimal
                        (let ((ref-SCR:module{AcquisitionScoresV2} AQP-SCORE))
                            (ref-SCR::UR_U-SCR|UserScoreBaseScore emma pool-id silver-score)
                        )
                    )
                )
                (map print
                    [
                        (format "<(W_user ANHD/EMMA/sum base-e)> => \"{} {} {} {}\"" [w-a w-e w-sum base-e])
                        (expect (format "<<TX-AQP-CL04>> ANHD W_user>0 got={}" [w-a]) true (> w-a 0.0))
                        (expect (format "<<TX-AQP-CL04>> EMMA W_user>0 got={}" [w-e]) true (> w-e 0.0))
                        (expect (format "<<TX-AQP-CL04>> denom≈ANHD+EMMA got={} ~{}" [w-sum (+ w-a w-e)])
                            true
                            (and (>= w-sum (- (+ w-a w-e) 0.000001)) (<= w-sum (+ (+ w-a w-e) 0.000001)))
                        )
                    ]
                )
                (print "--- [TX-AQP-CL04 · 03 · inject + both collect] ---")
                (print (format "<(C_Inject OURO farm {})> => \"{}\"" [inject-amt
                    (ref-TS02-C3::AQP-FVT|CC_Inject patron patron farm-id ouro-id inject-amt)
                ]))
                (let
                    (
                        (ouro-a0:decimal (ref-DPTF::UR_AccountSupply ouro-id anhd))
                        (auryn-a0:decimal (ref-DPTF::UR_AccountSupply auryn-id anhd))
                        (elite-a0:decimal (ref-DPTF::UR_AccountSupply elite-auryn-id anhd))
                        (ouro-e0:decimal (ref-DPTF::UR_AccountSupply ouro-id emma))
                        (auryn-e0:decimal (ref-DPTF::UR_AccountSupply auryn-id emma))
                        (elite-e0:decimal (ref-DPTF::UR_AccountSupply elite-auryn-id emma))
                    )
                    (print (format "<(CC_Collect ANHD)> => \"{}\"" [
                        (ref-TS02-C3::AQP-FVT|CC_Collect anhd anhd farm-id 3 triplet-id ouro-id)
                    ]))
                    (print (format "<(CC_Collect EMMA)> => \"{}\"" [
                        (ref-TS02-C3::AQP-FVT|CC_Collect emma emma farm-id 3 triplet-id ouro-id)
                    ]))
                    (let
                        (
                            (pay-a:decimal
                                (+ (- (ref-DPTF::UR_AccountSupply ouro-id anhd) ouro-a0)
                                    (+ (- (ref-DPTF::UR_AccountSupply auryn-id anhd) auryn-a0)
                                        (- (ref-DPTF::UR_AccountSupply elite-auryn-id anhd) elite-a0)
                                    )
                                )
                            )
                            (pay-e:decimal
                                (+ (- (ref-DPTF::UR_AccountSupply ouro-id emma) ouro-e0)
                                    (+ (- (ref-DPTF::UR_AccountSupply auryn-id emma) auryn-e0)
                                        (- (ref-DPTF::UR_AccountSupply elite-auryn-id emma) elite-e0)
                                    )
                                )
                            )
                            (ar-left:decimal (ref-FVT::UR_FVT-RG|AvailableRewards farm-id ouro-id))
                            (cross:decimal (abs (- (* pay-a w-e) (* pay-e w-a))))
                        )
                        (map print
                            [
                                (format "<(payouts ANHD/EMMA/sum cross)> => \"{} {} {} {}\"" [pay-a pay-e (+ pay-a pay-e) cross])
                                (expect (format "<<TX-AQP-CL04>> ANHD payout>0 got={}" [pay-a]) true (> pay-a 0.0))
                                (expect (format "<<TX-AQP-CL04>> EMMA payout>0 got={}" [pay-e]) true (> pay-e 0.0))
                                (expect (format "<<TX-AQP-CL04>> payout∝W got pay-a={} pay-e={} w-a={} w-e={} cross={}"
                                    [pay-a pay-e w-a w-e cross])
                                    true
                                    (< cross 0.5)
                                )
                                (expect (format "<<TX-AQP-CL04>> sum payouts <= inject got={} inject={}"
                                    [(+ pay-a pay-e) inject-amt])
                                    true
                                    (<= (+ pay-a pay-e) (+ inject-amt 0.000001))
                                )
                                (expect (format "<<TX-AQP-CL04>> available-rewards residual small got={}" [ar-left])
                                    true
                                    (< ar-left 0.05)
                                )
                            ]
                        )
                        ;; #10 wind-down: EMMA fully exits, then ANHD (sole claimant, gc==1) collects → the
                        ;; two-tier sweep drains both vaults. Dust lanes fall back to token-0 (Ouro) so it never reverts.
                        (print "--- [TX-AQP-CL04 · 04 · two-tier sweep drain proof] ---")
                        (ref-TS02-C3::AQP-POOL|CC_UnstakeTrueFungible patron emma emma pool-id lp-id stake-e)
                        ;;==== TX-AQP-CL04 · 03b · WHOSE sweep is it, and who may move the counter ====
                        ;;REGRESSION PIN added 2026-09-14 with the AQP-RPS sweep repair. Two coupled
                        ;;defects lived here, both absent from the Stoa `coin` UrStoa vault these
                        ;;phases are a port of (the comments still name the steps "coin step 1..5"):
                        ;;
                        ;;  1] URC_CollectClaimableRewards branched on `(= gc 1)` ALONE -- a property
                        ;;     of the VAULT -- and paid the whole pool to whoever asked. `coin` guards
                        ;;     the same branch with `(and (= unclaimed-count 1) (> available 0.0))`;
                        ;;     the second conjunct, the one that identifies the CALLER, was dropped.
                        ;;     MEASURED: EMMA, fully exited, took the sweep; ANHD, the rightful sole
                        ;;     claimant, received 0.
                        ;;  2] XI_1|BookCollectUnclaimed decremented `gc` on `deb == 0` alone, so any
                        ;;     zero-weight account could walk the counter down for the price of gas.
                        ;;     In `coin` that path is unreachable: its step 1 is C_Transmit, which
                        ;;     aborts on a zero amount via UEV_Amount. The port made step 1 SKIP
                        ;;     instead of abort, and the decrement three steps later became reachable.
                        ;;
                        ;;WHY THE SUITE STAYED GREEN THROUGH BOTH. The assertions further down check
                        ;;that the vault DRAINED (`ar-final`/`mv-final` -> 0). Conservation is
                        ;;satisfied whether the money reaches the rightful claimant or someone who
                        ;;just left. These assert OWNERSHIP and COUNTER INTEGRITY, which conservation
                        ;;cannot see.
                        (let
                            (
                                (ar-now:decimal (ref-FVT::UR_FVT-RG|AvailableRewards farm-id ouro-id))
                                (emma-c:decimal (ref-FVT::URC_CollectClaimableRewards emma pool-id farm-id 3 triplet-id ouro-id))
                                (anhd-c:decimal (ref-FVT::URC_CollectClaimableRewards anhd pool-id farm-id 3 triplet-id ouro-id))
                            )
                            (map print
                                [
                                    (format "<<TX-AQP-CL04>> gc={} ar={} emma-deb={} anhd-deb={} emma-claimable={} anhd-claimable={}"
                                        [(ref-FVT::UR_FVT-RG|UnclaimedCount farm-id ouro-id) ar-now
                                         (ref-FVT::URC_ScoreEntityUserWeight emma farm-id pool-id 3 triplet-id)
                                         (ref-FVT::URC_ScoreEntityUserWeight anhd farm-id pool-id 3 triplet-id)
                                         emma-c anhd-c])
                                    (expect "<<TX-AQP-CL04>> an exited account (deb=0) is offered NOTHING at gc==1"
                                        0.0 emma-c)
                                    ;;non-vacuity: without this, the line above would pass against a
                                    ;;reader that returns 0.0 to everyone -- satisfying the repair
                                    ;;while destroying the dust sweep it exists to perform.
                                    (expect "<<TX-AQP-CL04>> ...while the rightful sole claimant IS offered the whole vault"
                                        ar-now anhd-c)
                                    (expect "<<TX-AQP-CL04>> the reader DISTINGUISHES claimant from non-claimant"
                                        false (= emma-c anhd-c))
                                ]
                            )
                        )
                        ;;DEFECT 2, pinned as the attack: three collects by a zero-weight account must
                        ;;not move the counter. Before the repair each one decremented it, so an
                        ;;attacker could drive gc to 1 while honest stakers were still staked and then
                        ;;take the pool.
                        (ref-TS02-C3::AQP-FVT|CC_Collect emma emma farm-id 3 triplet-id ouro-id)
                        (ref-TS02-C3::AQP-FVT|CC_Collect emma emma farm-id 3 triplet-id ouro-id)
                        (ref-TS02-C3::AQP-FVT|CC_Collect emma emma farm-id 3 triplet-id ouro-id)
                        (map print
                            [
                                (expect "<<TX-AQP-CL04>> a zero-weight account cannot walk the claimant counter"
                                    1 (ref-FVT::UR_FVT-RG|UnclaimedCount farm-id ouro-id))
                            ]
                        )
                        (let ((ab:decimal (ref-DPTF::UR_AccountSupply ouro-id anhd)))
                            (ref-TS02-C3::AQP-FVT|CC_Collect anhd anhd farm-id 3 triplet-id ouro-id)
                            (map print
                                [
                                    ;;and the sweep still WORKS: the rightful claimant is paid the
                                    ;;remainder and the vault reaches 0, so nothing is stranded.
                                    ;;This is the half a naive "return 0 to everyone" fix would break.
                                    (expect "<<TX-AQP-CL04>> ...so the rightful claimant still sweeps the remainder"
                                        true (> (- (ref-DPTF::UR_AccountSupply ouro-id anhd) ab) 0.0))
                                    (expect "<<TX-AQP-CL04>> ...and the vault is fully drained, nothing stranded"
                                        0.0 (ref-FVT::UR_FVT-RG|AvailableRewards farm-id ouro-id))
                                ]
                            )
                        )
                        (let
                            (
                                (ar-final:decimal (ref-FVT::UR_FVT-RG|AvailableRewards farm-id ouro-id))
                                (mv-final:decimal (ref-FVT::UR_FVT-MV|AvailableRewards farm-id triplet-id ouro-id))
                                (gc-final:integer (ref-FVT::UR_FVT-RG|UnclaimedCount farm-id ouro-id))
                            )
                            (map print
                                [
                                    (format "<(post-winddown ar/member-vault/gc)> => \"{} {} {}\"" [ar-final mv-final gc-final])
                                    (expect (format "<<TX-AQP-CL04>> #10 sweep drains GLOBAL vault to ~0 got={}" [ar-final])
                                        true (< ar-final 0.0000001))
                                    (expect (format "<<TX-AQP-CL04>> #10 sweep drains MEMBER vault to ~0 got={}" [mv-final])
                                        true (< mv-final 0.0000001))
                                ]
                            )
                        )
                    )
                )
            )
        )
        (print (format "SKIP TX-AQP-CL04: OuroLpFarm/DHOuroLp not provisioned (farm-class={} pool-class={})" [farm-class pool-class]))
    )
)
(env-sigs [])
(commit-tx)
;;||>>>>>>>>>>>>>>>>>>>>>>>>>
;;|| NEXT                   >
;;||>>>>>>>>>>>>>>>>>>>>>>>>>
(print "")
(print "")
;;
(begin-tx "TX-AQP-CL05 - DHOuroLp dual-stream vacate (TF LP + Z| OF LP)")
(print "")
(print "=== TX-AQP-CL05 — VCT-15: vacate TF LP then Z| sleeping LP on DHOuroLp ======")
(namespace "ouronet-ns")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
;;==== TX-AQP-CL05 - DHOuroLp dual-stream vacate (TF LP + Z| OF LP) · 01 · let / invocation ==== ==
(print "--- [TX-AQP-CL05 - DHOuroLp dual-stream vacate (TF LP + Z| OF LP) · 01 · let / invocation] ---")
(let
    (
        (patron:string KST.ANHD)
        (owner:string KST.ANHD)
        (swpair:string "W|DLK-98c486052a51|OURO-98c486052a51|DWK-98c486052a51")
        (ref-U|DALOS:module{UtilityDalosV2} U|DALOS)
        (ref-DALOS:module{OuronetDalosV2} DALOS)
        (ref-U|CT:module{OuronetConstantsV2} U|CT)
        (ref-SWP:module{SwapperV4} SWP)
        (ref-DPTF:module{DemiourgosPactTrueFungibleV2} DPTF)
        (ref-DPOF:module{DemiourgosPactOrtoFungibleV2} DPOF)
        (ref-TS01-C2:module{TalosStageOne_ClientTwoV2} TS01-C2)
        (ref-TS01-C3:module{TalosStageOne_ClientThreeV4} TS01-C3)
        (ref-TS02-C3:module{TalosStageTwo_ClientThreeV2} TS02-C3)
        (ref-ANK:module{AcquisitionAnchorsV1} AQP-ANK)
        (ref-SCR:module{AcquisitionScoresV2} AQP-SCORE)
        (ref-AQP:module{AcquisitionPoolsV1} AQP-POOL)
        (ref-VCT:module{AcquisitionVacateV1} AQP-VCT)
        (pool-id:string (ref-U|DALOS::UDC_Makeid "DHOuroLp"))
        (silver-score:string (ref-U|DALOS::UDC_Makeid "SilverSnakePower"))
        (lp-id:string (ref-SWP::UR_TokenLP swpair))
        (pool-class:integer (try -1 (ref-AQP::UR_AQP|PoolAqpClass pool-id)))
        (bar:string (ref-U|CT::CT_BAR))
        (sleep-amt:decimal 5.0)
        (dptf-price:decimal (ref-DALOS::UR_UsagePrice "dptf"))
        (dpmf-price:decimal (ref-DALOS::UR_UsagePrice "dpmf"))
        (split-sleep:[decimal]
            (ref-DALOS::URC_SplitSTOAPrices patron (fold (+) 0.0 [dptf-price dpmf-price]))
        )
    )
    (env-sigs
        [
            { "key": "PK_AncientHodler", "caps": [] }
            { "key": "PK_Emma", "caps": [] }
            { "key": "PK_Lumy", "caps": [] }
            { "key": "6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263",
              "caps":
                [
                    (coin.TRANSFER "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263" "k:50d6c59b21e5e6e55baecaa75a1007de37576bde12d8230dc82459cc01b9484b" (at 2 split-sleep))
                    (coin.TRANSFER "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263" "k:0cb30c0121ff919266121a99ff9359871818932211df94dae4137c29bc0e8f7e" (at 0 split-sleep))
                    (coin.TRANSFER "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263" "c:XM-pkmuB5XUQlp87ZYSbfKt8qzmHY6O2EHAzMRVBt3k" (at 3 split-sleep))
                    (coin.TRANSFER "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263" "c:iQQFWj6gWtpGEzhM_O5ekW1QtnQQy55R8BRPGhj_0FU" (at 1 split-sleep))
                ]
            }
        ]
    )
    (if (< pool-class 0)
        (print "SKIP TX-AQP-CL05: DHOuroLp not provisioned")
        (let
            (
                (sleeping-pre:string (ref-DPTF::UR_Sleeping lp-id))
            )
            (if (= sleeping-pre bar)
                (print (format "<(SWP|C_EnableSleepingLP)> => \"{}\"" [
                    (ref-TS01-C3::SWP|C_EnableSleepingLP patron (SWP.UR_OwnerKonto swpair) swpair)
                ]))
                (print (format "<(sleeping LP already)> => \"{}\"" [sleeping-pre]))
            )
            (let
                (
                    (z-lp-id:string (ref-DPTF::UR_Sleeping lp-id))
                    (lp-free:decimal (ref-DPTF::UR_AccountSupply lp-id owner))
                    (tf-pre:decimal (ref-AQP::UR_AQP|DPTFTrackerBalance pool-id lp-id owner owner))
                    (aqp-sc:string (ref-ANK::GOV|AQP|SC_NAME))
                )
                (enforce (!= z-lp-id bar) "CL05: sleeping LP link missing after EnableSleepingLP")
                (print (format "<(VST|C_ToggleTransferRoleSleepingDPOF AQP SC)> => \"{}\"" [
                    (ref-TS01-C2::VST|C_ToggleTransferRoleSleepingDPOF patron (ouronet-ns.VST.URC_SpecialTransferRoleKonto z-lp-id) z-lp-id aqp-sc true)
                ]))
                (if (< lp-free sleep-amt)
                    (print (format "<(SWP|C_AddLiquidity for sleep seed)> => \"{}\"" [
                        (ref-TS01-C3::SWP|C_AddLiquidity patron patron swpair [50.0 50.0 50.0])
                    ]))
                    true
                )
                (let
                    (
                        (lp-free2:decimal (ref-DPTF::UR_AccountSupply lp-id owner))
                        (sleep-use:decimal (if (> lp-free2 sleep-amt) sleep-amt lp-free2))
                        (z-pre-count:integer (length (ref-DPOF::URH_AccountNonces owner z-lp-id)))
                    )
                    (enforce (> sleep-use 0.0) "CL05: need free LP to sleep for Z| stream")
                    (enforce (> tf-pre 0.0) "CL05: need existing TF LP stake (run CL03 first)")
                    (print (format "<(VST|C_Sleep LP {}s)> => \"{}\"" [sleep-use
                        (ref-TS01-C2::VST|C_Sleep patron owner owner lp-id sleep-use 86400)
                    ]))
                    (let
                        (
                            (z-nonces:[integer] (ref-DPOF::URH_AccountNonces owner z-lp-id))
                            (stake-nonce:integer (at z-pre-count z-nonces))
                        )
                        (enforce (> (length z-nonces) z-pre-count) "CL05: sleep did not mint Z| nonce")
                        (if (not (ref-AQP::UR_AQP|PoolStakeEnabled pool-id))
                            (print (format "<(AQP-POOL|C_EnablePoolStake)> => \"{}\"" [
                                (ref-TS02-C3::AQP-POOL|C_EnablePoolStake patron (AQP-POOL.URC_AqpOwnerKonto pool-id) pool-id)
                            ]))
                            true
                        )
                        ;;CUSTODIAL, AND IT HAS TO BE: the ordinary orto path now REFUSES a Z|
                        ;;leg (FVT|C>ORTO-FUNGIBLE-STAKE-FLOW #8), because a duration-scaled
                        ;;multiplier prices a commitment that a freely-withdrawable stake does
                        ;;not make. Switching this fixture over keeps its original subject --
                        ;;the agnostic dual-lane CC_FullVacate below -- and adds a second one:
                        ;;the vacated row's owner column is now `AQP|SC_NAME`, so the
                        ;;"Z| LP returned" assertion at the end of this block is what proves
                        ;;`UC_VacateOrtoDestinations` sends a CUSTODIAL position to its
                        ;;beneficiary. Before that helper existed the pool was both sender and
                        ;;recipient, the batch never left, and the tracker row was unwound
                        ;;around it -- the position gone and the asset still inside.
                        (print (format "<(CCp_StakeSpecialCustodial Z|LP nonce {})> => \"{}\"" [stake-nonce
                            (ref-TS02-C3::AQP-POOL|CCp_StakeSpecialCustodial patron owner owner pool-id z-lp-id [stake-nonce])
                        ]))
                        (let
                            (
                                ;;KEYED ON THE POOL, not the staker -- that one column IS the custody.
                                (of-pre:decimal (ref-AQP::UR_AQP|DPOFTrackerBalance pool-id z-lp-id aqp-sc owner stake-nonce))
                                (tf-both:decimal (ref-AQP::UR_AQP|DPTFTrackerBalance pool-id lp-id owner owner))
                            )
                            (map print
                                [
                                    (expect (format "<<TX-AQP-CL05>> dual TF tracker>0 got={}" [tf-both]) true (> tf-both 0.0))
                                    (expect (format "<<TX-AQP-CL05>> dual OF tracker>0 got={}" [of-pre]) true (> of-pre 0.0))
                                    ;;THE AWARDED-WEIGHT LEDGER FIRED ON A REAL SLEEPING STAKE.
                                    ;;`SCR|T|SleepStake` records what the lock had left at the
                                    ;;moment it was staked, so the unstake gives back exactly what
                                    ;;was credited rather than recomputing from a multiplier that
                                    ;;has since decayed -- which would leave weight behind for a
                                    ;;position nobody holds. This nonce was slept for 86,400s, so
                                    ;;the recorded figure must be positive and no greater than that.
                                    ;;Asserted HERE because this is the only fixture in the tree
                                    ;;that stakes a Z| sleeping LP through the real client path;
                                    ;;the arithmetic itself is pinned in [6.2.17] TX-RERATE-04.
                                    (expect
                                        (format "<<TX-AQP-CL05>> SleepStake recorded the lock's remaining term for nonce {} (got {})"
                                            [stake-nonce (AQP-SCORE.UR_SCR|SleepRemainingAtStake z-lp-id stake-nonce)])
                                        [true true]
                                        [(> (AQP-SCORE.UR_SCR|SleepRemainingAtStake z-lp-id stake-nonce) 0.0)
                                         (<= (AQP-SCORE.UR_SCR|SleepRemainingAtStake z-lp-id stake-nonce) 86400.0)])
                                ]
                            )
                            ;; REHAUL MULTI-LANE PROOF: ONE agnostic CC_FullVacate(pool-id) drains BOTH the native
                            ;; LP (DPTF lane) AND the Z| sleeping-LP satellite (DPOF lane) of this class-0 pool.
                            ;; Pre-fix, class-0 DPOF satellites were ORPHANED (with-satellites gated to class 1), so
                            ;; of-post would stay non-zero — this scenario directly falsifies that bug.
                            (let
                                (
                                    ;; both lanes checked by point-read (asset-id-derived, no scan reader):
                                    ;; native LP via DPTF tracker; Z| satellite via DPOF tracker (of-pre, above).
                                    (native-lp-bal:decimal (ref-AQP::UR_AQP|DPTFTrackerBalance pool-id lp-id owner owner))
                                )
                                (enforce (> native-lp-bal 0.0) "CL05: native LP lane must be live pre-vacate")
                                (enforce (> of-pre 0.0) "CL05: Z| satellite must be live pre-vacate")
                                (print (format "<(pre lanes native-LP-bal={} Z|-sat-bal={})> " [native-lp-bal of-pre]))
                                (print (format "<(AQP-POOL|CC_FullVacate — agnostic dual-lane, pool-id only)> => \"{}\"" [
                                    (ref-TS02-C3::AQP-POOL|CC_FullVacate patron (AQP-POOL.URC_AqpOwnerKonto pool-id) pool-id)
                                ]))
                            )
                            (let
                                (
                                    (tf-post:decimal (ref-AQP::UR_AQP|DPTFTrackerBalance pool-id lp-id owner owner))
                                    (of-post:decimal (ref-AQP::UR_AQP|DPOFTrackerBalance pool-id z-lp-id aqp-sc owner stake-nonce))
                                    (deb-post:decimal (ref-SCR::UR_U-SCR|UserScoreDebScore owner pool-id silver-score))
                                    (z-supply:decimal (ref-DPOF::UR_AccountSupply z-lp-id owner))
                                )
                                (map print
                                    [
                                        (expect (format "<<TX-AQP-CL05>> TF tracker cleared got={} expected=0" [tf-post]) 0.0 tf-post)
                                        (expect (format "<<TX-AQP-CL05>> OF tracker cleared got={} expected=0" [of-post]) 0.0 of-post)
                                        (expect
                                            (format "<<TX-AQP-CL05>> Silver |deb|≈0 got={}" [deb-post])
                                            true
                                            (<= (abs deb-post) 0.000001)
                                        )
                                        (expect (format "<<TX-AQP-CL05>> Z| LP returned got={}" [z-supply]) true (> z-supply 0.0))
                                    ]
                                )
                            )
                        )
                    )
                )
            )
        )
    )
)
(env-sigs [])
(commit-tx)
(print "")
(print "=== END [6.4]_AQP-TRIPLET-COLLECT.repl ======================================")

;;||>>>>>>>>>>>>>>>>>>>>>>>>>
;;|| NEXT                   >
;;||>>>>>>>>>>>>>>>>>>>>>>>>>
(print "")
;;
(begin-tx "TX-AQP-CL06 - CUSTODIAL sleeping LP: stake, early-exit refusals, matured release")
(print "")
(print "=== TX-AQP-CL06 — pool custody of a sleeping LP, end to end =================")
(namespace "ouronet-ns")
(env-gasmodel "table")(env-gaslimit 900000000)(env-gas 0)
;;==== TX-AQP-CL06 · 01 · env-sigs (caps) ====
(print "--- [TX-AQP-CL06 · 01 · env-sigs (caps)] ---")
(env-sigs [ { "key": "PK_AncientHodler", "caps": [] } ])
;;==== TX-AQP-CL06 · 02 · the custodial cycle ====
(print "--- [TX-AQP-CL06 · 02 · the custodial cycle] ---")
;;THE WHOLE POINT OF CUSTODY, ASSERTED. The owner's design: "the asset goes to aqp and aqp would
;;stake it ... such that it appears the stalker is the aqp itself instead of the user", and
;;"Unstake in this case ... is only allowed when the nonce sleeping period expired. And in this
;;case the AQP unsleeps it ... and transfer the user the native lp."
;;
;;Four properties have to hold together, and each one is worthless without the others:
;;  1] the tracker names the POOL as owner, not the staker
;;  2] the staker therefore CANNOT withdraw early
;;  3] nor can anyone release it early -- the pool gains no power the staker lacks
;;  4] but once matured, ANYONE can release it, and the value can only reach the staker
(let
    (
        (patron:string KST.ANHD)
        (owner:string KST.ANHD)
        (swpair:string "W|DLK-98c486052a51|OURO-98c486052a51|DWK-98c486052a51")
        (ref-U|DALOS:module{UtilityDalosV2} U|DALOS)
        (ref-DALOS:module{OuronetDalosV2} DALOS)
        (ref-U|CT:module{OuronetConstantsV2} U|CT)
        (ref-SWP:module{SwapperV4} SWP)
        (ref-DPTF:module{DemiourgosPactTrueFungibleV2} DPTF)
        (ref-DPOF:module{DemiourgosPactOrtoFungibleV2} DPOF)
        (ref-TS01-C2:module{TalosStageOne_ClientTwoV2} TS01-C2)
        (ref-TS02-C3:module{TalosStageTwo_ClientThreeV2} TS02-C3)
        (ref-SCR:module{AcquisitionScoresV2} AQP-SCORE)
        (ref-AQP:module{AcquisitionPoolsV1} AQP-POOL)
    )
    (let*
        (
            (pool-id:string (ref-U|DALOS::UDC_Makeid "DHOuroLp"))
            (silver-score:string (ref-U|DALOS::UDC_Makeid "SilverSnakePower"))
            (lp-id:string (ref-SWP::UR_TokenLP swpair))
            (z-lp-id:string (ref-DPTF::UR_Sleeping lp-id))
            (aqp:string (ref-DALOS::GOV|AQP|SC_NAME))
            (bar:string (ref-U|CT::CT_BAR))
            (pool-class:integer (try -1 (ref-AQP::UR_AQP|PoolAqpClass pool-id)))
        )
        (if (or (!= pool-class 0) (= z-lp-id bar))
            (print "SKIP TX-AQP-CL06: DHOuroLp/sleeping-LP not provisioned")
            (let*
                (
                    (base-pre:decimal (ref-SCR::UR_U-SCR|UserScoreBaseScore owner pool-id silver-score))
                    (lp-pre:decimal (DPTF.UR_AccountSupply lp-id owner))
                    (z-pre:integer (ref-DPOF::UR_NoncesUsed z-lp-id))
                )
                ;;a FULL-TERM lock, so the multiplier is at its mx-ceiling and the decay gap is at
                ;;its widest -- the hardest case for exact reversal
                (ref-TS01-C2::VST|C_Sleep patron owner owner lp-id 5.0 788400000)
                (let*
                    (
                        (n:integer (+ z-pre 1))
                        (dummy1:string (ref-TS02-C3::AQP-POOL|CCp_StakeSpecialCustodial
                                            patron owner owner pool-id z-lp-id [n]))
                        (base-staked:decimal (ref-SCR::UR_U-SCR|UserScoreBaseScore owner pool-id silver-score))
                    )
                    (map print
                        [
                            ;;1] THE TRACKER NAMES THE POOL. This single column is the custody
                            ;;mechanism -- `CAP_StakeOwner` checks it, so an early user exit is
                            ;;refused by the ownership guard that already existed.
                            (expect "<<TX-AQP-CL06>> the tracker credits the POOL as owner, and the staker holds no row"
                                [true 0.0]
                                [(> (ref-AQP::UR_AQP|DPOFTrackerBalance pool-id z-lp-id aqp owner n) 0.0)
                                 (ref-AQP::UR_AQP|DPOFTrackerBalance pool-id z-lp-id owner owner n)])
                            ;;the staker still earns -- they are time-locked, not dispossessed
                            (expect "<<TX-AQP-CL06>> ...while the WEIGHT still accrues to the staker"
                                true (> base-staked base-pre))
                            ;;the awarded-weight ledger stamped the full term
                            (expect "<<TX-AQP-CL06>> the ledger recorded the full 25-year term for the batch"
                                true (> (ref-SCR::UR_SCR|SleepRemainingAtStake z-lp-id n) 788000000.0))
                            ;;1b] AND THE ORDINARY PATH IS CLOSED TO THIS LEG ALTOGETHER, which
                            ;;is what makes custody MANDATORY rather than merely available. Pinned
                            ;;by MESSAGE, and that is the whole point: the duration multiplier and
                            ;;this refusal are one mechanism. Without it a staker takes the
                            ;;25-year rate on the ordinary path and withdraws next block, so the
                            ;;curve would price a commitment nobody made. Delete the guard and
                            ;;every other assertion in this file still passes -- which is exactly
                            ;;how a missing gate hides, so it needs an assertion of its own.
                            (expect-failure "<<TX-AQP-CL06>> a sleeping leg CANNOT be staked on the ordinary path — custody is mandatory"
                                "Invalid stake path: a sleeping leg that earns a duration multiplier must be staked under pool custody"
                                (ref-TS02-C3::AQP-POOL|CC_StakeOrtoFungible
                                    patron owner owner pool-id z-lp-id [n]))
                            ;;1c] AND THE SALE IS REFUSED ON *THIS* TOKEN, because CL05 granted the
                            ;;AQP smart account a transfer role on it -- a deliberate act by the
                            ;;token owner, which is exactly what `URC_SpecialLegIssuerRestricted`
                            ;;reads as intent to control who may hold it.
                            ;;
                            ;;THIS IS THE OTHER SIDE OF THE GATE, and the pair matters. `[6.2.17]`
                            ;;<<TX-RERATE-SELL>> sells a position on a token carrying ONLY VST's
                            ;;automatic infrastructure grant, and it succeeds. Here an owner has
                            ;;added a holder, and the same operation is refused for a counterparty
                            ;;who is not whitelisted. One predicate, two answers, decided by
                            ;;whether a human chose to restrict the token -- which is the only
                            ;;thing that can distinguish them, since EVERY special token has roles
                            ;;active from birth.
                            ;;
                            ;;It has to be refused: the release pays the NATIVE asset to whoever
                            ;;is beneficiary at maturity, so a reassignment is a deferred delivery
                            ;;to the new party, and nothing downstream re-checks it.
                            (expect-failure "<<TX-AQP-CL06>> the position CANNOT be sold on a token whose owner restricted it"
                                "Incompatible Transfer Roles"
                                (ref-TS02-C3::AQP-POOL|CCp_ReassignCustodialBeneficiary
                                    patron owner pool-id z-lp-id n KST.EMMA))
                            ;;2] NO EARLY USER EXIT -- refused by the pre-existing ownership guard
                            ;;THE REFUSAL COMES FROM THE TRACKER ITSELF, which is stronger than an
                            ;;ownership check: there is no row keyed to the staker at all, so the
                            ;;ordinary unstake cannot even find a balance to withdraw. Custody is
                            ;;enforced by the shape of the data, not by a guard that could be
                            ;;forgotten on some other path.
                            (expect-failure "<<TX-AQP-CL06>> the staker CANNOT unstake it — no tracker row is keyed to them"
                                "Invalid OF pool custody"
                                (ref-TS02-C3::AQP-POOL|CC_UnstakeOrtoFungible
                                    patron owner owner pool-id z-lp-id [n]))
                            ;;3] AND NO EARLY RELEASE EITHER. The pool gains the power to exit AT
                            ;;ALL, never the power to exit EARLY -- that asymmetry is what makes
                            ;;custody acceptable to a staker.
                            (expect-failure "<<TX-AQP-CL06>> nor can ANYONE release it early — VST refuses an immature lock"
                                "cannot be unsleeped yet"
                                (ref-TS02-C3::AQP-POOL|CCp_ReleaseSpecialCustodial
                                    patron pool-id owner z-lp-id n))
                        ]
                    )
                    ;;--- time passes: the lock matures ---
                    (env-chain-data { "block-time": (time "2060-01-01T00:00:00Z") })
                    (let
                        (
                            (dummy2:string (ref-TS02-C3::AQP-POOL|CCp_ReleaseSpecialCustodial
                                                patron pool-id owner z-lp-id n))
                        )
                        (map print
                            [
                                ;;4a] THE BASE NETS TO EXACTLY ITS PRE-STAKE VALUE. This is the
                                ;;assertion the awarded-weight ledger exists for: the multiplier
                                ;;decayed from its mx-ceiling to the plain rate while the position was
                                ;;held, so a recomputed reversal would have given back LESS than was
                                ;;credited and left the difference behind as permanent phantom
                                ;;weight. Reversing the LEDGER returns precisely what was taken.
                                (expect "<<TX-AQP-CL06>> the base is back to EXACTLY its pre-stake value — the ledger reversed in full"
                                    base-pre
                                    (ref-SCR::UR_U-SCR|UserScoreBaseScore owner pool-id silver-score))
                                ;;4b] the tracker row is gone
                                (expect "<<TX-AQP-CL06>> the custodial tracker row is drained"
                                    0.0 (ref-AQP::UR_AQP|DPOFTrackerBalance pool-id z-lp-id aqp owner n))
                                ;;4c] THE NONCE IS RETIRED. Burning the whole supply sets it to -1.0
                                ;;and takes it out of circulation permanently -- there is no disable
                                ;;flag, that negative supply IS the retirement.
                                (expect "<<TX-AQP-CL06>> the batch is dissolved and the nonce RETIRED to supply -1.0"
                                    -1.0 (ref-DPOF::UR_NonceSupply z-lp-id n))
                                ;;4d] and the value reached the STAKER, not the pool or the caller
                                (expect "<<TX-AQP-CL06>> the staker got the native LP back in full"
                                    lp-pre (DPTF.UR_AccountSupply lp-id owner))
                            ]
                        )
                    )
                    ""
                )
            )
        )
    )
)
(env-sigs [])
(print "===^^^===")
(commit-tx)
(print "")
(print "")
;;||>>>>>>>>>>>>>>>>>>>>>>>>>
;;|| NEXT                   >
;;||>>>>>>>>>>>>>>>>>>>>>>>>>
(print "")
;;
(begin-tx "TX-AQP-CL07 - a sold position is RE-RATED to the term remaining at transfer")
(print "")
(print "=== TX-AQP-CL07 — the buyer is re-rated, not handed the seller's ceiling ========")
(namespace "ouronet-ns")
(env-gasmodel "table")(env-gaslimit 900000000)(env-gas 0)
;;==== TX-AQP-CL07 · 01 · env-sigs (caps) ====
(print "--- [TX-AQP-CL07 · 01 · env-sigs (caps)] ---")
(env-sigs [ { "key": "PK_AncientHodler", "caps": [] } ])
;;==== TX-AQP-CL07 · 02 · stake at the ceiling, sell at the midpoint ====
(print "--- [TX-AQP-CL07 · 02 · stake at the ceiling, sell at the midpoint] ---")
;;OWNER RULING 2026-10-10: "when alice trasnfer custody to bob, the remaining time of the sleeping
;;nonce is smaller compared to when alice staked it first. so yes, the multiplier should also be
;;recomputed at transfer time."
;;
;;THE BEHAVIOUR WAS ALREADY CODED -- the buyer's leg runs the phase chain in the STAKE direction,
;;which re-stamps `SCR|T|SleepStake` with the term remaining NOW -- BUT IT WAS NOT PROVABLE. The
;;two reassignment tests in `[6.2.17]` both run on a score whose `mx-sleeping` is 1.0, where a
;;ceiling of 1.0 makes the decay curve a no-op and re-rating is numerically indistinguishable
;;from inheriting. They would have passed identically with the re-stamp deleted.
;;
;;THIS BLOCK IS THE ONE THAT CAN FAIL. `SilverSnakePower` on `DHOuroLp` carries a real ceiling, so
;;the arithmetic has somewhere to go, and the fixture chooses the term deliberately: stake at the
;;FULL 300-month lock, then advance exactly 150 months, so the remaining term is exactly half and
;;the expected multiplier is the exact midpoint between 1.0 and the ceiling. Nothing here depends
;;on a tolerance.
;;
;;WHY IT IS THE RIGHT RULE, recorded with the test that enforces it: a buyer who inherited the
;;seller's original multiplier would be better off buying the position than buying the nonce and
;;staking it himself -- the same holding by another route, at two different prices. That
;;arbitrage between routes is exactly what the duration curve exists to remove.
(let
    (
        (patron:string KST.ANHD)
        (alice:string KST.ANHD)
        (bob:string KST.EMMA)
        (swpair:string "W|DLK-98c486052a51|OURO-98c486052a51|DWK-98c486052a51")
        (ref-U|DALOS:module{UtilityDalosV2} U|DALOS)
        (ref-DALOS:module{OuronetDalosV2} DALOS)
        (ref-U|CT:module{OuronetConstantsV2} U|CT)
        (ref-SWP:module{SwapperV4} SWP)
        (ref-DPTF:module{DemiourgosPactTrueFungibleV2} DPTF)
        (ref-DPOF:module{DemiourgosPactOrtoFungibleV2} DPOF)
        (ref-TS01-C2:module{TalosStageOne_ClientTwoV2} TS01-C2)
        (ref-TS02-C3:module{TalosStageTwo_ClientThreeV2} TS02-C3)
        (ref-SCR:module{AcquisitionScoresV2} AQP-SCORE)
        (ref-AQP:module{AcquisitionPoolsV1} AQP-POOL)
    )
    (let*
        (
            (pool-id:string (ref-U|DALOS::UDC_Makeid "DHOuroLp"))
            (silver-score:string (ref-U|DALOS::UDC_Makeid "SilverSnakePower"))
            (lp-id:string (ref-SWP::UR_TokenLP swpair))
            (z-lp-id:string (ref-DPTF::UR_Sleeping lp-id))
            (aqp:string (ref-DALOS::GOV|AQP|SC_NAME))
            (bar:string (ref-U|CT::CT_BAR))
            (pool-class:integer (try -1 (ref-AQP::UR_AQP|PoolAqpClass pool-id)))
        )
        (if (or (!= pool-class 0) (= z-lp-id bar))
            (print "SKIP TX-AQP-CL07: DHOuroLp/sleeping-LP not provisioned")
            (let*
                (
                    (amt:decimal 4.0)
                    ;;300 months, the chain's own sleep maximum -- so the stake earns the CEILING
                    (full-term:integer 788400000)
                    ;;exactly 150 of those months, so the remaining term is exactly half
                    (half-term:decimal 394200000.0)
                    ;;`mx-ceiling`, not `ceiling`: the latter shadows a Pact native and the loader
                    ;;refuses it outright -- the same trap 02_SCORE.pact records at the weighting function.
                    (mx-ceiling:decimal (ref-SCR::UR_SCR|ScoreMxSleeping silver-score))
                    (lp-free:decimal (ref-DPTF::UR_AccountSupply lp-id alice))
                )
                (if (< lp-free amt)
                    (print "SKIP TX-AQP-CL07: not enough free LP to sleep")
                    (let*
                        (
                            (z-pre:integer (ref-DPOF::UR_NoncesUsed z-lp-id))
                        )
                        (ref-TS01-C2::VST|C_Sleep patron alice alice lp-id amt full-term)
                        (let*
                            (
                                (n:integer (+ z-pre 1))
                                (base-pre:decimal (ref-SCR::UR_U-SCR|UserScoreBaseScore alice pool-id silver-score))
                                (total-pre:decimal (ref-SCR::UR_SCR|ScoreTotalBaseScore silver-score))
                            )
                            (ref-TS02-C3::AQP-POOL|CCp_StakeSpecialCustodial patron alice alice pool-id z-lp-id [n])
                            (let*
                                (
                                    (alice-weight:decimal
                                        (- (ref-SCR::UR_U-SCR|UserScoreBaseScore alice pool-id silver-score) base-pre))
                                )
                                (map print
                                    [
                                        ;;the fixture, asserted: a REAL ceiling above 1.0, or this test proves nothing
                                        (expect "<<TX-AQP-CL07>> fixture: the score's sleeping CEILING is above 1.0, so decay is observable"
                                            true (> mx-ceiling 1.0))
                                        ;;a full-term lock earns the ceiling exactly
                                        (expect "<<TX-AQP-CL07>> a FULL-term stake earns the ceiling exactly"
                                            (floor (* amt mx-ceiling) 6) alice-weight)
                                    ]
                                )
                                ;;--- half the lock elapses ---
                                (env-chain-data
                                    { "block-time": (add-time (at "block-time" (chain-data)) half-term) })
                                ;;the token is transfer-restricted (CL05 whitelisted the pool), so the
                                ;;buyer must be whitelisted too -- which is the gate working, not a
                                ;;workaround: `enforce-one` is satisfied by EITHER party holding a role.
                                (ref-TS01-C2::VST|C_ToggleTransferRoleSleepingDPOF
                                    patron (ouronet-ns.VST.URC_SpecialTransferRoleKonto z-lp-id) z-lp-id bob true)
                                (let*
                                    (
                                        (bob-pre:decimal (ref-SCR::UR_U-SCR|UserScoreBaseScore bob pool-id silver-score))
                                    )
                                    (ref-TS02-C3::AQP-POOL|CCp_ReassignCustodialBeneficiary
                                        patron alice pool-id z-lp-id n bob)
                                    (let*
                                        (
                                            (bob-weight:decimal
                                                (- (ref-SCR::UR_U-SCR|UserScoreBaseScore bob pool-id silver-score) bob-pre))
                                            ;;the midpoint: 1 + (150/300) x (ceiling - 1)
                                            (expected:decimal
                                                (floor (* amt (+ 1.0 (* 0.5 (- mx-ceiling 1.0)))) 6))
                                        )
                                        (map print
                                            [
                                                ;;THE RULING, ENFORCED. Half the term elapsed, so the buyer earns the
                                                ;;exact midpoint -- not the seller's ceiling.
                                                (expect "<<TX-AQP-CL07>> the buyer is RE-RATED to the half-term midpoint, not the seller's ceiling"
                                                    expected bob-weight)
                                                ;;and strictly less than the seller held, which is the whole point
                                                (expect "<<TX-AQP-CL07>> ...which is strictly LESS than the seller's weight"
                                                    true (< bob-weight alice-weight))
                                                ;;ALICE IS FULLY UNWOUND -- she keeps nothing of the position
                                                (expect "<<TX-AQP-CL07>> the seller's weight is fully removed"
                                                    base-pre (ref-SCR::UR_U-SCR|UserScoreBaseScore alice pool-id silver-score))
                                                ;;CONSERVATION: the score's GLOBAL total moved by the same amount the
                                                ;;user rows did. A re-rate applied to one and not the other would
                                                ;;corrupt every reward share computed from the total, silently.
                                                (expect "<<TX-AQP-CL07>> the score's global total reflects the re-rate exactly"
                                                    (floor (+ total-pre bob-weight) 6)
                                                    (floor (ref-SCR::UR_SCR|ScoreTotalBaseScore silver-score) 6))
                                            ]
                                        )
                                    )
                                )
                            )
                        )
                    )
                )
            )
        )
    )
    ""
)
(env-sigs [])
(print "===^^^===")
(commit-tx)
(print "")
(print "=== END [6.4]_AQP-TRIPLET-COLLECT.repl (custodial) ==========================")
