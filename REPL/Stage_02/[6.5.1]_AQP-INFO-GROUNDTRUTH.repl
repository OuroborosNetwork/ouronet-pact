(begin-tx "TX-INFO-GT-STREAM — INFO_AQP-FVT|InjectStream, the STREAMED twin of the fixed defect")
(env-gasmodel "table")(env-gaslimit 100000000)(env-gas 0)
(namespace "ouronet-ns")
(print "--- [TX-INFO-GT-STREAM · 01 · streamed inject: quoted vs charged] ---")
;;FUNCTION COVERAGE (G6) — `INFO_AQP-FVT|InjectStream`, per the owner's spec.
;;
;;WHY THIS BLOCK EXISTS SEPARATELY FROM <<TX-INFO-GT-INJECT>>. The custody-transfer leg that block
;;found missing was missing from FOUR previews, not one: `Inject`, `InjectStream`, `InjectFinalize`
;;and `MTX|2Inject` all quoted the gas leg alone while their execs concatenated a `TFT::C_Transfer`
;;ahead of it (`XI_FvtInjectCore` / `XIv_FvtAddStream`, `04_RPS.pact`). All four were repaired the
;;same way, but only `Inject` was ever put on a scale. A fix that is verified on one member of a
;;family and assumed on the other three is exactly the kind of claim this whole exercise exists to
;;stop making, so the streamed path gets its own measurement.
;;
;;`InjectStream` is not merely `Inject` with an extra argument: it routes through `XIv_FvtAddStream`
;;rather than `XI_FvtInjectCore`, so the two share a shape but not a code path. Duration is payload —
;;the 86400 below buys a day-long drip and must not touch the price.
;;
;;WSTOA, deliberately, NOT the GAS token: `XI_FvtInjectCore`'s PHASE 1 moves the reward PRINCIPAL out
;;of the patron's account, and if that principal were IGNIS it would land in the very balance this
;;block differences. Hazard, not defect — but it silently turns a passing test into a wrong one.
(env-sigs [{ "key": "PK_AncientHodler", "caps": [] }])
(let
    (
        (ref-TS02-C3:module{TalosStageTwo_ClientThreeV1} TS02-C3)
        (ref-DPTF:module{DemiourgosPactTrueFungibleV2} DPTF)
        (ref-DALOS:module{OuronetDalosV2} DALOS)
        (patron:string KST.ANHD)
        (gas-id:string "GAS-98c486052a51")
        (fvt-id:string "CodingDivisionTreasury-98c486052a51")
        (wstoa-id:string (ref-DALOS::UR_WrappedStoaID))
    )
    (let
        (
            (predicted:decimal
                (at "ignis-need" (at "ignis"
                    (AQP-INFO.INFO_AQP-FVT|InjectStream patron fvt-id wstoa-id 24.0 86400))))
            (pre-gas:decimal (ref-DPTF::UR_AccountSupply gas-id patron))
        )
        (print (format "<(TS02-C3.AQP-FVT|CC_InjectStream)> => \"{}\""
            [(ref-TS02-C3::AQP-FVT|CC_InjectStream patron patron fvt-id wstoa-id 24.0 86400)]))
        (let
            (
                (real:decimal (- pre-gas (ref-DPTF::UR_AccountSupply gas-id patron)))
            )
            (map print
                [
                    (format "<<TX-INFO-GT-STREAM>> predicted={} real={} delta={}"
                        [predicted real (- real predicted)])
                    (expect "<<TX-INFO-GT-STREAM>> the quote equals what the streamed inject charged"
                        real predicted)
                    (expect "<<TX-INFO-GT-STREAM>> ...and it is a real, non-zero charge"
                        true (> real 0.0))
                ]
            )
        )
    )
    ""
)
(env-sigs [])
(rollback-tx)

