;;
;; REPL/Stage_02/[6.5.1]_AQP-INFO-GROUNDTRUTH.repl — cost-equality ground truth for the
;; multi-leg stake/unstake info functions. Runs AFTER a full boot that provisions TfStakePool
;; (i.e. after [6.2.4]_AQP-FVT) and AFTER AQP-INFO is deployed.
;;
;; Proof: AQP-INFO.AQP-POOL|INFO_StakeTrueFungible.ignis-need == the REAL IGNIS (GAS token)
;; balance delta the patron pays for the actual TS02-C3.AQP-POOL|CC_StakeTrueFungible. The
;; preview is computed on pre-stake state; the execution acts on the same state → exact match.
;; Same for unstake (transfer leg reversed).
;;
(print "")
(print "================================================================")
(print "FILE  REPL/Stage_02/[6.5.1]_AQP-INFO-GROUNDTRUTH.repl")
(print "================================================================")
(print "Legend: <<TX-INFO-GT-*>> cost-equality asserts; <(…)> echoes.")
(print "")
;;
;;==== TX901 · 01 · TF stake cost equality ====
(begin-tx "TX-INFO-GT-TF-STAKE - INFO_StakeTrueFungible.ignis-need == real GAS delta")
(print "--- [TX901 · 01 · TF stake cost equality] ---")
(namespace "ouronet-ns")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(env-sigs [{ "key": "PK_AncientHodler", "caps": [] }])
(let*
    (
        (patron:string          KST.ANHD)
        (owner-id:string        KST.ANHD)
        (beneficiary-id:string  KST.ANHD)
        (ouro-id:string         "OURO-98c486052a51")
        (gas-id:string          "GAS-98c486052a51")
        (amount:decimal         100.0)
        (ref-U|DALOS:module{UtilityDalosV1}                 U|DALOS)
        (ref-DPTF:module{DemiourgosPactTrueFungibleV1}      DPTF)
        (ref-TS02-C3:module{TalosStageTwo_ClientThreeV1}    TS02-C3)
        (pool-id:string         (ref-U|DALOS::UDC_Makeid "TfStakePool"))
        ;; 1) PREVIEW on pre-stake state
        (info                   (AQP-INFO.AQP-POOL|INFO_StakeTrueFungible
                                    patron pool-id owner-id beneficiary-id ouro-id amount))
        (predicted:decimal      (at "ignis-need" (at "ignis" info)))
        (pre-gas:decimal        (ref-DPTF::UR_AccountSupply gas-id patron))
    )
    (print (format "<(INFO_StakeTrueFungible)> predicted ignis-need = {} ; patron pre-gas = {}"
        [predicted pre-gas]))
    ;; 2) EXECUTE the real stake (bills the patron the exact flow cost)
    (print (format "<(TS02-C3.AQP-POOL|CC_StakeTrueFungible)> => \"{}\""
        [(ref-TS02-C3::AQP-POOL|CC_StakeTrueFungible patron pool-id owner-id beneficiary-id ouro-id amount)]))
    ;; 3) ASSERT predicted == actual GAS balance delta
    (let ((post-gas:decimal (ref-DPTF::UR_AccountSupply gas-id patron)))
        (print (format "<(post-gas)> = {} ; actual delta = {}" [post-gas (- pre-gas post-gas)]))
        (map print
            [ (expect (format "TX-INFO-GT-TF-STAKE: INFO predicted {} == real GAS delta {}"
                  [predicted (- pre-gas post-gas)])
                predicted (- pre-gas post-gas)) ]))
)
(commit-tx)
(print "")
;;
