(begin-tx "TX-INFO-GT-SCRBCLINK — INFO_AQP-SCR|CreateScoreBoostClassLink quote vs measured charge")
(env-gasmodel "table")(env-gaslimit 100000000)(env-gas 0)
(namespace "ouronet-ns")
(print "--- [TX-INFO-GT-SCRBCLINK · 01 · link a score to a boost CLASS] ---")
;;FUNCTION COVERAGE (G6) — `INFO_AQP-SCR|CreateScoreBoostClassLink`, per the owner's spec.
;;NAMED BY AN ABORT-PIN IN `Kursan/aqp-info-tests.repl`, NEVER WEIGHED — see `REPL/tools/_info_measured.py`.
;;
;;NOT TO BE CONFUSED WITH ITS NEIGHBOUR. `CreateScoreBoostLink` (measured at <<TX-INFO-GT-SCRBOOST>>)
;;links a score to ANOTHER SCORE; this one links a score to a boost CLASS — an anchor-group object
;;that has no constructor of its own. A class is minted as a SIDE EFFECT of issuing an anchor with
;;`acnoi = true`, which is why there is no `C_IssueBoostClass` to call — and why the setup below has
;;to issue an ANCHOR just to obtain one. `[6.2.1]` creates `CoreBoostTFa` the same way, but it is
;;INACTIVE by this point in the chain, and the link guard demands an active class.
;;
;;The score is VIRGIN: the link is one-shot per score, and every standing score here is spoken for.
;;Its issue is a billed STOA op (measured at <<TX-INFO-GT-SCOREISSUE>>) and closes before the window.
(let
    (
        (ref-DALOS:module{OuronetDalosV2} DALOS)
        (ref-IGNIS:module{IgnisCollectorV3} IGNIS)
    )
    (let ((split-stoa:[decimal]
              (ref-DALOS::URC_SplitSTOAPrices KST.ANHD
                  (+ (ref-IGNIS::UC_StoaPrice "issue-score") (* 2.0 (ref-IGNIS::UC_StoaPrice "anchor"))))))
        (env-sigs
            [ { "key": "PK_AncientHodler", "caps": [] }
              { "key": "6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263"
              , "caps":
                [ (coin.TRANSFER "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263" "k:50d6c59b21e5e6e55baecaa75a1007de37576bde12d8230dc82459cc01b9484b" (at 2 split-stoa))
                  (coin.TRANSFER "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263" "k:0cb30c0121ff919266121a99ff9359871818932211df94dae4137c29bc0e8f7e" (at 0 split-stoa))
                  (coin.TRANSFER "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263" "c:XM-pkmuB5XUQlp87ZYSbfKt8qzmHY6O2EHAzMRVBt3k" (at 3 split-stoa))
                  (coin.TRANSFER "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263" "c:iQQFWj6gWtpGEzhM_O5ekW1QtnQQy55R8BRPGhj_0FU" (at 1 split-stoa)) ] } ]
        )
    )
)
(let
    (
        (ref-TS02-C3:module{TalosStageTwo_ClientThreeV1} TS02-C3)
        (ref-DPTF:module{DemiourgosPactTrueFungibleV2} DPTF)
        (ref-U|DALOS:module{UtilityDalosV2} U|DALOS)
        (patron:string KST.ANHD)
        (gas-id:string "GAS-98c486052a51")
        (boost-class:string "GtBcProbeClass-98c486052a51")
        (ouro-id:string "OURO-98c486052a51")
        (ouro-owner:string (AQP-ANK.URC_AnchorableAssetOwner ouro-id [true true]))
    )
    ;;SETUP — a FRESH boost class. `CoreBoostTFa` from `[6.2.1]` exists but is INACTIVE by this point
    ;;("BoostClass must be active", `02_SCORE.pact:894`), and a class has no constructor of its own: it
    ;;is minted as a side effect of issuing an anchor with `acnoi = true`, which is why the setup below
    ;;issues an ANCHOR to obtain one. That anchor issue costs 2x the STOA anchor price precisely
    ;;BECAUSE `acnoi` is true, which is what the cap split above is sized for.
    (print (format "<(setup issue anchor + mint boost class)> => \"{}\""
        [(ref-TS02-C3::AQP-ANK|C_IssueTrueFungibleAnchor patron ouro-owner "GtBcProbeAnchor" ouro-id true
            "GtBcProbeClass" 3 100.0 1000.0)]))
    (print (format "<(setup issue virgin score)> => \"{}\""
        [(ref-TS02-C3::AQP-SCR|C_IssueTrueFungibleScore patron patron "GtBcLinkScoreProbe" 12 1.0)]))
    (let
        (
            (fresh:string (ref-U|DALOS::UDC_Makeid "GtBcLinkScoreProbe"))
        )
        (let
            (
                (predicted:decimal
                    (at "ignis-need" (at "ignis"
                        (AQP-INFO.INFO_AQP-SCR|CreateScoreBoostClassLink patron fresh boost-class))))
                (pre-gas:decimal (ref-DPTF::UR_AccountSupply gas-id patron))
            )
            (print (format "<(TS02-C3.AQP-SCR|C_CreateScoreBoostClassLink)> => \"{}\""
                [(ref-TS02-C3::AQP-SCR|C_CreateScoreBoostClassLink patron fresh boost-class)]))
            (let
                (
                    (real:decimal (- pre-gas (ref-DPTF::UR_AccountSupply gas-id patron)))
                )
                (map print
                    [
                        (format "<<TX-INFO-GT-SCRBCLINK>> predicted={} real={} delta={}"
                            [predicted real (- real predicted)])
                        (expect "<<TX-INFO-GT-SCRBCLINK>> the quote equals what the op actually charged"
                            real predicted)
                        (expect "<<TX-INFO-GT-SCRBCLINK>> ...and it is a real, non-zero charge"
                            true (> real 0.0))
                    ]
                )
            )
        )
    )
    ""
)
(env-sigs [])
(rollback-tx)

