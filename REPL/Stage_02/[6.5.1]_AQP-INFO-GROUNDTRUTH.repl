(begin-tx "TX-INFO-GT-UNSTAKE-OF — INFO_AQP-POOL|UnstakeOrtoFungible quote vs measured charge")
(env-gasmodel "table")(env-gaslimit 100000000)(env-gas 0)
(namespace "ouronet-ns")
(print "--- [TX-INFO-GT-UNSTAKE-OF · 01 · unstake an orto-fungible position] ---")
;;FUNCTION COVERAGE (G6) — `INFO_AQP-POOL|UnstakeOrtoFungible`, per the owner's spec. Template: `modules/ATS.repl <<ATS-I1>>`.
;;
;;A MULTI-LEG PREVIEW. The unstake side reads `URCi_*StakeFlow`-family aggregates rather than the
;;single reader its exec bills, so preview and exec name different functions BY DESIGN and only a
;;scale can say whether they agree — the same class as the inject family, where exactly that gap hid
;;a missing custody-transfer leg.
;;
;;THE SETUP CHAIN IS ABORT -> ENABLE -> STAKE, and all three are forced by the file itself: the
;;blocks above deliberately DRAIN every position and a drain leaves the pool vacate-FROZEN with
;;staking DISABLED (`06_VCT.pact:3350`). Each setup op is billed and measured elsewhere
;;(<<TX-INFO-GT-ABORT>>, <<TX-INFO-GT-ENABLE>>), so they all close before `pre-gas` is read.
(env-sigs [{ "key": "PK_AncientHodler", "caps": [] }])
(let
    (
        (ref-TS02-C3:module{TalosStageTwo_ClientThreeV1} TS02-C3)
        (ref-DPTF:module{DemiourgosPactTrueFungibleV2} DPTF)
        (ref-DPOF:module{DemiourgosPactOrtoFungibleV2} DPOF)
        (ref-DPDC:module{DpdcV2} DPDC)
        (ref-U|DALOS:module{UtilityDalosV2} U|DALOS)
        (patron:string KST.ANHD)
        (gas-id:string "GAS-98c486052a51")
        (pool-id:string (ref-U|DALOS::UDC_Makeid "InfoGtOfDrPool"))
        (asset:string "MVST-98c486052a51")
    )
    (print (format "<(setup abort-vacate)> => \"{}\""
        [(ref-TS02-C3::AQP-POOL|C_AbortVacate patron pool-id)]))
    (print (format "<(setup enable-stake)> => \"{}\""
        [(ref-TS02-C3::AQP-POOL|C_EnablePoolStake patron (AQP-POOL.URC_AqpOwnerKonto pool-id) pool-id)]))
    (let
        (
            (owned:[integer] (ref-DPOF::URH_AccountNonces patron asset))
        )
        (enforce (> (length owned) 0) "TX-INFO-GT-UNSTAKE-OF: ANHD needs a nonce of MVST-98c486052a51 to stake")
        (let
            (
                (n:integer (at 0 owned))
            )
            (print (format "<(setup stake nonce {})> => \"{}\""
                [n (ref-TS02-C3::AQP-POOL|CC_StakeOrtoFungible patron pool-id patron patron asset [n])]))
            (let
                (
                    (predicted:decimal
                        (at "ignis-need" (at "ignis"
                            (AQP-INFO.INFO_AQP-POOL|UnstakeOrtoFungible patron pool-id patron patron asset [n]))))
