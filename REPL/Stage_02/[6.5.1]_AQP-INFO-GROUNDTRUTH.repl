(namespace "ouronet-ns")
(print "--- [TX-INFO-GT-INJECT · 01 · inject: quoted vs charged] ---")
;;FUNCTION COVERAGE (G6) — `INFO_AQP-FVT|Inject`, per the owner's spec: an INFO_ must report the same
;;cost the op actually charges.
;;
;;THE SPECIFIC SUSPICION THIS BLOCK EXISTS TO SETTLE. The preview quotes ONE leg:
;;    (OI|UC_IfpFromOutputCumulator (RPS.URCi_Inject "AQP-FVT|CC_Inject" fvt-id []))
;;but the exec collects `XB_FvtInject` -> `XI_FvtInjectCore`, whose cumulator concatenates a CUSTODY
;;TRANSFER ahead of that gas leg (`04_RPS.pact:4548-4561`):
;;    (ref-TFT::C_Transfer reward-dptf-id patron AQP|SC_NAME amount true)   ;;PHASE 1
;;    ... (URCi_Inject op-key fvt-id [...])                                 ;;the leg the preview quotes
;;
;;Every OTHER transfer-bearing AQP op has a `*Full` reader that counts its transfer leg explicitly —
;;`URCi_TrueFungibleStakeFlow` counts `TFT.URCi_TransferCumulator`, `URCi_CollectFull` counts
;;`URC_CollectTransferLegIgnis`, `URCi_Sync*Full` counts `ico-ank`. The inject family is the only one
;;with no `*Full` reader at all. If that asymmetry is an oversight, the quote is short by exactly the
;;transfer cumulator and this assertion fails; if the transfer is genuinely free, it passes.
;;
;;Either way the answer is worth having written down, which is why this asserts equality rather than
;;hedging: a test that cannot fail tells you nothing about which of the two it is.
;;
;;REWARD CHOICE MATTERS. The reward is WSTOA, deliberately NOT "GAS-98c486052a51": PHASE 1 moves the
;;reward PRINCIPAL out of the patron, so injecting GAS would move the very balance being differenced
;;and the measurement would read principal + fee as though it were all fee.
(env-sigs [{ "key": "PK_AncientHodler", "caps": [] }])
(let
    (
        (ref-TS02-C3:module{TalosStageTwo_ClientThreeV1} TS02-C3)
        (ref-DPTF:module{DemiourgosPactTrueFungibleV2} DPTF)
        (ref-DALOS:module{OuronetDalosV2} DALOS)
        (patron:string KST.ANHD)
        (fvt-id:string "CodingDivisionTreasury-98c486052a51")
        (gas-id:string "GAS-98c486052a51")
    )
    (let
        (
            (wstoa-id:string (ref-DALOS::UR_WrappedStoaID))
        )
        (let
            (
                (predicted:decimal
                    (at "ignis-need" (at "ignis"
                        (AQP-INFO.INFO_AQP-FVT|Inject patron fvt-id wstoa-id 25.0))))
                (pre-gas:decimal (ref-DPTF::UR_AccountSupply gas-id patron))
            )
            (print (format "<(TS02-C3.AQP-FVT|CC_Inject)> => \"{}\""
                [(ref-TS02-C3::AQP-FVT|CC_Inject patron patron fvt-id wstoa-id 25.0)]))
            (let
                (
                    (real:decimal (- pre-gas (ref-DPTF::UR_AccountSupply gas-id patron)))
                )
                (map print
                    [
                        (format "<<TX-INFO-GT-INJECT>> predicted={} real={} delta={}"
                            [predicted real (- real predicted)])
                        (expect "<<TX-INFO-GT-INJECT>> INFO_AQP-FVT|Inject's quote equals what the inject charged"
                            real predicted)
                        (expect "<<TX-INFO-GT-INJECT>> ...and it is a real, non-zero charge"
                            true (> real 0.0))
                    ]
                )
            )
        )
    )
    ""
)
(env-sigs [])
;;discarded — the vault's reward ledger is left as the earlier blocks built it
(rollback-tx)

;;|| NEXT >
;;
(begin-tx "TX-INFO-GT-SYNC — the hand-rebuilt anchor-sync reconstruction vs the real charge")
(env-gasmodel "table")(env-gaslimit 100000000)(env-gas 0)
(namespace "ouronet-ns")
(print "--- [TX-INFO-GT-SYNC · 01 · a reconstruction, not a shared reader] ---")
;;FUNCTION COVERAGE (G6) — `INFO_AQP-POOL|SyncTrueFungibleAnchors`, per the owner's spec.
;;
;;WHY THIS ONE IS WORTH A BLOCK OF ITS OWN. Most previews in this codebase call the SAME `URCi_` the
;;exec bills, so they cannot drift by construction. `URCi_SyncTrueFungibleAnchorsFull` is different:
;;it is a HAND-WRITTEN reconstruction of the exec's three legs —
;;    ico-ank   re-derives n-live from UR_ANK|AnchorsForAsset
;;    ico-meta  re-derives UDC_LegCumulator "ank-sync-count-tf"
;;    ico-gas   the shared gas reader
;;Two independent expressions that must evaluate equal. Nothing but arithmetic keeps them in step, so
;;this is where a reconstruction drifts first — and the cost SCALES with the live anchor count, so a
;;single-anchor fixture would not notice a per-anchor error at all.
;;
;;OURO deliberately: it carries TWO live anchors at this point (TfStakeAnchor + TfStakeAnchor2), so a
;;per-anchor mistake shows up as a doubled gap rather than cancelling out.
;;
;;This is also the highest per-leg ROUNDING exposure in the family: `UDC_PrimeIgnisCumulator`
;;discounts and quarter-splits EACH leg separately, while the preview applies one discount to the
;;summed ifp. Three legs is enough for that difference to surface if it exists.
(env-sigs [{ "key": "PK_AncientHodler", "caps": [] }])
(let
    (
        (ref-TS02-C3:module{TalosStageTwo_ClientThreeV1} TS02-C3)
        (ref-DPTF:module{DemiourgosPactTrueFungibleV2} DPTF)
        (ref-ANK:module{AcquisitionAnchorsV1} AQP-ANK)
        (patron:string KST.ANHD)
        (ouro-id:string "OURO-98c486052a51")
        (ouro-owner:string (AQP-ANK.URC_AnchorableAssetOwner ouro-id [true true]))
        (gas-id:string "GAS-98c486052a51")
    )
    ;;SETUP — the cap enforces `(> (UR_AQP|BenDptfTotalBalance beneficiary dptf) 0.0)`: there must be a
    ;;live cross-pool TF stake to repair. Every TF position in this file has been drained or vacated by
    ;;the blocks above, so one is re-staked here. `TfStakePool` is restakeable (the file re-stakes it
    ;;the same way at TX907's setup), and the whole tx rolls back.
    ;;...and the pool's stake flag has to be back ON first: a vacate DISABLES staking and deliberately
    ;;leaves it disabled, so the re-stake would be refused with "pool stake disabled or has no
    ;;employed scores". Enable is itself measured separately at <<TX-INFO-GT-ENABLE>> below; here it is
    ;;only setup, and it opens before the measurement window.
    ;;...and the enable is itself blocked while a vacate is open ("finish or abort the vacate first"),
    ;;so the full setup chain is ABORT -> ENABLE -> STAKE -> the sync being measured. Three ops of
    ;;setup for one measurement is the price of reaching a repair path in a file whose earlier blocks
    ;;deliberately leave every pool drained and frozen.
    (print (format "<(setup abort-vacate)> => \"{}\""
        [(ref-TS02-C3::AQP-POOL|C_AbortVacate patron "TfStakePool-98c486052a51")]))
    (print (format "<(setup enable-stake)> => \"{}\""
        [(ref-TS02-C3::AQP-POOL|C_EnablePoolStake patron (AQP-POOL.URC_AqpOwnerKonto "TfStakePool-98c486052a51") "TfStakePool-98c486052a51")]))
    (print (format "<(setup re-stake)> => \"{}\""
        [(ref-TS02-C3::AQP-POOL|CC_StakeTrueFungible patron "TfStakePool-98c486052a51" patron patron ouro-id 100.0)]))
    (let
        (
            (n-live:integer (length (ref-ANK::UR_ANK|AnchorsForAsset ouro-id)))
        )
        (let
            (
                (predicted:decimal
                    (at "ignis-need" (at "ignis"
                        (AQP-INFO.INFO_AQP-POOL|SyncTrueFungibleAnchors patron patron ouro-id))))
                (pre-gas:decimal (ref-DPTF::UR_AccountSupply gas-id patron))
            )
            (print (format "<(TS02-C3.AQP-POOL|C_SyncTrueFungibleAnchors)> => \"{}\""
                [(ref-TS02-C3::AQP-POOL|C_SyncTrueFungibleAnchors patron patron ouro-id)]))
            (let
                (
                    (real:decimal (- pre-gas (ref-DPTF::UR_AccountSupply gas-id patron)))
                )
                (map print
                    [
                        (format "<<TX-INFO-GT-SYNC>> anchors={} predicted={} real={} delta={}"
                            [n-live predicted real (- real predicted)])
                        (expect "<<TX-INFO-GT-SYNC>> the reconstruction equals what the sync actually charged"
                            real predicted)
                        (expect "<<TX-INFO-GT-SYNC>> ...and it is a real, non-zero charge"
                            true (> real 0.0))
                        ;;the fixture has to be MULTI-anchor for this to test the scaling term at all
                        (expect "<<TX-INFO-GT-SYNC>> ...against a multi-anchor asset, so the per-anchor term is exercised"
                            true (> n-live 1))
                    ]
                )
            )
        )
    )
    ""
)
(env-sigs [])
(rollback-tx)

;;|| NEXT >
;;
(begin-tx "TX-INFO-GT-ENABLE — INFO_AQP-POOL|EnablePoolStake quote vs measured charge")
(env-gasmodel "table")(env-gaslimit 100000000)(env-gas 0)
(namespace "ouronet-ns")
(print "--- [TX-INFO-GT-ENABLE · 01 · re-open a drained pool to staking] ---")
;;FUNCTION COVERAGE (G6) — `INFO_AQP-POOL|EnablePoolStake`, per the owner's spec.
;;
;;The fixture is a by-product of the drain blocks above: `CCp_BatchDrain*` runs `XI_EnsureVacateBegun`
;;and explicitly does NOT finalize, so the drained pools are left vacate-in-progress with staking
;;DISABLED. That makes `true` the reachable direction for exactly these three pools and nowhere else
;;in the file — enable/disable both refuse a no-op change.
(env-sigs [{ "key": "PK_AncientHodler", "caps": [] }])
(let
    (
        (ref-TS02-C3:module{TalosStageTwo_ClientThreeV1} TS02-C3)
        (ref-DPTF:module{DemiourgosPactTrueFungibleV2} DPTF)
        (ref-AQP:module{AcquisitionPoolsV1} AQP-POOL)
        (patron:string KST.ANHD)
        (pool-id:string "InfoGtOfDrPool-98c486052a51")
        (gas-id:string "GAS-98c486052a51")
    )
    ;;SETUP — a drained pool is left vacate-in-progress, and enabling stake is refused while a vacate
    ;;is open. Aborting first is what makes the enable reachable. The abort costs nothing (it collects
    ;;an EMPTY cumulator), which is measured in its own right at <<TX-INFO-GT-ABORT>> below — so it
    ;;cannot contribute to the figure measured here either.
    (print (format "<(setup abort-vacate)> => \"{}\""
        [(ref-TS02-C3::AQP-POOL|C_AbortVacate patron pool-id)]))
    (let
        (
            (predicted:decimal
                (at "ignis-need" (at "ignis"
                    (AQP-INFO.INFO_AQP-POOL|EnablePoolStake patron pool-id))))
            (pre-gas:decimal (ref-DPTF::UR_AccountSupply gas-id patron))
        )
        (print (format "<(TS02-C3.AQP-POOL|C_EnablePoolStake)> => \"{}\""
            [(ref-TS02-C3::AQP-POOL|C_EnablePoolStake patron (AQP-POOL.URC_AqpOwnerKonto pool-id) pool-id)]))
        (let
            (
                (real:decimal (- pre-gas (ref-DPTF::UR_AccountSupply gas-id patron)))
            )
            (map print
                [
                    (format "<<TX-INFO-GT-ENABLE>> predicted={} real={}" [predicted real])
                    (expect "<<TX-INFO-GT-ENABLE>> the quote equals what enabling stake charged"
                        real predicted)
                    (expect "<<TX-INFO-GT-ENABLE>> ...and it is a real, non-zero charge"
                        true (> real 0.0))
                    ;;and it really flipped, so neither figure is for a no-op
                    (expect "<<TX-INFO-GT-ENABLE>> ...and the pool is genuinely open to staking again"
                        true (ref-AQP::UR_AQP|PoolStakeEnabled pool-id))
                ]
            )
        )
    )
    ""
)
(env-sigs [])
(rollback-tx)

;;|| NEXT >
