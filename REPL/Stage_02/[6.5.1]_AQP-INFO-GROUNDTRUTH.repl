                        (format "<<TX-INFO-GT-SCRBOOST>> predicted={} real={} delta={}"
                            [predicted real (- real predicted)])
                        (expect "<<TX-INFO-GT-SCRBOOST>> the quote equals what the op actually charged"
                            real predicted)
                        (expect "<<TX-INFO-GT-SCRBOOST>> ...and it is a real, non-zero charge"
