(print "--- [TX-INFO-GT-QSPLIT · 01 · set a multiplet reward quality split] ---")
;;FUNCTION COVERAGE (G6) — `INFO_AQP-FVT|SetQualitySplit`, per the owner's spec. Template:
;;`modules/ATS.repl <<ATS-I1>>`. Named by an abort-pin in `Kursan/aqp-info-tests.repl`, never weighed.
;;
;;THE DEEPEST FIXTURE IN THE SURFACE, and it stacks on the previous block's. `UEV_QualitySplitContext`
;;(`04_RPS.pact:3033`) requires the reward link to be of kind MULTIPLET_BASE, which `AddRewardLink`
;;only sets when handed a live multiplet family — and a family needs the two-rung ATS ladder built at
;;<<TX-INFO-GT-MULTIPLET>>. So the chain is: three virgin DPTFs -> two virgin ATS pairs -> the family
;;-> a virgin FVT -> a MULTIPLET_BASE reward link -> and only then the op under test.
;;Eight setup ops, every one of them measured elsewhere, all closing before `pre-gas` is read.
;;This is why the op read as "no fixture" for so long: nothing was missing, the prerequisites were
;;simply five deep.
(env-sigs
    [
        { "key": "PK_AncientHodler", "caps": [] }
        { "key": "6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263" ,
          "caps":
            [
                (coin.TRANSFER "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263" "k:50d6c59b21e5e6e55baecaa75a1007de37576bde12d8230dc82459cc01b9484b" 1000000.0)
                (coin.TRANSFER "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263" "k:0cb30c0121ff919266121a99ff9359871818932211df94dae4137c29bc0e8f7e" 1000000.0)
                (coin.TRANSFER "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263" "c:XM-pkmuB5XUQlp87ZYSbfKt8qzmHY6O2EHAzMRVBt3k" 1000000.0)
                (coin.TRANSFER "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263" "c:iQQFWj6gWtpGEzhM_O5ekW1QtnQQy55R8BRPGhj_0FU" 1000000.0)
            ]
        }
    ]
)
(let
    (
        (ref-TS01-C1:module{TalosStageOne_ClientOneV2} TS01-C1)
        (ref-TS01-C2:module{TalosStageOne_ClientTwoV2} TS01-C2)
        (ref-TS02-C3:module{TalosStageTwo_ClientThreeV1} TS02-C3)
        (ref-DPTF:module{DemiourgosPactTrueFungibleV2} DPTF)
        (ref-RPS:module{AcquisitionRewardPerShareV1} RPS)
        (patron:string KST.ANHD)
        (t0:string "GTM0-98c486052a51")
        (t1:string "GTM1-98c486052a51")
        (t2:string "GTM2-98c486052a51")
        (p01:string "GtMultPair01-98c486052a51")
        (p12:string "GtMultPair12-98c486052a51")
        (gas-id:string "GAS-98c486052a51")
    )
    ;;SETUP — three virgin DPTFs and the two-rung ATS ladder that chains them.
    (ref-TS01-C1::DPTF|C_Issue patron patron ["GtMultTok0"] ["GTM0"] [24] [true] [true] [true] [true] [true] [true])
    (ref-TS01-C1::DPTF|C_Issue patron patron ["GtMultTok1"] ["GTM1"] [24] [true] [true] [true] [true] [true] [true])
    (ref-TS01-C1::DPTF|C_Issue patron patron ["GtMultTok2"] ["GTM2"] [24] [true] [true] [true] [true] [true] [true])
    (ref-TS01-C2::ATS|C_Issue patron patron ["GtMultPair01"] [24] [t0] [false] [t1] [true])
    (ref-TS01-C2::ATS|C_Issue patron patron ["GtMultPair12"] [24] [t1] [false] [t2] [true])
    (print (format "<(setup issue family)> => \"{}\""
        [(ref-TS02-C3::AQP-FVT|C_IssueMultipletFamily patron t0 t1 t2 p01 p12)]))
    (print (format "<(setup issue virgin FVT)> => \"{}\""
        [(ref-TS02-C3::AQP-FVT|C_Issue patron "GtQSplitProbeVault" patron 1 "|")]))
    ;;THE FAMILY ID IS DERIVED, NOT THE BASE TOKEN. `XI_IssueMultipletFamily` keys the row on
    ;;`UCk_MultipletFamily token-0 token-1 token-2` (`04_RPS.pact:3506`), a composite of all three — not
    ;;on token-0, which is the intuitive guess and fails as a raw table miss on `FVT|T|MultipletFamily`
    ;;naming the TOKEN id, so the message reads like the family was never created.
    (let
        (
            (fvt:string "GtQSplitProbeVault-98c486052a51")
            (family:string (ref-RPS::UCk_MultipletFamily t0 t1 t2))
        )
    (print (format "<(setup add MULTIPLET_BASE reward link)> => \"{}\""
        [(ref-TS02-C3::AQP-FVT|C_AddRewardLink patron fvt t0 false family)]))
    (let
        (
            (predicted:decimal
                (at "ignis-need" (at "ignis"
                    (AQP-INFO.INFO_AQP-FVT|SetQualitySplit patron fvt t0 "HOMOGENEOUS"
                        [1000 0 0] [1000 0 0] [1000 0 0]))))
            (pre-gas:decimal (ref-DPTF::UR_AccountSupply gas-id patron))
        )
        (print (format "<(TS02-C3.AQP-FVT|C_SetQualitySplit)> => \"{}\""
            [(ref-TS02-C3::AQP-FVT|C_SetQualitySplit patron fvt t0 "HOMOGENEOUS"
                [1000 0 0] [1000 0 0] [1000 0 0])]))
        (let
            (
                (real:decimal (- pre-gas (ref-DPTF::UR_AccountSupply gas-id patron)))
            )
            (map print
                [
                    (format "<<TX-INFO-GT-QSPLIT>> predicted={} real={} delta={}"
                        [predicted real (- real predicted)])
                    (expect "<<TX-INFO-GT-QSPLIT>> the quote equals what the op actually charged"
                        real predicted)
                    (expect "<<TX-INFO-GT-QSPLIT>> ...and it is a real, non-zero charge"
                        true (> real 0.0))
                ]
            )
        )
    )
    )
    ""
)
(env-sigs [])
(rollback-tx)
