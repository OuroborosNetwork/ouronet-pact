(begin-tx "TX-INFO-GT-POOLISSUE — INFO_AQP-POOL|Issue: both currencies measured")
(env-gasmodel "table")(env-gaslimit 100000000)(env-gas 0)
(namespace "ouronet-ns")
(print "--- [TX-INFO-GT-POOLISSUE · 01 · issue an acquisition pool] ---")
;;FUNCTION COVERAGE (G6) — `INFO_AQP-POOL|Issue`, per the owner's spec: an INFO_ must report the same cost the
;;op actually charges. BOTH currencies are checked — checking only IGNIS is what let
;;`INFO_EQUITY|IssueCompany` quote a 918-STOA operation as free.
;;The preview is state-independent (`URCi_Issue []`, konto `AQP|SC_NAME`), so a fresh name is all
;;this needs — no existing fixture to disturb, and the whole tx rolls back.
(let
    (
        (ref-DALOS:module{OuronetDalosV2} DALOS)
        (ref-IGNIS:module{IgnisCollectorV3} IGNIS)
    )
    ;;The STOA fee is a real coin.transfer split 10/20/30/40 across the four fee targets, so it needs
    ;;one managed `coin.TRANSFER` per leg, sized from the same split the collector uses.
    (let ((split-stoa:[decimal]
              (ref-DALOS::URC_SplitSTOAPrices KST.ANHD (ref-IGNIS::UC_StoaPrice "issue-pool"))))
        (env-sigs
            [ { "key": "PK_AncientHodler", "caps": [] }
              { "key": "6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263"
              , "caps":
                [ (coin.TRANSFER "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263"
                      "k:50d6c59b21e5e6e55baecaa75a1007de37576bde12d8230dc82459cc01b9484b" (at 2 split-stoa))
                  (coin.TRANSFER "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263"
                      "k:0cb30c0121ff919266121a99ff9359871818932211df94dae4137c29bc0e8f7e" (at 0 split-stoa))
                  (coin.TRANSFER "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263"
                      "c:XM-pkmuB5XUQlp87ZYSbfKt8qzmHY6O2EHAzMRVBt3k" (at 3 split-stoa))
                  (coin.TRANSFER "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263"
                      "c:iQQFWj6gWtpGEzhM_O5ekW1QtnQQy55R8BRPGhj_0FU" (at 1 split-stoa)) ] } ]
        )
    )
)
(let
    (
        (ref-TS02-C3:module{TalosStageTwo_ClientThreeV1} TS02-C3)
        (ref-DPTF:module{DemiourgosPactTrueFungibleV2} DPTF)
        (ref-DALOS:module{OuronetDalosV2} DALOS)
        (patron:string KST.ANHD)
        (gas-id:string "GAS-98c486052a51")
    )
    (let
        (
            (predicted:object{OuronetInfoV2.ClientInfo} (AQP-INFO.INFO_AQP-POOL|Issue patron "GtCostProbePool" "OURO-98c486052a51" 1))
            (stoa-acct:string (ref-DALOS::UR_AccountStoa patron))
        )
        (let
            (
                (pre-gas:decimal (ref-DPTF::UR_AccountSupply gas-id patron))
                (pre-stoa:decimal (coin.get-balance stoa-acct))
                (m (ref-TS02-C3::AQP-POOL|C_Issue patron (AQP-POOL.URC_AqpOwnerKontoFromClassAndAsset 1 "OURO-98c486052a51") "GtCostProbePool" "OURO-98c486052a51" 1))
            )
            (map print
                [
                    (format "<<TX-INFO-GT-POOLISSUE>> IGNIS predicted={} real={} | STOA predicted={} real={}"
                        [(at "ignis-need" (at "ignis" predicted))
                         (- pre-gas (ref-DPTF::UR_AccountSupply gas-id patron))
                         (at "stoa-need" (at "stoa" predicted))
                         (- pre-stoa (coin.get-balance stoa-acct))])
                    (expect "<<TX-INFO-GT-POOLISSUE>> the IGNIS quote equals the IGNIS charged"
                        (- pre-gas (ref-DPTF::UR_AccountSupply gas-id patron))
                        (at "ignis-need" (at "ignis" predicted)))
                    (expect "<<TX-INFO-GT-POOLISSUE>> the STOA quote equals the STOA charged"
                        (- pre-stoa (coin.get-balance stoa-acct))
                        (at "stoa-need" (at "stoa" predicted)))
                    (expect "<<TX-INFO-GT-POOLISSUE>> ...and issuance is NOT free in STOA"
                        true (> (- pre-stoa (coin.get-balance stoa-acct)) 0.0))
                ]
            )
        )
    )
    ""
)
(env-sigs [])
(rollback-tx)

