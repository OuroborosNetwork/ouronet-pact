;;==== TX914 · 03 · FULL-VACATE cost equality (Σ over lanes, single-tx scan+exec) ====
(begin-tx "TX-INFO-GT-FULLVACATE - INFO_FullVacate.ignis-need == real GAS delta")
(print "--- [TX914 · 03 · full-vacate cost equality] ---")
(namespace "ouronet-ns")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
;;==== TX-INFO-GT-FULLVACATE - INFO_FullVacate.ignis-need == real GAS delta · 01 · env-sigs (caps) ==== 
(print "--- [TX-INFO-GT-FULLVACATE - INFO_FullVacate.ignis-need == real GAS delta · 01 · env-sigs (caps)] ---")
(env-sigs [{ "key": "PK_AncientHodler", "caps": [] }])
;;==== TX-INFO-GT-FULLVACATE - INFO_FullVacate.ignis-need == real GAS delta · 02 · let / invocation ==== 
(print "--- [TX-INFO-GT-FULLVACATE - INFO_FullVacate.ignis-need == real GAS delta · 02 · let / invocation] ---")
(let
    (
        (patron:string KST.ANHD) (gas-id:string "GAS-98c486052a51")
        (ref-U|DALOS:module{UtilityDalosV2} U|DALOS)
        (ref-DPTF:module{DemiourgosPactTrueFungibleV2} DPTF)
        (ref-TS02-C3:module{TalosStageTwo_ClientThreeV1} TS02-C3)
        (pool-id:string (ref-U|DALOS::UDC_Makeid "InfoGtFvPool"))
    )
    ;; PHASE-1 dirty-read scan fed to both INFO and exec. Class-1 (TF-family): the exec's
    ;; CC_FullVacate scans TF + OF satellite lanes ONLY (never collectables), so coll-lanes = [].
    (let
        (
            (tf-lanes:[object{AcquisitionSchemasV1.VCT|VacateTfLane}] (AQP-VCT.URH_VacateTrueFungiblePoolLegs pool-id))
            (of-lanes:[object{AcquisitionSchemasV1.VCT|VacateNonceLane}] (AQP-VCT.URH_VacateOrtoFungiblePoolLegs pool-id))
            (coll-lanes:[object{AcquisitionSchemasV1.VCT|VacateNonceLane}] [])
        )
        (let
            (
                (predicted:decimal
                    (at "ignis-need" (at "ignis"
                        (AQP-INFO.INFO_AQP-POOL|FullVacate patron pool-id tf-lanes of-lanes coll-lanes false))))
                (pre-gas:decimal (ref-DPTF::UR_AccountSupply gas-id patron))
            )
            (print (format "<(INFO_FullVacate)> predicted ignis-need = {} ; lanes = {}tf/{}of/{}coll ; pre-gas = {}"
                [predicted (length tf-lanes) (length of-lanes) (length coll-lanes) pre-gas]))
            (print (format "<(CC_FullVacate)> => \"{}\""
                [(ref-TS02-C3::AQP-POOL|CC_FullVacate patron pool-id)]))
            (let ((post-gas:decimal (ref-DPTF::UR_AccountSupply gas-id patron)))
                (print (format "<(post-gas)> = {} ; actual delta = {}" [post-gas (- pre-gas post-gas)]))
                (map print
                    [ (expect (format "TX-INFO-GT-FULLVACATE: INFO predicted {} == real GAS delta {}"
                          [predicted (- pre-gas post-gas)])
                        predicted (- pre-gas post-gas)) ]))
        )
    )
)
(commit-tx)
