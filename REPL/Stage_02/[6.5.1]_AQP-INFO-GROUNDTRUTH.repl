(begin-tx "TX-INFO-GT-FVTISSUE — INFO_AQP-FVT|Issue: both currencies measured")
(env-gasmodel "table")(env-gaslimit 100000000)(env-gas 0)
(namespace "ouronet-ns")
(print "--- [TX-INFO-GT-FVTISSUE · 01 · issue a farm/vault/treasury] ---")
;;FUNCTION COVERAGE (G6) — `INFO_AQP-FVT|Issue`, per the owner's spec: an INFO_ must report the same cost the
;;op actually charges. BOTH currencies are checked — checking only IGNIS is what let
;;`INFO_EQUITY|IssueCompany` quote a 918-STOA operation as free.
(let
