(begin-tx "TX-INFO-GT-FVTMOSAIC — INFO_AQP-FVT|SetMosaic quote vs measured charge")
(env-gasmodel "table")(env-gaslimit 100000000)(env-gas 0)
(namespace "ouronet-ns")
(print "--- [TX-INFO-GT-FVTMOSAIC · 01 · flip a FRESH FVT's mosaic flag] ---")
;;FUNCTION COVERAGE (G6) — `INFO_AQP-FVT|SetMosaic`, per the owner's spec.
;;
;;THE FVT HAS TO BE BRAND NEW, and that is the whole difficulty. `UEV_SetMosaicContext` enforces
;;    (= (RPS::UR_FVT|MemberLinkCount fvt-id) 0)   "Cannot change mosaic while ScoreEntityLink rows exist"
;;(`05_FVT.pact:1829`), and EVERY standing FVT in this chain already carries a link — `REPL_BootstrapVault`
;;writes a ScoreEntityLink at creation (`05_FVT.pact:3648`). So the op is unreachable on
;;`CodingDivisionTreasury`, `OuroLpFarm` and the rest, no matter which one is picked. Issuing a fresh
;;FVT in setup is the only way to reach it, and `C_Issue` produces one with no links yet.
;;
;;The issue is a billed, STOA-charging op (measured on its own at <<TX-INFO-GT-FVTISSUE>>), so it needs
;;its managed caps AND must close before `pre-gas` is read — otherwise its cost lands in this figure.
(let
    (
        (ref-DALOS:module{OuronetDalosV2} DALOS)
        (ref-IGNIS:module{IgnisCollectorV3} IGNIS)
    )
    (let ((split-stoa:[decimal]
              (ref-DALOS::URC_SplitSTOAPrices KST.ANHD (ref-IGNIS::UC_StoaPrice "issue-fvt"))))
        (env-sigs
            [ { "key": "PK_AncientHodler", "caps": [] }
              { "key": "6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263"
              , "caps":
                [ (coin.TRANSFER "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263"
                      "k:50d6c59b21e5e6e55baecaa75a1007de37576bde12d8230dc82459cc01b9484b" (at 2 split-stoa))
                  (coin.TRANSFER "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263"
                      "k:0cb30c0121ff919266121a99ff9359871818932211df94dae4137c29bc0e8f7e" (at 0 split-stoa))
                  (coin.TRANSFER "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263"
                      "c:XM-pkmuB5XUQlp87ZYSbfKt8qzmHY6O2EHAzMRVBt3k" (at 3 split-stoa))
                  (coin.TRANSFER "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263"
                      "c:iQQFWj6gWtpGEzhM_O5ekW1QtnQQy55R8BRPGhj_0FU" (at 1 split-stoa)) ] } ]
        )
    )
)
(let
    (
        (ref-TS02-C3:module{TalosStageTwo_ClientThreeV1} TS02-C3)
        (ref-DPTF:module{DemiourgosPactTrueFungibleV2} DPTF)
        (ref-RPS:module{AcquisitionRewardPerShareV1} RPS)
        (ref-U|DALOS:module{UtilityDalosV2} U|DALOS)
        (patron:string KST.ANHD)
        (gas-id:string "GAS-98c486052a51")
    )
    ;;SETUP — a link-free FVT, outside the measurement window.
    (print (format "<(setup issue fresh FVT)> => \"{}\""
        [(ref-TS02-C3::AQP-FVT|C_Issue patron "GtMosaicProbeVault" patron 1 "|")]))
    (let
        (
            (fresh:string (ref-U|DALOS::UDC_Makeid "GtMosaicProbeVault"))
        )
        (let
            (
                (predicted:decimal
                    (at "ignis-need" (at "ignis" (AQP-INFO.INFO_AQP-FVT|SetMosaic patron fresh true))))
                (pre-gas:decimal (ref-DPTF::UR_AccountSupply gas-id patron))
            )
            (print (format "<(TS02-C3.AQP-FVT|C_SetMosaic)> => \"{}\""
                [(ref-TS02-C3::AQP-FVT|C_SetMosaic patron fresh true)]))
            (let
                (
                    (real:decimal (- pre-gas (ref-DPTF::UR_AccountSupply gas-id patron)))
                )
                (map print
                    [
                        ;;the precondition the guard actually reads, asserted rather than assumed
                        (expect "<<TX-INFO-GT-FVTMOSAIC>> the fresh FVT really has no score-entity links yet"
                            0 (ref-RPS::UR_FVT|MemberLinkCount fresh))
                        (format "<<TX-INFO-GT-FVTMOSAIC>> predicted={} real={} delta={}"
                            [predicted real (- real predicted)])
                        (expect "<<TX-INFO-GT-FVTMOSAIC>> the quote equals what the op actually charged"
                            real predicted)
                        (expect "<<TX-INFO-GT-FVTMOSAIC>> ...and it is a real, non-zero charge"
                            true (> real 0.0))
                    ]
                )
            )
        )
    )
    ""
)
(env-sigs [])
(rollback-tx)

