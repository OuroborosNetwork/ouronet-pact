(begin-tx "TX-INFO-GT-ABORT — closing the AbortVacate proof that was split across two files")
(env-gasmodel "table")(env-gaslimit 100000000)(env-gas 0)
(namespace "ouronet-ns")
(print "--- [TX-INFO-GT-ABORT · 01 · preview and charge, finally in the same file] ---")
;;FUNCTION COVERAGE (G6) — `INFO_AQP-POOL|AbortVacate`, per the owner's spec.
;;
;;THIS CLOSES A PROOF THE CODEBASE SAID COULD NOT BE CLOSED. `Stage_02/[6.5]_AQP-INFO.repl` states:
;;    "The other half of the proof -- that the op really charges nothing when it runs -- is measured
;;     in Stage_02/[6.2.5]_AQP-VCT.repl <<TX-VCT-L03>>, against a live abort. It cannot live here
;;     (no vacate-in-progress pool), and this cannot live there (AQP-INFO is not loaded in every
;;     chain that runs that file)."
;;Both halves of that were true when written. The second still is. The FIRST is no longer: the drain
;;blocks added to this file leave `InfoGt*DrPool` vacate-in-progress by design, because
;;`CCp_BatchDrain*` runs `XI_EnsureVacateBegun` and explicitly does not finalize. So a live abort is
;;now available in a chain that DOES load `AQP-INFO`, and the quote and the charge can finally be
;;compared in one place.
;;
;;THE ASSERTION IS A ZERO, AND THAT NEEDS CARE. `INFO_AQP-POOL|AbortVacate` quotes "Costs you
;;nothing" for an op that visibly calls `IGNIS::C_Collect` — the exact shape that WAS a defect in
;;INFO_EQUITY|IssueCompany, INFO_SWP|ToggleFeeLock and INFO_ATS|ToggleParameterLock. It is correct
;;here only because `C_AbortVacate` returns `UC_EmptyOc`, and collecting an empty cumulator collects
;;nothing. The `(> real 0.0)` guard every other block in this family carries cannot apply, so what
;;keeps this honest instead is the third assertion: the op is proven to have DONE something. A free
;;op that is also a no-op fails that, not the equality.
(env-sigs [{ "key": "PK_AncientHodler", "caps": [] }])
(let
    (
        (ref-TS02-C3:module{TalosStageTwo_ClientThreeV1} TS02-C3)
        (ref-DPTF:module{DemiourgosPactTrueFungibleV2} DPTF)
        (ref-VCT:module{AcquisitionVacateV1} AQP-VCT)
        (patron:string KST.ANHD)
        (pool-id:string "InfoGtSfDrPool-98c486052a51")
        (gas-id:string "GAS-98c486052a51")
    )
    (map print
        [
            (expect "<<TX-INFO-GT-ABORT>> precondition: the drain really did leave a vacate open"
                true (ref-VCT::UR_VacateInProgress pool-id))
        ]
    )
    (let
        (
            (predicted:decimal
                (at "ignis-need" (at "ignis" (AQP-INFO.INFO_AQP-POOL|AbortVacate patron pool-id))))
            (predicted-stoa:decimal
                (at "stoa-need" (at "stoa" (AQP-INFO.INFO_AQP-POOL|AbortVacate patron pool-id))))
            (pre-gas:decimal (ref-DPTF::UR_AccountSupply gas-id patron))
        )
        (print (format "<(TS02-C3.AQP-POOL|C_AbortVacate)> => \"{}\""
            [(ref-TS02-C3::AQP-POOL|C_AbortVacate patron pool-id)]))
        (let
            (
                (real:decimal (- pre-gas (ref-DPTF::UR_AccountSupply gas-id patron)))
            )
            (map print
                [
                    (format "<<TX-INFO-GT-ABORT>> IGNIS predicted={} real={} | STOA predicted={}"
                        [predicted real predicted-stoa])
                    (expect "<<TX-INFO-GT-ABORT>> the quote equals what the abort charged"
                        real predicted)
                    (expect "<<TX-INFO-GT-ABORT>> ...and the quote really is zero: an empty cumulator collects nothing"
                        0.0 real)
                    ;;NON-VACUITY, standing in for the (> real 0.0) guard this op cannot have:
                    ;;the abort demonstrably did work, so zero is the price of something, not of nothing.
                    (expect "<<TX-INFO-GT-ABORT>> ...and the vacate really was cleared, so zero is not the price of a no-op"
                        false (ref-VCT::UR_VacateInProgress pool-id))
                ]
            )
        )
    )
    ""
)
(env-sigs [])
(rollback-tx)

;;|| NEXT >
