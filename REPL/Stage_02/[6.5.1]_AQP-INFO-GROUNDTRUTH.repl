(print "")
;;==== TX911 · 03 · TF batch-DRAIN cost equality (data-dependent UserUnn==0 subset -> real GAS delta) ====
(begin-tx "TX-INFO-GT-TF-DRAIN - INFO_BatchDrainTrueFungible.ignis-need == real GAS delta")
(print "--- [TX911 · 03 · TF batch-drain cost equality] ---")
(namespace "ouronet-ns")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(env-sigs [{ "key": "PK_AncientHodler", "caps": [] }])
(let
    (
        (patron:string KST.ANHD) (gas-id:string "GAS-98c486052a51")
        (ref-U|DALOS:module{UtilityDalosV1} U|DALOS)
        (ref-DPTF:module{DemiourgosPactTrueFungibleV1} DPTF)
        (ref-TS02-C3:module{TalosStageTwo_ClientThreeV1} TS02-C3)
        (pool-id:string (ref-U|DALOS::UDC_Makeid "InfoGtTfDrPool"))
    )
    ;; PHASE-1 dirty-read scan: the exact TF lane plan, fed to BOTH INFO and exec.
    (let
        (
            (lane:object{AQP-VCT.VCT|VacateTfLane} (at 0 (AQP-VCT.URH_VacateTrueFungiblePoolLegs pool-id)))
        )
        (let
            (
                (dptf-id:string (at "asset-id" lane))
                (legs:[object{AQP-VCT.VCT|VacateTfLeg}] (at "legs" lane))
            )
            (let
                (
                    (predicted:decimal
                        (at "ignis-need" (at "ignis"
                            (AQP-INFO.AQP-POOL|INFO_BatchDrainTrueFungible patron pool-id dptf-id legs))))
                    (pre-gas:decimal (ref-DPTF::UR_AccountSupply gas-id patron))
                )
                (print (format "<(INFO_BatchDrainTrueFungible)> predicted ignis-need = {} ; legs = {} ; pre-gas = {}"
                    [predicted (length legs) pre-gas]))
                (print (format "<(TS02-C3.AQP-POOL|CCp_BatchDrainTrueFungible)> => \"{}\""
                    [(ref-TS02-C3::AQP-POOL|CCp_BatchDrainTrueFungible
                        patron pool-id dptf-id
                        (map (lambda (l:object{AQP-VCT.VCT|VacateTfLeg}) (at "owner-id" l)) legs)
                        (map (lambda (l:object{AQP-VCT.VCT|VacateTfLeg}) (at "beneficiary-id" l)) legs)
                        (map (lambda (l:object{AQP-VCT.VCT|VacateTfLeg}) (at "balance" l)) legs))]))
                (let ((post-gas:decimal (ref-DPTF::UR_AccountSupply gas-id patron)))
                    (print (format "<(post-gas)> = {} ; actual delta = {}" [post-gas (- pre-gas post-gas)]))
                    (map print
                        [ (expect (format "TX-INFO-GT-TF-DRAIN: INFO predicted {} == real GAS delta {}"
                              [predicted (- pre-gas post-gas)])
                            predicted (- pre-gas post-gas)) ]))
            )
        )
    )
)
(commit-tx)
(print "")
