(begin-tx "TX-INFO-GT-FINALIZE — INFO_AQP-POOL|FinalizeVacate: a FLAT quote over O(scores) work")
(env-gasmodel "table")(env-gaslimit 100000000)(env-gas 0)
(namespace "ouronet-ns")
(print "--- [TX-INFO-GT-FINALIZE · 01 · flat price, variable work] ---")
;;FUNCTION COVERAGE (G6) — `INFO_AQP-POOL|FinalizeVacate`, per the owner's spec.
;;
;;WHY IT IS WORTH MEASURING RATHER THAN ASSUMING. `URCi_FinalizeVacate` is a FLAT
;;`UC_IgnisPrice "AQP-POOL|C_FinalizeVacate" "usage"` — one constant, no arguments — while the exec
;;bulk-zeroes every employed score's aggregates and bumps each one's vacate-generation. A flat quote
;;over work that scales with the score count is a deliberate pricing decision, not an oversight; the
;;single-source claim holds because `(URCi_FinalizeVacate)` is literally the cumulator the exec
;;returns. This block is the cheapest way to PROVE that rather than take the @doc's word for it.
;;
;;Fixture: the drain blocks above leave `InfoGtTfDrPool` vacate-in-progress and unfinalized, so
;;finalize is reachable here and nowhere else in the file. Abort and finalize are mutually exclusive,
;;so this deliberately uses a DIFFERENT pool from <<TX-INFO-GT-ABORT>>.
(env-sigs [{ "key": "PK_AncientHodler", "caps": [] }])
(let
    (
        (ref-TS02-C3:module{TalosStageTwo_ClientThreeV1} TS02-C3)
        (ref-DPTF:module{DemiourgosPactTrueFungibleV2} DPTF)
        (ref-VCT:module{AcquisitionVacateV1} AQP-VCT)
        (patron:string KST.ANHD)
        (pool-id:string "InfoGtTfDrPool-98c486052a51")
        (gas-id:string "GAS-98c486052a51")
    )
    (map print
        [
            (expect "<<TX-INFO-GT-FINALIZE>> precondition: the drain left a vacate open to finalize"
                true (ref-VCT::UR_VacateInProgress pool-id))
        ]
    )
    (let
        (
            (predicted:decimal
                (at "ignis-need" (at "ignis" (AQP-INFO.INFO_AQP-POOL|FinalizeVacate patron pool-id))))
            (pre-gas:decimal (ref-DPTF::UR_AccountSupply gas-id patron))
        )
        (print (format "<(TS02-C3.AQP-POOL|C_FinalizeVacate)> => \"{}\""
            [(ref-TS02-C3::AQP-POOL|C_FinalizeVacate patron pool-id)]))
        (let
            (
                (real:decimal (- pre-gas (ref-DPTF::UR_AccountSupply gas-id patron)))
            )
            (map print
                [
                    (format "<<TX-INFO-GT-FINALIZE>> predicted={} real={}" [predicted real])
                    (expect "<<TX-INFO-GT-FINALIZE>> the flat quote equals what finalizing actually charged"
                        real predicted)
                    (expect "<<TX-INFO-GT-FINALIZE>> ...and it is a real, non-zero charge"
                        true (> real 0.0))
                    (expect "<<TX-INFO-GT-FINALIZE>> ...and the vacate really closed, so the price is for work done"
                        false (ref-VCT::UR_VacateInProgress pool-id))
                ]
            )
        )
    )
    ""
)
(env-sigs [])
(rollback-tx)

