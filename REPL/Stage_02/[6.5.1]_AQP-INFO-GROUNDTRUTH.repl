(print "")
;;==== TX912 · 02 · stake the fresh MVST nonce into the OF drain pool ====
(begin-tx "TX-INFO-GT-OF-DRAIN-STAKE")
(print "--- [TX912 · 02 · stake into OF drain pool] ---")
(namespace "ouronet-ns")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(env-sigs [{ "key": "PK_AncientHodler", "caps": [] }])
(let
    (
        (patron:string KST.ANHD) (dpof-id:string "MVST-98c486052a51")
        (ref-U|DALOS:module{UtilityDalosV1} U|DALOS)
        (ref-DPOF:module{DemiourgosPactOrtoFungibleV1} DPOF)
        (ref-TS02-C3:module{TalosStageTwo_ClientThreeV1} TS02-C3)
        (pool-id:string (ref-U|DALOS::UDC_Makeid "InfoGtOfDrPool"))
        (owned:[integer] (ref-DPOF::URD_AccountNonces patron dpof-id))
    )
    ;; stake an owned MVST nonce (returned to owner by the earlier OF vacate)
    (enforce (> (length owned) 0) "TX912: ANHD needs an MVST nonce")
    (let ((fresh-nonce:integer (at 0 owned)))
        (print (format "<(stake nonce {})> => \"{}\""
            [fresh-nonce (ref-TS02-C3::AQP-POOL|CC_StakeOrtoFungible patron pool-id patron patron dpof-id [fresh-nonce])])))
)
(commit-tx)
(print "")
