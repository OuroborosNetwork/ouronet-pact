;;
;; REPL/Stage_02/[6.5.1]_AQP-INFO-GROUNDTRUTH.repl — cost-equality ground truth for the
;; multi-leg stake/unstake info functions. Runs AFTER a full boot that provisions TfStakePool
;; (i.e. after [6.2.4]_AQP-FVT) and AFTER AQP-INFO is deployed.
;;
;; Proof: AQP-INFO.AQP-POOL|INFO_StakeTrueFungible.ignis-need == the REAL IGNIS (GAS token)
;; balance delta the patron pays for the actual TS02-C3.AQP-POOL|CC_StakeTrueFungible. The
;; preview is computed on pre-stake state; the execution acts on the same state → exact match.
;; Same for unstake (transfer leg reversed).
;;
(print "")
(print "================================================================")
(print "FILE  REPL/Stage_02/[6.5.1]_AQP-INFO-GROUNDTRUTH.repl")
(print "================================================================")
(print "Legend: <<TX-INFO-GT-*>> cost-equality asserts; <(…)> echoes.")
(print "")
;;
;;==== TX901 · 01 · TF stake cost equality ====
(begin-tx "TX-INFO-GT-TF-STAKE - INFO_StakeTrueFungible.ignis-need == real GAS delta")
(print "--- [TX901 · 01 · TF stake cost equality] ---")
(namespace "ouronet-ns")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(env-sigs [{ "key": "PK_AncientHodler", "caps": [] }])
(let*
    (
        (patron:string          KST.ANHD)
        (owner-id:string        KST.ANHD)
        (beneficiary-id:string  KST.ANHD)
        (ouro-id:string         "OURO-98c486052a51")
        (gas-id:string          "GAS-98c486052a51")
        (amount:decimal         100.0)
        (ref-U|DALOS:module{UtilityDalosV1}                 U|DALOS)
        (ref-DPTF:module{DemiourgosPactTrueFungibleV1}      DPTF)
        (ref-TS02-C3:module{TalosStageTwo_ClientThreeV1}    TS02-C3)
        (pool-id:string         (ref-U|DALOS::UDC_Makeid "TfStakePool"))
        ;; 1) PREVIEW on pre-stake state
        (info                   (AQP-INFO.AQP-POOL|INFO_StakeTrueFungible
                                    patron pool-id owner-id beneficiary-id ouro-id amount))
        (predicted:decimal      (at "ignis-need" (at "ignis" info)))
        (pre-gas:decimal        (ref-DPTF::UR_AccountSupply gas-id patron))
    )
    (print (format "<(INFO_StakeTrueFungible)> predicted ignis-need = {} ; patron pre-gas = {}"
        [predicted pre-gas]))
    ;; 2) EXECUTE the real stake (bills the patron the exact flow cost)
    (print (format "<(TS02-C3.AQP-POOL|CC_StakeTrueFungible)> => \"{}\""
        [(ref-TS02-C3::AQP-POOL|CC_StakeTrueFungible patron pool-id owner-id beneficiary-id ouro-id amount)]))
    ;; 3) ASSERT predicted == actual GAS balance delta
    (let ((post-gas:decimal (ref-DPTF::UR_AccountSupply gas-id patron)))
        (print (format "<(post-gas)> = {} ; actual delta = {}" [post-gas (- pre-gas post-gas)]))
        (map print
            [ (expect (format "TX-INFO-GT-TF-STAKE: INFO predicted {} == real GAS delta {}"
                  [predicted (- pre-gas post-gas)])
                predicted (- pre-gas post-gas)) ]))
)
(commit-tx)
(print "")
;;
;;==== TX902 · 01 · TF unstake cost equality ====
(begin-tx "TX-INFO-GT-TF-UNSTAKE - INFO_UnstakeTrueFungible.ignis-need == real GAS delta")
(print "--- [TX902 · 01 · TF unstake cost equality] ---")
(namespace "ouronet-ns")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(env-sigs [{ "key": "PK_AncientHodler", "caps": [] }])
(let*
    (
        (patron:string          KST.ANHD)
        (owner-id:string        KST.ANHD)
        (beneficiary-id:string  KST.ANHD)
        (ouro-id:string         "OURO-98c486052a51")
        (gas-id:string          "GAS-98c486052a51")
        (amount:decimal         50.0)
        (ref-U|DALOS:module{UtilityDalosV1}                 U|DALOS)
        (ref-DPTF:module{DemiourgosPactTrueFungibleV1}      DPTF)
        (ref-TS02-C3:module{TalosStageTwo_ClientThreeV1}    TS02-C3)
        (pool-id:string         (ref-U|DALOS::UDC_Makeid "TfStakePool"))
        (info                   (AQP-INFO.AQP-POOL|INFO_UnstakeTrueFungible
                                    patron pool-id owner-id beneficiary-id ouro-id amount))
        (predicted:decimal      (at "ignis-need" (at "ignis" info)))
        (pre-gas:decimal        (ref-DPTF::UR_AccountSupply gas-id patron))
    )
    (print (format "<(INFO_UnstakeTrueFungible)> predicted ignis-need = {} ; patron pre-gas = {}"
        [predicted pre-gas]))
    (print (format "<(TS02-C3.AQP-POOL|CC_UnstakeTrueFungible)> => \"{}\""
        [(ref-TS02-C3::AQP-POOL|CC_UnstakeTrueFungible patron pool-id owner-id beneficiary-id ouro-id amount)]))
    (let ((post-gas:decimal (ref-DPTF::UR_AccountSupply gas-id patron)))
        (print (format "<(post-gas)> = {} ; actual delta = {}" [post-gas (- pre-gas post-gas)]))
        (map print
            [ (expect (format "TX-INFO-GT-TF-UNSTAKE: INFO predicted {} == real GAS delta {}"
                  [predicted (- pre-gas post-gas)])
                predicted (- pre-gas post-gas)) ]))
)
(commit-tx)
(print "")
;;
;;==== TX903 · 01 · fresh OF fixture (class-2, avoids [6.2.4] vacate collision) ====
(begin-tx "TX-INFO-GT-OF-FIXTURE - issue fresh OF score/pool/vault + mint MVST")
(print "--- [TX903 · 01 · fresh OF fixture] ---")
(namespace "ouronet-ns")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(let
    (
        (patron:string KST.ANHD)
        (owner-konto:string KST.ANHD)
        (dpof-id:string "MVST-98c486052a51")
        (ouro-id:string "OURO-98c486052a51")
        (score-name:string "InfoGtOfScore")
        (fvt-name:string "InfoGtOfVault")
        (pool-name:string "InfoGtOfPool")
        (ref-DALOS:module{OuronetDalosV1} DALOS)
        (ref-U|DALOS:module{UtilityDalosV1} U|DALOS)
        (ref-TS01-C1:module{TalosStageOne_ClientOneV1} TS01-C1)
        (ref-TS02-C3:module{TalosStageTwo_ClientThreeV1} TS02-C3)
        (ref-DPOF:module{DemiourgosPactOrtoFungibleV1} DPOF)
        (score-id:string (ref-U|DALOS::UDC_Makeid score-name))
        (fvt-id:string (ref-U|DALOS::UDC_Makeid fvt-name))
        (pool-id:string (ref-U|DALOS::UDC_Makeid pool-name))
        (split-smart:[decimal]
            (ref-DALOS::URC_SplitKDAPrices patron (* 2.0 (ref-DALOS::UR_UsagePrice "smart")))
        )
    )
    (env-sigs
        [
            { "key": "PK_AncientHodler", "caps": [] }
            { "key": "6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263",
              "caps":
                [
                    (coin.TRANSFER "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263"
                        "k:50d6c59b21e5e6e55baecaa75a1007de37576bde12d8230dc82459cc01b9484b" (at 2 split-smart))
                    (coin.TRANSFER "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263"
                        "k:0cb30c0121ff919266121a99ff9359871818932211df94dae4137c29bc0e8f7e" (at 0 split-smart))
                    (coin.TRANSFER "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263"
                        "c:XM-pkmuB5XUQlp87ZYSbfKt8qzmHY6O2EHAzMRVBt3k" (at 3 split-smart))
                    (coin.TRANSFER "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263"
                        "c:iQQFWj6gWtpGEzhM_O5ekW1QtnQQy55R8BRPGhj_0FU" (at 1 split-smart))
                ]
            }
        ]
    )
    ;; ensure ANHD holds MVST nonces to stake
    (if (= (length (ref-DPOF::URD_AccountNonces owner-konto dpof-id)) 0)
        (ref-TS01-C1::DPOF|C_Mint patron dpof-id owner-konto 1000.0 [{"test": "info-gt-of"}])
        "already has MVST")
    (ref-TS02-C3::AQP-SCR|C_IssueOrtoFungibleScore patron owner-konto score-name 12 1.0 1.0)
    (ref-TS02-C3::AQP-POOL|C_Issue patron pool-name dpof-id 2)
    (ref-TS02-C3::AQP-POOL|C_AddScore patron pool-id score-id)
    (ref-TS02-C3::AQP-FVT|REPL_BootstrapVault patron fvt-id patron score-id ouro-id)
    (print "<(fresh OF fixture provisioned)>")
)
(env-sigs [])
(commit-tx)
(print "")
;;
;;==== TX904 · 01 · OF stake cost equality ====
(begin-tx "TX-INFO-GT-OF-STAKE - INFO_StakeOrtoFungible.ignis-need == real GAS delta")
(print "--- [TX904 · 01 · OF stake cost equality] ---")
(namespace "ouronet-ns")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(env-sigs [{ "key": "PK_AncientHodler", "caps": [] }])
(let*
    (
        (patron:string          KST.ANHD)
        (owner-id:string        KST.ANHD)
        (beneficiary-id:string  KST.ANHD)
        (dpof-id:string         "MVST-98c486052a51")
        (gas-id:string          "GAS-98c486052a51")
        (ref-U|DALOS:module{UtilityDalosV1}                 U|DALOS)
        (ref-DPTF:module{DemiourgosPactTrueFungibleV1}      DPTF)
        (ref-DPOF:module{DemiourgosPactOrtoFungibleV1}      DPOF)
        (ref-TS02-C3:module{TalosStageTwo_ClientThreeV1}    TS02-C3)
        (pool-id:string         (ref-U|DALOS::UDC_Makeid "InfoGtOfPool"))
        (stake-nonce:integer    (at 0 (ref-DPOF::URD_AccountNonces owner-id dpof-id)))
        (nonces:[integer]       [stake-nonce])
        (info                   (AQP-INFO.AQP-POOL|INFO_StakeOrtoFungible
                                    patron pool-id owner-id beneficiary-id dpof-id nonces))
        (predicted:decimal      (at "ignis-need" (at "ignis" info)))
        (pre-gas:decimal        (ref-DPTF::UR_AccountSupply gas-id patron))
    )
    (print (format "<(INFO_StakeOrtoFungible)> predicted ignis-need = {} ; nonce = {} ; pre-gas = {}"
        [predicted stake-nonce pre-gas]))
    (print (format "<(TS02-C3.AQP-POOL|CC_StakeOrtoFungible)> => \"{}\""
        [(ref-TS02-C3::AQP-POOL|CC_StakeOrtoFungible patron pool-id owner-id beneficiary-id dpof-id nonces)]))
    (let ((post-gas:decimal (ref-DPTF::UR_AccountSupply gas-id patron)))
        (print (format "<(post-gas)> = {} ; actual delta = {}" [post-gas (- pre-gas post-gas)]))
        (map print
            [ (expect (format "TX-INFO-GT-OF-STAKE: INFO predicted {} == real GAS delta {}"
                  [predicted (- pre-gas post-gas)])
                predicted (- pre-gas post-gas)) ]))
)
(commit-tx)
(print "")
;;
;;==== TX905 · 01 · fresh SF fixture (class-3, exercises the full collectable helper) ====
(begin-tx "TX-INFO-GT-SF-FIXTURE - issue fresh SF score/pool/vault (DHCD)")
(print "--- [TX905 · 01 · fresh SF fixture] ---")
(namespace "ouronet-ns")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(let
    (
        (patron:string KST.ANHD)
        (owner-konto:string KST.ANHD)
        (dpsf-id:string "DHCD-98c486052a51")
        (ouro-id:string "OURO-98c486052a51")
        (score-name:string "InfoGtSfScore")
        (fvt-name:string "InfoGtSfVault")
        (pool-name:string "InfoGtSfPool")
        (ref-DALOS:module{OuronetDalosV1} DALOS)
        (ref-U|DALOS:module{UtilityDalosV1} U|DALOS)
        (ref-TS02-C3:module{TalosStageTwo_ClientThreeV1} TS02-C3)
        (score-id:string (ref-U|DALOS::UDC_Makeid score-name))
        (fvt-id:string (ref-U|DALOS::UDC_Makeid fvt-name))
        (pool-id:string (ref-U|DALOS::UDC_Makeid pool-name))
        (split-smart:[decimal]
            (ref-DALOS::URC_SplitKDAPrices patron (* 2.0 (ref-DALOS::UR_UsagePrice "smart")))
        )
    )
    (env-sigs
        [
            { "key": "PK_AncientHodler", "caps": [] }
            { "key": "6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263",
              "caps":
                [
                    (coin.TRANSFER "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263"
                        "k:50d6c59b21e5e6e55baecaa75a1007de37576bde12d8230dc82459cc01b9484b" (at 2 split-smart))
                    (coin.TRANSFER "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263"
                        "k:0cb30c0121ff919266121a99ff9359871818932211df94dae4137c29bc0e8f7e" (at 0 split-smart))
                    (coin.TRANSFER "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263"
                        "c:XM-pkmuB5XUQlp87ZYSbfKt8qzmHY6O2EHAzMRVBt3k" (at 3 split-smart))
                    (coin.TRANSFER "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263"
                        "c:iQQFWj6gWtpGEzhM_O5ekW1QtnQQy55R8BRPGhj_0FU" (at 1 split-smart))
                ]
            }
        ]
    )
    (ref-TS02-C3::AQP-SCR|C_IssueSemiFungibleScore patron owner-konto score-name 3 true)
    (ref-TS02-C3::AQP-POOL|C_Issue patron pool-name dpsf-id 3)
    (ref-TS02-C3::AQP-POOL|C_AddScore patron pool-id score-id)
    (ref-TS02-C3::AQP-FVT|REPL_BootstrapVault patron fvt-id patron score-id ouro-id)
    (print "<(fresh SF fixture provisioned)>")
)
(env-sigs [])
(commit-tx)
(print "")
;;
;;==== TX906 · 01 · SF stake cost equality ====
(begin-tx "TX-INFO-GT-SF-STAKE - INFO_StakeSemiFungibleCollectable.ignis-need == real GAS delta")
(print "--- [TX906 · 01 · SF stake cost equality] ---")
(namespace "ouronet-ns")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(env-sigs [{ "key": "PK_AncientHodler", "caps": [] }])
(let*
    (
        (patron:string          KST.ANHD)
        (owner-id:string        KST.ANHD)
        (beneficiary-id:string  KST.ANHD)
        (dpsf-id:string         "DHCD-98c486052a51")
        (gas-id:string          "GAS-98c486052a51")
        (ref-U|DALOS:module{UtilityDalosV1}                 U|DALOS)
        (ref-DPTF:module{DemiourgosPactTrueFungibleV1}      DPTF)
        (ref-DPDC:module{DpdcV1} DPDC)
        (ref-TS02-C3:module{TalosStageTwo_ClientThreeV1}    TS02-C3)
        (pool-id:string         (ref-U|DALOS::UDC_Makeid "InfoGtSfPool"))
        (owned:[integer]        (ref-DPDC::URD_AccountNonces owner-id dpsf-id true))
        (stake-nonce:integer    (at 0 owned))
        (nonces:[integer]       [stake-nonce])
        (info                   (AQP-INFO.AQP-POOL|INFO_StakeSemiFungibleCollectable
                                    patron pool-id owner-id beneficiary-id dpsf-id nonces))
        (predicted:decimal      (at "ignis-need" (at "ignis" info)))
        (pre-gas:decimal        (ref-DPTF::UR_AccountSupply gas-id patron))
    )
    (enforce (> (length owned) 0) "TX906: ANHD needs a DHCD nonce")
    (print (format "<(INFO_StakeSemiFungibleCollectable)> predicted ignis-need = {} ; nonce = {} ; pre-gas = {}"
        [predicted stake-nonce pre-gas]))
    (print (format "<(TS02-C3.AQP-POOL|CC_StakeSemiFungibleCollectable)> => \"{}\""
        [(ref-TS02-C3::AQP-POOL|CC_StakeSemiFungibleCollectable patron pool-id owner-id beneficiary-id dpsf-id nonces)]))
    (let ((post-gas:decimal (ref-DPTF::UR_AccountSupply gas-id patron)))
        (print (format "<(post-gas)> = {} ; actual delta = {}" [post-gas (- pre-gas post-gas)]))
        (map print
            [ (expect (format "TX-INFO-GT-SF-STAKE: INFO predicted {} == real GAS delta {}"
                  [predicted (- pre-gas post-gas)])
                predicted (- pre-gas post-gas)) ]))
)
(commit-tx)
(print "")
(print "=== [6.5.1] AQP-INFO GROUND TRUTH — TF + OF + SF stake/unstake cost-equality complete ===")
