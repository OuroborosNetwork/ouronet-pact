(begin-tx "TX-INFO-GT-SFSYNC — the COLLECTABLE anchor-sync reconstruction, a different reader")
(env-gasmodel "table")(env-gaslimit 100000000)(env-gas 0)
(namespace "ouronet-ns")
(print "--- [TX-INFO-GT-SFSYNC · 01 · the collectable reconstruction] ---")
;;FUNCTION COVERAGE (G6) — `INFO_AQP-POOL|SyncSemiFungibleAnchors`, per the owner's spec.
;;
;;WHY THE TRUE-FUNGIBLE PROOF AT <<TX-INFO-GT-SYNC>> DOES NOT COVER THIS. That block measured
;;`URCi_SyncTrueFungibleAnchorsFull`. The SF and NF previews route through a DIFFERENT hand-written
;;reconstruction, `URCi_SyncCollectableAnchorsFull` (`03_AQP.pact:2186`), with its own three legs:
;;    ico-ank   n-live from UR_ANK|AnchorsForAsset, priced by URC_TrueFungibleStakeAnchorRefreshIgnis
;;    ico-meta  the "ank-sync-count-tf" stamp
;;    ico-gas   URCi_SyncCollectableAnchors
;;Two reconstructions that happen to share a shape are still two expressions. A green TF measurement
;;says nothing at all about whether this one is in step, which is precisely the assumption worth
;;refusing to make.
;;
;;The op is son-INDEPENDENT by design (its own @doc says so), so the SF measurement also stands for
;;`SyncNonFungibleAnchors` — but only because the source says the cost cannot differ, not because
;;one number was taken and generalised.
(env-sigs [{ "key": "PK_AncientHodler", "caps": [] }])
(let
    (
        (ref-TS02-C3:module{TalosStageTwo_ClientThreeV1} TS02-C3)
        (ref-DPTF:module{DemiourgosPactTrueFungibleV2} DPTF)
        (ref-DPDC:module{DpdcV2} DPDC)
        (ref-ANK:module{AcquisitionAnchorsV1} AQP-ANK)
        (ref-U|DALOS:module{UtilityDalosV2} U|DALOS)
        (patron:string KST.ANHD)
        (gas-id:string "GAS-98c486052a51")
        (dpsf-id:string "DHCD-98c486052a51")
        (pool-id:string (ref-U|DALOS::UDC_Makeid "InfoGtSfDrPool"))
    )
    ;;SETUP — the cap enforces that there IS a live cross-pool collectable stake to repair
    ;;("No cross-pool collectable stake to sync", `03_AQP.pact:832`). Every SF position in this file
    ;;has been drained by the blocks above, so the same ABORT -> ENABLE -> STAKE chain the TF twin
    ;;needs is replayed here, and for the same reason: a vacate freezes the pool AND disables staking.
    (print (format "<(setup abort-vacate)> => \"{}\""
        [(ref-TS02-C3::AQP-POOL|C_AbortVacate patron pool-id)]))
    (print (format "<(setup enable-stake)> => \"{}\""
        [(ref-TS02-C3::AQP-POOL|C_EnablePoolStake patron (AQP-POOL.URC_AqpOwnerKonto pool-id) pool-id)]))
    (let
        (
            (owned:[integer] (ref-DPDC::URH_AccountNonces patron dpsf-id true))
        )
        (enforce (> (length owned) 0) "TX-INFO-GT-SFSYNC: ANHD needs a DHCD nonce to re-stake")
        (print (format "<(setup re-stake nonce {})> => \"{}\""
            [(at 0 owned)
             (ref-TS02-C3::AQP-POOL|CC_StakeSemiFungibleCollectable
                patron pool-id patron patron dpsf-id [(at 0 owned)])])))
    (let
        (
            (n-live:integer (length (ref-ANK::UR_ANK|AnchorsForAsset dpsf-id)))
        )
        (let
            (
                (predicted:decimal
                    (at "ignis-need" (at "ignis"
                        (AQP-INFO.INFO_AQP-POOL|SyncSemiFungibleAnchors patron patron dpsf-id))))
                (pre-gas:decimal (ref-DPTF::UR_AccountSupply gas-id patron))
            )
            (print (format "<(TS02-C3.AQP-POOL|C_SyncSemiFungibleAnchors)> => \"{}\""
                [(ref-TS02-C3::AQP-POOL|C_SyncSemiFungibleAnchors patron patron dpsf-id)]))
            (let
                (
                    (real:decimal (- pre-gas (ref-DPTF::UR_AccountSupply gas-id patron)))
                )
                (map print
                    [
                        (format "<<TX-INFO-GT-SFSYNC>> anchors={} predicted={} real={} delta={}"
                            [n-live predicted real (- real predicted)])
                        (expect "<<TX-INFO-GT-SFSYNC>> the collectable reconstruction equals what the sync charged"
                            real predicted)
                        (expect "<<TX-INFO-GT-SFSYNC>> ...and it is a real, non-zero charge"
                            true (> real 0.0))
                        ;;the per-anchor term is only exercised if the asset actually carries anchors
                        (expect "<<TX-INFO-GT-SFSYNC>> ...against an asset that really has live anchors"
                            true (> n-live 0))
                    ]
                )
            )
        )
    )
    ""
)
(env-sigs [])
(rollback-tx)

