;;
;;==== TX903 · 01 · fresh OF fixture (class-2, avoids [6.2.4] vacate collision) ====
(begin-tx "TX-INFO-GT-OF-FIXTURE - issue fresh OF score/pool/vault + mint MVST")
(print "--- [TX903 · 01 · fresh OF fixture] ---")
(namespace "ouronet-ns")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
;;==== TX-INFO-GT-OF-FIXTURE - issue fresh OF score/pool/vault + mint MVST · 01 · let / invocation ==== 
(print "--- [TX-INFO-GT-OF-FIXTURE - issue fresh OF score/pool/vault + mint MVST · 01 · let / invocation] ---")
(let
    (
        (patron:string KST.ANHD)
        (owner-konto:string KST.ANHD)
        (dpof-id:string "MVST-98c486052a51")
        (ouro-id:string "OURO-98c486052a51")
        (ouro-owner:string (AQP-ANK.URC_AnchorableAssetOwner ouro-id [true true]))
        (score-name:string "InfoGtOfScore")
        (fvt-name:string "InfoGtOfVault")
        (pool-name:string "InfoGtOfPool")
        (ref-DALOS:module{OuronetDalosV2} DALOS)
        (ref-U|DALOS:module{UtilityDalosV2} U|DALOS)
        (ref-TS01-C1:module{TalosStageOne_ClientOneV2} TS01-C1)
        (ref-TS02-C3:module{TalosStageTwo_ClientThreeV1} TS02-C3)
        (ref-DPOF:module{DemiourgosPactOrtoFungibleV2} DPOF)
        (score-id:string (ref-U|DALOS::UDC_Makeid score-name))
        (fvt-id:string (ref-U|DALOS::UDC_Makeid fvt-name))
        (pool-id:string (ref-U|DALOS::UDC_Makeid pool-name))
        (split-smart:[decimal]
            (ref-DALOS::URC_SplitSTOAPrices patron (* 2.0 (ref-DALOS::UR_UsagePrice "smart")))
        )
    )
    (env-sigs
        [
            { "key": "PK_AncientHodler", "caps": [] }
            { "key": "6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263",
              "caps":
                [
                    (coin.TRANSFER "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263"
                        "k:50d6c59b21e5e6e55baecaa75a1007de37576bde12d8230dc82459cc01b9484b" (at 2 split-smart))
                    (coin.TRANSFER "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263"
                        "k:0cb30c0121ff919266121a99ff9359871818932211df94dae4137c29bc0e8f7e" (at 0 split-smart))
                    (coin.TRANSFER "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263"
                        "c:XM-pkmuB5XUQlp87ZYSbfKt8qzmHY6O2EHAzMRVBt3k" (at 3 split-smart))
                    (coin.TRANSFER "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263"
                        "c:iQQFWj6gWtpGEzhM_O5ekW1QtnQQy55R8BRPGhj_0FU" (at 1 split-smart))
                ]
            }
        ]
    )
    ;; ensure ANHD holds MVST nonces to stake
    (if (= (length (ref-DPOF::URH_AccountNonces owner-konto dpof-id)) 0)
        (ref-TS01-C1::DPOF|C_Mint patron dpof-id owner-konto 1000.0 [{"test": "info-gt-of"}])
        "already has MVST")
    (ref-TS02-C3::AQP-SCR|C_IssueOrtoFungibleScore patron owner-konto score-name 12 1.0 1.0)
    (ref-TS02-C3::AQP-POOL|C_Issue patron (AQP-POOL.URC_AqpOwnerKontoFromClassAndAsset 2 dpof-id) pool-name dpof-id 2)
    (ref-TS02-C3::AQP-POOL|C_AddScore patron (AQP-POOL.URC_AqpOwnerKonto pool-id) pool-id score-id)
    (ref-TS02-C3::AQP-FVT|REPL_BootstrapVault patron fvt-id patron score-id ouro-id)
    (print "<(fresh OF fixture provisioned)>")
)
(env-sigs [])
(commit-tx)
;;||>>>>>>>>>>>>>>>>>>>>>>>>>
;;|| NEXT                   >
;;||>>>>>>>>>>>>>>>>>>>>>>>>>
(print "")
(print "")
;;
;;==== TX904 · 01 · OF stake cost equality ====
(begin-tx "TX-INFO-GT-OF-STAKE - INFO_StakeOrtoFungible.ignis-need == real GAS delta")
(print "--- [TX904 · 01 · OF stake cost equality] ---")
(namespace "ouronet-ns")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
;;==== TX-INFO-GT-OF-STAKE - INFO_StakeOrtoFungible.ignis-need == real GAS delta · 01 · env-sigs (caps) ==== 
(print "--- [TX-INFO-GT-OF-STAKE - INFO_StakeOrtoFungible.ignis-need == real GAS delta · 01 · env-sigs (caps)] ---")
(env-sigs [{ "key": "PK_AncientHodler", "caps": [] }])
(let*
    (
        (patron:string          KST.ANHD)
        (owner-id:string        KST.ANHD)
        (beneficiary-id:string  KST.ANHD)
        (dpof-id:string         "MVST-98c486052a51")
        (gas-id:string          "GAS-98c486052a51")
        (ref-U|DALOS:module{UtilityDalosV2}                 U|DALOS)
        (ref-DPTF:module{DemiourgosPactTrueFungibleV2}      DPTF)
        (ref-DPOF:module{DemiourgosPactOrtoFungibleV2}      DPOF)
        (ref-TS02-C3:module{TalosStageTwo_ClientThreeV1}    TS02-C3)
        (pool-id:string         (ref-U|DALOS::UDC_Makeid "InfoGtOfPool"))
        (stake-nonce:integer    (at 0 (ref-DPOF::URH_AccountNonces owner-id dpof-id)))
        (nonces:[integer]       [stake-nonce])
        (info                   (AQP-INFO.INFO_AQP-POOL|StakeOrtoFungible
                                    patron pool-id owner-id beneficiary-id dpof-id nonces))
        (predicted:decimal      (at "ignis-need" (at "ignis" info)))
        (pre-gas:decimal        (ref-DPTF::UR_AccountSupply gas-id patron))
    )
    (print (format "<(INFO_StakeOrtoFungible)> predicted ignis-need = {} ; nonce = {} ; pre-gas = {}"
        [predicted stake-nonce pre-gas]))
    ;;TEXT AGREEMENT. This suite proves the NUMBER against reality -- predicted ignis-need vs the
    ;;patron's real GAS balance delta -- which is the strongest cost check in the codebase. It
    ;;never looks at ignis-text, the line a UI actually renders. A wallet charges the number; a
    ;;user reads the text. Asserting here costs nothing (the preview object is already in hand)
    ;;and closes the loop: the figure proven correct below is the figure the user is shown.
    (map print
        [
            (expect
                (format "<<TX-INFO-GT-TEXT>> the rendered cost line quotes the verified figure ({})"
                    [predicted])
                true
                (if (> predicted 0.0)
                    (contains (format "{}" [predicted]) (at "ignis-text" (at "ignis" info)))
                    (contains "free of Ouronet GAS" (at "ignis-text" (at "ignis" info)))))
        ]
    )
    ;;WHY `02_SCORE.pact:1110` ("orto LP stake requires whole nonce supply") IS A TAUTOLOGY here.
    ;;The client below does not take nonce-amounts -- it derives them with
    ;;`DPOF::UR_NoncesSupplies dpof-id nonces`, which folds `UR_NonceSupply id element`. That is the
    ;;SAME reader SCORE's enforce compares each amount against, so through this path the guard reads
    ;;`(= (UR_NonceSupply dpof n) (UR_NonceSupply dpof n))`.
    ;;Asserted rather than argued, so the `;;UNREACHABLE` annotation at the site cannot rot: if the
    ;;client is ever changed to derive from a per-account reader (as the DPNF twin does), these two
    ;;stop being equal and this goes red.
    (map print
        [
            (expect "<<TX-INFO-GT>> the client derives amounts from the SAME reader the guard checks"
                (map (lambda (n:integer) (DPOF.UR_NonceSupply dpof-id n)) nonces)
                (DPOF.UR_NoncesSupplies dpof-id nonces))
        ]
    )
    (print (format "<(TS02-C3.AQP-POOL|CC_StakeOrtoFungible)> => \"{}\""
        [(ref-TS02-C3::AQP-POOL|CC_StakeOrtoFungible patron pool-id owner-id beneficiary-id dpof-id nonces)]))
    (let ((post-gas:decimal (ref-DPTF::UR_AccountSupply gas-id patron)))
        (print (format "<(post-gas)> = {} ; actual delta = {}" [post-gas (- pre-gas post-gas)]))
        (map print
            [ (expect (format "TX-INFO-GT-OF-STAKE: INFO predicted {} == real GAS delta {}"
                  [predicted (- pre-gas post-gas)])
                predicted (- pre-gas post-gas)) ]))
)
(commit-tx)
;;||>>>>>>>>>>>>>>>>>>>>>>>>>
;;|| NEXT                   >
;;||>>>>>>>>>>>>>>>>>>>>>>>>>
(print "")
(print "")
