(begin-tx "TX-INFO-GT-COLLECT — the most complex reconstruction in the family")
(env-gasmodel "table")(env-gaslimit 100000000)(env-gas 0)
(namespace "ouronet-ns")
(print "--- [TX-INFO-GT-COLLECT · 01 · transfer leg + forced-fix penalty + gas leg] ---")
;;FUNCTION COVERAGE (G6) — `INFO_AQP-FVT|Collect`, per the owner's spec.
;;
;;THE HARDEST PREVIEW IN THIS FAMILY, and the reason it is worth the setup. `URCi_CollectFull` sums
;;THREE independently-derived sources:
;;    URC_CollectTransferLegIgnis   the payout transfer, tiered by amount
;;    URC_CollectForcedFixIgnis     the stale-member penalty, ffc x CT_FORCED_FIX_RATE
;;    URCi_Collect                  the flat GAS|COLLECT leg
;;Three sources means three chances to drift, and this is the only preview in the tree that ships
;;with a WRITTEN-DOWN residual (`04_RPS.pact`): the payout is read pre-drip, so a lane carrying a LIVE
;;stream can shift the transfer tier between quote and charge.
;;
;;The fixture is chosen to take that residual off the table rather than to hide behind it:
;;  - the WSTOA lane, NOT an OURO lane. `[6.2.4]` injects a 240-OURO/86400s STREAM, and on a streamed
;;    lane the documented residual applies and a mismatch would be ambiguous. On the plain lane it is
;;    not, so a failure here means a real defect and nothing else.
;;  - the reward is WSTOA, never GAS: a GAS reward would move the PRINCIPAL through the very balance
;;    being differenced, and the measurement would read principal + fee as though it were all fee.
;;  - score-entity-type 1 (a score), never 3: a multiplet reward fans the transfer leg out through the
;;    ATS ladder, which is a different computation again.
;;
;;ONE SHOT PER FIXTURE: the forced-fix counter is ZEROED on collect, so a second measurement in the
;;same run would read a different `ffc` and legitimately disagree. Hence the rollback.
(env-sigs [{ "key": "PK_AncientHodler", "caps": [] }])
(let
    (
        (ref-TS02-C3:module{TalosStageTwo_ClientThreeV1} TS02-C3)
        (ref-DPTF:module{DemiourgosPactTrueFungibleV2} DPTF)
        (ref-DALOS:module{OuronetDalosV2} DALOS)
        (patron:string KST.ANHD)
        (fvt-id:string "CodingDivisionTreasury-98c486052a51")
        (score-id:string "TheCodingDivision-98c486052a51")
        (gas-id:string "GAS-98c486052a51")
    )
    (let
        (
            (wstoa-id:string (ref-DALOS::UR_WrappedStoaID))
        )
        ;;SETUP — there must be something to collect. The inject is a separate op with its own price
        ;;(measured in its own right at <<TX-INFO-GT-INJECT>>), and it completes before the
        ;;measurement window below opens.
        (print (format "<(setup inject)> => \"{}\""
            [(ref-TS02-C3::AQP-FVT|CC_Inject patron patron fvt-id wstoa-id 25.0)]))
        (let
            (
                (predicted:decimal
                    (at "ignis-need" (at "ignis"
                        (AQP-INFO.INFO_AQP-FVT|Collect patron fvt-id 1 score-id wstoa-id))))
                (pre-gas:decimal (ref-DPTF::UR_AccountSupply gas-id patron))
            )
            (print (format "<(TS02-C3.AQP-FVT|CC_Collect)> => \"{}\""
                [(ref-TS02-C3::AQP-FVT|CC_Collect patron patron fvt-id 1 score-id wstoa-id)]))
            (let
                (
                    (real:decimal (- pre-gas (ref-DPTF::UR_AccountSupply gas-id patron)))
                )
                (map print
                    [
                        (format "<<TX-INFO-GT-COLLECT>> predicted={} real={} delta={}"
                            [predicted real (- real predicted)])
                        (expect "<<TX-INFO-GT-COLLECT>> the three-source reconstruction equals what collect charged"
                            real predicted)
                        (expect "<<TX-INFO-GT-COLLECT>> ...and it is a real, non-zero charge"
                            true (> real 0.0))
                    ]
                )
            )
        )
    )
    ""
)
(env-sigs [])
(rollback-tx)

