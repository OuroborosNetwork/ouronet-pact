;;
;;==== TX906 · 01 · SF stake cost equality ====
(begin-tx "TX-INFO-GT-SF-STAKE - INFO_StakeSemiFungibleCollectable.ignis-need == real GAS delta")
(print "--- [TX906 · 01 · SF stake cost equality] ---")
(namespace "ouronet-ns")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(env-sigs [{ "key": "PK_AncientHodler", "caps": [] }])
(let*
    (
        (patron:string          KST.ANHD)
        (owner-id:string        KST.ANHD)
        (beneficiary-id:string  KST.ANHD)
        (dpsf-id:string         "DHCD-98c486052a51")
        (gas-id:string          "GAS-98c486052a51")
        (ref-U|DALOS:module{UtilityDalosV1}                 U|DALOS)
        (ref-DPTF:module{DemiourgosPactTrueFungibleV1}      DPTF)
        (ref-DPDC:module{DpdcV1} DPDC)
        (ref-TS02-C3:module{TalosStageTwo_ClientThreeV1}    TS02-C3)
        (pool-id:string         (ref-U|DALOS::UDC_Makeid "InfoGtSfPool"))
        (owned:[integer]        (ref-DPDC::URD_AccountNonces owner-id dpsf-id true))
        (stake-nonce:integer    (at 0 owned))
        (nonces:[integer]       [stake-nonce])
        (info                   (AQP-INFO.AQP-POOL|INFO_StakeSemiFungibleCollectable
                                    patron pool-id owner-id beneficiary-id dpsf-id nonces))
        (predicted:decimal      (at "ignis-need" (at "ignis" info)))
        (pre-gas:decimal        (ref-DPTF::UR_AccountSupply gas-id patron))
    )
    (enforce (> (length owned) 0) "TX906: ANHD needs a DHCD nonce")
    (print (format "<(INFO_StakeSemiFungibleCollectable)> predicted ignis-need = {} ; nonce = {} ; pre-gas = {}"
        [predicted stake-nonce pre-gas]))
    (print (format "<(TS02-C3.AQP-POOL|CC_StakeSemiFungibleCollectable)> => \"{}\""
        [(ref-TS02-C3::AQP-POOL|CC_StakeSemiFungibleCollectable patron pool-id owner-id beneficiary-id dpsf-id nonces)]))
    (let ((post-gas:decimal (ref-DPTF::UR_AccountSupply gas-id patron)))
        (print (format "<(post-gas)> = {} ; actual delta = {}" [post-gas (- pre-gas post-gas)]))
        (map print
            [ (expect (format "TX-INFO-GT-SF-STAKE: INFO predicted {} == real GAS delta {}"
                  [predicted (- pre-gas post-gas)])
                predicted (- pre-gas post-gas)) ]))
)
(commit-tx)
(print "")
;;
;;==== TX907 · 01 · TF batch-vacate cost equality (dirty-read legs -> real GAS delta) ====
(begin-tx "TX-INFO-GT-TF-VACATE - INFO_BatchVacateTrueFungible.ignis-need == real GAS delta")
(print "--- [TX907 · 01 · TF batch-vacate cost equality] ---")
(namespace "ouronet-ns")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(env-sigs [{ "key": "PK_AncientHodler", "caps": [] }])
(let
    (
        (patron:string          KST.ANHD)
        (owner-id:string        KST.ANHD)
        (beneficiary-id:string  KST.ANHD)
        (ouro-id:string         "OURO-98c486052a51")
        (gas-id:string          "GAS-98c486052a51")
        (amount:decimal         100.0)
        (ref-U|DALOS:module{UtilityDalosV1}                 U|DALOS)
        (ref-DPTF:module{DemiourgosPactTrueFungibleV1}      DPTF)
        (ref-TS02-C3:module{TalosStageTwo_ClientThreeV1}    TS02-C3)
        (pool-id:string         (ref-U|DALOS::UDC_Makeid "TfStakePool"))
    )
    ;; 1) Re-stake a fresh TF position so there is something to vacate (TfStakePool is restakeable).
    (print (format "<(re-stake)> => \"{}\""
        [(ref-TS02-C3::AQP-POOL|CC_StakeTrueFungible patron pool-id owner-id beneficiary-id ouro-id amount)]))
    ;; 2) PREVIEW on the post-stake state, fed the SAME dirty-read legs the exec will build.
    ;;    Vacate requires the FULL tracked balance (TfStakePool carries residual from the earlier
    ;;    stake/unstake tests), so read the real per-pool DPTF tracker balance and vacate exactly that.
    (let
        (
            (staked-bal:decimal (AQP-POOL.UR_AQP|DPTFTrackerBalance pool-id ouro-id owner-id beneficiary-id))
        )
        (let
            (
                (legs:[object{AQP-VCT.VCT|VacateTfLeg}]
                    (AQP-VCT.UC_TfLegsFromParallelArrays [owner-id] [beneficiary-id] [staked-bal]))
            )
        (let
            (
                (predicted:decimal
                    (at "ignis-need" (at "ignis"
                        (AQP-INFO.AQP-POOL|INFO_BatchVacateTrueFungible patron pool-id ouro-id legs))))
                (pre-gas:decimal (ref-DPTF::UR_AccountSupply gas-id patron))
            )
            (print (format "<(INFO_BatchVacateTrueFungible)> predicted ignis-need = {} ; staked-bal = {} ; patron pre-gas = {}"
                [predicted staked-bal pre-gas]))
            ;; 3) EXECUTE the real batch-vacate (bills the patron the exact flow cost).
            (print (format "<(TS02-C3.AQP-POOL|CCp_BatchVacateTrueFungible)> => \"{}\""
                [(ref-TS02-C3::AQP-POOL|CCp_BatchVacateTrueFungible
                    patron pool-id ouro-id [owner-id] [beneficiary-id] [staked-bal])]))
            ;; 4) ASSERT predicted == actual GAS balance delta.
            (let ((post-gas:decimal (ref-DPTF::UR_AccountSupply gas-id patron)))
                (print (format "<(post-gas)> = {} ; actual delta = {}" [post-gas (- pre-gas post-gas)]))
                (map print
                    [ (expect (format "TX-INFO-GT-TF-VACATE: INFO predicted {} == real GAS delta {}"
                          [predicted (- pre-gas post-gas)])
                        predicted (- pre-gas post-gas)) ]))
        )
        )
    )
)
(commit-tx)
(print "")
;;
;;==== TX909 · 01 · OF batch-vacate cost equality (dirty-read scan legs -> real GAS delta) ====
(begin-tx "TX-INFO-GT-OF-VACATE - INFO_BatchVacateOrtoFungible.ignis-need == real GAS delta")
(print "--- [TX909 · 01 · OF batch-vacate cost equality] ---")
(namespace "ouronet-ns")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(env-sigs [{ "key": "PK_AncientHodler", "caps": [] }])
(let
    (
        (patron:string          KST.ANHD)
        (gas-id:string          "GAS-98c486052a51")
        (ref-U|DALOS:module{UtilityDalosV1}                 U|DALOS)
        (ref-DPTF:module{DemiourgosPactTrueFungibleV1}      DPTF)
        (ref-TS02-C3:module{TalosStageTwo_ClientThreeV1}    TS02-C3)
        (pool-id:string         (ref-U|DALOS::UDC_Makeid "InfoGtOfPool"))
    )
    ;; PHASE-1 dirty-read scan: the exact lane plan the exec consumes, fed to BOTH INFO and exec.
    (let
        (
            (lane:object{AQP-VCT.VCT|VacateNonceLane} (at 0 (AQP-VCT.URH_VacateOrtoFungiblePoolLegs pool-id)))
        )
        (let
            (
                (dpof-id:string (at "asset-id" lane))
                (legs:[object{AQP-VCT.VCT|VacateNonceLeg}] (at "legs" lane))
            )
            (let
                (
                    (predicted:decimal
                        (at "ignis-need" (at "ignis"
                            (AQP-INFO.AQP-POOL|INFO_BatchVacateOrtoFungible patron pool-id dpof-id legs))))
                    (pre-gas:decimal (ref-DPTF::UR_AccountSupply gas-id patron))
                )
                (print (format "<(INFO_BatchVacateOrtoFungible)> predicted ignis-need = {} ; legs = {} ; pre-gas = {}"
                    [predicted (length legs) pre-gas]))
                (print (format "<(TS02-C3.AQP-POOL|CCp_BatchVacateOrtoFungible)> => \"{}\""
                    [(ref-TS02-C3::AQP-POOL|CCp_BatchVacateOrtoFungible
                        patron pool-id dpof-id
                        (map (lambda (l:object{AQP-VCT.VCT|VacateNonceLeg}) (at "owner-id" l)) legs)
                        (map (lambda (l:object{AQP-VCT.VCT|VacateNonceLeg}) (at "beneficiary-id" l)) legs)
                        (map (lambda (l:object{AQP-VCT.VCT|VacateNonceLeg}) (at "nonces" l)) legs))]))
                (let ((post-gas:decimal (ref-DPTF::UR_AccountSupply gas-id patron)))
                    (print (format "<(post-gas)> = {} ; actual delta = {}" [post-gas (- pre-gas post-gas)]))
                    (map print
                        [ (expect (format "TX-INFO-GT-OF-VACATE: INFO predicted {} == real GAS delta {}"
                              [predicted (- pre-gas post-gas)])
                            predicted (- pre-gas post-gas)) ]))
            )
        )
    )
)
(commit-tx)
(print "")
;;
;;==== TX910 · 01 · SF collectable batch-vacate cost equality (dirty-read scan legs -> real GAS delta) ====
(begin-tx "TX-INFO-GT-SF-VACATE - INFO_BatchVacateCollectables.ignis-need == real GAS delta")
(print "--- [TX910 · 01 · SF batch-vacate cost equality] ---")
(namespace "ouronet-ns")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(env-sigs [{ "key": "PK_AncientHodler", "caps": [] }])
(let
    (
        (patron:string          KST.ANHD)
        (gas-id:string          "GAS-98c486052a51")
        (son:bool               true)
        (ref-U|DALOS:module{UtilityDalosV1}                 U|DALOS)
        (ref-DPTF:module{DemiourgosPactTrueFungibleV1}      DPTF)
        (ref-TS02-C3:module{TalosStageTwo_ClientThreeV1}    TS02-C3)
        (pool-id:string         (ref-U|DALOS::UDC_Makeid "InfoGtSfPool"))
    )
    (let
        (
            (lane:object{AQP-VCT.VCT|VacateNonceLane} (at 0 (AQP-VCT.URH_VacateCollectablesPoolLegs pool-id son)))
        )
        (let
            (
                (dpsf-id:string (at "asset-id" lane))
                (legs:[object{AQP-VCT.VCT|VacateNonceLeg}] (at "legs" lane))
            )
            (let
                (
                    (predicted:decimal
                        (at "ignis-need" (at "ignis"
                            (AQP-INFO.AQP-POOL|INFO_BatchVacateCollectables patron pool-id dpsf-id son legs))))
                    (pre-gas:decimal (ref-DPTF::UR_AccountSupply gas-id patron))
                )
                (print (format "<(INFO_BatchVacateCollectables)> predicted ignis-need = {} ; legs = {} ; pre-gas = {}"
                    [predicted (length legs) pre-gas]))
                (print (format "<(TS02-C3.AQP-POOL|CCp_BatchVacateCollectables)> => \"{}\""
                    [(ref-TS02-C3::AQP-POOL|CCp_BatchVacateCollectables
                        patron pool-id dpsf-id son
                        (map (lambda (l:object{AQP-VCT.VCT|VacateNonceLeg}) (at "owner-id" l)) legs)
                        (map (lambda (l:object{AQP-VCT.VCT|VacateNonceLeg}) (at "beneficiary-id" l)) legs)
                        (map (lambda (l:object{AQP-VCT.VCT|VacateNonceLeg}) (at "nonces" l)) legs)
                        (map (lambda (l:object{AQP-VCT.VCT|VacateNonceLeg}) (map (lambda (q:decimal) (floor q)) (at "amounts" l))) legs))]))
                (let ((post-gas:decimal (ref-DPTF::UR_AccountSupply gas-id patron)))
                    (print (format "<(post-gas)> = {} ; actual delta = {}" [post-gas (- pre-gas post-gas)]))
                    (map print
                        [ (expect (format "TX-INFO-GT-SF-VACATE: INFO predicted {} == real GAS delta {}"
                              [predicted (- pre-gas post-gas)])
                            predicted (- pre-gas post-gas)) ]))
            )
        )
    )
)
(commit-tx)
(print "")
;;
;;==== TX911 · 01 · fresh TF DRAIN fixture (own pool — vacate/drain each consume their pool) ====
(begin-tx "TX-INFO-GT-TF-DRAIN-FIXTURE - fresh TF score/pool/vault + stake")
(print "--- [TX911 · 01 · fresh TF drain fixture] ---")
(namespace "ouronet-ns")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(let
    (
        (patron:string KST.ANHD)
        (owner-konto:string KST.ANHD)
        (ouro-id:string "OURO-98c486052a51")
        (score-name:string "InfoGtTfDrScore")
        (fvt-name:string "InfoGtTfDrVault")
        (pool-name:string "InfoGtTfDrPool")
        (ref-DALOS:module{OuronetDalosV1} DALOS)
        (ref-U|DALOS:module{UtilityDalosV1} U|DALOS)
        (ref-TS02-C3:module{TalosStageTwo_ClientThreeV1} TS02-C3)
        (score-id:string (ref-U|DALOS::UDC_Makeid score-name))
        (fvt-id:string (ref-U|DALOS::UDC_Makeid fvt-name))
        (pool-id:string (ref-U|DALOS::UDC_Makeid pool-name))
        (split-smart:[decimal] (ref-DALOS::URC_SplitSTOAPrices patron (* 2.0 (ref-DALOS::UR_UsagePrice "smart"))))
    )
    (env-sigs
        [ { "key": "PK_AncientHodler", "caps": [] }
          { "key": "6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263",
            "caps":
              [ (coin.TRANSFER "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263"
                    "k:50d6c59b21e5e6e55baecaa75a1007de37576bde12d8230dc82459cc01b9484b" (at 2 split-smart))
                (coin.TRANSFER "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263"
                    "k:0cb30c0121ff919266121a99ff9359871818932211df94dae4137c29bc0e8f7e" (at 0 split-smart))
                (coin.TRANSFER "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263"
                    "c:XM-pkmuB5XUQlp87ZYSbfKt8qzmHY6O2EHAzMRVBt3k" (at 3 split-smart))
                (coin.TRANSFER "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263"
                    "c:iQQFWj6gWtpGEzhM_O5ekW1QtnQQy55R8BRPGhj_0FU" (at 1 split-smart)) ] } ])
    (ref-TS02-C3::AQP-SCR|C_IssueTrueFungibleScore patron owner-konto score-name 12 1.0)
    (ref-TS02-C3::AQP-POOL|C_Issue patron pool-name ouro-id 1)
    (ref-TS02-C3::AQP-POOL|C_AddScore patron pool-id score-id)
    (ref-TS02-C3::AQP-FVT|REPL_BootstrapVault patron fvt-id patron score-id ouro-id)
    (print "<(fresh TF drain fixture provisioned)>")
)
(env-sigs [])
(commit-tx)
(print "")
