(env-gasmodel "table")(env-gaslimit 100000000)(env-gas 0)
(namespace "ouronet-ns")
(print "--- [TX-INFO-GT-SCROF · 01 · issue an orto-fungible score] ---")
;;FUNCTION COVERAGE (G6) — `INFO_AQP-SCR|IssueOrtoFungibleScore`, per the owner's spec. BOTH currencies are checked; checking
;;only IGNIS is what let `INFO_EQUITY|IssueCompany` quote a 918-STOA operation as free.
;;The remaining `Issue*Score` variants all read the SAME two price sources as the true-fungible one
;;measured at <<TX-INFO-GT-SCOREISSUE>> (`URCi_IssueScore` + `URCi_IssueScoreStoa`). Measuring them
;;anyway is the point: "they share a reader" is a claim about the source, and a shared source is
;;exactly what was wrong in `URCi_DefineHybridSet`, whose siblings also "shared a reader".
(let
    (
        (ref-DALOS:module{OuronetDalosV2} DALOS)
        (ref-IGNIS:module{IgnisCollectorV3} IGNIS)
    )
    ;;The STOA fee is a real coin.transfer split 10/20/30/40 across the four fee targets, so it needs
    ;;one managed `coin.TRANSFER` per leg, sized from the same split the collector uses.
    (let ((split-stoa:[decimal]
              (ref-DALOS::URC_SplitSTOAPrices KST.ANHD (ref-IGNIS::UC_StoaPrice "issue-score"))))
        (env-sigs
            [ { "key": "PK_AncientHodler", "caps": [] }
              { "key": "6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263"
              , "caps":
                [ (coin.TRANSFER "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263" "k:50d6c59b21e5e6e55baecaa75a1007de37576bde12d8230dc82459cc01b9484b" (at 2 split-stoa))
                  (coin.TRANSFER "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263" "k:0cb30c0121ff919266121a99ff9359871818932211df94dae4137c29bc0e8f7e" (at 0 split-stoa))
                  (coin.TRANSFER "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263" "c:XM-pkmuB5XUQlp87ZYSbfKt8qzmHY6O2EHAzMRVBt3k" (at 3 split-stoa))
                  (coin.TRANSFER "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263" "c:iQQFWj6gWtpGEzhM_O5ekW1QtnQQy55R8BRPGhj_0FU" (at 1 split-stoa)) ] } ]
        )
    )
)
(let
    (
        (ref-TS02-C3:module{TalosStageTwo_ClientThreeV1} TS02-C3)
        (ref-DPTF:module{DemiourgosPactTrueFungibleV2} DPTF)
        (ref-DALOS:module{OuronetDalosV2} DALOS)
        (patron:string KST.ANHD)
        (gas-id:string "GAS-98c486052a51")
    )
    (let
        (
            (predicted:object{OuronetInfoV2.ClientInfo} (AQP-INFO.INFO_AQP-SCR|IssueOrtoFungibleScore patron patron "GtOfScoreProbe" 12 1.0 1.0))
            (pre-gas:decimal (ref-DPTF::UR_AccountSupply gas-id patron))
            (pre-stoa:decimal (coin.get-balance (ref-DALOS::UR_AccountStoa patron)))
        )
        (print (format "<(TS02-C3.AQP-SCR|C_IssueOrtoFungibleScore)> => \"{}\"" [(ref-TS02-C3::AQP-SCR|C_IssueOrtoFungibleScore patron patron "GtOfScoreProbe" 12 1.0 1.0)]))
        (let
            (
                (real-gas:decimal (- pre-gas (ref-DPTF::UR_AccountSupply gas-id patron)))
                (real-stoa:decimal (- pre-stoa (coin.get-balance (ref-DALOS::UR_AccountStoa patron))))
            )
            (map print
                [
                    (format "<<TX-INFO-GT-SCROF>> IGNIS predicted={} real={} | STOA predicted={} real={}"
                        [(at "ignis-need" (at "ignis" predicted)) real-gas
                         (at "stoa-need" (at "stoa" predicted)) real-stoa])
                    (expect "<<TX-INFO-GT-SCROF>> the IGNIS quote equals the IGNIS charged"
                        real-gas (at "ignis-need" (at "ignis" predicted)))
                    (expect "<<TX-INFO-GT-SCROF>> the STOA quote equals the STOA charged"
                        real-stoa (at "stoa-need" (at "stoa" predicted)))
                    (expect "<<TX-INFO-GT-SCROF>> ...and issuance is NOT free in STOA" true (> real-stoa 0.0))
                ]
            )
        )
    )
    ""
)
(env-sigs [])
(rollback-tx)

