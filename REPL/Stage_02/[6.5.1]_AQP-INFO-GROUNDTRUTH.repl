;;==== TX913 · 03 · SF/coll batch-DRAIN cost equality ====
(begin-tx "TX-INFO-GT-SF-DRAIN - INFO_BatchDrainCollectable.ignis-need == real GAS delta")
(print "--- [TX913 · 03 · SF batch-drain cost equality] ---")
(namespace "ouronet-ns")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(env-sigs [{ "key": "PK_AncientHodler", "caps": [] }])
(let
    (
        (patron:string KST.ANHD) (gas-id:string "GAS-98c486052a51") (son:bool true)
        (ref-U|DALOS:module{UtilityDalosV1} U|DALOS)
        (ref-DPTF:module{DemiourgosPactTrueFungibleV1} DPTF)
        (ref-TS02-C3:module{TalosStageTwo_ClientThreeV1} TS02-C3)
        (pool-id:string (ref-U|DALOS::UDC_Makeid "InfoGtSfDrPool"))
    )
    (let ((lane:object{AQP-VCT.VCT|VacateNonceLane} (at 0 (AQP-VCT.URH_VacateCollectablesPoolLegs pool-id son))))
        (let
            (
                (coll-id:string (at "asset-id" lane))
                (legs:[object{AQP-VCT.VCT|VacateNonceLeg}] (at "legs" lane))
            )
            (let
                (
                    (predicted:decimal
                        (at "ignis-need" (at "ignis"
                            (AQP-INFO.AQP-POOL|INFO_BatchDrainCollectable patron pool-id coll-id son legs))))
                    (pre-gas:decimal (ref-DPTF::UR_AccountSupply gas-id patron))
                )
                (print (format "<(INFO_BatchDrainCollectable)> predicted ignis-need = {} ; legs = {} ; pre-gas = {}"
                    [predicted (length legs) pre-gas]))
                (print (format "<(CCp_BatchDrainCollectable)> => \"{}\""
                    [(ref-TS02-C3::AQP-POOL|CCp_BatchDrainCollectable
                        patron pool-id coll-id son
                        (map (lambda (l:object{AQP-VCT.VCT|VacateNonceLeg}) (at "owner-id" l)) legs)
                        (map (lambda (l:object{AQP-VCT.VCT|VacateNonceLeg}) (at "beneficiary-id" l)) legs)
                        (map (lambda (l:object{AQP-VCT.VCT|VacateNonceLeg}) (at "nonces" l)) legs)
                        (map (lambda (l:object{AQP-VCT.VCT|VacateNonceLeg})
                                (map (lambda (q:decimal) (floor q)) (at "amounts" l))) legs))]))
                (let ((post-gas:decimal (ref-DPTF::UR_AccountSupply gas-id patron)))
                    (print (format "<(post-gas)> = {} ; actual delta = {}" [post-gas (- pre-gas post-gas)]))
                    (map print
                        [ (expect (format "TX-INFO-GT-SF-DRAIN: INFO predicted {} == real GAS delta {}"
                              [predicted (- pre-gas post-gas)])
                            predicted (- pre-gas post-gas)) ]))
            )
        )
    )
)
(commit-tx)
(print "")
(print "=== [6.5.1] AQP-INFO GROUND TRUTH — TF/OF/SF stake+unstake + TF/OF/SF vacate + TF/OF/SF drain cost-equality complete ===")
