;;
;; REPL/Stage_02/[6.4]_AQP-EXHAUSTIVE-BOOT-POOLS.repl — stake/unstake on all AQP-BOOT Step7 production pools
;;
(print "")
(print "================================================================")
(print "FILE  REPL/Stage_02/[6.4]_AQP-EXHAUSTIVE-BOOT-POOLS.repl")
(print "================================================================")
(print "")
;;
(begin-tx "TX-AQP-BP01 - DHWonderCoach DPSF stake + unstake")
(print "")
(print "=== TX-AQP-BP01 — DHWonderCoach SubsidiaryWonderCoach stake cycle ============")
(namespace "ouronet-ns")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(let
    (
        (patron:string KST.ANHD)
        (owner:string KST.ANHD)
        (dhwc-id:string "DHWC-98c486052a51")
        (ref-U|DALOS:module{UtilityDalosV1} U|DALOS)
        (ref-DPDC:module{DpdcV1} DPDC)
        (ref-TS02-C3:module{TalosStageTwo_ClientThreeV1} TS02-C3)
        (ref-SCR:module{AcquisitionScoresV1} AQP-SCORE)
        (pool-id:string (ref-U|DALOS::UDC_Makeid "DHWonderCoach"))
        (score-id:string (ref-U|DALOS::UDC_Makeid "SubsidiaryWonderCoach"))
        (nonces:[integer] (ref-DPDC::URD_AccountNonces owner dhwc-id true))
        (stake-nonce:integer (at 0 nonces))
        (stake-amt:integer (ref-DPDC::UR_AccountNonceSupply owner dhwc-id true (at 0 nonces)))
        (deb-pre:decimal (ref-SCR::UR_U-SCR|UserScoreDebScore owner pool-id score-id))
    )
    (env-sigs [{ "key": "PK_AncientHodler", "caps": [] }])
    (enforce (> (length nonces) 0) "ANHD needs DHWC nonces")
    (print (format "<(C_StakeSemiFungible DHWC nonce={})> => \"{}\"" [stake-nonce
        (ref-TS02-C3::AQP-POOL|C_StakeSemiFungibleCollectable patron pool-id owner owner dhwc-id [stake-nonce])
    ]))
    (let
        (
            (deb-post:decimal (ref-SCR::UR_U-SCR|UserScoreDebScore owner pool-id score-id))
        )
        (expect (format "<<TX-AQP-BP01>> deb increased got={} pre={}" [deb-post deb-pre]) true (> deb-post deb-pre))
    )
    (print (format "<(C_UnstakeSemiFungible DHWC)> => \"{}\"" [
        (ref-TS02-C3::AQP-POOL|C_UnstakeSemiFungibleCollectable patron pool-id owner dhwc-id [stake-nonce] [stake-amt])
    ]))
    (let
        (
            (deb-final:decimal (ref-SCR::UR_U-SCR|UserScoreDebScore owner pool-id score-id))
        )
        (expect (format "<<TX-AQP-BP01>> deb zeroed after unstake got={}" [deb-final]) 0.0 deb-final)
    )
)
(env-sigs [])
(commit-tx)
(print "")
;;
(begin-tx "TX-AQP-BP02 - DHCompany shares score stake (E|DH tier-7 morph)")
(print "")
(print "=== TX-AQP-BP02 — CompanySharesTreasury denominator via E|DH stake ==========")
(namespace "ouronet-ns")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(let
    (
        (patron:string KST.ANHD)
        (anhd:string KST.ANHD)
        (edh-id:string "E|DH-98c486052a51")
        (ref-TS02-C1:module{TalosStageTwo_ClientOneV1} TS02-C1)
        (ref-U|DALOS:module{UtilityDalosV1} U|DALOS)
        (ref-TS02-C3:module{TalosStageTwo_ClientThreeV1} TS02-C3)
        (ref-SCR:module{AcquisitionScoresV1} AQP-SCORE)
        (pool-id:string (ref-U|DALOS::UDC_Makeid "DHCompany"))
        (shares-score:string (ref-U|DALOS::UDC_Makeid "DemiourgosShareholder"))
    )
    (env-sigs [{ "key": "PK_AncientHodler", "caps": [] }])
    (print (format "<(C_StakeSemiFungible E|DH tier-6 shareholder)> => \"{}\"" [
        (ref-TS02-C3::AQP-POOL|C_StakeSemiFungibleCollectable patron pool-id anhd anhd edh-id [6])
    ]))
    (let
        (
            (deb:decimal (ref-SCR::UR_U-SCR|UserScoreDebScore anhd pool-id shares-score))
            (total:decimal (ref-SCR::UR_SCR|ScoreTotalDebScore shares-score))
        )
        (map print
            [
                (format "<(shares deb)> => \"{}\" <(total)> => \"{}\"" [deb total])
                (expect (format "<<TX-AQP-BP02>> shareholder deb>0 got={}" [deb]) true (> deb 0.0))
            ]
        )
    )
)
(env-sigs [])
(commit-tx)
(print "")
;;
(begin-tx "TX-AQP-BP03 - DHOuroLp TF stake + farm Auryn inject readiness")
(print "")
(print "=== TX-AQP-BP03 — OURO LP pool TF stake + OuroLpFarm inject denominator ======")
(namespace "ouronet-ns")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(let
    (
        (patron:string KST.ANHD)
        (owner:string KST.ANHD)
        (emma:string KST.EMMA)
        (ouro-id:string "OURO-98c486052a51")
        (auryn-id:string "AURYN-98c486052a51")
        (kbn-id:string "KBN-98c486052a51")
        (auryn-rain-nonce:integer 75)
        (ref-U|DALOS:module{UtilityDalosV1} U|DALOS)
        (ref-DPDC:module{DpdcV1} DPDC)
        (ref-ANK:module{AcquisitionAnchorsV1} AQP-ANK)
        (ref-SWP:module{SwapperV3} SWP)
        (ref-DPTF:module{DemiourgosPactTrueFungibleV1} DPTF)
        (ref-TS01-C3:module{TalosStageOne_ClientThreeV3} TS01-C3)
        (ref-TS02-C2:module{TalosStageTwo_ClientTwoV1} TS02-C2)
        (ref-TS02-C3:module{TalosStageTwo_ClientThreeV1} TS02-C3)
        (ref-SCR:module{AcquisitionScoresV1} AQP-SCORE)
        (ref-FVT:module{AcquisitionFarmsVaultsTreasuriesV1} AQP-FVT)
        (ref-AQP:module{AcquisitionPoolsV1} AQP-POOL)
        (pool-id:string (ref-U|DALOS::UDC_Makeid "DHOuroLp"))
        (bunnies-pool:string (ref-U|DALOS::UDC_Makeid "DHBunnies"))
        (silver-score:string (ref-U|DALOS::UDC_Makeid "SilverSnakePower"))
        (farm-id:string (ref-U|DALOS::UDC_Makeid "OuroLpFarm"))
        (swpair:string "W|DLK-98c486052a51|OURO-98c486052a51|DWK-98c486052a51")
        (lp-id:string (ref-SWP::UR_TokenLP swpair))
        (lp-bal:decimal (ref-DPTF::UR_AccountSupply lp-id owner))
        (farm-class:integer
            (try -1 (ref-FVT::UR_FVT|FvtClass farm-id))
        )
        (pool-class:integer (try -1 (ref-AQP::UR_AQP|PoolAqpClass pool-id)))
    )
    (env-sigs
        [
            { "key": "PK_AncientHodler", "caps": [] }
            { "key": "PK_Emma", "caps": [] }
            { "key": "PK_Lumy", "caps": [] }
        ]
    )
    (if (and (!= farm-class -1) (>= pool-class 0))
        (let
            (
                (lp-bal-work:decimal lp-bal)
            )
            (if (< lp-bal-work 100.0)
                (print (format "<(BP03 seed LP)> => \"{}\"" [
                    (ref-TS01-C3::SWP|C_AddLiquidity patron patron swpair [50.0 50.0 50.0])
                ]))
                true
            )
            (let
                (
                    (lp-bal-final:decimal (ref-DPTF::UR_AccountSupply lp-id owner))
                    (stake-amt:decimal
                        (if (> lp-bal-final 100.0) 100.0 lp-bal-final)
                    )
                )
                (if (>= lp-bal-final stake-amt)
                    (do
                        (let
                            (
                                (prom-pre:decimal (ref-ANK::UR_UB|AggregatePromile owner silver-score))
                                (anhd-kbn:[integer] (ref-DPDC::URD_AccountNonces owner kbn-id false))
                            )
                            (if (= prom-pre 0.0)
                                (let
                                    (
                                        (emma-kbn:[integer] (ref-DPDC::URD_AccountNonces emma kbn-id false))
                                    )
                                    (if (not (contains auryn-rain-nonce anhd-kbn))
                                        (enforce (contains auryn-rain-nonce emma-kbn) "BP03: EMMA must hold Auryn Rain KBN nonce 75")
                                        true
                                    )
                                    (if (not (contains auryn-rain-nonce anhd-kbn))
                                        (print (format "<(DPNF transfer AurynRain nonce {} EMMA→ANHD)> => \"{}\"" [auryn-rain-nonce
                                            (ref-TS02-C2::DPNF|C_TransferNonce patron kbn-id emma owner auryn-rain-nonce 1 false)
                                        ]))
                                        true
                                    )
                                    (print (format "<(C_StakeNonFungible DHBunnies KBN nonce {})> => \"{}\"" [auryn-rain-nonce
                                        (ref-TS02-C3::AQP-POOL|C_StakeNonFungibleCollectable
                                            patron bunnies-pool owner owner kbn-id [auryn-rain-nonce]
                                        )
                                    ]))
                                )
                                true
                            )
                            (let
                                (
                                    (prom-post:decimal (ref-ANK::UR_UB|AggregatePromile owner silver-score))
                                )
                                (print (format "<(SilverSnakePower promile ANHD)> => \"{}\"" [prom-post]))
                                (enforce (> prom-post 0.0) "BP03 needs SilverSnakePower promile — Auryn Rain KBN stake")
                            )
                        )
                        (print (format "<(C_StakeTrueFungible DHOuroLp LP amount={})> => \"{}\"" [stake-amt
                            (ref-TS02-C3::AQP-POOL|C_StakeTrueFungible patron pool-id owner owner lp-id stake-amt)
                        ]))
                        (let
                            (
                                (deb:decimal (ref-SCR::UR_U-SCR|UserScoreDebScore owner pool-id silver-score))
                                (denom:decimal (ref-FVT::URC_InjectDenominator farm-id))
                            )
                            (map print
                                [
                                    (format "<(SilverSnakePower deb)> => \"{}\"" [deb])
                                    (format "<(OuroLpFarm inject denominator)> => \"{}\"" [denom])
                                    (expect (format "<<TX-AQP-BP03>> LP deb>0 got={}" [deb]) true (> deb 0.0))
                                    (expect (format "<<TX-AQP-BP03>> farm denom>0 got={}" [denom]) true (> denom 0.0))
                                ]
                            )
                        )
                        (print (format "<(C_Inject Auryn farm 50)> => \"{}\"" [
                            (ref-TS02-C3::AQP-FVT|C_Inject patron farm-id auryn-id 50.0)
                        ]))
                    )
                    (print (format "SKIP TX-AQP-BP03: no LP balance after seed (lp-bal={})" [lp-bal-final]))
                )
            )
        )
        (print (format "SKIP TX-AQP-BP03: DHOuroLp/OuroLpFarm not provisioned on REPL (lp-bal={} farm-class={})" [lp-bal farm-class]))
    )
)
(env-sigs [])
(commit-tx)
(print "")
(print "=== END [6.4]_AQP-EXHAUSTIVE-BOOT-POOLS.repl =================================")
