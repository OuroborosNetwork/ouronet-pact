;;
;; REPL/Stage_02/[6.4]_AQP-EXHAUSTIVE-ANK-LP.repl — KBN bunny anchors → OURO LP score boost chain
;; Requires: AQP-BOOT Steps 1–3 (bunny set + snake anchor classes), Step6 triplet, Step7 DHOuroLp.
;;
(print "")
(print "================================================================")
(print "FILE  REPL/Stage_02/[6.4]_AQP-EXHAUSTIVE-ANK-LP.repl")
(print "================================================================")
(print "")
;;
(begin-tx "TX-AQP-A01 - Anchor class inventory after boot Steps 2–3")
(print "")
(print "=== TX-AQP-A01 — SnakePower + booster anchor classes exist ==================")
(namespace "ouronet-ns")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(let
    (
        (ref-U|DALOS:module{UtilityDalosV1} U|DALOS)
        (ref-ANK:module{AcquisitionAnchorsV1} AQP-ANK)
        (silver-bc:string (ref-U|DALOS::UDC_Makeid "SilverSnakePower"))
        (bronze-bc:string (ref-U|DALOS::UDC_Makeid "BronzeSnakePower"))
        (unity-bc:string (ref-U|DALOS::UDC_Makeid "UnityBooster"))
        (ouro-rain:string (ref-U|DALOS::UDC_Makeid "AurynRain"))
    )
    (env-sigs [{ "key": "PK_AncientHodler", "caps": [] }])
    (map print
        [
            (expect (format "<<TX-AQP-A01>> SilverSnakePower BC active got={}" [(ref-ANK::UR_BC|Active silver-bc)]) true (ref-ANK::UR_BC|Active silver-bc))
            (expect (format "<<TX-AQP-A01>> BronzeSnakePower BC active got={}" [(ref-ANK::UR_BC|Active bronze-bc)]) true (ref-ANK::UR_BC|Active bronze-bc))
            (expect (format "<<TX-AQP-A01>> UnityBooster BC active got={}" [(ref-ANK::UR_BC|Active unity-bc)]) true (ref-ANK::UR_BC|Active unity-bc))
            (expect (format "<<TX-AQP-A01>> AurynRain anchor active got={}" [(ref-ANK::UR_ANK|State ouro-rain)]) true (ref-ANK::UR_ANK|State ouro-rain))
        ]
    )
)
(env-sigs [])
(commit-tx)
(print "")
;;
(begin-tx "TX-AQP-A02 - LP score boost links from Step 6 triplet")
(print "")
(print "=== TX-AQP-A02 — Bronze/Golden boost-link → Silver (LP triplet) ============")
(namespace "ouronet-ns")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(let
    (
        (ref-U|DALOS:module{UtilityDalosV1} U|DALOS)
        (ref-SCR:module{AcquisitionScoresV1} AQP-SCORE)
        (silver-id:string (ref-U|DALOS::UDC_Makeid "SilverSnakePower"))
        (bronze-id:string (ref-U|DALOS::UDC_Makeid "BronzeSnakePower"))
        (golden-id:string (ref-U|DALOS::UDC_Makeid "GoldenSnakePower"))
        (bronze-link:string (ref-SCR::UR_SCR|ScoreBoostLink bronze-id))
        (golden-link:string (ref-SCR::UR_SCR|ScoreBoostLink golden-id))
    )
    (env-sigs [{ "key": "PK_AncientHodler", "caps": [] }])
    (map print
        [
            (expect (format "<<TX-AQP-A02>> bronze→silver link got={} expected={}" [bronze-link silver-id]) silver-id bronze-link)
            (expect (format "<<TX-AQP-A02>> golden→silver link got={} expected={}" [golden-link silver-id]) silver-id golden-link)
        ]
    )
)
(env-sigs [])
(commit-tx)
(print "")
;;
(begin-tx "TX-AQP-A03 - OURO LP stake + anchor sync raises boosted score")
(print "")
(print "=== TX-AQP-A03 — DHOuroLp stake: base vs boosted SilverSnakePower ============")
(namespace "ouronet-ns")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(let
    (
        (patron:string KST.ANHD)
        (owner:string KST.ANHD)
        (emma:string KST.EMMA)
        (kbn-id:string "KBN-98c486052a51")
        (auryn-rain-nonce:integer 75)
        (ref-U|DALOS:module{UtilityDalosV1} U|DALOS)
        (ref-DPDC:module{DpdcV1} DPDC)
        (ref-ANK:module{AcquisitionAnchorsV1} AQP-ANK)
        (ref-SWP:module{SwapperV3} SWP)
        (ref-DPTF:module{DemiourgosPactTrueFungibleV1} DPTF)
        (ref-TS02-C2:module{TalosStageTwo_ClientTwoV1} TS02-C2)
        (ref-TS02-C3:module{TalosStageTwo_ClientThreeV1} TS02-C3)
        (ref-SCR:module{AcquisitionScoresV1} AQP-SCORE)
        (ref-AQP:module{AcquisitionPoolsV1} AQP-POOL)
        (pool-id:string (ref-U|DALOS::UDC_Makeid "DHOuroLp"))
        (bunnies-pool:string (ref-U|DALOS::UDC_Makeid "DHBunnies"))
        (silver-id:string (ref-U|DALOS::UDC_Makeid "SilverSnakePower"))
        (swpair:string "W|DLK-98c486052a51|OURO-98c486052a51|DWK-98c486052a51")
        (lp-id:string (ref-SWP::UR_TokenLP swpair))
        (ouro-id:string "OURO-98c486052a51")
        (lp-bal:decimal (ref-DPTF::UR_AccountSupply lp-id owner))
        (pool-class:integer (try -1 (ref-AQP::UR_AQP|PoolAqpClass pool-id)))
    )
    (env-sigs
        [
            { "key": "PK_AncientHodler", "caps": [] }
            { "key": "PK_Emma", "caps": [] }
            { "key": "PK_Lumy", "caps": [] }
        ]
    )
    (if (and (>= pool-class 0) (> lp-bal 0.0))
        (let
            (
                (stake-amt:decimal (if (> lp-bal 100.0) 100.0 lp-bal))
                (prom-pre:decimal (ref-ANK::UR_UB|AggregatePromile owner silver-id))
            )
            (if (= prom-pre 0.0)
                (let
                    (
                        (anhd-kbn:[integer] (ref-DPDC::URH_AccountNonces owner kbn-id false))
                        (emma-kbn:[integer] (ref-DPDC::URH_AccountNonces emma kbn-id false))
                    )
                    (if (not (contains auryn-rain-nonce anhd-kbn))
                        (enforce (contains auryn-rain-nonce emma-kbn) "A03: EMMA must hold Auryn Rain KBN nonce 75")
                        true
                    )
                    (if (not (contains auryn-rain-nonce anhd-kbn))
                        (print (format "<(DPNF transfer AurynRain nonce {} EMMA→ANHD)> => \"{}\"" [auryn-rain-nonce
                            (ref-TS02-C2::DPNF|C_TransferNonce patron kbn-id emma owner auryn-rain-nonce 1 false)
                        ]))
                        true
                    )
                    (print (format "<(C_StakeNonFungible DHBunnies KBN nonce {})> => \"{}\"" [auryn-rain-nonce
                        (ref-TS02-C3::AQP-POOL|CC_StakeNonFungibleCollectable
                            patron bunnies-pool owner owner kbn-id [auryn-rain-nonce]
                        )
                    ]))
                )
                true
            )
            (let
                (
                    (base-pre:decimal (ref-SCR::UR_U-SCR|UserScoreBaseScore owner pool-id silver-id))
                    (boost-pre:decimal (ref-SCR::UR_U-SCR|UserScoreBoostedScore owner pool-id silver-id))
                )
            (print (format "<(pre-stake base)> => \"{}\" <(boost)> => \"{}\"" [base-pre boost-pre]))
            (print (format "<(CC_StakeTrueFungible DHOuroLp LP {})> => \"{}\"" [stake-amt
                (ref-TS02-C3::AQP-POOL|CC_StakeTrueFungible patron pool-id owner owner lp-id stake-amt)
            ]))
            (let
                (
                    (base-post:decimal (ref-SCR::UR_U-SCR|UserScoreBaseScore owner pool-id silver-id))
                    (boost-post:decimal (ref-SCR::UR_U-SCR|UserScoreBoostedScore owner pool-id silver-id))
                    (deb:decimal (ref-SCR::UR_U-SCR|UserScoreDebScore owner pool-id silver-id))
                )
                (map print
                    [
                        (format "<(post-stake base)> => \"{}\" <(boost)> => \"{}\" <(deb)> => \"{}\"" [base-post boost-post deb])
                        (expect (format "<<TX-AQP-A03>> deb>0 got={}" [deb]) true (> deb 0.0))
                        (expect (format "<<TX-AQP-A03>> base>0 got={}" [base-post]) true (> base-post 0.0))
                    ]
                )
            )
        )
        )
        (print (format "SKIP TX-AQP-A03: DHOuroLp not issued on REPL (lp-bal={} pool-class={})" [lp-bal pool-class]))
    )
)
(env-sigs [])
(commit-tx)
(print "")
;;
(begin-tx "TX-AQP-A04 - staking a conforming Elk0nite-trait KBN bunny grants EMMA the Elk0nite promile")
(print "")
(print "=== TX-AQP-A04 — trait-anchor promile path: stake a CONFORMING Elk0nite bunny ==")
(namespace "ouronet-ns")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(let
    (
        (patron:string KST.ANHD)
        (owner:string KST.EMMA)
        (beneficiary:string KST.EMMA)
        (kbn-id:string "KBN-98c486052a51")
        (ref-U|DALOS:module{UtilityDalosV1} U|DALOS)
        (ref-ANK:module{AcquisitionAnchorsV1} AQP-ANK)
        (ref-DPDC:module{DpdcV1} DPDC)
        (ref-TS02-C3:module{TalosStageTwo_ClientThreeV1} TS02-C3)
        (pool-id:string (ref-U|DALOS::UDC_Makeid "DHBunnies"))
        (elk0nite-id:string (ref-U|DALOS::UDC_Makeid "Elk0nite"))
        ;; read the required trait straight from the anchor (robust to fixture edits)
        (trait-key:string (ref-ANK::UR_ANK|NFTraitKey elk0nite-id))
        (trait-value:string (ref-ANK::UR_ANK|NFTraitValue elk0nite-id))
        (anchors-active:integer (ref-ANK::UR_AA|AnchorsActive kbn-id))
        ;; EMMA's UNSTAKED KBN nonces that CONFORM to the Elk0nite trait — URC_ConformNonces is the exact
        ;; matcher the NF-stake anchor sync uses, so a conforming nonce is GUARANTEED to grant the promile.
        ;; (NF03 staked an arbitrary (at 0) nonce that need not be an Elk0nite bunny — hence promile 0 there.)
        (elk-nonces:[integer]
            (filter
                (lambda (n:integer) (= 1 (ref-ANK::URC_ConformNonces kbn-id [n] trait-key trait-value)))
                (ref-DPDC::URH_AccountNonces owner kbn-id false)))
    )
    (env-sigs
        [
            { "key": "PK_AncientHodler", "caps": [] }
            { "key": "PK_Emma", "caps": [] }
            { "key": "PK_Lumy", "caps": [] }
        ]
    )
    (print (format "<(anchors-active KBN)> => \"{}\" <(Elk0nite trait)> => \"{}={}\" <(EMMA conforming nonces)> => \"{}\"" [anchors-active trait-key trait-value elk-nonces]))
    (expect (format "<<TX-AQP-A04>> KBN anchors-active>=0 got={}" [anchors-active]) true (>= anchors-active 0))
    (if (> (length elk-nonces) 0)
        (let
            (
                (elk-nonce:integer (at 0 elk-nonces))
            )
            ;; stake a CONFORMING Elk0nite bunny → the NF-stake anchor sync must grant EMMA the Elk0nite promile
            (print (format "<(C_StakeNonFungible KBN Elk0nite bunny nonce={})> => \"{}\"" [elk-nonce
                (ref-TS02-C3::AQP-POOL|CC_StakeNonFungibleCollectable patron pool-id owner beneficiary kbn-id [elk-nonce])
            ]))
            (let
                (
                    (promile:decimal (ref-ANK::UR_ANK-U|Promile owner elk0nite-id))
                )
                (print (format "<(Elk0nite promile EMMA after conforming stake)> => \"{}\"" [promile]))
                (expect (format "<<TX-AQP-A04>> Elk0nite promile>0 after staking a conforming bunny got={}" [promile]) true (> promile 0.0))
            )
        )
        (print "SKIP TX-AQP-A04 promile assert: EMMA owns no unstaked Elk0nite-trait KBN bunny")
    )
)
(env-sigs [])
(commit-tx)
(print "")
;;
;; ============================================================================
;; TX-AQP-A05a — GAS BASELINE: stake a bunny that conforms to a SINGLE anchor
;; (Common rarity + Elk0nite Eyes → only the Elk0nite UnityBooster anchor). The
;; NF-stake anchor sync scans EVERY live KBN anchor regardless, so this is the
;; reference cost to compare the multi-anchor stake (A05b) against.
;; ============================================================================
(begin-tx "TX-AQP-A05a - single-anchor KBN bunny stake (gas baseline)")
(print "")
(print "=== TX-AQP-A05a — GAS baseline: stake a bunny matching ONE anchor ===========")
(namespace "ouronet-ns")
(env-gasmodel "table")(env-gaslimit 150000000)(env-gas 0)
(let
    (
        (patron:string KST.ANHD)
        (owner:string KST.EMMA)
        (beneficiary:string KST.EMMA)
        (kbn-id:string "KBN-98c486052a51")
        (ref-U|DALOS:module{UtilityDalosV1} U|DALOS)
        (ref-ANK:module{AcquisitionAnchorsV1} AQP-ANK)
        (ref-DPDC:module{DpdcV1} DPDC)
        (ref-TS02-C3:module{TalosStageTwo_ClientThreeV1} TS02-C3)
        (pool-id:string (ref-U|DALOS::UDC_Makeid "DHBunnies"))
        ;; Common + Elk0nite-Eyes ⇒ conforms to ONLY the Elk0nite anchor (not Legendary, not a snake Background)
        (single-nonces:[integer]
            (filter
                (lambda (n:integer)
                    (and (= 1 (ref-ANK::URC_ConformNonces kbn-id [n] "Eyes" "Elk0nite Unity Glasses"))
                         (= 1 (ref-ANK::URC_ConformNonces kbn-id [n] "Rarity" "Common"))))
                (ref-DPDC::URH_AccountNonces owner kbn-id false)))
    )
    (env-sigs [ { "key": "PK_AncientHodler", "caps": [] } { "key": "PK_Emma", "caps": [] } { "key": "PK_Lumy", "caps": [] } ])
    (if (> (length single-nonces) 0)
        (let ((n:integer (at 0 single-nonces)))
            (env-gas 0)
            (ref-TS02-C3::AQP-POOL|CC_StakeNonFungibleCollectable patron pool-id owner beneficiary kbn-id [n])
            (print (format "<(A05a SINGLE-anchor stake nonce={} · GAS)> => {}" [n (env-gas)])))
        (print "SKIP TX-AQP-A05a: EMMA owns no unstaked Common Elk0nite bunny"))
)
(env-sigs [])
(commit-tx)
(print "")
;;
;; ============================================================================
;; TX-AQP-A05b — MULTI-ANCHOR FAN-OUT: stake ONE "Legendary Elite-Auryn Rain" bunny.
;; A single NFT conforming to FIVE anchors across FOUR boost-classes:
;;   EliteAurynRain        (Background="Elite-Auryn Rain") → GoldenSnakePower  200
;;   LegendarySnakeTokenRain (Rarity="Legendary")          → GoldenSnakePower  400
;;   LegendaryUnityBooster (Rarity="Legendary")            → UnityBooster     1000
;;   LegendaryStoaBooster  (Rarity="Legendary")            → StoaBooster      3500
;;   LegendaryVestaBooster (Rarity="Legendary")            → VestaBooster     3500
;; Proves the fan-out (XE_ResyncNonFungibleUserAnchorValues maps ALL anchors +
;; recomputes DISTINCT affected boost-classes): every per-user promile lights up,
;; every touched boost-class aggregates, and the SAME-CLASS case (2 anchors on
;; GoldenSnakePower) sums correctly. Also measures gas vs the single-anchor baseline.
;; ============================================================================
(begin-tx "TX-AQP-A05b - multi-anchor fan-out: one Legendary Elite-Auryn Rain bunny -> 5 anchors / 4 boost-classes")
(print "")
(print "=== TX-AQP-A05b — MULTI-ANCHOR fan-out from a single NFT stake ==============")
(namespace "ouronet-ns")
(env-gasmodel "table")(env-gaslimit 150000000)(env-gas 0)
(let
    (
        (patron:string KST.ANHD)
        (owner:string KST.EMMA)
        (beneficiary:string KST.EMMA)
        (kbn-id:string "KBN-98c486052a51")
        (ref-U|DALOS:module{UtilityDalosV1} U|DALOS)
        (ref-ANK:module{AcquisitionAnchorsV1} AQP-ANK)
        (ref-DPDC:module{DpdcV1} DPDC)
        (ref-TS02-C3:module{TalosStageTwo_ClientThreeV1} TS02-C3)
        (pool-id:string (ref-U|DALOS::UDC_Makeid "DHBunnies"))
        ;; anchor + boost-class ids
        (elite-auryn:string        (ref-U|DALOS::UDC_Makeid "EliteAurynRain"))
        (legendary-snake:string    (ref-U|DALOS::UDC_Makeid "LegendarySnakeTokenRain"))
        (legendary-unity:string    (ref-U|DALOS::UDC_Makeid "LegendaryUnityBooster"))
        (legendary-stoa:string     (ref-U|DALOS::UDC_Makeid "LegendaryStoaBooster"))
        (legendary-vesta:string    (ref-U|DALOS::UDC_Makeid "LegendaryVestaBooster"))
        (golden-bc:string          (ref-U|DALOS::UDC_Makeid "GoldenSnakePower"))
        (unity-bc:string           (ref-U|DALOS::UDC_Makeid "UnityBooster"))
        (stoa-bc:string            (ref-U|DALOS::UDC_Makeid "StoaBooster"))
        (vesta-bc:string           (ref-U|DALOS::UDC_Makeid "VestaBooster"))
        ;; a nonce that CONFORMS to BOTH Rarity=Legendary AND Background=Elite-Auryn Rain (⇒ all 5 anchors)
        (multi-nonces:[integer]
            (filter
                (lambda (n:integer)
                    (and (= 1 (ref-ANK::URC_ConformNonces kbn-id [n] "Rarity" "Legendary"))
                         (= 1 (ref-ANK::URC_ConformNonces kbn-id [n] "Background" "Elite-Auryn Rain"))))
                (ref-DPDC::URH_AccountNonces owner kbn-id false)))
    )
    (env-sigs [ { "key": "PK_AncientHodler", "caps": [] } { "key": "PK_Emma", "caps": [] } { "key": "PK_Lumy", "caps": [] } ])
    (print (format "<(EMMA Legendary-Elite-Auryn conforming nonces)> => \"{}\"" [multi-nonces]))
    (if (> (length multi-nonces) 0)
        (let ((n:integer (at 0 multi-nonces)))
            ;; stake the multi-trait bunny (measure gas around JUST the stake)
            (env-gas 0)
            (ref-TS02-C3::AQP-POOL|CC_StakeNonFungibleCollectable patron pool-id owner beneficiary kbn-id [n])
            (let
                (
                    (g-multi:integer (env-gas))
                    (p-elite:decimal    (ref-ANK::UR_ANK-U|Promile owner elite-auryn))
                    (p-lsnake:decimal   (ref-ANK::UR_ANK-U|Promile owner legendary-snake))
                    (p-lunity:decimal   (ref-ANK::UR_ANK-U|Promile owner legendary-unity))
                    (p-lstoa:decimal    (ref-ANK::UR_ANK-U|Promile owner legendary-stoa))
                    (p-lvesta:decimal   (ref-ANK::UR_ANK-U|Promile owner legendary-vesta))
                    (agg-golden:decimal (ref-ANK::UR_UB|AggregatePromile owner golden-bc))
                    (agg-unity:decimal  (ref-ANK::UR_UB|AggregatePromile owner unity-bc))
                    (agg-stoa:decimal   (ref-ANK::UR_UB|AggregatePromile owner stoa-bc))
                    (agg-vesta:decimal  (ref-ANK::UR_UB|AggregatePromile owner vesta-bc))
                )
                (map print
                    [
                        (format "<(A05b MULTI-anchor stake nonce={} · GAS)> => {}" [n g-multi])
                        (format "<(per-anchor promile)> EliteAuryn={} LSnake={} LUnity={} LStoa={} LVesta={}" [p-elite p-lsnake p-lunity p-lstoa p-lvesta])
                        (format "<(boost-class aggregate)> Golden={} Unity={} Stoa={} Vesta={}" [agg-golden agg-unity agg-stoa agg-vesta])
                        ;; (a) ALL FIVE anchors got a per-user promile from the single stake
                        (expect (format "<<TX-AQP-A05b>> EliteAurynRain promile>0 got={}" [p-elite]) true (> p-elite 0.0))
                        (expect (format "<<TX-AQP-A05b>> LegendarySnakeTokenRain promile>0 got={}" [p-lsnake]) true (> p-lsnake 0.0))
                        (expect (format "<<TX-AQP-A05b>> LegendaryUnityBooster promile>0 got={}" [p-lunity]) true (> p-lunity 0.0))
                        (expect (format "<<TX-AQP-A05b>> LegendaryStoaBooster promile>0 got={}" [p-lstoa]) true (> p-lstoa 0.0))
                        (expect (format "<<TX-AQP-A05b>> LegendaryVestaBooster promile>0 got={}" [p-lvesta]) true (> p-lvesta 0.0))
                        ;; (b) ALL FOUR distinct boost-classes were recomputed to a non-zero aggregate
                        (expect (format "<<TX-AQP-A05b>> GoldenSnakePower aggregate>0 got={}" [agg-golden]) true (> agg-golden 0.0))
                        (expect (format "<<TX-AQP-A05b>> UnityBooster aggregate>0 got={}" [agg-unity]) true (> agg-unity 0.0))
                        (expect (format "<<TX-AQP-A05b>> StoaBooster aggregate>0 got={}" [agg-stoa]) true (> agg-stoa 0.0))
                        (expect (format "<<TX-AQP-A05b>> VestaBooster aggregate>0 got={}" [agg-vesta]) true (> agg-vesta 0.0))
                        ;; (c) SAME-CLASS SUM: GoldenSnakePower carries TWO anchors (EliteAurynRain + LegendarySnakeTokenRain);
                        ;;     its aggregate must equal the sum of those two per-user promiles (the dedup+sum in RecomputeAffectedBoostAggregates)
                        (expect (format "<<TX-AQP-A05b>> GoldenSnakePower aggregate == EliteAuryn + LegendarySnake ({} == {}+{})" [agg-golden p-elite p-lsnake])
                            (+ p-elite p-lsnake) agg-golden)
                    ]
                )
            )
        )
        (print "SKIP TX-AQP-A05b: EMMA owns no unstaked Legendary Elite-Auryn Rain bunny")
    )
)
(env-sigs [])
(commit-tx)
(print "")
(print "=== END [6.4]_AQP-EXHAUSTIVE-ANK-LP.repl ====================================")
