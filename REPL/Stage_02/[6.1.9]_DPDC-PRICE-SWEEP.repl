                (at "ignis" (at 0 (at "cumulator-chain" (ref-DPDC-MNG::URCi_BurnNFT nft)))))
            (expect "<<TX-DPP-001>> DPSF|C_EnableSetClassFragmentation == deter(setup) + components"
