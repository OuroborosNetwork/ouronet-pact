;;
;; REPL/Stage_02/[6.1.9]_DPDC-PRICE-SWEEP.repl — DPDC full-module IGNIS price sweep (P7)
;;   Canonical integration layout (OuronetInformational/ARCHITECTURE/REPL_AND_TESTS.md).
;;   Legend:  <<TX-DPP-nnn>>  price assertion
;;   Source:  1_SOVEREIGN/STAGE_02/2_Core/01_DPDC/{05_DPDC-R,06_DPDC-MNG,08_DPDC-S,09_DPDC-F}.pact
;;   REPL tests: every migrated DPDC URCi_* cost reader, BOTH son branches.
;;
;;   WHY this file exists: DPDC-MNG::URCi_Control and URCi_WipeNonce were once half-migrated —
;;   the son=true branch billed the new deter+components price while son=false silently kept a
;;   legacy flat tier. That is syntactically valid, so the whole pipeline stayed green. Only a
;;   price assertion catches it, and only if it exercises BOTH branches. Hence: every son-taking
;;   reader below is asserted twice (SFT id + NFT id).
;;
;;   Fixtures: TSFS-98c486052a51 (SFT collection, from [6.1.3]) and CNF-98c486052a51 (NFT
;;   collection, from [6.1.4]) — so this file must load after those two suites.
;;
(print "")
(print "================================================================")
(print "FILE  REPL/Stage_02/[6.1.9]_DPDC-PRICE-SWEEP.repl  (DPDC price sweep)")
(print "================================================================")
(print "")

;;================================================================================
(begin-tx "TX-DPP-001 - DPDC price sweep: observed IGNIS == deter + components")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(namespace "ouronet-ns")
;;==== TX-DPP-001 · 01 · full-module sweep ====
(print "--- [TX-DPP-001 · 01 · full-module sweep] ---")
(let
    (
        (ref-IGNIS:module{IgnisCollectorV2} IGNIS)
        (ref-DPDC-R:module{DpdcRolesV2} DPDC-R)
        (ref-DPDC-MNG:module{DpdcManagementV2} DPDC-MNG)
        (ref-DPDC-S:module{DpdcSetsV2} DPDC-S)
        (ref-DPDC-F:module{DpdcFragmentsV2} DPDC-F)
        (sft:string "TSFS-98c486052a51")
        (nft:string "CNF-98c486052a51")
    )
    (map (print)
        [
            (expect "<<TX-DPP-001>> DPSF|C_ToggleAddQuantityRole == deter(auth) + components"
                (ref-IGNIS::UC_IgnisPrice "DPSF|C_ToggleAddQuantityRole" "auth")
                (at "ignis" (at 0 (at "cumulator-chain" (ref-DPDC-R::URCi_ToggleAddQuantityRole sft)))))
            (expect "<<TX-DPP-001>> DPSF|C_ToggleFreezeAccount == deter(setup) + components"
                (ref-IGNIS::UC_IgnisPrice "DPSF|C_ToggleFreezeAccount" "setup")
                (at "ignis" (at 0 (at "cumulator-chain" (ref-DPDC-R::URCi_ToggleFreezeAccount sft true)))))
            (expect "<<TX-DPP-001>> DPNF|C_ToggleFreezeAccount == deter(setup) + components"
                (ref-IGNIS::UC_IgnisPrice "DPNF|C_ToggleFreezeAccount" "setup")
                (at "ignis" (at 0 (at "cumulator-chain" (ref-DPDC-R::URCi_ToggleFreezeAccount nft false)))))
            (expect "<<TX-DPP-001>> DPSF|C_ToggleExemptionRole == deter(auth) + components"
                (ref-IGNIS::UC_IgnisPrice "DPSF|C_ToggleExemptionRole" "auth")
                (at "ignis" (at 0 (at "cumulator-chain" (ref-DPDC-R::URCi_ToggleExemptionRole sft true)))))
            (expect "<<TX-DPP-001>> DPNF|C_ToggleExemptionRole == deter(auth) + components"
                (ref-IGNIS::UC_IgnisPrice "DPNF|C_ToggleExemptionRole" "auth")
                (at "ignis" (at 0 (at "cumulator-chain" (ref-DPDC-R::URCi_ToggleExemptionRole nft false)))))
            (expect "<<TX-DPP-001>> DPSF|C_ToggleBurnRole == deter(auth) + components"
                (ref-IGNIS::UC_IgnisPrice "DPSF|C_ToggleBurnRole" "auth")
                (at "ignis" (at 0 (at "cumulator-chain" (ref-DPDC-R::URCi_ToggleBurnRole sft true)))))
            (expect "<<TX-DPP-001>> DPNF|C_ToggleBurnRole == deter(auth) + components"
                (ref-IGNIS::UC_IgnisPrice "DPNF|C_ToggleBurnRole" "auth")
                (at "ignis" (at 0 (at "cumulator-chain" (ref-DPDC-R::URCi_ToggleBurnRole nft false)))))
            (expect "<<TX-DPP-001>> DPSF|C_ToggleUpdateRole == deter(auth) + components"
                (ref-IGNIS::UC_IgnisPrice "DPSF|C_ToggleUpdateRole" "auth")
                (at "ignis" (at 0 (at "cumulator-chain" (ref-DPDC-R::URCi_ToggleUpdateRole sft true)))))
            (expect "<<TX-DPP-001>> DPNF|C_ToggleUpdateRole == deter(auth) + components"
                (ref-IGNIS::UC_IgnisPrice "DPNF|C_ToggleUpdateRole" "auth")
                (at "ignis" (at 0 (at "cumulator-chain" (ref-DPDC-R::URCi_ToggleUpdateRole nft false)))))
            (expect "<<TX-DPP-001>> DPSF|C_ToggleModifyCreatorRole == deter(auth) + components"
                (ref-IGNIS::UC_IgnisPrice "DPSF|C_ToggleModifyCreatorRole" "auth")
                (at "ignis" (at 0 (at "cumulator-chain" (ref-DPDC-R::URCi_ToggleModifyCreatorRole sft true)))))
            (expect "<<TX-DPP-001>> DPNF|C_ToggleModifyCreatorRole == deter(auth) + components"
