                (at "ignis" (at 0 (at "cumulator-chain" (ref-DPDC-R::URCi_ToggleTransferRole nft false)))))
            (expect "<<TX-DPP-001>> DPSF|C_MoveCreateRole == deter(auth) + components"
                (ref-IGNIS::UC_IgnisPrice "DPSF|C_MoveCreateRole" "auth")
