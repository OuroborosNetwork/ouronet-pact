                (at "ignis" (at 0 (at "cumulator-chain" (ref-DPDC-R::URCi_ToggleModifyRoyaltiesRole sft true)))))
            (expect "<<TX-DPP-001>> DPNF|C_ToggleModifyRoyaltiesRole == deter(fee) + components"
                (ref-IGNIS::UC_IgnisPrice "DPNF|C_ToggleModifyRoyaltiesRole" "fee")
                (at "ignis" (at 0 (at "cumulator-chain" (ref-DPDC-R::URCi_ToggleModifyRoyaltiesRole nft false)))))
            (expect "<<TX-DPP-001>> DPSF|C_ToggleTransferRole == deter(usage) + components"
                (ref-IGNIS::UC_IgnisPrice "DPSF|C_ToggleTransferRole" "usage")
                (at "ignis" (at 0 (at "cumulator-chain" (ref-DPDC-R::URCi_ToggleTransferRole sft true)))))
            (expect "<<TX-DPP-001>> DPNF|C_ToggleTransferRole == deter(usage) + components"
