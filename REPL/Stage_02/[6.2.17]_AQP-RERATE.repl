(begin-tx "TX-RERATE-03 - what the two batches weigh, and what the old rule would have paid")
(namespace "ouronet-ns")
;;==== TX-RERATE-03 · 01 · per-nonce multipliers, read off the chain ====
(print "--- [TX-RERATE-03 · 01 · per-nonce multipliers, read off the chain] ---")
(let
    (
        (ref-SCR:module{AcquisitionScoresV2} AQP-SCORE)
        (ref-DALOS:module{OuronetDalosV2} DALOS)
        (ref-U|DALOS:module{UtilityDalosV2} U|DALOS)
    )
    (let*
        (
            (ouro-id:string (ref-DALOS::UR_OuroborosID))
            (zouro:string (DPTF.UR_Sleeping ouro-id))
            (used:integer (DPOF.UR_NoncesUsed zouro))
            (n-long:integer (- used 1))
            (n-short:integer used)
            (score:string (ref-U|DALOS::UDC_Makeid "LpProbeScore"))
        )
        (map print
            [
                ;;the fixture, asserted: a real class-0 score at the CANONICAL default ceiling. 1.999 rather
                ;;than a round 2.0 because `UC_MxSleepIntervalOk` requires the interval to divide by
                ;;three exactly, and 1.0 leaves one unit of 0.0001 over.
                (expect "<<TX-RERATE-03>> LpProbeScore is class 0 with the 1.999 default ceiling at precision 6"
                    [0 1.999 6]
                    [(ref-SCR::UR_SCR|ScoreClass score)
                     (ref-SCR::UR_SCR|ScoreMxSleeping score)
                     (ref-SCR::UR_SCR|ScorePrecision score)])
                ;;THE 25-YEAR BATCH EARNS THE CEILING, EXACTLY. Not 1.99899 — exactly 1.999, which is
                ;;what `UC_MxAtMonths` multiplying before dividing buys.
                (expect "<<TX-RERATE-03>> the 25-YEAR batch earns the ceiling EXACTLY: 1.999"
                    1.999 (ref-SCR::URC_SCR|SleepingLegWeight score zouro [n-long] [1.0] 300 false))
                ;;THE ONE-MONTH BATCH EARNS ALMOST NOTHING. This single assertion is the whole
                ;;anti-gambling fix: the same 100 tokens, locked for a month instead of 25 years,
                ;;now weigh a third of one percent more rather than twice as much.
                (expect "<<TX-RERATE-03>> the ONE-MONTH batch earns under 1.01x — NOT the 2.0 ceiling"
                    true (< (ref-SCR::URC_SCR|SleepingLegWeight score zouro [n-short] [1.0] 300 false) 1.01))
                (expect "<<TX-RERATE-03>> ...and strictly more than the plain rate, so the month still counts"
                    true (> (ref-SCR::URC_SCR|SleepingLegWeight score zouro [n-short] [1.0] 300 false) 1.0))
                ;;A NONEXISTENT NONCE ABORTS, and the empty-metadata branch does NOT catch it --
                ;;that branch is for a nonce that exists carrying no metadata. Pinned here because
                ;;the docstring originally claimed "matured or unknown ... never a refusal", and
                ;;this assertion is what proved half of that sentence wrong. Not a hazard: every
                ;;caller takes its nonces from the pool tracker, which cannot hold a nonce nobody
                ;;staked -- but the boundary is now stated by a test rather than by a comment.
                (expect-failure "<<TX-RERATE-03>> a nonce that does not exist ABORTS in DPOF's reader — the empty-meta branch does not cover it"
                    "No value found in table"
                    (ref-SCR::URC_SCR|SleepingLegWeight score zouro [(+ used 50)] [1.0] 300 false))
                ;;HIBERNATION DOES NOT DECAY, and these two assertions are the whole of the owner's
                ;;2026-10-10 ruling: the SAME two batches that differ 2.0 vs ~1.003 on the sleeping
                ;;scale are IDENTICAL on the hibernating one, because a hibernating position asks no
                ;;commitment -- it can be unstaked at any moment, and leaving hibernation itself
                ;;already costs a decaying burn fee, so the term is priced elsewhere.
                ;;
                ;;The value is `mx-hibernated` exactly, which for a class-0 score is 1.0 (issuance
                ;;hard-codes it) -- so this pins the default too: weight it like the native token.
                (expect "<<TX-RERATE-03>> on the HIBERNATE scale the 25-year batch is flat mx-hibernated, not the sleeping ceiling"
                    1.0 (ref-SCR::URC_SCR|SleepingLegWeight score zouro [n-long] [1.0] 1200 false))
                (expect "<<TX-RERATE-03>> ...and the ONE-MONTH batch is the SAME figure — term does not enter it"
                    (ref-SCR::URC_SCR|SleepingLegWeight score zouro [n-long] [1.0] 1200 false)
                    (ref-SCR::URC_SCR|SleepingLegWeight score zouro [n-short] [1.0] 1200 false))
            ]
        )
        ""
    )
)
;;==== TX-RERATE-03 · 02 · the LEG delta: Σ(amount × own mx), and the 400.0 it is not ====
(print "--- [TX-RERATE-03 · 02 · the LEG delta: Σ(amount × own mx), and the 400.0 it is not] ---")
(let
    (
        (ref-SCR:module{AcquisitionScoresV2} AQP-SCORE)
        (ref-DALOS:module{OuronetDalosV2} DALOS)
        (ref-U|DALOS:module{UtilityDalosV2} U|DALOS)
    )
    (let*
        (
            (ouro-id:string (ref-DALOS::UR_OuroborosID))
            (zouro:string (DPTF.UR_Sleeping ouro-id))
            (used:integer (DPOF.UR_NoncesUsed zouro))
            (n-long:integer (- used 1))
            (n-short:integer used)
            (score:string (ref-U|DALOS::UDC_Makeid "LpProbeScore"))
            (delta:decimal
                (ref-SCR::URC_SignedBaseDeltaForOrtoLpStake
                    score zouro [n-long n-short] [100.0 100.0] true))
        )
        (map print
            [
                ;;UNDER THE OLD FLAT RULE this leg was (100 + 100) × 2.0 = 400.0. The amounts were
                ;;summed BEFORE the multiplier, which is structurally incapable of giving two
                ;;batches different rates — it discarded the maturity before the rate was computed.
                (expect "<<TX-RERATE-03>> the leg is NOT the 400.0 the old flat rule paid"
                    true (!= delta 400.0))
                ;;IT IS 200 (the matured-term batch) + a hair over 100 (the one-month batch).
                (expect "<<TX-RERATE-03>> it is just over 300.0: 200 for the 25-year batch, ~100.33 for the month"
                    [true true] [(> delta 300.0) (< delta 301.0)])
                ;;THE BATCHES DO NOT INTERACT: the two-nonce leg is exactly the sum of the two
                ;;nonces priced one at a time. Worth asserting even though one function computes
                ;;both, because the thing that could break it is the FLOORING convention -- floor
                ;;per nonce and the split equals the whole, floor the total and it does not. That
                ;;is the property the awarded-weight ledger depends on, since it stores one row
                ;;per nonce and the base must move by the same Σ of floor()s.
                (expect "<<TX-RERATE-03>> it equals Σ over batches of amount × that batch's OWN multiplier"
                    (+ (ref-SCR::URC_SCR|SleepingLegWeight score zouro [n-long]  [100.0] 300 false)
                       (ref-SCR::URC_SCR|SleepingLegWeight score zouro [n-short] [100.0] 300 false))
                    delta)
                ;;THE UNSTAKE DIRECTION REVERSES THE LEDGER, NOT A RECOMPUTATION -- asserted as an
                ;;equality against `URC_SCR|SleepingLegHeldWeight`, which is the single reader the
                ;;sweep uses too.
                ;;
                ;;THIS ASSERTION USED TO READ `nets to exactly 0.0` AND THAT WAS THE WRONG CLAIM,
                ;;kept here because the correction is the interesting part. When both directions
                ;;recomputed from the live clock, stake + unstake self-cancelled and the test
                ;;passed -- while proving a property the system does not rely on. The reversal now
                ;;reads the STAMP, so on a nonce that was never staked (which these are -- the
                ;;block is a pure arithmetic probe) there is no stamp, the reversal falls to the
                ;;plain 1.0 rate, and the two directions correctly DISAGREE.
                ;;
                ;;The netting property itself is real and is proven where it actually lives: on a
                ;;staked position, end to end, in <<TX-RERATE-SAT>> and [6.4] <<TX-AQP-CL06>> --
                ;;both of which assert the holder's base returns to its exact pre-stake value.
                ;;Asserting it here against a recomputation would be asserting the old design.
                (expect "<<TX-RERATE-03>> the unstake direction is EXACTLY minus the ledger weight"
                    (- 0.0 (ref-SCR::URC_SCR|SleepingLegHeldWeight
                                score zouro [n-long n-short] [100.0 100.0] 300))
                    (ref-SCR::URC_SignedBaseDeltaForOrtoLpStake
                        score zouro [n-long n-short] [100.0 100.0] false))
            ]
        )
        ""
    )
)
(print "===^^^===")
(commit-tx)

