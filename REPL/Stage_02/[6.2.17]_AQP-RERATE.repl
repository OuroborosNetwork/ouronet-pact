(begin-tx "TX-RERATE-02 - two real sleeping batches, and what each one is actually worth")
(env-gasmodel "table")(env-gaslimit 150000000)(env-gas 0)
(namespace "ouronet-ns")
;;==== TX-RERATE-02 · 01 · env-sigs (caps) ====
(print "--- [TX-RERATE-02 · 01 · env-sigs (caps)] ---")
(env-sigs
    [ { "key": "PK_AncientHodler", "caps": [] }
      { "key": "6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263"
      , "caps":
        [ (coin.TRANSFER "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263"
                         "k:0cb30c0121ff919266121a99ff9359871818932211df94dae4137c29bc0e8f7e" 1000000.0)
          (coin.TRANSFER "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263"
                         "k:50d6c59b21e5e6e55baecaa75a1007de37576bde12d8230dc82459cc01b9484b" 1000000.0)
          (coin.TRANSFER "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263"
                         "c:XM-pkmuB5XUQlp87ZYSbfKt8qzmHY6O2EHAzMRVBt3k" 1000000.0)
          (coin.TRANSFER "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263"
                         "c:iQQFWj6gWtpGEzhM_O5ekW1QtnQQy55R8BRPGhj_0FU" 1000000.0) ] } ])
;;==== TX-RERATE-02 · 02 · sleep 100 OURO for 25 YEARS and 100 for ONE MONTH ====
(print "--- [TX-RERATE-02 · 02 · sleep 100 OURO for 25 YEARS and 100 for ONE MONTH] ---")
;;THE DECISIVE FIXTURE. Two batches of the SAME token and the SAME amount, differing only in how
;;long they are locked. Under the rule this replaces both earned `mx-sleeping` in full, so the
;;one-month batch was worth exactly as much as the twenty-five-year one — which is the gamble.
;;Real nonces with real metadata, not synthesised, because what is under test is that the
;;weighting reads `release-date` off the chain.
(let
    (
        (ref-DALOS:module{OuronetDalosV2} DALOS)
        (ref-TS01-C2:module{TalosStageOne_ClientTwoV2} TS01-C2)
        (ref-DPOF:module{DemiourgosPactOrtoFungibleV2} DPOF)
        (patron:string KST.ANHD)
        (ouro-id:string (ref-DALOS::UR_OuroborosID))
    )
    (ref-TS01-C2::VST|C_CreateSleepingLink patron (DPTF.UR_Konto ouro-id) ouro-id)
    (let
        (
            (zouro:string (DPTF.UR_Sleeping ouro-id))
            (before:integer (DPOF.UR_NoncesUsed (DPTF.UR_Sleeping ouro-id)))
        )
        ;;nonce `before+1` — the full 25-year term, the most the chain will accept
        (ref-TS01-C2::VST|C_Sleep patron patron patron ouro-id 100.0 788400000)
        ;;nonce `before+2` — one month, the shortest commitment worth testing
        (ref-TS01-C2::VST|C_Sleep patron patron patron ouro-id 100.0 2628000)
        (map print
            [
                (expect (format "<<TX-RERATE-02>> two sleeping nonces minted on {}" [zouro])
                    (+ before 2) (DPOF.UR_NoncesUsed zouro))
            ]
        )
        ""
    )
)
(print "===^^^===")
(commit-tx)

