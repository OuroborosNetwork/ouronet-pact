(begin-tx "TX-RERATE-09 - ADD a score to a pool that already has weight: the freeze")
(env-gasmodel "table")(env-gaslimit 900000000)(env-gas 0)
(namespace "ouronet-ns")
;;==== TX-RERATE-09 · 01 · env-sigs (caps) ====
(print "--- [TX-RERATE-09 · 01 · env-sigs (caps)] ---")
(env-sigs
    [ { "key": "PK_AncientHodler", "caps": [] }
      { "key": "6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263"
      , "caps":
        [ (coin.TRANSFER "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263"
                         "k:0cb30c0121ff919266121a99ff9359871818932211df94dae4137c29bc0e8f7e" 1000000.0)
          (coin.TRANSFER "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263"
                         "k:50d6c59b21e5e6e55baecaa75a1007de37576bde12d8230dc82459cc01b9484b" 1000000.0)
          (coin.TRANSFER "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263"
                         "c:XM-pkmuB5XUQlp87ZYSbfKt8qzmHY6O2EHAzMRVBt3k" 1000000.0)
          (coin.TRANSFER "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263"
                         "c:iQQFWj6gWtpGEzhM_O5ekW1QtnQQy55R8BRPGhj_0FU" 1000000.0) ] } ])
;;==== TX-RERATE-09 · 02 · the gap the owner asked about, measured ====
(print "--- [TX-RERATE-09 · 02 · the gap the owner asked about, measured] ---")
;;THE EXACT SCENARIO THE OWNER POSED: "bunnies have a single score ... I decide later to add a new
;;score in the bunny pool ... People already staked their bunnies. How is this new score suppose
;;to get updated?" Here: one holder with 1000 staked, and a second score arrives.
;;
;;The holder's base for the new score is 0 while their canonical target is 1000 -- so from this
;;instant the pool is mis-scored, and the pool freezes until a sweep fixes it.
(let
    (
        (ref-SCR:module{AcquisitionScoresV2} AQP-SCORE)
        (ref-SWP:module{SwapperV4} SWP)
        (ref-TS02-C3:module{TalosStageTwo_ClientThreeV2} TS02-C3)
        (ref-U|DALOS:module{UtilityDalosV2} U|DALOS)
    )
    (let*
        (
            (pool:string (ref-U|DALOS::UDC_Makeid "RerateVaultPool"))
            (ouro:string (DALOS.UR_OuroborosID))
        )
        ;;a SECOND class-1 score for the same staked token -- the "I decide later to add a new
        ;;score" case, with a holder already in the pool
        (ref-TS02-C3::AQP-SCR|C_IssueTrueFungibleScore KST.ANHD KST.ANHD "RerateScoreB" 6 2.0)
        (let
            (
                (scoreb:string (ref-U|DALOS::UDC_Makeid "RerateScoreB"))
            )
            (ref-TS02-C3::AQP-POOL|C_AddScore
                KST.ANHD (AQP-POOL.URC_AqpOwnerKontoFromClassAndAsset 1 ouro) pool scoreb)
            (map print
                [
                    (expect "<<TX-RERATE-09>> the pool is now FROZEN by the add"
                        true (AQP-POOL.UR_AQP|PoolSweepInProgress pool))
                    ;;THE WORK LIST, with the arithmetic spelled out: one holder, target 1000,
                    ;;stored 0, so a delta of exactly 1000 is owed.
                    (expect "<<TX-RERATE-09>> exactly one holder is outstanding, owed 1000.0"
                        [1 KST.ANHD 1000.0 0.0 1000.0]
                        (let ((row:object (at 0 (AQP-POOL.URHC_AQP|ScoreBackfillOutstanding pool scoreb))))
                            [(length (AQP-POOL.URHC_AQP|ScoreBackfillOutstanding pool scoreb))
                             (at "beneficiary-id" row) (at "target" row)
                             (at "current" row) (at "delta" row)]))
                    (expect "<<TX-RERATE-09>> ...and a sweep is reported as needed"
                        true (AQP-POOL.URHC_AQP|ScoreBackfillNeeded pool scoreb))
                    ;;BOTH DIRECTIONS ARE SHUT. Stake was already gated on the sweep flag (D3);
                    ;;unstake was NOT until this round, and it is the direction that actually
                    ;;corrupts -- it reverses a stored figure the chain already knows is wrong,
                    ;;and once the position is gone no sweep can recompute what it should have been.
                    (expect "<<TX-RERATE-09>> stake AND unstake are both refused while the pool is frozen"
                        [false false]
                        [(AQP-POOL.URC_PoolStakeAdmissionOk pool)
                         (AQP-POOL.URC_PoolUnstakeAdmissionOk pool)])
                    ;;the freeze cannot be waved away while the work exists
                    (expect-failure "<<TX-RERATE-09>> the freeze CANNOT be cleared while work is outstanding"
                        "Pool is not releasable"
                        (ref-TS02-C3::AQP-FVT|CC_ClearPoolSweep KST.ANHD pool))
                ]
            )
            ""
        )
    )
)
(env-sigs [])
(print "===^^^===")
(commit-tx)

;;||>>>>>>>>>>>>>>>>>>>>>>>>>
;;|| NEXT                   >
;;||>>>>>>>>>>>>>>>>>>>>>>>>>
(print "")
