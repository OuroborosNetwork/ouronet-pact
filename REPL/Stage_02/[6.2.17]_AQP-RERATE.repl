(begin-tx "TX-RERATE-10 - sweep it: convergence, the global invariant, and the release")
(env-gasmodel "table")(env-gaslimit 900000000)(env-gas 0)
(namespace "ouronet-ns")
;;==== TX-RERATE-10 · 01 · env-sigs (caps) ====
(print "--- [TX-RERATE-10 · 01 · env-sigs (caps)] ---")
(env-sigs
    [ { "key": "PK_AncientHodler", "caps": [] }
      { "key": "6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263"
      , "caps":
        [ (coin.TRANSFER "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263"
                         "k:0cb30c0121ff919266121a99ff9359871818932211df94dae4137c29bc0e8f7e" 1000000.0)
          (coin.TRANSFER "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263"
                         "k:50d6c59b21e5e6e55baecaa75a1007de37576bde12d8230dc82459cc01b9484b" 1000000.0)
          (coin.TRANSFER "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263"
                         "c:XM-pkmuB5XUQlp87ZYSbfKt8qzmHY6O2EHAzMRVBt3k" 1000000.0)
          (coin.TRANSFER "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263"
                         "c:iQQFWj6gWtpGEzhM_O5ekW1QtnQQy55R8BRPGhj_0FU" 1000000.0) ] } ])
;;==== TX-RERATE-10 · 02 · one slice moves a NON-ZERO delta and the pool reopens ====
(print "--- [TX-RERATE-10 · 02 · one slice moves a NON-ZERO delta and the pool reopens] ---")
(let
    (
        (ref-SCR:module{AcquisitionScoresV2} AQP-SCORE)
        (ref-TS02-C3:module{TalosStageTwo_ClientThreeV2} TS02-C3)
        (ref-U|DALOS:module{UtilityDalosV2} U|DALOS)
    )
    (let*
        (
            (pool:string (ref-U|DALOS::UDC_Makeid "RerateVaultPool"))
            (scoreb:string (ref-U|DALOS::UDC_Makeid "RerateScoreB"))
        )
        (ref-TS02-C3::AQP-POOL|CCp_BackfillScoreSlice KST.ANHD pool scoreb [KST.ANHD])
        (map print
            [
                ;;THE DELTA ACTUALLY LANDED. Every earlier write-path assertion in this file moved
                ;;a zero; this is the first that moves 1000.
                (expect "<<TX-RERATE-10>> the holder's base is now 1000.0 — the target, reached"
                    1000.0 (ref-SCR::UR_U-SCR|UserScoreBaseScore KST.ANHD pool scoreb))
                ;;THE MAINTAINED FIGURES MOVED WITH IT. A second writer that set the base directly
                ;;would have had to reproduce both of these and would be free to disagree.
                (expect "<<TX-RERATE-10>> the score's total base and nzs-count were maintained by the same write"
                    [1000.0 1] [(ref-SCR::UR_SCR|ScoreTotalBaseScore scoreb)
                                (ref-SCR::UR_SCR|ScoreNzsCount scoreb)])
                (expect "<<TX-RERATE-10>> nothing is outstanding any more"
                    [[] false]
                    [(AQP-POOL.URHC_AQP|ScoreBackfillOutstanding pool scoreb)
                     (AQP-POOL.URHC_AQP|ScoreBackfillNeeded pool scoreb)])
                (expect "<<TX-RERATE-10>> ...so the pool reports itself CLEAR"
                    true (AQP-POOL.URHC_AQP|PoolSweepClear pool))
            ]
        )
        ;;IDEMPOTENCE ON A SLICE THAT ALREADY DID ITS WORK -- the second run recomputes the same
        ;;target, finds the base already there, and writes a delta of exactly 0.
        (ref-TS02-C3::AQP-POOL|CCp_BackfillScoreSlice KST.ANHD pool scoreb [KST.ANHD KST.ANHD])
        (ref-TS02-C3::AQP-FVT|CC_ClearPoolSweep KST.ANHD pool)
        (map print
            [
                (expect "<<TX-RERATE-10>> replaying the slice (twice, in one call) changes nothing"
                    [1000.0 1000.0 1]
                    [(ref-SCR::UR_U-SCR|UserScoreBaseScore KST.ANHD pool scoreb)
                     (ref-SCR::UR_SCR|ScoreTotalBaseScore scoreb)
                     (ref-SCR::UR_SCR|ScoreNzsCount scoreb)])
                (expect "<<TX-RERATE-10>> the freeze is released and BOTH directions reopen"
                    [false true true]
                    [(AQP-POOL.UR_AQP|PoolSweepInProgress pool)
                     (AQP-POOL.URC_PoolStakeAdmissionOk pool)
                     (AQP-POOL.URC_PoolUnstakeAdmissionOk pool)])
                ;;THE GLOBAL INVARIANT, on both scores at once: the score's total base is exactly
                ;;the sum over its holders. This is the identity every reward share divides by.
                (expect "<<TX-RERATE-10>> Σ(user base) == total-base, on both employed scores"
                    [true true]
                    (map (lambda (sid:string)
                            (= (ref-SCR::UR_SCR|ScoreTotalBaseScore sid)
                               (fold (+) 0.0
                                   (map (lambda (a:string)
                                           (ref-SCR::UR_U-SCR|UserScoreBaseScore a pool sid))
                                        (ref-SCR::URH_SCR|ScoreHolderAccounts pool sid)))))
                         (AQP-POOL.URC_PoolActiveScoreIds pool)))
            ]
        )
        ""
    )
)
(env-sigs [])
(print "===^^^===")
(commit-tx)

