;;||>>>>>>>>>>>>>>>>>>>>>>>>>
(print "")
;;================================================================================
(begin-tx "TX-RERATE-04 - ONE FLOOR PER LEG, and the residue that convention leaves")
(namespace "ouronet-ns")
;;==== TX-RERATE-04 · 01 · the leg is floored ONCE over its whole sum ====
(print "--- [TX-RERATE-04 · 01 · the leg is floored ONCE over its whole sum] ---")
;;THE TARGET FLOORS ONCE PER LEG, not once per tracker row, and the difference is measurable.
;;A beneficiary may hold the same sleeping nonce through four different owners -- four tracker
;;rows, one score row -- so the engine hands all four to ONE call. Four separate calls would
;;floor four times and land one unit in the last place lower.
(let
    (
        (ref-SCR:module{AcquisitionScoresV2} AQP-SCORE)
        (ref-DALOS:module{OuronetDalosV2} DALOS)
        (ref-U|DALOS:module{UtilityDalosV2} U|DALOS)
    )
    (let*
        (
            (ouro-id:string (ref-DALOS::UR_OuroborosID))
            (zouro:string (DPTF.UR_Sleeping ouro-id))
            (n:integer (DPOF.UR_NoncesUsed zouro))
            ;;the 25-year batch is the one minted just BEFORE the one-month batch (TX-RERATE-02)
            (n-long:integer (- n 1))
            (score:string (ref-U|DALOS::UDC_Makeid "LpProbeScore"))
            ;;ONE call carrying four rows -- what the engine does
            (one-call:decimal
                (ref-SCR::URC_SignedBaseDeltaForOrtoLpStake
                    score zouro [n n n n] [100.0 100.0 100.0 100.0] true))
            ;;FOUR calls of one row each -- what a per-row loop would do
            (four-calls:decimal
                (fold (+) 0.0
                    (map (lambda (q:decimal)
                            (ref-SCR::URC_SignedBaseDeltaForOrtoLpStake score zouro [n] [q] true))
                         [100.0 100.0 100.0 100.0])))
        )
        (map print
            [
                ;;ONE FLOOR PER NONCE, so a slice of four rows and four calls of one row agree
                ;;EXACTLY. That equality is not cosmetic -- it is what lets `SCR|T|SleepStake`
                ;;record each slot separately and still sum to the base the stake path wrote.
                ;;Flooring the TOTAL instead would make the base move by floor(Sum) while the
                ;;ledger stored Sum of floor(), and a base that disagrees with its own ledger is
                ;;the one thing the ledger exists to prevent.
                (expect "<<TX-RERATE-04>> four rows in one call: 401.332 — four per-nonce floors"
                    401.332 one-call)
                (expect "<<TX-RERATE-04>> four separate calls agree EXACTLY — same convention either way"
                    401.332 four-calls)
                (expect "<<TX-RERATE-04>> so slicing a sleeping leg is free of rounding drift"
                    0.0 (- one-call four-calls))
                ;;THE PHANTOM-WEIGHT GAP, MEASURED. These two read the SAME formula from DIFFERENT
                ;;sources: the stake credit uses the multiplier the lock earns RIGHT NOW, while the
                ;;held weight uses the one it earned WHEN IT WAS STAKED, recorded in
                ;;`SCR|T|SleepStake`. These nonces were never staked, so the ledger has no row and
                ;;defaults to 0.0 remaining -- the plain 1.0 rate -- which is exactly the gap:
                ;;200.0 credited against 100.0 given back, if the two were allowed to disagree.
                ;;That 100.0 is weight for a position nobody holds, and it is tradeable.
                (expect "<<TX-RERATE-04>> a 25-year nonce CREDITS 199.9 at the live multiplier"
                    199.9
                    (ref-SCR::URC_SignedBaseDeltaForOrtoLpStake score zouro [n-long] [100.0] true))
                (expect "<<TX-RERATE-04>> ...while the LEDGER holds 100.0 for it — never staked, so no row"
                    100.0
                    (ref-SCR::URC_SCR|SleepingLegHeldWeight score zouro [n-long] [100.0] 300))
                ;;AND THE DEFAULT ERRS THE SAFE WAY. An unrecorded nonce reads 0.0 remaining, which
                ;;yields 1.0 -- so the worst a missing row can do is UNDER-credit. It can never
                ;;leave phantom weight behind, which is the only failure that cannot be undone.
                (expect "<<TX-RERATE-04>> an unrecorded lock reads 0.0 seconds remaining — under-credit, never over"
                    0.0 (ref-SCR::UR_SCR|SleepRemainingAtStake zouro n-long))
                ;;SPLIT SHAPES AGREE ON THE REVERSAL SIDE TOO, which per-nonce flooring buys for
                ;;free: one four-nonce reversal equals four one-nonce reversals, so the SHAPE a
                ;;caller unstakes in cannot change the figure. That is the drift-freedom this
                ;;block is about, and it is asserted on the reversal rather than on a round trip.
                ;;
                ;;THE ROUND-TRIP ASSERTIONS THAT USED TO SIT HERE WERE REMOVED, not relaxed, and
                ;;the reason matters: they added the stake direction to the unstake direction and
                ;;expected 0.0. That held only while both recomputed from the live clock. The
                ;;reversal now reads the STAMP in `SCR|T|SleepStake`, and these nonces were never
                ;;staked (this block is a pure arithmetic probe -- see the assertion above, which
                ;;pins the absent row at 0.0 seconds), so there is nothing to cancel against. The
                ;;old assertions would have been testing the OLD design while the system ran on
                ;;the new one.
                ;;
                ;;The netting property is real and proven where it lives -- on a staked position,
                ;;end to end: <<TX-RERATE-SAT>> and [6.4] <<TX-AQP-CL06>> both assert the holder's
                ;;base returns to its EXACT pre-stake value after a full release.
                (expect "<<TX-RERATE-04>> one four-nonce reversal equals four one-nonce reversals — shape-free"
                    (ref-SCR::URC_SignedBaseDeltaForOrtoLpStake
                        score zouro [n n n n] [100.0 100.0 100.0 100.0] false)
                    (fold (+) 0.0
                        (map (lambda (q:decimal)
                                (ref-SCR::URC_SignedBaseDeltaForOrtoLpStake score zouro [n] [q] false))
                             [100.0 100.0 100.0 100.0])))
            ]
        )
        ""
    )
)
;;==== TX-RERATE-04 · 02 · the frozen leg, and the native leg that is never multiplied ====
(print "--- [TX-RERATE-04 · 02 · the frozen leg, and the native leg that is never multiplied] ---")
(let
    (
        (ref-SCR:module{AcquisitionScoresV2} AQP-SCORE)
        (ref-U|DALOS:module{UtilityDalosV2} U|DALOS)
    )
    (let*
        (
            (score:string (ref-U|DALOS::UDC_Makeid "LpProbeScore"))
            ;;`lp-id` is carried for signature stability and never read by the weighting -- the
            ;;pool's own asset is the honest value to pass, and it needs no table scan.
            (lp:string (AQP-POOL.UR_AQP|PoolAssetId (ref-U|DALOS::UDC_Makeid "LpProbePool")))
        )
        (map print
            [
                ;;NATIVE IS NEVER MULTIPLIED. That is why native holders neither block a
                ;;multiplier change nor are moved by one, and it is asserted rather than assumed
                ;;because every live holder today is native.
                (expect "<<TX-RERATE-04>> a NATIVE leg weighs its amount, times nothing"
                    100.0 (ref-SCR::URC_SignedBaseDeltaForDptfLpStake score lp 100.0 true true))
                (expect "<<TX-RERATE-04>> a FROZEN leg weighs amount × mx-frozen (2.998 here) — flat, because a freeze is permanent"
                    299.8 (ref-SCR::URC_SignedBaseDeltaForDptfLpStake score lp 100.0 false true))
                (expect "<<TX-RERATE-04>> both legs reverse to exactly 0.0"
                    [0.0 0.0]
                    [(+ (ref-SCR::URC_SignedBaseDeltaForDptfLpStake score lp 100.0 true true)
                        (ref-SCR::URC_SignedBaseDeltaForDptfLpStake score lp 100.0 true false))
                     (+ (ref-SCR::URC_SignedBaseDeltaForDptfLpStake score lp 100.0 false true)
                        (ref-SCR::URC_SignedBaseDeltaForDptfLpStake score lp 100.0 false false))])
                ;;class 1 shares the arithmetic exactly -- the engine refuses class 1 for now, but
                ;;if that scope ever widens this is the assertion that says it may
                (expect "<<TX-RERATE-04>> the class-1 DPTF leg is the SAME arithmetic as the class-0 LP leg"
                    [(ref-SCR::URC_SignedBaseDeltaForDptfLpStake score lp 100.0 true true)
                     (ref-SCR::URC_SignedBaseDeltaForDptfLpStake score lp 100.0 false true)]
                    [(ref-SCR::URC_SignedBaseDeltaForDptfStake score lp 100.0 true true)
                     (ref-SCR::URC_SignedBaseDeltaForDptfStake score lp 100.0 false true)])
            ]
        )
        ""
    )
)
(print "===^^^===")
(commit-tx)

;;||>>>>>>>>>>>>>>>>>>>>>>>>>
;;|| NEXT                   >
;;||>>>>>>>>>>>>>>>>>>>>>>>>>
(print "")
;;================================================================================
(begin-tx "TX-RERATE-05 - the target: who it sums, and the legs it refuses to invent")
(namespace "ouronet-ns")
;;==== TX-RERATE-05 · 01 · the pure aggregation helpers ====
(print "--- [TX-RERATE-05 · 01 · the pure aggregation helpers] ---")
;;ONE BENEFICIARY, MANY OWNERS. The tracker is keyed by (pool, asset, owner, beneficiary), so an
;;account staked for by three different people holds three rows and exactly ONE score row. These
;;helpers are what collapse the first into the second, and getting the collapse wrong would
;;produce a target that is a multiple of the truth.
(let
    (
        (rows:[object]
            [ {"owner-id": "A", "beneficiary-id": "BEN1", "balance": 30.0}
              {"owner-id": "B", "beneficiary-id": "BEN2", "balance": 11.0}
              {"owner-id": "C", "beneficiary-id": "BEN1", "balance": 70.0}
              {"owner-id": "A", "beneficiary-id": "BEN3", "balance": 5.0} ])
    )
    (map print
        [
            (expect "<<TX-RERATE-05>> beneficiaries dedupe to three, in FIRST-SEEN order"
                ["BEN1" "BEN2" "BEN3"] (AQP-POOL.UC_AQP|BackfillUniqueBeneficiaries rows))
            (expect "<<TX-RERATE-05>> BEN1's two rows sum to 100.0 — across two different owners"
                100.0 (AQP-POOL.UC_AQP|BackfillSumForBeneficiary "BEN1" rows))
            (expect "<<TX-RERATE-05>> ...and the other beneficiaries are not folded into it"
                [11.0 5.0]
                [(AQP-POOL.UC_AQP|BackfillSumForBeneficiary "BEN2" rows)
                 (AQP-POOL.UC_AQP|BackfillSumForBeneficiary "BEN3" rows)])
            (expect "<<TX-RERATE-05>> an account with no rows sums to 0.0, not an error"
                0.0 (AQP-POOL.UC_AQP|BackfillSumForBeneficiary "NOBODY" rows))
            (expect "<<TX-RERATE-05>> the row filter keeps only that beneficiary's rows"
                2 (length (AQP-POOL.UC_AQP|BackfillRowsForBeneficiary "BEN1" rows)))
            (expect "<<TX-RERATE-05>> an empty tracker yields no beneficiaries"
                [] (AQP-POOL.UC_AQP|BackfillUniqueBeneficiaries []))
        ]
    )
    ""
)
;;==== TX-RERATE-05 · 02 · the target sums the legs the ASSET actually has ====
(print "--- [TX-RERATE-05 · 02 · the target sums the legs the ASSET actually has] ---")
;;LpProbePool's asset has NEITHER twin, and that is the branch under test. Rows for legs the
;;asset does not define are handed in DELIBERATELY: a target that counted them would be inventing
;;weight from a frozen token that cannot exist, and the engine would then "repair" every holder
;;to a figure no stake could ever have produced.
(let
    (
        (ref-U|DALOS:module{UtilityDalosV2} U|DALOS)
    )
    (let*
        (
            (pool:string (ref-U|DALOS::UDC_Makeid "LpProbePool"))
            (score:string (ref-U|DALOS::UDC_Makeid "LpProbeScore"))
            (legs:object (AQP-POOL.URC_AQP|PoolLiquidityLegs pool))
            (nat:[object]
                [ {"owner-id": "A", "beneficiary-id": "BEN1", "balance": 30.0}
                  {"owner-id": "C", "beneficiary-id": "BEN1", "balance": 70.0}
                  {"owner-id": "A", "beneficiary-id": "BEN2", "balance": 999.0} ])
            (frz:[object] [ {"owner-id": "A", "beneficiary-id": "BEN1", "balance": 1000.0} ])
            (slp:[object] [ {"owner-id": "A", "beneficiary-id": "BEN1", "nonce": 1, "balance": 1000.0} ])
        )
        (map print
            [
                (expect "<<TX-RERATE-05>> the pool's asset declares NO frozen and NO sleeping twin"
                    [true true]
                    [(= (at "frozen" legs) (U|CT.CT_BAR)) (= (at "sleeping" legs) (U|CT.CT_BAR))])
                (expect "<<TX-RERATE-05>> ...while the native leg IS the pool asset"
                    (AQP-POOL.UR_AQP|PoolAssetId pool) (at "native" legs))
                ;;the native term, aggregated across two owners
                (expect "<<TX-RERATE-05>> BEN1's target is 100.0 — the native sum of both owners' rows"
                    100.0
                    (AQP-POOL.URH_AQP|ScoreTargetBaseForBeneficiary pool score "BEN1" nat [] []))
                ;;THE REFUSAL TO INVENT. 1000 frozen and 1000 sleeping are handed in and both are
                ;;ignored, because the asset has no such twin. The target stays 100.0.
                (expect "<<TX-RERATE-05>> frozen and sleeping rows for legs the asset lacks are IGNORED, not counted"
                    100.0
                    (AQP-POOL.URH_AQP|ScoreTargetBaseForBeneficiary pool score "BEN1" nat frz slp))
                ;;and a different beneficiary's 999 is not swept into BEN1
                (expect "<<TX-RERATE-05>> BEN2's 999.0 stays BEN2's"
                    999.0
                    (AQP-POOL.URH_AQP|ScoreTargetBaseForBeneficiary pool score "BEN2" nat [] []))
                (expect "<<TX-RERATE-05>> an account with no position targets 0.0 — which is what drives an ORPHANED row back to zero"
                    0.0
                    (AQP-POOL.URH_AQP|ScoreTargetBaseForBeneficiary pool score "NOBODY" nat frz slp))
            ]
        )
        ""
    )
)
;;==== TX-RERATE-05 · 03 · what the engine refuses, and why refusing is the safe answer ====
(print "--- [TX-RERATE-05 · 03 · what the engine refuses, and why refusing is the safe answer] ---")
;;LpProbeScore is class 0 but is NOT assigned to any pool, so `Σ(amount × mx)` is not a statement
;;about it at all. The engine reports NO work rather than a wrong amount of work: a delta measured
;;against the wrong formula does not fail, it writes a plausible wrong number into a maintained
;;accumulator where nothing can later tell it from a real one.
(let
    (
        (ref-SCR:module{AcquisitionScoresV2} AQP-SCORE)
        (ref-TS02-C3:module{TalosStageTwo_ClientThreeV2} TS02-C3)
        (ref-U|DALOS:module{UtilityDalosV2} U|DALOS)
    )
    (let*
        (
            (pool:string (ref-U|DALOS::UDC_Makeid "LpProbePool"))
            (score:string (ref-U|DALOS::UDC_Makeid "LpProbeScore"))
        )
        (map print
            [
                (expect "<<TX-RERATE-05>> the score is class 0 but unassigned, so the pool does not employ it"
                    [0 (U|CT.CT_BAR) []]
                    [(ref-SCR::UR_SCR|ScoreClass score)
                     (ref-SCR::UR_SCR|ScoreAqpoolLink score)
                     (AQP-POOL.URC_PoolActiveScoreIds pool)])
                (expect "<<TX-RERATE-05>> ...so the engine declares it UNSUPPORTED"
                    false (AQP-POOL.URC_AQP|ScoreBackfillSupported pool score))
                ;;EMPTY, NEVER A WRONG COUNT -- this is the "is a sweep needed?" read, and for an
                ;;unsupported score the honest answer is "there is nothing here I can compute".
                (expect "<<TX-RERATE-05>> the outstanding list is EMPTY for an unsupported score"
                    [] (AQP-POOL.URHC_AQP|ScoreBackfillOutstanding pool score))
                (expect "<<TX-RERATE-05>> ...and no sweep is reported as needed"
                    false (AQP-POOL.URHC_AQP|ScoreBackfillNeeded pool score))
                ;;and the WRITE path refuses it too -- the read returning [] is a convenience, the
                ;;capability is the guarantee
                (expect-failure "<<TX-RERATE-05>> a slice against an unsupported score is REFUSED at the capability"
                    "Score is not re-ratable"
                    (ref-TS02-C3::AQP-POOL|CCp_BackfillScoreSlice KST.ANHD pool score ["BEN1"]))
                ;;an empty slice is refused before anything else: it can only be a caller mistake,
                ;;and billing a no-op transaction teaches nothing
                (expect-failure "<<TX-RERATE-05>> an EMPTY slice is refused outright"
                    "Empty slice"
                    (ref-TS02-C3::AQP-POOL|CCp_BackfillScoreSlice KST.ANHD pool score []))
            ]
        )
        ""
    )
)
(print "===^^^===")
(commit-tx)

;;||>>>>>>>>>>>>>>>>>>>>>>>>>
;;|| NEXT                   >
;;||>>>>>>>>>>>>>>>>>>>>>>>>>
(print "")
;;================================================================================
(begin-tx "TX-RERATE-06 - a SUPPORTED score, and the write path actually executing")
(env-gasmodel "table")(env-gaslimit 150000000)(env-gas 0)
(namespace "ouronet-ns")
;;==== TX-RERATE-06 · 01 · env-sigs (caps) ====
(print "--- [TX-RERATE-06 · 01 · env-sigs (caps)] ---")
;;score issuance is STOA-priced -- same four coin.TRANSFER caps as AQPLP-G2
(env-sigs
    [ { "key": "PK_AncientHodler", "caps": [] }
      { "key": "6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263"
      , "caps":
        [ (coin.TRANSFER "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263"
                         "k:0cb30c0121ff919266121a99ff9359871818932211df94dae4137c29bc0e8f7e" 1000000.0)
          (coin.TRANSFER "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263"
                         "k:50d6c59b21e5e6e55baecaa75a1007de37576bde12d8230dc82459cc01b9484b" 1000000.0)
          (coin.TRANSFER "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263"
                         "c:XM-pkmuB5XUQlp87ZYSbfKt8qzmHY6O2EHAzMRVBt3k" 1000000.0)
          (coin.TRANSFER "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263"
                         "c:iQQFWj6gWtpGEzhM_O5ekW1QtnQQy55R8BRPGhj_0FU" 1000000.0) ] } ])
;;==== TX-RERATE-06 · 02 · issue a correctly-denominated class-0 score and EMPLOY it ====
(print "--- [TX-RERATE-06 · 02 · issue a correctly-denominated class-0 score and EMPLOY it] ---")
;;`LpProbeScore` exists to be REFUSED -- its denominator is OURO, which is not in the pool's pair.
;;This one is built to be ACCEPTED: the denominator is a real token of the pair, which is the only
;;thing `UEV_AddScorePoolAndScore`'s third enforce asks about. Without an employed score there is
;;no supported (pool, score) pair anywhere in the tree, and the engine's whole write path --
;;`P|UEV_IMC`, the capability, and `SCR|XE>APPLY-RAW-BASE-DELTA`'s employed-score enforce -- would
;;go untested while every REFUSAL test passed.
(let
    (
        (ref-SWP:module{SwapperV4} SWP)
        (ref-TS02-C3:module{TalosStageTwo_ClientThreeV2} TS02-C3)
        (ref-U|DALOS:module{UtilityDalosV2} U|DALOS)
    )
    (let*
        (
            (pool:string (ref-U|DALOS::UDC_Makeid "LpProbePool"))
            (lp:string (AQP-POOL.UR_AQP|PoolAssetId pool))
            (insider:string (at 0 (ref-SWP::UR_PoolTokens (ref-SWP::UR_GetLpSwpair lp))))
        )
        (ref-TS02-C3::AQP-SCR|C_IssueLiquidityScore
            KST.ANHD KST.ANHD "RerateScore" 6 insider 2.998 1.999)
        (let
            (
                (score:string (ref-U|DALOS::UDC_Makeid "RerateScore"))
            )
            (ref-TS02-C3::AQP-POOL|C_AddScore
                KST.ANHD (AQP-POOL.URC_AqpOwnerKontoFromClassAndAsset 0 lp) pool score)
            (map print
                [
                    (expect "<<TX-RERATE-06>> the score's denominator IS a token of the pool's pair"
                        true (contains insider (ref-SWP::UR_PoolTokens (ref-SWP::UR_GetLpSwpair lp))))
                    (expect "<<TX-RERATE-06>> the pool now employs it, and the score points back"
                        [true pool]
                        [(contains score (AQP-POOL.URC_PoolActiveScoreIds pool))
                         (AQP-SCORE.UR_SCR|ScoreAqpoolLink score)])
                    ;;SUPPORTED AT LAST -- all three conditions hold: employed, class 0, not a satellite
                    (expect "<<TX-RERATE-06>> ...so the engine declares it SUPPORTED"
                        true (AQP-POOL.URC_AQP|ScoreBackfillSupported pool score))
                    ;;no stakers yet, so there is genuinely nothing outstanding
                    (expect "<<TX-RERATE-06>> with no stakers, nothing is outstanding and no sweep is needed"
                        [[] false]
                        [(AQP-POOL.URHC_AQP|ScoreBackfillOutstanding pool score)
                         (AQP-POOL.URHC_AQP|ScoreBackfillNeeded pool score)])
                ]
            )
            ""
        )
    )
)
(env-sigs [])
(print "===^^^===")
(commit-tx)

;;||>>>>>>>>>>>>>>>>>>>>>>>>>
;;|| NEXT                   >
;;||>>>>>>>>>>>>>>>>>>>>>>>>>
(print "")
;;================================================================================
(begin-tx "TX-RERATE-07 - the slice EXECUTES: IMC, capability, writer, idempotence")
(env-gasmodel "table")(env-gaslimit 150000000)(env-gas 0)
(namespace "ouronet-ns")
;;==== TX-RERATE-07 · 00 · env-sigs (the PATRON signature, which is the whole gate) ====
(print "--- [TX-RERATE-07 · 00 · env-sigs (the PATRON signature)] ---")
;;The slice is PERMISSIONLESS as to WHO may re-rate, not as to WHO PAYS. `IGNIS::UEV_Patron`
;;reaches `CAP_EnforceAccountOwnership` on the patron, so the gas payer still has to sign --
;;which is what stops a stranger from spending somebody else's IGNIS on a sweep.
(env-sigs [ { "key": "PK_AncientHodler", "caps": [] } ])
;;==== TX-RERATE-07 · 01 · a zero-delta slice is a real transaction that writes nothing ====
(print "--- [TX-RERATE-07 · 01 · a zero-delta slice is a real transaction that writes nothing] ---")
;;THIS IS THE TEST THE REFUSALS COULD NOT BE. Every refusal in TX-RERATE-05 fails inside
;;`AQP|C>BACKFILL-SCORE-SLICE`, which means the three things BELOW the capability were never
;;executed once: `P|UEV_IMC` on `SCR::XE_ApplyRawBaseDelta` (which aborts with "None of the guards
;;passed" from `U|G::UEV_Any` several frames below the mistake -- how the Talos wiring bug was
;;found earlier in this round), the `SCR|XE>APPLY-RAW-BASE-DELTA` capability, and the writer.
;;
;;A holder with no position has target 0.0 and base 0.0, so the delta is 0.0 and NOTHING SHOULD
;;MOVE -- while every gate on the path is still crossed for real. That is exactly the shape worth
;;running first: it proves the path is wired without depending on a weight being right.
(let
    (
        (ref-SCR:module{AcquisitionScoresV2} AQP-SCORE)
        (ref-TS02-C3:module{TalosStageTwo_ClientThreeV2} TS02-C3)
        (ref-U|DALOS:module{UtilityDalosV2} U|DALOS)
    )
    (let*
        (
            (pool:string (ref-U|DALOS::UDC_Makeid "LpProbePool"))
            (score:string (ref-U|DALOS::UDC_Makeid "RerateScore"))
            (nzs-before:integer (ref-SCR::UR_SCR|ScoreNzsCount score))
            (total-before:decimal (ref-SCR::UR_SCR|ScoreTotalBaseScore score))
            (out:string
                (ref-TS02-C3::AQP-POOL|CCp_BackfillScoreSlice KST.ANHD pool score [KST.ANHD]))
        )
        (map print
            [
                (expect "<<TX-RERATE-07>> the slice RUNS — IMC, capability and writer all crossed"
                    true (> (length out) 0))
                (expect "<<TX-RERATE-07>> the holder's base is still 0.0 — a zero delta writes no weight"
                    0.0 (ref-SCR::UR_U-SCR|UserScoreBaseScore KST.ANHD pool score))
                ;;NZS-COUNT IS THE ONE THAT WOULD HAVE BITTEN. It counts holders with any weight,
                ;;and it is maintained by the same writer -- a no-op slice that nudged it would
                ;;corrupt every share computed from it, silently and permanently.
                (expect "<<TX-RERATE-07>> nzs-count is untouched by a zero-delta write"
                    nzs-before (ref-SCR::UR_SCR|ScoreNzsCount score))
                (expect "<<TX-RERATE-07>> ...and so is the score's total base"
                    total-before (ref-SCR::UR_SCR|ScoreTotalBaseScore score))
                (expect "<<TX-RERATE-07>> nothing became outstanding by running the sweep"
                    [] (AQP-POOL.URHC_AQP|ScoreBackfillOutstanding pool score))
            ]
        )
        ""
    )
)
;;==== TX-RERATE-07 · 02 · idempotent, repeat-safe, and indifferent to a duplicated account ====
(print "--- [TX-RERATE-07 · 02 · idempotent, repeat-safe, and indifferent to a duplicated account] ---")
;;THE PROPERTY THAT MAKES THE SWEEP PARALLEL. The target is recomputed immediately before each
;;write, INSIDE the map, so a replayed slice, an overlapping slice and an account named twice in
;;the same slice are all the same thing: the second visit sees the first visit's result and
;;computes 0.0. Batching the deltas before the writes would break all three at once.
(let
    (
        (ref-SCR:module{AcquisitionScoresV2} AQP-SCORE)
        (ref-TS02-C3:module{TalosStageTwo_ClientThreeV2} TS02-C3)
        (ref-U|DALOS:module{UtilityDalosV2} U|DALOS)
    )
    (let*
        (
            (pool:string (ref-U|DALOS::UDC_Makeid "LpProbePool"))
            (score:string (ref-U|DALOS::UDC_Makeid "RerateScore"))
            (nzs-before:integer (ref-SCR::UR_SCR|ScoreNzsCount score))
            (total-before:decimal (ref-SCR::UR_SCR|ScoreTotalBaseScore score))
        )
        ;;replay the identical slice
        (ref-TS02-C3::AQP-POOL|CCp_BackfillScoreSlice KST.ANHD pool score [KST.ANHD])
        ;;the SAME account listed three times in one slice
        (ref-TS02-C3::AQP-POOL|CCp_BackfillScoreSlice KST.ANHD pool score [KST.ANHD KST.ANHD KST.ANHD])
        ;;an account that was never in the outstanding list at all
        (ref-TS02-C3::AQP-POOL|CCp_BackfillScoreSlice KST.ANHD pool score [KST.EMMA])
        (map print
            [
                (expect "<<TX-RERATE-07>> replay, a thrice-duplicated account and an off-list account all leave the state identical"
                    [nzs-before total-before 0.0 0.0]
                    [(ref-SCR::UR_SCR|ScoreNzsCount score)
                     (ref-SCR::UR_SCR|ScoreTotalBaseScore score)
                     (ref-SCR::UR_U-SCR|UserScoreBaseScore KST.ANHD pool score)
                     (ref-SCR::UR_U-SCR|UserScoreBaseScore KST.EMMA pool score)])
                (expect "<<TX-RERATE-07>> and the sweep still reports itself complete"
                    [[] false]
                    [(AQP-POOL.URHC_AQP|ScoreBackfillOutstanding pool score)
                     (AQP-POOL.URHC_AQP|ScoreBackfillNeeded pool score)])
            ]
        )
        ""
    )
)
(print "===^^^===")
(commit-tx)

;;||>>>>>>>>>>>>>>>>>>>>>>>>>
;;|| NEXT                   >
;;||>>>>>>>>>>>>>>>>>>>>>>>>>
(print "")
;;================================================================================
(begin-tx "TX-RERATE-08 - a REAL staked position, and a baseline that agrees with itself")
(env-gasmodel "table")(env-gaslimit 900000000)(env-gas 0)
(namespace "ouronet-ns")
;;==== TX-RERATE-08 · 01 · env-sigs (caps) ====
(print "--- [TX-RERATE-08 · 01 · env-sigs (caps)] ---")
(env-sigs
    [ { "key": "PK_AncientHodler", "caps": [] }
      { "key": "6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263"
      , "caps":
        [ (coin.TRANSFER "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263"
                         "k:0cb30c0121ff919266121a99ff9359871818932211df94dae4137c29bc0e8f7e" 1000000.0)
          (coin.TRANSFER "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263"
                         "k:50d6c59b21e5e6e55baecaa75a1007de37576bde12d8230dc82459cc01b9484b" 1000000.0)
          (coin.TRANSFER "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263"
                         "c:XM-pkmuB5XUQlp87ZYSbfKt8qzmHY6O2EHAzMRVBt3k" 1000000.0)
          (coin.TRANSFER "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263"
                         "c:iQQFWj6gWtpGEzhM_O5ekW1QtnQQy55R8BRPGhj_0FU" 1000000.0) ] } ])
;;==== TX-RERATE-08 · 02 · stand up a vault, stake into it, check the three maintained figures ====
(print "--- [TX-RERATE-08 · 02 · stand up a vault, stake into it, check the three maintained figures] ---")
;;THE FIXTURE EVERYTHING BELOW NEEDS, and the reason it is a class-1 VAULT rather than the class-0
;;LP pool this file already carries. A pool is only stakeable if its employed score sits behind a
;;live FVT reward pipeline -- an employed score with no enabled ScoreEntityLink and no reward
;;token aborts every stake (05_FVT.pact:986). For a class-0 LP score that pipeline must be a FARM
;;(`URC_ScoreClassMatchesFvtClass` admits LP only to fvt-class 0), and a farm's score entity needs
;;a positive GHOST WEIGHT, which is the LP's value in the farm's denominator -- zero here, because
;;the issuance-only SWP fixture mints LP supply without ever adding reserves. So a class-0
;;end-to-end fixture needs real liquidity that this chain does not have.
;;
;;`AQP-FVT|C_IssueGenericEarningVault` builds the class-1 equivalent -- score, pool, link, vault,
;;entity and reward token -- in ONE call and one IGNIS collection. The engine supports class 1 for
;;the same reason it supports class 0: the per-leg arithmetic is literally the same function body
;;(pinned equal in TX-RERATE-04), so what is proven here holds for an LP pool too.
(let
    (
        (ref-SCR:module{AcquisitionScoresV2} AQP-SCORE)
        (ref-TS02-C3:module{TalosStageTwo_ClientThreeV2} TS02-C3)
        (ref-U|DALOS:module{UtilityDalosV2} U|DALOS)
        (ref-DALOS:module{OuronetDalosV2} DALOS)
    )
    (let*
        (
            (ouro:string (ref-DALOS::UR_OuroborosID))
            (pool:string (ref-U|DALOS::UDC_Makeid "RerateVaultPool"))
            (score:string (ref-U|DALOS::UDC_Makeid "RerateVaultScore"))
        )
        (ref-TS02-C3::AQP-FVT|C_IssueGenericEarningVault
            KST.ANHD KST.ANHD "RerateVault" ouro "AURYN-98c486052a51")
        (ref-TS02-C3::AQP-POOL|CC_StakeTrueFungible KST.ANHD KST.ANHD KST.ANHD pool ouro 1000.0)
        (map print
            [
                ;;the fixture, asserted -- a class-1 score on a class-1 pool, employed
                (expect "<<TX-RERATE-08>> the vault built a class-1 score employed by a class-1 pool"
                    [1 1 pool true]
                    [(ref-SCR::UR_SCR|ScoreClass score)
                     (AQP-POOL.UR_AQP|PoolAqpClass pool)
                     (ref-SCR::UR_SCR|ScoreAqpoolLink score)
                     (contains score (AQP-POOL.URC_PoolActiveScoreIds pool))])
                (expect "<<TX-RERATE-08>> ...and the engine supports it"
                    true (AQP-POOL.URC_AQP|ScoreBackfillSupported pool score))
                ;;native leg, so the weight IS the amount -- times nothing
                (expect "<<TX-RERATE-08>> the staker's base is 1000.0 — a native leg multiplies by 1.0"
                    1000.0 (ref-SCR::UR_U-SCR|UserScoreBaseScore KST.ANHD pool score))
                ;;THE THREE FIGURES ONE WRITER MAINTAINS. If any could disagree, every reward
                ;;share computed downstream would be wrong in a way nothing reports.
                (expect "<<TX-RERATE-08>> the score's total base equals the one holder's base"
                    1000.0 (ref-SCR::UR_SCR|ScoreTotalBaseScore score))
                (expect "<<TX-RERATE-08>> ...and nzs-count counts exactly that one holder"
                    1 (ref-SCR::UR_SCR|ScoreNzsCount score))
                ;;CONSISTENT BY CONSTRUCTION: the stake path and the engine's target are the same
                ;;arithmetic, so a freshly staked pool has nothing outstanding. A non-empty list
                ;;here would mean the two already disagree.
                (expect "<<TX-RERATE-08>> nothing is outstanding — the stake path and the target agree"
                    [[] false]
                    [(AQP-POOL.URHC_AQP|ScoreBackfillOutstanding pool score)
                     (AQP-POOL.URHC_AQP|ScoreBackfillNeeded pool score)])
                (expect "<<TX-RERATE-08>> ...and the pool is not frozen"
                    false (AQP-POOL.UR_AQP|PoolSweepInProgress pool))
            ]
        )
        ""
    )
)
(env-sigs [])
(print "===^^^===")
(commit-tx)

;;||>>>>>>>>>>>>>>>>>>>>>>>>>
;;|| NEXT                   >
;;||>>>>>>>>>>>>>>>>>>>>>>>>>
(print "")
