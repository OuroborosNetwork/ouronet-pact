(begin-tx "TX-RERATE-01 - the duration scale: months remaining, and the curve over them")
(namespace "ouronet-ns")
;;==== TX-RERATE-01 · 01 · UC_DecayMonthsRemaining — the shared 0..cap scale ====
(print "--- [TX-RERATE-01 · 01 · UC_DecayMonthsRemaining — the shared 0..cap scale] ---")
;;These are the two numbers the whole anti-gambling mechanism rests on, and they are asserted
;;against the LITERAL chain bounds rather than against each other: `VST|C>SLEEP` caps duration at
;;788,400,000 seconds and `VST|C>HIBERNATE` caps `dayz` at 36,500. Divided by the month constant
;;those are EXACTLY 300 and EXACTLY 1200, which is the only reason one month constant can serve
;;both curves. If either chain bound ever moves, these fail here rather than silently re-scaling
;;every holder's multiplier.
(let
    (
        (ref-SCR:module{AcquisitionScoresV2} AQP-SCORE)
    )
    (map print
        [
            (expect "<<TX-RERATE-01>> the 25-year SLEEP bound is exactly 300 months"
                300 (ref-SCR::UC_DecayMonthsRemaining 788400000.0 300))
            (expect "<<TX-RERATE-01>> the 100-year HIBERNATE bound (36500 days) is exactly 1200 months"
                1200 (ref-SCR::UC_DecayMonthsRemaining 3153600000.0 1200))
            ;;clamped at the cap: a hibernation-length duration on the sleep scale cannot buy
            ;;more than the sleep ceiling
            (expect "<<TX-RERATE-01>> a 100-year duration on the 300-month scale CLAMPS to 300"
                300 (ref-SCR::UC_DecayMonthsRemaining 3153600000.0 300))
            ;;clamped at zero: a matured nonce earns nothing, and a negative remaining time is
            ;;what a matured nonce actually produces (release-date minus a LATER block time)
            (expect "<<TX-RERATE-01>> a MATURED nonce (negative remaining) is 0 months, not negative"
                0 (ref-SCR::UC_DecayMonthsRemaining -1.0 300))
            (expect "<<TX-RERATE-01>> exactly-matured is 0 months"
                0 (ref-SCR::UC_DecayMonthsRemaining 0.0 300))
            (expect "<<TX-RERATE-01>> one month of lock reads as 1 month"
                1 (ref-SCR::UC_DecayMonthsRemaining 2628000.0 300))
            ;;ROUNDS, not floors — the reason is the gap between the sleep tx and the stake tx.
            ;;An hour short of 36 months must still read 36, or every holder is short-changed by
            ;;however long they took to stake.
            (expect "<<TX-RERATE-01>> 36 months MINUS an hour still reads 36 (it rounds, not floors)"
                36 (ref-SCR::UC_DecayMonthsRemaining (- (* 36.0 2628000.0) 3600.0) 300))
            (expect "<<TX-RERATE-01>> ...and half a month past 36 rounds up to 37"
                37 (ref-SCR::UC_DecayMonthsRemaining (+ (* 36.0 2628000.0) 1400000.0) 300))
        ]
    )
    ""
)
;;==== TX-RERATE-01 · 02 · UC_MxAtMonths — the curve, exact at both ends ====
(print "--- [TX-RERATE-01 · 02 · UC_MxAtMonths — the curve, exact at both ends] ---")
;;THE CEILING MUST BE REACHED EXACTLY, for any ceiling and any cap. That is what lets the owner
;;pick 1.999 or 2.2 or 3.4 with no divisibility rule, and it is why the function multiplies
;;before dividing: a per-month step computed first would never land on the ceiling.
(let
    (
        (ref-SCR:module{AcquisitionScoresV2} AQP-SCORE)
    )
    (map print
        [
            (expect "<<TX-RERATE-01>> full sleep term returns the ceiling EXACTLY (2.2)"
                2.2 (ref-SCR::UC_MxAtMonths 2.2 300 300))
            (expect "<<TX-RERATE-01>> ...and for a 3-decimal ceiling too (1.999)"
                1.999 (ref-SCR::UC_MxAtMonths 1.999 300 300))
            (expect "<<TX-RERATE-01>> full HIBERNATE term returns the ceiling EXACTLY (3.4 at 1200)"
                3.4 (ref-SCR::UC_MxAtMonths 3.4 1200 1200))
            (expect "<<TX-RERATE-01>> zero months earns the PLAIN rate, 1.0 — never the ceiling"
                1.0 (ref-SCR::UC_MxAtMonths 2.2 0 300))
            (expect "<<TX-RERATE-01>> half the sleep term earns half the bonus (1.6 of a 2.2 ceiling)"
                1.6 (ref-SCR::UC_MxAtMonths 2.2 150 300))
            (expect "<<TX-RERATE-01>> half the HIBERNATE term likewise (2.2 of a 3.4 ceiling)"
                2.2 (ref-SCR::UC_MxAtMonths 3.4 600 1200))
            ;;THE GAMBLE, PRICED. One month of a 25-year ceiling is worth a third of one percent.
            ;;Before this it was worth the whole ceiling.
            (expect "<<TX-RERATE-01>> ONE month of a 2.0 ceiling is under 1.01x — the gamble is priced out"
                true (< (ref-SCR::UC_MxAtMonths 2.0 1 300) 1.01))
            (expect "<<TX-RERATE-01>> ...and one month of a 100-year HIBERNATE ceiling is under 1.003x"
                true (< (ref-SCR::UC_MxAtMonths 3.4 1 1200) 1.003))
            ;;MONOTONE: more commitment is never worth less. Asserted rather than assumed because
            ;;a sign slip in the numerator would invert the whole incentive and still return
            ;;plausible numbers at both ends.
            (expect "<<TX-RERATE-01>> the curve is monotone — 299 months is worth less than 300"
                true (< (ref-SCR::UC_MxAtMonths 2.2 299 300) (ref-SCR::UC_MxAtMonths 2.2 300 300)))
        ]
    )
    ""
)
;;==== TX-RERATE-01 · 03 · the sleep-named pair still agrees with the general one ====
(print "--- [TX-RERATE-01 · 03 · the sleep-named pair still agrees with the general one] ---")
;;`UC_SleepMonthsRemaining` / `UC_SleepMxAtMonths` keep their own bodies at the 300-month cap and
;;are pinned by [6.2.2] TX-SCORE-16. These assertions are what make that a CROSS-CHECK rather
;;than two independent implementations free to drift: same inputs, same answers, both directions.
(let
    (
        (ref-SCR:module{AcquisitionScoresV2} AQP-SCORE)
    )
    (map print
        [
            (expect "<<TX-RERATE-01>> months: the sleep-named helper equals the general one at cap 300"
                [300 0 1 36]
                [(ref-SCR::UC_SleepMonthsRemaining 788400000.0)
                 (ref-SCR::UC_SleepMonthsRemaining -1.0)
                 (ref-SCR::UC_SleepMonthsRemaining 2628000.0)
                 (ref-SCR::UC_SleepMonthsRemaining (- (* 36.0 2628000.0) 3600.0))])
            (expect "<<TX-RERATE-01>> curve: likewise, including the exact ceiling"
                [(ref-SCR::UC_MxAtMonths 2.2 300 300)
                 (ref-SCR::UC_MxAtMonths 2.2 0 300)
                 (ref-SCR::UC_MxAtMonths 2.2 150 300)]
                [(ref-SCR::UC_SleepMxAtMonths 2.2 300)
                 (ref-SCR::UC_SleepMxAtMonths 2.2 0)
                 (ref-SCR::UC_SleepMxAtMonths 2.2 150)])
        ]
    )
    ""
)
(print "===^^^===")
(commit-tx)

