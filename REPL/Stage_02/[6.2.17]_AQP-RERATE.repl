(begin-tx "TX-RERATE-11 - revoking a score people hold weight in: the three-phase drain")
(env-gasmodel "table")(env-gaslimit 900000000)(env-gas 0)
(namespace "ouronet-ns")
;;==== TX-RERATE-11 · 01 · env-sigs (caps) ====
(print "--- [TX-RERATE-11 · 01 · env-sigs (caps)] ---")
(env-sigs
    [ { "key": "PK_AncientHodler", "caps": [] }
      { "key": "6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263"
      , "caps":
        [ (coin.TRANSFER "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263"
                         "k:0cb30c0121ff919266121a99ff9359871818932211df94dae4137c29bc0e8f7e" 1000000.0)
          (coin.TRANSFER "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263"
                         "k:50d6c59b21e5e6e55baecaa75a1007de37576bde12d8230dc82459cc01b9484b" 1000000.0)
          (coin.TRANSFER "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263"
                         "c:XM-pkmuB5XUQlp87ZYSbfKt8qzmHY6O2EHAzMRVBt3k" 1000000.0)
          (coin.TRANSFER "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263"
                         "c:iQQFWj6gWtpGEzhM_O5ekW1QtnQQy55R8BRPGhj_0FU" 1000000.0) ] } ])
;;==== TX-RERATE-11 · 02 · the one-shot revoke refuses, and why that was a dead end ====
(print "--- [TX-RERATE-11 · 02 · the one-shot revoke refuses, and why that was a dead end] ---")
;;`C_RevokeScore` demands ZERO TOTALS, and it is right to: cutting the link over live weight
;;would strand that weight in the score's totals and `nzs-count` with nothing left able to
;;reverse it. But it also made revoke UNREACHABLE on any pool somebody had staked into -- an
;;admin cannot unstake on a holder's behalf, so there was no legitimate way to reach zero.
;;That is the gap the three phases close: the requirement becomes a GOAL, not a precondition.
(let
    (
        (ref-SCR:module{AcquisitionScoresV2} AQP-SCORE)
        (ref-TS02-C3:module{TalosStageTwo_ClientThreeV2} TS02-C3)
        (ref-U|DALOS:module{UtilityDalosV2} U|DALOS)
    )
    (let*
        (
            (pool:string (ref-U|DALOS::UDC_Makeid "RerateVaultPool"))
            (scoreb:string (ref-U|DALOS::UDC_Makeid "RerateScoreB"))
            (owner:string (AQP-POOL.URC_AqpOwnerKontoFromClassAndAsset 1 (DALOS.UR_OuroborosID)))
        )
        (map print
            [
                ;;the state that makes the one-shot path impossible
                (expect "<<TX-RERATE-11>> the score carries real weight: 1000.0 across 1 holder"
                    [1000.0 1] [(ref-SCR::UR_SCR|ScoreTotalBaseScore scoreb)
                                (ref-SCR::UR_SCR|ScoreNzsCount scoreb)])
                (expect-failure "<<TX-RERATE-11>> so the ONE-SHOT revoke refuses — zero totals is a precondition it cannot reach"
                    "Invalid score revoke for pool"
                    (ref-TS02-C3::AQP-POOL|C_RevokeScore KST.ANHD owner pool scoreb))
            ]
        )
        ""
    )
)
;;==== TX-RERATE-11 · 03 · PHASE 1: unslot, and the marker that needs no new column ====
(print "--- [TX-RERATE-11 · 03 · PHASE 1: unslot, and the marker that needs no new column] ---")
(let
    (
        (ref-SCR:module{AcquisitionScoresV2} AQP-SCORE)
        (ref-TS02-C3:module{TalosStageTwo_ClientThreeV2} TS02-C3)
        (ref-U|DALOS:module{UtilityDalosV2} U|DALOS)
    )
    (let*
        (
            (pool:string (ref-U|DALOS::UDC_Makeid "RerateVaultPool"))
            (scoreb:string (ref-U|DALOS::UDC_Makeid "RerateScoreB"))
            (owner:string (AQP-POOL.URC_AqpOwnerKontoFromClassAndAsset 1 (DALOS.UR_OuroborosID)))
        )
        (ref-TS02-C3::AQP-POOL|C_BeginScoreRevoke KST.ANHD owner pool scoreb)
        (map print
            [
                ;;UNSLOTTED BUT STILL LINKED -- the pending-revoke marker, expressed entirely in
                ;;state that already existed. No new column, no migration transaction.
                (expect "<<TX-RERATE-11>> the score is OUT of the pool's slots but STILL linked to it"
                    [false pool]
                    [(contains scoreb (AQP-POOL.URC_PoolActiveScoreIds pool))
                     (ref-SCR::UR_SCR|ScoreAqpoolLink scoreb)])
                ;;...which is exactly what the orphan scan looks for
                (expect "<<TX-RERATE-11>> so it shows up as an ORPHANED score on the pool"
                    [scoreb] (AQP-POOL.URHC_AQP|PoolOrphanedScores pool))
                (expect "<<TX-RERATE-11>> and its holder is on the drain work list"
                    [KST.ANHD] (AQP-POOL.URHC_AQP|ScoreDrainOutstanding pool scoreb))
                (expect "<<TX-RERATE-11>> the pool is frozen, both directions shut"
                    [true false false]
                    [(AQP-POOL.UR_AQP|PoolSweepInProgress pool)
                     (AQP-POOL.URC_PoolStakeAdmissionOk pool)
                     (AQP-POOL.URC_PoolUnstakeAdmissionOk pool)])
                ;;THE RE-RATE SWEEP WILL NOT TOUCH IT, and the drain is the only thing that can.
                ;;The two work lists are exact complements: re-rating is for scores the pool
                ;;employs, draining for ones it has stopped employing.
                (expect "<<TX-RERATE-11>> the RE-RATE list is empty for it — an unslotted score is not re-ratable"
                    [false []]
                    [(AQP-POOL.URC_AQP|ScoreBackfillSupported pool scoreb)
                     (AQP-POOL.URHC_AQP|ScoreBackfillOutstanding pool scoreb)])
                ;;phase 3 refuses while the work exists -- measured, not asserted by a flag
                (expect-failure "<<TX-RERATE-11>> PHASE 3 is refused while a holder still carries weight"
                    "Drain is not complete"
                    (ref-TS02-C3::AQP-POOL|CC_FinalizeScoreRevoke KST.ANHD owner pool scoreb))
            ]
        )
        ""
    )
)
;;==== TX-RERATE-11 · 04 · PHASE 2 + 3: drain, finalize, release ====
(print "--- [TX-RERATE-11 · 04 · PHASE 2 + 3: drain, finalize, release] ---")
(let
    (
        (ref-SCR:module{AcquisitionScoresV2} AQP-SCORE)
        (ref-TS02-C3:module{TalosStageTwo_ClientThreeV2} TS02-C3)
        (ref-U|DALOS:module{UtilityDalosV2} U|DALOS)
    )
    (let*
        (
            (pool:string (ref-U|DALOS::UDC_Makeid "RerateVaultPool"))
            (scoreb:string (ref-U|DALOS::UDC_Makeid "RerateScoreB"))
            (score:string (ref-U|DALOS::UDC_Makeid "RerateVaultScore"))
            (owner:string (AQP-POOL.URC_AqpOwnerKontoFromClassAndAsset 1 (DALOS.UR_OuroborosID)))
        )
        ;;the drain slice, then a REPLAY of it -- the second pass must be a no-op
        (ref-TS02-C3::AQP-POOL|Cp_DrainScoreSlice KST.ANHD pool scoreb [KST.ANHD])
        (ref-TS02-C3::AQP-POOL|Cp_DrainScoreSlice KST.ANHD pool scoreb [KST.ANHD KST.ANHD])
        (map print
            [
                ;;THE WEIGHT IS GONE, in all three maintained figures at once.
                (expect "<<TX-RERATE-11>> the holder's base, the score's total and nzs-count are all retired together"
                    [0.0 0.0 0]
                    [(ref-SCR::UR_U-SCR|UserScoreBaseScore KST.ANHD pool scoreb)
                     (ref-SCR::UR_SCR|ScoreTotalBaseScore scoreb)
                     (ref-SCR::UR_SCR|ScoreNzsCount scoreb)])
                (expect "<<TX-RERATE-11>> the drain work list is empty — replaying it changed nothing"
                    [] (AQP-POOL.URHC_AQP|ScoreDrainOutstanding pool scoreb))
                ;;THE OTHER SCORE IS UNTOUCHED. A drain is aimed at one (pool, score) pair, and
                ;;this is what proves it did not reach across to the pool's live score.
                (expect "<<TX-RERATE-11>> the pool's REMAINING score still carries its full weight"
                    [1000.0 1000.0 1]
                    [(ref-SCR::UR_U-SCR|UserScoreBaseScore KST.ANHD pool score)
                     (ref-SCR::UR_SCR|ScoreTotalBaseScore score)
                     (ref-SCR::UR_SCR|ScoreNzsCount score)])
            ]
        )
        ;;phase 3, then the release
        (ref-TS02-C3::AQP-POOL|CC_FinalizeScoreRevoke KST.ANHD owner pool scoreb)
        (ref-TS02-C3::AQP-FVT|CC_ClearPoolSweep KST.ANHD pool)
        (map print
            [
                (expect "<<TX-RERATE-11>> the link is cut, and the orphan list is empty"
                    [(U|CT.CT_BAR) []]
                    [(ref-SCR::UR_SCR|ScoreAqpoolLink scoreb)
                     (AQP-POOL.URHC_AQP|PoolOrphanedScores pool)])
                (expect "<<TX-RERATE-11>> the pool is released and BOTH directions reopen"
                    [false true true]
                    [(AQP-POOL.UR_AQP|PoolSweepInProgress pool)
                     (AQP-POOL.URC_PoolStakeAdmissionOk pool)
                     (AQP-POOL.URC_PoolUnstakeAdmissionOk pool)])
                ;;AND THE SCORE IS RE-USABLE: a BAR aqpool-link is what `UEV_AddScorePoolAndScore`
                ;;requires to admit a score, so a fully retired score can be employed again --
                ;;which a half-finished revoke would have blocked forever.
                (expect "<<TX-RERATE-11>> the retired score is admissible again (link is BAR, totals are zero)"
                    [true true]
                    [(= (ref-SCR::UR_SCR|ScoreAqpoolLink scoreb) (U|CT.CT_BAR))
                     (= (ref-SCR::UR_SCR|ScoreTotalBaseScore scoreb) 0.0)])
            ]
        )
        ""
    )
)
(env-sigs [])
(print "===^^^===")
(commit-tx)
(print "")
;;||>>>>>>>>>>>>>>>>>>>>>>>>>
;;|| NEXT                   >
;;||>>>>>>>>>>>>>>>>>>>>>>>>>
(print "")
;;
(begin-tx "TX-RERATE-SAT - a class-1 pool scores its sleeping satellite like the native token")
(print "")
(print "=== TX-RERATE-SAT — special satellites score, and custody follows the instrument ======")
(namespace "ouronet-ns")
(env-gasmodel "table")(env-gaslimit 900000000)(env-gas 0)
;;==== TX-RERATE-SAT · 01 · env-sigs (caps) ====
(print "--- [TX-RERATE-SAT · 01 · env-sigs (caps)] ---")
(env-sigs [ { "key": "PK_AncientHodler", "caps": [] } ])
;;==== TX-RERATE-SAT · 02 · stake a Z| satellite into a class-1 pool ====
(print "--- [TX-RERATE-SAT · 02 · stake a Z| satellite into a class-1 pool] ---")
;;OWNER RULING 2026-10-10: "special token satelites must behave like the native token plus their
;;designated multiplier." This block is that rule, end to end, on the only pool shape that can
;;hold one -- aqp-class 1, the DPTF pool whose satellites are `Z|` and `H|` variants of its asset.
;;
;;THIS TEST REPLACES ONE THAT ASSERTED THE OPPOSITE, and the replacement is the evidence. Until
;;today a satellite staked here MOVED, was TRACKED, and scored NOTHING -- three rules composing
;;into a silent dead end that none of them stated:
;;  - `UEV_AddScorePoolAndScore` enforces `score-class == aqp-class`, so a class-1 pool employs
;;    only class-1 scores;
;;  - the orto score-delta dispatch handled score-class 0 and 2 ONLY, falling through to an
;;    `"of-skip"` cumulator of 0.0 for everything else;
;;  - `URC_StakeOrtoFungibleDpofMatchesPool` admits `Z|`/`H|` satellites on aqp-class 1.
;;The previous version of this transaction pinned that zero and said in its own comment that it
;;would go red the day class-1 scoring was wired up. It did, at 1000.0 -> 1025.0, which is how the
;;fix was confirmed rather than assumed.
;;
;;`mx-sleeping` IS 1.0 ON THIS SCORE and that is the interesting case, not a degenerate one. It is
;;the owner's own example: a sleeping variant minted with a bonus quantity should weigh exactly
;;like the native token, so its ceiling is set to 1.0 -- and because the multiplier is a CEILING
;;reached at full term, a ceiling of 1.0 makes the duration curve a no-op. The 25.0 staked is
;;therefore worth exactly 25.0, with no rounding and no decay to reason about.
(let*
    (
        (ref-DALOS:module{OuronetDalosV2} DALOS)
        (ref-U|DALOS:module{UtilityDalosV2} U|DALOS)
        (ref-DPTF:module{DemiourgosPactTrueFungibleV2} DPTF)
        (ref-DPOF:module{DemiourgosPactOrtoFungibleV2} DPOF)
        (ref-TS01-C2:module{TalosStageOne_ClientTwoV2} TS01-C2)
        (ref-TS02-C3:module{TalosStageTwo_ClientThreeV2} TS02-C3)
        (ref-SCR:module{AcquisitionScoresV2} AQP-SCORE)
        (ref-AQP:module{AcquisitionPoolsV1} AQP-POOL)
        ;;
        (patron:string KST.ANHD)
        (owner:string KST.ANHD)
        (aqp-sc:string (ref-DALOS::GOV|AQP|SC_NAME))
        (ouro:string (ref-DALOS::UR_OuroborosID))
        (zouro:string (ref-DPTF::UR_Sleeping ouro))
        (pool:string (ref-U|DALOS::UDC_Makeid "RerateVaultPool"))
        (score:string (ref-U|DALOS::UDC_Makeid "RerateVaultScore"))
    )
    (ref-TS01-C2::VST|C_Sleep patron owner owner ouro 25.0 86400)
    (let*
        (
            (held:[integer] (ref-DPOF::URH_AccountNonces owner zouro))
            (n:integer (at (- (length held) 1) held))
            (base-pre:decimal (ref-SCR::UR_U-SCR|UserScoreBaseScore owner pool score))
        )
        (map print
            [
                ;;the fixture: an aqp-class-1 pool with a class-1 score whose sleeping ceiling is 1.0
                (expect "<<TX-RERATE-SAT>> fixture: aqp-class 1, score-class 1, mx-sleeping 1.999, Z| satellite of OURO"
                    [1 1 1.999 ouro]
                    [(ref-AQP::UR_AQP|PoolAqpClass pool)
                     (ref-SCR::UR_SCR|ScoreClass score)
                     (ref-SCR::UR_SCR|ScoreMxSleeping score)
                     (ref-DPOF::UR_Sleeping zouro)])
                ;;CUSTODY IS MANDATORY, because this is a SLEEPING leg and it now earns. The rule
                ;;follows the instrument, not the pool class -- and it was briefly scoped to
                ;;aqp-class 0 precisely because this leg used to earn nothing.
                (expect-failure "<<TX-RERATE-SAT>> the ordinary path refuses it — a sleeping leg that earns must be custodial"
                    "Invalid stake path: a sleeping leg that earns a duration multiplier must be staked under pool custody"
                    (ref-TS02-C3::AQP-POOL|CC_StakeOrtoFungible patron owner owner pool zouro [n]))
            ]
        )
        (ref-TS02-C3::AQP-POOL|CCp_StakeSpecialCustodial patron owner owner pool zouro [n])
        (map print
            [
                ;;THE SATELLITE SCORES LIKE THE NATIVE TOKEN. 25.0 staked at a 1.0 ceiling is
                ;;exactly 25.0 of base -- the owner's rule, asserted as an equality rather than as
                ;;"greater than", because the whole point is that the figure is the AMOUNT and not
                ;;some fraction of it.
                (expect "<<TX-RERATE-SAT>> the base rises by EXACTLY the staked amount — satellite weighted as native × 1.0"
                    (+ base-pre 25.0)
                    (ref-SCR::UR_U-SCR|UserScoreBaseScore owner pool score))
                ;;custody shape: the pool owns the row, the staker owns none, the weight is the staker's
                (expect "<<TX-RERATE-SAT>> the tracker credits the POOL as owner while the WEIGHT accrues to the staker"
                    [true 0.0]
                    [(> (ref-AQP::UR_AQP|DPOFTrackerBalance pool zouro aqp-sc owner n) 0.0)
                     (ref-AQP::UR_AQP|DPOFTrackerBalance pool zouro owner owner n)])
                ;;and the term was stamped, so the reversal has a figure to read
                (expect "<<TX-RERATE-SAT>> the sleep-term ledger stamped this nonce"
                    [true true]
                    [(> (ref-SCR::UR_SCR|SleepRemainingAtStake zouro n) 0.0)
                     (<= (ref-SCR::UR_SCR|SleepRemainingAtStake zouro n) 86400.0)])
                ;;no early exit, by the shape of the data: no row is keyed to the staker
                (expect-failure "<<TX-RERATE-SAT>> and the staker cannot withdraw it early"
                    "Invalid OF pool custody"
                    (ref-TS02-C3::AQP-POOL|CC_UnstakeOrtoFungible patron owner owner pool zouro [n]))
            ]
        )
        ;;--- the lock matures, relative to wherever this chain already is ---
        (env-chain-data { "block-time": (add-time (at "block-time" (chain-data)) (days 2)) })
        (ref-TS02-C3::AQP-POOL|CCp_ReleaseSpecialCustodial patron pool owner zouro n)
        (map print
            [
                ;;THE ROUND TRIP NETS TO EXACTLY ZERO. With a 1.0 ceiling there is no decay to
                ;;hide a discrepancy, so this is the cleanest possible check that the credit and
                ;;the reversal read the same rule from two different clocks.
                (expect "<<TX-RERATE-SAT>> after release the base is back to EXACTLY its pre-stake value"
                    base-pre (ref-SCR::UR_U-SCR|UserScoreBaseScore owner pool score))
                (expect "<<TX-RERATE-SAT>> the custodial tracker row is drained"
                    0.0 (ref-AQP::UR_AQP|DPOFTrackerBalance pool zouro aqp-sc owner n))
                (expect "<<TX-RERATE-SAT>> the batch is dissolved and the nonce RETIRED to supply -1.0"
                    -1.0 (ref-DPOF::UR_NonceSupply zouro n))
            ]
        )
    )
    ""
)
(env-sigs [])
(print "===^^^===")
(commit-tx)
(print "")
(begin-tx "TX-RERATE-SELL - selling a locked custodial position by reassigning the beneficiary")
(print "")
(print "=== TX-RERATE-SELL — Alice sells a locked position to Bob without unlocking it =====")
(namespace "ouronet-ns")
(env-gasmodel "table")(env-gaslimit 900000000)(env-gas 0)
;;==== TX-RERATE-SELL · 01 · env-sigs (caps) ====
(print "--- [TX-RERATE-SELL · 01 · env-sigs (caps)] ---")
(env-sigs [ { "key": "PK_AncientHodler", "caps": [] } ])
;;==== TX-RERATE-SELL · 02 · the reassignment ====
(print "--- [TX-RERATE-SELL · 02 · the reassignment] ---")
;;THE OWNER'S CASE, verbatim: "i aknoledge i cant take it out, and i must leave it stacked there
;;until the end, but i want to sell it to bob ... i no longer want you to stake it for me, but i
;;want bob to earn from it."
;;
;;A custodial stake cannot be withdrawn before its lock matures -- that IS the mechanism -- so
;;without this the holder has no exit at all, not even a sale. Reassignment moves the EARNINGS and
;;leaves the asset where it is.
;;
;;WHAT MAKES IT SAFE RATHER THAN A LOOPHOLE is the token's own transfer rule. The release pays the
;;NATIVE counterpart to whoever is beneficiary at maturity, so this is a DEFERRED DELIVERY of the
;;asset to Bob, not merely the sale of a claim -- and nothing downstream would catch it, because
;;the release transfers the native token, whose role list is a different object from the sleeping
;;variant's. So the gate asks `DPOF::UEV_MoveRoleCheck`, the same question a direct transfer asks.
(let*
    (
        (ref-DALOS:module{OuronetDalosV2} DALOS)
        (ref-U|DALOS:module{UtilityDalosV2} U|DALOS)
        (ref-DPTF:module{DemiourgosPactTrueFungibleV2} DPTF)
        (ref-DPOF:module{DemiourgosPactOrtoFungibleV2} DPOF)
        (ref-TS01-C2:module{TalosStageOne_ClientTwoV2} TS01-C2)
        (ref-TS02-C3:module{TalosStageTwo_ClientThreeV2} TS02-C3)
        (ref-SCR:module{AcquisitionScoresV2} AQP-SCORE)
        (ref-AQP:module{AcquisitionPoolsV1} AQP-POOL)
        ;;
        (patron:string KST.ANHD)
        (alice:string KST.ANHD)
        (bob:string KST.EMMA)
        (aqp-sc:string (ref-DALOS::GOV|AQP|SC_NAME))
        (ouro:string (ref-DALOS::UR_OuroborosID))
        (zouro:string (ref-DPTF::UR_Sleeping ouro))
        (pool:string (ref-U|DALOS::UDC_Makeid "RerateVaultPool"))
        (score:string (ref-U|DALOS::UDC_Makeid "RerateVaultScore"))
    )
    (ref-TS01-C2::VST|C_Sleep patron alice alice ouro 40.0 86400)
    (let*
        (
            (held:[integer] (ref-DPOF::URH_AccountNonces alice zouro))
            (n:integer (at (- (length held) 1) held))
        )
        (ref-TS02-C3::AQP-POOL|CCp_StakeSpecialCustodial patron alice alice pool zouro [n])
        (let*
            (
                (alice-base:decimal (ref-SCR::UR_U-SCR|UserScoreBaseScore alice pool score))
                (bob-base-pre:decimal (ref-SCR::UR_U-SCR|UserScoreBaseScore bob pool score))
                ;;Alice's TOTAL Z|OURO holding, which includes batches from earlier blocks in this
                ;;file. The point of capturing it is to prove the sale does not hand the batch
                ;;BACK to her, so what matters is that this figure does not move -- not that it is
                ;;zero, which it is not and should not be.
                (alice-z-pre:decimal (ref-DPOF::UR_AccountSupply zouro alice))
            )
            (map print
                [
                    (expect "<<TX-RERATE-SELL>> Alice holds the custodial position and its weight"
                        [true true]
                        [(> (ref-AQP::UR_AQP|DPOFTrackerBalance pool zouro aqp-sc alice n) 0.0)
                         (> alice-base 0.0)])
                    ;;SHE CANNOT WITHDRAW IT -- which is exactly why a sale has to be possible.
                    (expect-failure "<<TX-RERATE-SELL>> ...and cannot withdraw it, which is what makes the sale necessary"
                        "Invalid OF pool custody"
                        (ref-TS02-C3::AQP-POOL|CC_UnstakeOrtoFungible patron alice alice pool zouro [n]))
                    ;;A BUYER MUST BE NAMED, not implied: reassigning to yourself is a no-op that
                    ;;would still run two full phase chains and bill for them.
                    (expect-failure "<<TX-RERATE-SELL>> reassigning to herself is refused"
                        "Reassignment must name a different beneficiary"
                        (ref-TS02-C3::AQP-POOL|CCp_ReassignCustodialBeneficiary
                            patron alice pool zouro n alice))
                ]
            )
            ;;--- the sale ---
            (ref-TS02-C3::AQP-POOL|CCp_ReassignCustodialBeneficiary patron alice pool zouro n bob)
            (map print
                [
                    ;;THE POSITION MOVED WHOLE: Alice's row and weight are gone, Bob's exist.
                    ;;ALICE LOSES THE POSITION AND NOTHING ELSE. Her tracker row for this nonce
                    ;;goes to zero and her base drops by exactly the 40.0 the position carried --
                    ;;not to zero, because she also holds a 1000.0 NATIVE stake in this pool from
                    ;;TX-RERATE-08. Asserting zero here would have been asserting the fixture
                    ;;away, and the difference is the whole value of the test: it proves the
                    ;;reassignment touched ONE position rather than her whole standing.
                    (expect "<<TX-RERATE-SELL>> Alice's row is gone and her base drops by exactly the position's weight"
                        [0.0 (- alice-base 40.0)]
                        [(ref-AQP::UR_AQP|DPOFTrackerBalance pool zouro aqp-sc alice n)
                         (ref-SCR::UR_U-SCR|UserScoreBaseScore alice pool score)])
                    (expect "<<TX-RERATE-SELL>> Bob now holds the row — still keyed to the POOL as owner, so still locked"
                        true (> (ref-AQP::UR_AQP|DPOFTrackerBalance pool zouro aqp-sc bob n) 0.0))
                    ;;AND BOB GOT THE WEIGHT. On this score `mx-sleeping` is 1.0, so the figure is
                    ;;the staked amount exactly and the re-rate-vs-inherit question cannot hide in
                    ;;rounding: 40.0 either way.
                    (expect "<<TX-RERATE-SELL>> Bob earns exactly what the position is worth"
                        (+ bob-base-pre 40.0)
                        (ref-SCR::UR_U-SCR|UserScoreBaseScore bob pool score))
                    ;;THE ASSET NEVER MOVED, which is the whole point: the batch is still the
                    ;;pool's and still locked. A sale that released it would defeat the time-lock
                    ;;the multiplier priced. Asserted as "Alice's holding is UNCHANGED and Bob
                    ;;received nothing" rather than "both are zero", because Alice holds other
                    ;;sleeping batches from earlier blocks -- the invariant is that this
                    ;;transaction moved no tokens, not that nobody owns any.
                    (expect "<<TX-RERATE-SELL>> no tokens moved — Alice's holding is unchanged and Bob received none"
                        [alice-z-pre 0.0]
                        [(ref-DPOF::UR_AccountSupply zouro alice)
                         (ref-DPOF::UR_AccountSupply zouro bob)])
                    ;;NOR CAN BOB CASH OUT EARLY. He bought the position, not an unlock.
                    (expect-failure "<<TX-RERATE-SELL>> and Bob cannot release it early either"
                        "cannot be unsleeped yet"
                        (ref-TS02-C3::AQP-POOL|CCp_ReleaseSpecialCustodial patron pool bob zouro n))
                ]
            )
            ;;--- and at maturity it pays BOB, not Alice ---
            (env-chain-data { "block-time": (add-time (at "block-time" (chain-data)) (days 2)) })
            (let
                (
                    (bob-ouro-pre:decimal (ref-DPTF::UR_AccountSupply ouro bob))
                )
                (ref-TS02-C3::AQP-POOL|CCp_ReleaseSpecialCustodial patron pool bob zouro n)
                (map print
                    [
                        ;;THE DEFERRED DELIVERY, LANDING. This is why the gate has to ask the
                        ;;token's transfer rule: the native asset ends up with Bob.
                        (expect "<<TX-RERATE-SELL>> at maturity the NATIVE asset goes to Bob — the delivery the gate exists to police"
                            (+ bob-ouro-pre 40.0) (ref-DPTF::UR_AccountSupply ouro bob))
                        (expect "<<TX-RERATE-SELL>> Bob's weight unwinds to zero and the nonce retires"
                            [bob-base-pre -1.0]
                            [(ref-SCR::UR_U-SCR|UserScoreBaseScore bob pool score)
                             (ref-DPOF::UR_NonceSupply zouro n)])
                    ]
                )
            )
        )
    )
    ""
)
(env-sigs [])
(print "===^^^===")
(commit-tx)
(print "")
(begin-tx "TX-RERATE-WL - a RESTRICTED token: whitelisted buyer passes, stranger does not")
(print "")
(print "=== TX-RERATE-WL — the middle case: restricted token, whitelisted recipient ========")
(namespace "ouronet-ns")
(env-gasmodel "table")(env-gaslimit 900000000)(env-gas 0)
;;==== TX-RERATE-WL · 01 · env-sigs (caps) ====
(print "--- [TX-RERATE-WL · 01 · env-sigs (caps)] ---")
(env-sigs [ { "key": "PK_AncientHodler", "caps": [] } ])
;;==== TX-RERATE-WL · 02 · restrict the token, then sell to the whitelisted party ====
(print "--- [TX-RERATE-WL · 02 · restrict the token, then sell to the whitelisted party] ---")
;;THE CASE THE OWNER NAMED: "it may be that a trasnfer token is restricted in movment, but bob may
;;have a trasnfer role, so he is allowed to move towards. therefore alice can reasign to bob,
;;because she could have transfered to bob in the first place."
;;
;;THAT IS EXACTLY WHAT `DPOF::UEV_MoveRoleCheck` SAYS, and the shape of the check is why: it is an
;;`enforce-one` over [sender-has-role, receiver-has-role], so EITHER side qualifying is enough. The
;;gate asks that same question with (Alice, Bob), so the rule is literally "could Alice have
;;transferred to Bob" -- inherited from the token layer rather than restated.
;;
;;THIS IS THE MIDDLE OF A THREE-CASE TRUTH TABLE and it was the untested one. The other two are
;;pinned elsewhere and are the easy ones:
;;  - UNRESTRICTED token (only VST's infrastructure grant) -> allowed:  <<TX-RERATE-SELL>> above.
;;  - RESTRICTED, recipient NOT whitelisted              -> refused:   [6.4] <<TX-AQP-CL06>>.
;;Without this block the gate could have been coded as "refuse whenever restricted" and both of
;;those would still pass -- the over-broad rule is indistinguishable from the correct one until
;;somebody whitelists a counterparty. So this transaction is the one that tells them apart.
(let*
    (
        (ref-DALOS:module{OuronetDalosV2} DALOS)
        (ref-U|DALOS:module{UtilityDalosV2} U|DALOS)
        (ref-DPTF:module{DemiourgosPactTrueFungibleV2} DPTF)
        (ref-DPOF:module{DemiourgosPactOrtoFungibleV2} DPOF)
        (ref-VST:module{VestingV2} VST)
        (ref-TS01-C2:module{TalosStageOne_ClientTwoV2} TS01-C2)
        (ref-TS02-C3:module{TalosStageTwo_ClientThreeV2} TS02-C3)
        (ref-SCR:module{AcquisitionScoresV2} AQP-SCORE)
        (ref-AQP:module{AcquisitionPoolsV1} AQP-POOL)
        ;;
        (patron:string KST.ANHD)
        (alice:string KST.ANHD)
        (bob:string KST.EMMA)
        (stranger:string KST.FLRN)
        (aqp-sc:string (ref-DALOS::GOV|AQP|SC_NAME))
        (ouro:string (ref-DALOS::UR_OuroborosID))
        (zouro:string (ref-DPTF::UR_Sleeping ouro))
        (pool:string (ref-U|DALOS::UDC_Makeid "RerateVaultPool"))
        (score:string (ref-U|DALOS::UDC_Makeid "RerateVaultScore"))
    )
    (map print
        [
            ;;BEFORE: the token carries ONLY VST's automatic grant, so no human has restricted it.
            ;;Asserted so the state change below is visible rather than assumed.
            (expect "<<TX-RERATE-WL>> the token starts UNrestricted — VST's infrastructure grant alone does not count"
                false (ref-VST::URC_SpecialLegIssuerRestricted zouro))
        ]
    )
    ;;the token OWNER whitelists Bob — the only way any name other than VST's reaches that list
    (ref-TS01-C2::VST|C_ToggleTransferRoleSleepingDPOF
        patron (ouronet-ns.VST.URC_SpecialTransferRoleKonto zouro) zouro bob true)
    (ref-TS01-C2::VST|C_Sleep patron alice alice ouro 30.0 86400)
    (let*
        (
            (held:[integer] (ref-DPOF::URH_AccountNonces alice zouro))
            (n:integer (at (- (length held) 1) held))
        )
        (ref-TS02-C3::AQP-POOL|CCp_StakeSpecialCustodial patron alice alice pool zouro [n])
        (let*
            (
                (bob-base-pre:decimal (ref-SCR::UR_U-SCR|UserScoreBaseScore bob pool score))
            )
            (map print
                [
                    ;;AFTER: a human has named a holder, so the token is now issuer-restricted.
                    (expect "<<TX-RERATE-WL>> whitelisting Bob makes the token issuer-RESTRICTED"
                        true (ref-VST::URC_SpecialLegIssuerRestricted zouro))
                    ;;AND A STRANGER IS REFUSED, which is what the restriction is for. Note the
                    ;;asymmetry this proves: the SAME token, the SAME seller, two recipients, two
                    ;;answers. A gate keyed on "is it restricted" could not produce that.
                    (expect-failure "<<TX-RERATE-WL>> a NON-whitelisted buyer is refused on the restricted token"
                        "Incompatible Transfer Roles"
                        (ref-TS02-C3::AQP-POOL|CCp_ReassignCustodialBeneficiary
                            patron alice pool zouro n stranger))
                ]
            )
            ;;--- and the whitelisted one goes through ---
            (ref-TS02-C3::AQP-POOL|CCp_ReassignCustodialBeneficiary patron alice pool zouro n bob)
            (map print
                [
                    ;;THE SALE SUCCEEDED BECAUSE BOB COULD HAVE RECEIVED A DIRECT TRANSFER. This is
                    ;;the assertion that distinguishes the correct gate from the over-broad one.
                    (expect "<<TX-RERATE-WL>> the whitelisted buyer DOES get the position — Alice could have transferred to him"
                        [true (+ bob-base-pre 30.0)]
                        [(> (ref-AQP::UR_AQP|DPOFTrackerBalance pool zouro aqp-sc bob n) 0.0)
                         (ref-SCR::UR_U-SCR|UserScoreBaseScore bob pool score)])
                    (expect "<<TX-RERATE-WL>> ...and Alice's row for that nonce is gone"
                        0.0 (ref-AQP::UR_AQP|DPOFTrackerBalance pool zouro aqp-sc alice n))
                ]
            )
        )
    )
    ""
)
(env-sigs [])
(print "===^^^===")
(commit-tx)
(print "")
(print "=== END REPL/Stage_02/[6.2.17]_AQP-RERATE.repl ===")
