;;
;; REPL/Stage_02/[6.2.1]_AQP-ANK.repl — source layout mirrors console
;;   Inter-tx:   ;;|| NEXT >  (same three lines as REPL/Stage_01/[2.2]_Core.repl)
;;   Intra-tx:   ;;==== TXnnn · mm · <slug> ====  pairs with (print "--- [TXnnn · mm · …] ---") (mm = group within that begin-tx, 01..)
;;   format "{}": only from Talos C_* return, ref-ANK::UR_* return, expect/expect-failure doc, or (env-gas).
;;   REPL tests: (expect …) / (expect-failure …) return strings — collect in a list and (map print …) so every assertion line appears in the REPL; no nested format wrapping expect.
;;
(print "")
(print "================================================================")
(print "FILE  REPL/Stage_02/[6.2.1]_AQP-ANK.repl")
(print "================================================================")
(print "Legend (terminal observability):")
(print "  <<…>>     expect / expect-failure doc (format …) — REPL logs pass/fail")
(print "  <(TS02-C3.AQP-ANK|C_…)> => \"…\"   Talos client → AQP-ANK write (return value)")
(print "  <(AQP-ANK|UR_…|…)> => \"…\"       ref-ANK utility read (return value)")
(print "  <(REPL|env-gas)> …               gas after tx (env-gas)")
(print "")
(print "Source: ;;|| NEXT > between txs; ;;==== TXnnn · mm · … ==== before each REPL group banner (mm = intra-tx group).")
(print "REPL tests: (map print [(expect (format \"<<TX…>> …\" […]) expected actual) …]) — expect / expect-failure return strings; map print surfaces each line.")
(print "")
(print "===================Initialise AQP-ANK TX Block==========================")
(begin-tx "INIT TX 000 - Chain Data Time SetUp Definition")
(print "")
(print "=== TX000 INIT — chain / gas baseline =================================")
(namespace "ouronet-ns")
(env-chain-data
    {"prev-block-hash": "98c486052a5147fdd30fa43cc6d67e0a4e680c856c37f9157cb788cd67d58006",
     "block-time": TV.TIME00}
    )
;;==== TX000 · 01 · env gas model — REPL banner follows ============================
(print "--- [TX000 · 01 · env gas model] ---")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(print (format "<(REPL|env-gas)> after gas reset => \"{}\"" [(env-gas)]))
(commit-tx)
(print "")
(print "=== END TX000 ==========================================================")
(print "")
;;||>>>>>>>>>>>>>>>>>>>>>>>>>
;;|| NEXT                   >
;;||>>>>>>>>>>>>>>>>>>>>>>>>>
(print "")
(begin-tx "TX001 - AQP-ANK TrueFungible class/slot tests")
(print "")
(print "=== TX001 — AQP-ANK TrueFungible class/slot tests =======================")
(namespace "ouronet-ns")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
;;==== TX001 · 01 · env-sigs (patron only) — REPL banner follows ===================
(print "--- [TX001 · 01 · env-sigs (patron only)] ---")
(env-sigs
    [
        { "key": "PK_AncientHodler", "caps": [] }
    ]
)
(let
    (
        (patron:string KST.ANHD)
        (ouro-id:string "OURO-98c486052a51")
        (ref-DALOS:module{OuronetDalosV2} DALOS)
        (ref-TS02-C3:module{TalosStageTwo_ClientThreeV2} TS02-C3)
        (ref-ANK:module{AcquisitionAnchorsV2} AQP-ANK)
        (core-class-name:string "CoreBoostTFa")
        (core-class-id:string "CoreBoostTFa-98c486052a51")
        (split-stoa:[decimal]
            (ref-DALOS::URC_SplitSTOAPrices
                patron
                (* (ref-DALOS::UR_UsagePrice "standard") 20.0)
            )
        )
    )
    ;;==== TX001 · 02 · DALOS URC_SplitSTOAPrices ×20 — REPL banner follows ===========
    (print "--- [TX001 · 02 · DALOS fee split ×20] ---")
    (print (format "<(DALOS|URC_SplitSTOAPrices)> patron standard×20 => \"{}\"" [split-stoa]))
    ;;==== TX001 · 03 · env-sigs + coin caps for issuance — REPL banner follows ======
    (print "--- [TX001 · 03 · env-sigs + coin caps for issuance] ---")
    (env-sigs
        [
            { "key": "PK_AncientHodler", "caps": [] }
            { "key": "6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263",
              "caps":
                [
                    (coin.TRANSFER
                        "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263"
                        "k:50d6c59b21e5e6e55baecaa75a1007de37576bde12d8230dc82459cc01b9484b"
                        (at 2 split-stoa)
                    )
                    (coin.TRANSFER
                        "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263"
                        "k:0cb30c0121ff919266121a99ff9359871818932211df94dae4137c29bc0e8f7e"
                        (at 0 split-stoa)
                    )
                    (coin.TRANSFER
                        "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263"
                        "c:XM-pkmuB5XUQlp87ZYSbfKt8qzmHY6O2EHAzMRVBt3k"
                        (at 3 split-stoa)
                    )
                    (coin.TRANSFER
                        "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263"
                        "c:iQQFWj6gWtpGEzhM_O5ekW1QtnQQy55R8BRPGhj_0FU"
                        (at 1 split-stoa)
                    )
                ]
            }
        ]
    )
    ;;==== TX001 · 04 · Talos C_IssueTrueFungibleAnchor acnoi=true (first anchor creates BoostClass) + acnoi=false (rest) =
    (print "--- [TX001 · 04 · issue 7 TF anchors (acnoi=true for 1st creates BoostClass, acnoi=false for 2..7)] ---")
    (map print
        [
            (format "<(TS02-C3.C_AQP-ANK|IssueTrueFungibleAnchor TFAnchorAa acnoi=true CoreBoostTFa)> => \"{}\"" [(ref-TS02-C3::C_AQP-ANK|IssueTrueFungibleAnchor patron "TFAnchorAa" ouro-id true core-class-name 3 100.0 1000.0)])
            (format "<(TS02-C3.C_AQP-ANK|IssueTrueFungibleAnchor TFAnchorAb acnoi=false)> => \"{}\"" [(ref-TS02-C3::C_AQP-ANK|IssueTrueFungibleAnchor patron "TFAnchorAb" ouro-id false core-class-id 3 110.0 1100.0)])
            (format "<(TS02-C3.C_AQP-ANK|IssueTrueFungibleAnchor TFAnchorAc acnoi=false)> => \"{}\"" [(ref-TS02-C3::C_AQP-ANK|IssueTrueFungibleAnchor patron "TFAnchorAc" ouro-id false core-class-id 3 120.0 1200.0)])
            (format "<(TS02-C3.C_AQP-ANK|IssueTrueFungibleAnchor TFAnchorAd acnoi=false)> => \"{}\"" [(ref-TS02-C3::C_AQP-ANK|IssueTrueFungibleAnchor patron "TFAnchorAd" ouro-id false core-class-id 3 130.0 1300.0)])
            (format "<(TS02-C3.C_AQP-ANK|IssueTrueFungibleAnchor TFAnchorAe acnoi=false)> => \"{}\"" [(ref-TS02-C3::C_AQP-ANK|IssueTrueFungibleAnchor patron "TFAnchorAe" ouro-id false core-class-id 3 140.0 1400.0)])
            (format "<(TS02-C3.C_AQP-ANK|IssueTrueFungibleAnchor TFAnchorAf acnoi=false)> => \"{}\"" [(ref-TS02-C3::C_AQP-ANK|IssueTrueFungibleAnchor patron "TFAnchorAf" ouro-id false core-class-id 3 150.0 1500.0)])
            (format "<(TS02-C3.C_AQP-ANK|IssueTrueFungibleAnchor TFAnchorAg acnoi=false)> => \"{}\"" [(ref-TS02-C3::C_AQP-ANK|IssueTrueFungibleAnchor patron "TFAnchorAg" ouro-id false core-class-id 3 160.0 1600.0)])
        ]
    )
    ;;==== TX001 · 05 · expect-failure (8th anchor slot in BoostClass) — REPL =========
    (print "--- [TX001 · 05 · expect-failure: 8th slot in BoostClass] ---")
    (map print
        [
            (expect-failure
                (format "<<TX001 expect-failure>> BoostClass must reject 8th anchor slot: <(TS02-C3.C_AQP-ANK|IssueTrueFungibleAnchor TFAnchorfailslot)> (must fail)" [])
                (ref-TS02-C3::C_AQP-ANK|IssueTrueFungibleAnchor patron "TFAnchorfailslot" ouro-id false core-class-id 3 990.0 9900.0)
            )
        ]
    )
    ;;==== TX001 · 05b · M6 #15 anchor-definition bound guards (all must fail) — REPL ==
    ;; precision must be exactly 3; promile in [1, 10000] and conform to precision 3; dptf-amount in [1000, 1,000,000].
    ;; expect-failure rolls each back — no anchor/class is created. In-range acceptance is proven by TX001 · 04/06.
    (print "--- [TX001 · 05b · M6 #15: promile [1,10000] · precision 3 · dptf-amount [1000,1M]] ---")
    (map print
        [
            (expect-failure "<<TX001 M6#15>> promile > 10000 rejected"
                (ref-TS02-C3::C_AQP-ANK|IssueTrueFungibleAnchor patron "TFbadPromileHi" ouro-id true "M6HiClass" 3 10001.0 1000.0))
            (expect-failure "<<TX001 M6#15>> promile < 1 rejected"
                (ref-TS02-C3::C_AQP-ANK|IssueTrueFungibleAnchor patron "TFbadPromileLo" ouro-id true "M6LoClass" 3 0.999 1000.0))
            (expect-failure "<<TX001 M6#15>> promile not conform to precision 3 rejected"
                (ref-TS02-C3::C_AQP-ANK|IssueTrueFungibleAnchor patron "TFbadConf" ouro-id true "M6ConfClass" 3 100.0001 1000.0))
            (expect-failure "<<TX001 M6#15>> precision != 3 rejected"
                (ref-TS02-C3::C_AQP-ANK|IssueTrueFungibleAnchor patron "TFbadPrec" ouro-id true "M6PrecClass" 4 100.0 1000.0))
            (expect-failure "<<TX001 M6#15>> dptf-amount < 1000 rejected"
                (ref-TS02-C3::C_AQP-ANK|IssueTrueFungibleAnchor patron "TFbadAmtLo" ouro-id true "M6AmtLoClass" 3 100.0 999.0))
            (expect-failure "<<TX001 M6#15>> dptf-amount > 1,000,000 rejected"
                (ref-TS02-C3::C_AQP-ANK|IssueTrueFungibleAnchor patron "TFbadAmtHi" ouro-id true "M6AmtHiClass" 3 100.0 1000001.0))
        ]
    )
    ;;==== TX001 · 06 · Talos C_IssueTrueFungibleAnchor acnoi=true (6 more classes, 1 anchor each) =
    (print "--- [TX001 · 06 · issue 6 more TF anchors (acnoi=true each creates its own BoostClass)] ---")
    (map print
        [
            (format "<(TS02-C3.C_AQP-ANK|IssueTrueFungibleAnchor TFclassBa acnoi=true CoreBoostTFb)> => \"{}\"" [(ref-TS02-C3::C_AQP-ANK|IssueTrueFungibleAnchor patron "TFclassBa" ouro-id true "CoreBoostTFb" 3 100.0 1000.0)])
            (format "<(TS02-C3.C_AQP-ANK|IssueTrueFungibleAnchor TFclassCa acnoi=true CoreBoostTFc)> => \"{}\"" [(ref-TS02-C3::C_AQP-ANK|IssueTrueFungibleAnchor patron "TFclassCa" ouro-id true "CoreBoostTFc" 3 220.0 2200.0)])
            (format "<(TS02-C3.C_AQP-ANK|IssueTrueFungibleAnchor TFclassDa acnoi=true CoreBoostTFd)> => \"{}\"" [(ref-TS02-C3::C_AQP-ANK|IssueTrueFungibleAnchor patron "TFclassDa" ouro-id true "CoreBoostTFd" 3 230.0 2300.0)])
            (format "<(TS02-C3.C_AQP-ANK|IssueTrueFungibleAnchor TFclassEa acnoi=true CoreBoostTFe)> => \"{}\"" [(ref-TS02-C3::C_AQP-ANK|IssueTrueFungibleAnchor patron "TFclassEa" ouro-id true "CoreBoostTFe" 3 240.0 2400.0)])
            (format "<(TS02-C3.C_AQP-ANK|IssueTrueFungibleAnchor TFclassFa acnoi=true CoreBoostTFf)> => \"{}\"" [(ref-TS02-C3::C_AQP-ANK|IssueTrueFungibleAnchor patron "TFclassFa" ouro-id true "CoreBoostTFf" 3 250.0 2500.0)])
            (format "<(TS02-C3.C_AQP-ANK|IssueTrueFungibleAnchor TFclassGa acnoi=true CoreBoostTFg)> => \"{}\"" [(ref-TS02-C3::C_AQP-ANK|IssueTrueFungibleAnchor patron "TFclassGa" ouro-id true "CoreBoostTFg" 3 260.0 2600.0)])
        ]
    )
    ;;==== TX001 · 07 · ref-ANK UR_BC|Data / UR_AA|Data / UR_ANK|Data — REPL =========
    (print "--- [TX001 · 07 · UR reads (BoostClass / AssetAnchors / single anchor)] ---")
    (map print
        [
            (format "<(AQP-ANK|UR_BC|Data CoreBoostTFa)> => \"{}\"" [(ref-ANK::UR_BC|Data core-class-id)])
            (format "<(AQP-ANK|UR_AA|Data OURO)> => \"{}\"" [(ref-ANK::UR_AA|Data ouro-id)])
            (format "<(AQP-ANK|UR_ANK|Data TFAnchorAa-98c486052a51)> => \"{}\"" [(ref-ANK::UR_ANK|Data "TFAnchorAa-98c486052a51")])
        ]
    )
)
(print (format "<(REPL|env-gas)> TX001 after commit => \"{}\"" [(env-gas)]))
(commit-tx)
(print "")
(print "=== END TX001 ==========================================================")
(print "")
;;||>>>>>>>>>>>>>>>>>>>>>>>>>
;;|| NEXT                   >
