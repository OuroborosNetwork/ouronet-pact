(begin-tx "TX002 - AQP-ANK TF class-cap and class revoke tests")
(print "")
(print "=== TX002 — TF class-cap and class revoke ===============================")
(namespace "ouronet-ns")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
;;==== TX002 · 01 · env-sigs (patron only) — REPL banner follows ===================
(print "--- [TX002 · 01 · env-sigs (patron only)] ---")
(env-sigs
    [
        { "key": "PK_AncientHodler", "caps": [] }
    ]
)
(let
    (
        (patron:string KST.ANHD)
        (ouro-id:string "OURO-98c486052a51")
        (ref-DALOS:module{OuronetDalosV2} DALOS)
        (ref-TS02-C3:module{TalosStageTwo_ClientThreeV2} TS02-C3)
        (ref-ANK:module{AcquisitionAnchorsV2} AQP-ANK)
        (temp-class-name:string "TempClassTF")
        (temp-class-id:string "TempClassTF-98c486052a51")
        (class07-id:string "CoreBoostTFg-98c486052a51")
        (split-stoa:[decimal]
            (ref-DALOS::URC_SplitSTOAPrices
                patron
                (* (ref-DALOS::UR_UsagePrice "standard") 2.0)
            )
        )
    )
    ;;==== TX002 · 02 · DALOS URC_SplitSTOAPrices ×2 — REPL banner follows ============
    (print "--- [TX002 · 02 · DALOS fee split ×2] ---")
    (print (format "<(DALOS|URC_SplitSTOAPrices)> patron standard×2 => \"{}\"" [split-stoa]))
    ;;==== TX002 · 03 · env-sigs + coin caps — REPL banner follows ====================
    (print "--- [TX002 · 03 · env-sigs + coin caps] ---")
    (env-sigs
        [
            { "key": "PK_AncientHodler", "caps": [] }
            { "key": "6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263",
              "caps":
                [
                    (coin.TRANSFER
                        "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263"
                        "k:50d6c59b21e5e6e55baecaa75a1007de37576bde12d8230dc82459cc01b9484b"
                        (at 2 split-stoa)
                    )
                    (coin.TRANSFER
                        "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263"
                        "k:0cb30c0121ff919266121a99ff9359871818932211df94dae4137c29bc0e8f7e"
                        (at 0 split-stoa)
                    )
                    (coin.TRANSFER
                        "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263"
                        "c:XM-pkmuB5XUQlp87ZYSbfKt8qzmHY6O2EHAzMRVBt3k"
                        (at 3 split-stoa)
                    )
                    (coin.TRANSFER
                        "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263"
                        "c:iQQFWj6gWtpGEzhM_O5ekW1QtnQQy55R8BRPGhj_0FU"
                        (at 1 split-stoa)
                    )
                ]
            }
        ]
    )
    ;;==== TX002 · 04 · Talos revoke / issue (temp anchor acnoi=true creates BoostClass inline) — REPL ============
    (print "--- [TX002 · 04 · revoke last TF in class-7 + revoke BoostClass-7 + issue temp anchor (acnoi=true)] ---")
    (map print
        [
            (format "<(TS02-C3.C_AQP-ANK|RevokeAnchor TFclassGa-98c486052a51)> => \"{}\"" [(ref-TS02-C3::C_AQP-ANK|RevokeAnchor patron "TFclassGa-98c486052a51")])
            (format "<(TS02-C3.C_AQP-ANK|RevokeBoostClass CoreBoostTFg)> => \"{}\"" [(ref-TS02-C3::C_AQP-ANK|RevokeBoostClass patron class07-id)])
            (format "<(TS02-C3.C_AQP-ANK|IssueTrueFungibleAnchor TFTEMPaa acnoi=true TempClassTF)> => \"{}\"" [(ref-TS02-C3::C_AQP-ANK|IssueTrueFungibleAnchor patron "TFTEMPaa" ouro-id true temp-class-name 3 400.0 4000.0)])
        ]
    )
    ;;==== TX002 · 05 · expect-failure (revoke non-empty BoostClass) — REPL ===========
    (print "--- [TX002 · 05 · expect-failure: revoke non-empty BoostClass] ---")
    (map print
        [
            (expect-failure
                (format "<<TX002 expect-failure>> Cannot revoke non-empty BoostClass: <(TS02-C3.C_AQP-ANK|RevokeBoostClass TempClassTF)> (must fail)" [])
                (ref-TS02-C3::C_AQP-ANK|RevokeBoostClass patron temp-class-id)
            )
        ]
    )
    ;;==== TX002 · 06 · Talos clear temp anchor + revoke BoostClass — REPL ============
    (print "--- [TX002 · 06 · clear temp anchor then revoke temp BoostClass] ---")
    (map print
        [
            (format "<(TS02-C3.C_AQP-ANK|RevokeAnchor TFTEMPaa-98c486052a51)> => \"{}\"" [(ref-TS02-C3::C_AQP-ANK|RevokeAnchor patron "TFTEMPaa-98c486052a51")])
            (format "<(TS02-C3.C_AQP-ANK|RevokeBoostClass TempClassTF)> => \"{}\"" [(ref-TS02-C3::C_AQP-ANK|RevokeBoostClass patron temp-class-id)])
        ]
    )
    ;;==== TX002 · 06b · L4 #17: double-revoke of a now-dead anchor must fail (UEV_LiveAnchor) =
    (print "--- [TX002 · 06b · L4 #17: re-revoking the dead TFTEMPaa anchor must fail] ---")
    (map print
        [
            (expect-failure
                "<<TX002 L4#17>> re-revoking an already-revoked anchor is rejected up front (anchor must be alive)"
                (ref-TS02-C3::C_AQP-ANK|RevokeAnchor patron "TFTEMPaa-98c486052a51"))
        ]
    )
    ;;==== TX002 · 07 · ref-ANK UR_AA|Data / UR_ANK|Data — REPL =======================
    (print "--- [TX002 · 07 · UR reads] ---")
    (map print
        [
            (format "<(AQP-ANK|UR_AA|Data OURO)> => \"{}\"" [(ref-ANK::UR_AA|Data ouro-id)])
            (format "<(AQP-ANK|UR_ANK|Data TFTEMPaa-98c486052a51)> => \"{}\"" [(ref-ANK::UR_ANK|Data "TFTEMPaa-98c486052a51")])
        ]
    )
)
(print (format "<(REPL|env-gas)> TX002 after commit => \"{}\"" [(env-gas)]))
(commit-tx)
(print "")
(print "=== END TX002 ==========================================================")
(print "")
