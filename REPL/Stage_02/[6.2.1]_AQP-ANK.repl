;; TX004: After OURO/DHCD usage in TX001–TX002, strip every live TF anchor on OURO and SF anchor on DHCD, then
;; revoke every associated BoostClass so both assets are bare. KBN NF (Bunnies) anchors stay for [6.2.2]+ repls.
(print "")
(begin-tx "TX004 - Strip OURO TF and DHCD SF anchors and BoostClasses (KBN NF retained)")
(print "")
(print "=== TX004 — Strip OURO/DHCD (KBN NF retained) ===========================")
(namespace "ouronet-ns")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
;;==== TX004 · 01 · env-sigs — REPL banner follows ==================================
(print "--- [TX004 · 01 · env-sigs] ---")
(env-sigs [{ "key": "PK_AncientHodler", "caps": [] }])
(let
    (
        (patron:string KST.ANHD)
        (ouro-id:string "OURO-98c486052a51")
        (ouro-owner:string (AQP-ANK.URC_AnchorableAssetOwner ouro-id [true true]))
        (dhcd-id:string "DHCD-98c486052a51")
        (kbn-id:string "KBN-98c486052a51")
        (ref-TS02-C3:module{TalosStageTwo_ClientThreeV1} TS02-C3)
        (ref-ANK:module{AcquisitionAnchorsV1} AQP-ANK)
        (tf-ids:[string] (ref-ANK::UR_ANK|AnchorsForAsset ouro-id))
        (sf-ids:[string] (ref-ANK::UR_ANK|AnchorsForAsset dhcd-id))
    )
    ;;==== TX004 · 02 · ref-ANK UR_ANK|AnchorsForAsset (sweep 1) — REPL ==============
    (print "--- [TX004 · 02 · UR: anchor id lists (sweep 1)] ---")
    (map print
        [
            (format "<(AQP-ANK|UR_ANK|AnchorsForAsset OURO)> => \"{}\"" [tf-ids])
            (format "<(AQP-ANK|UR_ANK|AnchorsForAsset DHCD)> => \"{}\"" [sf-ids])
        ]
    )
    ;;==== TX004 · 03 · Talos C_RevokeAnchor (sweep 1 OURO/DHCD) — REPL ==============
    (print "--- [TX004 · 03 · revoke all TF/SF anchors (sweep 1)] ---")
    (map print (map (lambda (id:string) (format "<(TS02-C3.AQP-ANK|C_RevokeAnchor)> OURO id={} => \"{}\"" [id (ref-TS02-C3::AQP-ANK|C_RevokeAnchor patron id)])) tf-ids))
    (map print (map (lambda (id:string) (format "<(TS02-C3.AQP-ANK|C_RevokeAnchor)> DHCD id={} => \"{}\"" [id (ref-TS02-C3::AQP-ANK|C_RevokeAnchor patron id)])) sf-ids))
    (let
        (
            (ouro-bcids:[string]
                (fold
                    (lambda (acc:[string] aid:string)
                        (let ((bcid:string (ref-ANK::UR_ANK|BoostClassId aid)))
                            (if (or (= bcid AQP-ANK.BAR) (contains bcid acc)) acc (+ acc [bcid]))
                        )
                    )
                    []
                    tf-ids
                )
            )
            (dhcd-bcids:[string]
                (fold
                    (lambda (acc:[string] aid:string)
                        (let ((bcid:string (ref-ANK::UR_ANK|BoostClassId aid)))
                            (if (or (= bcid AQP-ANK.BAR) (contains bcid acc)) acc (+ acc [bcid]))
                        )
                    )
                    []
                    sf-ids
                )
            )
        )
        ;;==== TX004 · 04 · BoostClass IDs derived from anchors — REPL ==================
        (print "--- [TX004 · 04 · echo BoostClass-id lists to revoke] ---")
        (map print
            [
                (format "<(AQP-ANK|UR derived OURO non-BAR BoostClass-ids)> => \"{}\"" [ouro-bcids])
                (format "<(AQP-ANK|UR derived DHCD non-BAR BoostClass-ids)> => \"{}\"" [dhcd-bcids])
            ]
        )
        ;;==== TX004 · 05 · Talos C_RevokeBoostClass (OURO/DHCD) — REPL ================
        (print "--- [TX004 · 05 · revoke non-BAR BoostClasses] ---")
        (map print (map (lambda (bcid:string) (format "<(TS02-C3.AQP-ANK|C_RevokeBoostClass)> OURO bcid={} => \"{}\"" [bcid (ref-TS02-C3::AQP-ANK|C_RevokeBoostClass patron bcid)])) ouro-bcids))
        (map print (map (lambda (bcid:string) (format "<(TS02-C3.AQP-ANK|C_RevokeBoostClass)> DHCD bcid={} => \"{}\"" [bcid (ref-TS02-C3::AQP-ANK|C_RevokeBoostClass patron bcid)])) dhcd-bcids))
    )
    ;;==== TX004 · 06 · UR sweep-2 + Talos C_RevokeAnchor stragglers — REPL ===========
    (print "--- [TX004 · 06 · UR re-query + revoke stragglers (sweep 2)] ---")
    (let
        (
            (tf2:[string] (ref-ANK::UR_ANK|AnchorsForAsset ouro-id))
            (sf2:[string] (ref-ANK::UR_ANK|AnchorsForAsset dhcd-id))
        )
        (map print [(format "<(AQP-ANK|UR_ANK|AnchorsForAsset OURO sweep-2)> => \"{}\"" [tf2]) (format "<(AQP-ANK|UR_ANK|AnchorsForAsset DHCD sweep-2)> => \"{}\"" [sf2])])
        (map print (map (lambda (id:string) (format "<(TS02-C3.AQP-ANK|C_RevokeAnchor)> OURO sweep-2 id={} => \"{}\"" [id (ref-TS02-C3::AQP-ANK|C_RevokeAnchor patron id)])) tf2))
        (map print (map (lambda (id:string) (format "<(TS02-C3.AQP-ANK|C_RevokeAnchor)> DHCD sweep-2 id={} => \"{}\"" [id (ref-TS02-C3::AQP-ANK|C_RevokeAnchor patron id)])) sf2))
    )
    ;;==== TX004 · 07 · expect (strip invariants) — REPL ==============================
    (print "--- [TX004 · 07 · expect: OURO/DHCD bare; KBN NF still live] ---")
    (let
        (
            (n-ouro:integer (ref-ANK::UR_AA|AnchorsActive ouro-id))
            (n-dhcd:integer (ref-ANK::UR_AA|AnchorsActive dhcd-id))
            (g-ouro:integer (ref-ANK::UR_AA|GroupsActive ouro-id))
            (g-dhcd:integer (ref-ANK::UR_AA|GroupsActive dhcd-id))
            (n-kbn-nf:integer (length (ref-ANK::UR_ANK|AnchorsForAsset kbn-id)))
        )
        (map print
            [
                (expect (format "<<TX004 expect>> <(AQP-ANK|UR_AA|AnchorsActive OURO)> anchors: actual={} expected=0" [n-ouro]) 0 n-ouro)
                (expect (format "<<TX004 expect>> <(AQP-ANK|UR_AA|AnchorsActive DHCD)> anchors: actual={} expected=0" [n-dhcd]) 0 n-dhcd)
                (expect (format "<<TX004 expect>> <(AQP-ANK|UR_AA|GroupsActive OURO)> groups: actual={} expected=0" [g-ouro]) 0 g-ouro)
                (expect (format "<<TX004 expect>> <(AQP-ANK|UR_AA|GroupsActive DHCD)> groups: actual={} expected=0" [g-dhcd]) 0 g-dhcd)
                (expect (format "<<TX004 expect>> <(AQP-ANK|UR_ANK|AnchorsForAsset KBN)> nf-live-count: actual={} expected=0 (AQP-FAST; FULL chain expects >0 after PopulateBunnies)" [n-kbn-nf]) 0 n-kbn-nf)
            ]
        )
    )
)
(print (format "<(REPL|env-gas)> TX004 after commit => \"{}\"" [(env-gas)]))
(env-sigs [])
(commit-tx)
(print "")
(print "=== END TX004 ==========================================================")
