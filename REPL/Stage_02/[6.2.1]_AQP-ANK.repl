(begin-tx "TX002 - AQP-ANK TF class-cap and class revoke tests")
(namespace "ouronet-ns")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(env-sigs
    [
        { "key": "PK_AncientHodler", "caps": [] }
    ]
)
(let
    (
        (patron:string KST.ANHD)
        (ouro-id:string "OURO-98c486052a51")
        (ref-DALOS:module{OuronetDalosV1} DALOS)
        (ref-TS02-C3:module{TalosStageTwo_ClientThreeV1} TS02-C3)
        (ref-ANK:module{AcquisitionAnchorsV1} AQP-ANK)
        (temp-class-name:string "TempClassTF")
        (temp-class-id:string "TempClassTF-98c486052a51")
        (class07-id:string "CoreBoostTFg-98c486052a51")
        (split-kda:[decimal]
            (ref-DALOS::URC_SplitKDAPrices
                patron
                (* (ref-DALOS::UR_UsagePrice "standard") 4.0)
            )
        )
    )
    (env-sigs
        [
            { "key": "PK_AncientHodler", "caps": [] }
            { "key": "6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263",
              "caps":
                [
                    (coin.TRANSFER
                        "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263"
                        "k:50d6c59b21e5e6e55baecaa75a1007de37576bde12d8230dc82459cc01b9484b"
                        (at 2 split-kda)
                    )
                    (coin.TRANSFER
                        "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263"
                        "k:0cb30c0121ff919266121a99ff9359871818932211df94dae4137c29bc0e8f7e"
                        (at 0 split-kda)
                    )
                    (coin.TRANSFER
                        "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263"
                        "c:XM-pkmuB5XUQlp87ZYSbfKt8qzmHY6O2EHAzMRVBt3k"
                        (at 3 split-kda)
                    )
                    (coin.TRANSFER
                        "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263"
                        "c:iQQFWj6gWtpGEzhM_O5ekW1QtnQQy55R8BRPGhj_0FU"
                        (at 1 split-kda)
                    )
                ]
            }
        ]
    )
    [
        [
            (ref-TS02-C3::AQP-ANK|C_RevokeAnchor patron "TFclassGa-98c486052a51")
            (ref-TS02-C3::AQP-ANK|C_RevokeAnchorClass patron ouro-id [true true] class07-id)
            (ref-TS02-C3::AQP-ANK|C_IssueTrueFungibleAnchor patron "TFTEMPaa" ouro-id true temp-class-name 8 40.0 400.0)
            (expect-failure
                "Cannot revoke non-empty class"
                (ref-TS02-C3::AQP-ANK|C_RevokeAnchorClass patron ouro-id [true true] temp-class-id)
            )
            (ref-TS02-C3::AQP-ANK|C_RevokeAnchor patron "TFTEMPaa-98c486052a51")
            (ref-TS02-C3::AQP-ANK|C_RevokeAnchorClass patron ouro-id [true true] temp-class-id)
        ]
        [
            (ref-ANK::UR_ANK-CLASSES|Data ouro-id [true true])
            (ref-ANK::UR_ANK|Data "TFTEMPaa-98c486052a51")
        ]
    ]
)
(format "<<<<<<<TX002 - AQP-ANK TF class-cap/revoke tests costs {} GAS>>>>>>>" [(env-gas)])
(commit-tx)
