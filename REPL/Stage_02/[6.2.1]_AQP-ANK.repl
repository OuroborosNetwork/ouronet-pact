(begin-tx "TX003 - TF user promile refresh (UPDATE-DPTF cap chain / SECURE compose)")
(print "")
(print "=== TX003 — XE_Update* cap chain (XI_1|Update + nested XI_2|Recompute) =========")
(namespace "ouronet-ns")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
;;==== TX003 · 01 · env-sigs — REPL banner follows ==================================
(print "--- [TX003 · 01 · env-sigs] ---")
(env-sigs [{ "key": "PK_AncientHodler", "caps": [] }])
(let
    (
        (beneficiary:string KST.ANHD)
        (ouro-id:string "OURO-98c486052a51")
        (total-dptf:decimal 500.0)
        (anchor-id:string "TFclassBa-98c486052a51")
        (bc-id:string "CoreBoostTFb-98c486052a51")
        (ref-ANK:module{AcquisitionAnchorsV2} AQP-ANK)
        (n-live:integer (length (ref-ANK::UR_ANK|AnchorsForAsset ouro-id)))
        (expected-promile:decimal 50.0)
    )
    ;;==== TX003 · 02 · pre-check live anchor count — REPL =============================
    (print "--- [TX003 · 02 · pre-check live TF anchors on OURO] ---")
    (print (format "<(AQP-ANK|UR_ANK|AnchorsForAsset OURO)> n_live => \"{}\"" [n-live]))
    (expect (format "<<TX003 expect>> n_live > 0 after TX001 (before TX004 strip)" []) true (> n-live 0))
    ;;==== TX003 · 03 · with-capability UPDATE-DPTF → XI_Update (no inner with-capability SECURE) =
    (print "--- [TX003 · 03 · UPDATE-DPTF envelope → XI_1|UpdateTrueFungibleUserAnchorValues] ---")
    (acquire-module-admin AQP-ANK)
    (with-capability (AQP-ANK.ANK|C>UPDATE-DPTF beneficiary ouro-id total-dptf)
        (AQP-ANK.XI_1|UpdateTrueFungibleUserAnchorValues beneficiary ouro-id total-dptf)
    )
    (let
        (
            (promile:decimal (ref-ANK::UR_ANK-U|Promile beneficiary anchor-id))
            (agg:decimal (ref-ANK::UR_UB|AggregatePromile beneficiary bc-id))
        )
        ;;==== TX003 · 04 · expect promile + UserBoost after XI_Update — REPL =============
        (print "--- [TX003 · 04 · expect promile writes (500/1000×100 = 50 on TFclassBa; solo BoostClass)] ---")
        (map print
            [
                (expect (format "<<TX003 expect>> <(AQP-ANK|UR_ANK-U|Promile TFclassBa)> actual={} expected={}" [promile expected-promile]) expected-promile promile)
                (expect (format "<<TX003 expect>> <(AQP-ANK|UR_UB|AggregatePromile CoreBoostTFb)> actual={} expected={}" [agg expected-promile]) expected-promile agg)
            ]
        )
    )
    ;;==== TX003 · 05 · nested XI_2|Recompute under same cap pattern (no extra with-capability SECURE) =
    (print "--- [TX003 · 05 · UPDATE-DPTF envelope → XI_2|RecomputeAffectedBoostAggregates alone] ---")
    (with-capability (AQP-ANK.ANK|C>UPDATE-DPTF beneficiary ouro-id total-dptf)
        (AQP-ANK.XI_2|RecomputeAffectedBoostAggregates beneficiary [bc-id])
    )
    (expect
        (format "<<TX003 expect>> nested XI_2|Recompute under UPDATE-DPTF still reads aggregate {}" [expected-promile])
        expected-promile
        (ref-ANK::UR_UB|AggregatePromile beneficiary bc-id)
    )
    ;;==== TX003 · 06 · expect-failure: direct XI without cap — REPL =====================
    (print "--- [TX003 · 06 · expect-failure: XI_Update without UPDATE-DPTF/SECURE] ---")
    (map print
        [
            (expect-failure
                (format "<<TX003 expect-failure>> XI_Update without cap (must fail on require SECURE)" [])
                (AQP-ANK.XI_1|UpdateTrueFungibleUserAnchorValues beneficiary ouro-id total-dptf)
            )
            (expect-failure
                (format "<<TX003 expect-failure>> XI_2|Recompute without cap (must fail on require SECURE)" [])
                (AQP-ANK.XI_2|RecomputeAffectedBoostAggregates beneficiary [bc-id])
            )
        ]
    )
)
(print (format "<(REPL|env-gas)> TX003 after commit => \"{}\"" [(env-gas)]))
(commit-tx)
(print "")
(print "=== END TX003 ==========================================================")
(print "")
