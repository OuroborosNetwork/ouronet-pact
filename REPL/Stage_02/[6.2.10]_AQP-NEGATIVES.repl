;;
;; REPL/Stage_02/[6.2.10]_AQP-NEGATIVES.repl — AQP negative-path coverage (Track C).
;; IMC boundary: the ONLY supported client path is Talos. Every sovereign-core C_/CC_/X entrypoint
;; opens with UEV_IMC, so a DIRECT ref-CORE::fn call (bypassing the TS02-C3 shell) must fail — even
;; when made by the pool/asset OWNER (so the owner gate passes and UEV_IMC is the isolated cause).
;; Loaded by REPL/Stage_02/[6.2]_AQP.repl after [6.2.5]. Assumes the [6.2.1-5] entities exist.
;;
(print "")
(print "================================================================")
(print "FILE  REPL/Stage_02/[6.2.10]_AQP-NEGATIVES.repl")
(print "================================================================")
(print "Legend: <<TX-AQP-NEG-*>> expect-failure lines — direct core calls must be rejected.")
(print "")
;;
(begin-tx "TX-AQP-NEG-IMC1 - VCT/FVT/MTX core calls bypassing Talos must fail UEV_IMC")
(print "")
(print "=== TX-AQP-NEG-IMC1 — direct AQP-VCT / AQP-FVT / MTX-AQP calls rejected (Talos only) ==")
(namespace "ouronet-ns")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
;; ANHD is the OWNER of these entities — owner gate passes, so the ONLY thing that rejects is UEV_IMC.
(env-sigs [{ "key": "PK_AncientHodler", "caps": [] }])
(let
    (
        (patron:string KST.ANHD)
        (ouro-id:string "OURO-98c486052a51")
        (ref-U|DALOS:module{UtilityDalosV1} U|DALOS)
        (ref-VCT:module{AcquisitionVacateV1} AQP-VCT)
        (ref-FVT:module{AcquisitionFarmsVaultsTreasuriesV1} AQP-FVT)
        (ref-MTX:module{AqpMtxV1} MTX-AQP)
        (pool-id:string (ref-U|DALOS::UDC_Makeid "TfStakePool"))
        (fvt-id:string (ref-U|DALOS::UDC_Makeid "TfStakeVault"))
        (anchor-id:string (ref-U|DALOS::UDC_Makeid "AurynRain"))
    )
    (map print
        [
            (expect-failure
                (format "<<TX-AQP-NEG-IMC1>> direct AQP-VCT::CC_FullVacate rejected (UEV_IMC — Talos only)" [])
                (ref-VCT::CC_FullVacate pool-id))
            (expect-failure
                (format "<<TX-AQP-NEG-IMC1>> direct AQP-VCT::C_AbortVacate rejected (UEV_IMC)" [])
                (ref-VCT::C_AbortVacate pool-id))
            (expect-failure
                (format "<<TX-AQP-NEG-IMC1>> direct AQP-FVT::CC_Inject rejected (UEV_IMC)" [])
                (ref-FVT::CC_Inject patron fvt-id ouro-id 1.0))
            (expect-failure
                (format "<<TX-AQP-NEG-IMC1>> direct AQP-FVT::CC_SweepRevokeAnchor rejected (UEV_IMC)" [])
                (ref-FVT::CC_SweepRevokeAnchor patron anchor-id))
            (expect-failure
                (format "<<TX-AQP-NEG-IMC1>> direct MTX-AQP::C_2|Inject rejected (UEV_IMC)" [])
                (ref-MTX::C_2|Inject patron fvt-id ouro-id 1.0))
        ]
    )
)
(env-sigs [])
(commit-tx)
(print "=== END TX-AQP-NEG-IMC1 =====================================================")
(print "")
;;||>>>>>>>>>>>>>>>>>>>>>>>>>
;;|| NEXT                   >
;;||>>>>>>>>>>>>>>>>>>>>>>>>>
(print "")
;;
(begin-tx "TX-AQP-NEG-IMC2 - ANK/SCORE/POOL core calls bypassing Talos must fail UEV_IMC")
(print "")
(print "=== TX-AQP-NEG-IMC2 — direct AQP-ANK / AQP-SCR / AQP-POOL calls rejected (Talos only) ==")
(namespace "ouronet-ns")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
;; ANHD owns these entities — owner gate passes, so UEV_IMC is the isolated rejection cause.
(env-sigs [{ "key": "PK_AncientHodler", "caps": [] }])
(let
    (
        (patron:string KST.ANHD)
        (ouro-id:string "OURO-98c486052a51")
        (ref-U|DALOS:module{UtilityDalosV1} U|DALOS)
        (ref-ANK:module{AcquisitionAnchorsV1} AQP-ANK)
        (ref-SCR:module{AcquisitionScoresV1} AQP-SCORE)
        (ref-AQP:module{AcquisitionPoolsV1} AQP-POOL)
        (anchor-id:string (ref-U|DALOS::UDC_Makeid "AurynRain"))
        (score-id:string (ref-U|DALOS::UDC_Makeid "TfStakeScore"))
        (pool-id:string (ref-U|DALOS::UDC_Makeid "TfStakePool"))
    )
    (map print
        [
            (expect-failure
                (format "<<TX-AQP-NEG-IMC2>> direct AQP-ANK::C_RevokeAnchor rejected (UEV_IMC — Talos only)" [])
                (ref-ANK::C_RevokeAnchor anchor-id))
            (expect-failure
                (format "<<TX-AQP-NEG-IMC2>> direct AQP-SCR::C_EnableDebBoost rejected (UEV_IMC)" [])
                (ref-SCR::C_EnableDebBoost score-id))
            (expect-failure
                (format "<<TX-AQP-NEG-IMC2>> direct AQP-POOL::C_DisablePoolStake rejected (UEV_IMC)" [])
                (ref-AQP::C_DisablePoolStake patron pool-id))
            (expect-failure
                (format "<<TX-AQP-NEG-IMC2>> direct AQP-POOL::C_Issue rejected (UEV_IMC)" [])
                (ref-AQP::C_Issue patron "NegProbePool" ouro-id 1))
        ]
    )
)
(env-sigs [])
(commit-tx)
(print "=== END TX-AQP-NEG-IMC2 =====================================================")
(print "")
;;||>>>>>>>>>>>>>>>>>>>>>>>>>
;;|| NEXT                   >
;;||>>>>>>>>>>>>>>>>>>>>>>>>>
(print "")
;;
(begin-tx "TX-AQP-NEG-STATE - stake into a stake-DISABLED pool must fail")
(print "")
(print "=== TX-AQP-NEG-STATE — C_StakeTrueFungible into a disabled pool rejected =====")
(namespace "ouronet-ns")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(env-sigs [{ "key": "PK_AncientHodler", "caps": [] }])
(let
    (
        (patron:string KST.ANHD)
        (owner-id:string KST.ANHD)
        (beneficiary-id:string KST.ANHD)
        (ouro-id:string "OURO-98c486052a51")
        ;; ResumeVacPool ends [6.2.5] fully vacated → auto-finalized → stake RE-ENABLED and NOT
        ;; vacate-in-progress, so it is a genuinely clean owned pool: disable does real work and the
        ;; cleanup re-enable is unblocked (TfStakePool is left vacate-in-progress by the VCT suite).
        (pool-name:string "ResumeVacPool")
        (ref-U|DALOS:module{UtilityDalosV1} U|DALOS)
        (ref-TS02-C3:module{TalosStageTwo_ClientThreeV1} TS02-C3)
        (ref-AQP:module{AcquisitionPoolsV1} AQP-POOL)
        (pool-id:string (ref-U|DALOS::UDC_Makeid pool-name))
    )
    (ref-TS02-C3::AQP-POOL|C_DisablePoolStake patron pool-id)
    (map print
        [
            (expect (format "<<TX-AQP-NEG-STATE>> pool now stake-disabled got={}" [(ref-AQP::UR_AQP|PoolStakeEnabled pool-id)]) false (ref-AQP::UR_AQP|PoolStakeEnabled pool-id))
            (expect-failure
                (format "<<TX-AQP-NEG-STATE>> stake into a DISABLED pool rejected (URC_PoolStakeAdmissionOk)" [])
                (ref-TS02-C3::AQP-POOL|C_StakeTrueFungible patron pool-id owner-id beneficiary-id ouro-id 10.0))
        ]
    )
)
(env-sigs [])
(commit-tx)
(print "=== END TX-AQP-NEG-STATE ====================================================")
(print "")
;;||>>>>>>>>>>>>>>>>>>>>>>>>>
;;|| NEXT                   >
;;||>>>>>>>>>>>>>>>>>>>>>>>>>
(print "")
;;
;; cleanup: re-enable ResumeVacPool in its OWN tx (one IGNIS-collecting client op per tx)
(begin-tx "TX-AQP-NEG-STATE-cleanup - re-enable ResumeVacPool (leave as found)")
(namespace "ouronet-ns")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(env-sigs [{ "key": "PK_AncientHodler", "caps": [] }])
(let
    (
        (patron:string KST.ANHD)
        (ref-U|DALOS:module{UtilityDalosV1} U|DALOS)
        (ref-TS02-C3:module{TalosStageTwo_ClientThreeV1} TS02-C3)
        (pool-id:string (ref-U|DALOS::UDC_Makeid "ResumeVacPool"))
    )
    (ref-TS02-C3::AQP-POOL|C_EnablePoolStake patron pool-id)
)
(env-sigs [])
(commit-tx)
(print "")
;;||>>>>>>>>>>>>>>>>>>>>>>>>>
;;|| NEXT                   >
;;||>>>>>>>>>>>>>>>>>>>>>>>>>
(print "")
;;
(begin-tx "TX-AQP-NEG-OWNER - non-owner pool-config ops must fail (owner gate)")
(print "")
(print "=== TX-AQP-NEG-OWNER — non-owner C_DisablePoolStake / C_AddScore / C_RevokeScore rejected ==")
(namespace "ouronet-ns")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
;; EMMA signs — NOT the TfStakePool owner (ANHD). All three are pool-owner-gated (CAP_PoolOwner defun).
(env-sigs [{ "key": "PK_Emma", "caps": [] }])
(let
    (
        (foreign:string KST.EMMA)
        (pool-name:string "TfStakePool")
        (score-name:string "TfStakeScore")
        (ref-U|DALOS:module{UtilityDalosV1} U|DALOS)
        (ref-TS02-C3:module{TalosStageTwo_ClientThreeV1} TS02-C3)
        (pool-id:string (ref-U|DALOS::UDC_Makeid pool-name))
        (score-id:string (ref-U|DALOS::UDC_Makeid score-name))
    )
    (map print
        [
            (expect-failure
                (format "<<TX-AQP-NEG-OWNER>> non-owner C_DisablePoolStake rejected (pool-owner gate)" [])
                (ref-TS02-C3::AQP-POOL|C_DisablePoolStake foreign pool-id))
            (expect-failure
                (format "<<TX-AQP-NEG-OWNER>> non-owner C_AddScore rejected (pool-owner gate)" [])
                (ref-TS02-C3::AQP-POOL|C_AddScore foreign pool-id score-id))
            (expect-failure
                (format "<<TX-AQP-NEG-OWNER>> non-owner C_RevokeScore rejected (pool-owner gate)" [])
                (ref-TS02-C3::AQP-POOL|C_RevokeScore foreign pool-id score-id))
        ]
    )
)
(env-sigs [])
(commit-tx)
(print "=== END TX-AQP-NEG-OWNER ====================================================")
(print "")
(print "=== END FILE [6.2.10]_AQP-NEGATIVES.repl =====================================")
(print "")
