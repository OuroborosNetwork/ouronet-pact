;;
(begin-tx "TX-AQP-NEG-OWNER2 - non-owner ANK/SCORE/FVT owner-gated ops must fail")
(print "")
(print "=== TX-AQP-NEG-OWNER2 — non-owner AQP-ANK/AQP-SCR/AQP-FVT owner-gated ops rejected ==")
(namespace "ouronet-ns")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
;; EMMA signs — NOT the owner (ANHD) of AurynRain / ResumeVacScore / ResumeVacVault. Each op goes
;; through the Talos client path (so P|UEV_IMC passes) and must reject at the OWNER gate specifically:
;;   · AurynRain is alive → ANK|C>REVOKE's owner check precedes the #9 BoostClass lock.
;;   · ResumeVacScore is fully vacated (nzs=0, deb-boost false) → ENABLE-DEB-BOOST precondition passes.
;;   · ResumeVacVault has can-upgrade=true (default) → CONTROL-FVT precondition passes.
;; So in every case the ONLY thing that could reject EMMA is ownership — non-vacuous by construction.
;;
;;EXTENDED 2026-09-16, because that reasoning was written for THREE ops and four more owner gates in
;;the same family had no non-owner test at all. `FVT|C>CONTROL-FVT` (below) was the ONLY one of the
;;four latched-flag AQP owner gates any test reached with a foreign signer; `SCR|C>CONTROL-SCORE`,
;;`FVT|C>ROTATE-OWNERSHIP-FVT` and `SCR|C>ROTATE-OWNERSHIP-SCORE` were exercised exclusively by the
;;OWNER, so their `CAP_EnforceAccountOwnership` had never once been shown refusing anybody. Each of
;;those three sits AFTER a business `enforce` on a latched flag, which is the shadowing shape
;;CLAUDE.md's 2026-09-14 ruling is about -- but the remedy here is NOT to reorder them. Two suites
;;deliberately depend on the current order to reach the argument guard without a signature
;;(`TX-AQP-NEG-SCRCTL` below, and `[6.4]` `<<TX-AQP-FA01>>`), so reordering would merely move the
;;unobservable guard from one clause to the other. Ordering can expose only ONE of two
;;state-dependent guards at a time; a fixture that satisfies the first guard exposes BOTH. That is
;;what this block already did for CONTROL-FVT, and what the three additions below do for the rest.
;;
;;The preconditions are now ASSERTED rather than asserted-in-a-comment: each refusal is preceded by
;;an `expect` pinning the flag it needs, so if a future suite latches one of these flags early the
;;precondition goes red instead of the refusal quietly becoming vacuous again.
;;==== TX-AQP-NEG-OWNER2 - non-owner ANK/SCORE/FVT owner-gated ops must fail · 01 · env-sigs (caps) ==== 
(print "--- [TX-AQP-NEG-OWNER2 - non-owner ANK/SCORE/FVT owner-gated ops must fail · 01 · env-sigs (caps)] ---")
(env-sigs [{ "key": "PK_Emma", "caps": [] }])
;;==== TX-AQP-NEG-OWNER2 - non-owner ANK/SCORE/FVT owner-gated ops must fail · 02 · let / invocation ==== 
(print "--- [TX-AQP-NEG-OWNER2 - non-owner ANK/SCORE/FVT owner-gated ops must fail · 02 · let / invocation] ---")
(let
    (
        (foreign:string KST.EMMA)
        (ref-U|DALOS:module{UtilityDalosV2} U|DALOS)
        (ref-SCR:module{AcquisitionScoresV1} AQP-SCORE)
        (ref-FVT:module{AcquisitionFarmsVaultsTreasuriesV1} AQP-FVT)
        (ref-RPS:module{AcquisitionRewardPerShareV1} RPS)
        (ref-ANK:module{AcquisitionAnchorsV1} AQP-ANK)
        (ouro-id:string "OURO-98c486052a51")
        (boost-score-id:string (ref-U|DALOS::UDC_Makeid "TfStakeScore"))
        ;;An ACTIVE boost class, SELECTED rather than named. There is no C_IssueBoostClass -- classes
        ;;appear as a side effect of anchor issuance with acnoi=true -- so any literal id here would
        ;;be a guess about which anchor ran first, and would silently start testing the
        ;;"BoostClass must be active" enforce instead of the owner gate the day that order changed.
        (active-bcs:[string]
            (filter (lambda (b:string) (ref-ANK::UR_BC|Active b)) (ref-ANK::URH_BC|AllBoostClassIds))
        )
        (ref-TS02-C3:module{TalosStageTwo_ClientThreeV2} TS02-C3)
        (anchor-id:string (ref-U|DALOS::UDC_Makeid "AurynRain"))
        (score-id:string (ref-U|DALOS::UDC_Makeid "ResumeVacScore"))
        (fvt-id:string (ref-U|DALOS::UDC_Makeid "ResumeVacVault"))
    )
    (map print
        [
            ;;THIS ASSERTION USED TO PROVE NOTHING ABOUT THE GATE IT NAMED, and RT-K-007 surfaced it.
            ;;It was labelled "anchor-owner gate" while pinning
            ;;`No value found in table ouronet-ns.AQP-ANK_ANK|T|Anchor for key:` -- because
            ;;<anchor-id> is `UDC_Makeid "AurynRain"`, derived from THIS block's hash, so no such
            ;;anchor has ever existed. The refusal came from a missing ROW, not from an owner check:
            ;;delete the owner gate entirely and the line would still have passed. (RT-C-001's
            ;;lesson: a refusal by the wrong guard is indistinguishable from the right one unless the
            ;;message is pinned -- and pinning the WRONG message is worse than pinning none.)
            ;;
            ;;Split into the two things it was conflating. First: the id that does not exist now
            ;;refuses with the LIVENESS message, which is what that input actually tests -- and which
            ;;`UEV_LiveAnchor` could not deliver until `UR_ANK|State` stopped being a bare `read`.
            (expect-failure
                (format "<<TX-AQP-NEG-OWNER2>> AQP-ANK|C_RevokeAnchor on a NON-EXISTENT anchor: liveness gate" [])
                "must be alive for operation"
                (ref-TS02-C3::AQP-ANK|C_RevokeAnchor foreign anchor-id))
            ;;THE OWNER-GATE HALF IS NOT WRITTEN HERE, and the attempt is worth recording. Taking
            ;;`(at 0 (URH_ANK|AllAnchorIds))` and revoking it as <foreign> SUCCEEDED --
            ;;"Successfully revoked Anchor NfSyncAnchor-98c486052a51." -- which is NOT a bypass:
            ;;`CAP_Owner` resolves anchor ownership through the ANCHORED ASSET, and for a DPSF/DPNF
            ;;it accepts the asset's OWNER **or** its CREATOR, so EMMA legitimately controlled that
            ;;one. A correct owner-gate test must first establish an anchor whose anchored asset the
            ;;signer neither owns nor created -- and must not do what that attempt did, which was to
            ;;MUTATE STATE inside a negatives suite by actually revoking an anchor.
            ;;Recorded as known-open in DEFECT-LEDGER 7.3 rather than left as a passing line that
            ;;proves the wrong thing.
            (expect-failure
                (format "<<TX-AQP-NEG-OWNER2>> non-owner AQP-SCR|C_EnableDebBoost rejected (score-owner gate)" [])
                "Keyset failure (keys-all): [PK_Ancie...]"
                (ref-TS02-C3::AQP-SCR|C_EnableDebBoost foreign score-id))
            (expect-failure
                (format "<<TX-AQP-NEG-OWNER2>> non-owner AQP-FVT|C_Control rejected (fvt-owner gate)" [])
                "Keyset failure (keys-all): [PK_Ancie...]"
                (ref-TS02-C3::AQP-FVT|C_Control foreign fvt-id false false))
            ;;--- the three owner gates that no non-owner had ever reached (see preamble). Each is
            ;;preceded by the flag its shadowing `enforce` reads, so the refusal below is
            ;;attributable to ownership and to nothing else.
            (expect
                (format "<<TX-AQP-NEG-OWNER2>> ResumeVacScore is still controllable (CONTROL-SCORE precondition)" [])
                true (ref-SCR::UR_SCR|ScoreCanUpgrade score-id))
            (expect-failure
                (format "<<TX-AQP-NEG-OWNER2>> non-owner AQP-SCR|C_ControlScore rejected (score-owner gate)" [])
                "Keyset failure (keys-all): [PK_Ancie...]"
                (ref-TS02-C3::AQP-SCR|C_ControlScore foreign score-id false false))
            ;;Rotation needs BOTH halves of its conjunction to pass before ownership is consulted:
            ;;can-change-owner true, and a new owner distinct from the current one. EMMA is not the
            ;;owner (ANHD is), so handing EMMA in satisfies distinctness by the same fact that makes
            ;;her a non-owner -- the one argument that cannot accidentally trip the guard instead.
            (expect
                (format "<<TX-AQP-NEG-OWNER2>> ResumeVacScore still allows owner rotation (ROTATE-SCORE precondition)" [])
                true (ref-SCR::UR_SCR|ScoreCanChangeOwner score-id))
            (expect-failure
                (format "<<TX-AQP-NEG-OWNER2>> non-owner AQP-SCR|C_RotateScoreOwnership rejected (score-owner gate)" [])
                "Keyset failure (keys-all): [PK_Ancie...]"
                (ref-TS02-C3::AQP-SCR|C_RotateScoreOwnership foreign score-id foreign))
            (expect
                (format "<<TX-AQP-NEG-OWNER2>> ResumeVacVault still allows owner rotation (ROTATE-FVT precondition)" [])
                true (ref-FVT::UR_FVT|CanChangeOwner fvt-id))
            (expect-failure
                (format "<<TX-AQP-NEG-OWNER2>> non-owner AQP-FVT|C_RotateOwnership rejected (fvt-owner gate)" [])
                "Keyset failure (keys-all): [PK_Ancie...]"
                (ref-TS02-C3::AQP-FVT|C_RotateOwnership foreign fvt-id foreign))
            ;;--- two more FVT owner gates, each shadowed by a ROW-EXISTENCE enforce rather than by
            ;;a latched flag. The discipline is the same and matters more here: a missing row is the
            ;;single likeliest way to reach these ops, so a non-owner test that did not first prove
            ;;the row EXISTS would be pinning "Reward link row must exist" and crediting it to the
            ;;owner gate -- RT-C-001's failure mode exactly. Both rows come from
            ;;`REPL_BootstrapVault` in [6.2.5], which linked ResumeVacVault to OURO and to
            ;;ResumeVacScore, so both are real and both are asserted before they are relied on.
            (expect
                (format "<<TX-AQP-NEG-OWNER2>> the ResumeVacVault/OURO reward-link row exists (TOGGLE-REWARD-LINK precondition)" [])
                true (ref-RPS::URC_FvtRpsGlobalRowExists fvt-id ouro-id))
            (expect-failure
                (format "<<TX-AQP-NEG-OWNER2>> non-owner AQP-FVT|C_ToggleRewardLink rejected (fvt-owner gate)" [])
                "Keyset failure (keys-all): [PK_Ancie...]"
                (ref-TS02-C3::AQP-FVT|C_ToggleRewardLink foreign fvt-id ouro-id false))
            ;;The score-entity variant carries a SECOND guard ahead of ownership -- the entity type
            ;;must match the stored one -- so the type is READ rather than hardcoded. Writing a
            ;;literal here would pass today and silently start testing the type guard instead of
            ;;the owner gate the day a fixture changes class.
            (expect
                (format "<<TX-AQP-NEG-OWNER2>> the ResumeVacVault/ResumeVacScore entity-link row exists (TOGGLE-SCORE-ENTITY-LINK precondition)" [])
                true (ref-RPS::URC_FvtScoreEntityLinkRowExists fvt-id score-id))
            (expect-failure
                (format "<<TX-AQP-NEG-OWNER2>> non-owner AQP-FVT|C_ToggleScoreEntityLink rejected (fvt-owner gate)" [])
                "Keyset failure (keys-all): [PK_Ancie...]"
                (ref-TS02-C3::AQP-FVT|C_ToggleScoreEntityLink foreign fvt-id
                    (ref-RPS::UR_FVT-SEL|ScoreEntityType fvt-id score-id) score-id false))
            ;;--- the two SCORE boost-link owner gates. Both sit behind a multi-conjunct enforce, so
            ;;every conjunct is pinned to its live value first: a non-owner test that tripped the
            ;;fold instead would report a refusal that has nothing to do with ownership.
            (expect
                (format "<<TX-AQP-NEG-OWNER2>> TfStakeScore exists, so the boost-link fold cannot fail on it" [])
                boost-score-id (ref-SCR::UR_SCR|ScoreScoreId boost-score-id))
            (expect
                (format "<<TX-AQP-NEG-OWNER2>> ResumeVacScore has no stakers, so the nzs-count conjunct passes" [])
                0 (ref-SCR::UR_SCR|ScoreNzsCount score-id))
            (expect-failure
                (format "<<TX-AQP-NEG-OWNER2>> non-owner AQP-SCR|C_CreateScoreBoostLink rejected (score-owner gate)" [])
                "Keyset failure (keys-all): [PK_Ancie...]"
                (ref-TS02-C3::AQP-SCR|C_CreateScoreBoostLink foreign score-id boost-score-id))
            ;;The class variant adds one more guard ahead of ownership -- the class must be ACTIVE --
            ;;so the id is taken from the live set rather than named, and the set is proved non-empty
            ;;first so `(at 0 ...)` cannot be what fails.
            (expect
                (format "<<TX-AQP-NEG-OWNER2>> at least one ACTIVE BoostClass exists to aim at (got {})" [(length active-bcs)])
                true (> (length active-bcs) 0))
            (expect-failure
                (format "<<TX-AQP-NEG-OWNER2>> non-owner AQP-SCR|C_CreateScoreBoostClassLink rejected (score-owner gate)" [])
                "Keyset failure (keys-all): [PK_Ancie...]"
                (ref-TS02-C3::AQP-SCR|C_CreateScoreBoostClassLink foreign score-id (at 0 active-bcs)))
        ]
    )
)
(env-sigs [])
(commit-tx)
(print "=== END TX-AQP-NEG-OWNER2 ===================================================")
(print "")
