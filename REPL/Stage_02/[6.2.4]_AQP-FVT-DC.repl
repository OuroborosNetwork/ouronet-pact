(begin-tx "TX-FVT-DC-05 - C_VacateSemiFungibleLegs multi-owner")
(print "")
(print "=== TX-FVT-DC-05 — VacateSemiFungibleLegs 2 owner legs finalize =============")
(namespace "ouronet-ns")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(let
    (
        (patron:string KST.ANHD)
        (owner-a:string KST.ANHD)
        (owner-b:string KST.EMMA)
        (beneficiary-a:string KST.ANHD)
        (beneficiary-b:string KST.EMMA)
        (dpsf-id:string "DHCD-98c486052a51")
        (ouro-id:string "OURO-98c486052a51")
        (score-name:string "SfStakeScore")
        (fvt-name:string "SfStakeVault")
        (pool-name:string "SfStakePool")
        (vacate-kind-dpsf:integer 3)
        (ref-U|DALOS:module{UtilityDalosV1} U|DALOS)
        (ref-DPDC:module{DpdcV1} DPDC)
        (ref-IGNIS:module{IgnisCollectorV1} IGNIS)
        (ref-TS02-C1:module{TalosStageTwo_ClientOneV2} TS02-C1)
        (ref-TS02-C3:module{TalosStageTwo_ClientThreeV1} TS02-C3)
        (ref-AQP:module{AcquisitionPoolsV1} AQP-POOL)
        (ref-SCR:module{AcquisitionScoresV1} AQP-SCORE)
        (ref-FVT:module{AcquisitionFarmsVaultsTreasuriesV1} AQP-FVT)
        (ref-VCT:module{AcquisitionVacateV1} AQP-VCT)
        (score-id:string (ref-U|DALOS::UDC_Makeid score-name))
        (fvt-id:string (ref-U|DALOS::UDC_Makeid fvt-name))
        (pool-id:string (ref-U|DALOS::UDC_Makeid pool-name))
        (nonce-a:integer 1)
        (nonce-b:integer 2)
    )
    (print "--- [TX-FVT-DC-05 · 00 · re-enable stake after TX-FVT-DC-04 vacate (XB disable)] ---")
    (env-sigs [{ "key": "PK_AncientHodler", "caps": [] }])
    (print (format "<(TS02-C3.AQP-POOL|C_EnablePoolStake)> => \"{}\"" [
        (ref-TS02-C3::AQP-POOL|C_EnablePoolStake patron pool-id)
    ]))
    (print "--- [TX-FVT-DC-05 · 01 · transfer DHCD nonce 2 to EMMA + dual stake] ---")
    (env-sigs
        [
            { "key": "PK_AncientHodler", "caps": [] }
            { "key": "PK_Emma", "caps": [] }
        ]
    )
    (let
        (
            (amt-b:integer (ref-DPDC::UR_AccountNonceSupply owner-a dpsf-id true nonce-b))
        )
        (enforce (> amt-b 0) "owner-a must hold DHCD nonce 2 for multi-owner vacate setup")
        (print (format "<(TS02-C1.DPSF|C_TransferNonces owner-a→owner-b)> => {}" [
            (ref-TS02-C1::DPSF|C_TransferNonces patron dpsf-id owner-a owner-b [nonce-b] [amt-b] false)
        ]))
    )
    (print (format "<(TS02-C3.AQP-POOL|C_StakeSemiFungibleCollectable owner-a)> => \"{}\"" [
        (ref-TS02-C3::AQP-POOL|C_StakeSemiFungibleCollectable
            patron pool-id owner-a beneficiary-a dpsf-id [nonce-a]
        )
    ]))
    (print (format "<(TS02-C3.AQP-POOL|C_StakeSemiFungibleCollectable owner-b)> => \"{}\"" [
        (ref-TS02-C3::AQP-POOL|C_StakeSemiFungibleCollectable
            patron pool-id owner-b beneficiary-b dpsf-id [nonce-b]
        )
    ]))
    (let
        (
            (inventory:[object] (at "legs" (ref-VCT::URD_VacateCollectableInventory pool-id dpsf-id true)))
            (pre-supply-a:integer (ref-DPDC::UR_AccountNonceSupply owner-a dpsf-id true nonce-a))
            (pre-supply-b:integer (ref-DPDC::UR_AccountNonceSupply owner-b dpsf-id true nonce-b))
            (vacate-a:integer (floor (ref-AQP::UR_AQP|DPSFTrackerBalance pool-id dpsf-id owner-a beneficiary-a nonce-a)))
            (vacate-b:integer (floor (ref-AQP::UR_AQP|DPSFTrackerBalance pool-id dpsf-id owner-b beneficiary-b nonce-b)))
            (plan:object (ref-VCT::URDC_BuildVacateSlicePlan pool-id dpsf-id vacate-kind-dpsf 1))
            (slice0:object (at 0 (at "slices" plan)))
        )
        (enforce (= (length inventory) 2) "TX-FVT-DC-05: expect 2 vacate legs from URD")
        (enforce (> vacate-a 0) "owner-a tracker must hold stake")
        (enforce (> vacate-b 0) "owner-b tracker must hold stake")
        (print (format "<(URD vacate legs)> => {}" [inventory]))
        (print "--- [TX-FVT-DC-05 · 02 · C_VacateSemiFungibleLegs finalize] ---")
        (print (format "<(TS02-C3.AQP-POOL|C_VacateSemiFungibleLegs)> => \"{}\"" [
            (ref-TS02-C3::AQP-POOL|C_VacateSemiFungibleLegs
                patron pool-id dpsf-id
                (at "owner-ids" slice0)
                (at "beneficiary-ids" slice0)
                (at "nonces-array" slice0)
                (at "amounts-array" slice0)
                true
            )
        ]))
        (print "--- [TX-FVT-DC-05 · 03 · post-vacate expects] ---")
        (let
            (
                (tracker-a-post:decimal (ref-AQP::UR_AQP|DPSFTrackerBalance pool-id dpsf-id owner-a beneficiary-a nonce-a))
                (tracker-b-post:decimal (ref-AQP::UR_AQP|DPSFTrackerBalance pool-id dpsf-id owner-b beneficiary-b nonce-b))
                (deb-a:decimal (ref-SCR::UR_U-SCR|UserScoreDebScore beneficiary-a pool-id score-id))
                (deb-b:decimal (ref-SCR::UR_U-SCR|UserScoreDebScore beneficiary-b pool-id score-id))
                (unclaimed:integer (ref-FVT::UR_FVT-RG|UnclaimedCount fvt-id ouro-id))
                (post-supply-a:integer (ref-DPDC::UR_AccountNonceSupply owner-a dpsf-id true nonce-a))
                (post-supply-b:integer (ref-DPDC::UR_AccountNonceSupply owner-b dpsf-id true nonce-b))
                (vacate-in-progress:bool (ref-VCT::UR_VacateInProgress pool-id))
                (stake-enabled:bool (ref-AQP::UR_AQP|PoolStakeEnabled pool-id))
            )
            (map print
                [
                    (format "<(AQP-POOL|DPSFTrackerBalance owner-a)> => \"{}\"" [tracker-a-post])
                    (format "<(AQP-POOL|DPSFTrackerBalance owner-b)> => \"{}\"" [tracker-b-post])
                    (format "<(AQP-SCORE|deb-score owner-a)> => \"{}\"" [deb-a])
                    (format "<(AQP-SCORE|deb-score owner-b)> => \"{}\"" [deb-b])
                    (format "<(FVT|unclaimed-count)> => \"{}\"" [unclaimed])
                    (format "<(DPDC|UR_AccountNonceSupply owner-a)> post => \"{}\"" [post-supply-a])
                    (format "<(DPDC|UR_AccountNonceSupply owner-b)> post => \"{}\"" [post-supply-b])
                ]
            )
            (map print
                [
                    (expect (format "<<TX-FVT-DC-05 expect>> owner-a tracker cleared got={} expected=0" [tracker-a-post]) 0.0 tracker-a-post)
                    (expect (format "<<TX-FVT-DC-05 expect>> owner-b tracker cleared got={} expected=0" [tracker-b-post]) 0.0 tracker-b-post)
                    (expect (format "<<TX-FVT-DC-05 expect>> owner-a deb-score cleared got={} expected=0" [deb-a]) 0.0 deb-a)
                    (expect (format "<<TX-FVT-DC-05 expect>> owner-b deb-score cleared got={} expected=0" [deb-b]) 0.0 deb-b)
                    (expect (format "<<TX-FVT-DC-05 expect>> unclaimed-count after vacate got={} expected=0" [unclaimed]) 0 unclaimed)
                    (expect (format "<<TX-FVT-DC-05 expect>> owner-a supply restored got={} expected={}" [post-supply-a (+ pre-supply-a vacate-a)]) (+ pre-supply-a vacate-a) post-supply-a)
                    (expect (format "<<TX-FVT-DC-05 expect>> owner-b supply restored got={} expected={}" [post-supply-b (+ pre-supply-b vacate-b)]) (+ pre-supply-b vacate-b) post-supply-b)
                    (expect (format "<<TX-FVT-DC-05 expect>> vacate-in-progress cleared got={} expected=false" [vacate-in-progress]) false vacate-in-progress)
                    (expect (format "<<TX-FVT-DC-05 expect>> stake re-enabled got={} expected=true" [stake-enabled]) true stake-enabled)
                ]
            )
        )
    )
)
(env-sigs [])
(commit-tx)
(print "=== END TX-FVT-DC-05 =======================================================")
(print "")
