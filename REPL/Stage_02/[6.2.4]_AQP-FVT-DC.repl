(begin-tx "TX-FVT-DC-04 - C_VacateSemiFungibleCollectable (pool-owner forced unstake)")
(print "")
(print "=== TX-FVT-DC-04 — C_VacateSemiFungibleCollectable ==========================")
(namespace "ouronet-ns")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(let
    (
        (patron:string KST.ANHD)
        (owner-id:string KST.ANHD)
        (beneficiary-id:string KST.ANHD)
        (dpsf-id:string "DHCD-98c486052a51")
        (ouro-id:string "OURO-98c486052a51")
        (score-name:string "SfStakeScore")
        (fvt-name:string "SfStakeVault")
        (pool-name:string "SfStakePool")
        (ref-U|DALOS:module{UtilityDalosV1} U|DALOS)
        (ref-DPDC:module{DpdcV1} DPDC)
        (ref-TS02-C3:module{TalosStageTwo_ClientThreeV1} TS02-C3)
        (ref-AQP:module{AcquisitionPoolsV1} AQP-POOL)
        (ref-SCR:module{AcquisitionScoresV1} AQP-SCORE)
        (ref-FVT:module{AcquisitionFarmsVaultsTreasuriesV1} AQP-FVT)
        (score-id:string (ref-U|DALOS::UDC_Makeid score-name))
        (fvt-id:string (ref-U|DALOS::UDC_Makeid fvt-name))
        (pool-id:string (ref-U|DALOS::UDC_Makeid pool-name))
        (stake-nonce:integer 1)
    )
    (print "--- [TX-FVT-DC-04 · 01 · re-stake after TX-FVT-DC-03 round-trip] ---")
    (env-sigs [{ "key": "PK_AncientHodler", "caps": [] }])
    (print (format "<(TS02-C3.AQP-POOL|C_StakeSemiFungibleCollectable)> => \"{}\"" [
        (ref-TS02-C3::AQP-POOL|C_StakeSemiFungibleCollectable
            patron pool-id owner-id beneficiary-id dpsf-id [stake-nonce]
        )
    ]))
    (let
        (
            (tracker-pre:decimal (ref-AQP::UR_AQP|DPSFTrackerBalance pool-id dpsf-id owner-id beneficiary-id stake-nonce))
            (vacate-amount:integer (floor tracker-pre))
            (pre-supply:integer (ref-DPDC::UR_AccountNonceSupply owner-id dpsf-id true stake-nonce))
        )
        (enforce (> vacate-amount 0) "tracker must hold stake before vacate")
        (print (format "<(vacate-nonce vacate-amount)> => {} / {}" [stake-nonce vacate-amount]))
        (print "--- [TX-FVT-DC-04 · 02 · C_VacateSemiFungibleCollectable (pool owner)] ---")
        (print (format "<(TS02-C3.AQP-POOL|C_VacateSemiFungibleCollectable)> => \"{}\"" [
            (ref-TS02-C3::AQP-POOL|C_VacateSemiFungibleCollectable
                patron pool-id owner-id beneficiary-id dpsf-id [stake-nonce] [vacate-amount]
            )
        ]))
        (print "--- [TX-FVT-DC-04 · 03 · post-vacate expects] ---")
        (let
            (
                (tracker-post:decimal (ref-AQP::UR_AQP|DPSFTrackerBalance pool-id dpsf-id owner-id beneficiary-id stake-nonce))
                (deb-user:decimal (ref-SCR::UR_U-SCR|UserScoreDebScore beneficiary-id pool-id score-id))
                (unclaimed:integer (ref-FVT::UR_FVT-RG|UnclaimedCount fvt-id ouro-id))
                (post-supply:integer (ref-DPDC::UR_AccountNonceSupply owner-id dpsf-id true stake-nonce))
            )
            (map print
                [
                    (format "<(AQP-POOL|DPSFTrackerBalance)> => \"{}\"" [tracker-post])
                    (format "<(AQP-SCORE|deb-score)> => \"{}\"" [deb-user])
                    (format "<(FVT|unclaimed-count)> => \"{}\"" [unclaimed])
                    (format "<(DPDC|UR_AccountNonceSupply owner)> post => \"{}\"" [post-supply])
                ]
            )
            (map print
                [
                    (expect (format "<<TX-FVT-DC-04 expect>> tracker cleared got={} expected=0" [tracker-post]) 0.0 tracker-post)
                    (expect (format "<<TX-FVT-DC-04 expect>> deb-score cleared got={} expected=0" [deb-user]) 0.0 deb-user)
                    (expect (format "<<TX-FVT-DC-04 expect>> unclaimed-count after vacate got={} expected=0" [unclaimed]) 0 unclaimed)
                    (expect (format "<<TX-FVT-DC-04 expect>> owner supply restored got={} expected={}" [post-supply (+ pre-supply vacate-amount)]) (+ pre-supply vacate-amount) post-supply)
                ]
            )
        )
    )
)
(env-sigs [])
(commit-tx)
(print "=== END TX-FVT-DC-04 =======================================================")
(print "")
;; DEFERRED (see TEST_DEFERRED.md + README_VACATE_UI.md):
;; - DPNF Bloodshed-scale vacate (repeat C_VacateNonFungibleCollectable per owner / nonce chunk)
;; - C_VacateTrueFungible + C_VacateOrtoFungibleBatch on class-0 LP pool
;; - Bloodshed DPNF full-collection vacate gas limit (tune VACATE-MAX-NONCES)
(print "")
