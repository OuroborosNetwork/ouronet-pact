(begin-tx "TX-FVT-DC-03 - C_UnstakeSemiFungibleCollectable round-trip")
(print "")
(print "=== TX-FVT-DC-03 — C_UnstakeSemiFungibleCollectable ==========================")
(namespace "ouronet-ns")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(let
    (
        (patron:string KST.ANHD)
        (owner-id:string KST.ANHD)
        (beneficiary-id:string KST.ANHD)
        (dpsf-id:string "DHCD-98c486052a51")
        (ouro-id:string "OURO-98c486052a51")
        (score-name:string "SfStakeScore")
        (fvt-name:string "SfStakeVault")
        (pool-name:string "SfStakePool")
        (ref-U|DALOS:module{UtilityDalosV1} U|DALOS)
        (ref-DPDC:module{DpdcV1} DPDC)
        (ref-TS02-C3:module{TalosStageTwo_ClientThreeV1} TS02-C3)
        (ref-AQP:module{AcquisitionPoolsV1} AQP-POOL)
        (ref-SCR:module{AcquisitionScoresV1} AQP-SCORE)
        (ref-FVT:module{AcquisitionFarmsVaultsTreasuriesV1} AQP-FVT)
        (ref-ANK:module{AcquisitionAnchorsV1} AQP-ANK)
        (score-id:string (ref-U|DALOS::UDC_Makeid score-name))
        (fvt-id:string (ref-U|DALOS::UDC_Makeid fvt-name))
        (pool-id:string (ref-U|DALOS::UDC_Makeid pool-name))
        (vault-konto:string (ref-ANK::GOV|AQP|SC_NAME))
        (stake-nonce:integer 1)
        (tracker-bal:decimal (ref-AQP::UR_AQP|DPSFTrackerBalance pool-id dpsf-id owner-id beneficiary-id stake-nonce))
        (stake-amount:integer (floor tracker-bal))
        (pre-supply:integer (ref-DPDC::UR_AccountNonceSupply owner-id dpsf-id true stake-nonce))
    )
    (enforce (> tracker-bal 0.0) "DPSF tracker must hold staked nonce from TX-FVT-DC-02")
    (print (format "<(unstake-nonce stake-amount vault-konto)> => {} / {} / {}" [stake-nonce stake-amount vault-konto]))
    (env-sigs [{ "key": "PK_AncientHodler", "caps": [] }])
    (print "--- [TX-FVT-DC-03 · 01 · C_UnstakeSemiFungibleCollectable] ---")
    (print (format "<(TS02-C3.AQP-POOL|C_UnstakeSemiFungibleCollectable)> => \"{}\"" [
        (ref-TS02-C3::AQP-POOL|C_UnstakeSemiFungibleCollectable
            patron pool-id owner-id owner-id dpsf-id [stake-nonce] [stake-amount]
        )
    ]))
    (print "--- [TX-FVT-DC-03 · 02 · post-unstake reads + expect] ---")
    (let
        (
            (tracker-post:decimal (ref-AQP::UR_AQP|DPSFTrackerBalance pool-id dpsf-id owner-id beneficiary-id stake-nonce))
            (deb-user:decimal (ref-SCR::UR_U-SCR|UserScoreDebScore beneficiary-id pool-id score-id))
            (base-user:decimal (ref-SCR::UR_U-SCR|UserScoreBaseScore beneficiary-id pool-id score-id))
            (unclaimed:integer (ref-FVT::UR_FVT-RG|UnclaimedCount fvt-id ouro-id))
            (post-supply:integer (ref-DPDC::UR_AccountNonceSupply owner-id dpsf-id true stake-nonce))
        )
        (map print
            [
                (format "<(AQP-POOL|DPSFTrackerBalance)> => \"{}\"" [tracker-post])
                (format "<(AQP-SCORE|deb-score)> => \"{}\"" [deb-user])
                (format "<(AQP-SCORE|base-score)> => \"{}\"" [base-user])
                (format "<(FVT|unclaimed-count)> => \"{}\"" [unclaimed])
                (format "<(DPDC|UR_AccountNonceSupply owner)> post => \"{}\"" [post-supply])
            ]
        )
        (map print
            [
                (expect (format "<<TX-FVT-DC-03 expect>> tracker cleared got={} expected=0" [tracker-post]) 0.0 tracker-post)
                (expect (format "<<TX-FVT-DC-03 expect>> deb-score cleared got={} expected=0" [deb-user]) 0.0 deb-user)
                (expect (format "<<TX-FVT-DC-03 expect>> base-score cleared got={} expected=0" [base-user]) 0.0 base-user)
                (expect (format "<<TX-FVT-DC-03 expect>> unclaimed-count after full unstake got={} expected=0" [unclaimed]) 0 unclaimed)
                (expect (format "<<TX-FVT-DC-03 expect>> owner supply restored got={} expected={}" [post-supply (+ pre-supply stake-amount)]) (+ pre-supply stake-amount) post-supply)
            ]
        )
    )
)
(env-sigs [])
(commit-tx)
(print "=== END TX-FVT-DC-03 =======================================================")
(print "")
