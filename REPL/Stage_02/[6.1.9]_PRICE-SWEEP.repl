                (at "ignis" (at 0 (at "cumulator-chain" (ref-DPDC-R::URCi_ToggleModifyCreatorRole sft true)))))
            (expect "<<TX-DPP-001>> DPNF|C_ToggleModifyCreatorRole == deter(auth) + components"
