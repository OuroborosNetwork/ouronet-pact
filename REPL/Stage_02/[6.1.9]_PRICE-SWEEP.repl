;;================================================================================
(begin-tx "TX-SWPP-001 - SWP price sweep: observed IGNIS == deter + components")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(namespace "ouronet-ns")
;;==== TX-SWPP-001 · 01 · full-module sweep ====
(print "--- [TX-SWPP-001 · 01 · full-module sweep] ---")
;;The swpair fixture is derived at RUNTIME from whatever pairs Stage 1 issued — same principle as
;;the ATS sweep in [6.1]_Cumulator.repl. No hardcoded id, so this cannot rot when a suite changes
;;which pairs it creates; it only requires that at least one pair exists.
;;NOT swept here: the six SWPLC liquidity readers are composed (deter + transfer/burn legs), so
;;they have no single deter+components identity to assert — they need a floor-style check instead.
(let
    (
        (ref-IGNIS:module{IgnisCollectorV2} IGNIS)
        (ref-SWP:module{SwapperV4} SWP)
        (swpair:string (at 0 (ref-SWP::URC_Swpairs)))
    )
    (map (print)
        [
            (expect "<<TX-SWPP-001>> SWP|C_ChangeOwnership == deter(auth) + components"
                (ref-IGNIS::UC_IgnisPrice "SWP|C_ChangeOwnership" "auth")
                (at "ignis" (at 0 (at "cumulator-chain" (ref-SWP::URCi_ChangeOwnership swpair)))))
            (expect "<<TX-SWPP-001>> SWP|C_ModifyCanChangeOwner == deter(auth) + components"
                (ref-IGNIS::UC_IgnisPrice "SWP|C_ModifyCanChangeOwner" "auth")
                (at "ignis" (at 0 (at "cumulator-chain" (ref-SWP::URCi_ModifyCanChangeOwner swpair)))))
            (expect "<<TX-SWPP-001>> SWP|C_ModifyWeights == deter(fee) + components"
                (ref-IGNIS::UC_IgnisPrice "SWP|C_ModifyWeights" "fee")
                (at "ignis" (at 0 (at "cumulator-chain" (ref-SWP::URCi_ModifyWeights swpair)))))
            (expect "<<TX-SWPP-001>> SWP|C_UpdateAmplifier == deter(fee) + components"
                (ref-IGNIS::UC_IgnisPrice "SWP|C_UpdateAmplifier" "fee")
                (at "ignis" (at 0 (at "cumulator-chain" (ref-SWP::URCi_UpdateAmplifier swpair)))))
            (expect "<<TX-SWPP-001>> SWP|C_UpdateFee == deter(fee) + components"
                (ref-IGNIS::UC_IgnisPrice "SWP|C_UpdateFee" "fee")
                (at "ignis" (at 0 (at "cumulator-chain" (ref-SWP::URCi_UpdateFee swpair)))))
            (expect "<<TX-SWPP-001>> SWP|C_UpdateSpecialFeeTargets == deter(fee) + components"
                (ref-IGNIS::UC_IgnisPrice "SWP|C_UpdateSpecialFeeTargets" "fee")
                (at "ignis" (at 0 (at "cumulator-chain" (ref-SWP::URCi_UpdateSpecialFeeTargets swpair)))))
            ""
        ]
    )
)
(print "")
(print "<<TX-SWPP-001>> P7 sweep: all 6 migrated SWP readers price correctly")
(print "===^^^===")
(commit-tx)
