            (expect "<<TX-DPP-001>> DPSF|C_Control == deter(setup) + components"
                (ref-IGNIS::UC_IgnisPrice "DPSF|C_Control" "setup")
                (at "ignis" (at 0 (at "cumulator-chain" (ref-DPDC-MNG::URCi_Control sft true)))))
            (expect "<<TX-DPP-001>> DPNF|C_Control == deter(setup) + components"
                (ref-IGNIS::UC_IgnisPrice "DPNF|C_Control" "setup")
                (at "ignis" (at 0 (at "cumulator-chain" (ref-DPDC-MNG::URCi_Control nft false)))))
            (expect "<<TX-DPP-001>> DPSF|C_TogglePause == deter(setup) + components"
                (ref-IGNIS::UC_IgnisPrice "DPSF|C_TogglePause" "setup")
                (at "ignis" (at 0 (at "cumulator-chain" (ref-DPDC-MNG::URCi_TogglePause sft true)))))
            (expect "<<TX-DPP-001>> DPNF|C_TogglePause == deter(setup) + components"
                (ref-IGNIS::UC_IgnisPrice "DPNF|C_TogglePause" "setup")
                (at "ignis" (at 0 (at "cumulator-chain" (ref-DPDC-MNG::URCi_TogglePause nft false)))))
            (expect "<<TX-DPP-001>> DPSF|C_WipeNonce == deter(setup) + components"
                (ref-IGNIS::UC_IgnisPrice "DPSF|C_WipeNonce" "setup")
                (at "ignis" (at 0 (at "cumulator-chain" (ref-DPDC-MNG::URCi_WipeNonce sft true)))))
            (expect "<<TX-DPP-001>> DPNF|C_WipeNonce == deter(setup) + components"
                (ref-IGNIS::UC_IgnisPrice "DPNF|C_WipeNonce" "setup")
                (at "ignis" (at 0 (at "cumulator-chain" (ref-DPDC-MNG::URCi_WipeNonce nft false)))))
            ;;minting-type op: generic tier, no issuance price
            (expect "<<TX-DPP-001>> DPSF|C_AddQuantity == deter(setup) + components"
                (ref-IGNIS::UC_IgnisPrice "DPSF|C_AddQuantity" "setup")
                (at "ignis" (at 0 (at "cumulator-chain" (ref-DPDC-MNG::URCi_AddQuantity sft)))))
            ;;minting-type op: generic tier, no issuance price
            (expect "<<TX-DPP-001>> DPNF|C_Respawn == deter(setup) + components"
                (ref-IGNIS::UC_IgnisPrice "DPNF|C_Respawn" "setup")
                (at "ignis" (at 0 (at "cumulator-chain" (ref-DPDC-MNG::URCi_RespawnNFT nft)))))
            ;;reader name != Talos op name
            (expect "<<TX-DPP-001>> DPSF|C_Burn == deter(setup) + components"
                (ref-IGNIS::UC_IgnisPrice "DPSF|C_Burn" "setup")
                (at "ignis" (at 0 (at "cumulator-chain" (ref-DPDC-MNG::URCi_BurnSFT sft)))))
            ;;reader name != Talos op name
            (expect "<<TX-DPP-001>> DPSF|C_WipeNoncePartialy == deter(setup) + components"
                (ref-IGNIS::UC_IgnisPrice "DPSF|C_WipeNoncePartialy" "setup")
                (at "ignis" (at 0 (at "cumulator-chain" (ref-DPDC-MNG::URCi_WipeSlim sft)))))
            ;;reader name != Talos op name
            (expect "<<TX-DPP-001>> DPNF|C_Burn == deter(setup) + components"
