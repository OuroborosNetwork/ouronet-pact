                (at "ignis" (at 0 (at "cumulator-chain" (ref-DPDC-R::URCi_ToggleUpdateRole sft true)))))
            (expect "<<TX-DPP-001>> DPNF|C_ToggleUpdateRole == deter(auth) + components"
