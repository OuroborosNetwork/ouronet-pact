(begin-tx "TX-OFP-001 - DPOF price sweep: observed IGNIS == deter + components")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(namespace "ouronet-ns")
;;==== TX-OFP-001 · 01 · full-module sweep ====
(print "--- [TX-OFP-001 · 01 · full-module sweep] ---")
;;All 14 migrated DPOF cost readers. The 12 below take an ortofungible id; the two after them
;;are deterrence-only (no components leg), so they are asserted against UC_IgnisDeter directly.
(let
    (
        (ref-IGNIS:module{IgnisCollectorV2} IGNIS)
        (ref-DPOF:module{DemiourgosPactOrtoFungibleV2} DPOF)
        (of:string "COF-98c486052a51")
    )
    (map (print)
        [
            (expect "<<TX-OFP-001>> DPOF|C_RotateOwnership == deter(auth) + components"
                (ref-IGNIS::UC_IgnisPrice "DPOF|C_RotateOwnership" "auth")
                (at "ignis" (at 0 (at "cumulator-chain" (ref-DPOF::URCi_RotateOwnership of)))))
            (expect "<<TX-OFP-001>> DPOF|C_Control == deter(setup) + components"
                (ref-IGNIS::UC_IgnisPrice "DPOF|C_Control" "setup")
                (at "ignis" (at 0 (at "cumulator-chain" (ref-DPOF::URCi_Control of)))))
            (expect "<<TX-OFP-001>> DPOF|C_TogglePause == deter(setup) + components"
                (ref-IGNIS::UC_IgnisPrice "DPOF|C_TogglePause" "setup")
                (at "ignis" (at 0 (at "cumulator-chain" (ref-DPOF::URCi_TogglePause of)))))
            (expect "<<TX-OFP-001>> DPOF|C_ToggleFreezeAccount == deter(setup) + components"
                (ref-IGNIS::UC_IgnisPrice "DPOF|C_ToggleFreezeAccount" "setup")
                (at "ignis" (at 0 (at "cumulator-chain" (ref-DPOF::URCi_ToggleFreezeAccount of)))))
            (expect "<<TX-OFP-001>> DPOF|C_ToggleAddQuantityRole == deter(auth) + components"
                (ref-IGNIS::UC_IgnisPrice "DPOF|C_ToggleAddQuantityRole" "auth")
                (at "ignis" (at 0 (at "cumulator-chain" (ref-DPOF::URCi_ToggleAddQuantityRole of)))))
            (expect "<<TX-OFP-001>> DPOF|C_ToggleBurnRole == deter(auth) + components"
                (ref-IGNIS::UC_IgnisPrice "DPOF|C_ToggleBurnRole" "auth")
                (at "ignis" (at 0 (at "cumulator-chain" (ref-DPOF::URCi_ToggleBurnRole of)))))
            (expect "<<TX-OFP-001>> DPOF|C_MoveCreateRole == deter(auth) + components"
                (ref-IGNIS::UC_IgnisPrice "DPOF|C_MoveCreateRole" "auth")
                (at "ignis" (at 0 (at "cumulator-chain" (ref-DPOF::URCi_MoveCreateRole of)))))
            (expect "<<TX-OFP-001>> DPOF|C_ToggleTransferRole == deter(usage) + components"
                (ref-IGNIS::UC_IgnisPrice "DPOF|C_ToggleTransferRole" "usage")
                (at "ignis" (at 0 (at "cumulator-chain" (ref-DPOF::URCi_ToggleTransferRole of)))))
            (expect "<<TX-OFP-001>> DPOF|C_AddQuantity == deter(setup) + components"
                (ref-IGNIS::UC_IgnisPrice "DPOF|C_AddQuantity" "setup")
                (at "ignis" (at 0 (at "cumulator-chain" (ref-DPOF::URCi_AddQuantity of)))))
            (expect "<<TX-OFP-001>> DPOF|C_Burn == deter(setup) + components"
                (ref-IGNIS::UC_IgnisPrice "DPOF|C_Burn" "setup")
                (at "ignis" (at 0 (at "cumulator-chain" (ref-DPOF::URCi_Burn of)))))
            (expect "<<TX-OFP-001>> DPOF|C_WipeSlim == deter(setup) + components"
                (ref-IGNIS::UC_IgnisPrice "DPOF|C_WipeSlim" "setup")
                (at "ignis" (at 0 (at "cumulator-chain" (ref-DPOF::URCi_WipeSlim of)))))
            (expect "<<TX-OFP-001>> DPOF|C_Mint == deter(setup) + components"
                (ref-IGNIS::UC_IgnisPrice "DPOF|C_Mint" "setup")
                (at "ignis" (at 0 (at "cumulator-chain" (ref-DPOF::URCi_Mint of)))))
            ;;issuance rail + token-account creation, both now deter + components
            (expect "<<TX-OFP-001>> DPOF issue gas (1 token) == deter(issue-of) + components"
                (ref-IGNIS::UC_IgnisPrice "DPOF|C_Issue" "issue-of")
                (ref-DPOF::URCi_IssueGas 1))
            (expect "<<TX-OFP-001>> DPOF DeployAccount == deter(token-account) + components"
                (ref-IGNIS::UC_IgnisPrice "DPOF|C_DeployAccount" "token-account")
                (at "ignis" (at 0 (at "cumulator-chain" (ref-DPOF::URCi_DeployAccount KST.ANHD)))))
            ""
        ]
    )
)
(print "")
(print "<<TX-OFP-001>> P7 sweep: all 14 migrated DPOF readers price correctly")
(print "===^^^===")
(commit-tx)

