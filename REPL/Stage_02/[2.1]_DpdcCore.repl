(print "")
(begin-tx "TX-01 [1.1] - Define Keys Used in Stage 02 Modules")
(namespace "ouronet-ns")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
;;==== TX-01 [1.1] - Define Keys Used in Stage 02 Modules · 01 · env-sigs (caps) ==== =============
(print "--- [TX-01 [1.1] - Define Keys Used in Stage 02 Modules · 01 · env-sigs (caps)] ---")
(env-sigs
  [{"key": "1a4e15d3c51e0b73e92644600487ba8eaae312e1a178b91801d54e13c1b350a5", "caps": []}])

    (module KC2 GOVERNANCE
        (defcap GOVERNANCE () true)

        ;;User Names
        
        ;;Smart Contracts
        (defconst KADN_NAME_0001 "k:35d7f82a7754d10fc1128d199aadb51cb1461f0eb52f4fa89790a44434f12ed8")
        (defconst KADN_PBKY_0001 (drop 2 KADN_NAME_0001))
        (defconst DPTS_NAME_0001 "Σ.μЖâAáпδÃàźфнMAŸôIÌjȘЛδεЬÍБЮoзξ4κΩøΠÒçѺłœщÌĘчoãueUøVlßHšδLτε£σž£ЙLÛòCÎcďьčfğÅηвČïnÊвÞIwÇÝмÉŠвRмWć5íЮzGWYвьżΨπûEÃdйdGЫŁŤČçПχĘŚślьЙŤğLУ0SýЭψȘÔÜнìÆkČѺȘÍÍΛ4шεнÄtИςȘ4")
        (defconst DPDC DPTS_NAME_0001)
        (defconst DPTS_PBKY_0001 "PK_Collectables")
        (defconst PBLC_0001 "9G.")

        (defconst KADN_NAME_0002 "k:2d4c9cd8d1bd30d9156b65c1259d2be9689f068927d8fee19bfb695619436e01")
        (defconst KADN_PBKY_0002 (drop 2 KADN_NAME_0002))
        (defconst DPTS_NAME_0002 "Σ.Îäć$ЬчýφVεÎÿůпΨÖůηüηŞйnюŽXΣşpЩß5ςĂκ£RäbE₳èËłŹŘYшÆgлoюýRαѺÑÏρζt∇ŹÏýжIŒațэVÞÛщŹЭδźvëȘĂтPЖÃÇЭiërđÈÝДÖšжzČđзUĚĂsкιnãñOÔIKпŞΛI₳zÄû$ρśθ6ΨЬпYпĞHöÝйÏюşí2ćщÞΔΔŻTж€₿ŞhTțŽ")
        (defconst LPAD DPTS_NAME_0002)
        (defconst DPTS_PBKY_0002 "PK_LPAD")
        (defconst PBLC_0002 "9F.")

        (defconst KADN_NAME_0003 "dee7795b6cea301d300e74131f14bd6a2fe75181a3e86daa34a551b6570abb78")
        (defconst KADN_PBKY_0003 (drop 2 KADN_NAME_0003))
        (defconst DPTS_NAME_0003 "Σ.ЖřÎzэóΣQз3ÌĄăådìÜλÅË9γğ7χûПæ0₳ПûÖŞrĄθXtFìмkщsGвÅgλąÇπЩAĚЭDíéαэБùđáżñИïПÆΣтцξsηåäялÃБц¢r6ÁíäзуμþĄĐЫîÉAćýìЧыQPнŁзßξĂйjay£üѺçRЫfУQșÏΠÜqîÔĄťß6ЗSρŠeΦñëdmûΦøШâΞýκъиřк")
        (defconst ACQP DPTS_NAME_0003)
        (defconst DPTS_PBKY_0003 "PK_ACQP")
        (defconst PBLC_0003 "9G.")

    )
    (env-data
        {
            ;;DEMI-SC-KEYS
            "KEY_SC_Collectables": { "keys": [KC2.DPTS_PBKY_0001]},
            "KEY_SC_Launchpad": { "keys": [KC2.DPTS_PBKY_0002]},
            "KEY_SC_Acquisition": { "keys": [KC2.DPTS_PBKY_0003]},

            "KEY_STOA_Collectables": { "keys": [KC2.KADN_PBKY_0001]},
            "KEY_STOA_Launchpad": { "keys": [KC2.KADN_PBKY_0002]},
            "KEY_STOA_Acquisition": { "keys": [KC2.KADN_PBKY_0003]}
        }
    )

    ;;DALOS Defined Keysets ==> For Repl Using Named Keys, ex PK_AncientHodler
    (define-keyset "ouronet-ns.dh_sc_dpdc-keyset" (read-keyset "KEY_SC_Collectables"))
    (define-keyset "ouronet-ns.dh_sc_mb-keyset" (read-keyset "KEY_SC_Launchpad"))
    (define-keyset "ouronet-ns.dh_sc_aqp-keyset" (read-keyset "KEY_SC_Acquisition"))

    ;;Create Collectables STOA Accounts and Fuel Them (for use in Repl)
    (env-sigs
        [
            {
                "key": "alice-key",
                "caps":
                    [
                        (coin.TRANSFER "alice" KC2.KADN_NAME_0001 5000.0)    ;;<PK_Collectables>    "k:35d7f82a7754d10fc1128d199aadb51cb1461f0eb52f4fa89790a44434f12ed8"
                        (coin.TRANSFER "alice" KC2.KADN_NAME_0002 5000.0)    ;;<PK_LPAD>            "k:2d4c9cd8d1bd30d9156b65c1259d2be9689f068927d8fee19bfb695619436e01"
                        (coin.TRANSFER "alice" KC2.KADN_NAME_0003 5000.0)    ;;<PK_ACQP>             "k:dee7795b6cea301d300e74131f14bd6a2fe75181a3e86daa34a551b6570abb78"
                    ]
            }
        ]
    )
;;==== TX-01 [1.1] - Define Keys Used in Stage 02 Modules · 02 · let / invocation ==== ============
(print "--- [TX-01 [1.1] - Define Keys Used in Stage 02 Modules · 02 · let / invocation] ---")
    (let
        (
            (ref-coin:module{stoa-ns.fungible-v1} coin)

        )
        ;;Create Accounts:
        (ref-coin::create-account KC2.KADN_NAME_0001 (read-keyset "KEY_STOA_Collectables"))
        (ref-coin::create-account KC2.KADN_NAME_0002 (read-keyset "KEY_STOA_Launchpad"))
        (ref-coin::create-account KC2.KADN_NAME_0003 (read-keyset "KEY_STOA_Acquisition"))
        ;;Fuel Account
        (ref-coin::transfer "alice" KC2.KADN_NAME_0001 5000.0)
        (ref-coin::transfer "alice" KC2.KADN_NAME_0002 5000.0)
        (ref-coin::transfer "alice" KC2.KADN_NAME_0003 5000.0)
    )

    ;;Create Collectables Smart Ouronet Account
    (env-sigs 
        [ 
            { "key": "PK_AncientHodler", "caps": [] }
            { "key": "PK_Collectables", "caps": [] }
            { "key": "PK_LPAD", "caps": [] }
            { "key": "PK_ACQP", "caps": [] }
        ]
    )
    (let
        (
            (ref-TS01-A:module{TalosStageOne_AdminV1} TS01-A)
            (patron:string KST.ANHD)
        )
        (ref-TS01-A::A_DALOS|DeploySmartAccount KC2.DPTS_NAME_0001 (keyset-ref-guard "ouronet-ns.dh_sc_dpdc-keyset")  KC2.KADN_NAME_0001 patron KC2.PBLC_0001)
        (ref-TS01-A::A_DALOS|DeploySmartAccount KC2.DPTS_NAME_0002 (keyset-ref-guard "ouronet-ns.dh_sc_mb-keyset")    KC2.KADN_NAME_0002 patron KC2.PBLC_0002)
        (ref-TS01-A::A_DALOS|DeploySmartAccount KC2.DPTS_NAME_0003 (keyset-ref-guard "ouronet-ns.dh_sc_aqp-keyset")   KC2.KADN_NAME_0003 patron KC2.PBLC_0003)
    )

(env-gas)
(commit-tx)
