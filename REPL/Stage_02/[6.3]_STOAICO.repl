;; REPL/Stage_02/[6.3]_STOAICO.repl — canonical integration layout (OuronetInformational/ARCHITECTURE/REPL_AND_TESTS.md)
;;   Inter-tx:   ;;|| NEXT >  (same three lines as REPL/Stage_01/[2.2]_Core.repl)
;;   Intra-tx:   ;;==== <TX label> · mm · <slug> ====  + next-line (print "--- [<label> · mm · …] ---"); mm = 01.. within each (begin-tx …) (see OuronetInformational/ARCHITECTURE/REPL_AND_TESTS.md).
;;   format "{}": Talos / module echoes and (env-gas) — document additional prefixes in this file's (print …) lines as needed.
;;
(print "")
(print "================================================================")
(print "FILE  REPL/Stage_02/[6.3]_STOAICO.repl")
(print "================================================================")
(print "Legend (terminal observability): see ;; preface; echoes use <(…)> where helpful.")
(print "Source: ;;|| NEXT > between txs; ;;==== … · mm · … ==== + banner before each begin-tx.")
(print "")
(print "")
(print "===================Initialise Ouronet_TX-002============================")
(begin-tx "INIT TX 000 - Chain Data Time SetUp Definition")
(namespace "ouronet-ns")
;;==== INIT TX 000 - Chain Data Time SetUp Definition · 01 · env-chain-data ==== ==================
(print "--- [INIT TX 000 - Chain Data Time SetUp Definition · 01 · env-chain-data] ---")
(env-chain-data
    {"prev-block-hash": "98c486052a5147fdd30fa43cc6d67e0a4e680c856c37f9157cb788cd67d58006",
     "block-time": TV.TIME00}
)
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(env-gas)
(commit-tx)
;;||>>>>>>>>>>>>>>>>>>>>>>>>>
;;|| NEXT                   >
;;||>>>>>>>>>>>>>>>>>>>>>>>>>
(print "")
;;||>>>>>>>>>>>>>>>>>>>>>>>>>
;;|| NEXT                   >
;;||>>>>>>>>>>>>>>>>>>>>>>>>>
(print "")
(begin-tx "TX000 - Set Intermodule Communication")
(namespace "ouronet-ns")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
;;==== TX000 - Set Intermodule Communication · 01 · env-sigs (caps) ==== ==========================
(print "--- [TX000 - Set Intermodule Communication · 01 · env-sigs (caps)] ---")
(env-sigs 
    [   
        { "key": "PK_AncientHodler", "caps": [] }
    ]
)

;;==== TX000 - Set Intermodule Communication · 02 · let / invocation ==== =========================
(print "--- [TX000 - Set Intermodule Communication · 02 · let / invocation] ---")
    (let
        (
            (ref-P|DPAD:module{OuronetPolicyV1} DEMIPAD)
            (ref-P|STOAICO:module{OuronetPolicyV1} STOAICO)
            ;;
            (ref-U|G:module{OuronetGuardsV1} U|G)
            (ref-TS01-C1:module{TalosStageOne_ClientOneV1} TS01-C1)
            (ref-DPAD:module{DemiourgosLaunchpadV1} DEMIPAD)
            ;;
            (mg:guard (create-capability-guard (TS02-DPAD.P|TALOS-SUMMONER)))
            (lpad-sc:string (ref-DPAD::GOV|DEMIPAD|SC_NAME))
        )
        ;;Backward IMC                      Sets IMC for backward Modules
        (ref-P|STOAICO::P|A_Define)
        ;;Forward IMC                       Sets IMC for forward Modules
        ;(ref-P|STOAICO::P|A_AddIMP mg)     Needed on Mainnet
        ;                                   Not needed on repl because it is already added on TS02-DPAD
        ;;Governor Update for <lpad-sc>
        (ref-TS01-C1::DALOS|C_RotateGovernor
            KST.ANHD
            lpad-sc
            (ref-U|G::UEV_GuardOfAny
                [
                    (create-capability-guard (DEMIPAD.DEMIPAD|GOV))
                    (ref-P|DPAD::P|UR "SPARK|RemoteGov")
                    (ref-P|DPAD::P|UR "SNAKES|RemoteGov")
                    (ref-P|DPAD::P|UR "CUSTODIANS|RemoteGov")
                    (ref-P|DPAD::P|UR "KPAY|RemoteGov")
                    (ref-P|DPAD::P|UR "STOAICO|RemoteGov")
                ]
            )
        )
    )


(print "")
(print "")
;;==== TX000 - Set Intermodule Communication · 03 · gas echo ==== =================================
(print "--- [TX000 - Set Intermodule Communication · 03 · gas echo] ---")
(format "<<<<<<<TX000 - STOAICO intermodule Communictaion Setup costs {} GAS>>>>>>>" [(env-gas)])
(print "")
(print "")
(print "===^^^===")
(commit-tx)
;;||>>>>>>>>>>>>>>>>>>>>>>>>>
;;|| NEXT                   >
;;||>>>>>>>>>>>>>>>>>>>>>>>>>
(print "")
(begin-tx "TX-01 - Initialise STOA ICO")
(namespace "ouronet-ns")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
;;==== TX-01 - Initialise STOA ICO · 01 · env-sigs (caps) ==== ====================================
(print "--- [TX-01 - Initialise STOA ICO · 01 · env-sigs (caps)] ---")
(env-sigs
    [
        { "key": "PK_AncientHodler", "caps": [] }
        { "key": "PK_LPAD", "caps": [] }
    ]
)
;;==== TX-01 - Initialise STOA ICO · 02 · let / invocation ==== ===================================
(print "--- [TX-01 - Initialise STOA ICO · 02 · let / invocation] ---")
(let
    (
        (ref-DALOS:module{OuronetDalosV1} DALOS)
        (split-kda:[decimal]
            (ref-DALOS::URC_SplitKDAPrices
                KST.ANHD
                (* 3.0 (ref-DALOS::UR_UsagePrice "dptf"))
            )
        )
    )
    (env-sigs
        [
            { "key": "PK_AncientHodler", "caps": [] }
            { "key": "6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263" ,
              "caps":
                [
                    (coin.TRANSFER
                        "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263"
                        "k:50d6c59b21e5e6e55baecaa75a1007de37576bde12d8230dc82459cc01b9484b"
                        (at 2 split-kda)
                    )
                    (coin.TRANSFER
                        "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263"
                        "k:0cb30c0121ff919266121a99ff9359871818932211df94dae4137c29bc0e8f7e"
                        (at 0 split-kda)
                    )
                    (coin.TRANSFER
                        "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263"
                        "c:XM-pkmuB5XUQlp87ZYSbfKt8qzmHY6O2EHAzMRVBt3k"
                        (at 3 split-kda)
                    )
                    (coin.TRANSFER
                        "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263"
                        "c:iQQFWj6gWtpGEzhM_O5ekW1QtnQQy55R8BRPGhj_0FU"
                        (at 1 split-kda)

                    )
                ]
            }
        ]
    )
    ;(DALOS.UEV_StandardAccOwn "Ѻ.éXødVțrřĄθ7ΛдUŒjeßćιiXTПЗÚĞqŸœÈэαLżØôćmч₱ęãΛě$êůáØCЗшõyĂźςÜãθΘзШË¥şEÈnxΞЗÚÏÛjDVЪжγÏŽнăъçùαìrпцДЖöŃȘâÿřh£1vĎO£κнβдłпČлÿáZiĐą8ÊHÂßĎЩmEBцÄĎвЙßÌ5Ï7ĘŘùrÑckeñëδšПχÌàî")
    (STOAICO.A_InitialiseDistributionVault KST.ANHD)
)


(print "")
(print "")
