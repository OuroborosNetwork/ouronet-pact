(begin-tx "TX-00c - STOAICO baseline capture (delta conservation, boot-position-independent)")
(namespace "ouronet-ns")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
;; Capture emma+lumy pre-existing wSTOA so the final CONSERVATION assert measures the DELTA the ICO
;; distributed (==10M), not an absolute — otherwise a full-boot residue on the shared KST.EMMA/KST.LUMY
;; accounts (e.g. ~0.012 wSTOA left by earlier suites) breaks it. (try 0.0 …): no wSTOA row yet -> 0.
(let ((wstoa:string (DALOS.UR_WrappedStoaID)))
    (env-data
        { "stoaico-wstoa-base":
            (+ (try 0.0 (DPTF.UR_AccountSupply wstoa KST.EMMA))
               (try 0.0 (DPTF.UR_AccountSupply wstoa KST.LUMY))) }))
(commit-tx)
(print "")
