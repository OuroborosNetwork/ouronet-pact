(print "")
(begin-tx "TX-02 - STOAICO Stake Tests")
(namespace "ouronet-ns")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
;;==== TX-02 - STOAICO Stake Tests · 01 · env-sigs (caps) ==== ====================================
(print "--- [TX-02 - STOAICO Stake Tests · 01 · env-sigs (caps)] ---")
(env-sigs
    [
        { "key": "PK_AncientHodler", "caps": [] }
        { "key": "PK_LPAD", "caps": [] }
        { "key": "PK_Emma", "caps": [] }
        { "key": "PK_Lumy", "caps": [] }
    ]
)

;;==== TX-02 - STOAICO Stake Tests · 02 · let / invocation ==== ===================================
(print "--- [TX-02 - STOAICO Stake Tests · 02 · let / invocation] ---")
    (let
        (
            (emma:string KST.EMMA)
            (lumy:string KST.LUMY)
        )
        (STOAICO.A_Stake KST.ANHD emma 2500.0)
        (STOAICO.A_Stake KST.ANHD emma 341.0)
        (STOAICO.A_Stake KST.ANHD emma 2.0)
        (STOAICO.A_Stake KST.ANHD lumy 17500.0)
        ;; #5M FLUSH: inject the remaining 7M — vault-score > 0 now, so this also FLUSHES the escrowed 3M
        ;; zombie (eff = 7M + 3M = 10M distributed). #1C: opens distribution-round 1 (unclaimed = nzs = 2).
        (STOAICO.A_Inject KST.ANHD KST.ANHD 7000000.0)
        (map print
            [
                (format "flush => zombie={} supply={}" [(STOAICO.UR_Global12) (STOAICO.UR_Global4)])
                (expect "#5M: escrowed zombie fully consumed by the flush (0)" 0.0 (STOAICO.UR_Global12))
                (expect "#5M: supply = escrow 3M + flush 7M = 10M total held" 10000000.0 (STOAICO.UR_Global4))
            ]
        )
        ;; Only EMMA self-collects; LUMY is intentionally left as a straggler so TX-03/04 can prove the
        ;; per-round idempotency, the inject barrier, and the admin flush.
        (print (format "emma collect => {}" [(STOAICO.C_Collect KST.ANHD emma)]))
        (map print
            [
                (format "round={} unclaimed={} wstoa-supply={}"
                    [(STOAICO.UR_Global11) (STOAICO.UR_Global7) (STOAICO.UR_Global4)])
                (expect "round advanced to 1 on inject" 1 (STOAICO.UR_Global11))
                (expect "emma stamped collected for round 1" 1 (STOAICO.UR_User5 emma))
                (expect "lumy still uncollected (round 0)" 0 (STOAICO.UR_User5 lumy))
                (expect "unclaimed-count = 1 (lumy outstanding)" 1 (STOAICO.UR_Global7))
                ""
            ]
        )
    )

(print "")
(print "")
