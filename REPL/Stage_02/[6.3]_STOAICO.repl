(begin-tx "TX-01b - #5M escrow-on-empty: inject into the empty vault parks it as zombie")
(namespace "ouronet-ns")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(print "=== TX-01b — #5M: A_Inject into a vault WITH NO STAKERS escrows (no div-by-zero) ===")
(env-sigs [{ "key": "PK_AncientHodler", "caps": [] }])
;; Fresh vault, no contributions yet → vault-score == 0. Injecting 3M must NOT divide by zero — it
;; parks the amount as zombie-rewards, to be distributed by the next non-zero-score inject.
(STOAICO.A_Inject KST.ANHD KST.ANHD 3000000.0)
(map print
    [
        (format "escrow => zombie={} supply={} rps={} round={}"
            [(STOAICO.UR_Global12) (STOAICO.UR_Global4) (STOAICO.UR_Global6) (STOAICO.UR_Global11)])
        (expect "#5M: 3M escrowed as zombie-rewards (no crash on empty vault)" 3000000.0 (STOAICO.UR_Global12))
        (expect "#5M: the 3M is held in wstoa-supply" 3000000.0 (STOAICO.UR_Global4))
        (expect "#5M: nothing distributed — current-rps still 0" 0.0 (STOAICO.UR_Global6))
        (expect "#5M: no distribution-round opened while escrowed (still 0)" 0 (STOAICO.UR_Global11))
        ""
    ]
)
(env-sigs [])
(commit-tx)
;;||>>>>>>>>>>>>>>>>>>>>>>>>>
