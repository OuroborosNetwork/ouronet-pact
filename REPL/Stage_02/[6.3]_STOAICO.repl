(begin-tx "TX-03 - #1C idempotency + inject barrier")
(namespace "ouronet-ns")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(print "=== TX-03 — #1C: double-collect rejected + inject barrier while a straggler is outstanding ===")
(env-sigs
    [
        { "key": "PK_AncientHodler", "caps": [] }
        { "key": "PK_LPAD", "caps": [] }
        { "key": "PK_Emma", "caps": [] }
        { "key": "PK_Lumy", "caps": [] }
    ]
)
(let ((emma:string KST.EMMA))
    (map print
        [
            ;; THE drain-killer: a second collect in the same distribution-round is rejected outright.
            (expect-failure
                "#1C: emma double-collect rejected (already collected this distribution round)"
                "has already collected this distribution round"
                (STOAICO.C_Collect KST.ANHD emma))
            ;; The barrier: a new inject cannot open until the previous round is fully collected.
            (expect-failure
                "#1C: A_Inject blocked while lumy is still uncollected (unclaimed-count != 0)"
                "previous distribution-round not fully collected"
                (STOAICO.A_Inject KST.ANHD KST.ANHD 1000.0))
            ""
        ]
    )
)
(env-sigs [])
(commit-tx)
;;||>>>>>>>>>>>>>>>>>>>>>>>>>
;;|| NEXT                   >
;;||>>>>>>>>>>>>>>>>>>>>>>>>>
(begin-tx "TX-04 - #1C admin flush: push-collect straggler, conserve, unblock")
(namespace "ouronet-ns")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(print "=== TX-04 — #1C: admin flush push-collects lumy (delivered to lumy), conserves, clears barrier ===")
(env-sigs
    [
        { "key": "PK_AncientHodler", "caps": [] }
        { "key": "PK_LPAD", "caps": [] }
        { "key": "PK_Emma", "caps": [] }
        { "key": "PK_Lumy", "caps": [] }
    ]
)
(let
    (
        (emma:string KST.EMMA)
        (lumy:string KST.LUMY)
        (ref-DPTF:module{DemiourgosPactTrueFungibleV2} DPTF)
        (wstoa-id:string (STOAICO.UR_Global8))
    )
    ;; Preflight lists exactly the straggler; the admin flush push-collects it (last => dust sweep).
    (map print
        [
            (format "URH_UncollectedAccounts => {}" [(STOAICO.URH_UncollectedAccounts)])
            (expect "URH preflight lists exactly the straggler lumy" [lumy] (STOAICO.URH_UncollectedAccounts))
        ]
    )
    (print (format "flush => {}" [(STOAICO.AA_FlushUncollected KST.ANHD)]))
    (let
        (
            (emma-bal:decimal (ref-DPTF::UR_AccountSupply wstoa-id emma))
            (lumy-bal:decimal (ref-DPTF::UR_AccountSupply wstoa-id lumy))
        )
        (map print
            [
                (format "emma wSTOA={} lumy wSTOA={} vault-supply={}" [emma-bal lumy-bal (STOAICO.UR_Global4)])
                (expect "lumy received its wSTOA via the flush (>0)" true (> lumy-bal 0.0))
                (expect "lumy stamped collected for round 1" 1 (STOAICO.UR_User5 lumy))
                (expect "unclaimed-count cleared to 0 (inject barrier now open)" 0 (STOAICO.UR_Global7))
                (expect "vault wstoa-supply fully conserved to 0 (dust to the last collector)" 0.0 (STOAICO.UR_Global4))
                ;; delta = (emma+lumy now) - (emma+lumy baseline captured at TX-00c) == 10M distributed,
                ;; boot-position-independent (immune to any pre-existing residue on the shared accounts).
                (expect "CONSERVATION: emma + lumy wSTOA delta == 10,000,000 injected" 10000000.0
                    (- (+ emma-bal lumy-bal) (read-decimal "stoaico-wstoa-base")))
                ""
            ]
        )
    )
)
(env-sigs [])
(commit-tx)
;;||>>>>>>>>>>>>>>>>>>>>>>>>>
;;|| NEXT                   >
;;||>>>>>>>>>>>>>>>>>>>>>>>>>
(begin-tx "TX-06M - #6M post-ICO stake earns NO urSTOA (ICO-phase-only)")
(namespace "ouronet-ns")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(print "=== TX-06M — #6M: after the ICO concludes (distribution-round >= 1) contributions earn no urSTOA ===")
(env-sigs [{ "key": "PK_AncientHodler", "caps": [] }])
;; The ICO concluded at the first inject (round is now 1). A further admin stake must NOT earn urSTOA:
;; the global urstoa-left is untouched and the contributor's urstoa-earned is not re-credited — so a
;; later collect can never double-mint (pre-fix, this stake re-earned floor(new-score/5) urSTOA).
(let
    (
        (emma:string KST.EMMA)
        (urstoa-left-before:integer (STOAICO.UR_Global2))
        (emma-earned-before:integer (STOAICO.UR_User2 KST.EMMA))
    )
    (STOAICO.A_Stake KST.ANHD emma 5000.0)
    (map print
        [
            (format "round={} urstoa-left {} -> {} · emma urstoa-earned {} -> {}"
                [(STOAICO.UR_Global11) urstoa-left-before (STOAICO.UR_Global2) emma-earned-before (STOAICO.UR_User2 emma)])
            (expect "#6M: ICO has concluded (distribution-round >= 1)" true (>= (STOAICO.UR_Global11) 1))
            (expect "#6M: post-ICO stake earns NO urSTOA — global urstoa-left unchanged" urstoa-left-before (STOAICO.UR_Global2))
            (expect "#6M: post-ICO stake does not re-credit emma's urstoa-earned" emma-earned-before (STOAICO.UR_User2 emma))
            ""
        ]
    )
)
(env-sigs [])
(commit-tx)
(print "=== END [6.3]_STOAICO.repl (with #1C + #5M + #6M proofs) ===")
;;||>>>>>>>>>>>>>>>>>>>>>>>>>
;;|| NEXT                   >
;;||>>>>>>>>>>>>>>>>>>>>>>>>>
(begin-tx "TX-TAL - STOAICO|C_Collect over the TALOS path, and a round-2 DEADLOCK")
(namespace "ouronet-ns")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(print "=== TX-TAL — the Talos wrapper, and the zero-amount mint that FROZE the vault (fixed) ===")
;; Two things at once.
;;
;; (a) Every collect above calls STOAICO.C_Collect DIRECTLY on the core module. That is not the
;;     supported client path and it bills NOTHING: Talos is the only place IGNIS is collected, so
;;     a suite that only calls the core proves the state machine and skips the whole gas model.
;;     TS02-CPAD::STOAICO|C_Collect -- the sole gas-funded entry -- had no live invocation
;;     anywhere in the suite.
;;
;; (b) DEFECT FOUND HERE, AND FIXED 2026-09-14. Exercising it exposed a deadlock in the SECOND
;;     distribution round. The diagnosis below is kept in full because the MECHANISM is the lesson;
;;     the assertions are now the positive collect it asked for.
;;     XI_CollectFor (05_STOAICO.pact:496) mints the account's urSTOA UNCONDITIONALLY:
;;
;;         (ref-TS01-C1::DPTF|C_Mint patron urSTOA-id DEMIPAD|SC_NAME urSTOA-supply false)
;;         (if (!= urSTOA-supply 0.0) <multi-transfer> <single-transfer>)
;;
;;     The `if` guards the DELIVERY against a zero amount. The MINT above it is not guarded, and
;;     DPTF::UEV_Amount refuses a zero-amount mint. An account's urSTOA entitlement is zeroed by
;;     its FIRST collect, so from its second collect onward urSTOA-supply is 0.0 and the whole
;;     transaction aborts -- even though it still has real wSTOA rewards waiting (probe below
;;     shows emma with 0 urSTOA and ~309 claimable wSTOA).
;;
;;     This is not an end-of-ICO edge case. It is every account, every round after the first, and
;;     it is a DEADLOCK rather than a nuisance:
;;       * C_Collect aborts, so the account cannot self-collect;
;;       * AA_FlushUncollected shares XI_CollectFor, so the admin cannot push-collect either;
;;       * A_Inject is barred while unclaimed-count != 0, so no new round can open.
;;     The vault stops paying and cannot be restarted from any entrypoint.
;;
;;     THE FIX APPLIED: the mint moved INSIDE the guard the delivery already had, and the wSTOA
;;     leg guarded on the same principle (a staker whose RPS delta is zero has nothing to transfer
;;     either, and a zero transfer is refused by the same UEV_Amount). Steps 2-6 of XI_CollectFor
;;     still run in every branch, which is what actually clears the straggler out of
;;     <unclaimed-count> and lets the next round open. IGNIS's own C_TransferDalosFuel documents
;;     exactly this lesson ("A ZERO amount is a NO-OP, not a transfer ... passing 0.0 aborts the
;;     whole transaction") -- it simply had not been applied here.
;;
;;     WHAT THE ASSERTIONS NOW PROVE: emma collects, the wSTOA she was owed reaches her, she is
;;     marked collected, and <unclaimed-count> falls -- that last one is the difference between
;;     "the abort is gone" and "the DEADLOCK is gone", because it is the barrier that had frozen
;;     A_Inject. She is paid with no urSTOA leg at all, which is the exact shape that used to abort.
(env-sigs
    [
        { "key": "PK_AncientHodler", "caps": [] }
        { "key": "PK_LPAD", "caps": [] }
        { "key": "PK_Emma", "caps": [] }
        { "key": "PK_Lumy", "caps": [] }
    ]
)
;; A fresh inject opens the next distribution-round and re-arms both stakers.
(STOAICO.A_Inject KST.ANHD KST.ANHD 1000.0)
(let
    (
        (ref-DALOS:module{OuronetDalosV2} DALOS)
        (ref-DPTF:module{DemiourgosPactTrueFungibleV2} DPTF)
        (ref-CPAD:module{CitizenLaunchpadTalosV2} TS02-CPAD)
        (emma:string KST.EMMA)
        (lumy:string KST.LUMY)
        (patron:string KST.ANHD)
    )
    (let
        (
            (gas-id:string (ref-DALOS::UR_IgnisID))
            (wstoa-id:string (STOAICO.UR_Global8))
            (dround:integer (STOAICO.UR_Global11))
            (wstoa-before:decimal (ref-DPTF::UR_AccountSupply (STOAICO.UR_Global8) KST.EMMA))
        )
        (map print
            [
                (expect "<<TX-TAL>> the inject opened a new distribution-round" true (>= dround 2))
                (expect "<<TX-TAL>> both stakers are re-armed for it" 2 (STOAICO.UR_Global7))
                (expect "<<TX-TAL>> emma has not collected this round yet"
                    true (< (STOAICO.UR_User5 emma) dround))
                ;;The two halves of the trap, side by side.
                (expect "<<TX-TAL>> emma's urSTOA entitlement was zeroed by her FIRST collect"
                    0 (STOAICO.UR_User2 emma))
                (expect "<<TX-TAL>> ...yet she has real wSTOA rewards waiting in this round"
                    true (> (STOAICO.URC_ClaimableRewards emma) 0.0))
                ;;...and the global urSTOA pool is nowhere near exhausted, so this is a per-account
                ;;bug, not the ICO running out of urSTOA.
                (expect "<<TX-TAL>> the global urSTOA pool still has plenty left"
                    true (> (STOAICO.UR_Global2) 0))
                ;;THE FIX, VERIFIED. Each line below replaces an `expect-failure` that pinned one
                ;;closed exit of the deadlock, and the first is the proof that matters: emma is PAID.
                (expect "<<TX-TAL>> the Talos self-collect now succeeds on a zero urSTOA entitlement"
                    true (> (length (ref-CPAD::STOAICO|C_Collect patron emma)) 0))
                ;;...and it is a real payout, not a no-op that merely stopped aborting. This is the
                ;;wSTOA that was STRANDED: owed, counted, and undeliverable through any entrypoint.
                (expect "<<TX-TAL>> ...and the wSTOA she was owed actually reached her"
                    true (> (ref-DPTF::UR_AccountSupply wstoa-id emma) wstoa-before))
                (expect "<<TX-TAL>> ...she is now marked collected for this round"
                    true (>= (STOAICO.UR_User5 emma) dround))
                ;;the straggler left <unclaimed-count> -- the barrier that had frozen the whole
                ;;vault. This is the assertion that says the DEADLOCK, not merely the abort, is gone.
                (expect "<<TX-TAL>> ...and the unclaimed count fell, unblocking the inject barrier"
                    1 (STOAICO.UR_Global7))
                ;;non-vacuity for the payout: her urSTOA entitlement really was zero going in, so
                ;;this is the exact shape that used to abort.
                (expect "<<TX-TAL>> ...and she was paid with NO urSTOA leg at all"
                    0 (STOAICO.UR_User2 emma))
            ]
        )
    )
)
(env-sigs [])
(commit-tx)

;;|| NEXT >
;;
(begin-tx "TX-ICO-K8 — the preview quoted 88x the real cost, on the NORMAL state")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(namespace "ouronet-ns")
;;==== TX-ICO-K8 · 01 · preview/exec cost parity for the reward collect ====
(print "--- [TX-ICO-K8 · 01 · preview/exec cost parity for the reward collect] ---")
;;<<RT-K-008>> FAMILY: K | STATUS: FIXED
;;HYPOTHESIS: `INFO_Collect` was the ONE client-facing cost preview in the tree named by no test at
;;            all -- found not by suspicion but by counting the population, after the coverage tool
;;            that reports on previews turned out to scan three HARDCODED files and to have
;;            reported "401 of 401 measured, 0 never named" about a set it had defined to exclude
;;            the gaps. An unmeasured preview is a number a client is shown and nobody checks.
;;METHOD:     read the preview's `ignis-need`, then drive the real collect through the citizen
;;            Talos and measure the patron's IGNIS balance across it. Preview against charge, one
;;            transaction, nothing else moving.
;;RESULT:     FIXED -- and the gap was not small. Preview said **88.0** (mint leg 87.0 + transfer
;;            leg 1.0) for an operation that charged **1.0**.
;;
;;WHY, AND WHY IT IS THE NORMAL CASE RATHER THAN AN EDGE. `XI_CollectFor` used to mint urSTOA
;;unconditionally; the 2026-09-14 vault-deadlock fix moved that mint INSIDE a
;;`(!= urSTOA-supply 0.0)` guard, because a zero-amount mint is refused and the vault deadlocked.
;;That fix repaired the EXECUTOR and left `URCi_Collect` -- the reader the preview wraps -- with its
;;mint still outside the guard. And the collect that zeroes an account's urSTOA is its FIRST one, so
;;the two paths disagreed on EVERY SUBSEQUENT ROUND. The disagreeing case is the ordinary one.
;;
;;The fix mirrors the executor's branch into the reader. This block asserts the state that makes it
;;the interesting case, so a fixture drifting to non-zero urSTOA turns the PRECONDITION red rather
;;than quietly making the parity check trivial.
(env-sigs
    [
        { "key": "PK_AncientHodler", "caps": [] }
        { "key": "PK_Florin", "caps": [] }
        { "key": "PK_Lumy", "caps": [] }
    ]
)
(let
    (
        (ref-DPTF:module{DemiourgosPactTrueFungibleV2} DPTF)
        (ref-DALOS:module{OuronetDalosV2} DALOS)
        (ref-TS02-CPAD:module{CitizenLaunchpadTalosV2} TS02-CPAD)
    )
    (let
        (
            (straggler:string (at 0 (STOAICO.URH_UncollectedAccounts)))
            (ignis-id:string (ref-DALOS::UR_IgnisID))
        )
        (let
            (
                ;;Ordered: quote and balance BEFORE, charge measured across the call.
                (urstoa:integer (STOAICO.UR_User2 straggler))
                (quoted:decimal
                    (at "ignis-need" (at "ignis" (STOAICO.INFO_Collect KST.ANHD straggler))))
                (before:decimal (ref-DPTF::UR_AccountSupply ignis-id KST.ANHD))
            )
            (ref-TS02-CPAD::STOAICO|C_Collect KST.ANHD straggler)
            (map print
                [
                    ;;THE PRECONDITION. Zero urSTOA is what makes the executor skip its mint leg,
                    ;;and therefore what the reader has to agree with. If this ever goes non-zero,
                    ;;this line goes red and says the case below stopped being the interesting one.
                    (expect "<<RT-K-008>> the straggler's urSTOA is zero, so the executor skips its mint leg"
                        0 urstoa)
                    ;;NON-VACUITY: a real quote, not a zero that would match anything.
                    (expect "<<RT-K-008>> the preview quotes a positive cost"
                        true (> quoted 0.0))
                    ;;THE PARITY. Before the fix this read 46.64 against a charge of 0.53.
                    (expect "<<RT-K-008>> the preview quotes EXACTLY what the collect charges"
                        quoted
                        (- before (ref-DPTF::UR_AccountSupply ignis-id KST.ANHD)))
                ]
            )
        )
    )
    ""
)
(env-sigs [])
(rollback-tx)
;;ROLLED BACK, not committed. The first draft of this block ended on `commit-tx` and the collect it
;;drives CONSUMED the last unclaimed straggler -- the exact fixture that the RT-E-001 attack in
;;`[RT-E]_Sequencing.repl` needs, since it is about what the vault pays the LAST claimant. The gate
;;caught it: RT-E-001 went red with "the rightful last claimant is still paid the WHOLE vault".
;;(The tag is written bare here, not in `<<...>>` at line start: the attack register scans every
;;.repl for that form, so quoting another block's tag in a comment registers a malformed header --
;;which is how this very file failed the gate a second time.)
;;A parity measurement has no business mutating shared state; the assertions are all made INSIDE the
;;transaction, so rolling back costs nothing and leaves the fixture for the suite that needs it.