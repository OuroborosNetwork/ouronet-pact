;;
;; REPL/Stage_02/[6.4]_AQP-EXHAUSTIVE-FVT-ADMIN.repl — FVT C_Control / C_Toggle* / C_SetCommonDenominator
;;
(print "")
(print "================================================================")
(print "FILE  REPL/Stage_02/[6.4]_AQP-EXHAUSTIVE-FVT-ADMIN.repl")
(print "================================================================")
(print "")
;;
(begin-tx "TX-AQP-FA01 - FVT C_ToggleScoreLink + C_ToggleRewardLink round-trip")
(print "")
(print "=== TX-AQP-FA01 — Toggle score/reward links on CodingDivisionTreasury =========")
(namespace "ouronet-ns")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(let
    (
        (patron:string KST.ANHD)
        (ref-U|DALOS:module{UtilityDalosV1} U|DALOS)
        (ref-DALOS:module{OuronetDalosV1} DALOS)
        (ref-TS02-C3:module{TalosStageTwo_ClientThreeV1} TS02-C3)
        (ref-FVT:module{AcquisitionFarmsVaultsTreasuriesV1} AQP-FVT)
        (fvt-id:string (ref-U|DALOS::UDC_Makeid "CodingDivisionTreasury"))
        (score-id:string (ref-U|DALOS::UDC_Makeid "TheCodingDivision"))
        (wstoa-id:string (ref-DALOS::UR_WrappedStoaID))
    )
    (env-sigs [{ "key": "PK_AncientHodler", "caps": [] }])
    (print (expect (format "<<TX-AQP-FA01>> scorelink enabled pre got={}" [(ref-FVT::UR_FVT-SL|Enabled fvt-id score-id)]) true (ref-FVT::UR_FVT-SL|Enabled fvt-id score-id)))
    (print (format "<(C_ToggleScoreLink disable)> => \"{}\"" [(ref-TS02-C3::AQP-FVT|C_ToggleScoreLink patron fvt-id score-id false)]))
    (print (expect (format "<<TX-AQP-FA01>> scorelink disabled got={}" [(ref-FVT::UR_FVT-SL|Enabled fvt-id score-id)]) false (ref-FVT::UR_FVT-SL|Enabled fvt-id score-id)))
    (print (format "<(C_ToggleScoreLink enable)> => \"{}\"" [(ref-TS02-C3::AQP-FVT|C_ToggleScoreLink patron fvt-id score-id true)]))
    (print (expect (format "<<TX-AQP-FA01>> scorelink re-enabled got={}" [(ref-FVT::UR_FVT-SL|Enabled fvt-id score-id)]) true (ref-FVT::UR_FVT-SL|Enabled fvt-id score-id)))
    (print (format "<(C_ToggleRewardLink Wstoa disable)> => \"{}\"" [(ref-TS02-C3::AQP-FVT|C_ToggleRewardLink patron fvt-id wstoa-id false)]))
    (print (expect (format "<<TX-AQP-FA01>> reward disabled got={}" [(ref-FVT::UR_FVT-RG|RewardEnabled fvt-id wstoa-id)]) false (ref-FVT::UR_FVT-RG|RewardEnabled fvt-id wstoa-id)))
    (print (format "<(C_ToggleRewardLink Wstoa enable)> => \"{}\"" [(ref-TS02-C3::AQP-FVT|C_ToggleRewardLink patron fvt-id wstoa-id true)]))
    (print (expect (format "<<TX-AQP-FA01>> reward re-enabled got={}" [(ref-FVT::UR_FVT-RG|RewardEnabled fvt-id wstoa-id)]) true (ref-FVT::UR_FVT-RG|RewardEnabled fvt-id wstoa-id)))
)
(env-sigs [])
(commit-tx)
(print "")
;;
(begin-tx "TX-AQP-FA02 - FVT C_Control can-upgrade flag")
(print "")
(print "=== TX-AQP-FA02 — C_Control on SnakesTreasury ================================")
(namespace "ouronet-ns")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(let
    (
        (patron:string KST.ANHD)
        (ref-U|DALOS:module{UtilityDalosV1} U|DALOS)
        (ref-TS02-C3:module{TalosStageTwo_ClientThreeV1} TS02-C3)
        (ref-FVT:module{AcquisitionFarmsVaultsTreasuriesV1} AQP-FVT)
        (fvt-id:string (ref-U|DALOS::UDC_Makeid "SnakesTreasury"))
        (can-upgrade-pre:bool (ref-FVT::UR_FVT|CanUpgrade fvt-id))
    )
    (env-sigs [{ "key": "PK_AncientHodler", "caps": [] }])
    (print (format "<(can-upgrade pre)> => \"{}\"" [can-upgrade-pre]))
    (print (format "<(C_Control can-upgrade=false)> => \"{}\"" [
        (ref-TS02-C3::AQP-FVT|C_Control patron fvt-id false (ref-FVT::UR_FVT|CanChangeOwner fvt-id))
    ]))
    (print (expect (format "<<TX-AQP-FA02>> can-upgrade false got={}" [(ref-FVT::UR_FVT|CanUpgrade fvt-id)]) false (ref-FVT::UR_FVT|CanUpgrade fvt-id)))
    (print "<<TX-AQP-FA02>> NOTE: cannot C_Control restore once can-upgrade=false (cap requires current can-upgrade true)")
)
(env-sigs [])
(commit-tx)
(print "")
;;
(begin-tx "TX-AQP-FA03 - OuroLpFarm C_SetCommonDenominator echo")
(print "")
(print "=== TX-AQP-FA03 — Farm common-denominator read (OURO DPTF id) ================")
(namespace "ouronet-ns")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(let
    (
        (patron:string KST.ANHD)
        (ouro-id:string "OURO-98c486052a51")
        (ref-U|DALOS:module{UtilityDalosV1} U|DALOS)
        (ref-FVT:module{AcquisitionFarmsVaultsTreasuriesV1} AQP-FVT)
        (farm-id:string (ref-U|DALOS::UDC_Makeid "OuroLpFarm"))
        (farm-class:integer (try -1 (ref-FVT::UR_FVT|FvtClass farm-id)))
        (denom:decimal (try 0.0 (ref-FVT::URC_InjectDenominator farm-id)))
    )
    (env-sigs [{ "key": "PK_AncientHodler", "caps": [] }])
    (if (!= farm-class -1)
        (map print
            [
                (format "<(OuroLpFarm class)> => \"{}\"" [farm-class])
                (format "<(inject denominator)> => \"{}\"" [denom])
                (expect (format "<<TX-AQP-FA03>> farm class=0 got={}" [farm-class]) 0 farm-class)
                (expect (format "<<TX-AQP-FA03>> farm denom>0 got={}" [denom]) true (> denom 0.0))
            ]
        )
        (print "SKIP TX-AQP-FA03: OuroLpFarm not issued on REPL")
    )
)
(env-sigs [])
(commit-tx)
(print "")
(print "=== END [6.4]_AQP-EXHAUSTIVE-FVT-ADMIN.repl =================================")
