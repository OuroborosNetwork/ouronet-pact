        (print "--- [TX-FVT-08 · 01 · CC_FullVacate (agnostic, class-2 OF; pool-id only)] ---")
        (print (format "<(TS02-C3.AQP-POOL|CC_FullVacate)> => \"{}\"" [
            (ref-TS02-C3::AQP-POOL|CC_FullVacate patron pool-id)
        ]))
        (print "--- [TX-FVT-08 · 02 · post full-vacate expects] ---")
        (let
            (
                (inv-post:integer (at "leg-count" (ref-VCT::URH_VacateOfInventory pool-id dpof-id)))
