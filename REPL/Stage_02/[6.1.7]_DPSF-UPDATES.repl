;;
;; REPL/Stage_02/[6.1.7]_DPSF-UPDATES.repl — DPSF tail-op coverage (#79 Phase 2)
;;   Reuses TSFS (SFT, set-class 1 from [6.1.3]; owner holds nonces). Covers the uncovered DPSF
;;   ops: all UpdateSetNonce* + RemoveSetNonceScore + UpdateNonces + BulkTransfer + UpgradeBranding.
;;
(print "")
(print "================================================================")
(print "FILE  REPL/Stage_02/[6.1.7]_DPSF-UPDATES.repl  (DPSF tail ops)")
(print "================================================================")
(print "")

;;================================================================================
(begin-tx "TX-SU-001 - DPSF set-nonce updaters on TSFS set-class 1 (nos=true native)")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(namespace "ouronet-ns")
;;==== TX-SU-001 · 01 · env-sigs (caps) ====
(print "--- [TX-SU-001 · 01 · env-sigs] ---")
(env-sigs [ { "key": "PK_AncientHodler", "caps": [] } ])
;;==== TX-SU-001 · 02 · set-nonce updates ====
(print "--- [TX-SU-001 · 02 · set-nonce updates] ---")
(let
    (
        (ref-DPDC-UDC:module{DpdcUdcV2} DPDC-UDC)
        (ref-TS02-C1:module{TalosStageTwo_ClientOneV2} TS02-C1)
        (id:string "TSFS-98c486052a51")
        (patron:string KST.ANHD)
        (sc:integer 1)
        (type:object{DpdcUdcV2.URI|Type} (ref-DPDC-UDC::UDC_URI|Type true false false false false false false))
        (nd2:object{DpdcUdcV2.DPDC|NonceData}
            (ref-DPDC-UDC::UDC_NonceData
                0.0 3.0 "SetUpd" "SFT set nonce updated" (ref-DPDC-UDC::UDC_NoMetaData) type
                (ref-DPDC-UDC::UDC_ZeroURI|Data) (ref-DPDC-UDC::UDC_ZeroURI|Data) (ref-DPDC-UDC::UDC_ZeroURI|Data)
            )
        )
    )
    (ref-TS02-C1::DPSF|C_UpdateSetNonce patron id patron sc true nd2)
    (ref-TS02-C1::DPSF|C_UpdateSetNonces patron id patron [sc] true [nd2])
    (ref-TS02-C1::DPSF|C_UpdateSetNonceRoyalty patron id patron sc true 3.0)
    (ref-TS02-C1::DPSF|C_UpdateSetNonceIgnisRoyalty patron id patron sc true 2.0)
    (ref-TS02-C1::DPSF|C_UpdateSetNonceName patron id patron sc true "SetName")
    (ref-TS02-C1::DPSF|C_UpdateSetNonceDescription patron id patron sc true "SetDesc")
    (ref-TS02-C1::DPSF|C_UpdateSetNonceScore patron id patron sc true 5.0)
    (ref-TS02-C1::DPSF|C_UpdateSetNonceMetaData patron id patron sc true (ref-DPDC-UDC::UDC_NoMetaData))
    (ref-TS02-C1::DPSF|C_UpdateSetNonceURI patron id patron sc true type
        (ref-DPDC-UDC::UDC_ZeroURI|Data) (ref-DPDC-UDC::UDC_ZeroURI|Data) (ref-DPDC-UDC::UDC_ZeroURI|Data))
    (ref-TS02-C1::DPSF|C_RemoveSetNonceScore patron id patron sc true)
    (print "<<TX-SU-001>> DPSF all 10 UpdateSetNonce* + RemoveSetNonceScore executed OK")
)
(print "===^^^===")
(commit-tx)
;;================================================================================
(begin-tx "TX-SU-002 - DPSF native UpdateNonces + BulkTransfer + UpgradeBranding")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(namespace "ouronet-ns")
;;==== TX-SU-002 · 01 · env-sigs (STOA fee caps for UpgradeBranding) ====
(print "--- [TX-SU-002 · 01 · env-sigs] ---")
(env-sigs
    [
        { "key": "PK_AncientHodler", "caps": [] }
        { "key": "6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263",
          "caps":
            [
                (coin.TRANSFER "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263"
                    "k:50d6c59b21e5e6e55baecaa75a1007de37576bde12d8230dc82459cc01b9484b" 1000.0)
                (coin.TRANSFER "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263"
                    "k:0cb30c0121ff919266121a99ff9359871818932211df94dae4137c29bc0e8f7e" 1000.0)
                (coin.TRANSFER "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263"
                    "c:XM-pkmuB5XUQlp87ZYSbfKt8qzmHY6O2EHAzMRVBt3k" 1000.0)
                (coin.TRANSFER "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263"
                    "c:iQQFWj6gWtpGEzhM_O5ekW1QtnQQy55R8BRPGhj_0FU" 1000.0)
            ]
        }
    ]
)
;;==== TX-SU-002 · 02 · UpdateNonces / BulkTransfer / UpgradeBranding ====
(print "--- [TX-SU-002 · 02 · native updates / transfer / branding] ---")
(let
    (
        (ref-DPDC-UDC:module{DpdcUdcV2} DPDC-UDC)
        (ref-TS02-C1:module{TalosStageTwo_ClientOneV2} TS02-C1)
        (id:string "TSFS-98c486052a51")
        (patron:string KST.ANHD)
        (emma:string KST.EMMA)
        (type:object{DpdcUdcV2.URI|Type} (ref-DPDC-UDC::UDC_URI|Type true false false false false false false))
        (nd2:object{DpdcUdcV2.DPDC|NonceData}
            (ref-DPDC-UDC::UDC_NonceData
                0.0 3.0 "NonceUpd" "SFT native nonce updated" (ref-DPDC-UDC::UDC_NoMetaData) type
                (ref-DPDC-UDC::UDC_ZeroURI|Data) (ref-DPDC-UDC::UDC_ZeroURI|Data) (ref-DPDC-UDC::UDC_ZeroURI|Data)
            )
        )
    )
    ;; native (non-set) nonce update on nonce 7 (owner holds 1000 of it, untouched by [6.1.3] sets)
    (ref-TS02-C1::DPSF|C_UpdateNonces patron id patron [7] true [nd2])
    ;; bulk transfer 100 units of nonce 7 to EMMA (account auto-deploys; method=false, standard acct)
    (ref-TS02-C1::DPSF|C_BulkTransfer patron id [[7]] [[100]] patron [emma] false)
    ;; premium branding upgrade (STOA fee)
    (ref-TS02-C1::DPSF|C_UpgradeBranding patron id 1)
    (print "<<TX-SU-002>> DPSF UpdateNonces + BulkTransfer + UpgradeBranding OK")
)
(print "===^^^===")
(commit-tx)
(print "")
(print "=== END FILE [6.1.7]_DPSF-UPDATES.repl (all 14 DPSF tail ops) ===")
