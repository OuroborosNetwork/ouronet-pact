(begin-tx "TX-SET-006 - Primordial NFT Make -> Break round trip, exact conservation")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(namespace "ouronet-ns")
;;==== TX-SET-006 · 01 · env-sigs (caps) ====
(print "--- [TX-SET-006 · 01 · env-sigs (caps)] ---")
(env-sigs [{ "key": "PK_AncientHodler", "caps": [] }])
;;==== TX-SET-006 · 02 · Make: choose nonce 1 (of [1 2]) + nonce 3 (of [3 4]) ====
(print "--- [TX-SET-006 · 02 · Make: choose nonce 1 (of [1 2]) + nonce 3 (of [3 4])] ---")
(let
    (
        (ref-DPDC:module{DpdcV2} DPDC)
        (ref-TS02-C2:module{TalosStageTwo_ClientTwoV2} TS02-C2)
        (owner:string KST.ANHD)
        (nft-id:string "TSFN-98c486052a51")
    )
    (map print
        [
            (format "<(TS02-C2.DPNF|C_Make [1 3])> => \"{}\""
                [(ref-TS02-C2::DPNF|C_Make owner owner nft-id [1 3] 1)])
        ]
    )
    (map print
        [
            (expect "<<TX-SET-006>> Make: nonce 1 (position 1 choice) consumed, supply drops to 0"
                0
                (ref-DPDC::UR_AccountNonceSupply owner nft-id false 1)
            )
            (expect "<<TX-SET-006>> Make: nonce 3 (position 2 choice) consumed, supply drops to 0"
                0
                (ref-DPDC::UR_AccountNonceSupply owner nft-id false 3)
            )
            (expect "<<TX-SET-006>> Make: new NFT set instance spawned at nonce 5, quantity 1"
                1
                (ref-DPDC::UR_AccountNonceSupply owner nft-id false 5)
            )
        ]
    )
    ""
)
;;==== TX-SET-006 · 03 · Break the spawned instance, exact conservation ====
(print "--- [TX-SET-006 · 03 · Break the spawned instance (nonce 5); exact conservation] ---")
(let
    (
        (ref-DPDC:module{DpdcV2} DPDC)
        (ref-TS02-C2:module{TalosStageTwo_ClientTwoV2} TS02-C2)
        (owner:string KST.ANHD)
        (nft-id:string "TSFN-98c486052a51")
    )
    (map print
        [
            (format "<(TS02-C2.DPNF|C_Break nonce 5)> => \"{}\""
                [(ref-TS02-C2::DPNF|C_Break owner owner nft-id 5)])
        ]
    )
    (map print
        [
            (expect "<<TX-SET-006>> Break: nonce 1 returned, supply restored to 1"
                1
                (ref-DPDC::UR_AccountNonceSupply owner nft-id false 1)
            )
            (expect "<<TX-SET-006>> Break: nonce 3 returned, supply restored to 1"
                1
                (ref-DPDC::UR_AccountNonceSupply owner nft-id false 3)
            )
            (expect "<<TX-SET-006>> Break: spawned instance (nonce 5) fully burned back to 0"
                0
                (ref-DPDC::UR_AccountNonceSupply owner nft-id false 5)
            )
        ]
    )
    ""
)
(commit-tx)
(print "")
(print "=== END TX-SET-006 ==================================================")
(print "")
