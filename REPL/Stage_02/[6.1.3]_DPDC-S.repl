            (expect "<<TX-SET-005>> Break: nonce 3 restored to the full 1,000 (exact conservation)"
                1000
                (ref-DPDC::UR_AccountNonceSupply owner sft-id true 3)
            )
            (expect "<<TX-SET-005>> Break: SC1 (nonce 11) restored to 5 (3 + 2)"
                5
                (ref-DPDC::UR_AccountNonceSupply owner sft-id true 11)
            )
            (expect "<<TX-SET-005>> Break: SC3 set-token (nonce 13) fully drained back to 0"
                0
                (ref-DPDC::UR_AccountNonceSupply owner sft-id true 13)
            )
        ]
