        [
            (format "<(TS02-C1.DPSF|C_Make SC1 x5)> => \"{}\""
                [(ref-TS02-C1::DPSF|C_Make owner owner sft-id [1 2] 1 5)])
            ;;DPDC Audit #32M regression coverage: nonces ordered [primordial (3), composite (11)]
            (format "<(TS02-C1.DPSF|C_Make SC3 x2 [nonce3, SC1])> => \"{}\""
