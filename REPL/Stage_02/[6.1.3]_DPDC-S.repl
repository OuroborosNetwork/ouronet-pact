(env-sigs [{ "key": "PK_AncientHodler", "caps": [] }])
;;==== TX-SET-004 · 02 · Re-make 5 SC1 units, then Make 3 SC2 (Composite) sets from 3 of them ====
(print "--- [TX-SET-004 · 02 · re-make 5 SC1 units; Make 3 SC2 (Composite) sets from 3 of them] ---")
(let
    (
        (ref-DPDC:module{DpdcV2} DPDC)
        (ref-TS02-C1:module{TalosStageTwo_ClientOneV2} TS02-C1)
        (owner:string KST.ANHD)
        (sft-id:string "TSFS-98c486052a51")
    )
    (map print
        [
            (format "<(TS02-C1.DPSF|C_Make SC1 x5)> => \"{}\""
                [(ref-TS02-C1::DPSF|C_Make owner owner sft-id [1 2] 1 5)])
            (format "<(TS02-C1.DPSF|C_Make SC2 x3 from SC1)> => \"{}\""
                [(ref-TS02-C1::DPSF|C_Make owner owner sft-id [11] 2 3)])
        ]
