(begin-tx "TX-SET-007 - Admin mutations: ToggleSet / RenameSet / EnableSetClassFragmentation")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(namespace "ouronet-ns")
;;==== TX-SET-007 · 01 · env-sigs (caps) ====
(print "--- [TX-SET-007 · 01 · env-sigs (caps)] ---")
(env-sigs [{ "key": "PK_AncientHodler", "caps": [] }])
;;==== TX-SET-007 · 02 · ToggleSet off -> EnableFragmentation rejected (#30M) -> ToggleSet on ====
(print "--- [TX-SET-007 · 02 · ToggleSet off rejects EnableFragmentation (#30M); ToggleSet back on] ---")
(let
    (
        (ref-DPDC-S:module{DpdcSetsV2} DPDC-S)
        (ref-DPDC-UDC:module{DpdcUdcV2} DPDC-UDC)
        (ref-TS02-C1:module{TalosStageTwo_ClientOneV2} TS02-C1)
        (owner:string KST.ANHD)
        (sft-id:string "TSFS-98c486052a51")
        (type:object{DpdcUdcV2.URI|Type} (ref-DPDC-UDC::UDC_URI|Type true false false false false false false))
        (nd:object{DpdcUdcV2.DPDC|NonceData}
            (ref-DPDC-UDC::UDC_NonceData
                0.0 0.0 "FragSC1" "Fragmentation marker" (ref-DPDC-UDC::UDC_NoMetaData) type
                (ref-DPDC-UDC::UDC_ZeroURI|Data) (ref-DPDC-UDC::UDC_ZeroURI|Data) (ref-DPDC-UDC::UDC_ZeroURI|Data)
            )
        )
    )
    (map print
        [
            (format "<(TS02-C1.DPSF|C_ToggleSet SC1 off)> => \"{}\""
                [(ref-TS02-C1::DPSF|C_ToggleSet owner sft-id 1 false)])
        ]
    )
    (map print
        [
            (expect "<<TX-SET-007>> SC1 active-state is false after toggling off"
                false
                (ref-DPDC-S::UR_IzSetActive sft-id true 1)
            )
            (expect-failure
                "<<TX-SET-007>> EnableSetClassFragmentation on a deactivated set-class is rejected (DPDC Audit #30M)"
                (ref-TS02-C1::DPSF|C_EnableSetClassFragmentation owner sft-id 1 nd)
            )
        ]
    )
    (map print
        [
            (format "<(TS02-C1.DPSF|C_ToggleSet SC1 on)> => \"{}\""
                [(ref-TS02-C1::DPSF|C_ToggleSet owner sft-id 1 true)])
        ]
    )
    (map print
        [
            (expect "<<TX-SET-007>> SC1 active-state is true after toggling back on"
                true
                (ref-DPDC-S::UR_IzSetActive sft-id true 1)
            )
        ]
    )
    ""
)
;;==== TX-SET-007 · 03 · RenameSet then EnableSetClassFragmentation (now active) succeeds ====
(print "--- [TX-SET-007 · 03 · RenameSet; EnableSetClassFragmentation on the now-active SC1 succeeds] ---")
(let
    (
        (ref-DPDC-S:module{DpdcSetsV2} DPDC-S)
        (ref-DPDC-UDC:module{DpdcUdcV2} DPDC-UDC)
        (ref-TS02-C1:module{TalosStageTwo_ClientOneV2} TS02-C1)
        (owner:string KST.ANHD)
        (sft-id:string "TSFS-98c486052a51")
        (type:object{DpdcUdcV2.URI|Type} (ref-DPDC-UDC::UDC_URI|Type true false false false false false false))
        (nd:object{DpdcUdcV2.DPDC|NonceData}
            (ref-DPDC-UDC::UDC_NonceData
                0.0 0.0 "FragSC1" "Fragmentation marker" (ref-DPDC-UDC::UDC_NoMetaData) type
                (ref-DPDC-UDC::UDC_ZeroURI|Data) (ref-DPDC-UDC::UDC_ZeroURI|Data) (ref-DPDC-UDC::UDC_ZeroURI|Data)
            )
        )
    )
    (map print
        [
            (format "<(TS02-C1.DPSF|C_RenameSet SC1)> => \"{}\""
                [(ref-TS02-C1::DPSF|C_RenameSet owner sft-id 1 "SC1-Renamed")])
        ]
    )
    (map print
        [
            (expect "<<TX-SET-007>> SC1's name is updated after rename"
                "SC1-Renamed"
                (ref-DPDC-S::UR_SetName sft-id true 1)
            )
        ]
    )
    (map print
        [
            (format "<(TS02-C1.DPSF|C_EnableSetClassFragmentation SC1)> => \"{}\""
                [(ref-TS02-C1::DPSF|C_EnableSetClassFragmentation owner sft-id 1 nd)])
        ]
    )
    (map print
        [
            (expect "<<TX-SET-007>> SC1 reads as fragmented after enabling fragmentation"
                true
                (ref-DPDC-S::UEV_IzSetClassFragmented sft-id true 1)
            )
        ]
    )
    ""
)
(commit-tx)
(print "")
(print "=== END TX-SET-007 ==================================================")
(print "")
(print "=== END FILE [6.1.3]_DPDC-S.repl ========================================")
(print "")
