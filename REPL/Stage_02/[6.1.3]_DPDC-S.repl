            (expect "<<TX-SET-005>> Full circle: SC1 set-token (nonce 11) back to 0"
                0
                (ref-DPDC::UR_AccountNonceSupply owner sft-id true 11)
            )
        ]
    )
    ""
)
(commit-tx)
(print "")
(print "=== END TX-SET-005 ==================================================")
(print "")
