(let
    (
        (ref-DPDC:module{DpdcV2} DPDC)
        (ref-TS02-C1:module{TalosStageTwo_ClientOneV2} TS02-C1)
        (owner:string KST.ANHD)
        (sft-id:string "TSFS-98c486052a51")
    )
    (map print
        [
            (format "<(TS02-C1.DPSF|C_Break SC2 x3)> => \"{}\""
                [(ref-TS02-C1::DPSF|C_Break owner owner sft-id 12 3)])
        ]
    )
    (map print
        [
            (expect "<<TX-SET-004>> Break: SC1 (nonce 11) restored to 5 (2 + 3)"
                5
                (ref-DPDC::UR_AccountNonceSupply owner sft-id true 11)
            )
            (expect "<<TX-SET-004>> Break: SC2 set-token (nonce 12) fully drained back to 0"
                0
                (ref-DPDC::UR_AccountNonceSupply owner sft-id true 12)
            )
        ]
    )
    (map print
        [
            (format "<(TS02-C1.DPSF|C_Break SC1 x5)> => \"{}\""
                [(ref-TS02-C1::DPSF|C_Break owner owner sft-id 11 5)])
        ]
    )
    (map print
        [
            (expect "<<TX-SET-004>> Full circle: nonce 1 restored to the full 1,000"
                1000
                (ref-DPDC::UR_AccountNonceSupply owner sft-id true 1)
            )
            (expect "<<TX-SET-004>> Full circle: nonce 2 restored to the full 1,000"
                1000
                (ref-DPDC::UR_AccountNonceSupply owner sft-id true 2)
            )
            (expect "<<TX-SET-004>> Full circle: SC1 set-token (nonce 11) back to 0"
                0
                (ref-DPDC::UR_AccountNonceSupply owner sft-id true 11)
            )
        ]
    )
    ""
)
(commit-tx)
(print "")
(print "=== END TX-SET-004 ==================================================")
(print "")
