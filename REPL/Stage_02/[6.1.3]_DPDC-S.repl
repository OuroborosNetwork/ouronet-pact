                3
                (ref-DPDC::UR_AccountNonceSupply owner sft-id true 12)
            )
        ]
    )
    ""
)
;;==== TX-SET-004 · 03 · Break the 3 SC2 sets; then break the remaining 5 SC1, full-circle ====
