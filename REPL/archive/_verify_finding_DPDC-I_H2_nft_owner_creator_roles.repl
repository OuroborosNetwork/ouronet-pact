;; Verification for DPDC Audit finding #11H (DPDC-I · H2): NFT genesis issuance with owner==creator wrote
;; role-exemption/role-modify-creator/role-modify-royalties = false into the Account table (the table that
;; actually gates those operations), so a solo NFT creator could never set a royalty on their own mint.
;; Fix: those three flags now write `true` in that branch, matching the SFT sibling.
(load "../Stage00_Sanboxes.repl")
(load "../Stage01_Tester.repl")
(load "../Stage_02/[0.1]_Interfaces.repl")
(load "../Stage_02/[2.1]_DpdcCore.repl")
(load "../Stage_02/[2.2]_DemiPad.repl")
(load "../Stage_02/[2.3]_EarningPools.repl")
(load "../Stage_02/[3]_Talos.repl")
(load "../Stage_02/[4.0]_Sovereign-Executor.repl")

(begin-tx "PROBE-H2 - issue a fresh NFT collection, owner==creator, mint a nonce, try to set its royalty")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(namespace "ouronet-ns")
(let
    (
        (ref-DALOS:module{OuronetDalosV2} DALOS)
        (owner:string KST.ANHD)
        (dpnf-price:decimal (ref-DALOS::UR_UsagePrice "dpnf"))
        (split-stoa:[decimal] (ref-DALOS::URC_SplitSTOAPrices owner dpnf-price))
    )
    (env-sigs
        [
            { "key": "PK_AncientHodler", "caps": [] }
            { "key": "6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263",
              "caps":
                [
                    (coin.TRANSFER "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263"
                        "k:50d6c59b21e5e6e55baecaa75a1007de37576bde12d8230dc82459cc01b9484b" (at 2 split-stoa))
                    (coin.TRANSFER "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263"
                        "k:0cb30c0121ff919266121a99ff9359871818932211df94dae4137c29bc0e8f7e" (at 0 split-stoa))
                    (coin.TRANSFER "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263"
                        "c:XM-pkmuB5XUQlp87ZYSbfKt8qzmHY6O2EHAzMRVBt3k" (at 3 split-stoa))
                    (coin.TRANSFER "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263"
                        "c:iQQFWj6gWtpGEzhM_O5ekW1QtnQQy55R8BRPGhj_0FU" (at 1 split-stoa))
                ]
            }
        ]
    )
)
(let
    (
        (ref-DPDC:module{DpdcV2} DPDC)
        (ref-DPDC-UDC:module{DpdcUdcV2} DPDC-UDC)
        (ref-TS02-C2:module{TalosStageTwo_ClientTwoV2} TS02-C2)
        (owner:string KST.ANHD)
        (creator:string KST.ANHD)
    )
    (print (format "ISSUE RESULT = {}"
        [(ref-TS02-C2::DPNF|C_Issue owner owner creator "SoloCreatorProbeNFT" "SCPN"
            true true true true true true true true)]))
    (let ((id:string "SCPN-98c486052a51"))
        (print (format "role-modify-royalties on owner BEFORE would-be-check: {}"
            [(ref-DPDC::UR_CA|R-ModifyRoyalties id false owner)]))
        (print (format "CREATE NONCE RESULT = {}"
            [(ref-TS02-C2::DPNF|C_Create owner id
                [(ref-DPDC-UDC::UDC_NonceData
                    0.0 0.0 "Solo Probe NFT #1" "bar" (ref-DPDC-UDC::UDC_NoMetaData)
                    ;; DPDC Audit #12Hb: at least one real asset-type flag + matching link required now.
                    (ref-DPDC-UDC::UDC_URI|Type true false false false false false false)
                    (ref-DPDC-UDC::UDC_URI|Data "ipfs://bafySoloProbe/primary.png" "" "" "" "" "" "")
                    (ref-DPDC-UDC::UDC_ZeroURI|Data) (ref-DPDC-UDC::UDC_ZeroURI|Data)
                )]
            )]))
        (print (format "SET ROYALTY RESULT = {}"
            [(ref-TS02-C2::DPNF|C_UpdateNonceRoyalty owner id owner 1 true 50.0)]))
        (print (format "royalty after set = {}" [(ref-DPDC::UR_N|Royalty (ref-DPDC::UR_NonceData id false 1))]))
    )
)
(commit-tx)
