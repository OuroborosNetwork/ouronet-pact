;; Verification for DPDC Audit finding #3C (DPDC-F · C2): "amount is never validated >0 anywhere in the
;; Make/Merge/Repurpose fragmentation call chain — a negative amount inverts credit/debit direction."
;; Claim under test: this was already closed as a side effect of Fix #1 (DPDC-C::UEV_Amount, the universal
;; credit/debit chokepoint), since C_MakeFragments/C_MergeFragments route their constituent leg through
;; DPDC-T::C_Transfer -> the same XI_CreditOrDebitDPDC. Never independently live-tested by name until now.
(load "../Stage00_Sanboxes.repl")
(load "../Stage01_Tester.repl")
(load "../Stage_02/[0.1]_Interfaces.repl")
(load "../Stage_02/[2.1]_DpdcCore.repl")
(load "../Stage_02/[2.2]_DemiPad.repl")
(load "../Stage_02/[2.3]_EarningPools.repl")
(load "../Stage_02/[3]_Talos.repl")
(load "../Stage_02/[4.0]_Sovereign-Executor.repl")

(begin-tx "PROBE-C3 - baseline (nonce 3 is already fragmentation-enabled by genesis)")
(namespace "ouronet-ns")
(let
    (
        (ref-DPDC:module{DpdcV2} DPDC)
        (id:string "DHOC-98c486052a51")
    )
    (print (format "BEFORE anhd nonce3 supply = {}" [(ref-DPDC::UR_AccountNonceSupply KST.ANHD id true 3)]))
)
(commit-tx)

(begin-tx "PROBE-C3 - control: legit C_MakeFragments (positive amount) must still work")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(namespace "ouronet-ns")
(env-sigs [{ "key": "PK_AncientHodler", "caps": [] }])
(let
    (
        (ref-DPDC:module{DpdcV2} DPDC)
        (ref-TS02-C1:module{TalosStageTwo_ClientOneV2} TS02-C1)
        (id:string "DHOC-98c486052a51")
    )
    (print (format "LEGIT MAKE-FRAGMENTS RESULT = {}"
        [(ref-TS02-C1::DPSF|C_MakeFragments KST.ANHD KST.ANHD id 3 100)]))
    (print (format "AFTER legit make: anhd nonce3 supply = {}" [(ref-DPDC::UR_AccountNonceSupply KST.ANHD id true 3)]))
    (print (format "AFTER legit make: anhd fragment(-3) supply = {}" [(ref-DPDC::UR_AccountNonceSupply KST.ANHD id true -3)]))
)
(commit-tx)

;;|| NEXT >
;; The exploit attempt: C_MakeFragments with a negative amount, submitted as its own real, uncaught
;; transaction (no expect-failure — matching real on-chain submission). EXPECTED: hard rejection before
;; commit-tx, ideally at UEV_Amount inside DPDC-C::XI_CreditOrDebitDPDC (proving Fix #1's chokepoint is what
;; catches it, not some new/separate guard).
(begin-tx "PROBE-C3 - the exploit: negative amount, submitted as a real uncaught transaction")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(namespace "ouronet-ns")
(env-sigs [{ "key": "PK_AncientHodler", "caps": [] }])
(let
    (
        (ref-TS02-C1:module{TalosStageTwo_ClientOneV2} TS02-C1)
        (id:string "DHOC-98c486052a51")
    )
    (ref-TS02-C1::DPSF|C_MakeFragments KST.ANHD KST.ANHD id 3 -100)
)
(commit-tx)
