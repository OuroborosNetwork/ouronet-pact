;;
(print "")
(print "================================================================")
(print "FILE  REPL/archive/triplet-diag.repl")
(print "================================================================")
(print "Legend (terminal observability): see ;; preface; echoes use <(…)> where helpful.")
(print "Source: ;;|| NEXT > between txs; ;;==== … · mm · … ==== + banner before each begin-tx.")
(print "")
;; Quick runner for triplet score diagnostic (loads boot chain, ~40s)
(load "Stage00_Sanboxes.repl")
