;; isolated RPS load probe: boot full stack, then deploy 04_RPS.pact on top
(load "Stage00_Sanboxes.repl")
(load "Stage01_Tester.repl")
(load "Stage02_Tester.repl")
(print "")
(print "=== RPS LOAD PROBE ===")
(begin-tx "deploy RPS")
(env-gasmodel "table")(env-gaslimit 100000000)(env-gas 0)
(namespace "ouronet-ns")
(env-sigs [{"key": "1a4e15d3c51e0b73e92644600487ba8eaae312e1a178b91801d54e13c1b350a5", "caps": []}])
(load "../1_SOVEREIGN/STAGE_02/2_Core/03_AQP/04_RPS.pact")
(print (format "<<<RPS loaded, {} GAS>>>" [(env-gas)]))
(commit-tx)
(print "=== RPS PROBE OK ===")
