;;
;; REPL/Stage00b_StoaBulkGasTests.repl - 5000-recipient bulk gas stress (after Stage00_Sanboxes.repl)
;;   Inter-tx:   ;;|| NEXT >
;;   Intra-tx:   ;;==== <TX label> - mm - <slug> ====  + (print "--- […] ---")
;;   <(REPL|env-gas)> gas after each tx; target chain limit 2_000_000
;;
(print "")
(print "================================================================")
(print "FILE  REPL/Stage00b_StoaBulkGasTests.repl")
(print "================================================================")
(print "Legend: <<…>> expect; <(REPL|env-gas)> gas; <(coin.C_Bulk…)> return echoes.")
(print "Source: ;;|| NEXT > between txs; one TRANSFER_BULK per tx (managed cap).")
(print "REPL tests: gas probes for MAX_BULK_BATCH (5000) vs 2M gas limit.")
(print "")
(print "************************ Stage 00b-GAS - bulk 5000 gas START ***********************************")

(print "")
(begin-tx "TX-BULK-GAS-01 - SKB5K list builders + keyset")
(namespace "ouronet-ns")
(env-chain-data {"chain-id": "0"})
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
;;==== TX-BULK-GAS-01 - 01 - module + keyset ==== =================================================
(print "--- [TX-BULK-GAS-01 - 01 - module + keyset] ---")
(env-sigs
  [{"key": "1a4e15d3c51e0b73e92644600487ba8eaae312e1a178b91801d54e13c1b350a5", "caps": []}])

(module SKB5K GOVERNANCE
    @doc "REPL-only helpers for 5000-recipient bulk gas probes"
    (defcap GOVERNANCE () true)
    (defconst BULK_MAX 5000)
    (defconst BULK_UNIT 1.0)
    (defconst SETUP_BATCH 1000)
    (defun UC_Receiver:string (idx:integer)
        (format "brcpt-{}" [(int-to-str 10 idx)])
    )
    (defun UC_Receivers:[string] (count:integer)
        (map UC_Receiver (enumerate 0 (- count 1)))
    )
    (defun UC_Amounts:[decimal] (count:integer amount:decimal)
        (map (lambda (x:integer) amount) (enumerate 0 (- count 1)))
    )
    (defun UC_Guards:[guard] (count:integer g:guard)
        (map (lambda (x:integer) g) (enumerate 0 (- count 1)))
    )
    (defun UC_Total:decimal (count:integer amount:decimal)
        (* (dec count) amount)
    )
    (defun UC_BatchReceivers:[string] (batch:integer)
        (let
            (
                (start:integer (* batch SETUP_BATCH))
                (stop:integer (+ start (- SETUP_BATCH 1)))
            )
            (map UC_Receiver (enumerate start stop))
        )
    )
    (defun UC_BatchAmounts:[decimal] (amount:decimal)
        (UC_Amounts SETUP_BATCH amount)
    )
)

(env-data
    {
        "KEY_BULK_RCPT" : { "keys" : ["1a4e15d3c51e0b73e92644600487ba8eaae312e1a178b91801d54e13c1b350a5"]}
    }
)

(print (format "<(REPL|env-gas)> TX-BULK-GAS-01 => \"{}\"" [(env-gas)]))
(commit-tx)
;;||>>>>>>>>>>>>>>>>>>>>>>>>>
;;|| NEXT                   >
;;||>>>>>>>>>>>>>>>>>>>>>>>>>

;; Setup: 5 txs x 1000 recipients (managed cap = one bulk per tx)
(print "")
(begin-tx "TX-BULK-GAS-02-00 - seed batch 0 (brcpt-0..999)")
(namespace "ouronet-ns")
(env-chain-data {"chain-id": "0"})
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(print "--- [TX-BULK-GAS-02-00 - seed batch 0] ---")
(env-sigs [{"key": "625ad78ab8c1df826d69e1f0e6457334b8e085b7d256d10be41726ced17fdf74", "caps": []}])
(let
    (
        (sender:string "stoa-foundation")
        (guard:guard (read-keyset "KEY_BULK_RCPT"))
        (unit:decimal SKB5K.BULK_UNIT)
        (batch-total:decimal (SKB5K.UC_Total SKB5K.SETUP_BATCH unit))
    )
    (test-capability (coin.TRANSFER_BULK sender batch-total))
    (coin.C_BulkTransferAnew sender (SKB5K.UC_BatchReceivers 0) (SKB5K.UC_Guards SKB5K.SETUP_BATCH guard) (SKB5K.UC_BatchAmounts unit))
    (print (format "<(REPL|env-gas)> setup batch 0 => \"{}\"" [(env-gas)]))
)
(commit-tx)
