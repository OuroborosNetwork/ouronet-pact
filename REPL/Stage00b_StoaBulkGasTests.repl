(namespace "ouronet-ns")
(env-chain-data {"chain-id": "0"})
(env-gasmodel "table")(env-gaslimit 2000000)(env-gas 0)
(print "--- [TX-BULK-GAS-04 - 5000 at 2M cap] ---")
(env-sigs [{"key": "625ad78ab8c1df826d69e1f0e6457334b8e085b7d256d10be41726ced17fdf74", "caps": []}])
(let
    (
        (sender:string "stoa-foundation")
        (count:integer SKB5K.BULK_MAX)
        (unit:decimal SKB5K.BULK_UNIT)
        (total:decimal (SKB5K.UC_Total count unit))
        (limit:integer 2000000)
    )
    (test-capability (coin.TRANSFER_BULK sender total))
    (let
        ((result:string (coin.C_BulkTransfer sender (SKB5K.UC_Receivers count) (SKB5K.UC_Amounts count unit))))
        (print (format "<(coin.C_BulkTransfer)> => \"{}\"" [result]))
        (let ((gas:integer (env-gas)))
            (print (format "<(REPL|env-gas)> C_BulkTransfer 5000 at 2M limit => \"{}\"" [gas]))
            (map print
                [
                    (expect
                        (format "<<TX-BULK-GAS-04>> 5000 bulk succeeds within 2M gas (used {})" [gas])
                        true
                        (<= gas limit))
                    (expect
                        (format "<<TX-BULK-GAS-04>> summary for 5000 recipients" [])
                        "BulkTransfer: 5000 recipients, total 5000.0"
                        result)
                ]
            )
        )
    )
)
(commit-tx)
;;||>>>>>>>>>>>>>>>>>>>>>>>>>

(print "")
(begin-tx "TX-BULK-GAS-05 - 5000 C_BulkTransferAnew cold path")
(namespace "ouronet-ns")
(env-chain-data {"chain-id": "0"})
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(print "--- [TX-BULK-GAS-05 - 5000 anew] ---")
(env-sigs [{"key": "625ad78ab8c1df826d69e1f0e6457334b8e085b7d256d10be41726ced17fdf74", "caps": []}])
(let
    (
        (sender:string "stoa-foundation")
        (count:integer SKB5K.BULK_MAX)
        (unit:decimal SKB5K.BULK_UNIT)
        (offset:integer 10000)
        (receivers:[string]
            (map
                (lambda (idx:integer)
                    (format "brcpt-new-{}" [(int-to-str 10 (+ idx offset))]))
                (enumerate 0 (- count 1))
            )
        )
        (total:decimal (SKB5K.UC_Total count unit))
        (limit:integer 2000000)
    )
    (test-capability (coin.TRANSFER_BULK sender total))
    (let
        ((result:string
            (coin.C_BulkTransferAnew
                sender
                receivers
                (SKB5K.UC_Guards count (read-keyset "KEY_BULK_RCPT"))
                (SKB5K.UC_Amounts count unit))))
        (print (format "<(coin.C_BulkTransferAnew)> => \"{}\"" [result]))
        (let ((gas:integer (env-gas)))
            (print (format "<(REPL|env-gas)> C_BulkTransferAnew 5000 => \"{}\"" [gas]))
            (print (format "<<TX-BULK-GAS-05>> anew 5000 fits 2M? {}" [(<= gas limit)]))
            (expect
                (format "<<TX-BULK-GAS-05>> anew summary" [])
                "BulkTransferAnew: 5000 recipients, total 5000.0"
                result)
        )
    )
)
(commit-tx)
;;||>>>>>>>>>>>>>>>>>>>>>>>>>

