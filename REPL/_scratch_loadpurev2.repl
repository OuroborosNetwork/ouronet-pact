;;================================================================
;; FILE  REPL/_scratch_loadpurev2.repl
;;================================================================
;; Legend: <(…)> echoes a computed value.
;; Source: Deploy/PureV2/23_deploy.pact (generated by REPL/tools/_purev2.py)
;;
;; DOES THE EMITTED PureV2 FILE LOAD AS AN UPGRADE OVER AN ALREADY-DEPLOYED MODULE?
;;
;; `_purev2.py --check` proves the BODY matches its module source byte for byte. It cannot
;; prove the file DEPLOYS, and the two failure modes that matter are invisible to a diff:
;;
;;   · an `(interface …)` form shipped a second time -- Pact refuses byte-identical
;;     re-deploys ("Interface cannot be upgraded"), which cost round V1 tx 11 and tx 21;
;;   · a `(create-table …)` form left in an upgrade -- re-creating an existing table aborts
;;     the whole transaction, which 16_deploy carried until someone loaded it by hand.
;;
;; Both are caught by doing the only thing that settles it: loading the emitted file on top of
;; a tree that already has the module. KBN implements no interface and declares no tables, so
;; this is expected to be quiet -- the point is that it is CHECKED rather than reasoned about,
;; and that the next PureV2 file added to this scratch inherits the check for free.
;;
;; NOT VERIFIED HERE: what A_BunnyRGBSet STORES. Defining the Bunny RGB Set needs its 1,100
;; native nonces minted first (UEV_PrimordialSetDefinition enforces every allowed-nonce
;; references an existing nonce), which is [5.4]_PopulateBunnies' job. The artwork links are
;; asserted there -- TX-03 <<KBN-RGB-URI>> / <<KBN-RGB-ROY>>, negative-tested -- and
;; duplicating a 1,100-nonce mint here to re-assert them would buy nothing.
;;================================================================
(load "Stage00_Sanboxes.repl")
(load "deploy-stage01.repl")
(load "deploy-stage02.repl")
;;||>>>>>>>>>>>>>>>>>>>>>>>>>
;;|| NEXT                   >
;;||>>>>>>>>>>>>>>>>>>>>>>>>>
(begin-tx "TX-01 - PureV2 23: KBN module upgrade over a deployed KBN")
;;==== TX-01 · 01 · the hash BEFORE the upgrade ====
(print "--- [TX-01 · 01 · the hash BEFORE the upgrade] ---")
(namespace "ouronet-ns")
;; Echoed, NOT asserted, and the reason is worth writing down: `deploy-stage02` already loads the
;; CURRENT KBunnies source, so this scratch upgrades the module to the bytes it already has and
;; the hash does not move. A "hash changed" assertion would be false by construction here and
;; would only pass on a tree whose deployed KBN was stale -- the opposite of what the suite wants.
;; Byte-equality of the emitted body against the module source is `_purev2.py --check`'s job and
;; is gate-fatal there; duplicating it with a pasted hash literal would just be brittle.
(print (format "<(KBN hash before)> {}" [(at "hash" (describe-module "ouronet-ns.KBN"))]))
;;==== TX-01 · 02 · load the emitted deploy file ====
(print "--- [TX-01 · 02 · load the emitted deploy file] ---")
(load "../Deploy/PureV2/23_deploy.pact")
(commit-tx)
;;||>>>>>>>>>>>>>>>>>>>>>>>>>
;;|| NEXT                   >
;;||>>>>>>>>>>>>>>>>>>>>>>>>>
(begin-tx "TX-01b - PureV2 24: AQP-BOOT module upgrade over a deployed AQP-BOOT")
;;==== TX-01b · 01 · load the emitted deploy file ====
(print "--- [TX-01b · 01 · load the emitted deploy file] ---")
;;Same check as 23 and for the same two reasons: an interface shipped a second time, or a
;;create-table left in an upgrade. AQP-BOOT DOES implement an interface (AcquisitionPoolBootV1),
;;so module-only is load-bearing here rather than merely tidy -- shipping the file verbatim
;;would re-send AcquisitionPoolBootV1 and be refused.
(load "../Deploy/PureV2/24_deploy.pact")
(commit-tx)
;;||>>>>>>>>>>>>>>>>>>>>>>>>>
;;|| NEXT                   >
;;||>>>>>>>>>>>>>>>>>>>>>>>>>
(begin-tx "TX-01c - PureV2 25: IGNIS module upgrade over a deployed IGNIS")
;;==== TX-01c · 01 · load the emitted deploy file ====
(print "--- [TX-01c · 01 · load the emitted deploy file] ---")
;;IGNIS implements IgnisCollectorV3, already live -- so module-only is load-bearing here too.
(load "../Deploy/PureV2/25_deploy.pact")
(commit-tx)
;;||>>>>>>>>>>>>>>>>>>>>>>>>>
;;|| NEXT                   >
;;||>>>>>>>>>>>>>>>>>>>>>>>>>
(begin-tx "TX-02 - the upgrades took, and the entrypoints are still reachable")
;;==== TX-02 · 01 · post-upgrade shape ====
(print "--- [TX-02 · 01 · post-upgrade shape] ---")
(namespace "ouronet-ns")
(map print
    [
        ;; It implements no interface, which is WHY this file ships module-only. Asserted because
        ;; it is the premise of that decision: the day KBN gains an `implements`, the emitted file
        ;; has to stop being module-only or the deploy is refused, and this is what says so.
        (expect
            "<<DEPLOY23>> KBN still implements no interface, so module-only is correct"
            []
            (at "interfaces" (describe-module "ouronet-ns.KBN")))
        ;; And the entrypoint the asset step calls is reachable on the upgraded module.
        (expect
            "<<DEPLOY23>> A_BunnyRGBSet is reachable post-upgrade"
            true
            (contains "A_BunnyRGBSet" (format "{}" [(describe-module "ouronet-ns.KBN")])))
        ;;AQP-BOOT, unlike KBN, DOES implement an interface -- so this asserts the live one is
        ;;still satisfied after a module-only upgrade, which is the thing module-only risks.
        (expect
            "<<DEPLOY24>> AQP-BOOT still implements AcquisitionPoolBootV1 after the upgrade"
            ["ouronet-ns.AcquisitionPoolBootV1"]
            (at "interfaces" (describe-module "ouronet-ns.AQP-BOOT")))
        (expect
            "<<DEPLOY24>> the new guard helper is present on the upgraded module"
            true
            (contains "UEV_BootStepState" (format "{}" [(describe-module "ouronet-ns.AQP-BOOT")])))
        ;;IGNIS: the upgrade took AND the price now comes from the oracle, not the usage table.
        (expect
            "<<DEPLOY25>> IGNIS still implements IgnisCollectorV3 after the upgrade"
            true
            (contains "ouronet-ns.IgnisCollectorV3"
                (at "interfaces" (describe-module "ouronet-ns.IGNIS"))))
        (expect
            "<<DEPLOY25>> UC_StoaPrice derives from the ORACLE, not DALOS|PricesTable"
            (/ (/ (IGNIS.UC_IgnisDeter "issue-nft") 100.0) (U|CT.UR_STOA-PID|Price))
            (IGNIS.UC_StoaPrice "issue-nft"))
    ]
)
(commit-tx)
