;;
;; REPL/deploy-stage02.repl — canonical integration layout (OuronetInformational/ARCHITECTURE/REPL_AND_TESTS.md)
;;   Inter-tx:   ;;|| NEXT >  (same three lines as REPL/Stage_01/[2.2]_Core.repl)
;;   Intra-tx:   ;;==== <TX label> · mm · <slug> ====  + next-line (print "--- [<label> · mm · …] ---"); mm = 01.. within each (begin-tx …) (see OuronetInformational/ARCHITECTURE/REPL_AND_TESTS.md).
;;   format "{}": Talos / module echoes and (env-gas) — document additional prefixes in this file's (print …) lines as needed.
;;
(print "")
(print "================================================================")
(print "FILE  REPL/deploy-stage02.repl")
(print "================================================================")
(print "Legend (terminal observability): see ;; preface; echoes use <(…)> where helpful.")
(print "Source: ;;|| NEXT > between txs; ;;==== … · mm · … ==== + banner before each begin-tx.")
(print "")
;; deploy-stage02.repl — Stage 2 deploy core (DPDC → DemiPad → EarningPools[ANK/SCORE/POOL/RPS/FVT/
;; VCT/MTX/DSA/INFO] → Talos → sovereign executor → Z_Reads/INFO-TWO). Deploy ONLY, no [6.x] suites.
;; Shared by Stage02_Tester, ZALL.repl, and standalone Stage-2 module testers.
;; Assumes Stage 00 + Stage 01 deploy cores already loaded.
;;SOVEREIGN DEPLOYER
(load "Stage_02/[0.1]_Interfaces.repl")
(load "Stage_02/[2.1]_DpdcCore.repl")
(load "Stage_02/[2.2]_DemiPad.repl")
(load "Stage_02/[2.3]_EarningPools.repl")
(load "Stage_02/[3]_Talos.repl")
;;SOVEREIGN EXECUTOR (DPDC IMC policies + DH collection issue — no mass mint)
(load "Stage_02/[4.0]_Sovereign-Executor.repl")
;;Z_READS — INFO-TWO (Stage-2 INFO previews), deployed after usage prices exist
(load "Stage_02/[Z]_Reads.repl")

;;==================================================================================
;; CITIZEN DEPLOYER + EXECUTOR (part of the deploy core — needed by AQP suites)
;;==================================================================================
;; KBN (Bunnies) citizen module — AQP-BOOT load prerequisite
(begin-tx "deploy-stage02 · KBN citizen module (deploy only)")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(namespace "ouronet-ns")
;;==== deploy-stage02 · KBN citizen module (deploy only) · 01 · env-sigs (caps) ==== ==============
(print "--- [deploy-stage02 · KBN citizen module (deploy only) · 01 · env-sigs (caps)] ---")
(env-sigs [{"key": "1a4e15d3c51e0b73e92644600487ba8eaae312e1a178b91801d54e13c1b350a5", "caps": []}])
;;==== deploy-stage02 · KBN citizen module (deploy only) · 02 · load module ==== ==================
(print "--- [deploy-stage02 · KBN citizen module (deploy only) · 02 · load module] ---")
(load "../2_CITIZEN/4_BunniesMinter/02_KBunnies.pact")
(commit-tx)
;;||>>>>>>>>>>>>>>>>>>>>>>>>>
;;|| NEXT                   >
;;||>>>>>>>>>>>>>>>>>>>>>>>>>
(print "")
;; AQP-BOOT citizen module
(begin-tx "deploy-stage02 · AQP-BOOT module")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(namespace "ouronet-ns")
;;==== deploy-stage02 · AQP-BOOT module · 01 · env-sigs (caps) ==== ===============================
(print "--- [deploy-stage02 · AQP-BOOT module · 01 · env-sigs (caps)] ---")
(env-sigs [{"key": "1a4e15d3c51e0b73e92644600487ba8eaae312e1a178b91801d54e13c1b350a5", "caps": []}])
;;==== deploy-stage02 · AQP-BOOT module · 02 · load module ==== ===================================
(print "--- [deploy-stage02 · AQP-BOOT module · 02 · load module] ---")
(load "../2_CITIZEN/5_VaultsMinter/04_AQP-BOOT.pact")
(commit-tx)
;;||>>>>>>>>>>>>>>>>>>>>>>>>>
;;|| NEXT                   >
;;||>>>>>>>>>>>>>>>>>>>>>>>>>
(print "")
;; AQP-BOOT Step0 — wire IMC policies + rotate the vault governor
(begin-tx "deploy-stage02 · AQP-BOOT Step0 WireImcAndGovernor")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(namespace "ouronet-ns")
;;==== deploy-stage02 · AQP-BOOT Step0 WireImcAndGovernor · 01 · env-sigs (caps) ==== =============
(print "--- [deploy-stage02 · AQP-BOOT Step0 WireImcAndGovernor · 01 · env-sigs (caps)] ---")
(env-sigs [{ "key": "PK_AncientHodler", "caps": [] }])
(AQP-BOOT.C_Step0_WireImcAndGovernor KST.ANHD)
(commit-tx)

