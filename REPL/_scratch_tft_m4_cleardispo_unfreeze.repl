;;
;; REPL/_scratch_tft_m4_cleardispo_unfreeze.repl — DALOS-audit #28M investigation/proof
;; (TFT::C_ClearDispo unconditionally force-unfreezes the account's Elite-Auryn balance at the
;; end, even if it was frozen for an unrelated reason before C_ClearDispo was ever called - the
;; freeze-check only guards the INITIAL freeze (skip-if-already-frozen), not the final unfreeze.)
;;
;; Setup mirrors REPL/Stage_01/[6.2]_DPTF.repl's own "DISPO 1|3 Tests" -> "Dispo 2|x Clear Dispo
;; Test" recipe (the only existing fixture that exercises C_ClearDispo at all): transfer EA to
;; emma, sublimate OURO against a zero balance to go negative (creating a clearable Dispo), except
;; here we ALSO freeze emma's EA account for an unrelated reason immediately before calling
;; C_ClearDispo, to see whether that pre-existing freeze survives.
;;
(load "Stage00_Sanboxes.repl")
(load "Stage_01/[0.0]_Starter.repl")
(load "Stage_01/[0.1]_Interfaces.repl")
(load "Stage_01/[1]_Utilities.repl")
(load "Stage_01/[2.1]_Dalos.repl")
(load "Stage_01/[2.2]_Core.repl")
(load "Stage_01/[3]_Talos.repl")
(load "Stage_01/[4.0]_Sovereign-Executor.repl")
(load "Stage_01/[5.1]_Aoz+.repl")

(begin-tx "M4 SETUP - transfer EA to emma, sublimate OURO against zero balance to go negative")
(namespace "ouronet-ns")
(env-sigs [ { "key": "PK_AncientHodler", "caps": [] } ])
(let
    (
        (ref-TS01-C1:module{TalosStageOne_ClientOneV1} TS01-C1)
        (patron:string KST.ANHD)
        (receiver:string KST.EMMA)
        (ea-id:string "ELITEAURYN-98c486052a51")
    )
    (ref-TS01-C1::DPTF|C_Transfer patron ea-id patron receiver 5000.0 false)
)
(commit-tx)

(begin-tx "M4 SETUP part 2 - Emma sublimates 10 OURO against a 0 balance, going negative")
(namespace "ouronet-ns")
(env-sigs [ { "key": "PK_Emma", "caps": [] } ])
(let
    (
        (ref-TS01-C2:module{TalosStageOne_ClientTwoV1} TS01-C2)
        (receiver:string KST.EMMA)
    )
    (ref-TS01-C2::ORBR|C_Sublimate receiver receiver 10.0)
)
(commit-tx)

(begin-tx "M4 TEST - freeze EA for an unrelated reason, then ClearDispo, check if freeze survives")
(namespace "ouronet-ns")
(env-sigs [ { "key": "PK_AncientHodler", "caps": [] } ])
(let
    (
        (ref-TS01-C1:module{TalosStageOne_ClientOneV1} TS01-C1)
        (ref-DPTF:module{DemiourgosPactTrueFungibleV1} DPTF)
        (patron:string KST.ANHD)
        (receiver:string KST.EMMA)
        (ea-id:string "ELITEAURYN-98c486052a51")
        (ouro:string "OURO-98c486052a51")
    )
    (map print
        [
            (format "Emma's OURO balance (must be negative for ClearDispo to be callable): {}" [(ref-DPTF::UR_AccountSupply ouro receiver)])
        ]
    )
    ;;Freeze emma's EA for an unrelated reason (e.g. an admin compliance freeze), BEFORE ClearDispo
    (ref-TS01-C1::DPTF|C_ToggleFreezeAccount patron ea-id receiver true)
    (print (format "Emma's EA frozen-state BEFORE ClearDispo (unrelated freeze applied): {}" [(ref-DPTF::UR_AccountFrozenState ea-id receiver)]))
    (ref-TS01-C1::DPTF|C_ClearDispo patron receiver)
    (print (format "Emma's EA frozen-state AFTER ClearDispo (THE CLAIMED BUG: if false, the unrelated freeze was incorrectly lifted): {}" [(ref-DPTF::UR_AccountFrozenState ea-id receiver)]))
)
(commit-tx)
