;;||>>>>>>>>>>>>>>>>>>>>>>>>>
;;|| NEXT                   >
;;||>>>>>>>>>>>>>>>>>>>>>>>>>
(print "")
(begin-tx "TX001 - PYTHIA|C_DeployApiKey Standard + reads")
(namespace "ouronet-ns")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(print "")
(print "=== TX001 — C_DeployApiKey (Standard ₱.) =================================")
(let
    (
        (apollo-std:string (read-string "PYTHIA|APOLLO-STANDARD"))
        (public-std:string (read-string "PYTHIA|PUBLIC-STANDARD"))
        (lane-std:string (read-string "PYTHIA|LANE-STANDARD"))
        (owner-acct:string
            (if (= (read-string "PYTHIA|OWNER-ACCOUNT") "")
                KST.ANHD
                (read-string "PYTHIA|OWNER-ACCOUNT")
            )
        )
        (patron:string KST.ANHD)
        (ref-DALOS:module{OuronetDalosV1} DALOS)
        (ref-TS01-C4:module{TalosStageOne_ClientFourV3} TS01-C4)
        (ref-PYTHIA:module{PythiaV2} PYTHIA)
        (deploy-fee:decimal (ref-PYTHIA::UC_DeployPrice))
        (patron-kda:string (ref-DALOS::UR_AccountKadena patron))
        (demiurgoi:[string] (ref-DALOS::UR_DemiurgoiID))
        (kda-hov:string (ref-DALOS::UR_AccountKadena (at 2 demiurgoi)))
        (kda-cto:string (ref-DALOS::UR_AccountKadena (at 1 demiurgoi)))
        (kda-ouroboros:string (ref-DALOS::UR_AccountKadena (ref-DALOS::GOV|OUROBOROS|SC_NAME)))
        (kda-dalos:string (ref-DALOS::UR_AccountKadena (ref-DALOS::GOV|DALOS|SC_NAME)))
        (split-kda:[decimal] (ref-DALOS::URC_SplitKDAPrices (ref-PYTHIA::UC_FeeDiscountAnchor) deploy-fee))
    )
    ;;==== TX001 · 01 · deploy fee echo ====
    (print "--- [TX001 · 01 · deploy fee echo] ---")
    (print (format "<(PYTHIA|UC_DeployPrice)> => \"{}\" STOA" [deploy-fee]))
    (print (format "<(DALOS|URC_SplitKDAPrices)> => \"{}\"" [split-kda]))
    ;;==== TX001 · 02 · env-sigs (owner + STOA split) ====
    (print "--- [TX001 · 02 · env-sigs (owner + STOA split)] ---")
    (env-sigs
        [
            { "key": "PK_AncientHodler", "caps": [] }
            { "key": "6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263",
              "caps":
                [
                    (coin.TRANSFER patron-kda kda-cto (at 2 split-kda))
                    (coin.TRANSFER patron-kda kda-hov (at 0 split-kda))
                    (coin.TRANSFER patron-kda kda-ouroboros (at 3 split-kda))
                    (coin.TRANSFER patron-kda kda-dalos (at 1 split-kda))
                ]
            }
        ]
    )
    (let
        (
            (dep-msg:string
                (ref-TS01-C4::PYTHIA|C_DeployApiKey
                    patron owner-acct apollo-std public-std lane-std
                )
            )
        )
        ;;==== TX001 · 03 · Talos C_DeployApiKey ====
        (print "--- [TX001 · 03 · Talos C_DeployApiKey] ---")
        (print (format "<(TS01-C4.PYTHIA|C_DeployApiKey)> => \"{}\"" [dep-msg]))
        ;;==== TX001 · 04 · UR / URD expects ====
        (print "--- [TX001 · 04 · UR / URD expects] ---")
        (map print
            [
                (expect
                    "<<TX001>> UR_IsActivated false (inactive after deploy)"
                    false
                    (ref-PYTHIA::UR_IsActivated apollo-std)
                )
                (expect
                    "<<TX001>> UR_Public matches PUBLIC-STANDARD"
                    public-std
                    (ref-PYTHIA::UR_Public apollo-std)
                )
                (expect
                    "<<TX001>> UR_OwnerAccount matches owner"
                    owner-acct
                    (ref-PYTHIA::UR_OwnerAccount apollo-std)
                )
                (expect
                    "<<TX001>> URC_IsStandardApollo true for ₱."
                    true
                    (ref-PYTHIA::URC_IsStandardApollo apollo-std)
                )
                (expect
                    "<<TX001>> UR_ApiKeyRowOrNull is-registered true"
                    true
                    (at "is-registered" (ref-PYTHIA::UR_ApiKeyRowOrNull apollo-std))
                )
                (expect
                    "<<TX001>> URD_ApiKeyCount >= 1"
                    true
                    (>= (ref-PYTHIA::URD_ApiKeyCount) 1)
                )
                (expect
                    "<<TX001>> URD_ListInactiveApiKeys includes deployed row"
                    true
                    (> (length (ref-PYTHIA::URD_ListInactiveApiKeys)) 0)
                )
            ]
        )
        ""
    )
)
(print (format "<(REPL|env-gas)> TX001 => \"{}\"" [(env-gas)]))
(commit-tx)
(print "")
;;||>>>>>>>>>>>>>>>>>>>>>>>>>
;;|| NEXT                   >
;;||>>>>>>>>>>>>>>>>>>>>>>>>>
(print "")
(begin-tx "TX002 - PYTHIA|A_ActivateApiKey (Cronoton)")
(namespace "ouronet-ns")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(print "")
(print "=== TX002 — A_ActivateApiKey (Cronoton) ================================")
(let
    (
        (apollo-std:string (read-string "PYTHIA|APOLLO-STANDARD"))
        (ref-TS01-C4:module{TalosStageOne_ClientFourV3} TS01-C4)
        (ref-PYTHIA:module{PythiaV2} PYTHIA)
    )
    ;;==== TX002 · 01 · env-sigs (pythia-cronoton-keyset) ====
    (print "--- [TX002 · 01 · env-sigs (pythia-cronoton-keyset)] ---")
    (env-sigs
        [
            { "key": "PK_AncientHodler", "caps": [] }
        ]
    )
    (let
        (
            (act-msg:string (ref-TS01-C4::PYTHIA|A_ActivateApiKey apollo-std))
        )
        ;;==== TX002 · 02 · Talos A_ActivateApiKey ====
        (print "--- [TX002 · 02 · Talos A_ActivateApiKey] ---")
        (print (format "<(TS01-C4.PYTHIA|A_ActivateApiKey)> => \"{}\"" [act-msg]))
        ;;==== TX002 · 03 · expects ====
        (print "--- [TX002 · 03 · expects] ---")
        (map print
            [
                (expect
                    "<<TX002>> UR_IsActivated true after Cronoton activate"
                    true
                    (ref-PYTHIA::UR_IsActivated apollo-std)
                )
                (expect
                    "<<TX002>> URC_ActivatedSet contains apollo-account"
                    true
                    (contains apollo-std (ref-PYTHIA::URC_ActivatedSet))
                )
                (expect
                    "<<TX002>> URD_ListActivatedApiKeys non-empty"
                    true
                    (> (length (ref-PYTHIA::URD_ListActivatedApiKeys)) 0)
                )
            ]
        )
        ""
    )
)
(print (format "<(REPL|env-gas)> TX002 => \"{}\"" [(env-gas)]))
(commit-tx)
(print "")
