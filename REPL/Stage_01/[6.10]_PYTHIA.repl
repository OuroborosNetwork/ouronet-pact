        (patron-kda:string (ref-DALOS::UR_AccountKadena patron))
        (demiurgoi:[string] (ref-DALOS::UR_DemiurgoiID))
        (kda-hov:string (ref-DALOS::UR_AccountKadena (at 2 demiurgoi)))
        (kda-cto:string (ref-DALOS::UR_AccountKadena (at 1 demiurgoi)))
        (kda-ouroboros:string (ref-DALOS::UR_AccountKadena (ref-DALOS::GOV|OUROBOROS|SC_NAME)))
        (kda-dalos:string (ref-DALOS::UR_AccountKadena (ref-DALOS::GOV|DALOS|SC_NAME)))
        (split-kda:[decimal] (ref-DALOS::URC_SplitKDAPrices (ref-PYTHIA::UC_FeeDiscountAnchor) deploy-fee))
    )
    ;;==== TX005 · 01 · env-sigs (Demiurgoi + STOA split) ====
    (print "--- [TX005 · 01 · env-sigs (Demiurgoi + STOA split)] ---")
    (env-sigs
        [
            { "key": "PK_AncientHodler", "caps": [] }
            { "key": "6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263",
              "caps":
                [
                    (coin.TRANSFER patron-kda kda-cto (at 2 split-kda))
                    (coin.TRANSFER patron-kda kda-hov (at 0 split-kda))
                    (coin.TRANSFER patron-kda kda-ouroboros (at 3 split-kda))
                    (coin.TRANSFER patron-kda kda-dalos (at 1 split-kda))
