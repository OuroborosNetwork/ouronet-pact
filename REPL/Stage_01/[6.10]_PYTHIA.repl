;;
;; REPL/Stage_01/[6.10]_PYTHIA.repl — PYTHIA deploy / activate / deactivate / rename via TS01-C4
;;   Prerequisite: Stage 01 stack through [4.0]_Sovereign-Executor.repl (PYTHIA, TS01-C4 deployed).
;;   Load: (load "Stage_01/[6.10]_PYTHIA.repl") after Stage01_Tester.
;;
;;   Placeholders — env-data in INIT TX000 (Apollo strings reused from [6.9]_CODEX.repl):
;;     PYTHIA|APOLLO-STANDARD   162-char ₱. Apollo account (= table key / API key)
;;     PYTHIA|APOLLO-SMART      162-char Π. Apollo account (admin deploy only)
;;     PYTHIA|PUBLIC-STANDARD   canonical public-key material (stored in row)
;;     PYTHIA|PUBLIC-SMART      canonical public-key material (stored in row)
;;     PYTHIA|LANE-STANDARD     consumer-lane for Standard key
;;     PYTHIA|LANE-SMART        consumer-lane for Smart key
;;     PYTHIA|OWNER-ACCOUNT     Ouronet DALOS account (default KST.ANHD)
;;
(print "")
(print "================================================================")
(print "FILE  REPL/Stage_01/[6.10]_PYTHIA.repl")
(print "================================================================")
(print "Legend:")
(print "  <<…>>     expect / expect-failure doc")
(print "  <(TS01-C4.PYTHIA|…)> => \"…\"   Talos client → PYTHIA write")
(print "  <(PYTHIA|UR_…|…)> => \"…\"       ref-PYTHIA utility read")
(print "  <(REPL|env-gas)> …             gas after tx")
(print "")
(print "Source: ;;|| NEXT > between txs; ;;==== TXnnn · mm · … ==== per group.")
(print "REPL tests: (map print [(expect …) …]) — one line per assertion.")
(print "")
;;
(begin-tx "TX000 INIT - chain data + PYTHIA placeholder env-data")
(namespace "ouronet-ns")
;;==== TX000 · 01 · env-chain-data ====
(print "--- [TX000 · 01 · env-chain-data] ---")
(env-chain-data
    {"prev-block-hash": "98c486052a5147fdd30fa43cc6d67e0a4e680c856c37f9157cb788cd67d58006",
     "block-time": TV.TIME00}
)
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
;;==== TX000 · 02 · placeholder env-data ====
(print "--- [TX000 · 02 · placeholder env-data] ---")
(env-data
    {
        "PYTHIA|APOLLO-STANDARD": "₱.ŹΘHYSç7þУJΛpøЩфμбÄИЫŒП9ó7æйȘΣßлΔσ3äЬyrfжπйôleBĄиĄLtźș∇îИyKβńĎDûuÁCȘñЯÒźâŒíßRζäĞΩěѺtşlęHБMŸíWlãąŹÔИЖÊzHțćœŽζýżχδšωχUΨNńúńñУnИкjубâ£ßMKηжлý9κιЦвSαцууěÖщьΩùцn₳Бεůφ",
        "PYTHIA|APOLLO-SMART": "Π.ЙÛœ5ŒOóцιbÌȘŚÚůVÀΠьδЬÃςиbIñжÄoTЬŮşÄrhûεżęF5h₳ΞžGËWXÇûKÖLÙNÂ₱ůθŚяZ₳tœ¥ÅÂΓŹË4uĂбoÚAвOUζÂwΩэí₳ÜŻŁqΣкΣΨΨþѺBkĞõeѺńξTŠB0èΦeπδóýwÑeщIäΣMNøθΔîý₿ŹďρŁȘρτYEúNвÓûĐØúkŹýşθÞΓ",
        "PYTHIA|PUBLIC-STANDARD": "6g.",
        "PYTHIA|PUBLIC-SMART": "6g.",
        "PYTHIA|LANE-STANDARD": "pythiastd01",
        "PYTHIA|LANE-SMART": "pythiasmrt01",
        "PYTHIA|LANE-RENAMED": "pythiaren01",
        "PYTHIA|OWNER-ACCOUNT": ""
