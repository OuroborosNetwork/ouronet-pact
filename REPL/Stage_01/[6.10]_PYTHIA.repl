        (print (format "<(TS01-C4.PYTHIA|A_DeploySmartApiKey)> => \"{}\"" [smt-msg]))
        ;;==== TX005 · 03 · expects ====
        (print "--- [TX005 · 03 · expects] ---")
        (map print
            [
                (expect
                    "<<TX005>> URC_IsStandardApollo false for Π."
                    false
                    (ref-PYTHIA::URC_IsStandardApollo apollo-smt)
                )
                (expect
                    "<<TX005>> Smart key inactive after admin deploy"
                    false
                    (ref-PYTHIA::UR_IsActivated apollo-smt)
                )
                (expect
                    "<<TX005>> URD_ListAllApiKeys count >= 2"
