(print "  <(TS01-C4.PYTHIA|…)> => \"…\"   Talos client → PYTHIA write")
(print "  <(PYTHIA|UR_…|…)> => \"…\"       ref-PYTHIA utility read")
(print "  <(REPL|env-gas)> …             gas after tx")
(print "")
;;
