;;
;; REPL/Stage_01/[6.10]_PYTHIA.repl — dual-Apollo deploy / link / activate / revoke via TS01-C4
;;   Prerequisite: Stage 01 stack through [4.0]_Sovereign-Executor.repl (PYTHIA, TS01-C4 deployed).
;;   Load: (load "Stage_01/[6.10]_PYTHIA.repl") after Stage01_Tester.
;;
(print "")
(print "================================================================")
(print "FILE  REPL/Stage_01/[6.10]_PYTHIA.repl")
(print "================================================================")
(print "Legend:")
(print "  <<…>>     expect / expect-failure doc")
(print "  <(TS01-C4.PYTHIA|…)> => \"…\"   Talos client → PYTHIA write")
(print "  <(PYTHIA|UR_…|…)> => \"…\"       ref-PYTHIA utility read")
(print "  <(REPL|env-gas)> …             gas after tx")
(print "")
;;
(begin-tx "TX000 INIT - chain data + PYTHIA placeholder env-data")
(namespace "ouronet-ns")
(env-chain-data
    {"prev-block-hash": "98c486052a5147fdd30fa43cc6d67e0a4e680c856c37f9157cb788cd67d58006",
     "block-time": TV.TIME00,
     "block-height": 378734}
)
