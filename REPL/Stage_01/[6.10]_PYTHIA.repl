            { "key": "PK_AncientHodler", "caps": [] }
        ]
    )
    (let
        (
            (patron:string KST.ANHD)
            (deact-fee:decimal (ref-PYTHIA::UC_DeactivateIgnisFee))
            (off-msg:string
                (ref-TS01-C4::PYTHIA|C_DeactivateApiKey patron owner-acct apollo-std)
            )
