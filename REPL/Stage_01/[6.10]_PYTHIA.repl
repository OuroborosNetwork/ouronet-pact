(print "")
(begin-tx "TX007 - keyless reads")
(namespace "ouronet-ns")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(print "=== TX007 — keyless UR/URD reads ========================================")
(env-sigs [])
(let
    (
        (apollo-std:string (read-string "PYTHIA|APOLLO-STANDARD"))
        (apollo-smt:string (read-string "PYTHIA|APOLLO-SMART"))
        (ref-PYTHIA:module{PythiaV4} PYTHIA)
        (dlk:string (ref-PYTHIA::UC_DualLinkKey apollo-std apollo-smt))
    )
    (map print
        [
            (expect "<<TX007>> keyless UR_DualLinkIzActiveOrFalse" true (ref-PYTHIA::UR_DualLinkIzActiveOrFalse dlk))
            (expect "<<TX007>> keyless URH_ListActiveDualLinks non-empty" true (> (length (ref-PYTHIA::URH_ListActiveDualLinks)) 0))
            (expect "<<TX007>> keyless UR_RevocationEpoch 3156 at height 378734" 3156 (ref-PYTHIA::UR_RevocationEpoch))
            (expect "<<TX007>> keyless UR_RevocationAtHeight > 0" true (> (ref-PYTHIA::UR_RevocationAtHeight) 0))
            (expect "<<TX007>> unknown dual key => false" false (ref-PYTHIA::UR_DualLinkIzActiveOrFalse "₱.unknown|Π.unknown"))
        ]
    )
    ""
)
(commit-tx)
(print "")
