    (let ((react-msg:string (ref-TS01-C4::A_PYTHIA|Link apollo-std apollo-smt)))
        (print (format "<(TS01-C4.A_PYTHIA|Link)> => \"{}\"" [react-msg]))
        ""
    )
    (env-sigs
        [
            { "key": "PK_AncientHodler", "caps": [] }
            { "key": "6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263",
              "caps":
                [
                    (coin.TRANSFER patron-stoa (ref-DALOS::UR_AccountStoa (at 1 demiurgoi)) (at 2 split-stoa))
                    (coin.TRANSFER patron-stoa (ref-DALOS::UR_AccountStoa (at 2 demiurgoi)) (at 0 split-stoa))
                    (coin.TRANSFER patron-stoa (ref-DALOS::UR_AccountStoa (ref-DALOS::GOV|OUROBOROS|SC_NAME)) (at 3 split-stoa))
                    (coin.TRANSFER patron-stoa (ref-DALOS::UR_AccountStoa (ref-DALOS::GOV|DALOS|SC_NAME)) (at 1 split-stoa))
                ]
            }
        ]
