        (split-stoa:[decimal] (ref-DALOS::URC_SplitSTOAPrices (ref-PYTHIA::UC_FeeDiscountAnchor) deploy-fee))
    )
    (env-sigs
        [
            { "key": "PK_AncientHodler", "caps": [] }
            { "key": "6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263",
              "caps":
                [
                    (coin.TRANSFER patron-stoa (ref-DALOS::UR_AccountStoa (at 1 demiurgoi)) (at 2 split-stoa))
                    (coin.TRANSFER patron-stoa (ref-DALOS::UR_AccountStoa (at 2 demiurgoi)) (at 0 split-stoa))
                    (coin.TRANSFER patron-stoa (ref-DALOS::UR_AccountStoa (ref-DALOS::GOV|OUROBOROS|SC_NAME)) (at 3 split-stoa))
                    (coin.TRANSFER patron-stoa (ref-DALOS::UR_AccountStoa (ref-DALOS::GOV|DALOS|SC_NAME)) (at 1 split-stoa))
                ]
            }
        ]
    )
    (let ((dep-msg:string (ref-TS01-C4::PYTHIA|C_DeployApiKey patron owner-acct apollo-smt public-smt)))
        (print (format "<(TS01-C4.PYTHIA|C_DeployApiKey)> => \"{}\"" [dep-msg]))
        (map print
            [
                (expect "<<TX002>> UC_IsStandardApollo false for Π." false (ref-PYTHIA::UC_IsStandardApollo apollo-smt))
                (expect "<<TX002>> URH_ApiKeyCount >= 2" true (>= (ref-PYTHIA::URH_ApiKeyCount) 2))
            ]
        )
        ""
    )
)
(commit-tx)
(print "")
(begin-tx "TX003 - C_Link inactive dual row")
(namespace "ouronet-ns")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(print "=== TX003 — C_Link (inactive) ===========================================")
(let
    (
        (apollo-std:string (read-string "PYTHIA|APOLLO-STANDARD"))
        (apollo-smt:string (read-string "PYTHIA|APOLLO-SMART"))
        (lane-dual:string (read-string "PYTHIA|LANE-DUAL"))
        (owner-acct:string (if (= (read-string "PYTHIA|OWNER-ACCOUNT") "") KST.ANHD (read-string "PYTHIA|OWNER-ACCOUNT")))
        (ref-TS01-C4:module{TalosStageOne_ClientFourV8} TS01-C4)
        (ref-PYTHIA:module{PythiaV5} PYTHIA)
        (dlk:string (ref-PYTHIA::UC_DualLinkKey apollo-std apollo-smt))
    )
    (env-sigs [{ "key": "PK_AncientHodler", "caps": [] }])
    ;;FUNCTION COVERAGE (G6) — `INFO_PYTHIA|Link`, per the owner's spec. Template: `<<ATS-I1>>`.
    ;;This is the FREE op of the family, and a preview claiming "free" is precisely the shape that was
    ;;wrong in INFO_EQUITY|IssueCompany / INFO_SWP|ToggleFeeLock / INFO_ATS|ToggleParameterLock — so
    ;;the zero is measured, not taken on trust. Note the preview takes no patron (linking is not
    ;;billed to anyone), so "free" is checked against the account that would pay if it ever were.
    (let (
            (predicted:object{OuronetInfoV2.ClientInfo}
                (PYTHIA.INFO_PYTHIA|Link apollo-std apollo-smt lane-dual))
            (stoa-before:decimal (coin.get-balance (DALOS.UR_AccountStoa KST.ANHD)))
            (ignis-before:decimal (DALOS.UR_TF_AccountSupply KST.ANHD false))
            (link-msg:string (ref-TS01-C4::PYTHIA|C_Link apollo-std apollo-smt lane-dual))
         )
        (map print
            [
                (expect "<<TX003-INFO>> INFO_PYTHIA|Link quotes zero STOA, and the link really takes none"
                    (- stoa-before (coin.get-balance (DALOS.UR_AccountStoa KST.ANHD)))
                    (at "stoa-need" (at "stoa" predicted)))
                (expect "<<TX003-INFO>> ...and zero IGNIS likewise"
                    (- ignis-before (DALOS.UR_TF_AccountSupply KST.ANHD false))
                    (at "ignis-need" (at "ignis" predicted)))
                ;;what stops this being vacuous is that the op is independently proven below to have
                ;;DONE something — it creates the dual row. A free no-op would fail those, not these.
                (expect "<<TX003-INFO>> ...and the quote really is zero, not merely equal to the charge"
                    0.0 (at "stoa-need" (at "stoa" predicted)))
            ]
        )
        (print (format "<(TS01-C4.PYTHIA|C_Link)> => \"{}\"" [link-msg]))
        (map print
            [
                (expect "<<TX003>> dual key length 325" 325 (length dlk))
                (expect "<<TX003>> UR_Counterpart set on Standard" apollo-smt (ref-PYTHIA::UR_Counterpart apollo-std))
                (expect "<<TX003>> UR_Counterpart set on Smart" apollo-std (ref-PYTHIA::UR_Counterpart apollo-smt))
                (expect "<<TX003>> UR_DualLinkConsumerLane set" lane-dual (ref-PYTHIA::UR_DualLinkConsumerLane dlk))
                (expect "<<TX003>> UR_DualLinkIzActive false" false (ref-PYTHIA::UR_DualLinkIzActive dlk))
                (expect "<<TX003>> URH_DualLinkCount >= 1" true (>= (ref-PYTHIA::URH_DualLinkCount) 1))
            ]
        )
        ""
    )
)
(commit-tx)
(print "")
(begin-tx "TX004 - A_Link Cronoton activate")
(namespace "ouronet-ns")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(print "=== TX004 — A_Link (Cronoton activate) ==================================")
(let
    (
        (apollo-std:string (read-string "PYTHIA|APOLLO-STANDARD"))
        (apollo-smt:string (read-string "PYTHIA|APOLLO-SMART"))
        (ref-TS01-C4:module{TalosStageOne_ClientFourV8} TS01-C4)
        (ref-PYTHIA:module{PythiaV5} PYTHIA)
        (dlk:string (ref-PYTHIA::UC_DualLinkKey apollo-std apollo-smt))
    )
    (env-sigs [{ "key": "PK_AncientHodler", "caps": [] }])
    (let ((act-msg:string (ref-TS01-C4::PYTHIA|A_Link apollo-std apollo-smt)))
        (print (format "<(TS01-C4.PYTHIA|A_Link)> => \"{}\"" [act-msg]))
        (map print
            [
                (expect "<<TX004>> UR_DualLinkIzActive true" true (ref-PYTHIA::UR_DualLinkIzActive dlk))
                (expect "<<TX004>> UR_DualLinkIzActiveOrFalse true" true (ref-PYTHIA::UR_DualLinkIzActiveOrFalse dlk))
                (expect "<<TX004>> URH_ActiveDualLinkSet contains dlk" true (contains dlk (ref-PYTHIA::URH_ActiveDualLinkSet)))
                (expect "<<TX004>> URH_ApiKeyByConsumer iz-active true" true (at "iz-active" (ref-PYTHIA::URH_ApiKeyByConsumer apollo-smt)))
                ;;`22_PYTHIA.pact:454`. A_Link is CREATE-OR-ACTIVATE: if the dual row is missing it
                ;;creates one, and if the row exists it flips inactive -> active. The guard covers the
                ;;second path and demands the row be (a) currently INACTIVE and (b) carrying matching
                ;;counterparts both ways.
                ;;
                ;;The activation two lines up satisfied it and flipped the row to ACTIVE, so the
                ;;IDENTICAL call is now refused -- activating something already active is not
                ;;idempotent here, it is an error. Reached with no new fixture: the only thing that
                ;;changed between the accepted call and the refused one is the row's own state.
                ;;
                ;;The OTHER two conjuncts (counterpart agreement) are a different matter and are
                ;;annotated UNREACHABLE at :1353/:1377 -- XI_ApplyDualCounterparts writes both
                ;;counterparts atomically before WI_DualLink, so they cannot disagree. This is the
                ;;one conjunct of the three that a caller can actually trip.
                (expect-failure "<<TX004>> ...so re-activating an ALREADY-ACTIVE dual link is refused"
                    "Dual link not ready for Cronoton activate"
                    (ref-TS01-C4::PYTHIA|A_Link apollo-std apollo-smt))
            ]
        )
        ""
    )
)
(commit-tx)
(print "")
(begin-tx "TX005 - C_RevokeLink owner + IGNIS")
(namespace "ouronet-ns")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(print "=== TX005 — C_RevokeLink (owner) ========================================")
(let
    (
        (apollo-std:string (read-string "PYTHIA|APOLLO-STANDARD"))
        (apollo-smt:string (read-string "PYTHIA|APOLLO-SMART"))
        (owner-acct:string (if (= (read-string "PYTHIA|OWNER-ACCOUNT") "") KST.ANHD (read-string "PYTHIA|OWNER-ACCOUNT")))
        (patron:string KST.ANHD)
        (ref-TS01-C4:module{TalosStageOne_ClientFourV8} TS01-C4)
        (ref-PYTHIA:module{PythiaV5} PYTHIA)
        (dlk:string (ref-PYTHIA::UC_DualLinkKey apollo-std apollo-smt))
        (revoke-fee:decimal (ref-PYTHIA::UC_RevokeIgnisFee))
        (height-before:integer (ref-PYTHIA::UR_RevocationAtHeight))
    )
    (env-sigs [{ "key": "PK_AncientHodler", "caps": [] }])
    ;;FUNCTION COVERAGE (G6) — `INFO_PYTHIA|RevokeLink`, per the owner's spec. Template: `<<ATS-I1>>`.
    ;;Revoke is the IGNIS-charging member of this family (deploy and rename charge STOA, link is free),
    ;;so all three billing shapes in PYTHIA now have a measured preview.
    (let (
            (predicted:object{OuronetInfoV2.ClientInfo} (PYTHIA.INFO_PYTHIA|RevokeLink patron dlk))
            (ignis-before:decimal (DALOS.UR_TF_AccountSupply patron false))
            (rev-msg:string (ref-TS01-C4::PYTHIA|C_RevokeLink patron dlk))
         )
        (map print
            [
                (expect "<<TX005-INFO>> the preview's IGNIS quote equals what the revoke charged"
                    (- ignis-before (DALOS.UR_TF_AccountSupply patron false))
                    (at "ignis-need" (at "ignis" predicted)))
                (expect "<<TX005-INFO>> ...and revoking is NOT free"
                    true (> (- ignis-before (DALOS.UR_TF_AccountSupply patron false)) 0.0))
            ]
        )
        (print (format "<(PYTHIA|UC_RevokeIgnisFee)> => \"{}\" IGNIS" [revoke-fee]))
        (print (format "<(TS01-C4.PYTHIA|C_RevokeLink)> => \"{}\"" [rev-msg]))
        (map print
            [
                (expect "<<TX005>> UR_DualLinkIzActive false after revoke" false (ref-PYTHIA::UR_DualLinkIzActive dlk))
                (expect "<<TX005>> UR_RevocationAtHeight recorded" 378734 (ref-PYTHIA::UR_RevocationAtHeight))
                (expect "<<TX005>> UR_RevocationEpoch chain epoch 3156" 3156 (ref-PYTHIA::UR_RevocationEpoch))
                (expect "<<TX005>> height changed from before" true (> (ref-PYTHIA::UR_RevocationAtHeight) height-before))
                (expect "<<TX005>> counterparts immutable" apollo-smt (ref-PYTHIA::UR_Counterpart apollo-std))
            ]
        )
        ""
    )
)
(commit-tx)
(print "")
(begin-tx "TX006 - A_Link re-activate + rename")
(namespace "ouronet-ns")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(print "=== TX006 — A_Link re-activate + rename =================================")
(let
    (
        (apollo-std:string (read-string "PYTHIA|APOLLO-STANDARD"))
        (apollo-smt:string (read-string "PYTHIA|APOLLO-SMART"))
        (lane-renamed:string (read-string "PYTHIA|LANE-RENAMED"))
        (owner-acct:string (if (= (read-string "PYTHIA|OWNER-ACCOUNT") "") KST.ANHD (read-string "PYTHIA|OWNER-ACCOUNT")))
        (patron:string KST.ANHD)
        (ref-DALOS:module{OuronetDalosV2} DALOS)
        (ref-TS01-C4:module{TalosStageOne_ClientFourV8} TS01-C4)
        (ref-PYTHIA:module{PythiaV5} PYTHIA)
        (dlk:string (ref-PYTHIA::UC_DualLinkKey apollo-std apollo-smt))
        (rename-fee:decimal (ref-PYTHIA::UC_RenamePrice))
        (patron-stoa:string (ref-DALOS::UR_AccountStoa patron))
        (demiurgoi:[string] (ref-DALOS::UR_DemiurgoiID))
        (split-stoa:[decimal] (ref-DALOS::URC_SplitSTOAPrices (ref-PYTHIA::UC_FeeDiscountAnchor) rename-fee))
    )
    (env-sigs [{ "key": "PK_AncientHodler", "caps": [] }])
    (let ((react-msg:string (ref-TS01-C4::PYTHIA|A_Link apollo-std apollo-smt)))
        (print (format "<(TS01-C4.PYTHIA|A_Link)> => \"{}\"" [react-msg]))
        ""
    )
    (env-sigs
        [
            { "key": "PK_AncientHodler", "caps": [] }
            { "key": "6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263",
              "caps":
                [
                    (coin.TRANSFER patron-stoa (ref-DALOS::UR_AccountStoa (at 1 demiurgoi)) (at 2 split-stoa))
                    (coin.TRANSFER patron-stoa (ref-DALOS::UR_AccountStoa (at 2 demiurgoi)) (at 0 split-stoa))
                    (coin.TRANSFER patron-stoa (ref-DALOS::UR_AccountStoa (ref-DALOS::GOV|OUROBOROS|SC_NAME)) (at 3 split-stoa))
                    (coin.TRANSFER patron-stoa (ref-DALOS::UR_AccountStoa (ref-DALOS::GOV|DALOS|SC_NAME)) (at 1 split-stoa))
                ]
            }
        ]
    )
    ;;FUNCTION COVERAGE (G6) — `INFO_PYTHIA|UpdateDualConsumerLane`, per the owner's spec.
    ;;Template: `<<ATS-I1>>`. This completes the family: deploy (STOA) at <<TX001-INFO>>, link (free)
    ;;at <<TX003-INFO>>, revoke (IGNIS) at <<TX005-INFO>>, rename (STOA) here — so every one of
    ;;PYTHIA's four client ops now has its quote measured against the charge, and all three billing
    ;;shapes the module uses are covered.
    (let (
            (predicted:object{OuronetInfoV2.ClientInfo}
                (PYTHIA.INFO_PYTHIA|UpdateDualConsumerLane patron dlk lane-renamed))
            (stoa-before:decimal (coin.get-balance patron-stoa))
            (ren-msg:string (ref-TS01-C4::PYTHIA|C_UpdateDualConsumerLane patron dlk lane-renamed))
         )
        (map print
            [
                (format "<<TX006-INFO>> STOA predicted={} real={}"
                    [(at "stoa-need" (at "stoa" predicted)) (- stoa-before (coin.get-balance patron-stoa))])
                (expect "<<TX006-INFO>> the preview's STOA quote equals what the rename charged"
                    (- stoa-before (coin.get-balance patron-stoa)) (at "stoa-need" (at "stoa" predicted)))
                (expect "<<TX006-INFO>> ...and renaming a consumer lane is NOT free"
                    true (> (- stoa-before (coin.get-balance patron-stoa)) 0.0))
            ]
        )
        (print (format "<(TS01-C4.PYTHIA|C_UpdateDualConsumerLane)> => \"{}\"" [ren-msg]))
        (map print
            [
                (expect "<<TX006>> UR_DualLinkIzActive true after re-activate" true (ref-PYTHIA::UR_DualLinkIzActive dlk))
                (expect "<<TX006>> UR_DualLinkConsumerLane renamed" lane-renamed (ref-PYTHIA::UR_DualLinkConsumerLane dlk))
                (expect "<<TX006>> UR_ApiKeyBySlot iz-active true" true (at "iz-active" (ref-PYTHIA::UR_ApiKeyBySlot apollo-std)))
            ]
        )
        ""
    )
)
(commit-tx)
(print "")
