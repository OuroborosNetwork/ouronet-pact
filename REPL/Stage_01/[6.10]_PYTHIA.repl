(print "")
(begin-tx "TX005 - C_RevokeLink owner + IGNIS")
(namespace "ouronet-ns")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(print "=== TX005 — C_RevokeLink (owner) ========================================")
(let
    (
        (apollo-std:string (read-string "PYTHIA|APOLLO-STANDARD"))
        (apollo-smt:string (read-string "PYTHIA|APOLLO-SMART"))
        (owner-acct:string (if (= (read-string "PYTHIA|OWNER-ACCOUNT") "") KST.ANHD (read-string "PYTHIA|OWNER-ACCOUNT")))
        (patron:string KST.ANHD)
        (ref-TS01-C4:module{TalosStageOne_ClientFourV8} TS01-C4)
        (ref-PYTHIA:module{PythiaV5} PYTHIA)
        (dlk:string (ref-PYTHIA::UC_DualLinkKey apollo-std apollo-smt))
        (revoke-fee:decimal (ref-PYTHIA::UC_RevokeIgnisFee))
        (height-before:integer (ref-PYTHIA::UR_RevocationAtHeight))
    )
    (env-sigs [{ "key": "PK_AncientHodler", "caps": [] }])
    (let ((rev-msg:string (ref-TS01-C4::PYTHIA|C_RevokeLink patron dlk)))
        (print (format "<(PYTHIA|UC_RevokeIgnisFee)> => \"{}\" IGNIS" [revoke-fee]))
        (print (format "<(TS01-C4.PYTHIA|C_RevokeLink)> => \"{}\"" [rev-msg]))
        (map print
            [
                (expect "<<TX005>> UR_DualLinkIzActive false after revoke" false (ref-PYTHIA::UR_DualLinkIzActive dlk))
                (expect "<<TX005>> UR_RevocationAtHeight recorded" 378734 (ref-PYTHIA::UR_RevocationAtHeight))
                (expect "<<TX005>> UR_RevocationEpoch chain epoch 3156" 3156 (ref-PYTHIA::UR_RevocationEpoch))
                (expect "<<TX005>> height changed from before" true (> (ref-PYTHIA::UR_RevocationAtHeight) height-before))
                (expect "<<TX005>> counterparts immutable" apollo-smt (ref-PYTHIA::UR_Counterpart apollo-std))
            ]
        )
        ""
    )
)
(commit-tx)
(print "")
(begin-tx "TX006 - A_Link re-activate + rename")
