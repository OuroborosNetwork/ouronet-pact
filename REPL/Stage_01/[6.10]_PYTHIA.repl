(begin-tx "TX001 - deploy Standard half")
(namespace "ouronet-ns")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(print "=== TX001 — C_DeployApiKey (Standard ₱.) =================================")
(let
    (
        (apollo-std:string (read-string "PYTHIA|APOLLO-STANDARD"))
        (public-std:string (read-string "PYTHIA|PUBLIC-STANDARD"))
        (owner-acct:string (if (= (read-string "PYTHIA|OWNER-ACCOUNT") "") KST.ANHD (read-string "PYTHIA|OWNER-ACCOUNT")))
        (patron:string KST.ANHD)
        (ref-DALOS:module{OuronetDalosV2} DALOS)
        (ref-TS01-C4:module{TalosStageOne_ClientFourV8} TS01-C4)
        (ref-PYTHIA:module{PythiaV5} PYTHIA)
        (deploy-fee:decimal (ref-PYTHIA::UC_DeployPrice))
        (patron-stoa:string (ref-DALOS::UR_AccountStoa patron))
        (demiurgoi:[string] (ref-DALOS::UR_DemiurgoiID))
        (split-stoa:[decimal] (ref-DALOS::URC_SplitSTOAPrices (ref-PYTHIA::UC_FeeDiscountAnchor) deploy-fee))
    )
    (print (format "<(PYTHIA|UC_DeployPrice)> => \"{}\" STOA" [deploy-fee]))
    (env-sigs
        [
            { "key": "PK_AncientHodler", "caps": [] }
            { "key": "6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263",
              "caps":
                [
                    (coin.TRANSFER patron-stoa (ref-DALOS::UR_AccountStoa (at 1 demiurgoi)) (at 2 split-stoa))
                    (coin.TRANSFER patron-stoa (ref-DALOS::UR_AccountStoa (at 2 demiurgoi)) (at 0 split-stoa))
                    (coin.TRANSFER patron-stoa (ref-DALOS::UR_AccountStoa (ref-DALOS::GOV|OUROBOROS|SC_NAME)) (at 3 split-stoa))
                    (coin.TRANSFER patron-stoa (ref-DALOS::UR_AccountStoa (ref-DALOS::GOV|DALOS|SC_NAME)) (at 1 split-stoa))
                ]
            }
        ]
    )
    ;;FUNCTION COVERAGE (G6) — `INFO_PYTHIA|DeployApiKey`, per the owner's spec: an INFO_ must report
    ;;the same cost the op actually charges. Template: `modules/ATS.repl <<ATS-I1>>`.
    ;;
    ;;The preview and the exec take IDENTICAL arguments, so the quote below is read with exactly what
    ;;the op is then handed — the strongest form of this test, with no translation step between the
    ;;two call sites where a mistake could hide.
    ;;
    ;;This op is the interesting case in the family: PYTHIA fees are NON-discountable by spec, so the
    ;;exec calls `STOA|C_CollectFull patron deploy-fee false` (not the discounted `STOA|C_Collect`),
    ;;and the preview correspondingly anchors to `UC_FeeDiscountAnchor` rather than to the patron. If
    ;;either side ever moves to the ordinary discounted path alone, the two figures separate and this
    ;;fails — which is the only thing that would catch it, since a discount is silent by nature.
    ;;
    ;;The four bindings below rely on `let` being EAGER and ORDERED in Pact: `predicted` and the two
    ;;"before" balances are evaluated, in order, BEFORE `dep-msg` runs the operation. That eagerness
    ;;is the same property that causes the mute-guard bug class elsewhere in this codebase; here it is
    ;;exactly what the measurement needs.
    (let (
            (predicted:object{OuronetInfoV2.ClientInfo}
                (PYTHIA.INFO_PYTHIA|DeployApiKey patron owner-acct apollo-std public-std))
            (stoa-before:decimal (coin.get-balance patron-stoa))
            (ignis-before:decimal (ref-DALOS::UR_TF_AccountSupply patron false))
            (dep-msg:string (ref-TS01-C4::PYTHIA|C_DeployApiKey patron owner-acct apollo-std public-std))
         )
        (print (format "<(TS01-C4.PYTHIA|C_DeployApiKey)> => \"{}\"" [dep-msg]))
        (map print
            [
                (format "<<TX001-INFO>> STOA predicted={} real={}"
                    [(at "stoa-need" (at "stoa" predicted)) (- stoa-before (coin.get-balance patron-stoa))])
                (expect "<<TX001-INFO>> the preview's STOA quote equals the STOA the deploy charged"
                    (- stoa-before (coin.get-balance patron-stoa)) (at "stoa-need" (at "stoa" predicted)))
                ;;...and it is a real charge, so the equality is not two zeros agreeing
                (expect "<<TX001-INFO>> ...and deploying an Apollo half is NOT free"
                    true (> (- stoa-before (coin.get-balance patron-stoa)) 0.0))
                ;;the preview also claims the op costs no IGNIS — asserted, not assumed, because a
                ;;literal zero for a currency the op really charges is exactly the defect found in
                ;;INFO_EQUITY|IssueCompany, INFO_SWP|ToggleFeeLock and INFO_ATS|ToggleParameterLock.
                (expect "<<TX001-INFO>> the preview quotes zero IGNIS, and zero IGNIS is what it takes"
                    (- ignis-before (ref-DALOS::UR_TF_AccountSupply patron false))
                    (at "ignis-need" (at "ignis" predicted)))
                (expect "<<TX001>> UR_ApiKeyRowOrNull is-registered true" true (at "is-registered" (ref-PYTHIA::UR_ApiKeyRowOrNull apollo-std)))
                (expect "<<TX001>> registered-at block-time" TV.TIME00 (ref-PYTHIA::UR_RegisteredAt apollo-std))
                (expect "<<TX001>> updated-at block-time" TV.TIME00 (ref-PYTHIA::UR_UpdatedAt apollo-std))
                (expect "<<TX001>> UC_IsStandardApollo true" true (ref-PYTHIA::UC_IsStandardApollo apollo-std))
                (expect "<<TX001>> URH_ApiKeyCount >= 1" true (>= (ref-PYTHIA::URH_ApiKeyCount) 1))
            ]
        )
        ""
    )
)
(commit-tx)
(print "")
(begin-tx "TX002 - deploy Smart half")
(namespace "ouronet-ns")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(print "=== TX002 — C_DeployApiKey (Smart Π.) ===================================")
(let
    (
        (apollo-smt:string (read-string "PYTHIA|APOLLO-SMART"))
        (public-smt:string (read-string "PYTHIA|PUBLIC-SMART"))
        (owner-acct:string (if (= (read-string "PYTHIA|OWNER-ACCOUNT") "") KST.ANHD (read-string "PYTHIA|OWNER-ACCOUNT")))
