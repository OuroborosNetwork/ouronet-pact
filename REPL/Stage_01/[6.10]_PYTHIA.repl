(begin-tx "TX007e - the dual-link validators, as mirror images")
(namespace "ouronet-ns")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(print "=== TX007e - PYTHIA dual-link guard family ==============================")
;;==== TX007e · 01 · composite key shape ==== ======================================================
(print "--- [TX007e · 01 · composite key shape] ---")
;; P3.3. PYTHIA's remaining unpinned guards are all UEV_ -- unprotected, so a direct call is the
;; whole test -- and this file has already built everything they read: pair-1 LINKED (TX006
;; re-activated it) and pair-2 linked-then-revoked (TX007d), with counterparts surviving the
;; revoke.
;;
;; A dual-link key is standard(162) + BAR + smart(162) = 325. Both trips below keep every other
;; property intact and break exactly one, so neither can pass for the wrong reason.
(env-sigs [])
(let
    (
        (ref-PYTHIA:module{PythiaV5} PYTHIA)
        (apollo-std:string (read-string "PYTHIA|APOLLO-STANDARD"))
        (apollo-smt:string (read-string "PYTHIA|APOLLO-SMART"))
    )
    (let
        (
            (dlk:string (ref-PYTHIA::UC_DualLinkKey apollo-std apollo-smt))
        )
        (map print
            [
                ;;HAPPY PATH: the key the module builds itself must validate. Without it a
                ;;validator that rejected everything would satisfy both rejections below.
                (expect "<<TX007e-01>> the key UC_DualLinkKey builds is valid"
                    true (ref-PYTHIA::UEV_ValidateCompositeDualLinkKey dlk))
                (expect "<<TX007e-01>> ...and it really is 325 characters"
                    325 (length dlk))
                ;;LENGTH: one character short, everything else untouched.
                (expect-failure "<<TX007e-01>> a 324-character key is refused on length"
                    "Dual link key length must be 325"
                    (ref-PYTHIA::UEV_ValidateCompositeDualLinkKey (drop 1 dlk)))
                ;;SEPARATOR: length preserved at 325, only the byte at the join replaced. This is
                ;;the trip that a length-only guard would let through -- two valid apollo halves
                ;;glued with the wrong character still measure 325.
                (expect-failure "<<TX007e-01>> ...and a 325-character key with the WRONG separator"
                    "Dual link key separator must be BAR"
                    (ref-PYTHIA::UEV_ValidateCompositeDualLinkKey
                        (+ (take 162 dlk) (+ "X" (drop 163 dlk)))))
            ]
        )
        ""
    )
)
(print "")
;;==== TX007e · 02 · the two link-state validators are mirror images ==== ==========================
(print "--- [TX007e · 02 · the two link-state validators are mirror images] ---")
;;UEV_DualPairForLink and UEV_DualPairReadyForActivate read the SAME two counterparts and demand
;;OPPOSITE things of them:
;;
;;    ForLink            counterpart == BAR            (both halves still free)
;;    ReadyForActivate   counterpart == the other half (already linked to each other)
;;
;;So one linked pair exercises both, in both directions, with no new fixture: ReadyForActivate
;;must accept it and ForLink must refuse it. That is strictly stronger than testing either
;;alone -- it shows each is reading the link state and reacting to it, rather than passing or
;;failing for some unrelated reason.
(let
    (
        (ref-PYTHIA:module{PythiaV5} PYTHIA)
        (apollo-std:string (read-string "PYTHIA|APOLLO-STANDARD"))
        (apollo-smt:string (read-string "PYTHIA|APOLLO-SMART"))
    )
    (map print
        [
            ;;state precondition, asserted rather than assumed: pair-1 IS mutually linked.
            (expect "<<TX007e-02>> pair-1's halves point at each other"
                [apollo-smt apollo-std]
                [(ref-PYTHIA::UR_Counterpart apollo-std) (ref-PYTHIA::UR_Counterpart apollo-smt)])
            ;;the LINKED direction passes...
            (expect "<<TX007e-02>> ReadyForActivate ACCEPTS a mutually-linked pair, returning its key"
                (ref-PYTHIA::UC_DualLinkKey apollo-std apollo-smt)
                (ref-PYTHIA::UEV_DualPairReadyForActivate apollo-std apollo-smt))
            ;;...and the same pair fails the opposite validator, on its first counterpart check.
            (expect-failure "<<TX007e-02>> ...while ForLink REFUSES it: the standard half is taken"
                "Standard half is already linked"
                (ref-PYTHIA::UEV_DualPairForLink apollo-std apollo-smt))
        ]
    )
    ""
)
(print "")
;;==== TX007e · 03 · the mirror, on the revoked pair ==== ==========================================
(print "--- [TX007e · 03 · the mirror, on the revoked pair] ---")
;;Pair-2 was revoked in TX007d, and the assertion there was that revoke is a DEACTIVATION, not an
;;unlink -- the counterparts survive. This is the consequence, and it is worth pinning because it
;;is not obvious: a revoked pair still satisfies ReadyForActivate (which is exactly what lets
;;A_Link flip it back on) and still fails ForLink (its halves are not free).
(let
    (
        (ref-PYTHIA:module{PythiaV5} PYTHIA)
        (apollo-std:string (read-string "PYTHIA|APOLLO-STANDARD-2"))
        (apollo-smt:string (read-string "PYTHIA|APOLLO-SMART-2"))
    )
    (map print
        [
            (expect "<<TX007e-03>> the revoked pair's link is OFF"
                false (ref-PYTHIA::UR_DualLinkIzActive
                        (ref-PYTHIA::UC_DualLinkKey apollo-std apollo-smt)))
            (expect "<<TX007e-03>> ...yet ReadyForActivate still accepts it -- which is what lets A_Link re-arm it"
                (ref-PYTHIA::UC_DualLinkKey apollo-std apollo-smt)
                (ref-PYTHIA::UEV_DualPairReadyForActivate apollo-std apollo-smt))
            (expect-failure "<<TX007e-03>> ...and ForLink still refuses it: revoked is not unlinked"
                "Standard half is already linked"
                (ref-PYTHIA::UEV_DualPairForLink apollo-std apollo-smt))
            ;;FINDING -- ForLink DEGRADES on an undeployed half. Its first act is
            ;;(UR_Counterpart standard-apollo), a HARD read of PYTHIA|T|ApiKeys, so a half that
            ;;was never deployed aborts there with a raw table miss naming the 162-glyph row key
            ;;-- not "this half does not exist". Reaching the guard at all requires the half to be
            ;;deployed already, which is the same shape as the shadowed guards catalogued in
            ;;ARCHITECTURE 2.5.2, in its DEGRADED form: the guard is live for its real case
            ;;(deployed-but-taken) and unhelpful for the case a caller is most likely to hit.
            (expect-failure "<<TX007e-03>> FINDING: an UNDEPLOYED half aborts in the table read, not a named guard"
                "No value found in table"
                (ref-PYTHIA::UEV_DualPairForLink
                    (+ "₱" (drop 1 KST.ANHD)) (read-string "PYTHIA|APOLLO-SMART")))
            ;;The "Smart half is already linked" enforce needed a standard half that is DEPLOYED
            ;;AND FREE paired with a taken smart half -- a state this suite did not have, because
            ;;TX003 and TX007c link both pairs immediately. TX007f below deploys that third
            ;;standard half and pins it.
        ]
    )
    ""
)
(print "")
(print "===^^^===")
(commit-tx)
(print "")
(begin-tx "TX007f - deploy a THIRD standard half, free, to reach the smart-half guard")
(namespace "ouronet-ns")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(print "=== TX007f — C_DeployApiKey (Standard ₱. #3, deliberately left UNLINKED) ===")
;;P3.3. The fixture TX007e-03 recorded as missing. UEV_DualPairForLink checks its two halves in
;;order -- standard first, then smart -- so the SMART-half guard is unreachable while every
;;standard half in the suite is already linked: the first enforce answers before the second is
;;asked. Reaching it needs one standard half that is deployed and FREE, which is all this
;;transaction creates. It is never linked, on purpose.
(let
    (
        (apollo-std3:string (read-string "PYTHIA|APOLLO-STANDARD-3"))
        (public-std:string (read-string "PYTHIA|PUBLIC-STANDARD"))
        (patron:string KST.ANHD)
        (ref-DALOS:module{OuronetDalosV2} DALOS)
        (ref-TS01-C4:module{TalosStageOne_ClientFourV8} TS01-C4)
        (ref-PYTHIA:module{PythiaV5} PYTHIA)
        (deploy-fee:decimal (ref-PYTHIA::UC_DeployPrice))
        (patron-stoa:string (DALOS.UR_AccountStoa KST.ANHD))
        (demiurgoi:[string] (ref-DALOS::UR_DemiurgoiID))
        (split-stoa:[decimal] (ref-DALOS::URC_SplitSTOAPrices (ref-PYTHIA::UC_FeeDiscountAnchor) (ref-PYTHIA::UC_DeployPrice)))
    )
    (env-sigs
        [
            { "key": "PK_AncientHodler", "caps": [] }
            { "key": "6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263",
              "caps":
                [
                    (coin.TRANSFER patron-stoa (ref-DALOS::UR_AccountStoa (at 1 demiurgoi)) (at 2 split-stoa))
                    (coin.TRANSFER patron-stoa (ref-DALOS::UR_AccountStoa (at 2 demiurgoi)) (at 0 split-stoa))
                    (coin.TRANSFER patron-stoa (ref-DALOS::UR_AccountStoa (ref-DALOS::GOV|OUROBOROS|SC_NAME)) (at 3 split-stoa))
                    (coin.TRANSFER patron-stoa (ref-DALOS::UR_AccountStoa (ref-DALOS::GOV|DALOS|SC_NAME)) (at 1 split-stoa))
                ]
            }
        ]
    )
    (let ((dep-msg:string (ref-TS01-C4::PYTHIA|C_DeployApiKey patron KST.ANHD apollo-std3 public-std)))
        (print (format "<(TS01-C4.PYTHIA|C_DeployApiKey)> => \"{}\"" [dep-msg]))
        ""
    )
)
(commit-tx)
(print "")
(begin-tx "TX007g - the smart-half guard, and three siblings that CANNOT be reached")
(namespace "ouronet-ns")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
;;==== TX007g · 01 · UEV_DualPairForLink, second enforce ==== =====================================
(print "--- [TX007g · 01 · UEV_DualPairForLink, second enforce] ---")
;;With a free standard half in hand, pairing it against pair-1's ALREADY-LINKED smart half walks
;;past the first enforce and lands on the second. Both preconditions are asserted rather than
;;assumed -- the third half free, the smart half taken -- because if either were wrong this test
;;would still fail, just for the wrong reason, and would read as a pass.
(let
    (
        (ref-PYTHIA:module{PythiaV5} PYTHIA)
        (apollo-std3:string (read-string "PYTHIA|APOLLO-STANDARD-3"))
        (apollo-smt:string (read-string "PYTHIA|APOLLO-SMART"))
    )
    (map print
        [
            (expect "<<TX007g>> the third standard half is deployed"
                true (at "is-registered" (ref-PYTHIA::UR_ApiKeyRowOrNull apollo-std3)))
            (expect "<<TX007g>> ...and FREE, so the first enforce will not answer for us"
                "|" (ref-PYTHIA::UR_Counterpart apollo-std3))
            (expect "<<TX007g>> ...while pair-1's smart half is taken"
                (read-string "PYTHIA|APOLLO-STANDARD") (ref-PYTHIA::UR_Counterpart apollo-smt))
            ;;the guard itself
            (expect-failure "<<TX007g>> a FREE standard half against a TAKEN smart half trips the smart guard"
                "Smart half is already linked"
                (ref-PYTHIA::UEV_DualPairForLink apollo-std3 apollo-smt))
            ;;and the third half is not simply broken -- paired with a free smart half it would
            ;;pass, except no free smart half exists, so the closest available check is that its
            ;;own row reads back as a standard apollo.
            (expect "<<TX007g>> the third half is a well-formed standard apollo"
                true (ref-PYTHIA::UC_IsStandardApollo apollo-std3))
        ]
    )
    ""
)
(print "")
;;==== TX007g · 02 · the three that cannot be reached, and why ==== ===============================
(print "--- [TX007g · 02 · three UNREACHABLE siblings] ---")
;;FINDING, recorded instead of tested. Three enforces in this family cannot be tripped by any
;;input, and the reason is one design decision rather than three accidents:
;;
;;    XI_ApplyDualCounterparts writes BOTH counterparts, and every caller (A_LinkDualApiKey and
;;    C_LinkDualApiKey) follows it with WI_DualLink in the SAME transaction. Counterparts are
;;    then never cleared -- C_RevokeDualLink deactivates the link and says so in its own client
;;    info: "Counterpart fields remain immutable; deploy fresh halves to re-pair."
;;
;;From which:
;;
;;  UEV_DualPairForLink       "Dual link row already exists for this pair"
;;      The row exists only if the pair was linked, and linking set both counterparts. So the
;;      row's existence IMPLIES the first enforce already fired. Fail-closed backstop.
;;
;;  UEV_DualPairReadyForActivate  "Smart half not linked to Standard"
;;      Requires std->smt while smt-/->std. The two writes are one atomic pair, so the halves
;;      cannot disagree. Any genuine mismatch trips the STANDARD-side enforce one line earlier.
;;
;;  ...and the same reasoning covers the DPMF-side twin of this pattern.
;;
;;These are annotated at their definitions. They are correct code -- a backstop that survives a
;;future non-atomic write path -- but they are not coverage, and counting them as unpinned work
;;would misreport the worklist. Below is the positive half of the argument: the pair really is
;;symmetric, which is what makes the mismatch unconstructible.
(let
    (
        (ref-PYTHIA:module{PythiaV5} PYTHIA)
        (apollo-std:string (read-string "PYTHIA|APOLLO-STANDARD"))
        (apollo-smt:string (read-string "PYTHIA|APOLLO-SMART"))
    )
    (map print
        [
            (expect "<<TX007g>> the linked pair is SYMMETRIC — each half names the other"
                [apollo-smt apollo-std]
                [(ref-PYTHIA::UR_Counterpart apollo-std) (ref-PYTHIA::UR_Counterpart apollo-smt)])
            ;;and a half-and-stranger pairing fails on the STANDARD side, never the smart side —
            ;;which is the concrete demonstration that the smart-side enforce is unreachable.
            (expect-failure "<<TX007g>> ...so a mismatched pair always trips the STANDARD enforce first"
                "Standard half not linked to Smart"
                (ref-PYTHIA::UEV_DualPairReadyForActivate
                    (read-string "PYTHIA|APOLLO-STANDARD-3") apollo-smt))
        ]
    )
    ""
)
(print "")
(print "===^^^===")
(commit-tx)
(load "[6.10b]_PYTHIA-ledger-v2.repl")
(print "=== [6.10]_PYTHIA.repl complete ========================================")
