(begin-tx "TX004 - PYTHIA|A_ActivateApiKey re-activate + rename")
(namespace "ouronet-ns")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(print "")
(print "=== TX004 — re-activate + C_UpdateApiConsumerName ======================")
(let
    (
        (apollo-std:string (read-string "PYTHIA|APOLLO-STANDARD"))
        (lane-renamed:string (read-string "PYTHIA|LANE-RENAMED"))
        (owner-acct:string
            (if (= (read-string "PYTHIA|OWNER-ACCOUNT") "")
                KST.ANHD
                (read-string "PYTHIA|OWNER-ACCOUNT")
            )
        )
        (patron:string KST.ANHD)
        (ref-DALOS:module{OuronetDalosV1} DALOS)
        (ref-TS01-C4:module{TalosStageOne_ClientFourV3} TS01-C4)
        (ref-PYTHIA:module{PythiaV2} PYTHIA)
        (rename-fee:decimal (ref-PYTHIA::UC_RenamePrice))
        (patron-kda:string (ref-DALOS::UR_AccountKadena patron))
        (demiurgoi:[string] (ref-DALOS::UR_DemiurgoiID))
        (kda-hov:string (ref-DALOS::UR_AccountKadena (at 2 demiurgoi)))
        (kda-cto:string (ref-DALOS::UR_AccountKadena (at 1 demiurgoi)))
        (kda-ouroboros:string (ref-DALOS::UR_AccountKadena (ref-DALOS::GOV|OUROBOROS|SC_NAME)))
        (kda-dalos:string (ref-DALOS::UR_AccountKadena (ref-DALOS::GOV|DALOS|SC_NAME)))
        (split-kda:[decimal] (ref-DALOS::URC_SplitKDAPrices (ref-PYTHIA::UC_FeeDiscountAnchor) rename-fee))
    )
    ;;==== TX004 · 01 · env-sigs (Cronoton re-activate) ====
    (print "--- [TX004 · 01 · env-sigs (Cronoton re-activate)] ---")
    (env-sigs
        [
            { "key": "PK_AncientHodler", "caps": [] }
        ]
    )
    (let
        (
            (react-msg:string (ref-TS01-C4::PYTHIA|A_ActivateApiKey apollo-std))
        )
        ;;==== TX004 · 02 · re-activate ====
        (print "--- [TX004 · 02 · re-activate] ---")
        (print (format "<(TS01-C4.PYTHIA|A_ActivateApiKey)> => \"{}\"" [react-msg]))
        ""
    )
    (env-sigs
        [
            { "key": "PK_AncientHodler", "caps": [] }
            { "key": "6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263",
              "caps":
                [
                    (coin.TRANSFER patron-kda kda-cto (at 2 split-kda))
                    (coin.TRANSFER patron-kda kda-hov (at 0 split-kda))
                    (coin.TRANSFER patron-kda kda-ouroboros (at 3 split-kda))
                    (coin.TRANSFER patron-kda kda-dalos (at 1 split-kda))
                ]
            }
        ]
    )
    (let
        (
            (ren-msg:string
                (ref-TS01-C4::PYTHIA|C_UpdateApiConsumerName
                    patron owner-acct apollo-std lane-renamed
                )
            )
        )
        ;;==== TX004 · 03 · rename ====
        (print "--- [TX004 · 03 · rename] ---")
        (print (format "<(TS01-C4.PYTHIA|C_UpdateApiConsumerName)> => \"{}\"" [ren-msg]))
        ;;==== TX004 · 04 · URD directory expects ====
        (print "--- [TX004 · 04 · URD directory expects] ---")
        (map print
            [
                (expect
                    "<<TX004>> UR_ConsumerLane renamed"
                    lane-renamed
                    (ref-PYTHIA::UR_ConsumerLane apollo-std)
                )
                (expect
                    "<<TX004>> URD_ListAllApiKeys length matches count"
                    (ref-PYTHIA::URD_ApiKeyCount)
                    (length (ref-PYTHIA::URD_ListAllApiKeys))
                )
                (expect
                    "<<TX004>> URD_ListActivatedApiKeys all have activated=true"
                    true
                    (fold
                        (lambda (ok:bool row:object)
                            (and ok (= true (at "activated" row)))
                        )
                        true
                        (ref-PYTHIA::URD_ListActivatedApiKeys)
                    )
                )
            ]
        )
        ""
    )
)
(print (format "<(REPL|env-gas)> TX004 => \"{}\"" [(env-gas)]))
(commit-tx)
(print "")
