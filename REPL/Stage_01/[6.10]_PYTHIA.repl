        ;;==== TX003 · 03 · expects ====
        (print "--- [TX003 · 03 · expects] ---")
        (map print
            [
                (expect
                    "<<TX003>> UR_IsActivated false after owner deactivate"
                    false
                    (ref-PYTHIA::UR_IsActivated apollo-std)
                )
                (expect
                    "<<TX003>> URC_IsActivatedOrFalse false"
                    false
                    (ref-PYTHIA::URC_IsActivatedOrFalse apollo-std)
                )
            ]
        )
        ""
    )
)
(print (format "<(REPL|env-gas)> TX003 => \"{}\"" [(env-gas)]))
