(env-sigs [])
(let
    (
        (ref-LEDGER:module{PythiaLedgerV3} PYTHIA)
        (tot:object{PythiaLedgerV3.PYTHIA|S|PythTotal} (ref-LEDGER::UR_PythTotal))
        (tm:object{PythiaLedgerV3.PYTHIA|S|PythMetrics} (ref-LEDGER::UR_PythTotal|TotalMetrics))
    )
    (map print
        [
            (expect "<<TX008>> UR_PythTotal|LastDay 0" 0 (ref-LEDGER::UR_PythTotal|LastDay))
            (expect "<<TX008>> UR_PythMaxFlushBatch > 0" true (> (ref-LEDGER::UR_PythMaxFlushBatch) 0))
            (expect "<<TX008>> UR_PythLedgerEpochStart" (time "2026-08-01T00:00:00Z") (ref-LEDGER::UR_PythLedgerEpochStart))
            (expect "<<TX008>> total-metrics petitions 0" 0 (at "petitions" tm))
            (expect "<<TX008>> total-metrics pondus 0.0" 0.0 (at "pondus" tm))
            ;; URH_ListPythDaily maps UR_PythDay (hard read) — empty ledger: use invalid range → []
            (expect "<<TX008>> URH_ListPythDaily invalid range []" 0 (length (ref-LEDGER::URH_ListPythDaily 0 0)))
            (expect "<<TX008>> UR_PythTotal last-day field 0" 0 (at "last-day" tot))
        ]
    )
    ""
)
(commit-tx)
(print "")
