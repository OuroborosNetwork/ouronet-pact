;;
;; REPL/Stage_01/[0.1]_Interfaces.repl — canonical integration layout (OuronetInformational/ARCHITECTURE/REPL_AND_TESTS.md)
;;   Inter-tx:   ;;|| NEXT >  (same three lines as REPL/Stage_01/[2.2]_Core.repl)
;;   Intra-tx:   ;;==== <TX label> · mm · <slug> ====  + next-line (print "--- [<label> · mm · …] ---"); mm = 01.. within each (begin-tx …) (see OuronetInformational/ARCHITECTURE/REPL_AND_TESTS.md).
;;   format "{}": Talos / module echoes and (env-gas) — document additional prefixes in this file's (print …) lines as needed.
;;
(print "")
(print "================================================================")
(print "FILE  REPL/Stage_01/[0.1]_Interfaces.repl")
(print "================================================================")
(print "Legend (terminal observability): see ;; preface; echoes use <(…)> where helpful.")
(print "Source: ;;|| NEXT > between txs; ;;==== … · mm · … ==== + banner before each begin-tx.")
(print "")
;;
;;
;;================================================================================
;;                                                                              ;;
;;                      [3 TXs — ALL THREE NOW LOAD NOTHING]                    ;;
;;                                                                              ;;
;;   This file is a VESTIGE and is kept only so the ~40 harnesses that load it   ;;
;;   keep working. It deploys no interface. All three Stage-01 registry files    ;;
;;   (01_Utilities / 02_Core / 03_Talos) declare ZERO interfaces: every one is   ;;
;;   co-located with its module and deploys with it, per StoicSyntax §7.10       ;;
;;   (2026-09-02). The banner here used to announce three LOADs and the tx       ;;
;;   bodies still print "load module" and a gas cost — theatre for work that no  ;;
;;   longer happens. Corrected 2026-09-17; see DEFECT-LEDGER §8.6.               ;;
;;                                                                              ;;
;;   Module-owned interfaces ship inside 2_Core/*.pact and 3_Talos/*.pact        ;;
;;   (one load per module tx in [2.2]_Core.repl / [3]_Talos.repl).              ;;
;;                                                                              ;;
;;================================================================================
;;
;;
(print "")
(begin-tx "TX-01 [0.01] - Deploy Stage One Utility Interfaces")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(namespace "ouronet-ns")
;;==== TX-01 [0.01] - Deploy Stage One Utility Interfaces · 01 · env-sigs (caps) ==== =============
(print "--- [TX-01 [0.01] - Deploy Stage One Utility Interfaces · 01 · env-sigs (caps)] ---")
;;==== TX-01 [0.01] - Deploy Stage One Utility Interfaces · 01 · env-sigs (caps) ==== =============
(print "--- [TX-01 [0.01] - Deploy Stage One Utility Interfaces · 01 · env-sigs (caps)] ---")
(env-sigs
  [{"key": "1a4e15d3c51e0b73e92644600487ba8eaae312e1a178b91801d54e13c1b350a5", "caps": []}])
;;==== TX-01 [0.01] - Deploy Stage One Utility Interfaces · 02 · load module (NONE — see header) ==== =================
(print "--- [TX-01 [0.01] - Deploy Stage One Utility Interfaces · 02 · load module (NONE — see header)] ---")
;;==== TX-01 [0.01] - Deploy Stage One Utility Interfaces · 03 · gas echo ==== ====================
(print "--- [TX-01 [0.01] - Deploy Stage One Utility Interfaces · 03 · gas echo] ---")
(print (format "<<<<<<<Stage One Utility Interfaces Costs {} GAS>>>>>>>" [(env-gas)]))
(print "")
(commit-tx)
;;||>>>>>>>>>>>>>>>>>>>>>>>>>
;;|| NEXT                   >
;;||>>>>>>>>>>>>>>>>>>>>>>>>>
(print "")
;;
;;
(print "")
