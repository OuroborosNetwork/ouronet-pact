(print "")
(begin-tx "TX-04 [C3.2] - Guard-type policy on Ouronet Account guard/governor slots")
(namespace "ouronet-ns")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
;;==== TX-04 [C3.2] - Guard-type policy · 01 · env-sigs (caps) ==== ===============================
(print "--- [TX-04 [C3.2] - Guard-type policy · 01 · env-sigs (caps)] ---")
(env-data
    {
        "KEY_TEST_SingleKey": { "keys": ["PK_Emma"], "pred": "keys-all" }
        ,"KEY_TEST_MultiKey": { "keys": ["PK_Emma", "PK_AncientHodler"], "pred": "keys-all" }
    }
)
;;==== TX-04 [C3.2] - Guard-type policy on Ouronet Account guard/governor slots · 01 · env-sigs (caps) ==== 
(print "--- [TX-04 [C3.2] - Guard-type policy on Ouronet Account guard/governor slots · 01 · env-sigs (caps)] ---")
(env-sigs
    [
        { "key": "PK_AncientHodler", "caps": [] }
    ]
)
;;==== TX-04 [C3.2] - Guard-type policy · 02 · NO master-key IMC registration ==== ================
(print "--- [TX-04 [C3.2] - Guard-type policy · 02 · NO master-key IMC registration] ---")
;;REMOVED 2026-09-14 -- this is the X-01 / RT-B-001 fix, and what it removes is a privilege the
;;HARNESS was granting itself. The line was:
;;
;;    (acquire-module-admin DALOS)
;;    (DALOS.P|A_AddIMP (keyset-ref-guard "ouronet-ns.dh_master-keyset"))
;;
;;`P|UEV_IMC` is `UEV_Any` over the registered inter-module policy guards, so registering the
;;MASTER KEYSET made any holder of that key satisfy a gate whose name says inter-MODULE. Every
;;core `C_` on DALOS became reachable from a signature, outside Talos, and therefore UNBILLED --
;;IGNIS is collected in Talos and that route never enters it.
;;
;;It appeared NOWHERE ELSE in the repository and is NOT part of genesis, so the deployed system
;;never had this exception: on chain, `DALOS::C_RotateStoa` is already Talos-only. The red team
;;reported it as a live hole in "Talos is the only supported client path"; that overstated it.
;;What it actually was is worse in a quieter way -- the harness was WEAKER than production, and
;;the weakness was load-bearing for five assertions that called core while being LABELLED with
;;the Talos entrypoint names. They now run against the entrypoints they always claimed, in
;;`[6.12]_DALOS-ADMIN.repl` `<<TX-DA-004>>`, where Talos exists and the billing leg is crossed.
;;
;;Owner ruling, 2026-09-14: "master key passes as module is correct. RotateStoa must pass through
;;talos, if it doesn't it's a bug." The MECHANISM is untouched -- `P|A_AddIMP` still exists and
;;every real module still registers through it at deploy. What is gone is the harness pretending
;;to be one.
;;
;;WHY THE FILE CANNOT SIMPLY CALL TALOS INSTEAD: this file runs before `3_Talos/` is deployed.
;;That is the whole reason the shortcut existed, and it is why the repair is a MOVE.
;;
;;`modules/CONFORMANCE.repl` <<CONF-01>> now asserts the REFUSAL, so the day this registration
;;comes back, a test says so.
;;==== TX-04 [C3.2] - Guard-type policy · 03 · helper unit expects ==== =============================
(print "--- [TX-04 [C3.2] - Guard-type policy · 03 · helper unit expects] ---")
;;==== TX-04 [C3.2] - Guard-type policy on Ouronet Account guard/governor slots · 02 · let / invocation ==== 
(print "--- [TX-04 [C3.2] - Guard-type policy on Ouronet Account guard/governor slots · 02 · let / invocation] ---")
(let
    (
        (ref-DALOS:module{OuronetDalosV2} DALOS)
        (key-ref:guard (keyset-ref-guard "ouronet-ns.dh_master-keyset"))
        (key-read:guard (read-keyset "KEY_TEST_SingleKey"))
        (user-g:guard (create-user-guard (DALOS.P|UEV_IMC)))
        (cap-g:guard (create-capability-guard (ref-DALOS::SECURE)))
    )
    (map print
        [
            (expect
                (format "<<TX-04 expect>> <(DALOS|UC_GuardProtocol keyset-ref)> got={} expected=r:" [(ref-DALOS::UC_GuardProtocol key-ref)])
                "r:"
                (ref-DALOS::UC_GuardProtocol key-ref))
            ;;This assertion used to compare (UC_GuardProtocol key-read) to ITSELF -- the only
            ;;positive assertion in the whole suite that could not fail (found by _vacuous.py).
            ;;Its doc said "expected=k: or w:", so the intent was "one of two values", which
            ;;`expect` cannot express directly; the self-comparison looks like an unfinished
            ;;placeholder. Measured, the answer is narrower than the doc guessed: a read-keyset
            ;;guard is ALWAYS w:, so the real expectation is exact.
            (expect
                (format "<<TX-04 expect>> <(DALOS|UC_GuardProtocol read-keyset)> got={} expected=w:" [(ref-DALOS::UC_GuardProtocol key-read)])
                "w:"
                (ref-DALOS::UC_GuardProtocol key-read))
            ;;...and the part a reader WILL assume wrongly. key-read above holds exactly ONE key
            ;;and still reads w:, NOT k: -- `k:` is the protocol for a bare single-key guard, while
            ;;anything from read-keyset is a keyset guard at any size. This is the multi-key half of
            ;;that pair: same answer, so the protocol does not vary with keyset size. Both halves
            ;;are needed -- the 1-key case alone looks like an accident, the 2-key case alone does
            ;;not rule out k: for size 1.
            (expect
                (format "<<TX-04 expect>> a MULTI-key keyset is w: too -- size does not change it" [])
                "w:"
                (ref-DALOS::UC_GuardProtocol (read-keyset "KEY_TEST_MultiKey")))
            (expect
                (format "<<TX-04 expect>> <(DALOS|UEV_EnforceGuardProtocol keyset-ref true)> must pass" [])
                true
                (ref-DALOS::UEV_EnforceGuardProtocol key-ref true))
            (expect
                (format "<<TX-04 expect>> <(DALOS|UEV_EnforceGuardProtocol read-keyset true)> must pass" [])
                true
                (ref-DALOS::UEV_EnforceGuardProtocol key-read true))
            (expect-failure
                (format "<<TX-04 expect-failure>> <(DALOS|UEV_EnforceGuardProtocol user-guard true)> must reject u:" [])
                "Guard must be key-based (keyset/keyset-ref); got 'u:"
                (ref-DALOS::UEV_EnforceGuardProtocol user-g true))
            (expect-failure
                (format "<<TX-04 expect-failure>> <(DALOS|UEV_EnforceGuardProtocol capability-guard true)> must reject c:" [])
                "Guard must be key-based (keyset/keyset-ref); got 'c:"
                (ref-DALOS::UEV_EnforceGuardProtocol cap-g true))
            (expect
                (format "<<TX-04 expect>> <(DALOS|UEV_EnforceGuardProtocol capability-guard false)> must pass" [])
                true
                (ref-DALOS::UEV_EnforceGuardProtocol cap-g false))
            (expect
                (format "<<TX-04 expect>> <(DALOS|UEV_EnforceGuardProtocol user-guard false)> must pass" [])
                true
                (ref-DALOS::UEV_EnforceGuardProtocol user-g false))
            (expect-failure
                (format "<<TX-04 expect-failure>> <(DALOS|UEV_EnforceGuardProtocol keyset-ref false)> must reject r:" [])
                "Governor must be non-key-based (user/capability/module/pact); got 'r:"
                (ref-DALOS::UEV_EnforceGuardProtocol key-ref false))
            (expect-failure
                (format "<<TX-04 expect-failure>> <(DALOS|UEV_EnforceGuardProtocol read-keyset false)> must reject k:/w:" [])
                "Governor must be non-key-based (user/capability/module/pact); got 'w:"
                (ref-DALOS::UEV_EnforceGuardProtocol key-read false))
        ]
    )
    ""
)
;;==== TX-04 [C3.2] - Guard-type policy · 04 · C_RotateGovernor e2e (smart BJ) ==== ===============
(print "--- [TX-04 [C3.2] - Guard-type policy · 04 · C_RotateGovernor e2e (smart BJ)] ---")
(env-sigs
    [
        { "key": "PK_AncientHodler", "caps": [] }
        { "key": "PK_BM", "caps": [] }
    ]
)
;;THE FIVE ASSERTIONS THAT USED TO SIT HERE NOW LIVE IN `[6.12]_DALOS-ADMIN.repl` <<TX-DA-004>>.
;;
;;They called `ref-DALOS::C_RotateGovernor` and `ref-DALOS::C_RotateGuard` -- the CORE functions --
;;while being labelled `<(DALOS|C_RotateGovernor ...)>` and `<(DALOS|C_RotateGuard ...)>`, which are
;;the TALOS entrypoint names. The gap between the label and the call was invisible for as long as
;;the master-key IMC registration above made the core path reachable from a signature.
;;
;;Removing that registration made all five fail with
;;`No value found in table ouronet-ns.DALOS_P|MT for key: InterModulePolicies` -- and they were the
;;ONLY five failures in the entire 86-entrypoint gate, which is what established that nothing
;;downstream depended on the state they set. Measured before moving anything.
;;
;;They are better off where they went: [6.12] runs after `3_Talos/`, so they now exercise the
;;entrypoints their names always claimed AND cross the IGNIS billing leg, which the core-direct
;;form never touched.
(env-sigs [])
(env-gas)
(commit-tx)