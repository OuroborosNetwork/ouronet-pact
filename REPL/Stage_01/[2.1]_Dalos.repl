    (define-keyset "ouronet-ns.dh_sc_stoaliquidstaking-keyset" (read-keyset "KEY_SC_StoaLiquidStaking"))
    (define-keyset "ouronet-ns.dh_sc_ouroboros-keyset" (read-keyset "KEY_SC_Ouroboros"))
    (define-keyset "ouronet-ns.dh_sc_swapper-keyset" (read-keyset "KEY_SC_DalosSwapper"))
    (define-keyset "ouronet-ns.dh_sc_dhvault-keyset" (read-keyset "KEY_SC_DHVault"))
    (define-keyset "ouronet-ns.codex-keyset" (read-keyset "DemiourgosSithMasters"))
    (define-keyset "ouronet-ns.pythia-cronoton-keyset" (read-keyset "DemiourgosSithMasters"))

    ;;Create Autostake and Vesting STOA Accounts (for use in Repl)
