(begin-tx "TX-03 [C3.1] - Deploy Ouronet Accounts for Testing Purposes")
(namespace "ouronet-ns")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
;;==== TX-03 [C3.1] - Deploy Ouronet Accounts for Testing Purposes · 01 · env-sigs (caps) ==== ====
(print "--- [TX-03 [C3.1] - Deploy Ouronet Accounts for Testing Purposes · 01 · env-sigs (caps)] ---")
(env-sigs 
    [ 
        { "key": "PK_AncientHodler", "caps": [] }
        ;;
        { "key": "PK_Emma", "caps": [] }
        { "key": "PK_Lumy", "caps": [] }
        { "key": "PK_Coca", "caps": [] }
        { "key": "PK_Kiss", "caps": [] }
        { "key": "PK_Plcs", "caps": [] }
        { "key": "PK_Nani", "caps": [] }
        { "key": "PK_AOZ", "caps": [] }
        ;;
        { "key": "PK_BM", "caps": [] }
        { "key": "PK_BJ", "caps": [] }
    ]
)

    ;;
    [
        (DALOS.A_DeployStandardAccount KC.EMMA (keyset-ref-guard "ouronet-ns.us-0001_emma-keyset") KC.KADN_NAME_000b KC.PBLC_000b)
        (DALOS.A_DeployStandardAccount KC.LUMY (keyset-ref-guard "ouronet-ns.us-0002_lumy-keyset") KC.KADN_NAME_000d KC.PBLC_000d)
        (DALOS.A_DeployStandardAccount KC.COCA (keyset-ref-guard "ouronet-ns.us-0003_coca-keyset") KC.KADN_NAME_000e KC.PBLC_000e)
        (DALOS.A_DeployStandardAccount KC.KISS (keyset-ref-guard "ouronet-ns.us-0004_kiss-keyset") KC.KADN_NAME_000f KC.PBLC_000f)
        (DALOS.A_DeployStandardAccount KC.PULECS (keyset-ref-guard "ouronet-ns.us-0005_plcs-keyset") KC.KADN_NAME_000g KC.PBLC_000g)
        (DALOS.A_DeployStandardAccount KC.NANI (keyset-ref-guard "ouronet-ns.us-0006_nani-keyset") KC.KADN_NAME_000h KC.PBLC_000h)
        (DALOS.A_DeployStandardAccount KC.AOZ (keyset-ref-guard "ouronet-ns.us-0000_aozt-keyset") KC.KADN_NAME_000i KC.PBLC_000i)
        ;;
        ;;Banana Example
        (DALOS.A_DeployStandardAccount KC.BM (keyset-ref-guard "ouronet-ns.us-0007_bnms-keyset") KC.KADN_NAME_000j KC.PBLC_000j)
        (DALOS.A_DeploySmartAccount KC.BJ (keyset-ref-guard "ouronet-ns.us-0008_bnjr-keyset") KC.KADN_NAME_0006 KC.BM KC.PBLC_0006)
    ]

(env-sigs [])
(env-gas)
