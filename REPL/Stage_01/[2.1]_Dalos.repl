(print "")
(begin-tx "TX-01 [1.1] - Define Keys Used in the DALOS Module")
(namespace "ouronet-ns")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
;;==== TX-01 [1.1] - Define Keys Used in the DALOS Module · 01 · env-sigs (caps) ==== =============
(print "--- [TX-01 [1.1] - Define Keys Used in the DALOS Module · 01 · env-sigs (caps)] ---")
(env-sigs
  [{"key": "1a4e15d3c51e0b73e92644600487ba8eaae312e1a178b91801d54e13c1b350a5", "caps": []}])

    (env-data
        {
            ;;DEMI-MASTER-KEYS
            "DemiourgosSithMasters": { "keys": [KC.DPTS_PBKY_0000, KC.DPTS_PBKY_000a], "pred": "keys-any" },
            "KEY_SC_GasTanker": { "keys": [KC.DPTS_PBKY_0000, KC.DPTS_PBKY_0002], "pred": "keys-any" },
            "KEY_SC_DalosAutostake": { "keys": [KC.DPTS_PBKY_0004]},
            "KEY_SC_DalosVesting": { "keys": [KC.DPTS_PBKY_0005]},
            "KEY_SC_StoaLiquidStaking": { "keys": [KC.DPTS_PBKY_0000, KC.DPTS_PBKY_0003], "pred": "keys-any" },
            "KEY_SC_Ouroboros": { "keys": [KC.DPTS_PBKY_0000, KC.DPTS_PBKY_0001], "pred": "keys-any" },
            "KEY_SC_DalosSwapper": { "keys": [KC.DPTS_PBKY_0000]},
            "KEY_SC_DHVault": { "keys": [KC.DPTS_PBKY_0007]},

            "KEY_STOA_DalosAutostake": { "keys": [KC.KADN_PBKY_0004]},
            "KEY_STOA_DalosVesting": { "keys": [KC.KADN_PBKY_0005]}
        }
    )

    ;;DALOS Defined Keysets ==> For Repl Using Named Keys, ex PK_AncientHodler
    (define-keyset "ouronet-ns.dh_master-keyset" (read-keyset "DemiourgosSithMasters"))
    (define-keyset "ouronet-ns.dh_sc_dalos-keyset" (read-keyset "KEY_SC_GasTanker"))
    (define-keyset "ouronet-ns.dh_sc_autostake-keyset" (read-keyset "KEY_SC_DalosAutostake"))
    (define-keyset "ouronet-ns.dh_sc_vesting-keyset" (read-keyset "KEY_SC_DalosVesting"))
    (define-keyset "ouronet-ns.dh_sc_stoaliquidstaking-keyset" (read-keyset "KEY_SC_StoaLiquidStaking"))
    (define-keyset "ouronet-ns.dh_sc_ouroboros-keyset" (read-keyset "KEY_SC_Ouroboros"))
    (define-keyset "ouronet-ns.dh_sc_swapper-keyset" (read-keyset "KEY_SC_DalosSwapper"))
    (define-keyset "ouronet-ns.dh_sc_dhvault-keyset" (read-keyset "KEY_SC_DHVault"))
    (define-keyset "ouronet-ns.codex-keyset" (read-keyset "DemiourgosSithMasters"))
    (define-keyset "ouronet-ns.pythia-cronoton-keyset" (read-keyset "DemiourgosSithMasters"))

    ;;Create Autostake and Vesting STOA Accounts (for use in Repl)
;;==== TX-01 [1.1] - Define Keys Used in the DALOS Module · 02 · let / invocation ==== ============
(print "--- [TX-01 [1.1] - Define Keys Used in the DALOS Module · 02 · let / invocation] ---")
    (let
        (
            (ref-coin:module{stoa-ns.fungible-v1} coin)

        )
        (ref-coin::create-account KC.KADN_NAME_0004 (read-keyset "KEY_STOA_DalosAutostake"))
        (ref-coin::create-account KC.KADN_NAME_0005 (read-keyset "KEY_STOA_DalosVesting"))
    )

(env-gas)
(commit-tx)
(print "")
;;||>>>>>>>>>>>>>>>>>>>>>>>>>
;;|| NEXT                   >
;;||>>>>>>>>>>>>>>>>>>>>>>>>>
(print "")
(begin-tx "TX-02 [1.2] - Stoa Account Creation and Fuel of 1st Account")
(namespace "ouronet-ns")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)

;;==== TX-02 [1.2] - Stoa Account Creation and Fuel of 1st Account · 01 · env-sigs (caps) ==== ==
