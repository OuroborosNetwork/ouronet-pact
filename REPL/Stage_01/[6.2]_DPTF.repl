(env-sigs 
    [   
        { "key": "PK_AOZ", "caps": [] }
    ]
)
(print "=============================================BEGIN DPTF TESTS==========================================")
;;==== REPL_Test_000x - TX03 - Accounts Display · 02 · let / invocation ==== ======================
(print "--- [REPL_Test_000x - TX03 - Accounts Display · 02 · let / invocation] ---")
(let
    (
        (ref-DALOS:module{OuronetDalosV1} DALOS)
        (ouroboros:string (ref-DALOS::GOV|OUROBOROS|SC_NAME))
        (dalos:string (ref-DALOS::GOV|DALOS|SC_NAME))
        (liquid:string (ref-DALOS::GOV|LIQUID|SC_NAME))
    )
    [
        (format "ANHD Stoa is {}" [(ref-DALOS::UR_AccountStoa KST.ANHD)])
        (format "CTO is {}" [(ref-DALOS::UR_AccountStoa (at 0 (ref-DALOS::UR_DemiurgoiID)))])
        (format "HOV is {}" [(ref-DALOS::UR_AccountStoa (at 1 (ref-DALOS::UR_DemiurgoiID)))])
        (format "OUROBOROS is {}" [(ref-DALOS::UR_AccountStoa ouroboros)])
        (format "DALOS is {}" [(ref-DALOS::UR_AccountStoa dalos)])
        (format "LIQUID is {}" [(ref-DALOS::UR_AccountStoa liquid)])
    ]
)

(env-gas)
(commit-tx)
;;||>>>>>>>>>>>>>>>>>>>>>>>>>
;;|| NEXT                   >
