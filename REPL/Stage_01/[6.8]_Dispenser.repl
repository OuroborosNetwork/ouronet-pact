;;
;; REPL/Stage_01/[6.8]_Dispenser.repl — canonical integration layout (OuronetInformational/ARCHITECTURE/REPL_AND_TESTS.md)
;;   Inter-tx:   ;;|| NEXT >  (same three lines as REPL/Stage_01/[2.2]_Core.repl)
;;   Intra-tx:   ;;==== <TX label> · mm · <slug> ====  + next-line (print "--- [<label> · mm · …] ---"); mm = 01.. within each (begin-tx …) (see OuronetInformational/ARCHITECTURE/REPL_AND_TESTS.md).
;;   format "{}": Talos / module echoes and (env-gas) — document additional prefixes in this file's (print …) lines as needed.
;;
(print "")
(print "================================================================")
(print "FILE  REPL/Stage_01/[6.8]_Dispenser.repl")
(print "================================================================")
(print "Legend (terminal observability): see ;; preface; echoes use <(…)> where helpful.")
(print "Source: ;;|| NEXT > between txs; ;;==== … · mm · … ==== + banner before each begin-tx.")
(print "")
(print "")
(print "===================Last Dispenser Tests============================")
(begin-tx "INIT TX 000 - Chain Data Time SetUp Definition")
(namespace "ouronet-ns")
;;==== INIT TX 000 - Chain Data Time SetUp Definition · 01 · env-chain-data ==== ==================
(print "--- [INIT TX 000 - Chain Data Time SetUp Definition · 01 · env-chain-data] ---")
(env-chain-data
    {"prev-block-hash": "98c486052a5147fdd30fa43cc6d67e0a4e680c856c37f9157cb788cd67d58006",
     "block-time": TV.TIME00}
)
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(env-gas)
(commit-tx)
;;||>>>>>>>>>>>>>>>>>>>>>>>>>
;;|| NEXT                   >
;;||>>>>>>>>>>>>>>>>>>>>>>>>>
(print "")
;;||>>>>>>>>>>>>>>>>>>>>>>>>>
;;|| NEXT                   >
;;||>>>>>>>>>>>>>>>>>>>>>>>>>
(print "")
(begin-tx "Manual Ouro Price Update")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
;;==== Manual Ouro Price Update · 01 · env-sigs (caps) ==== =======================================
(print "--- [Manual Ouro Price Update · 01 · env-sigs (caps)] ---")
(env-sigs 
    [   
        { "key": "PK_AOZ", "caps": [] }
        { "key": "PK_AncientHodler", "caps": [] }
        ;{ "key": "PK_DHV", "caps": [] }
        ;{ "key": "PK_CST", "caps": [] }
        { "key": "PK_DSP", "caps": [] }
    ]
)
(namespace "ouronet-ns")
;;==== Manual Ouro Price Update · 02 · let / invocation ==== ======================================
(print "--- [Manual Ouro Price Update · 02 · let / invocation] ---")
(let
    (
        (ref-DSP:module{Dispenser} DSP)
        (ref-DALOS:module{OuronetDalosV1} DALOS)
        (ref-DPTF:module{DemiourgosPactTrueFungibleV1} DPTF)
        (ref-ATS:module{AutostakeV2} ATS)
        (ouro:string (ref-DALOS::UR_OuroborosID))
        (os:decimal (ref-DPTF::UR_Supply ouro))

        (treasury:string (ref-DALOS::GOV|DHV1|SC_NAME))
        (validators:string (ref-DSP::GOV|CST1|SC_NAME))
        (dispenser:string (ref-DSP::GOV|DSP1|SC_NAME))

        (auryn:string (ref-DALOS::UR_AurynID))
        (elite-auryn:string (ref-DALOS::UR_EliteAurynID))
        (auryndex:string (at 0 (ref-DPTF::UR_RewardBearingToken auryn)))
        (elite-auryndex:string (at 0 (ref-DPTF::UR_RewardBearingToken elite-auryn)))
    )
    ;(ref-DSP::A_ManualOuroPriceUpdate)
    ;(ref-DSP::A_OuroMinterStageOne)
    [
        (format "Minting Ouro Daily is {}" [(ref-DSP::A_OuroMinterStageOne)])
        (format "Ouro Price is {}" [(ref-DALOS::UR_OuroborosPrice)])
        (format "Ouro Supply is {}" [os])
        (format "OURO on Treasury is {}" [(ref-DPTF::UR_AccountSupply ouro treasury)])
        (format "OURO on Validators is {}" [(ref-DPTF::UR_AccountSupply ouro validators)])
        (format "OURO on Dispenser is {}" [(ref-DPTF::UR_AccountSupply ouro dispenser)])

        (format "Auryndex is {}" [(ref-ATS::URC_Index auryndex)])
        (format "Elite-Auryndex is {}" [(ref-ATS::URC_Index elite-auryndex)])

    ]
    
)

(print "")
(print "")
;;==== Manual Ouro Price Update · 03 · gas echo ==== ==============================================
(print "--- [Manual Ouro Price Update · 03 · gas echo] ---")
(format "<<<<<<<Manual Ouro Price Update Costs {} GAS>>>>>>>" [(env-gas)])
(print "")
(print "")
(print "===^^^===")
(commit-tx)
