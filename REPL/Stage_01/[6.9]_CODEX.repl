(begin-tx "TX001 - CODEX|A_RegisterCodexIdentity + UR_CIX reads")
(namespace "ouronet-ns")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(print "")
(print "=== TX001 — A_RegisterCodexIdentity =====================================")
;;==== TX001 · 01 · env-sigs (codex-keyset / Demiourgos) ====
(print "--- [TX001 · 01 · env-sigs (codex-keyset / Demiourgos)] ---")
;;==== TX001 - CODEX|A_RegisterCodexIdentity + UR_CIX reads · 01 · env-sigs (caps) ==== ===========
(print "--- [TX001 - CODEX|A_RegisterCodexIdentity + UR_CIX reads · 01 · env-sigs (caps)] ---")
(env-sigs
    [
        { "key": "PK_AncientHodler", "caps": [] }
    ]
)
;;==== TX001 - CODEX|A_RegisterCodexIdentity + UR_CIX reads · 02 · let / invocation ==== ==========
(print "--- [TX001 - CODEX|A_RegisterCodexIdentity + UR_CIX reads · 02 · let / invocation] ---")
(let
    (
        (composite-id:string (read-string "CODEX|COMPOSITE-ID"))
        (public-standard:string (read-string "CODEX|PUBLIC-STANDARD"))
        (public-smart:string (read-string "CODEX|PUBLIC-SMART"))
        (registered-by:string (read-string "CODEX|REGISTERED-BY"))
        (codex-guard:guard (read-keyset "KEY_CODEX_GUARD"))
        (ref-TS01-C4:module{TalosStageOne_ClientFourV8} TS01-C4)
        (ref-CODEX:module{CodexV2} CODEX)
        (reg-msg:string
            (ref-TS01-C4::CODEX|A_RegisterCodexIdentity
                composite-id
                public-standard
                public-smart
                codex-guard
                registered-by
            )
        )
    )
    ;;==== TX001 · 02 · Talos A_Register ====
    (print "--- [TX001 · 02 · Talos A_Register] ---")
    (print (format "<(TS01-C4.CODEX|A_RegisterCodexIdentity)> => \"{}\"" [reg-msg]))
    ;;==== TX001 · 03 · UR_CIX reads + expects ====
    (print "--- [TX001 · 03 · UR_CIX reads + expects] ---")
    (map print
        [
            (format "<(CODEX|UR_CIX|CodexId)> => \"{}\"" [(ref-CODEX::UR_CIX|CodexId composite-id)])
            (format "<(CODEX|UR_CIX|PublicStandard)> => \"{}\"" [(ref-CODEX::UR_CIX|PublicStandard composite-id)])
            (format "<(CODEX|UR_CIX|PublicSmart)> => \"{}\"" [(ref-CODEX::UR_CIX|PublicSmart composite-id)])
            (format "<(CODEX|UR_CIX|RegisteredBy)> => \"{}\"" [(ref-CODEX::UR_CIX|RegisteredBy composite-id)])
            (expect
                (format "<<TX001>> UR_CIX|CodexId matches composite-id \"{}\"" [composite-id])
                composite-id
                (ref-CODEX::UR_CIX|CodexId composite-id)
            )
            (expect
                (format "<<TX001>> UR_CIX|RegisteredBy \"{}\"" [registered-by])
                registered-by
                (ref-CODEX::UR_CIX|RegisteredBy composite-id)
            )
            (expect
                "<<TX001>> UR_CIX|DataOrNull is-registered true"
                true
                (at "is-registered" (ref-CODEX::UR_CIX|DataOrNull composite-id))
            )
        ]
    )
    ""
)
(print (format "<(REPL|env-gas)> TX001 => \"{}\"" [(env-gas)]))
(commit-tx)
(print "")
;;||>>>>>>>>>>>>>>>>>>>>>>>>>
;;|| NEXT                   >
;;||>>>>>>>>>>>>>>>>>>>>>>>>>
(print "")
(begin-tx "TX002 - CODEX|C_RotateCodexGuard")
(namespace "ouronet-ns")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(print "")
(print "=== TX002 — C_RotateCodexGuard =========================================")
;;==== TX002 · 01 · env-sigs (current + new codex guard) ====
(print "--- [TX002 · 01 · env-sigs (current + new codex guard)] ---")
;;==== TX002 - CODEX|C_RotateCodexGuard · 01 · env-sigs (caps) ==== ===============================
(print "--- [TX002 - CODEX|C_RotateCodexGuard · 01 · env-sigs (caps)] ---")
(env-sigs
    [
        { "key": "PK_AncientHodler", "caps": [] }
        { "key": "PK_Florean", "caps": [] }
    ]
)
;;==== TX002 - CODEX|C_RotateCodexGuard · 02 · let / invocation ==== ==============================
(print "--- [TX002 - CODEX|C_RotateCodexGuard · 02 · let / invocation] ---")
(let
    (
        (composite-id:string (read-string "CODEX|COMPOSITE-ID"))
        (new-codex-guard:guard (read-keyset "KEY_CODEX_GUARD_NEW"))
        (ref-TS01-C4:module{TalosStageOne_ClientFourV8} TS01-C4)
        (ref-CODEX:module{CodexV2} CODEX)
        ;;FUNCTION COVERAGE (G6) — `INFO_CODEX|RotateCodexGuard`, per the owner's spec: an INFO_ must
        ;;report the same cost the op actually charges. Template: `modules/ATS.repl <<ATS-I1>>`.
        ;;These bindings rely on `let` being EAGER and ORDERED: the quote and the pre-op balance are
        ;;both taken BEFORE `rot-msg` runs the rotation.
        (predicted:object{OuronetInfoV2.ClientInfo}
            (CODEX.INFO_CODEX|RotateCodexGuard KST.ANHD composite-id))
        (ignis-before:decimal (DALOS.UR_TF_AccountSupply KST.ANHD false))
        (rot-msg:string
            (ref-TS01-C4::CODEX|C_RotateCodexGuard KST.ANHD composite-id new-codex-guard)
        )
    )
    (map print
        [
            (expect "<<TX002-INFO>> the preview's IGNIS quote equals what the guard rotation charged"
                (- ignis-before (DALOS.UR_TF_AccountSupply KST.ANHD false))
                (at "ignis-need" (at "ignis" predicted)))
            (expect "<<TX002-INFO>> ...and rotating a Codex guard is NOT free"
                true (> (- ignis-before (DALOS.UR_TF_AccountSupply KST.ANHD false)) 0.0))
        ]
    )
    ;;==== TX002 · 02 · Talos C_Rotate ====
    (print "--- [TX002 · 02 · Talos C_Rotate] ---")
    (print (format "<(TS01-C4.CODEX|C_RotateCodexGuard)> => \"{}\"" [rot-msg]))
    ;;==== TX002 · 03 · UR guard expect ====
    (print "--- [TX002 · 03 · UR guard expect] ---")
    (map print
        [
            (format "<(CODEX|UR_CIX|CodexGuard)> => \"{}\"" [(ref-CODEX::UR_CIX|CodexGuard composite-id)])
            (expect
                "<<TX002>> codex-guard rotated to KEY_CODEX_GUARD_NEW"
                new-codex-guard
                (ref-CODEX::UR_CIX|CodexGuard composite-id)
            )
        ]
    )
    ""
)
(print (format "<(REPL|env-gas)> TX002 => \"{}\"" [(env-gas)]))
(commit-tx)
(print "")
;;||>>>>>>>>>>>>>>>>>>>>>>>>>
;;|| NEXT                   >
;;||>>>>>>>>>>>>>>>>>>>>>>>>>
(print "")
(begin-tx "TX003 - CODEX|C_RecordArweaveUpload")
(namespace "ouronet-ns")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(print "")
(print "=== TX003 — C_RecordArweaveUpload =======================================")
;;==== TX003 · 01 · env-sigs (rotated codex guard = Florian + IGNIS patron) ====
(print "--- [TX003 · 01 · env-sigs (rotated codex guard + patron)] ---")
;;the patron key is required now that CODEX|C_RecordArweaveUpload collects IGNIS
;;(deter(usage) + components) — before the pricing rehaul this op was gasless.
;;==== TX003 - CODEX|C_RecordArweaveUpload · 01 · env-sigs (caps) ==== ============================
(print "--- [TX003 - CODEX|C_RecordArweaveUpload · 01 · env-sigs (caps)] ---")
(env-sigs
    [
        { "key": "PK_AncientHodler", "caps": [] }
        { "key": "PK_Florean", "caps": [] }
    ]
)
;;==== TX003 - CODEX|C_RecordArweaveUpload · 02 · let / invocation ==== ===========================
(print "--- [TX003 - CODEX|C_RecordArweaveUpload · 02 · let / invocation] ---")
(let
    (
        (composite-id:string (read-string "CODEX|COMPOSITE-ID"))
        (arweave-tx-id:string (read-string "CODEX|ARWEAVE-TX-ID"))
        (uploaded-bytes:integer 1024)
        (ref-TS01-C4:module{TalosStageOne_ClientFourV8} TS01-C4)
        (ref-CODEX:module{CodexV2} CODEX)
        (arw-msg:string
            (ref-TS01-C4::CODEX|C_RecordArweaveUpload KST.ANHD composite-id arweave-tx-id uploaded-bytes)
        )
    )
    ;;==== TX003 · 02 · Talos C_RecordArweave ====
    (print "--- [TX003 · 02 · Talos C_RecordArweave] ---")
    (print (format "<(TS01-C4.CODEX|C_RecordArweaveUpload)> => \"{}\"" [arw-msg]))
    ;;==== TX003 · 03 · UR_AWT reads + expects ====
    (print "--- [TX003 · 03 · UR_AWT reads + expects] ---")
    (map print
        [
            (format "<(CODEX|UR_AWT|ArweaveTxId)> => \"{}\"" [(ref-CODEX::UR_AWT|ArweaveTxId composite-id arweave-tx-id)])
            (format "<(CODEX|UR_AWT|UploadedBytes)> => \"{}\"" [(ref-CODEX::UR_AWT|UploadedBytes composite-id arweave-tx-id)])
            (expect
                (format "<<TX003>> UR_AWT|ArweaveTxId \"{}\"" [arweave-tx-id])
                arweave-tx-id
                (ref-CODEX::UR_AWT|ArweaveTxId composite-id arweave-tx-id)
            )
            ;;`21_CODEX.pact:379`, the upload-shape rule, driven on BOTH of its conjuncts. The
            ;;accepted call three lines up is the contrast, and it matters here more than usual: the
            ;;guard sits BELOW `(compose-capability (CODEX|OWNER codex-id))`, so a registered codex
            ;;AND the current guard's signature are hard preconditions. Anything short of that dies
            ;;on a row read or a keyset failure and never reaches this message.
            ;;This transaction already holds both -- TX001 registered the identity and TX002 rotated
            ;;its guard to PK_Florean, which is signed above -- so the only thing varying below is
            ;;the argument under test.
            (expect-failure "<<TX003>> a tx-id of the wrong LENGTH is refused"
                "Invalid arweave upload: bad tx-id format or non-positive uploaded-bytes"
                (ref-TS01-C4::CODEX|C_RecordArweaveUpload KST.ANHD composite-id "tooshort" 1024))
            ;;...a 43-character id with a character outside the base64url alphabet -- same length,
            ;;wrong charset. Driving this as well as the length case is what shows
            ;;UC_ValidateArweaveTxId checks both, not just the easy one.
            (expect-failure "<<TX003>> ...and so is a right-length id with a non-base64url character"
                "Invalid arweave upload: bad tx-id format or non-positive uploaded-bytes"
                (ref-TS01-C4::CODEX|C_RecordArweaveUpload KST.ANHD composite-id
                    "+aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa" 1024))
            ;;...and the OTHER conjunct: a valid id with nothing uploaded.
            (expect-failure "<<TX003>> ...and so is a valid tx-id with zero uploaded bytes"
                "Invalid arweave upload: bad tx-id format or non-positive uploaded-bytes"
                (ref-TS01-C4::CODEX|C_RecordArweaveUpload KST.ANHD composite-id arweave-tx-id 0))
            (expect
                "<<TX003>> UR_AWT|UploadedBytes 1024"
                1024
                (ref-CODEX::UR_AWT|UploadedBytes composite-id arweave-tx-id)
            )
        ]
    )
    ""
)
(print (format "<(REPL|env-gas)> TX003 => \"{}\"" [(env-gas)]))
(commit-tx)
(print "")
;;||>>>>>>>>>>>>>>>>>>>>>>>>>
;;|| NEXT                   >
;;||>>>>>>>>>>>>>>>>>>>>>>>>>
(print "")
(begin-tx "TX004 - CODEX|C_RegisterStoicTag")
(namespace "ouronet-ns")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(print "")
(print "=== TX004 — C_RegisterStoicTag ==========================================")
;;==== TX004 - CODEX|C_RegisterStoicTag · 01 · let / invocation ==== ==============================
(print "--- [TX004 - CODEX|C_RegisterStoicTag · 01 · let / invocation] ---")
(let
    (
        (patron:string KST.ANHD)
        (tag-name:string (read-string "CODEX|STOICTAG-NAME"))
        (account-raw:string (read-string "CODEX|STOICTAG-ACCOUNT"))
        (account-address:string
            (if (= account-raw "")
                KST.ANHD
                account-raw
            )
        )
        (ref-DALOS:module{OuronetDalosV2} DALOS)
        (ref-TS01-C4:module{TalosStageOne_ClientFourV8} TS01-C4)
        (ref-CODEX:module{CodexV2} CODEX)
        (stoa-fee:decimal (ref-CODEX::UC_StoicTagStoaFee tag-name))
        (patron-stoa:string (ref-DALOS::UR_AccountStoa patron))
        (demiurgoi:[string] (ref-DALOS::UR_DemiurgoiID))
        (stoa-hov:string (ref-DALOS::UR_AccountStoa (at 2 demiurgoi)))
        (stoa-cto:string (ref-DALOS::UR_AccountStoa (at 1 demiurgoi)))
        (stoa-ouroboros:string (ref-DALOS::UR_AccountStoa (ref-DALOS::GOV|OUROBOROS|SC_NAME)))
        (stoa-dalos:string (ref-DALOS::UR_AccountStoa (ref-DALOS::GOV|DALOS|SC_NAME)))
        (split-stoa:[decimal] (ref-DALOS::URC_SplitSTOAPrices account-address stoa-fee))
    )
    ;;==== TX004 · 01 · STOA fee echo ====
    (print "--- [TX004 · 01 · STOA fee (1 per glyph, 10/20/30/40 split)] ---")
    (print (format "<(CODEX|UC_StoicTagStoaFee)> tag len {} => \"{}\" STOA" [(length tag-name) stoa-fee]))
    (print (format "<(DALOS|URC_SplitSTOAPrices)> => \"{}\"" [split-stoa]))
    ;;==== TX004 · 02 · env-sigs (DALOS owner + four STOA transfers) ====
    (print "--- [TX004 · 02 · env-sigs (DALOS owner + STOA 10/20/30/40)] ---")
    (env-sigs
        [
            { "key": "PK_AncientHodler", "caps": [] }
            { "key": "6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263",
              "caps":
                [
                    (coin.TRANSFER patron-stoa stoa-cto (at 2 split-stoa))
                    (coin.TRANSFER patron-stoa stoa-hov (at 0 split-stoa))
                    (coin.TRANSFER patron-stoa stoa-ouroboros (at 3 split-stoa))
                    (coin.TRANSFER patron-stoa stoa-dalos (at 1 split-stoa))
                ]
            }
        ]
    )
    (let
        (
            ;;FUNCTION COVERAGE (G6) — `INFO_CODEX|RegisterStoicTag`, per the owner's spec.
            ;;Template: `modules/ATS.repl <<ATS-I1>>`. This is the STOA member of the CODEX family
            ;;(1 STOA per glyph via `XB_CollectStoaDiscountedFrom`, with the Elite discount taken from
            ;;`account-address` rather than from the patron) — so the quote must track BOTH a
            ;;length-dependent price AND a discount read off a different account than the payer.
            ;;The managed coin.TRANSFER caps installed just above are what let the charge land.
            (predicted:object{OuronetInfoV2.ClientInfo}
                (CODEX.INFO_CODEX|RegisterStoicTag patron tag-name account-address))
            (stoa-before:decimal (coin.get-balance patron-stoa))
            (stg-msg:string
                (ref-TS01-C4::CODEX|C_RegisterStoicTag patron tag-name account-address)
            )
        )
        (map print
            [
                (format "<<TX004-INFO>> STOA predicted={} real={}"
                    [(at "stoa-need" (at "stoa" predicted)) (- stoa-before (coin.get-balance patron-stoa))])
                (expect "<<TX004-INFO>> the preview's STOA quote equals what registering the tag charged"
                    (- stoa-before (coin.get-balance patron-stoa)) (at "stoa-need" (at "stoa" predicted)))
                (expect "<<TX004-INFO>> ...and registering a StoicTag is NOT free"
                    true (> (- stoa-before (coin.get-balance patron-stoa)) 0.0))
            ]
        )
        ;;==== TX004 · 03 · Talos C_RegisterStoicTag ====
        (print "--- [TX004 · 03 · Talos C_RegisterStoicTag] ---")
        (print (format "<(TS01-C4.CODEX|C_RegisterStoicTag)> patron={} tag={} account={} => \"{}\""
            [patron tag-name account-address stg-msg]))
        ;;==== TX004 · 04 · UR_STG / UR_STBA expects (virgin insert — both tables) ====
        (print "--- [TX004 · 04 · UR_STG / UR_STBA expects (virgin insert)] ---")
        (map print
            [
                (format "<(CODEX|UR_STG|AccountAddress)> => \"{}\"" [(ref-CODEX::UR_STG|AccountAddress tag-name)])
                (format "<(CODEX|UR_STG|IzActive)> => \"{}\"" [(ref-CODEX::UR_STG|IzActive tag-name)])
                (expect
                    (format "<<TX004>> UR_STG|AccountAddress \"{}\"" [account-address])
                    account-address
                    (ref-CODEX::UR_STG|AccountAddress tag-name)
                )
                (expect
                    "<<TX004>> UR_STG|IzActive true"
                    true
                    (ref-CODEX::UR_STG|IzActive tag-name)
                )
                (expect
                    "<<TX004>> UR_STBA|TagName matches (bijection tag→account)"
                    tag-name
                    (ref-CODEX::UR_STBA|TagName account-address)
                )
                (expect
                    "<<TX004>> UR_STG|DataOrNull is-registered true (virgin)"
                    true
                    (at "is-registered" (ref-CODEX::UR_STG|DataOrNull tag-name))
                )
                (expect
                    "<<TX004>> UR_STBA|DataOrNull has-stoictag true (virgin bijection)"
                    true
                    (at "has-stoictag" (ref-CODEX::UR_STBA|DataOrNull account-address))
                )
            ]
        )
        ""
    )
)
(print (format "<(REPL|env-gas)> TX004 => \"{}\"" [(env-gas)]))
(commit-tx)
(print "")
