;;|| NEXT                   >
;;||>>>>>>>>>>>>>>>>>>>>>>>>>
(print "")
(begin-tx "TX005 - CODEX|C_ReleaseStoicTag")
(namespace "ouronet-ns")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(print "")
(print "=== TX005 — C_ReleaseStoicTag ===========================================")
;;==== TX005 · 01 · env-sigs (DALOS account owner) ====
(print "--- [TX005 · 01 · env-sigs (DALOS account owner)] ---")
;;==== TX005 - CODEX|C_ReleaseStoicTag · 01 · env-sigs (caps) ==== ================================
(print "--- [TX005 - CODEX|C_ReleaseStoicTag · 01 · env-sigs (caps)] ---")
(env-sigs
    [
        { "key": "PK_AncientHodler", "caps": [] }
    ]
)
;;==== TX005 - CODEX|C_ReleaseStoicTag · 02 · let / invocation ==== ===============================
(print "--- [TX005 - CODEX|C_ReleaseStoicTag · 02 · let / invocation] ---")
(let
    (
        (patron:string KST.ANHD)
        (tag-name:string (read-string "CODEX|STOICTAG-NAME"))
        (account-raw:string (read-string "CODEX|STOICTAG-ACCOUNT"))
        (account-address:string
            (if (= account-raw "")
                KST.ANHD
                account-raw
            )
        )
        (ref-TS01-C4:module{TalosStageOne_ClientFourV8} TS01-C4)
        (ref-CODEX:module{CodexV2} CODEX)
        (tag-fee:decimal (ref-CODEX::UC_StoicTagStoaFee tag-name))
        ;;FUNCTION COVERAGE (G6) — `INFO_CODEX|ReleaseStoicTag`, per the owner's spec. Template:
        ;;`modules/ATS.repl <<ATS-I1>>`. This completes CODEX: rotate-guard (IGNIS) at <<TX002-INFO>>,
        ;;arweave-upload (IGNIS) at `modules/CODEX.repl <<CODEX-I1>>`, register-tag (STOA) at
        ;;<<TX004-INFO>>, release-tag here — all four client ops now have a measured quote.
        ;;Release is the interesting twin of register: the SAME per-glyph figure is charged, but in
        ;;IGNIS rather than STOA, so a preview that copied its sibling's currency would be caught here.
        (predicted:object{OuronetInfoV2.ClientInfo}
            (CODEX.INFO_CODEX|ReleaseStoicTag patron tag-name))
        (ignis-before:decimal (DALOS.UR_TF_AccountSupply patron false))
        (stoa-before:decimal (coin.get-balance (DALOS.UR_AccountStoa patron)))
        (rel-msg:string (ref-TS01-C4::CODEX|C_ReleaseStoicTag patron tag-name))
    )
    (map print
        [
            (format "<<TX005-INFO>> IGNIS predicted={} real={}"
                [(at "ignis-need" (at "ignis" predicted)) (- ignis-before (DALOS.UR_TF_AccountSupply patron false))])
            (expect "<<TX005-INFO>> the preview's IGNIS quote equals what releasing the tag charged"
                (- ignis-before (DALOS.UR_TF_AccountSupply patron false))
                (at "ignis-need" (at "ignis" predicted)))
            (expect "<<TX005-INFO>> ...and releasing a StoicTag is NOT free"
                true (> (- ignis-before (DALOS.UR_TF_AccountSupply patron false)) 0.0))
            ;;and the currency really is IGNIS, not STOA: the sibling register-tag op charges the same
            ;;per-glyph figure in STOA, so "no STOA moved" is what distinguishes the two.
            (expect "<<TX005-INFO>> ...and it is charged in IGNIS, not STOA — unlike its register twin"
                (- stoa-before (coin.get-balance (DALOS.UR_AccountStoa patron)))
                (at "stoa-need" (at "stoa" predicted)))
        ]
    )
    ;;==== TX005 · 01b · IGNIS fee echo (same UC_StoicTagStoaFee amount) ====
    (print "--- [TX005 · 01b · IGNIS fee (UC_StoicTagStoaFee amount, 1 per glyph)] ---")
    (print (format "<(CODEX|UC_StoicTagStoaFee)> tag len {} => \"{}\" IGNIS" [(length tag-name) tag-fee]))
    ;;==== TX005 · 02 · Talos C_ReleaseStoicTag ====
    (print "--- [TX005 · 02 · Talos C_ReleaseStoicTag] ---")
    (print (format "<(TS01-C4.CODEX|C_ReleaseStoicTag)> => \"{}\"" [rel-msg]))
    ;;==== TX005 · 03 · UR deactivation + bijection expects ====
    (print "--- [TX005 · 03 · UR deactivation + bijection expects] ---")
    (map print
        [
            (format "<(CODEX|UR_STG|IzActive)> => \"{}\"" [(ref-CODEX::UR_STG|IzActive tag-name)])
            (format "<(CODEX|UR_STBA|IzActive)> => \"{}\"" [(ref-CODEX::UR_STBA|IzActive account-address)])
            (expect
                "<<TX005>> UR_STG|IzActive false after release"
                false
                (ref-CODEX::UR_STG|IzActive tag-name)
            )
            (expect
                "<<TX005>> UR_STBA|IzActive false after release (bijection)"
                false
                (ref-CODEX::UR_STBA|IzActive account-address)
            )
            (expect
                "<<TX005>> UR_STG|DataOrNull is-registered false"
                false
                (at "is-registered" (ref-CODEX::UR_STG|DataOrNull tag-name))
            )
            (expect
                "<<TX005>> UR_STBA|DataOrNull has-stoictag false (bijection)"
                false
                (at "has-stoictag" (ref-CODEX::UR_STBA|DataOrNull account-address))
            )
        ]
    )
    ""
)
(print (format "<(REPL|env-gas)> TX005 => \"{}\"" [(env-gas)]))
(commit-tx)
(print "")
;;||>>>>>>>>>>>>>>>>>>>>>>>>>
;;|| NEXT                   >
;;||>>>>>>>>>>>>>>>>>>>>>>>>>
(print "")
(begin-tx "TX006 - CODEX|C_RegisterStoicTag (re-activate released tag)")
(namespace "ouronet-ns")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(print "")
(print "=== TX006 — C_RegisterStoicTag (released → re-active, update both tables) =====")
;;==== TX006 - CODEX|C_RegisterStoicTag (re-activate released tag) · 01 · let / invocation ==== ===
(print "--- [TX006 - CODEX|C_RegisterStoicTag (re-activate released tag) · 01 · let / invocation] ---")
(let
    (
        (patron:string KST.ANHD)
        (tag-name:string (read-string "CODEX|STOICTAG-NAME"))
        (account-raw:string (read-string "CODEX|STOICTAG-ACCOUNT"))
        (account-address:string
            (if (= account-raw "")
                KST.ANHD
                account-raw
            )
        )
        (ref-DALOS:module{OuronetDalosV2} DALOS)
        (ref-TS01-C4:module{TalosStageOne_ClientFourV8} TS01-C4)
        (ref-CODEX:module{CodexV2} CODEX)
        (stoa-fee:decimal (ref-CODEX::UC_StoicTagStoaFee tag-name))
        (patron-stoa:string (ref-DALOS::UR_AccountStoa patron))
        (demiurgoi:[string] (ref-DALOS::UR_DemiurgoiID))
        (stoa-hov:string (ref-DALOS::UR_AccountStoa (at 2 demiurgoi)))
        (stoa-cto:string (ref-DALOS::UR_AccountStoa (at 1 demiurgoi)))
        (stoa-ouroboros:string (ref-DALOS::UR_AccountStoa (ref-DALOS::GOV|OUROBOROS|SC_NAME)))
        (stoa-dalos:string (ref-DALOS::UR_AccountStoa (ref-DALOS::GOV|DALOS|SC_NAME)))
        (split-stoa:[decimal] (ref-DALOS::URC_SplitSTOAPrices account-address stoa-fee))
    )
    ;;==== TX006 · 01 · STOA fee echo ====
    (print "--- [TX006 · 01 · STOA fee (re-register released tag, 10/20/30/40 split)] ---")
    (print (format "<(CODEX|UC_StoicTagStoaFee)> tag len {} => \"{}\" STOA" [(length tag-name) stoa-fee]))
    (print (format "<(DALOS|URC_SplitSTOAPrices)> => \"{}\"" [split-stoa]))
    ;;==== TX006 · 02 · env-sigs ====
    (print "--- [TX006 · 02 · env-sigs (DALOS owner + STOA 10/20/30/40)] ---")
    (env-sigs
        [
            { "key": "PK_AncientHodler", "caps": [] }
            { "key": "6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263",
              "caps":
                [
                    (coin.TRANSFER patron-stoa stoa-cto (at 2 split-stoa))
                    (coin.TRANSFER patron-stoa stoa-hov (at 0 split-stoa))
                    (coin.TRANSFER patron-stoa stoa-ouroboros (at 3 split-stoa))
                    (coin.TRANSFER patron-stoa stoa-dalos (at 1 split-stoa))
                ]
            }
        ]
    )
    (let
        (
            (stg-msg:string
                (ref-TS01-C4::CODEX|C_RegisterStoicTag patron tag-name account-address)
            )
        )
        ;;==== TX006 · 03 · Talos C_RegisterStoicTag (upsert path) ====
        (print "--- [TX006 · 03 · Talos C_RegisterStoicTag (released re-activate)] ---")
        (print (format "<(TS01-C4.CODEX|C_RegisterStoicTag)> => \"{}\"" [stg-msg]))
        ;;==== TX006 · 04 · bijection re-active expects ====
        (print "--- [TX006 · 04 · bijection re-active expects (both tables)] ---")
        (map print
            [
                (expect
                    "<<TX006>> UR_STG|IzActive true after re-register"
                    true
                    (ref-CODEX::UR_STG|IzActive tag-name)
                )
                (expect
                    "<<TX006>> UR_STBA|IzActive true after re-register (bijection)"
                    true
                    (ref-CODEX::UR_STBA|IzActive account-address)
                )
                (expect
                    (format "<<TX006>> UR_STG|AccountAddress \"{}\"" [account-address])
                    account-address
                    (ref-CODEX::UR_STG|AccountAddress tag-name)
                )
                (expect
                    (format "<<TX006>> UR_STBA|TagName \"{}\"" [tag-name])
                    tag-name
                    (ref-CODEX::UR_STBA|TagName account-address)
                )
                (expect
                    "<<TX006>> UR_STG|DataOrNull is-registered true (released re-activate)"
                    true
                    (at "is-registered" (ref-CODEX::UR_STG|DataOrNull tag-name))
                )
                (expect
                    "<<TX006>> UR_STBA|DataOrNull has-stoictag true (released re-activate)"
                    true
                    (at "has-stoictag" (ref-CODEX::UR_STBA|DataOrNull account-address))
                )
            ]
        )
        ""
    )
)
(print (format "<(REPL|env-gas)> TX006 => \"{}\"" [(env-gas)]))
(commit-tx)
(print "")
(print "=== END [6.9]_CODEX.repl ================================================")
