;;
;; REPL/Stage_01/[6.9]_CODEX.repl — CODEX A_ / C_ via TS01-C4 (canonical layout)
;;   Prerequisite: Stage 01 stack through [4.0]_Sovereign-Executor.repl (CODEX, TS01-C4 deployed).
;;   Load: (load "Stage_01/[6.9]_CODEX.repl") after Stage01_Tester (or comment other [6.x] and add this load).
;;
;;   Placeholders — edit env-data in INIT TX000 before running TX001+:
;;     CODEX|COMPOSITE-ID     325-char Apollo composite (₱.*162 + ':' + Π.*162)
;;     CODEX|PUBLIC-STANDARD  non-empty pubkey string for standard half
;;     CODEX|PUBLIC-SMART     non-empty pubkey string for smart half
;;     CODEX|REGISTERED-BY    Mnemosyne operator id (free-form string stored on row)
;;     CODEX|ARWEAVE-TX-ID    43-char base64url Arweave tx id (default is valid charset; replace with real id)
;;     CODEX|STOICTAG-NAME    3–256 glyphs, DALOS|CHARSET only; register = 1 STOA/glyph, release = 1 IGNIS/glyph
;;     CODEX|STOICTAG-ACCOUNT Ouronet DALOS account (Ѻ.* / Σ.*) — default KST.ANHD
;;   KEY_CODEX_GUARD / KEY_CODEX_GUARD_NEW — keysets for codex-guard at register and after rotate.
;;
;;   Inter-tx:   ;;|| NEXT >
;;   Intra-tx:   ;;==== TXnnn · mm · <slug> ====  + (print "--- [TXnnn · mm · …] ---")
;;   format "{}": Talos C_* / CODEX UR_* echoes, expect docs, (env-gas).
;;
(print "")
(print "================================================================")
(print "FILE  REPL/Stage_01/[6.9]_CODEX.repl")
(print "================================================================")
(print "Legend:")
(print "  <<…>>     expect / expect-failure doc")
(print "  <(TS01-C4.CODEX|…)> => \"…\"   Talos client → CODEX write")
(print "  <(CODEX|UR_…|…)> => \"…\"       ref-CODEX utility read")
(print "  <(REPL|env-gas)> …             gas after tx")
(print "")
(print "Source: ;;|| NEXT > between txs; ;;==== TXnnn · mm · … ==== per group.")
(print "REPL tests: (map print [(expect …) …]) — one line per assertion.")
(print "")
(print ">>> Fill CODEX|COMPOSITE-ID and pubkey placeholders in INIT TX000 env-data before TX001. <<<")
(print "")
;;
(begin-tx "TX000 INIT - chain data + CODEX placeholder env-data")
(namespace "ouronet-ns")
;;==== TX000 · 01 · env-chain-data ====
(print "--- [TX000 · 01 · env-chain-data] ---")
(env-chain-data
    {"prev-block-hash": "98c486052a5147fdd30fa43cc6d67e0a4e680c856c37f9157cb788cd67d58006",
     "block-time": TV.TIME00}
)
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
;;==== TX000 · 02 · placeholder env-data (edit before TX001) ====
(print "--- [TX000 · 02 · placeholder env-data (edit before TX001)] ---")
(env-data
    {
        "CODEX|COMPOSITE-ID": "₱.ŹΘHYSç7þУJΛpøЩфμбÄИЫŒП9ó7æйȘΣßлΔσ3äЬyrfжπйôleBĄиĄLtźș∇îИyKβńĎDûuÁCȘñЯÒźâŒíßRζäĞΩěѺtşlęHБMŸíWlãąŹÔИЖÊzHțćœŽζýżχδšωχUΨNńúńñУnИкjубâ£ßMKηжлý9κιЦвSαцууěÖщьΩùцn₳Бεůφ:Π.ЙÛœ5ŒOóцιbÌȘŚÚůVÀΠьδЬÃςиbIñжÄoTЬŮşÄrhûεżęF5h₳ΞžGËWXÇûKÖLÙNÂ₱ůθŚяZ₳tœ¥ÅÂΓŹË4uĂбoÚAвOUζÂwΩэí₳ÜŻŁqΣкΣΨΨþѺBkĞõeѺńξTŠB0èΦeπδóýwÑeщIäΣMNøθΔîý₿ŹďρŁȘρτYEúNвÓûĐØúkŹýşθÞΓ",
        "CODEX|PUBLIC-STANDARD": "6g.",
        "CODEX|PUBLIC-SMART": "6g.",
        "CODEX|REGISTERED-BY": "AncientHodler",
        "CODEX|ARWEAVE-TX-ID": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
        "CODEX|STOICTAG-NAME": "codextest01",
        "CODEX|STOICTAG-ACCOUNT": "",
        "KEY_CODEX_GUARD": {"keys": [KC.DPTS_PBKY_0000], "pred": "keys-all"},
        "KEY_CODEX_GUARD_NEW": {"keys": [KC.DPTS_PBKY_000a], "pred": "keys-all"}
    }
)
(print (format "<(REPL|env-gas)> TX000 after env-data => \"{}\"" [(env-gas)]))
(commit-tx)
(print "")
;;||>>>>>>>>>>>>>>>>>>>>>>>>>
;;|| NEXT                   >
;;||>>>>>>>>>>>>>>>>>>>>>>>>>
(print "")
(begin-tx "TX001 - CODEX|A_RegisterCodexIdentity + UR_CIX reads")
(namespace "ouronet-ns")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(print "")
(print "=== TX001 — A_RegisterCodexIdentity =====================================")
;;==== TX001 · 01 · env-sigs (codex-keyset / Demiourgos) ====
(print "--- [TX001 · 01 · env-sigs (codex-keyset / Demiourgos)] ---")
(env-sigs
    [
        { "key": "PK_AncientHodler", "caps": [] }
    ]
)
(let
    (
        (composite-id:string (read-string "CODEX|COMPOSITE-ID"))
        (public-standard:string (read-string "CODEX|PUBLIC-STANDARD"))
        (public-smart:string (read-string "CODEX|PUBLIC-SMART"))
        (registered-by:string (read-string "CODEX|REGISTERED-BY"))
        (codex-guard:guard (read-keyset "KEY_CODEX_GUARD"))
        (ref-TS01-C4:module{TalosStageOne_ClientFourV7} TS01-C4)
        (ref-CODEX:module{CodexV1} CODEX)
        (reg-msg:string
            (ref-TS01-C4::CODEX|A_RegisterCodexIdentity
                composite-id
                public-standard
                public-smart
                codex-guard
                registered-by
            )
        )
    )
    ;;==== TX001 · 02 · Talos A_Register ====
    (print "--- [TX001 · 02 · Talos A_Register] ---")
    (print (format "<(TS01-C4.CODEX|A_RegisterCodexIdentity)> => \"{}\"" [reg-msg]))
    ;;==== TX001 · 03 · UR_CIX reads + expects ====
    (print "--- [TX001 · 03 · UR_CIX reads + expects] ---")
    (map print
        [
            (format "<(CODEX|UR_CIX|CodexId)> => \"{}\"" [(ref-CODEX::UR_CIX|CodexId composite-id)])
            (format "<(CODEX|UR_CIX|PublicStandard)> => \"{}\"" [(ref-CODEX::UR_CIX|PublicStandard composite-id)])
            (format "<(CODEX|UR_CIX|PublicSmart)> => \"{}\"" [(ref-CODEX::UR_CIX|PublicSmart composite-id)])
            (format "<(CODEX|UR_CIX|RegisteredBy)> => \"{}\"" [(ref-CODEX::UR_CIX|RegisteredBy composite-id)])
            (expect
                (format "<<TX001>> UR_CIX|CodexId matches composite-id \"{}\"" [composite-id])
                composite-id
                (ref-CODEX::UR_CIX|CodexId composite-id)
            )
            (expect
                (format "<<TX001>> UR_CIX|RegisteredBy \"{}\"" [registered-by])
                registered-by
                (ref-CODEX::UR_CIX|RegisteredBy composite-id)
            )
            (expect
                "<<TX001>> UR_CIX|DataOrNull is-registered true"
                true
                (at "is-registered" (ref-CODEX::UR_CIX|DataOrNull composite-id))
            )
        ]
    )
    ""
)
(print (format "<(REPL|env-gas)> TX001 => \"{}\"" [(env-gas)]))
(commit-tx)
(print "")
;;||>>>>>>>>>>>>>>>>>>>>>>>>>
