;;
;; REPL/Stage_01/[6.9]_CODEX.repl — CODEX A_ / C_ via TS01-C4 (canonical layout)
;;   Prerequisite: Stage 01 stack through [4.0]_Sovereign-Executor.repl (CODEX, TS01-C4 deployed).
;;   Load: (load "Stage_01/[6.9]_CODEX.repl") after Stage01_Tester (or comment other [6.x] and add this load).
;;
;;   Placeholders — edit env-data in INIT TX000 before running TX001+:
;;     CODEX|COMPOSITE-ID     325-char Apollo composite (₱.*162 + ':' + Π.*162)
;;     CODEX|PUBLIC-STANDARD  non-empty pubkey string for standard half
;;     CODEX|PUBLIC-SMART     non-empty pubkey string for smart half
;;     CODEX|REGISTERED-BY    Mnemosyne operator id (free-form string stored on row)
;;     CODEX|ARWEAVE-TX-ID    43-char base64url Arweave tx id (default is valid charset; replace with real id)
;;     CODEX|STOICTAG-NAME    3–256 glyphs, DALOS|CHARSET only; register = 1 STOA/glyph, release = 1 IGNIS/glyph
;;     CODEX|STOICTAG-ACCOUNT Ouronet DALOS account (Ѻ.* / Σ.*) — default KST.ANHD
;;   KEY_CODEX_GUARD / KEY_CODEX_GUARD_NEW — keysets for codex-guard at register and after rotate.
;;
;;   Inter-tx:   ;;|| NEXT >
;;   Intra-tx:   ;;==== TXnnn · mm · <slug> ====  + (print "--- [TXnnn · mm · …] ---")
;;   format "{}": Talos C_* / CODEX UR_* echoes, expect docs, (env-gas).
;;
(print "")
(print "================================================================")
(print "FILE  REPL/Stage_01/[6.9]_CODEX.repl")
(print "================================================================")
(print "Legend:")
(print "  <<…>>     expect / expect-failure doc")
(print "  <(TS01-C4.CODEX|…)> => \"…\"   Talos client → CODEX write")
(print "  <(CODEX|UR_…|…)> => \"…\"       ref-CODEX utility read")
(print "  <(REPL|env-gas)> …             gas after tx")
(print "")
(print "Source: ;;|| NEXT > between txs; ;;==== TXnnn · mm · … ==== per group.")
(print "REPL tests: (map print [(expect …) …]) — one line per assertion.")
(print "")
(print ">>> Fill CODEX|COMPOSITE-ID and pubkey placeholders in INIT TX000 env-data before TX001. <<<")
(print "")
