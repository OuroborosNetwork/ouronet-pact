;;==== SWP|TX 018 - C7 Reproduction: Weight-Modification Guards · 02 · let / invocation ==== ==========
(print "--- [SWP|TX 018 - C7 Reproduction: Weight-Modification Guards · 02 · let / invocation] ---")
;;Audit ref: Audit/SWP/ROUND-01-FINDINGS.md #C7 — SWP|S>WEIGHTS had no length-parity check, a dead
;;(discarded) precision check, and no per-weight lower bound. Fixed: length-parity mirrors the sibling
;;SWP|S>UPDATE-SUPPLIES cap; precision + >=0.1 floor now enforced per-weight inside the map lambda
;;(matching the working UEV_UniformList idiom, not the original dead-map one). Every case below would
;;have succeeded silently pre-fix; all four must now abort, and a legitimate reweight must still work.
(let
    (
        (ref-TS01-C3:module{TalosStageOne_ClientThreeV3} TS01-C3)
        (ref-SWP:module{SwapperV3} SWP)
        (patron:string KST.ANHD)
        (pool1:string "W|DLK-98c486052a51|OURO-98c486052a51|DWK-98c486052a51")
    )
    (map print
        [
            (expect-failure "C7 fix — length mismatch (2 weights on a 3-token pool) is rejected"
                (ref-TS01-C3::SWP|C_ModifyWeights patron pool1 [0.5 0.5]))
            (expect-failure "C7 fix — a weight below the 0.1 floor is rejected"
                (ref-TS01-C3::SWP|C_ModifyWeights patron pool1 [0.05 0.45 0.5]))
            (expect-failure "C7 fix — a negative weight (cancelling to sum=1.0) is rejected"
                (ref-TS01-C3::SWP|C_ModifyWeights patron pool1 [1.2 0.3 -0.5]))
            (expect-failure "C7 fix — a weight violating fee precision (5 decimals) is rejected"
                (ref-TS01-C3::SWP|C_ModifyWeights patron pool1 [0.30001 0.5 0.19999]))
        ]
    )
    (ref-TS01-C3::SWP|C_ModifyWeights patron pool1 [0.4 0.4 0.2])
    (print (format "C7 — legitimate reweight succeeded, pool1 weights now: {}" [(ref-SWP::UR_Weigths pool1)]))
)
