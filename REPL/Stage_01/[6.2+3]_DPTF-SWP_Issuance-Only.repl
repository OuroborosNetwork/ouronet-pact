(begin-tx "SWP|TX 026 - #13C Reproduction: 4-Hop Chain Path Discovery")
(namespace "ouronet-ns")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(print "--- [SWP|TX 026 - #13C Reproduction · 01 · env-sigs (caps)] ---")
(env-sigs [])
(print "--- [SWP|TX 026 - #13C Reproduction · 02 · let / invocation] ---")
;;Audit ref: ROUND-01-FINDINGS.md #13C — node envelope narrower than the live edge-set, paths >=4
;;hops corrupted/lost. AG->CO is a genuine, real, freshly-issued 4-hop chain (AG-AL-AU-BI-CO); no
;;shorter route exists yet (the shortcut pool is issued only in TX027, for #19H). Pre-fix, this
;;would either lose the path entirely or splice the literal "BAR" sentinel into the chain.
(let
    (
        (ref-SWPI:module{SwapperIssueV3} SWPI)
        (ag:string "AG-98c486052a51")
        (al:string "AL-98c486052a51")
        (au:string "AU-98c486052a51")
        (bi:string "BI-98c486052a51")
        (co:string "CO-98c486052a51")
        (expected-nodes:[string] ["AG-98c486052a51" "AL-98c486052a51" "AU-98c486052a51" "BI-98c486052a51" "CO-98c486052a51"])
        (h-obj:object{SwapperIssueV3.Hopper} (ref-SWPI::URC_HopperActive ag co 10.0))
        (nodes:[string] (at "nodes" h-obj))
        (edges:[string] (at "edges" h-obj))
        (outputs:[decimal] (at "output-values" h-obj))
    )
    (map print
        [
            (format "#13C proof — AG->CO nodes found: {}" [nodes])
            (format "#13C proof — edges used: {}" [edges])
            (format "#13C proof — output values per hop: {}" [outputs])
            (expect "#13C fix — full 5-node/4-hop chain AG-AL-AU-BI-CO discovered intact, no truncation or BAR corruption" expected-nodes nodes)
            (expect "#13C fix — exactly 4 real edges used (one per hop), none the literal BAR sentinel" 4 (length edges))
            (expect "#13C fix — no BAR sentinel spliced into the edge list" false (contains "|" edges))
        ]
    )
)
(print "")
(print "--- [SWP|TX 026 - #13C Reproduction · 03 · gas echo] ---")
(format "<<<<<<<SWP|TX 026 #13C Reproduction ==> {} KDA GAS>>>>>>>" [(env-gas)])
(print "===^^^===")
(env-sigs [])
(commit-tx)
