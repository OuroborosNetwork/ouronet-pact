    ;(ref-TS01-CP::SWP|C_IssueStandardPool
    ;    patron
    ;    patron
    ;    pool-tokens
    ;    fee-lp
    ;    ;amp
    ;    p
    ;)
    
    [
        (format "AH has {} GAS" [(ref-DPTF::UR_AccountSupply (ref-DALOS::UR_IgnisID) KST.ANHD)])
        (ref-TS01-CP::SWP|C_IssueStablePool
            patron
            patron
            pool-tokens
            fee-lp
            amp
            p
        )
        (pact-state)
    ]
)

