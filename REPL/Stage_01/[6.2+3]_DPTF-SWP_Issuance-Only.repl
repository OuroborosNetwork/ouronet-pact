(begin-tx "SWP|TX 028 - #19H Reproduction: Disabled Shortcut Falls Back To Active Chain")
(namespace "ouronet-ns")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(print "--- [SWP|TX 028 - #19H Reproduction · 01 · env-sigs (caps)] ---")
(env-sigs [ { "key": "PK_AncientHodler", "caps": [] } ])
(print "--- [SWP|TX 028 - #19H Reproduction · 02 · let / invocation] ---")
;;Audit ref: ROUND-01-FINDINGS.md #19H — disabled/frozen pools are never filtered from routing,
;;no fallback. With the shortcut S|AG|CO active, it is the shortest (1-hop) AG->CO route and
;;should be BFS's pick. We disable it (can-swap=false) and assert routing correctly falls back
;;to the still-active 4-hop chain instead of failing outright or (pre-fix) still trying to use
;;the disabled pool.
(let
    (
        (ref-SWPI:module{SwapperIssueV3} SWPI)
        (ref-TS01-C3:module{TalosStageOne_ClientThreeV3} TS01-C3)
        (ag:string "AG-98c486052a51")
        (co:string "CO-98c486052a51")
        (shortcut:string "S|AG-98c486052a51|CO-98c486052a51")
        (expected-chain-nodes:[string] ["AG-98c486052a51" "AL-98c486052a51" "AU-98c486052a51" "BI-98c486052a51" "CO-98c486052a51"])
    )
    (ref-TS01-C3::SWP|C_ToggleSwapCapability KST.ANHD shortcut false)
    (let
        (
            (h-obj:object{SwapperIssueV3.Hopper} (ref-SWPI::URC_HopperActive ag co 10.0))
            (nodes:[string] (at "nodes" h-obj))
            (edges:[string] (at "edges" h-obj))
        )
        (map print
            [
                (format "#19H proof — shortcut disabled; AG->CO nodes found: {}" [nodes])
                (format "#19H proof — edges used: {}" [edges])
                (expect "#19H fix — disabled shortcut is never selected; routing falls back to the active 4-hop chain" expected-chain-nodes nodes)
                (expect "#19H fix — the disabled shortcut pool itself is not among the edges used" false (contains shortcut edges))
            ]
        )
    )
)
(print "")
(print "--- [SWP|TX 028 - #19H Reproduction · 03 · gas echo] ---")
(format "<<<<<<<SWP|TX 028 #19H Reproduction ==> {} KDA GAS>>>>>>>" [(env-gas)])
(print "===^^^===")
(env-sigs [])
(commit-tx)
;;|| NEXT >
(begin-tx "SWP|TX 029 - #20H Reproduction: Fully Disconnected Pair Returns Clean No-Path")
(namespace "ouronet-ns")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(print "--- [SWP|TX 029 - #20H Reproduction · 01 · env-sigs (caps)] ---")
(env-sigs [ { "key": "PK_AncientHodler", "caps": [] } ])
(print "--- [SWP|TX 029 - #20H Reproduction · 02 · let / invocation] ---")
;;Audit ref: ROUND-01-FINDINGS.md #20H — URC_ComputeGraphPath crashes (out-of-bounds `at` on an
;;empty list) instead of returning the clean [BAR] "no path" sentinel. This crash path is
;;specifically the case where BFS DOES discover real chains (so the "nothing at all" [[BAR]]
;;short-circuit is never hit) but NONE of them reach <output> — so S|OURO|AG is deliberately left
;;ACTIVE here (AG stays richly connected to the wider live graph via OURO's many other pools,
;;guaranteeing BFS finds real chains rooted at AG), while every pool that could ever reach CO from
;;AG (the rest of the chain, plus the already-disabled shortcut from TX028) is disabled — making
;;CO itself genuinely unreachable, not AG merely isolated.
(let
    (
        (ref-TS01-C3:module{TalosStageOne_ClientThreeV3} TS01-C3)
        (pools-to-disable:[string]
            [ "S|AG-98c486052a51|AL-98c486052a51"
              "S|AL-98c486052a51|AU-98c486052a51"
              "S|AU-98c486052a51|BI-98c486052a51"
              "S|BI-98c486052a51|CO-98c486052a51" ]
        )
    )
