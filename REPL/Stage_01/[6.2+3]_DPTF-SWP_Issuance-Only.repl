(begin-tx "SWP|TX 022 - H11 Reproduction: can-add Never Blocks Removal")
(namespace "ouronet-ns")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
;;==== SWP|TX 022 - H11 Reproduction: can-add Never Blocks Removal · 01 · env-sigs (caps) ==== ==========
(print "--- [SWP|TX 022 - H11 Reproduction: can-add Never Blocks Removal · 01 · env-sigs (caps)] ---")
(env-sigs
    [
        { "key": "PK_AncientHodler", "caps": [] }
        { "key": "PK_AOZ", "caps": [] }
    ]
)
;;==== SWP|TX 022 - H11 Reproduction: can-add Never Blocks Removal · 02 · let / invocation ==== =========
(print "--- [SWP|TX 022 - H11 Reproduction: can-add Never Blocks Removal · 02 · let / invocation] ---")
;;Audit ref: Audit/SWP/ROUND-01-FINDINGS.md #H11 — UEV_RemoveLiquidity read the SAME <can-add> flag
;;UEV_AddLiquidity does; flipping can-add=false blocked new deposits AND simultaneously stranded every
;;existing LP's principal, permanently, with no escape hatch. Owner decision (2026-08-17, after checking
;;industry practice — Curve's kill_me structurally exempts plain remove_liquidity; Balancer's Recovery
;;Mode is deliberately permissionless while paused, "so that funds can never be locked by governance
;;action"): can-add legitimately pauses new deposits, but must NEVER be able to block existing LPs from
;;getting their own principal back. Fixed by removing the can-add check from UEV_RemoveLiquidity entirely.
(let
    (
        (ref-TS01-C3:module{TalosStageOne_ClientThreeV3} TS01-C3)
        (ref-SWP:module{SwapperV3} SWP)
        (ref-DPTF:module{DemiourgosPactTrueFungibleV1} DPTF)
        (patron:string KST.ANHD)
        (pool1:string "W|DLK-98c486052a51|OURO-98c486052a51|DWK-98c486052a51")
        (lp-id:string (ref-SWP::UR_TokenLP pool1))
        (patron-lp-before:decimal (ref-DPTF::UR_AccountSupply lp-id patron))
    )
    ;;Pause new deposits on pool1.
    (ref-TS01-C3::SWP|C_ToggleAddLiquidity patron pool1 false)
    (map print
        [
            ;;can-add=false must still block a NEW deposit — unchanged, legitimate behavior.
            (expect-failure "H11 fix — can-add=false still blocks a new deposit, as intended"
                (ref-TS01-C3::SWP|C_AddLiquidity patron patron pool1 [10.0 10.0 10.0]))
        ]
    )
    ;;can-add=false must NOT block removing existing LP principal — the actual fix.
    (ref-TS01-C3::SWP|C_RemoveLiquidity patron patron pool1 (floor (* patron-lp-before 0.01) 6))
    (print (format "H11 fix — removal succeeded despite can-add=false; patron LP before={} after={}"
        [patron-lp-before (ref-DPTF::UR_AccountSupply lp-id patron)]))
    ;;Restore pool1 to its normal (add-enabled) state so nothing downstream is perturbed.
    (ref-TS01-C3::SWP|C_ToggleAddLiquidity patron pool1 true)
)
(print "")
(print "")
