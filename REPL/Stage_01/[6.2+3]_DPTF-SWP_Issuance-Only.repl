(begin-tx "SWP|TX 035 - A_RotatePrincipal Reproduction: HG -> TI")
(namespace "ouronet-ns")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(print "--- [SWP|TX 035 - Rotate Principal Reproduction · 01 · env-sigs (caps)] ---")
(env-sigs [ { "key": "PK_AncientHodler", "caps": [] } ])
(print "--- [SWP|TX 035 - Rotate Principal Reproduction · 02 · let / invocation] ---")
;;Audit ref: #21H — proves rotation is safe end-to-end. HG anchors the real, already-issued
;;P|HG|TE pool from TX034. Rotating HG -> TI must: (1) leave the principal count unchanged at 7,
;;(2) leave P|HG|TE's routing completely intact (SWPT's graph is principal-agnostic, #21H's fix —
;;rotation touches SWP|Properties only, never SWPT), (3) block any NEW pool from anchoring to HG
;;(no longer a principal), (4) allow a NEW pool to anchor to TI (the new principal). Also checks
;;the 3 rotate-specific rejections: rotating a non-principal, rotating into an already-existing
;;principal, and rotating a principal into itself.
(let
    (
        (ref-TS01-A:module{TalosStageOne_AdminV1} TS01-A)
        (ref-SWP:module{SwapperV3} SWP)
        (ref-SWPI:module{SwapperIssueV3} SWPI)
        (hg:string "HG-98c486052a51")
        (te:string "TE-98c486052a51")
        (ti:string "TI-98c486052a51")
        (ouro:string "OURO-98c486052a51")
        (before-count:integer (length (ref-SWP::UR_Principals)))
        (route-before:object{SwapperIssueV3.Hopper} (ref-SWPI::URC_Hopper hg te 5.0))
    )
    (map print
        [
            (expect-failure "Rotate fix — rotating a non-principal is rejected" (ref-TS01-A::SWP|A_RotatePrincipal "PT-98c486052a51_typo" ti))
            (expect-failure "Rotate fix — rotating into an already-existing principal is rejected" (ref-TS01-A::SWP|A_RotatePrincipal hg ouro))
            (expect-failure "Rotate fix — rotating a principal into itself is rejected" (ref-TS01-A::SWP|A_RotatePrincipal hg hg))
        ]
    )
    (ref-TS01-A::SWP|A_RotatePrincipal hg ti)
    (let
        (
            (after-principals:[string] (ref-SWP::UR_Principals))
            (route-after:object{SwapperIssueV3.Hopper} (ref-SWPI::URC_Hopper hg te 5.0))
        )
        (map print
            [
                (format "#21H rotate proof — principals after rotation: {}" [after-principals])
                (format "#21H rotate proof — HG->TE route before: {}" [(at "nodes" route-before)])
                (format "#21H rotate proof — HG->TE route after:  {}" [(at "nodes" route-after)])
                (expect "Rotate fix — principal count unchanged (still 7)" before-count (length after-principals))
                (expect "Rotate fix — HG removed from principals" false (contains hg after-principals))
                (expect "Rotate fix — TI added to principals" true (contains ti after-principals))
                (expect "Rotate fix — HG->TE route is genuinely non-empty before rotation (proves this is a real check, not a trivial []=[] pass)" true (> (length (at "nodes" route-before)) 0))
                (expect "#21H fix — HG->TE routing completely unaffected by the rotation (SWPT is principal-agnostic)" route-before route-after)
            ]
        )
    )
)
(print "")
