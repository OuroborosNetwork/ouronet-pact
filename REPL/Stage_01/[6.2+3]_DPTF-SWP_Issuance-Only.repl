(begin-tx "SWP|TX 019 - C8 Reproduction: Amplifier-Update Guards")
(namespace "ouronet-ns")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
;;==== SWP|TX 019 - C8 Reproduction: Amplifier-Update Guards · 01 · env-sigs (caps) ==== ================
(print "--- [SWP|TX 019 - C8 Reproduction: Amplifier-Update Guards · 01 · env-sigs (caps)] ---")
(env-sigs
    [
        { "key": "PK_AncientHodler", "caps": [] }
        { "key": "PK_AOZ", "caps": [] }
    ]
)
;;==== SWP|TX 019 - C8 Reproduction: Amplifier-Update Guards · 02 · let / invocation ==== ===============
(print "--- [SWP|TX 019 - C8 Reproduction: Amplifier-Update Guards · 02 · let / invocation] ---")
;;Audit ref: Audit/SWP/ROUND-01-FINDINGS.md #C8 — SWP|S>UPDATE-AMPLIFIER never validated <new-amplifier>
;;at all: no lower bound, no upper bound, no exclusion of the module's own -1.0 "not a stable pool"
;;sentinel. Fixed: >= 1.0 (mirrors UEV_Issue's own creation-time floor) and <= 2000.0 (REPL-verified
;;ceiling — see 15_SWP.pact comment for the convergence-degradation data behind that number). Every case
;;below would have succeeded silently pre-fix; all four must now abort, and a legitimate update must work.
(let
    (
        (ref-TS01-C3:module{TalosStageOne_ClientThreeV3} TS01-C3)
        (ref-SWP:module{SwapperV3} SWP)
        (patron:string KST.ANHD)
        (pool2:string "S|DLK-98c486052a51|OURO-98c486052a51|DWK-98c486052a51")
    )
    ;;Each case is preceded by a reset to a known-good baseline (85.0) — deliberately isolates every
    ;;check from the others. Without this, a bad value that (pre-fix) actually succeeds would brick
    ;;<current-amp>, which then makes every LATER case "fail" for the wrong reason (the cap's own
    ;;pre-existing current-amp>0 check), masking whether each individual bound is independently enforced.
    (ref-TS01-C3::SWP|C_UpdateAmplifier patron pool2 85.0)
    (map print
        [(expect-failure "C8 fix — new-amplifier = 0.0 (div-by-zero bricking risk) is rejected"
            (ref-TS01-C3::SWP|C_UpdateAmplifier patron pool2 0.0))]
    )
    (ref-TS01-C3::SWP|C_UpdateAmplifier patron pool2 85.0)
    (map print
        [(expect-failure "C8 fix — new-amplifier = -1.0 (the non-stable-pool sentinel) is rejected"
            (ref-TS01-C3::SWP|C_UpdateAmplifier patron pool2 -1.0))]
    )
    (ref-TS01-C3::SWP|C_UpdateAmplifier patron pool2 85.0)
    (map print
        [(expect-failure "C8 fix — a negative new-amplifier is rejected"
            (ref-TS01-C3::SWP|C_UpdateAmplifier patron pool2 -5.0))]
    )
    (ref-TS01-C3::SWP|C_UpdateAmplifier patron pool2 85.0)
    (map print
        [(expect-failure "C8 fix — new-amplifier above the 2000.0 ceiling is rejected"
            (ref-TS01-C3::SWP|C_UpdateAmplifier patron pool2 5000.0))]
    )
    (ref-TS01-C3::SWP|C_UpdateAmplifier patron pool2 150.0)
    (print (format "C8 — legitimate amplifier update succeeded, pool2 amplifier now: {}" [(ref-SWP::UR_Amplifier pool2)]))
)
(print "")
(print "")
