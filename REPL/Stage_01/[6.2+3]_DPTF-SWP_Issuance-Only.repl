(begin-tx "SWP|TX 017 - C3 Reproduction: Zero-Fee Round-Trip Rounding Bias")
(namespace "ouronet-ns")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
;;==== SWP|TX 017 - C3 Reproduction: Zero-Fee Round-Trip Rounding Bias · 01 · env-sigs (caps) ==== ===
(print "--- [SWP|TX 017 - C3 Reproduction: Zero-Fee Round-Trip Rounding Bias · 01 · env-sigs (caps)] ---")
(env-sigs [])
;;==== SWP|TX 017 - C3 Reproduction: Zero-Fee Round-Trip Rounding Bias · 02 · let / invocation ==== ==
(print "--- [SWP|TX 017 - C3 Reproduction: Zero-Fee Round-Trip Rounding Bias · 02 · let / invocation] ---")
;;Audit ref: Audit/SWP/ROUND-01-FINDINGS.md #C3 — every solved-balance formula floors the intermediate
;;new-balance term, not the final answer, biasing every swap in the TAKER's favor. Reproduced here by
;;calling the raw UC_ComputeY/UC_ComputeWP math directly (bypassing fees entirely, exactly matching the
;;audit's own "zero fees, raw math" method) on two already-issued pools, round-tripping a swap: if a
;;trader can swap A->B then B->A and walk away with MORE than they started with, the bias is real and
;;live, not just a code-reading claim. No fees, no other callers involved — isolates the math alone.
;;Amount 100.0 (stable) / 9999.0 (weighted) were chosen because they're proven, live, to trigger the
;;bias on these exact pools — smaller weighted-pool amounts round-tripped exactly clean in a first pass
;;(100.0, 137.777, 333.333333, 1.0, 0.0001, 271.828182845904523536 all landed at delta=0), so 9999.0 was
;;picked specifically because it's the one that actually exposed it, not cherry-picked to hide anything.
(let
    (
        (ref-DALOS:module{OuronetDalosV1} DALOS)
        (ref-SWP:module{SwapperV3} SWP)
        (ref-U|SWP:module{UtilitySwpV1} U|SWP)
        (ref-U|LST:module{StringProcessorV1} U|LST)
        ;;-- Stable pool leg (S|DLK|OURO|DWK, A=85, genesis 800/900/850) --
        (pool-s:string "S|DLK-98c486052a51|OURO-98c486052a51|DWK-98c486052a51")
        (dlk:string (ref-DALOS::UR_SilverStoaID))
        (ouro:string (ref-DALOS::UR_OuroborosID))
        (As:decimal (ref-SWP::UR_Amplifier pool-s))
        (Xs:[decimal] (ref-SWP::UR_PoolTokenSupplies pool-s))
        (Ws:[decimal] (ref-SWP::UR_Weigths pool-s))
        (ip-s:integer (ref-SWP::UR_PoolTokenPosition pool-s dlk))
        (op-s:integer (ref-SWP::UR_PoolTokenPosition pool-s ouro))
        (o-prec-s:integer (at op-s (ref-SWP::UR_PoolTokenPrecisions pool-s)))
        (i-prec-s:integer (at ip-s (ref-SWP::UR_PoolTokenPrecisions pool-s)))
        (leg1-input-s:decimal 100.0)
        (leg1-out-s:decimal
            (ref-U|SWP::UC_ComputeY
                (ref-U|SWP::UDC_DirectRawSwapInput As Xs [leg1-input-s] [ip-s] op-s o-prec-s Ws)
            )
        )
        (Xs1:[decimal]
            (ref-U|LST::UC_ReplaceAt
                (ref-U|LST::UC_ReplaceAt Xs ip-s (+ (at ip-s Xs) leg1-input-s))
                op-s (- (at op-s Xs) leg1-out-s)
            )
        )
        (leg2-out-s:decimal
            (ref-U|SWP::UC_ComputeY
                (ref-U|SWP::UDC_DirectRawSwapInput As Xs1 [leg1-out-s] [op-s] ip-s i-prec-s Ws)
            )
        )
        ;;Also directly exercise UC_ComputeInverseY/UC_ZNext (not touched by leg1/leg2 above, which only
        ;;call UC_ComputeY) — on the ORIGINAL pool state, "how much DLK input is needed to get exactly
        ;;<leg1-out-s> OURO out" should round-trip consistently with the direct quote (>= leg1-input-s,
        ;;since UC_ComputeInverseY now ceilings — must never require less than was actually used).
        (inverse-check-s:decimal
            (ref-U|SWP::UC_ComputeInverseY
                (ref-U|SWP::UDC_InverseRawSwapInput As Xs leg1-out-s op-s ip-s i-prec-s Ws)
            )
        )
        ;;-- Weighted pool leg (W|DLK|OURO|DWK, weights [0.3 0.5 0.2], genesis 3200/10000/6000) --
        (pool-w:string "W|DLK-98c486052a51|OURO-98c486052a51|DWK-98c486052a51")
        (Aw:decimal (ref-SWP::UR_Amplifier pool-w))
        (Xw:[decimal] (ref-SWP::UR_PoolTokenSupplies pool-w))
        (Ww:[decimal] (ref-SWP::UR_Weigths pool-w))
        (ip-w:integer (ref-SWP::UR_PoolTokenPosition pool-w dlk))
        (op-w:integer (ref-SWP::UR_PoolTokenPosition pool-w ouro))
        (o-prec-w:integer (at op-w (ref-SWP::UR_PoolTokenPrecisions pool-w)))
        (i-prec-w:integer (at ip-w (ref-SWP::UR_PoolTokenPrecisions pool-w)))
        (leg1-input-w:decimal 9999.0)
        (leg1-out-w:decimal
            (ref-U|SWP::UC_ComputeWP
                (ref-U|SWP::UDC_DirectRawSwapInput Aw Xw [leg1-input-w] [ip-w] op-w o-prec-w Ww)
            )
        )
        (Xw1:[decimal]
            (ref-U|LST::UC_ReplaceAt
                (ref-U|LST::UC_ReplaceAt Xw ip-w (+ (at ip-w Xw) leg1-input-w))
                op-w (- (at op-w Xw) leg1-out-w)
            )
        )
        (leg2-out-w:decimal
            (ref-U|SWP::UC_ComputeWP
                (ref-U|SWP::UDC_DirectRawSwapInput Aw Xw1 [leg1-out-w] [op-w] ip-w i-prec-w Ww)
            )
        )
        ;;C3 status: the STABLE-pool bias above is now fully closed (exact, see UC_IntPow in 12_U_SWP.pact).
        ;;The WEIGHTED-pool leg is NOT — Pact's native <^> silently loses precision on the required
        ;;fractional exponent (<weight>), which cannot be worked around with an exact-multiplication trick
        ;;the way the stable-pool integer exponents were. Accepted as a bounded, documented limitation
        ;;(Audit/SWP/ROUND-02-FIXES.md Fix #3) rather than an open bug — this assertion is a REGRESSION
        ;;bound, not a "must be zero" check: it fails only if the bias ever grows beyond generous headroom
        ;;over float64's own ~2.2e-16 relative epsilon (the observed bias here is ~1.8e-16 relative).
        (weighted-relative-tolerance:decimal 0.000000001)
        (weighted-bias:decimal (abs (- leg2-out-w leg1-input-w)))
    )
    (map print
        [
            (format "STABLE  {} DLK -> {} OURO -> {} DLK (round trip)" [leg1-input-s leg1-out-s leg2-out-s])
            (format "STABLE INVERSE check: needs {} DLK in to get {} OURO out (direct used {})"
                [inverse-check-s leg1-out-s leg1-input-s])
            (format "WEIGHTED {} DLK -> {} OURO -> {} DLK (round trip, bias={})"
                [leg1-input-w leg1-out-w leg2-out-w weighted-bias])
            (expect "C3 reproduction — stable-pool zero-fee round trip does not profit the trader"
                true (<= leg2-out-s leg1-input-s))
            (expect "C3 reproduction — stable-pool inverse quote never requires less than the direct input"
                true (>= inverse-check-s leg1-input-s))
            (expect "C3 accepted limitation — weighted-pool round-trip bias stays within float64-noise bound (Fix #3)"
                true (<= weighted-bias (* leg1-input-w weighted-relative-tolerance)))
        ]
    )
)
(print "")
(print "")
;;==== SWP|TX 017 - C3 Reproduction: Zero-Fee Round-Trip Rounding Bias · 03 · gas echo ==== ===========
(print "--- [SWP|TX 017 - C3 Reproduction: Zero-Fee Round-Trip Rounding Bias · 03 · gas echo] ---")
(format "<<<<<<<SWP|TX 017 C3 Reproduction ==> {} KDA GAS>>>>>>>" [(env-gas)])
(print "")
(print "")
(print "===^^^===")
(env-sigs [])
(commit-tx)
