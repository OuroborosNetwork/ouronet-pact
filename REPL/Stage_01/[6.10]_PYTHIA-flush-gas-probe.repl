;; REPL/Stage_01/[6.10]_PYTHIA-flush-gas-probe.repl — measure max batch size under ~2M gas
;;
;; Strategy:
;; 1) Load the canonical Stage01 environment + PYTHIA ledger V2.
;; 2) Insert N distinct open calendar-day rows in one A_Flush call.
;; 3) Record (env-gas) used by each probe tx.
;; 4) Pick the largest N where gas-used <= 2_000_000.
;;

(print "")
(print "================================================================")
(print "FILE  REPL/Stage_01/[6.10]_PYTHIA-flush-gas-probe.repl")
(print "================================================================")

(load "../Stage00_Sanboxes.repl")
(load "../Stage01_Tester.repl")
(load "[6.10]_PYTHIA.repl")

(print "")
(print "=== Gas probe: A_Flush insert-path, N=open days, env-gaslimit=10M ===")

(defun mk-probe-entries
    (start:integer
        n:integer
        petitions:integer
        pondus:decimal
        transactions:integer
        gas-reserved:integer
        failed-transactions:integer
        wasted-gas-reserved:integer
    )
    (map
        (lambda (d:integer)
            {
                "day": d
                , "iz-complete": false
                , "petitions": petitions
                , "pondus": pondus
                , "transactions": transactions
                , "gas-reserved": gas-reserved
                , "failed-transactions": failed-transactions
                , "wasted-gas-reserved": wasted-gas-reserved
            }
        )
        (enumerate start (+ start (- n 1)))
    )
)

(defun mk-probe-entries-ic
    (start:integer
        n:integer
        iz-complete:bool
        petitions:integer
        pondus:decimal
        transactions:integer
        gas-reserved:integer
        failed-transactions:integer
        wasted-gas-reserved:integer
    )
    (map
        (lambda (d:integer)
            {
                "day": d
                , "iz-complete": iz-complete
                , "petitions": petitions
                , "pondus": pondus
                , "transactions": transactions
                , "gas-reserved": gas-reserved
                , "failed-transactions": failed-transactions
                , "wasted-gas-reserved": wasted-gas-reserved
            }
        )
        (enumerate start (+ start (- n 1)))
    )
)

;; Sweep N around the current tuned cap.
;; Values are explicit so we can eyeball the crossing point in output.

(defconst PROBE-GAS-LIMIT:integer 2000000)

;; TX-PG-00
(begin-tx "TX-PG-00 A_Flush inserts N=20 open days")
(namespace "ouronet-ns")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(env-sigs [{ "key": "PK_AncientHodler", "caps": [] }])
(let
    (
        (ref-TS01-C4:module{TalosStageOne_ClientFourV8} TS01-C4)
        (n:integer 20)
        (start:integer 100000)
        (entries:[object{PythiaLedgerV3.PYTHIA|S|PythFlushEntry}]
            (mk-probe-entries start n 1 1.234 1 1 0 0)
        )
        (msg:string (ref-TS01-C4::PYTHIA|A_Flush entries))
        (gas-used:integer (env-gas))
    )
    (print (format "<TX-PG-00> n={} gas-used={} <=2M? {} => {}"
        [n gas-used (<= gas-used PROBE-GAS-LIMIT) msg]))
)
(commit-tx)

;; TX-PG-01
(begin-tx "TX-PG-01 A_Flush inserts N=21 open days")
(namespace "ouronet-ns")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(env-sigs [{ "key": "PK_AncientHodler", "caps": [] }])
(let
    (
        (ref-TS01-C4:module{TalosStageOne_ClientFourV8} TS01-C4)
        (n:integer 21)
        (start:integer 101000)
        (entries:[object{PythiaLedgerV3.PYTHIA|S|PythFlushEntry}]
