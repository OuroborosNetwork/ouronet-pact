;;
;; REPL/Stage_01/[6.12]_DALOS-ADMIN.repl — DALOS admin-toggle coverage (#79 Phase 2)
;;   Covers the uncovered global-config admin ops: DALOS|A_ToggleGAP, ToggleOAPU, SetAutoFueling,
;;   SetIgnisSourcePrice. Each is exercised idempotently — read the current value, then set the flag
;;   to that same value — so the write path is covered with ZERO net state change (safe to run in the
;;   shared Z.repl pipeline before Stage 2). MigrateLiquidFunds is intentionally excluded (it moves
;;   liquid funds and has no safe idempotent form).
;;
(print "")
(print "================================================================")
(print "FILE  REPL/Stage_01/[6.12]_DALOS-ADMIN.repl  (DALOS admin toggles)")
(print "================================================================")
(print "")

;;================================================================================
(begin-tx "TX-DA-001 - DALOS admin toggles idempotent set-to-current (coverage)")
(namespace "ouronet-ns")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
;;==== TX-DA-001 · 01 · env-sigs (admin keyset) ====
(print "--- [TX-DA-001 · 01 · env-sigs] ---")
;;==== TX-DA-001 - DALOS admin toggles idempotent set-to-current (coverage) · 01 · env-sigs (caps) ==== 
(print "--- [TX-DA-001 - DALOS admin toggles idempotent set-to-current (coverage) · 01 · env-sigs (caps)] ---")
(env-sigs [ { "key": "PK_AncientHodler", "caps": [] } ])
;;==== TX-DA-001 · 02 · read current global config, set each to itself ====
(print "--- [TX-DA-001 · 02 · idempotent admin toggles] ---")
;;==== TX-DA-001 - DALOS admin toggles idempotent set-to-current (coverage) · 02 · let / invocation ==== 
(print "--- [TX-DA-001 - DALOS admin toggles idempotent set-to-current (coverage) · 02 · let / invocation] ---")
(let
    (
        (ref-DALOS:module{OuronetDalosV2} DALOS)
        (ref-TS01-A:module{TalosStageOne_AdminV2} TS01-A)
    )
    (let
        (
            (gap0:bool (ref-DALOS::UR_GAP))
            (oapu0:bool (ref-DALOS::UR_OuroAutoPriceUpdate))
            (autofuel0:bool (ref-DALOS::UR_AutoFuel))
            (ouro-price0:decimal (ref-DALOS::UR_OuroborosPrice))
        )
        ;; ToggleGAP enforces the value must CHANGE — flip to the opposite then flip back (net zero)
        (ref-TS01-A::DALOS|A_ToggleGAP (not gap0))
        (ref-TS01-A::DALOS|A_ToggleGAP gap0)
        ;; the rest are plain setters (no enforce-difference) — set each to its current value, no change
        (ref-TS01-A::DALOS|A_ToggleOAPU oapu0)
        (ref-TS01-A::DALOS|A_SetAutoFueling autofuel0)
        (ref-TS01-A::DALOS|A_SetIgnisSourcePrice ouro-price0)
        ;; prove the idempotency (values unchanged) — batch the expects so every line prints
        (map print
            [
                (expect (format "<<TX-DA-001>> GAP unchanged (={})" [gap0]) gap0 (ref-DALOS::UR_GAP))
                (expect (format "<<TX-DA-001>> OAPU unchanged (={})" [oapu0]) oapu0 (ref-DALOS::UR_OuroAutoPriceUpdate))
                (expect (format "<<TX-DA-001>> AutoFuel unchanged (={})" [autofuel0]) autofuel0 (ref-DALOS::UR_AutoFuel))
                (expect (format "<<TX-DA-001>> OURO price unchanged (={})" [ouro-price0]) ouro-price0 (ref-DALOS::UR_OuroborosPrice))
                ""
            ]
        )
    )
)
(print "===^^^===")
(commit-tx)
(print "")
;;||>>>>>>>>>>>>>>>>>>>>>>>>>
;;|| NEXT                   >
;;||>>>>>>>>>>>>>>>>>>>>>>>>>
(print "")
(begin-tx "TX-DA-002 - P|A_Add: the named-policy lane, and where it is inert")
(namespace "ouronet-ns")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(print "=== TX-DA-002 - P|A_Add on a Talos module ===============================")
;;==== TX-DA-002 · 01 · P|A_Add round-trip ==== ====================================================
(print "--- [TX-DA-002 · 01 · P|A_Add round-trip] ---")
;; P|A_Add is OuronetPolicyV2 boilerplate: every module that implements the interface has one,
;; all 11 Talos modules included. It writes a NAMED guard into P|T, whose only reader is P|UR.
;;
;; It was the last never-exercised admin entrypoint on the Talos contract, and measuring WHY is
;; the point of this test. Across the whole tree there are 26 ::P|A_Add call sites; every one
;; targets a CORE module (AQP-POOL, ATS, DALOS, DEMIPAD, DPDC, SWP, VST). None targets a Talos
;; module, and no Talos module ever calls its own P|UR. So on Talos the named-policy lane is
;; inert -- not by accident but by position: Talos is the top of the deploy graph, so it is the
;; thing that registers INTO others, never the thing others register into.
;;
;; Contrast the SIBLING lane, which is live on Talos: TS02-CPAD's P|A_Define calls
;; TS01-A::P|A_AddIMP so the launchpad wrappers' XB_DynamicFuelSTOA refuel passes P|UEV_IMC.
;; The IMP list is load-bearing on TS01-A; the named table is not. They are easy to conflate --
;; the only cross-module P|UR reads in the tree are AQP-BOOT's two "RemoteAqpGov" lookups.
;;
;; So this asserts the mechanism works when invoked, and pins the reason it never is.
(env-data
    { "P_ADD_TEST_KS"  : { "keys": ["PK_Emma"], "pred": "keys-all" }
    , "P_ADD_TEST_KS2" : { "keys": ["PK_Lumy"], "pred": "keys-all" } }
)
;;==== TX-DA-002 - P|A_Add: the named-policy lane, and where it is inert · 01 · env-sigs (caps) ==== 
(print "--- [TX-DA-002 - P|A_Add: the named-policy lane, and where it is inert · 01 · env-sigs (caps)] ---")
(env-sigs [{ "key": "PK_AncientHodler", "caps": [] }])
;;==== TX-DA-002 - P|A_Add: the named-policy lane, and where it is inert · 02 · let / invocation ==== 
(print "--- [TX-DA-002 - P|A_Add: the named-policy lane, and where it is inert · 02 · let / invocation] ---")
(let
    (
        (ref-P|TS01-A:module{OuronetPolicyV2} TS01-A)
        (g:guard (read-keyset "P_ADD_TEST_KS"))
    )
    (map print
        [
            ;;P|UR is a HARD read: before the write there is no row, and the lookup aborts
            ;;rather than returning a null guard. Any future Talos code that starts consulting
            ;;a named policy must therefore register it at deploy time or it will abort here.
            (expect-failure "<<TX-DA-002>> P|UR aborts on an unregistered policy name"
                "No value found in table"
                (ref-P|TS01-A::P|UR "TEST|NeverRegistered"))
        ]
    )
    (ref-P|TS01-A::P|A_Add "TEST|Policy" g)
    (map print
        [
            (expect "<<TX-DA-002>> P|A_Add stored the guard P|UR reads back"
                g (ref-P|TS01-A::P|UR "TEST|Policy"))
        ]
    )
    ;;LAST-WRITE-WINS: P|A_Add uses `write`, not `insert`, so re-registering an EXISTING name
    ;;silently REPLACES the guard -- there is no "already registered" rejection. Proven by
    ;;registering a DIFFERENT guard under the SAME name and reading the new one back. For a
    ;;table of authorization guards this is a real property, not a detail: whoever holds the
    ;;module admin key can REPOINT an existing named policy, not merely add new ones. On Talos
    ;;that is harmless (nothing reads P|T); on AQP-POOL, whose "FVT|RemoteAqpGov" /
    ;;"VCT|RemoteAqpGov" entries ARE read by AQP-BOOT, the same call is a governance repoint.
    (ref-P|TS01-A::P|A_Add "TEST|Policy" (read-keyset "P_ADD_TEST_KS2"))
    (map print
        [
            (expect "<<TX-DA-002>> re-registering the SAME name replaced the guard"
                (read-keyset "P_ADD_TEST_KS2") (ref-P|TS01-A::P|UR "TEST|Policy"))
            (expect "<<TX-DA-002>> ...and the original guard is gone, not merged"
                false (= g (ref-P|TS01-A::P|UR "TEST|Policy")))
        ]
    )
    ""
)
(commit-tx)
(print "")
;;||>>>>>>>>>>>>>>>>>>>>>>>>>
;;|| NEXT                   >
;;||>>>>>>>>>>>>>>>>>>>>>>>>>
(print "")
(begin-tx "TX-DA-002b - P|A_Add rejects a non-admin")
(namespace "ouronet-ns")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(print "=== TX-DA-002b - P|A_Add admin gate ====================================")
;;==== TX-DA-002b · 01 · admin gate ==== ===========================================================
(print "--- [TX-DA-002b · 01 · admin gate] ---")
;; Given last-write-wins above, the ONLY thing standing between an attacker and repointing a
;; named policy guard is GOV|TS01-A_ADMIN (dh_master-keyset). Worth an explicit assertion.
(env-data
    { "P_ADD_TEST_KS": { "keys": ["PK_Emma"], "pred": "keys-all" } }
)
;;==== TX-DA-002b - P|A_Add rejects a non-admin · 01 · env-sigs (caps) ==== =======================
(print "--- [TX-DA-002b - P|A_Add rejects a non-admin · 01 · env-sigs (caps)] ---")
(env-sigs [{ "key": "PK_Emma", "caps": [] }])
;;==== TX-DA-002b - P|A_Add rejects a non-admin · 02 · let / invocation ==== ======================
(print "--- [TX-DA-002b - P|A_Add rejects a non-admin · 02 · let / invocation] ---")
(let
    (
        (ref-P|TS01-A:module{OuronetPolicyV2} TS01-A)
    )
    (map print
        [
            (expect-failure "<<TX-DA-002b>> a non-Demiurgos cannot register a named policy"
                "Keyset failure (keys-any): [PK_Ancie..., PK_Flore...]"
                (ref-P|TS01-A::P|A_Add "TEST|Hijack" (read-keyset "P_ADD_TEST_KS")))
            (expect-failure "<<TX-DA-002b>> ...and the rejected name was never written"
                "No value found in table"
                (ref-P|TS01-A::P|UR "TEST|Hijack"))
        ]
    )
    ""
)
(env-sigs [])
(commit-tx)
(print "")
;;||>>>>>>>>>>>>>>>>>>>>>>>>>
;;|| NEXT                   >
;;||>>>>>>>>>>>>>>>>>>>>>>>>>
(print "")
(begin-tx "TX-DA-003 - the account rotations, billed through Talos")
(namespace "ouronet-ns")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(print "=== TX-DA-003 - DALOS rotations via Talos ==============================")
;;==== TX-DA-003 · 01 · rotate the attached STOA address ==== ======================================
(print "--- [TX-DA-003 · 01 · rotate the attached STOA address] ---")
;; The three rotations control who owns an Ouronet account and which STOA address pays for it.
;; [2.1]_Dalos already exercises the CORE functions (ref-DALOS::C_RotateGuard and friends), so
;; their behaviour is covered -- but nothing had ever gone through the TALOS entrypoints, which
;; means the IGNIS billing leg on all three had never executed once:
;;
;;      (ref-DALOS::C_RotateStoa account stoa)
;;      (ref-IGNIS::C_Collect patron (ref-IGNIS::DALOS|URCi_RotateStoa account))   <-- never run
;;
;; Billing is the entire reason the Talos layer exists, so "the core function works" is not the
;; same claim as "the client path works". Each rotation below asserts BOTH: the state change,
;; and that the IGNIS actually collected equals what the URCi_ cost reader predicts. That
;; preview-vs-exec equality is the invariant a desync breaks -- the same class of defect as the
;; SWPI|URCi_Issue under-charge (#76), which sat undetected because no test compared the two.
;;==== TX-DA-003 - the account rotations, billed through Talos · 01 · env-sigs (caps) ==== ========
(print "--- [TX-DA-003 - the account rotations, billed through Talos · 01 · env-sigs (caps)] ---")
(env-sigs [{ "key": "PK_AncientHodler", "caps": [] } { "key": "PK_Emma", "caps": [] }])
;;==== TX-DA-003 - the account rotations, billed through Talos · 02 · let / invocation ==== =======
(print "--- [TX-DA-003 - the account rotations, billed through Talos · 02 · let / invocation] ---")
(let
    (
        (ref-DALOS:module{OuronetDalosV2} DALOS)
        (ref-IGNIS:module{IgnisCollectorV3} IGNIS)
        (ref-DPTF:module{DemiourgosPactTrueFungibleV2} DPTF)
        (ref-TS01-C1:module{TalosStageOne_ClientOneV2} TS01-C1)
        (emma:string KST.EMMA)
        (patron:string KST.ANHD)
    )
    (let
        (
            (ignis-id:string (ref-DALOS::UR_IgnisID))
            (stoa-before:string (ref-DALOS::UR_AccountStoa KST.EMMA))
            (new-stoa:string KC.KADN_NAME_000d)
        )
        (let
            (
                (fuel-before:decimal (ref-DPTF::UR_AccountSupply ignis-id patron))
                ;;The cost reader IS the single source of truth the exec path bills from; read
                ;;it before the call so the comparison cannot be circular.
                (quoted:decimal
                    (at "ignis" (at 0 (at "cumulator-chain" (ref-IGNIS::DALOS|URCi_RotateStoa emma)))))
            )
            (let
                (
                    (msg:string (ref-TS01-C1::DALOS|C_RotateStoa patron emma new-stoa))
                )
                (map print
                    [
                        (expect "<<TX-DA-003>> C_RotateStoa names the account in its result"
                            (format "Ouronet Account {} Attached Stoa-Address rotated succesfully!" [emma]) msg)
                        (expect "<<TX-DA-003>> the attached STOA address actually changed"
                            new-stoa (ref-DALOS::UR_AccountStoa emma))
                        (expect "<<TX-DA-003>> ...and it is not the old one"
                            false (= stoa-before (ref-DALOS::UR_AccountStoa emma)))
                        ;;THE BILLING LEG, first execution ever -- and it does NOT charge the
                        ;;quoted number. The cost model has TWO layers, and this is where they
                        ;;meet:
                        ;;
                        ;;    URCi_ quote     = the RAW cost definition            (34.0 here)
                        ;;    charged         = raw x URC_IgnisGasDiscount(patron) (18.02 here)
                        ;;
                        ;;UDC_PrimeIgnisCumulator applies the patron discount inside C_Collect.
                        ;;My first version of this assertion compared the charge to the RAW quote
                        ;;and failed; I briefly wrote that up as a client-facing defect before
                        ;;checking the presentation layer, which turns out to model it correctly:
                        ;;OI|UDC_ClientIgnisCosts carries ignis-full, ignis-discount AND
                        ;;ignis-need = discount x full, plus generated text naming the percentage.
                        ;;So there is no defect -- URCi_ is a cost DEFINITION and INFO_ is the
                        ;;patron quote. Recording the distinction here because getting it backwards
                        ;;is the natural mistake, and this is the only test that pins the join.
                        ;;
                        ;;GAP, separately: the DALOS rotations have NO INFO_ preview at all, unlike
                        ;;INFO_DPTF|RotateOwnership / INFO_DPOF|RotateOwnership. Not a defect in
                        ;;what exists, but the client-facing preview surface is incomplete here.
                        (expect "<<TX-DA-003>> INVARIANT: charged == URCi quote x the patron's ignis discount"
                            (- fuel-before (* quoted (ref-DALOS::URC_IgnisGasDiscount patron)))
                            (ref-DPTF::UR_AccountSupply ignis-id patron))
                        ;;And the raw quote is the price-sheet entry, not an independent number.
                        (expect "<<TX-DA-003>> the quote IS UC_IgnisPrice(DALOS|C_RotateStoa, auth)"
                            (ref-IGNIS::UC_IgnisPrice "DALOS|C_RotateStoa" "auth") quoted)
                        ;;The discount is real and non-trivial for this patron, so the assertion
                        ;;above is genuinely distinguishing the two models rather than passing
                        ;;because the factor happens to be 1.0.
                        (expect "<<TX-DA-003>> the patron's discount is a real reduction, not 1.0"
                            true (< (ref-DALOS::URC_IgnisGasDiscount patron) 1.0))
                    ]
                )
                ""
            )
        )
    )
)
;;==== TX-DA-003 · 02 · restore, and prove the rotation is reversible ==== =========================
(print "--- [TX-DA-003 · 02 · restore, and prove the rotation is reversible] ---")
;;Metamorphic: rotate back and assert the ORIGINAL value returns. A one-way test would pass
;;just as well against an op that wrote a constant.
(let
    (
        (ref-DALOS:module{OuronetDalosV2} DALOS)
        (ref-TS01-C1:module{TalosStageOne_ClientOneV2} TS01-C1)
    )
    (ref-TS01-C1::DALOS|C_RotateStoa KST.ANHD KST.EMMA KC.KADN_NAME_000b)
    (map print
        [
            (expect "<<TX-DA-003>> rotating back restores EMMA's original STOA address"
                KC.KADN_NAME_000b (ref-DALOS::UR_AccountStoa KST.EMMA))
        ]
    )
    ""
)
;;==== TX-DA-003 · 03 · rotate the primary guard ==== ==============================================
(print "--- [TX-DA-003 · 03 · rotate the primary guard] ---")
;;<safe> true additionally ENFORCES the incoming guard, so only a guard the caller can satisfy
;;right now can be installed -- the anti-footgun that stops an account being rotated into a
;;guard nobody holds. Exercised in the true direction here; [2.1]_Dalos covers the guard-TYPE
;;rejections (u:, c:, r: prefixes) on the core function.
(env-sigs [{ "key": "PK_AncientHodler", "caps": [] } { "key": "PK_Emma", "caps": [] }])
(let
    (
        (ref-DALOS:module{OuronetDalosV2} DALOS)
        (ref-IGNIS:module{IgnisCollectorV3} IGNIS)
        (ref-DPTF:module{DemiourgosPactTrueFungibleV2} DPTF)
        (ref-TS01-C1:module{TalosStageOne_ClientOneV2} TS01-C1)
        (emma:string KST.EMMA)
        (patron:string KST.ANHD)
    )
    (let
        (
            (ignis-id:string (ref-DALOS::UR_IgnisID))
            (guard-before:guard (ref-DALOS::UR_AccountGuard KST.EMMA))
            (new-guard:guard (keyset-ref-guard "ouronet-ns.us-0001_emma-keyset"))
        )
        (let
            (
                (fuel-before:decimal (ref-DPTF::UR_AccountSupply ignis-id patron))
                (quoted:decimal
                    (at "ignis" (at 0 (at "cumulator-chain" (ref-IGNIS::DALOS|URCi_RotateGuard emma)))))
            )
            (let
                (
                    (msg:string (ref-TS01-C1::DALOS|C_RotateGuard patron emma new-guard true))
                )
                (map print
                    [
                        (expect "<<TX-DA-003>> C_RotateGuard names the account in its result"
                            (format "Ouronet Account {} Primary-Guard rotated succesfully!" [emma]) msg)
                        (expect "<<TX-DA-003>> the primary guard is now the one supplied"
                            new-guard (ref-DALOS::UR_AccountGuard emma))
                        (expect "<<TX-DA-003>> INVARIANT: charged == URCi quote x the patron's ignis discount"
                            (- fuel-before (* quoted (ref-DALOS::URC_IgnisGasDiscount patron)))
                            (ref-DPTF::UR_AccountSupply ignis-id patron))
                        (expect "<<TX-DA-003>> the quote IS UC_IgnisPrice(DALOS|C_RotateGuard, auth)"
                            (ref-IGNIS::UC_IgnisPrice "DALOS|C_RotateGuard" "auth") quoted)
                    ]
                )
                ""
            )
        )
    )
)
;;==== TX-DA-003 · 04 · rotate the SOVEREIGN of a smart account ==== ===============================
(print "--- [TX-DA-003 · 04 · rotate the SOVEREIGN of a smart account] ---")
;;The heaviest of the three: the sovereign IS the controlling identity of a SMART account, so
;;this transfers control outright. Three preconditions in DALOS|S>ROTATE-OA-SOVEREIGN:
;;  - the caller owns <account>            (CAP_EnforceAccountOwnership -- the CURRENT sovereign)
;;  - <account> is SMART                   (UEV_EnforceAccountType account true)
;;  - <new-sovereign> is STANDARD          (UEV_EnforceAccountType new-sovereign false)
;;  - and differs from the current one     (UEV_SenderWithReceiver)
;;BJ is the suite's smart account, sovereign BM -- so BM signs, not ANHD.
(env-sigs [{ "key": "PK_AncientHodler", "caps": [] } { "key": "PK_BM", "caps": [] }])
(let
    (
        (ref-DALOS:module{OuronetDalosV2} DALOS)
        (ref-IGNIS:module{IgnisCollectorV3} IGNIS)
        (ref-DPTF:module{DemiourgosPactTrueFungibleV2} DPTF)
        (ref-TS01-C1:module{TalosStageOne_ClientOneV2} TS01-C1)
        (bj:string KC.BJ)
        (patron:string KST.ANHD)
    )
    (let
        (
            (ignis-id:string (ref-DALOS::UR_IgnisID))
            (sov-before:string (ref-DALOS::UR_AccountSovereign KC.BJ))
        )
        (let
            (
                (fuel-before:decimal (ref-DPTF::UR_AccountSupply ignis-id patron))
                (quoted:decimal
                    (at "ignis" (at 0 (at "cumulator-chain" (ref-IGNIS::DALOS|URCi_RotateSovereign bj)))))
            )
            (map print
                [
                    ;;State the precondition rather than assuming it: BJ must really be smart and
                    ;;BM must really be its sovereign, or the assertions below prove nothing.
                    (expect "<<TX-DA-003>> BJ is a SMART account (rotation only applies to smart)"
                        true (ref-DALOS::UR_AccountType bj))
                    (expect "<<TX-DA-003>> ...and BM is currently its sovereign"
                        KC.BM sov-before)
                ]
            )
            (let
                (
                    (msg:string (ref-TS01-C1::DALOS|C_RotateSovereign patron bj KST.EMMA))
                )
                (map print
                    [
                        (expect "<<TX-DA-003>> control of the smart account moved to the new sovereign"
                            KST.EMMA (ref-DALOS::UR_AccountSovereign bj))
                        (expect "<<TX-DA-003>> INVARIANT: charged == URCi quote x the patron's ignis discount"
                            (- fuel-before (* quoted (ref-DALOS::URC_IgnisGasDiscount patron)))
                            (ref-DPTF::UR_AccountSupply ignis-id patron))
                        (expect "<<TX-DA-003>> the quote IS UC_IgnisPrice(DALOS|C_RotateSovereign, auth)"
                            (ref-IGNIS::UC_IgnisPrice "DALOS|C_RotateSovereign" "auth") quoted)
                    ]
                )
                ""
            )
        )
    )
)
;;==== TX-DA-003 · 05 · the rotation really moved authority ==== ==================================
(print "--- [TX-DA-003 · 05 · the rotation really moved authority] ---")
;;A rotation that only rewrites a field is not a rotation. The test that matters is whether the
;;OLD sovereign has actually LOST control -- BM signing alone must no longer satisfy ownership
;;of BJ, and EMMA signing alone must now satisfy it. Both directions asserted, because either
;;one alone is compatible with a broken implementation (a field written but not consulted, or a
;;guard that accepts everyone).
(env-sigs [{ "key": "PK_AncientHodler", "caps": [] } { "key": "PK_BM", "caps": [] }])
(let
    (
        (ref-TS01-C1:module{TalosStageOne_ClientOneV2} TS01-C1)
    )
    (map print
        [
            ;;The message is a NAMED one -- "Smart DALOS Account <id> Ownership could not be
            ;;verified!" -- not a raw keyset failure. Worth noting as a positive: this is what
            ;;the PYTHIA and DEMIPAD findings earlier in this session were missing. Matched on
            ;;the stable tail because the account id in the middle is a 200-glyph string.
            (expect-failure "<<TX-DA-003>> the OLD sovereign can no longer rotate the account"
                "Ownership could not be verified!"
                (ref-TS01-C1::DALOS|C_RotateSovereign KST.ANHD KC.BJ KST.LUMY))
        ]
    )
    ""
)
;;Rule 9: the rejection above fires in CAP_EnforceAccountOwnership inside the defcap, before any
;;write -- asserted, not assumed.
(let
    (
        (ref-DALOS:module{OuronetDalosV2} DALOS)
    )
    (map print
        [
            (expect "<<TX-DA-003>> the rejected rotation left the sovereign unchanged"
                KST.EMMA (ref-DALOS::UR_AccountSovereign KC.BJ))
        ]
    )
    ""
)
;;And the NEW sovereign can: rotate back, restoring the suite's original state so nothing
;;downstream inherits a BJ owned by EMMA.
(env-sigs [{ "key": "PK_AncientHodler", "caps": [] } { "key": "PK_Emma", "caps": [] }])
(let
    (
        (ref-DALOS:module{OuronetDalosV2} DALOS)
        (ref-TS01-C1:module{TalosStageOne_ClientOneV2} TS01-C1)
    )
    (ref-TS01-C1::DALOS|C_RotateSovereign KST.ANHD KC.BJ KC.BM)
    (map print
        [
            (expect "<<TX-DA-003>> the NEW sovereign has real authority: it rotates control back"
                KC.BM (ref-DALOS::UR_AccountSovereign KC.BJ))
        ]
    )
    ""
)
(print "")
(print "===^^^===")
(env-sigs [])
(commit-tx)


;;|| NEXT >
