(env-sigs
    [
        { "key": "PK_AOZ", "caps": [] }
    ]
)
;;==== HOT-RBT Branding Proof 1|2 · 02 · let / invocation ==== ====================================
(print "--- [HOT-RBT Branding Proof 1|2 · 02 · let / invocation] ---")
;; #5C / C5 regression context: ATS|C>HOT-RBT-UPDATE-BRD / ATS|C>HOT-RBT-UPGRADE-BRD resolve the
;; owning ats-pair from the hot-rbt token (ref-DPOF::UR_RewardBearingToken) and enforce CAP_Owner on
;; THAT pair before composing ATS|GOV — proven here via a real owner-signed call succeeding.
