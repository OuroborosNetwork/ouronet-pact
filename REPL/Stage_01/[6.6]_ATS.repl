(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(namespace "ouronet-ns")
;;==== ToggleUpgrade Proof 2|2 · 01 · env-sigs (caps) ==== ========================================
(print "--- [ToggleUpgrade Proof 2|2 · 01 · env-sigs (caps)] ---")
(env-sigs
    [
        { "key": "PK_AOZ", "caps": [] }
    ]
)
;;==== ToggleUpgrade Proof 2|2 · 02 · let / invocation ==== =======================================
(print "--- [ToggleUpgrade Proof 2|2 · 02 · let / invocation — switch back ON, C_Control succeeds] ---")
(let
    (
        (ref-TS01-C2:module{TalosStageOne_ClientTwoV1} TS01-C2)
        (ref-ATS:module{AutostakeV2} ATS)
        (aoz:string KST.AOZT)
        (ps:string "PlebeicStrength-98c486052a51")
    )
    (ref-TS01-C2::ATS|C_ToggleUpgrade aoz ps true)
    (ref-TS01-C2::ATS|C_Control aoz ps false false false)
    (map print
        [
            (expect "can-upgrade is now true" true (ref-ATS::UR_CanUpgrade ps))
        ]
    )
)

