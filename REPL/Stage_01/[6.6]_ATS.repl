;; ================================================================================================
;; #22L test-coverage sweep — permanent proofs for the 12 ATS/ATSU config-surface functions that had
;; zero REPL coverage before this session (see Audit/ATS/HANDOFF-SESSION-RESUME.md §4-5). Each group
;; below targets exactly one (or one closely-related pair of) Talos client function(s), with explicit
;; before/after assertions rather than relying on "it didn't crash".
;; ================================================================================================
(begin-tx "ToggleUpgrade Proof 1|2")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(namespace "ouronet-ns")
;;==== ToggleUpgrade Proof 1|2 · 01 · env-sigs (caps) ==== ========================================
(print "--- [ToggleUpgrade Proof 1|2 · 01 · env-sigs (caps)] ---")
(env-sigs
    [
        { "key": "PK_AOZ", "caps": [] }
    ]
)
;;==== ToggleUpgrade Proof 1|2 · 02 · let / invocation ==== =======================================
(print "--- [ToggleUpgrade Proof 1|2 · 02 · let / invocation — switch OFF, C_Control must now fail] ---")
;; #21L / L3 regression: can-upgrade previously had no setter at all. ATS|C_ToggleUpgrade
;; (audit fix, 08_ATS.pact ATS|C>TOGGLE-UPGRADE / XI_ToggleUpgrade) gates ATS|C_Control via
;; UEV_CanUpgradeON — flipping it off must make C_Control fail with the "properties cannot be
;; upgraded" enforce, and flipping it back on (Proof 2|2) must let C_Control succeed again.
(let
    (
        (ref-TS01-C2:module{TalosStageOne_ClientTwoV1} TS01-C2)
        (ref-ATS:module{AutostakeV2} ATS)
        (aoz:string KST.AOZT)
        (ps:string "PlebeicStrength-98c486052a51")
    )
    (ref-TS01-C2::ATS|C_ToggleUpgrade aoz ps false)
    (map print
        [
            (expect "can-upgrade is now false" false (ref-ATS::UR_CanUpgrade ps))
            (expect-failure (format "{} properties cannot be upgraded" [ps])
                (ref-TS01-C2::ATS|C_Control aoz ps false false false)
            )
        ]
    )
)

(print "")
(print "")
;;==== ToggleUpgrade Proof 1|2 · 03 · gas echo ==== ================================================
(print "--- [ToggleUpgrade Proof 1|2 · 03 · gas echo] ---")
(format "<<<<<<<ToggleUpgrade Proof 1|2 {} GAS>>>>>>>" [(env-gas)])
(print "")
(print "")
(print "===^^^===")
(commit-tx)
;;||>>>>>>>>>>>>>>>>>>>>>>>>>
;;|| NEXT                   >
;;||>>>>>>>>>>>>>>>>>>>>>>>>>
(print "")
