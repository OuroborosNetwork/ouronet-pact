(print "--- [WithdrawRoyalties Proof · 03 · gas echo] ---")
(format "<<<<<<<WithdrawRoyalties Proof {} GAS>>>>>>>" [(env-gas)])
(print "")
(print "")
(print "===^^^===")
(commit-tx)
