(begin-tx "A_KickStart Proof")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(namespace "ouronet-ns")
;;==== A_KickStart Proof · 01 · env-sigs (caps) ==== ===============================================
(print "--- [A_KickStart Proof · 01 · env-sigs (caps)] ---")
;; ATS|A_RemoveSecondary / ATS|A_KickStart regression proof — the P|A_Define fix (01_TS01-A.pact):
;; ATS and ATSU were never registered as permitted callers there (ATS was even bound - ref-P|ATS -
;; but never used), so this admin path used to fail unconditionally inside ATSU's own UEV_IMC with
;; "None of the guards passed", regardless of who signed. "DemiourgosSithMasters" (keys-any over
;; PK_AncientHodler / PK_Florean) is the keyset behind both the Talos-level P|ADMINISTRATIVE-SUMMONER
;; gate and ATSU's own GOV|ATSU_ADMIN gate — PK_AncientHodler alone satisfies both. Also exercises
;; the #11M / M2 fix's shared floor/ceiling machinery (UC_KickStartIndex, ATSU|C>X_KICKSTART): the
;; admin path has no upper ceiling (unlike the owner-facing ATS|C_KickStart's 100.0 cap), only the
;; shared >= 0.1 floor. TestKickPair was issued fresh and never fueled/coiled, so its index is
;; still the -1.0 "un-kickstarted" sentinel — exactly the precondition ATSU|C>X_KICKSTART requires.
(env-sigs
    [
        { "key": "PK_AOZ", "caps": [] }
        { "key": "PK_AncientHodler", "caps": [] }
    ]
)
;;==== A_KickStart Proof · 02 · let / invocation ==== ==============================================
(print "--- [A_KickStart Proof · 02 · let / invocation] ---")
(let
    (
        (ref-TS01-A:module{TalosStageOne_AdminV1} TS01-A)
        (ref-ATS:module{AutostakeV2} ATS)
        (aoz:string KST.AOZT)
        (tkp:string "TestKickPair-98c486052a51")
    )
    (map print
        [
            (expect "TestKickPair index is -1.0 before KickStart (never fueled)" -1.0 (ref-ATS::URC_Index tkp))
        ]
    )
    (ref-TS01-A::ATS|A_KickStart aoz aoz tkp [1000.0] 1000.0)
    (map print
        [
            (expect "TestKickPair index is 1.0 after KickStart (1000.0 RT / 1000.0 RBT)" 1.0 (ref-ATS::URC_Index tkp))
        ]
    )
)

