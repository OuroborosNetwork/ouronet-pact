(begin-tx "Reverse (Recover) Proof")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(namespace "ouronet-ns")
;;==== Reverse (Recover) Proof · 01 · env-sigs (caps) ==== =========================================
(print "--- [Reverse (Recover) Proof · 01 · env-sigs (caps)] ---")
(env-sigs
    [
        { "key": "PK_AOZ", "caps": [] }
    ]
)
;;==== Reverse (Recover) Proof · 02 · let / invocation ==== ========================================
(print "--- [Reverse (Recover) Proof · 02 · let / invocation] ---")
;; ATS|C_Reverse (Talos, 03_TS01-C2.pact) forwards to ATSU's own C_Recover (10_ATSU.pact) — converts
;; a still-live Hot-RBT nonce back into an equivalent Cold-RBT position: burns the nonce, mints the
;; matching amount of the pair's cold-RBT (PDKOSON) straight to the recoverer. Mints a fresh nonce
;; (nonce 5 — nonces-used was 4 after the Repurpose proof's own internal mint) specifically for this,
;; separate from nonce 4 (now emma's, from Repurpose) and the already-redeemed nonces 1/2.
(let
    (
        (ref-TS01-C2:module{TalosStageOne_ClientTwoV1} TS01-C2)
        (ref-DPOF:module{DemiourgosPactOrtoFungibleV1} DPOF)
        (ref-DPTF:module{DemiourgosPactTrueFungibleV1} DPTF)
        (aoz:string KST.AOZT)
        (dd-k:string "DDKOSON-98c486052a51")
        (pd-k:string "PDKOSON-98c486052a51")
    )
    (ref-TS01-C2::ATS|C_HotRecovery aoz aoz "PlebeicStrength-98c486052a51" 15.0)
    (let
        (
            (nonce-5-supply:decimal (ref-DPOF::UR_NonceSupply dd-k 5))
            (pd-k-before:decimal (ref-DPTF::UR_AccountSupply pd-k aoz))
        )
        (map print
            [
                (expect "nonce 5 was minted to aoz" aoz (ref-DPOF::UR_NonceHolder dd-k 5))
            ]
        )
        (ref-TS01-C2::ATS|C_Reverse aoz aoz dd-k 5)
        (map print
            [
                (expect "nonce 5 burned — DPOF supply now the not-exists sentinel" -1.0 (ref-DPOF::UR_NonceSupply dd-k 5))
                (expect "aoz's PDKOSON (cold-RBT) balance grew by exactly nonce 5's supply"
                    (+ pd-k-before nonce-5-supply)
                    (ref-DPTF::UR_AccountSupply pd-k aoz)
                )
            ]
        )
    )
)

(print "")
(print "")
