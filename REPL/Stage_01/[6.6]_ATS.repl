    [
        { "key": "PK_AOZ", "caps": [] }
    ]
)
;;==== A_RemoveSecondary Proof 1|2 · 02 · let / invocation ==== ===================================
(print "--- [A_RemoveSecondary Proof 1|2 · 02 · let / invocation] ---")
;; X_RemoveSecondary (10_ATSU.pact) buys back the pool-level resident/unbonding/royalty (RUR 1/2/3)
;; sum for the removed RT via a TFT transfer — a zero remove-sum hits DPTF's own UEV_Amount
;; (amount > 0.0) enforce. A freshly-AddSecondary'd RT starts at a zero RUR sum, so it must be
;; Fueled (which needs TestKickPair's now-positive index from the KickStart above) before it can be
;; administratively removed below.
(let
    (
        (ref-TS01-C2:module{TalosStageOne_ClientTwoV1} TS01-C2)
        (ref-ATS:module{AutostakeV2} ATS)
        (aoz:string KST.AOZT)
        (tkp:string "TestKickPair-98c486052a51")
        (e-k:string "EKOSON-98c486052a51")
    )
    (ref-TS01-C2::ATS|C_AddSecondary aoz tkp e-k false)
    (map print
        [
            (expect "EKOSON is now a registered RT for TestKickPair" true (contains e-k (ref-ATS::UR_RewardTokenList tkp)))
        ]
    )
    (ref-TS01-C2::ATS|C_Fuel aoz aoz tkp e-k 50.0)
    (map print
        [
            (expect "EKOSON resident RUR is now nonzero (fueled)" true (> (at 1 (ref-ATS::UR_RewardTokenRUR tkp 1)) 0.0))
        ]
    )
)

