(begin-tx "HOT-RBT Repurpose Proof")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(namespace "ouronet-ns")
;;==== HOT-RBT Repurpose Proof · 01 · env-sigs (caps) ==== =========================================
(print "--- [HOT-RBT Repurpose Proof · 01 · env-sigs (caps)] ---")
(env-sigs
    [
        { "key": "PK_AOZ", "caps": [] }
    ]
)
;;==== HOT-RBT Repurpose Proof · 02 · let / invocation ==== ========================================
(print "--- [HOT-RBT Repurpose Proof · 02 · let / invocation] ---")
;; #22L core fix regression: C_HOT-RBT|Repurpose (08_ATS.pact) used to call
;; (ref-DPOF::UR_NonceMetaData) with zero arguments where it requires (id nonce) — an unconditional
;; crash on every call, never caught for lack of test coverage. This seizes nonce 3 (minted to aoz
;; in the SetHotRecoveryFee/HotRecovery proof above, still unredeemed) and reassigns an
;; equivalent-value replacement — a freshly-minted nonce carrying the SAME original mint-time
;; metadata — to emma. nonces-used was 3 going in, so the replacement is nonce 4.
(let
    (
        (ref-TS01-C2:module{TalosStageOne_ClientTwoV1} TS01-C2)
        (ref-DPOF:module{DemiourgosPactOrtoFungibleV1} DPOF)
        (aoz:string KST.AOZT)
        (emma:string KST.EMMA)
        (dd-k:string "DDKOSON-98c486052a51")
        (nonce-3-supply:decimal (ref-DPOF::UR_NonceSupply dd-k 3))
        (nonce-3-mint-time:time (at "mint-time" (at 0 (ref-DPOF::UR_NonceMetaData dd-k 3))))
    )
    (ref-TS01-C2::ATS|C_HOT-RBT|Repurpose aoz dd-k 3 emma)
    (map print
        [
            (expect "nonce 3 wiped — DPOF supply now the not-exists sentinel" -1.0 (ref-DPOF::UR_NonceSupply dd-k 3))
            (expect "nonce 4 (the replacement) exists with the same supply nonce 3 had"
                nonce-3-supply
                (ref-DPOF::UR_NonceSupply dd-k 4)
            )
            (expect "nonce 4 is held by emma (the repurpose-to account)" emma (ref-DPOF::UR_NonceHolder dd-k 4))
            (expect "nonce 4 carries forward nonce 3's original mint-time"
                nonce-3-mint-time
                (at "mint-time" (at 0 (ref-DPOF::UR_NonceMetaData dd-k 4)))
            )
        ]
    )
)

(print "")
(print "")
;;==== HOT-RBT Repurpose Proof · 03 · gas echo ==== =================================================
(print "--- [HOT-RBT Repurpose Proof · 03 · gas echo] ---")
(format "<<<<<<<HOT-RBT Repurpose Proof {} GAS>>>>>>>" [(env-gas)])
(print "")
(print "")
(print "===^^^===")
(commit-tx)
