(begin-tx "DirectRecovery Proof")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(namespace "ouronet-ns")
;;==== DirectRecovery Proof · 01 · env-sigs (caps) ==== =============================================
(print "--- [DirectRecovery Proof · 01 · env-sigs (caps)] ---")
(env-sigs
    [
        { "key": "PK_AOZ", "caps": [] }
    ]
)
;;==== DirectRecovery Proof · 02 · let / invocation ==== ============================================
(print "--- [DirectRecovery Proof · 02 · let / invocation] ---")
;; ATS|C>DIRECT_RECOVERY requires Direct Recovery to be switched ON first (never toggled for ps
;; elsewhere in this file — only for KoriID, in [4.0]_Sovereign-Executor.repl). ps's direct-recovery
;; fee (d-promile) was never set, so it's still the 0.0 default — the fee-free branch of
;; C_DirectRecovery burns <ra> of the cold-RBT and releases the equivalent value in reward tokens
;; (via the pool's current index, URC_RTSplitAmounts — NOT a flat 1:1, since ps's index has moved
;; well off its 1.0 genesis value from all the Coil/Cull/fee activity earlier in this file), split
;; proportionally across ps's reward-token list.
(let
    (
        (ref-TS01-C2:module{TalosStageOne_ClientTwoV1} TS01-C2)
        (ref-ATS:module{AutostakeV2} ATS)
        (ref-DPTF:module{DemiourgosPactTrueFungibleV1} DPTF)
        (aoz:string KST.AOZT)
        (ps:string "PlebeicStrength-98c486052a51")
        (pd-k:string "PDKOSON-98c486052a51")
    )
    (ref-TS01-C2::ATS|C_SwitchDirectRecovery aoz ps true)
    (let
        (
            (rt-lst:[string] (ref-ATS::UR_RewardTokenList ps))
            (pd-k-before:decimal (ref-DPTF::UR_AccountSupply pd-k aoz))
            (ra:decimal 10.0)
            (expected-release-sum:decimal (fold (+) 0.0 (ref-ATS::URC_RTSplitAmounts ps 10.0)))
        )
        (let
            (
                (rt-before:[decimal] (map (lambda (id:string) (ref-DPTF::UR_AccountSupply id aoz)) rt-lst))
            )
            (ref-TS01-C2::ATS|C_DirectRecovery aoz aoz ps ra)
            (let
                (
                    (rt-after:[decimal] (map (lambda (id:string) (ref-DPTF::UR_AccountSupply id aoz)) rt-lst))
                    (rt-delta-sum:decimal
                        (fold (+) 0.0 (zip (-) rt-after rt-before))
                    )
                )
                (map print
                    [
                        (format "ra={}, pool index-derived expected release={}" [ra expected-release-sum])
                        (expect "aoz's PDKOSON (cold-RBT) balance shrank by exactly ra"
                            (- pd-k-before ra)
                            (ref-DPTF::UR_AccountSupply pd-k aoz)
                        )
                        (expect "released reward-tokens sum to the index-derived expected value (zero direct-recovery fee)"
                            expected-release-sum
                            rt-delta-sum
                        )
                    ]
                )
            )
        )
    )
)

