(begin-tx "HOT-RBT Branding Proof 2|2 - UpgradeBranding")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(namespace "ouronet-ns")
;;==== HOT-RBT Branding Proof 2|2 · 01 · env-sigs (caps) ==== =====================================
(print "--- [HOT-RBT Branding Proof 2|2 · 01 · env-sigs (caps)] ---")
;; C_HOT-RBT|UpgradeBranding -> DPOF::C_UpgradeBranding -> IGNIS::STOA|C_CollectWT -> real coin.TRANSFER
;; (price key "blue", same URC_SplitSTOAPrices 4-way split / 4-target pattern as every other raw-STOA
;; payment in this file), followed by TS01-A::XB_DynamicFuelSTOA.
(let
    (
        (ref-DALOS:module{OuronetDalosV1} DALOS)
        (aoz:string KST.AOZT)
        (months:integer 1)
        (split-stoa:[decimal]
            (ref-DALOS::URC_SplitSTOAPrices aoz (* (dec months) (ref-DALOS::UR_UsagePrice "blue")))
        )
    )
    (env-sigs
        [
            { "key": "PK_AOZ", "caps": [] }
            { "key": "95a59029029524ebb250b2fafe6826ff88bb59c527d661cba3279d09a51d3bdf" ,
              "caps":
                [
                    (coin.TRANSFER
                        "k:95a59029029524ebb250b2fafe6826ff88bb59c527d661cba3279d09a51d3bdf"
                        "k:50d6c59b21e5e6e55baecaa75a1007de37576bde12d8230dc82459cc01b9484b"
                        (at 2 split-stoa)
                    )
                    (coin.TRANSFER
                        "k:95a59029029524ebb250b2fafe6826ff88bb59c527d661cba3279d09a51d3bdf"
                        "k:0cb30c0121ff919266121a99ff9359871818932211df94dae4137c29bc0e8f7e"
                        (at 0 split-stoa)
                    )
                    (coin.TRANSFER
                        "k:95a59029029524ebb250b2fafe6826ff88bb59c527d661cba3279d09a51d3bdf"
                        "c:XM-pkmuB5XUQlp87ZYSbfKt8qzmHY6O2EHAzMRVBt3k"
                        (at 3 split-stoa)
                    )
                    (coin.TRANSFER
                        "k:95a59029029524ebb250b2fafe6826ff88bb59c527d661cba3279d09a51d3bdf"
                        "c:iQQFWj6gWtpGEzhM_O5ekW1QtnQQy55R8BRPGhj_0FU"
                        (at 1 split-stoa)
                    )
                ]
            }
        ]
    )
;;==== HOT-RBT Branding Proof 2|2 · 02 · let / invocation ==== ====================================
    (print "--- [HOT-RBT Branding Proof 2|2 · 02 · let / invocation] ---")
    (let
        (
            (ref-TS01-C2:module{TalosStageOne_ClientTwoV1} TS01-C2)
            (ref-BRD:module{BrandingV1} BRD)
            (dd-k:string "DDKOSON-98c486052a51")
            (flag-before:integer (ref-BRD::UR_Flag dd-k false))
        )
        (ref-TS01-C2::ATS|C_HOT-RBT|UpgradeBranding aoz dd-k months)
        (map print
            [
                (format "flag was {} (3 = Gray) before upgrade" [flag-before])
                (expect "live flag is now 1 (Blue)" 1 (ref-BRD::UR_Flag dd-k false))
                (expect "live branding promoted from pending on Gray->Blue upgrade"
                    "Denarius Debilis Hot-RBT test branding"
                    (ref-BRD::UR_Description dd-k false)
                )
            ]
        )
    )
)

