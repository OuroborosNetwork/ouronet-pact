(begin-tx "SetHibernationFees Proof")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(namespace "ouronet-ns")
;;==== SetHibernationFees Proof · 01 · env-sigs (caps) ==== =======================================
(print "--- [SetHibernationFees Proof · 01 · env-sigs (caps)] ---")
(env-sigs
    [
        { "key": "PK_AOZ", "caps": [] }
    ]
)
;;==== SetHibernationFees Proof · 02 · let / invocation ==== ======================================
(print "--- [SetHibernationFees Proof · 02 · let / invocation] ---")
;; #9H/#10M regression: UEV_HibernationFees (09_U_ATS.pact) used to fail unconditionally on every
;; input (stray `(= () 0.0)` 7th predicate, always false). Proves the full ATS|C_SetHibernationFees
;; capability chain (ATS|S>SET-HIBERNATION-FEES -> ref-U|ATS::UEV_HibernationFees) now accepts a
;; valid (peak, decay) pair and persists it.
(let
    (
        (ref-TS01-C2:module{TalosStageOne_ClientTwoV1} TS01-C2)
        (ref-ATS:module{AutostakeV2} ATS)
        (aoz:string KST.AOZT)
        (ps:string "PlebeicStrength-98c486052a51")
        (peak-before:decimal (ref-ATS::UR_PeakHibernatePromile ps))
        (decay-before:decimal (ref-ATS::UR_HibernateDecay ps))
    )
    (ref-TS01-C2::ATS|C_SetHibernationFees aoz ps 160.0 0.01)
    (map print
        [
            (format "peak-hibernate-promile was {}, decay was {}" [peak-before decay-before])
