(begin-tx "WithdrawRoyalties Proof")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(namespace "ouronet-ns")
;;==== WithdrawRoyalties Proof · 01 · env-sigs (caps) ==== =========================================
(print "--- [WithdrawRoyalties Proof · 01 · env-sigs (caps)] ---")
(env-sigs
    [
        { "key": "PK_AOZ", "caps": [] }
    ]
)
;;==== WithdrawRoyalties Proof · 02 · let / invocation ==== ========================================
(print "--- [WithdrawRoyalties Proof · 02 · let / invocation] ---")
;; ATSU|C>WITHDRAW-ROYALTIES enforces a nonzero accrued sum (RUR bucket 3) before it will run, so a
;; royalty rate is set and a Coil is performed first (URCx_RBT-Amount charges royalty-fee out of
;; every Coil deposit once ATS|C_UpdateRoyalty has set a nonzero royalty-promile) to actually accrue
;; something to withdraw.
(let
    (
        (ref-TS01-C2:module{TalosStageOne_ClientTwoV1} TS01-C2)
        (ref-ATS:module{AutostakeV2} ATS)
        (aoz:string KST.AOZT)
        (emma:string KST.EMMA)
        (ps:string "PlebeicStrength-98c486052a51")
        (p-k:string "PKOSON-98c486052a51")
    )
    (ref-TS01-C2::ATS|C_UpdateRoyalty aoz ps 15.0)
    (ref-TS01-C2::ATS|C_Coil aoz aoz ps p-k 200.0)
    (let
        (
            (royalty-sum-before:decimal (fold (+) 0.0 (ref-ATS::UR_RewardTokenRUR ps 3)))
        )
        (map print
            [
                (format "accrued royalty sum before withdrawal: {}" [royalty-sum-before])
                (expect "royalty accrued from the Coil above (nonzero)" true (> royalty-sum-before 0.0))
            ]
        )
        (ref-TS01-C2::ATS|C_WithdrawRoyalties aoz ps emma)
        (map print
            [
                (expect "all royalty buckets reset to 0.0 after withdrawal"
                    0.0
                    (fold (+) 0.0 (ref-ATS::UR_RewardTokenRUR ps 3))
                )
            ]
        )
    )
)

(print "")
(print "")
