;;==== Hot RBT and Redeem Test 5|5 · 02 · let / invocation — LATE C_Redeem, zero-fee branch ==== ===
(print "--- [Hot RBT and Redeem Test 5|5 · 02 · let / invocation — LATE C_Redeem, zero-fee branch] ---")
;; Second half of the #3C / C3 regression: redeems nonce 2 two full decay periods after minting
;; (`elapsed-time >= total-time`), so `earned-rbt = nonce-supply` exactly and `are-fee-rts = 0.0` —
;; the EXACT edge case that first exposed the bug (Pact's `if` rejects `0.0` same as any nonzero
;; decimal; no silent coercion). Exercises the FALSE branch of the fix: full value paid, no fee.
(let
    (
        (ref-TS01-C2:module{TalosStageOne_ClientTwoV1} TS01-C2)
        (ref-ATS:module{AutostakeV2} ATS)
        (ref-DPOF:module{DemiourgosPactOrtoFungibleV1} DPOF)
        (ref-DPTF:module{DemiourgosPactTrueFungibleV1} DPTF)
        (aoz:string KST.AOZT)
        (atsc:string KST.ATSTK)
        (ps:string "PlebeicStrength-98c486052a51")
        (dd-k:string "DDKOSON-98c486052a51")
        (p-k:string "PKOSON-98c486052a51")
        (e-k:string "EKOSON-98c486052a51")
        (a-k:string "AKOSON-98c486052a51")
        (pd-k:string "PDKOSON-98c486052a51")
        ;;
        (nonce-supply-2:decimal (ref-DPOF::UR_NonceSupply dd-k 2))
        (total-rts-2:[decimal] (ref-ATS::URC_RTSplitAmounts ps nonce-supply-2))
        (total-value-2:decimal (fold (+) 0.0 total-rts-2))
        (p-before:decimal (ref-DPTF::UR_AccountSupply p-k aoz))
        (e-before:decimal (ref-DPTF::UR_AccountSupply e-k aoz))
        (a-before:decimal (ref-DPTF::UR_AccountSupply a-k aoz))
    )
    (env-chain-data
        {"prev-block-hash": "98c486052a5147fdd30fa43cc6d67e0a4e680c856c37f9157cb788cd67d58006",
        "block-time": (time "2026-10-12T00:00:00Z")}
    )
    (ref-TS01-C2::ATS|C_Redeem aoz aoz dd-k 2)
    (let
        (
            (p-delta:decimal (- (ref-DPTF::UR_AccountSupply p-k aoz) p-before))
            (e-delta:decimal (- (ref-DPTF::UR_AccountSupply e-k aoz) e-before))
            (a-delta:decimal (- (ref-DPTF::UR_AccountSupply a-k aoz) a-before))
        )
        (let
            (
                (paid-total:decimal (fold (+) 0.0 [p-delta e-delta a-delta]))
            )
            (map print
                [
                    (format "nonce 2 supply was {}; full (no-fee) value {}; actually paid {}" [nonce-supply-2 total-value-2 paid-total])
                    (expect "nonce 2 burned — DPOF supply now the not-exists sentinel" -1.0 (ref-DPOF::UR_NonceSupply dd-k 2))
                    (expect "fully-matured redeem paid EXACTLY the full value (no fee withheld)"
                        total-value-2
                        paid-total
                    )
                    (format "AOZET has  {} p-k |{} e-k |{} a-k "
                        [
                            (ref-DPTF::UR_AccountSupply p-k aoz)
                            (ref-DPTF::UR_AccountSupply e-k aoz)
                            (ref-DPTF::UR_AccountSupply a-k aoz)
                        ]
                    )
                    (format "AOZET has {} PlebiumDenarius and {} Denarius Debilis; Time is {}"
                        [
                            (ref-DPTF::UR_AccountSupply pd-k aoz)
                            (ref-DPOF::UR_AccountSupply dd-k aoz)
                            (at "block-time" (chain-data))
                        ]
                    )
                    (format "{} Index is {};" [ps (ref-ATS::URC_Index ps)])
                    (format "Autostake has AFTER REDEEM in {} P-K, {} E-K, A-K {} for {}"
                        [
                            (at "resident" (at 0 (ref-ATS::UR_RewardTokens ps)))
                            (at "resident" (at 1 (ref-ATS::UR_RewardTokens ps)))
                            (at "resident" (at 2 (ref-ATS::UR_RewardTokens ps)))
                            ps
                        ]
                    )
                ]
            )
        )
        ""
    )
)
;; Restore ambient chain-time to exactly what the pre-existing sections below this point already
;; assumed (the original file left "2024-10-11T00:00:00Z" as ambient here) — keeps this rewrite
;; self-contained to the Redeem regression, with no incidental effect on later, unrelated sections.
(env-chain-data
    {"prev-block-hash": "98c486052a5147fdd30fa43cc6d67e0a4e680c856c37f9157cb788cd67d58006",
    "block-time": (time "2024-10-11T00:00:00Z")}
)

