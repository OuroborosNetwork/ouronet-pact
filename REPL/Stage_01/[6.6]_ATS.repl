;;==== Hot RBT and Redeem Test 4|5 · 01 · env-sigs (caps) ==== ====================================
(print "--- [Hot RBT and Redeem Test 4|5 · 01 · env-sigs (caps)] ---")
(env-sigs
    [
        { "key": "PK_AOZ", "caps": [] }
    ]
)
(namespace "ouronet-ns")
;;==== Hot RBT and Redeem Test 4|5 · 02 · let / invocation — EARLY C_Redeem, fee-bearing branch ====
(print "--- [Hot RBT and Redeem Test 4|5 · 02 · let / invocation — EARLY C_Redeem, fee-bearing branch] ---")
;; REGRESSION for audit finding #3C / C3 (ROUND-01-FINDINGS.md): `C_Redeem` used to revert
;; unconditionally (`are-fee-rts:decimal` fed straight into `if`, which requires :bool — Pact does
;; not coerce). Fixed in ROUND-02-FIXES.md Fix #2 (`have-fee-rts:bool (!= are-fee-rts 0.0)`).
;; This tx redeems nonce 1 only ~6h after minting (well inside the 1-day decay window, h-promile
;; 10%), so a real, nonzero fee must be withheld — exercises the TRUE branch of the fix.
(let
    (
        (ref-TS01-C2:module{TalosStageOne_ClientTwoV1} TS01-C2)
        (ref-ATS:module{AutostakeV2} ATS)
        (ref-DPOF:module{DemiourgosPactOrtoFungibleV1} DPOF)
        (ref-DPTF:module{DemiourgosPactTrueFungibleV1} DPTF)
        (aoz:string KST.AOZT)
        (ps:string "PlebeicStrength-98c486052a51")
        (dd-k:string "DDKOSON-98c486052a51")
        (p-k:string "PKOSON-98c486052a51")
        (e-k:string "EKOSON-98c486052a51")
        (a-k:string "AKOSON-98c486052a51")
        ;;
        (nonce-supply-1:decimal (ref-DPOF::UR_NonceSupply dd-k 1))
        (total-rts-1:[decimal] (ref-ATS::URC_RTSplitAmounts ps nonce-supply-1))
        (total-value-1:decimal (fold (+) 0.0 total-rts-1))
        (p-before:decimal (ref-DPTF::UR_AccountSupply p-k aoz))
        (e-before:decimal (ref-DPTF::UR_AccountSupply e-k aoz))
        (a-before:decimal (ref-DPTF::UR_AccountSupply a-k aoz))
    )
    (env-chain-data
        {"prev-block-hash": "98c486052a5147fdd30fa43cc6d67e0a4e680c856c37f9157cb788cd67d58006",
        "block-time": (time "2026-10-10T06:00:00Z")}
    )
    (ref-TS01-C2::ATS|C_Redeem aoz aoz dd-k 1)
    (let
        (
            (p-delta:decimal (- (ref-DPTF::UR_AccountSupply p-k aoz) p-before))
            (e-delta:decimal (- (ref-DPTF::UR_AccountSupply e-k aoz) e-before))
            (a-delta:decimal (- (ref-DPTF::UR_AccountSupply a-k aoz) a-before))
            (paid-value:decimal 0.0)
        )
        (let
            (
                (paid-total:decimal (fold (+) 0.0 [p-delta e-delta a-delta]))
            )
            (map print
                [
                    (format "nonce 1 supply was {}; full (no-fee) value would be {}; actually paid {}" [nonce-supply-1 total-value-1 paid-total])
                    (expect "nonce 1 burned — DPOF supply now the not-exists sentinel" -1.0 (ref-DPOF::UR_NonceSupply dd-k 1))
                    (expect "early redeem paid something (not zero)" true (> paid-total 0.0))
                    (expect "early redeem withheld a real fee — paid STRICTLY LESS than full value"
                        true
                        (< paid-total total-value-1)
                    )
                ]
            )
        )
        ""
    )
)

