(begin-tx "SetHotRecoveryFee and HotRecovery Proof")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(namespace "ouronet-ns")
;;==== SetHotRecoveryFee and HotRecovery Proof · 01 · env-sigs (caps) ==== ========================
(print "--- [SetHotRecoveryFee and HotRecovery Proof · 01 · env-sigs (caps)] ---")
(env-sigs
    [
        { "key": "PK_AOZ", "caps": [] }
    ]
)
;;==== SetHotRecoveryFee and HotRecovery Proof · 02 · let / invocation ==== =======================
(print "--- [SetHotRecoveryFee and HotRecovery Proof · 02 · let / invocation] ---")
;; ATS|C>SET_HOT_FEES composes ATS|C>CONTROL-HOT-RECOVERY, which requires Hot Recovery to
;; currently be OFF (mirrors AOZ's own C_SetupKosonicATS: AddHotRBT + SetHotRecoveryFee both
;; happen before Hot Recovery is ever switched on for a pair). ps has had Hot Recovery switched ON
;; since the "Hybrid Cull" sections earlier in this file, so it's toggled off, reconfigured, and
;; toggled back on here — leaving ps's ambient state exactly as the rest of the file left it.
;; #31L confirmation: the Talos wrapper is the SINGULAR ATS|C_SetHotRecoveryFee (not "...Fees").
(let
    (
        (ref-TS01-C2:module{TalosStageOne_ClientTwoV1} TS01-C2)
        (ref-ATS:module{AutostakeV2} ATS)
        (ref-DPOF:module{DemiourgosPactOrtoFungibleV1} DPOF)
        (aoz:string KST.AOZT)
        (ps:string "PlebeicStrength-98c486052a51")
        (dd-k:string "DDKOSON-98c486052a51")
        (promile-before:decimal (ref-ATS::UR_HotRecoveryStartingFeePromile ps))
        (decay-before:integer (ref-ATS::UR_HotRecoveryDecayPeriod ps))
        (nonces-before:integer (ref-DPOF::UR_NoncesUsed dd-k))
    )
    (ref-TS01-C2::ATS|C_SwitchHotRecovery aoz ps false)
    (ref-TS01-C2::ATS|C_SetHotRecoveryFee aoz ps 500.0 30)
    (map print
        [
            (format "h-promile was {}, h-decay was {}" [promile-before decay-before])
            (expect "h-promile updated to 500.0" 500.0 (ref-ATS::UR_HotRecoveryStartingFeePromile ps))
            (expect "h-decay updated to 30" 30 (ref-ATS::UR_HotRecoveryDecayPeriod ps))
        ]
    )
    (ref-TS01-C2::ATS|C_SwitchHotRecovery aoz ps true)
    (ref-TS01-C2::ATS|C_HotRecovery aoz aoz ps 25.0)
    (map print
        [
            (expect "DDKOSON minted exactly one new nonce (nonce 3)" (+ nonces-before 1) (ref-DPOF::UR_NoncesUsed dd-k))
            (expect "nonce 3 exists with positive supply" true (> (ref-DPOF::UR_NonceSupply dd-k 3) 0.0))
        ]
    )
)

