(print "")
(begin-tx "TX-01 [1.01] - Deploy U|CT")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(namespace "ouronet-ns")
;;==== TX-01 [1.01] - Deploy U|CT · 01 · env-sigs (caps) ==== =====================================
(print "--- [TX-01 [1.01] - Deploy U|CT · 01 · env-sigs (caps)] ---")
(env-sigs
  [{"key": "1a4e15d3c51e0b73e92644600487ba8eaae312e1a178b91801d54e13c1b350a5", "caps": []}])
;;==== TX-01 [1.01] - Deploy U|CT · 02 · load module ==== =========================================
(print "--- [TX-01 [1.01] - Deploy U|CT · 02 · load module] ---")
(load "../../1_SOVEREIGN/STAGE_01/1_Utilities/01_U_CT.pact")
;;==== TX-01 [1.01] - Deploy U|CT · 03 · gas echo ==== ============================================
(print "--- [TX-01 [1.01] - Deploy U|CT · 03 · gas echo] ---")
(format "<<<<<<<U|CT Costs {} GAS>>>>>>>" [(env-gas)])
(print "")
(commit-tx)
;;||>>>>>>>>>>>>>>>>>>>>>>>>>
;;|| NEXT                   >
;;||>>>>>>>>>>>>>>>>>>>>>>>>>
