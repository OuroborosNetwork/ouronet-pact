;;================================================================================
;; FILE  REPL/Stage_01/[Z]_Reads.repl
;;   Stage-1 Z_Reads layer — pure read-only presentation modules, deployed LAST
;;   (after 3_Talos). Currently: INFO-ZERO (DALOS client-op previews). More INFO
;;   modules join here in Phase 1.2. Leaf layer — nothing references it.
;;================================================================================
(print "")
(begin-tx "TX-Z01 [Z] - INFO-ZERO Module")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(namespace "ouronet-ns")
;;==== TX-Z01 [Z] - INFO-ZERO Module · 01 · env-sigs (caps) ==== ==================================
(print "--- [TX-Z01 [Z] - INFO-ZERO Module · 01 · env-sigs (caps)] ---")
(env-sigs
  [{"key": "1a4e15d3c51e0b73e92644600487ba8eaae312e1a178b91801d54e13c1b350a5", "caps": []}])
;;==== TX-Z01 [Z] - INFO-ZERO Module · 02 · load module ==== ======================================
(print "--- [TX-Z01 [Z] - INFO-ZERO Module · 02 · load module] ---")
(load "../../1_SOVEREIGN/STAGE_01/Z_Reads/01_INFO-ZERO.pact")
;;==== TX-Z01 [Z] - INFO-ZERO Module · 03 · gas echo ==== =========================================
(print "--- [TX-Z01 [Z] - INFO-ZERO Module · 03 · gas echo] ---")
(format "<<<<<<<INFO-ZERO Costs {} GAS>>>>>>>" [(env-gas)])
(print "")
(commit-tx)
(print "")
