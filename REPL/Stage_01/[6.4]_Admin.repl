        (ref-TS01-C3:module{TalosStageOne_ClientThreeV4} TS01-C3)
        (patron:string KST.ANHD)
    )
    (ref-TS01-A::DALOS|A_SetIgnisSourcePrice 1.2)
    (ref-TS01-A::DALOS|A_SetAutoFueling true)
    (ref-TS01-A::DALOS|A_UpdatePublicKey patron "plmea")
    ;;
    (ref-TS01-C1::DPTF|C_UpdatePendingBranding
        patron
        "GA-98c486052a51"
        "This is the logo"
        "Galium is an element"
        "Website of Galium"
        [
            { "social-media-name":  "Galium Facebook", "social-media-link": "Facebook link"}
            { "social-media-name":  "Galium Waztup", "social-media-link": "Watzup link"}
        ]
    )
    (ref-TS01-C1::DPTF|C_UpdatePendingBranding
        patron
        "F|VST-98c486052a51"
        "This is the logo"
        "Galium is an element"
        "Website of Galium"
        [
            { "social-media-name":  "Galium Facebook", "social-media-link": "Facebook link"}
            { "social-media-name":  "Galium Waztup", "social-media-link": "Watzup link"}
        ]
    )
    (ref-TS01-C1::DPOF|C_UpdatePendingBranding
        patron
        "Z|VST-98c486052a51"
        "This is the logo"
        "Galium is an element"
        "Website of Galium"
        [
            { "social-media-name":  "Galium Facebook", "social-media-link": "Facebook link"}
            { "social-media-name":  "Galium Waztup", "social-media-link": "Watzup link"}
        ]
    )
    ;;#61L: pre-existing, unrelated to this fix — "Magnindium-98c486052a51" is never
    ;;actually issued anywhere in the test suite (grepped: this is the only reference
    ;;to it in all of REPL/), so this call has always hard-failed with "No value found
    ;;in table ATS_ATS|Pairs" whenever this file was loaded — which is presumably
    ;;exactly why the whole file was excluded from the default Z.repl pipeline.
    ;;Commented out (matching this file's own established pattern for not-ready
    ;;calls below) so the rest of the file — including the #61L proof — can load.
    ;(ref-TS01-C2::ATS|C_UpdatePendingBranding
    ;    patron
    ;    "Magnindium-98c486052a51"
    ;    "This is the logo"
    ;    "Galium is an element"
    ;    "Website of Galium"
    ;    [
    ;        { "social-media-name":  "Galium Facebook", "social-media-link": "Facebook link"}
    ;        { "social-media-name":  "Galium Waztup", "social-media-link": "Watzup link"}
    ;    ]
    ;)
    (ref-TS01-C3::SWP|C_UpdatePendingBranding
        patron
        "S|DLK-98c486052a51|OURO-98c486052a51|DWK-98c486052a51"
        "This is the logo"
        "Galium is an element"
        "Website of Galium"
        [
            { "social-media-name":  "Galium Facebook", "social-media-link": "Facebook link"}
            { "social-media-name":  "Galium Waztup", "social-media-link": "Watzup link"}
        ]
    )
    (ref-TS01-C3::SWP|C_UpdatePendingBrandingLPs
        patron
        "P|OURO-98c486052a51|VST-98c486052a51"
        1
        "This is the logo"
        "Native LP is an element"
        "Website of Galium"
        [
            { "social-media-name":  "Galium Facebook", "social-media-link": "Facebook link"}
            { "social-media-name":  "Galium Waztup", "social-media-link": "Watzup link"}
        ]
    )
    ;;#61L: pre-existing, unrelated to this fix — this pool never had a frozen-LP
    ;;(entity-pos 2) or sleeping-LP (entity-pos 3) variant created anywhere in the
    ;;test suite (grepped: no C_EnableFrozenLP/C_EnableSleepingLP for this pool),
    ;;so URC_EntityPosToID resolves to the BAR sentinel "|" for both and this always
    ;;hard-failed ("No value found in table DPTF_DPTF|PropertiesTable for key: |").
    ;;Commented out for the same reason as the ATS call above.
    ;(ref-TS01-C3::SWP|C_UpdatePendingBrandingLPs
    ;    patron
