(begin-tx "SWP|TX 032s - Mint + Issue 80 P2-Scale Noise Pools (OURO-anchored)")
(namespace "ouronet-ns")
;;env-gaslimit is a REPL-testing safety valve only, not a real StoaChain constraint —
;;raised generously here since this SETUP transaction's own cost isn't what's being
;;measured (only SWP|TX 032q's real worst-case swap is). Bulk-issuing many pools in
;;one map makes each pool's own worth-check search cost more as the graph grows.
(env-gasmodel "table")(env-gaslimit 2000000000)(env-gas 0)
