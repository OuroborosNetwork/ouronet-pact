(begin-tx "SWP|TX 032z6 - #34 Phase 8 Bundle-Based SmartSwap Proof + Gas Comparison (Permanent)")
(namespace "ouronet-ns")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
;;==== SWP|TX 032z6 - Bundle-Based SmartSwap Proof · 01 · env-sigs (caps) ====
(print "--- [SWP|TX 032z6 - Bundle-Based SmartSwap Proof · 01 · env-sigs (caps)] ---")
(env-sigs
    [
        { "key": "PK_AncientHodler", "caps": [] }
    ]
)
;;#34 Phase 8: proves the bundle-based SWP|C_SmartSwapNoSlippage end to end at the
;;SAME ~102-active-pool P2-scale worst-case state SWP|TX 032z2 measured
;;SWP|CC_SmartSwapNoSlippage (self-searching) at — direct, apples-to-apples gas
;;comparison against that already-recorded number, not an estimate. Bundle
;;construction below (URC_HopperActive/URC_HopperActiveShortest/URC_Hopper calls)
;;simulates exactly what an off-chain client would do via free /local dirty reads —
;;deliberately done BEFORE the gas reset, so none of it counts against the measured
;;total, matching production reality where only the real submitted transaction costs
;;anything.
;;==== SWP|TX 032z6 - Bundle-Based SmartSwap Proof · 02 · dirty-read bundle + measured call ====
(print "--- [SWP|TX 032z6 - Bundle-Based SmartSwap Proof · 02 · dirty-read bundle + measured call] ---")
(let ((ref-TS01-A:module{TalosStageOne_AdminV2} TS01-A)) (ref-TS01-A::SWP|A_UpdateLiquidBoost true))
(let*
    (
        (ref-SWPI:module{SwapperIssueV4} SWPI)
        (ref-SWP:module{SwapperV4} SWP)
        (ref-SWPT:module{SwapTracerV3} SWPT)
        (ref-DALOS:module{OuronetDalosV2} DALOS)
        (ref-TS01-C3:module{TalosStageOne_ClientThreeV4} TS01-C3)
        (dwk:string (ref-DALOS::UR_WrappedStoaID))
        (dlk:string (ref-DALOS::UR_SilverStoaID))
        (input-id "W1-98c486052a51")
        (output-id "W7-98c486052a51")
        ;;1) swap-route: A->B, freshly discovered off-chain (P3.0: never cached,
        ;;amount-sensitive) — the real, best-of-3 active-only search, same one
        ;;SWP|CC_SmartSwapNoSlippage itself runs internally at 032z2.
        (route-h:object{SwapperIssueV4.Hopper} (ref-SWPI::URC_HopperActive input-id output-id 10.0))
        (route-nodes:[string] (at "nodes" route-h))
        (route-edges:[string] (at "edges" route-h))
        ;;2) boost-path: output-id -> DLK, amount-agnostic (P3.0) — any positive
        ;;discovery amount works, the real transaction recomputes the actual carried
        ;;value fresh via URC_HopperForKnownRoute over these exact nodes/edges.
        (boost-h:object{SwapperIssueV4.Hopper} (ref-SWPI::URC_HopperActiveShortest output-id dlk 1.0))
        ;;3) stoa-paths: one deduped entry per DISTINCT first-token among the route's
        ;;own distinct pools, each first-token -> DWK, exists-only universe (matching
        ;;URC_WorthWSTOA's own unfiltered URC_Hopper call, not URC_HopperActive).
        (distinct-pools:[string] (distinct route-edges))
        (first-tokens:[string] (distinct (map (lambda (sp:string) (at 0 (ref-SWP::UR_PoolTokens sp))) distinct-pools)))
        (stoa-paths:list
            (map
                (lambda (ft:string)
                    (let
                        (
                            (h:object{SwapperIssueV4.Hopper} (ref-SWPI::URC_Hopper ft dwk 1.0))
                        )
                        ;;is-new=true: this IS genuinely the first time this exact test
                        ;;runs, so these ARE genuinely fresh discoveries — exercises the
                        ;;real cache self-warming write path (XI_RegisterBundlePaths),
                        ;;not just its "nothing to do" branch.
                        {"first-token" : ft
                        ,"path" : {"nodes" : (at "nodes" h), "edges" : (at "edges" h), "is-new" : true}}
                    )
                )
                first-tokens
            )
        )
        (bundle
            {"swap-route" : {"nodes" : route-nodes, "edges" : route-edges}
            ,"boost-path" : {"nodes" : (at "nodes" boost-h), "edges" : (at "edges" boost-h), "is-new" : true}
            ,"stoa-paths" : stoa-paths}
        )
        (verify-first-token:string (at 0 first-tokens))
    )
    ;;Gas reset happens HERE, after bundle construction — only the real paid
    ;;transaction below is measured, exactly matching 032z2's own measurement shape
    ;;((env-gas 0) immediately before the Talos call).
    (env-gas 0)
    (let
        (
            (swap-result:string
                (ref-TS01-C3::SWP|C_SmartSwapNoSlippage KST.ANHD KST.ANHD input-id 10.0 output-id bundle)
            )
        )
        (map print
            [
                (format "#34 Phase 8 bundle-based swap result (Liquid Boost ON, ~102 active pools): {}" [swap-result])
                (expect
                    "Bundle-based swap actually executed the full 6-hop route (not a shorter shortcut, not a fallback)"
                    true
                    (contains "via 6 Swaps" swap-result)
                )
            ]
        )
    )
    ;;Cache self-warming verification: reads back via the same reversed-lookup path
    ;;any real caller would use.
    ;;
    ;;boost-path (output-id=W7 -> DLK) is deliberately expected NOT to register here
    ;;— in THIS topology, the shortest active route from W7 back through the W-chain
    ;;to the OURO anchor and on to DLK is genuinely 8 hops (9 nodes) —
    ;;URC_HopperActiveShortest itself has no depth-cap restriction (it just returns
    ;;whatever BFS finds), but URC_ValidatePathActive DOES enforce the P0.4 depth cap
    ;;(7 nodes/6 hops) on every bundle-supplied path — correctly rejecting this one,
    ;;same graceful "no boost pumped, no crash" degrade as a genuine no-route-found
    ;;case (confirmed: the swap above still completed normally). SWP|TX 032z7 below
    ;;proves the positive case (a genuinely-eligible, in-depth-cap path DOES get
    ;;registered) using a short 1-hop boost target instead.
    (map print
        [
            (expect
                (format "Cache self-warming: boost-path {}->{} correctly NOT registered (natural route exceeds the P0.4 depth cap)" [output-id dlk])
                false
                (!= (at "nodes" (ref-SWPT::URC_ReadPathCache output-id dlk)) [SWPT.BAR])
            )
            (expect
                (format "Cache self-warming: stoa-path {}->{} was registered by the swap" [verify-first-token dwk])
                true
                (!= (at "nodes" (ref-SWPT::URC_ReadPathCache verify-first-token dwk)) [SWPT.BAR])
            )
        ]
    )
)
(print (format "<<<<<<<SWP|TX 032z6 #34 PHASE 8 BUNDLE-BASED SMARTSWAP (Liquid Boost ON, ~102 active pools) ==> {} STOA GAS>>>>>>>" [(env-gas)]))
(print "Compare directly against SWP|TX 032z2's recorded SWP|CC_SmartSwapNoSlippage gas at the same ~102-active-pool state — this is the real 'how much does outsourcing dirty reads save us' number.")
(let ((ref-TS01-A:module{TalosStageOne_AdminV2} TS01-A)) (ref-TS01-A::SWP|A_UpdateLiquidBoost false))
(env-sigs [])
(commit-tx)
;;||>>>>>>>>>>>>>>>>>>>>>>>>>
;;|| NEXT                   >
;;||>>>>>>>>>>>>>>>>>>>>>>>>>
(begin-tx "SWP|TX 032z6b - #65bL Phase 1 PathCache-Wired URCx_Hopper Proof (Permanent)")
(namespace "ouronet-ns")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
;;==== SWP|TX 032z6b - #65bL Phase 1 PathCache Proof · 01 · env-sigs (caps) ====
(print "--- [SWP|TX 032z6b - #65bL Phase 1 PathCache Proof · 01 · env-sigs (caps)] ---")
(env-sigs
    [
        { "key": "PK_AncientHodler", "caps": [] }
    ]
)
;;#65bL Phase 1 fix: SWP|TX 032z6 (immediately above) already warmed SWPT|PathCache
;;for <verify-first-token>->DWK via the bundle-based swap's own cache self-warming
;;(XI_RegisterBundlePaths). URCx_Hopper (16_SWPI.pact) now checks SWPT|PathCache
;;(via URC_ReadPathCacheFresh) before running its own live best-of-3 BFS search.
;;This proves: (1) a warm-cache call returns EXACTLY the cached node path, not some
;;independently-recomputed route that just happens to match, and (2) the real
;;measured gas cost of that same lookup, for later comparison against the same
;;scenario with Phase 1's URCx_Hopper wiring reverted (see the stashed before/after
;;measurement in the session notes for this fix).
;;==== SWP|TX 032z6b - #65bL Phase 1 PathCache Proof · 02 · recompute + measured call ====
(print "--- [SWP|TX 032z6b - #65bL Phase 1 PathCache Proof · 02 · recompute + measured call] ---")
(let*
    (
        (ref-SWPI:module{SwapperIssueV4} SWPI)
        (ref-SWP:module{SwapperV4} SWP)
        (ref-SWPT:module{SwapTracerV3} SWPT)
        (ref-DALOS:module{OuronetDalosV2} DALOS)
        (dwk:string (ref-DALOS::UR_WrappedStoaID))
        (input-id "W1-98c486052a51")
        (output-id "W7-98c486052a51")
        ;;Recompute the same route/first-tokens derivation TX 032z6 used, to identify
        ;;the exact same <verify-first-token> its cache-warming registered.
        (route-h:object{SwapperIssueV4.Hopper} (ref-SWPI::URC_HopperActive input-id output-id 10.0))
        (route-edges:[string] (at "edges" route-h))
        (distinct-pools:[string] (distinct route-edges))
        (first-tokens:[string] (distinct (map (lambda (sp:string) (at 0 (ref-SWP::UR_PoolTokens sp))) distinct-pools)))
        (verify-first-token:string (at 0 first-tokens))
        (cached-row:object{SwapTracerV3.PathCacheRow} (ref-SWPT::URC_ReadPathCache verify-first-token dwk))
        (cached-nodes:[string] (at "nodes" cached-row))
    )
    (map print
        [
            (expect "#65bL Phase 1: cache is genuinely warm for verify-first-token->DWK before this proof starts"
                true
                (!= cached-nodes [SWPT.BAR])
            )
        ]
    )
    (env-gas 0)
    (let
        (
            (h:object{SwapperIssueV4.Hopper} (ref-SWPI::URC_Hopper verify-first-token dwk 1.0))
        )
        (map print
            [
                (expect "#65bL Phase 1: URC_Hopper on a warm cache returns EXACTLY the cached node path"
                    cached-nodes
                    (at "nodes" h)
                )
                (format "#65bL Phase 1: URC_Hopper(verify-first-token, DWK) WARM-CACHE gas: {}" [(env-gas)])
            ]
        )
    )
)
(env-sigs [])
(commit-tx)
