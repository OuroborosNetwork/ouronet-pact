(begin-tx "SWP|TX 032p - 7 Special Fee Targets + Enable Swap on All 6 Pools (P0.5)")
(namespace "ouronet-ns")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
;;==== SWP|TX 032p - Fee Targets + Enable Swap (P0.5) · 01 · env-sigs (caps) ==== ========================
(print "--- [SWP|TX 032p - Fee Targets + Enable Swap (P0.5) · 01 · env-sigs (caps)] ---")
(env-sigs
    [
        { "key": "PK_AncientHodler", "caps": [] }
    ]
)
;;==== SWP|TX 032p - Fee Targets + Enable Swap (P0.5) · 02 · let / invocation ==== =======================
(print "--- [SWP|TX 032p - Fee Targets + Enable Swap (P0.5) · 02 · let / invocation] ---")
(let
    (
        (ref-TS01-C3:module{TalosStageOne_ClientThreeV4} TS01-C3)
        (pools:[string]
            [ "S|W1-98c486052a51|W2-98c486052a51|W1A-98c486052a51|W1B-98c486052a51|W1C-98c486052a51|W1D-98c486052a51|W1E-98c486052a51"
              "S|W2-98c486052a51|W3-98c486052a51|W2A-98c486052a51|W2B-98c486052a51|W2C-98c486052a51|W2D-98c486052a51|W2E-98c486052a51"
              "S|W4-98c486052a51|W3-98c486052a51|W3A-98c486052a51|W3B-98c486052a51|W3C-98c486052a51|W3D-98c486052a51|W3E-98c486052a51"
              "S|W4-98c486052a51|W5-98c486052a51|W4A-98c486052a51|W4B-98c486052a51|W4C-98c486052a51|W4D-98c486052a51|W4E-98c486052a51"
              "S|W5-98c486052a51|W6-98c486052a51|W5A-98c486052a51|W5B-98c486052a51|W5C-98c486052a51|W5D-98c486052a51|W5E-98c486052a51"
              "S|W7-98c486052a51|W6-98c486052a51|W6A-98c486052a51|W6B-98c486052a51|W6C-98c486052a51|W6D-98c486052a51|W6E-98c486052a51" ]
        )
        (spt:[object{SwapperV4.FeeSplit}]
            [
                {"target":KST.BYTA, "value":15}
                {"target":KST.LUMY, "value":125}
                {"target":KST.COCA, "value":35}
                {"target":KST.KISS, "value":35}
                {"target":KST.PLCS, "value":50}
                {"target":KST.NANI, "value":60}
                {"target":KST.AOZT, "value":10}
            ]
        )
    )
    (map (lambda (p:string) (ref-TS01-C3::SWP|C_UpdateSpecialFeeTargets KST.ANHD p spt)) pools)
    ;;P0.6 correction, 2026-08-21: configuring targets alone (above) does NOT activate
    ;;the special-fee rate itself — <fee-special> defaults to 0.0 at issuance and stays
    ;;there unless explicitly set, meaning every prior worst-case measurement in this
    ;;file never actually exercised the special-fee-target <C_MultiBulkTransfer> path at
    ;;all (o-id-special was 0.0 on every hop). Set to 10.0 here, mirroring <lp-fee>
    ;;(matches how Liquid Boost already mirrors <lp-fee> when its own toggle is on), so
    ;;this "worst case" test actually stresses the path it claims to.
    (map (lambda (p:string) (ref-TS01-C3::SWP|C_UpdateFee KST.ANHD p 10.0 false)) pools)
    (map (lambda (p:string) (ref-TS01-C3::SWP|C_ToggleSwapCapability KST.ANHD p true)) pools)
)
(print "")
(print "")
;;==== SWP|TX 032p - Fee Targets + Enable Swap (P0.5) · 03 · gas echo ==== ===============================
(print "--- [SWP|TX 032p - Fee Targets + Enable Swap (P0.5) · 03 · gas echo] ---")
(format "<<<<<<<SWP|TX 032p Fee Targets + Enable ==> {} STOA GAS>>>>>>>" [(env-gas)])
