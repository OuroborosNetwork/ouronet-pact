(print "=======================P0.5 Worst-Case Execution Gas Test (Phase 2 planning)=================================")
;;Roadmap: OuronetInformational/HANDOFF-swp-exhaustive-path-search.md, item P0.5.
;;Measures the real gas cost of executing (not searching for) a maximal-complexity
;;SmartSwap: a 7-token/6-hop route (owner's "sexy number 7" depth cap) where EVERY
;;one of the 6 pools along the way is itself maximally sized (7 members) with 7
;;special fee targets configured. Validates the biggest assumption the whole
;;Phase 2 execution path (P3) depends on — that the absolute worst case still fits
;;in one transaction under StoaChain's ~2,000,000 gas ceiling.
;;
;;Topology: W1 -> W2 -> W3 -> W4 -> W5 -> W6 -> W7 (7 tokens, 6 hops). W1/W4/W7 are
;;registered as real principals (start/middle/end of the route) so every pool's
;;anchoring requirement is satisfied by tokens already ON the intended route — no
;;shared "hub" token bridges the ends and creates an accidental shortcut (a design
;;mistake caught and corrected before building this: reusing one common anchor, or
;;sharing filler tokens across pools, would let BFS skip straight from W1 to W7 in
;;2 hops instead of the intended 6). Each pool's other 5 members are unique,
;;pool-local filler tokens never reused elsewhere, for the same reason. Issued with
;;p=true (permissioned bypass) since brand-new principals have no prior trading
;;history to price against the spawn-limit check — the anchoring rule itself still
;;applies unconditionally regardless of p.
(begin-tx "SWP|TX 032l - Issue 37 Tokens for Worst-Case Gas Test (P0.5)")
(namespace "ouronet-ns")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
;;==== SWP|TX 032l - Issue 37 Tokens for Worst-Case Gas Test (P0.5) · 01 · let / invocation ==== =====
(print "--- [SWP|TX 032l - Issue 37 Tokens for Worst-Case Gas Test (P0.5) · 01 · let / invocation] ---")
(let
    (
        (patron:string KST.ANHD)
        (ref-DALOS:module{OuronetDalosV2} DALOS)
        (split-stoa:[decimal]
            (ref-DALOS::URC_SplitSTOAPrices
                patron
                (* (ref-DALOS::UR_UsagePrice "dptf") 37.0)
            )
        )
    )
;;==== SWP|TX 032l - Issue 37 Tokens for Worst-Case Gas Test (P0.5) · 02 · env-sigs (caps) ==== =======
(print "--- [SWP|TX 032l - Issue 37 Tokens for Worst-Case Gas Test (P0.5) · 02 · env-sigs (caps)] ---")
    (env-sigs
        [
            { "key": "PK_AncientHodler", "caps": [] }
            { "key": "6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263" ,
              "caps":
                [
                    (coin.TRANSFER
                        "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263"
                        "k:50d6c59b21e5e6e55baecaa75a1007de37576bde12d8230dc82459cc01b9484b"
                        (at 2 split-stoa)
                    )
                    (coin.TRANSFER
                        "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263"
                        "k:0cb30c0121ff919266121a99ff9359871818932211df94dae4137c29bc0e8f7e"
                        (at 0 split-stoa)
                    )
                    (coin.TRANSFER
                        "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263"
                        "c:XM-pkmuB5XUQlp87ZYSbfKt8qzmHY6O2EHAzMRVBt3k"
                        (at 3 split-stoa)
                    )
                    (coin.TRANSFER
                        "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263"
                        "c:iQQFWj6gWtpGEzhM_O5ekW1QtnQQy55R8BRPGhj_0FU"
                        (at 1 split-stoa)
                    )
                ]
            }
        ]
    )
    (let
        (
            (ref-TS01-C1:module{TalosStageOne_ClientOneV2} TS01-C1)
            (names:[string]
                [ "PathW1" "PathW2" "PathW3" "PathW4" "PathW5" "PathW6" "PathW7"
                  "PathW1FA" "PathW1FB" "PathW1FC" "PathW1FD" "PathW1FE"
                  "PathW2FA" "PathW2FB" "PathW2FC" "PathW2FD" "PathW2FE"
                  "PathW3FA" "PathW3FB" "PathW3FC" "PathW3FD" "PathW3FE"
                  "PathW4FA" "PathW4FB" "PathW4FC" "PathW4FD" "PathW4FE"
                  "PathW5FA" "PathW5FB" "PathW5FC" "PathW5FD" "PathW5FE"
                  "PathW6FA" "PathW6FB" "PathW6FC" "PathW6FD" "PathW6FE" ]
            )
            (tickers:[string]
                [ "W1" "W2" "W3" "W4" "W5" "W6" "W7"
                  "W1A" "W1B" "W1C" "W1D" "W1E"
                  "W2A" "W2B" "W2C" "W2D" "W2E"
                  "W3A" "W3B" "W3C" "W3D" "W3E"
                  "W4A" "W4B" "W4C" "W4D" "W4E"
                  "W5A" "W5B" "W5C" "W5D" "W5E"
                  "W6A" "W6B" "W6C" "W6D" "W6E" ]
            )
            (issued-ids:[string]
                (ref-TS01-C1::DPTF|C_Issue
                    patron
                    patron
                    names
                    tickers
                    (make-list 37 24)
                    (make-list 37 true)
                    (make-list 37 true)
                    (make-list 37 true)
                    (make-list 37 false)
