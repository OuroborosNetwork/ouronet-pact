(begin-tx "SWP|TX 032z6c - #65bL Phase 4 Shared Raw-Graph URC_PoolValueFromRaw Proof (Permanent)")
(namespace "ouronet-ns")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
;;==== SWP|TX 032z6c - #65bL Phase 4 Proof · 01 · env-sigs (caps) ====
(print "--- [SWP|TX 032z6c - #65bL Phase 4 Proof · 01 · env-sigs (caps)] ---")
(env-sigs
    [
        { "key": "PK_AncientHodler", "caps": [] }
    ]
)
;;#65bL Phase 4 fix: the STOA-repricing loop in SWP|CC_SmartSwap{With,No}Slippage
;;(04_TS01-C3.pact) now fetches ONE raw graph and calls SWPI::URC_PoolValueFromRaw
;;for every distinct pool touched, instead of each pool's own URC_PoolValue call
;;independently re-reading and rebuilding the whole graph. Proves the shared-fetch
;;version produces EXACTLY the same result as the original, unchanged URC_PoolValue
;;for a real pool — correctness preserved, not just "still runs."
;;==== SWP|TX 032z6c - #65bL Phase 4 Proof · 02 · direct comparison ====
(print "--- [SWP|TX 032z6c - #65bL Phase 4 Proof · 02 · direct comparison] ---")
(let*
    (
        (ref-SWPI:module{SwapperIssueV4} SWPI)
        (ref-SWP:module{SwapperV4} SWP)
        (ref-SWPT:module{SwapTracerV3} SWPT)
        (ref-U|SWP:module{UtilitySwpV2} U|SWP)
        (test-pool:string "P|OURO-98c486052a51|VST-98c486052a51")
        (all-swpairs:[string] (ref-SWP::URC_Swpairs))
        (all-nodes:[string] (ref-U|SWP::UC_MakeGraphNodes SWPT.BAR SWPT.BAR all-swpairs))
        (raw-graph:[object{SwapTracerV3.RawGraphNode}] (ref-SWPT::URC_FetchRawGraph all-nodes))
        (original-result:[decimal] (ref-SWPI::URC_PoolValue test-pool))
        (from-raw-result:[decimal] (ref-SWPI::URC_PoolValueFromRaw test-pool raw-graph))
    )
    (print
        (expect "#65bL Phase 4: URC_PoolValueFromRaw(shared raw-graph) == URC_PoolValue(self-fetch), byte-identical"
            original-result
            from-raw-result
        )
    )
)
(env-sigs [])
(commit-tx)
