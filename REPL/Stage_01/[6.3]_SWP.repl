(begin-tx "SWP|TX 032k - #34bM Adversarial Proof: S|TSTM|TSTQ Must Be Rejected")
(namespace "ouronet-ns")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
;;==== SWP|TX 032k - #34bM Adversarial Proof (2-hop rejection) · 01 · let / invocation ==== ============
(print "--- [SWP|TX 032k - #34bM Adversarial Proof (2-hop rejection) · 01 · let / invocation] ---")
(let
    (
        (ref-DALOS:module{OuronetDalosV2} DALOS)
        (ref-TS01-C3:module{TalosStageOne_ClientThreeV4} TS01-C3)
        (split-stoa:[decimal]
            (ref-DALOS::URC_SplitSTOAPrices
                KST.ANHD
                (+ (ref-DALOS::UR_UsagePrice "dptf") (ref-DALOS::UR_UsagePrice "swp"))
            )
        )
    )
;;==== SWP|TX 032k - #34bM Adversarial Proof (2-hop rejection) · 02 · env-sigs (caps) ==== =============
(print "--- [SWP|TX 032k - #34bM Adversarial Proof (2-hop rejection) · 02 · env-sigs (caps)] ---")
    ;;Full coin.TRANSFER caps granted here (unlike an earlier attempt at this
    ;;same test) — so the ONLY possible failure is the anchoring enforce itself,
    ;;not a confounding missing-fee-capability error masking the real result.
    (env-sigs
        [
            { "key": "PK_AncientHodler", "caps": [] }
            { "key": "6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263" ,
              "caps":
                [
                    (coin.TRANSFER
                        "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263"
                        "k:50d6c59b21e5e6e55baecaa75a1007de37576bde12d8230dc82459cc01b9484b"
                        (at 2 split-stoa)
                    )
                    (coin.TRANSFER
                        "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263"
                        "k:0cb30c0121ff919266121a99ff9359871818932211df94dae4137c29bc0e8f7e"
                        (at 0 split-stoa)
                    )
                    (coin.TRANSFER
                        "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263"
                        "c:XM-pkmuB5XUQlp87ZYSbfKt8qzmHY6O2EHAzMRVBt3k"
                        (at 3 split-stoa)
                    )
                    (coin.TRANSFER
                        "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263"
                        "c:iQQFWj6gWtpGEzhM_O5ekW1QtnQQy55R8BRPGhj_0FU"
                        (at 1 split-stoa)
                    )
                ]
            }
        ]
    )
    ;;TSTM is 2 hops from a principal (TSTM -> TSTN -> OURO), never directly
    ;;pooled with one. #34bM fix: must be REJECTED — the owner's design is
    ;;direct-adjacency only, not transitive/multi-hop BFS reachability.
    (map print
        [
            (expect-failure
                "S|TSTM|TSTQ rejected — TSTM is only transitively (2-hop), not \
                \ directly, connected to a principal (#34bM fix)"
                (ref-TS01-C3::SWP|C_IssueStable KST.ANHD KST.ANHD
                    [
                        { "token-id": "TSTM-98c486052a51", "token-supply": 800.0}
                        { "token-id": "TSTQ-98c486052a51", "token-supply": 800.0}
                    ]
                    10.0 10.0 false
                )
            )
        ]
    )
)
