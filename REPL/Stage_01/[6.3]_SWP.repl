(begin-tx "SWP|TX 016g - #27M/M13 Adversarial Proof Swap")
(namespace "ouronet-ns")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
;;==== SWP|TX 016g - #27M/M13 Adversarial Proof Swap · 01 · env-sigs (caps) ==== =====================
(print "--- [SWP|TX 016g - #27M/M13 Adversarial Proof Swap · 01 · env-sigs (caps)] ---")
(env-sigs
    [
        { "key": "PK_AncientHodler", "caps": [] }
    ]
)
;;==== SWP|TX 016g - #27M/M13 Adversarial Proof Swap · 02 · let / invocation ==== ====================
(print "--- [SWP|TX 016g - #27M/M13 Adversarial Proof Swap · 02 · let / invocation] ---")
(let
    (
        (ref-SWP:module{SwapperV4} SWP)
        (ref-SWPI:module{SwapperIssueV4} SWPI)
        (ref-TS01-C3:module{TalosStageOne_ClientThreeV4} TS01-C3)
        (poolP:string "P|OURO-98c486052a51|TSTY-98c486052a51")
        (poolQ:string "W|OURO-98c486052a51|TSTY-98c486052a51")
        (cached-P-before:decimal (ref-SWP::UR_StoaValue poolP))
        (cached-Q-before:decimal (ref-SWP::UR_StoaValue poolQ))
        (swap-result:string
            (ref-TS01-C3::SWP|CC_SmartSwapNoSlippage
                KST.ANHD
                KST.ANHD
                "OURO-98c486052a51"
                1500.0
                "TSTY-98c486052a51"
            )
        )
        (cached-P-after:decimal (ref-SWP::UR_StoaValue poolP))
        (cached-Q-after:decimal (ref-SWP::UR_StoaValue poolQ))
        (fresh-P-after:decimal (at 0 (ref-SWPI::URC_PoolValue poolP)))
        (fresh-Q-after:decimal (at 0 (ref-SWPI::URC_PoolValue poolQ)))
    )
    (map print
        [
            (format "Swap result: {}" [swap-result])
            (format "poolP (actually swapped)   cached-before={} cached-after={} fresh-after={}" [cached-P-before cached-P-after fresh-P-after])
            (format "poolQ (never touched)      cached-before={} cached-after={} fresh-after={}" [cached-Q-before cached-Q-after fresh-Q-after])
            ;;#27M/M13 adversarial proof: poolP/poolQ are two brand-new isolated pools
            ;;(P|OURO|TSTY constant-product, W|OURO|TSTY equal-weighted — same math,
            ;;different prefix so both register as parallel edges) sized so BFS picks
            ;;poolP pre-swap (better rate) but poolQ post-swap (poolP's rate collapses
            ;;from the swap itself). Reverting the fix (temporarily, adversarially)
            ;;reproduced the exact bug: poolP stayed cached at 0.0 (never refreshed,
            ;;stale) while poolQ was spuriously bumped to its fresh value despite never
            ;;being swapped. These assertions pin the FIXED behavior.
            (expect
                "Smart swap actually executed (not the slippage-rejection branch)"
                true
                (contains "Succesfully smart-swapped" swap-result)
            )
            (expect
                "poolP (the pool ACTUALLY swapped) must be refreshed — cached value \
                \ must match a fresh recompute, not stay at its pre-swap default"
                fresh-P-after
                cached-P-after
            )
            (expect
                "poolP's cache must have actually moved off its pre-swap default \
                \ (guards against a vacuous pass if fresh-P-after happened to be 0.0)"
                true
                (!= cached-P-after cached-P-before)
            )
            (expect
                "poolQ (never swapped) must NOT receive a spurious refresh — cached \
                \ value stays at its pre-swap default"
                cached-Q-before
                cached-Q-after
            )
            (expect
                "poolQ's true value is genuinely nonzero and differs from its cached \
                \ default (guards against a vacuous pass if Q's real value were 0.0)"
                true
                (!= fresh-Q-after cached-Q-after)
            )
        ]
    )
    ""
)
(print "")
(print "")
;;==== SWP|TX 016g - #27M/M13 Adversarial Proof Swap · 03 · gas echo ==== =============================
(print "--- [SWP|TX 016g - #27M/M13 Adversarial Proof Swap · 03 · gas echo] ---")
(format "<<<<<<<SWP|TX 016g #27M Proof Swap ==> {} STOA GAS>>>>>>>" [(env-gas)])
(print "")
(print "")
(print "===^^^===")
(env-sigs [])
(commit-tx)
