(begin-tx "SWP|TX 032z6f - #65fL Phase 8b / #73C OURO Shortcut Gas + Correctness Proof (Permanent)")
(namespace "ouronet-ns")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(print "--- [SWP|TX 032z6f - #65fL Phase 8b / #73C Proof · 01 · env-sigs (caps)] ---")
(env-sigs [ { "key": "PK_AncientHodler", "caps": [] } ])
;;#65fL Phase 8b: URC_WorthWSTOA's own id==OURO shortcut (URC_SingleOuroWorthWSTOA) vs the
;;graph-search path (URC_Hopper ouro->DWK, reproduced directly here for comparison) — the exact
;;fallback URC_WorthWSTOA uses for every id that isn't WSTOA/SSTOA/OURO.
;;#73C fix (owner-directed, 2026-08-29): originally this proof only asserted the shortcut was
;;non-zero and printed the diff, honestly flagged as NOT expected to be close (the shortcut's old
;;<primordial-wstoa-value / ouro-supply> ratio silently ignored the primordial pool's own weights
;;— SSTOA 0.3 / OURO 0.5 / WSTOA 0.2, genuinely unequal — undervaluing OURO by ~38% against a
;;real weighted-pool swap). Fixed by sourcing the shortcut from a real 1-unit weighted-pool swap
;;(URC_W-Swap) instead of the hand-rolled ratio. Now the two SHOULD agree closely: the shortcut is
;;the pure marginal/spot price (no slippage), the graph search is a real simulated swap of the
;;full <amount> (genuine AMM slippage for that trade size) — shortcut should be >= graph search,
;;by a small amount reflecting only honest slippage, not a large, silent methodology error.
(print "--- [SWP|TX 032z6f - #65fL Phase 8b / #73C Proof · 02 · direct comparison] ---")
(let*
    (
        (ref-SWPI:module{SwapperIssueV4} SWPI)
        (ref-DALOS:module{OuronetDalosV2} DALOS)
        (ouro:string "OURO-98c486052a51")
        (dwk:string (ref-DALOS::UR_WrappedStoaID))
        (amount:decimal 100.0)
    )
    (env-gas 0)
    (let
        (
            (shortcut-result:decimal (ref-SWPI::URC_WorthWSTOA ouro amount))
        )
        (print (format "#65fL Phase 8b: URC_WorthWSTOA(OURO, {}) via shortcut = {}, gas: {}" [amount shortcut-result (env-gas)]))
        (env-gas 0)
        (let
            (
                (h-obj:object{SwapperIssueV4.Hopper} (ref-SWPI::URC_Hopper ouro dwk amount))
                (ovs:[decimal] (at "output-values" h-obj))
                (graph-search-result:decimal (if (= (length ovs) 0) 0.0 (at 0 (take -1 ovs))))
                (abs-diff:decimal (- shortcut-result graph-search-result))
            )
            (print (format "#65fL Phase 8b: URC_Hopper(OURO->DWK, {}) via graph search = {}, gas: {}" [amount graph-search-result (env-gas)]))
            (map print
                [
                    (expect "#65fL Phase 8b: shortcut result is genuinely non-zero (real primordial-pool data, not an empty fallback)" true (> shortcut-result 0.0))
                    (expect "#73C: shortcut (marginal spot price) is now >= graph search (real execution price with slippage) — the marginal price is always at least as good as the average price paid on a real trade"
                        true (>= shortcut-result graph-search-result))
                    (expect "#73C: shortcut and graph search now agree within honest slippage (< 5% apart) — NOT the pre-fix ~38% weight-omission gap"
                        true (< abs-diff (* graph-search-result 0.05)))
                    (format "#65fL/#73C: value difference (shortcut - graph search) = {}" [abs-diff])
                ]
            )
        )
    )
)
(env-sigs [])
(commit-tx)
