(begin-tx "SWP|TX 032q - P0.5 Worst-Case 6-Hop SmartSwap Gas Measurement")
(namespace "ouronet-ns")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
;;==== SWP|TX 032q - P0.5 Worst-Case Gas Measurement · 01 · env-sigs (caps) ==== =========================
(print "--- [SWP|TX 032q - P0.5 Worst-Case Gas Measurement · 01 · env-sigs (caps)] ---")
(env-sigs
    [
        { "key": "PK_AncientHodler", "caps": [] }
    ]
)
;;==== SWP|TX 032q - P0.5 Worst-Case Gas Measurement · 02 · let / invocation ==== ========================
(print "--- [SWP|TX 032q - P0.5 Worst-Case Gas Measurement · 02 · let / invocation] ---")
;;Liquid Boost is a GLOBAL toggle (SWP::UR_LiquidBoost) — when on, every pool's
;;"boost" fee component equals its lp-fee (UDC_PoolFees: boost-fee = (if lb
;;lp-fee 0.0)) instead of 0.0, which makes XI_LiquidIndexPump fire on every hop.
;;Confirmed via diagnostic it defaults to false this deep into the pipeline, so
;;the true worst case must explicitly turn it on for this measurement — and back
;;off immediately after, since it's global and would otherwise silently change
;;every fee computation for the rest of this file's later transactions.
(let
    (
        (ref-TS01-A:module{TalosStageOne_AdminV2} TS01-A)
    )
    (ref-TS01-A::SWP|A_UpdateLiquidBoost true)
)
;;P0.6 direction 5: XI_SmartSwapCore now carries the Liquid Boost cut forward
;;hop-by-hop (SWPI::URC_Swap over each hop's own already-selected edge, no
;;search) and only prices-and-burns once, on the LAST hop — this intentionally
;;produces a DIFFERENT total DLK burn than the old per-hop-independent-search
;;design (it follows the swap's own route, not each hop's individually-best
;;route to DLK). Printing the actual DLK burned here so that shift is visible,
;;not silent — SWP|SC_NAME's own DLK balance is what C_Burn debits.
(let*
    (
        (ref-DALOS:module{OuronetDalosV2} DALOS)
        (ref-DPTF:module{DemiourgosPactTrueFungibleV2} DPTF)
        (sstoa:string (ref-DALOS::UR_SilverStoaID))
        (swp-sc:string (ref-DALOS::GOV|SWP|SC_NAME))
        (dlk-before:decimal (ref-DPTF::UR_AccountSupply sstoa swp-sc))
        (ref-TS01-C3:module{TalosStageOne_ClientThreeV4} TS01-C3)
        (swap-result:string
            (ref-TS01-C3::SWP|CC_SmartSwapNoSlippage
                KST.ANHD
                KST.ANHD
                "W1-98c486052a51"
                10.0
                "W7-98c486052a51"
            )
        )
        (dlk-after:decimal (ref-DPTF::UR_AccountSupply sstoa swp-sc))
    )
    (map print
        [
            (format "P0.5 worst-case swap result (Liquid Boost ON): {}" [swap-result])
            (expect
                "Smart swap actually executed the full 6-hop route (not a shorter shortcut)"
                true
                (contains "via 6 Swaps" swap-result)
            )
            (format "P0.6 direction 5 — DLK burned by this swap's single end-of-route Liquid Boost pump: {}" [(- dlk-before dlk-after)])
        ]
    )
)
(print "")
(print "")
;;==== SWP|TX 032q - P0.5 Worst-Case Gas Measurement · 03 · gas echo ==== ================================
(print "--- [SWP|TX 032q - P0.5 Worst-Case Gas Measurement · 03 · gas echo] ---")
(print (format "<<<<<<<SWP|TX 032q P0.5 WORST-CASE 6-HOP SMARTSWAP (Liquid Boost ON) ==> {} STOA GAS>>>>>>>" [(env-gas)]))
(print "")
(print "")
(let
    (
        (ref-TS01-A:module{TalosStageOne_AdminV2} TS01-A)
    )
    ;;Restore — must not leak into the rest of the file's later transactions.
    (ref-TS01-A::SWP|A_UpdateLiquidBoost false)
)
(print "===^^^===")
(env-sigs [])
(commit-tx)
