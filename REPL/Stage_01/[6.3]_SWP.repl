(begin-tx "SWP|TX 032a - #31M/M7 Owner-Auth Adversarial Proof")
(namespace "ouronet-ns")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
;;==== SWP|TX 032a - #31M/M7 Owner-Auth Adversarial Proof · 01 · let / invocation ==== ==============
(print "--- [SWP|TX 032a - #31M/M7 Owner-Auth Adversarial Proof · 01 · let / invocation] ---")
(let
    (
        (ref-TS01-C3:module{TalosStageOne_ClientThreeV4} TS01-C3)
        (ref-SWP:module{SwapperV4} SWP)
        ;;pool5 — owned by KST.ANHD, untouched by SWP|TX 032, neither flag enabled yet.
        (pool5:string "P|OURO-98c486052a51|BUSD-98c486052a51")
    )
;;==== SWP|TX 032a - #31M/M7 Owner-Auth Adversarial Proof · 02 · env-sigs (caps) ==== ================
(print "--- [SWP|TX 032a - #31M/M7 Owner-Auth Adversarial Proof · 02 · env-sigs (caps)] ---")
    ;;Non-owner (Emma) alone — no PK_AncientHodler signature — attempts to trigger
    ;;irreversible Frozen/Sleeping LP on a pool she does not own.
    (env-sigs
        [
            { "key": "PK_Emma", "caps": [] }
        ]
    )
    (map print
        [
            (expect-failure
                "Non-owner cannot enable Frozen LP on someone else's pool (#31M/M7 fix)"
                (ref-TS01-C3::SWP|C_EnableFrozenLP KST.EMMA pool5)
            )
            (expect-failure
                "Non-owner cannot enable Sleeping LP on someone else's pool (#31M/M7 fix)"
                (ref-TS01-C3::SWP|C_EnableSleepingLP KST.EMMA pool5)
            )
            (expect
                "Frozen LP must still read false — the rejected non-owner call must not have mutated state"
                false
                (ref-SWP::UR_IzFrozenLP pool5)
            )
            (expect
                "Sleeping LP must still read false — the rejected non-owner call must not have mutated state"
                false
                (ref-SWP::UR_IzSleepingLP pool5)
            )
        ]
    )
)
(print "")
(print "")
