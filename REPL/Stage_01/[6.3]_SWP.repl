    (env-sigs
        [
            { "key": "PK_AncientHodler", "caps": [] }
            { "key": "6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263" ,
              "caps":
                [
                    (coin.TRANSFER
                        "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263"
                        "k:50d6c59b21e5e6e55baecaa75a1007de37576bde12d8230dc82459cc01b9484b"
                        (at 2 split-stoa)
                    )
                    (coin.TRANSFER
                        "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263"
                        "k:0cb30c0121ff919266121a99ff9359871818932211df94dae4137c29bc0e8f7e"
                        (at 0 split-stoa)
                    )
                    (coin.TRANSFER
                        "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263"
                        "c:XM-pkmuB5XUQlp87ZYSbfKt8qzmHY6O2EHAzMRVBt3k"
                        (at 3 split-stoa)
                    )
                    (coin.TRANSFER
                        "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263"
                        "c:iQQFWj6gWtpGEzhM_O5ekW1QtnQQy55R8BRPGhj_0FU"
                        (at 1 split-stoa)
                    )
                ]
            }
        ]
    )
    ;;Pool AN: OURO (principal, first) + TSTN — valid W/P anchoring. TSTN is now
    ;;genuinely DIRECTLY pooled with a principal.
    (ref-TS01-C3::SWP|C_IssueStandard KST.ANHD KST.ANHD
        [
            { "token-id": "OURO-98c486052a51", "token-supply": 800.0}
            { "token-id": "TSTN-98c486052a51", "token-supply": 800.0}
        ]
        25.0 false
    )
    ;;Pool NM: TSTN (first) + TSTM — Stable. TSTN is directly principal-adjacent
    ;;(via pool AN just above), so this passes under both old and new logic —
    ;;this is the legitimate "S|AG|AL" case. TSTM's ONLY connection after this
    ;;is to TSTN (not itself a principal, just principal-adjacent).
    (ref-TS01-C3::SWP|C_IssueStable KST.ANHD KST.ANHD
        [
            { "token-id": "TSTN-98c486052a51", "token-supply": 800.0}
            { "token-id": "TSTM-98c486052a51", "token-supply": 800.0}
        ]
        10.0 10.0 false
    )
)
