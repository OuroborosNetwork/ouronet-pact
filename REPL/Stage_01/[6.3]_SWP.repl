(begin-tx "SWP|TX 032z8c - #65fL Minor-Principal Pool Repricing Spectrum Proof (Permanent)")
(namespace "ouronet-ns")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(print "--- [SWP|TX 032z8c - Minor-Principal Repricing Spectrum · 01 · env-sigs (caps)] ---")
(env-sigs [ { "key": "PK_AncientHodler", "caps": [] } ])
;;#65fL: completes the spectrum owner asked for — major-anchored (SWP|TX 032z8b, 3,524 gas,
;;zero search) vs a REALISTIC minor-principal-anchored pool (MPTEST, 1 hop from OURO — the
;;cheapest shape a minor principal's own reachability can realistically take) vs the
;;deliberately-adversarial worst case (W7, 8 hops — the SAME real pool SWP|TX 032q's own
;;6-hop worst-case scenario already depends on, measured here in ISOLATION instead of buried
;;inside that whole transaction's total).
(print "--- [SWP|TX 032z8c - Minor-Principal Repricing Spectrum · 02 · direct measurement] ---")
(let*
    (
        (ref-SWPI:module{SwapperIssueV4} SWPI)
        (ref-SWP:module{SwapperV4} SWP)
        (realistic-minor-pool:string "P|MPTEST-98c486052a51|OURO-98c486052a51")
        (worstcase-minor-pool:string "S|W7-98c486052a51|W6-98c486052a51|W6A-98c486052a51|W6B-98c486052a51|W6C-98c486052a51|W6D-98c486052a51|W6E-98c486052a51")
        (realistic-first-token:string (at 0 (ref-SWP::UR_PoolTokens realistic-minor-pool)))
        (worstcase-first-token:string (at 0 (ref-SWP::UR_PoolTokens worstcase-minor-pool)))
    )
    (map print
        [
            (expect "#65fL: sanity — realistic-minor pool's first token genuinely is MPTEST" "MPTEST-98c486052a51" realistic-first-token)
            (expect "#65fL: sanity — worst-case-minor pool's first token genuinely is W7 (the same adversarially-far principal SWP|TX 032q depends on)" "W7-98c486052a51" worstcase-first-token)
        ]
    )
    (env-gas 0)
    (let
        (
            (realistic-worth:[decimal] (ref-SWPI::URC_PoolValue realistic-minor-pool))
        )
        (print (format "#65fL: URC_PoolValue(realistic minor-principal pool, MPTEST 1-hop-from-OURO) = {}, gas: {}" [realistic-worth (env-gas)]))
    )
    (env-gas 0)
    (let
        (
            (worstcase-worth:[decimal] (ref-SWPI::URC_PoolValue worstcase-minor-pool))
        )
        (map print
            [
                (expect "#65fL: worst-case-minor pool's worth is genuinely non-zero (real reachability via the sole OURO-W1 bridge, not an empty fallback)" true (> (at 0 worstcase-worth) 0.0))
                (format "#65fL: URC_PoolValue(worst-case minor-principal pool, W7 8-hops-from-DWK) = {}, gas: {}" [worstcase-worth (env-gas)])
            ]
        )
    )
)
(env-sigs [])
(commit-tx)
