;;==== SWP|TX 014 - Enable Pools Functionality · 02 · let / invocation ==== =======================
(print "--- [SWP|TX 014 - Enable Pools Functionality · 02 · let / invocation] ---")
(let
    (
        (ref-TS01-A:module{TalosStageOne_AdminV2} TS01-A)
        (ref-TS01-C3:module{TalosStageOne_ClientThreeV4} TS01-C3)
        (pool1:string "W|DLK-98c486052a51|OURO-98c486052a51|DWK-98c486052a51")
        (pool2:string "S|DLK-98c486052a51|OURO-98c486052a51|DWK-98c486052a51")
        (pool3:string "P|OURO-98c486052a51|PKOSON-98c486052a51")
        (pool4:string "S|PKOSON-98c486052a51|EKOSON-98c486052a51|AKOSON-98c486052a51")
        (pool5:string "P|OURO-98c486052a51|BUSD-98c486052a51")
        (pool6:string "P|OURO-98c486052a51|VST-98c486052a51")
        (pool6a:string "P|OURO-98c486052a51|BUSD-98c486052a51|TUSD-98c486052a51|VST-98c486052a51")
        (pool7:string "S|BUSD-98c486052a51|TUSD-98c486052a51|USDT-98c486052a51|USDC-98c486052a51|USDD-98c486052a51|AUSD-98c486052a51|CUSD-98c486052a51")
        (pool8:string "W|OURO-98c486052a51|TEUR-98c486052a51|EURT-98c486052a51|EURC-98c486052a51|EURD-98c486052a51|AEUR-98c486052a51|CEUR-98c486052a51")
        (spt1:[object{SwapperV4.FeeSplit}]
            [
                {"target":KST.BYTA, "value":15}
                {"target":KST.LUMY, "value":125}
                {"target":KST.COCA, "value":35}
                {"target":KST.KISS, "value":35}
                {"target":KST.PLCS, "value":50}
                {"target":KST.NANI, "value":60}
                {"target":KST.AOZT, "value":10}
            ]
        )
        (spt2:[object{SwapperV4.FeeSplit}]
            [
                {"target":KST.BYTA, "value":15}
                {"target":KST.LUMY, "value":125}
                {"target":KST.COCA, "value":35}
                {"target":KST.KISS, "value":35}
                {"target":KST.PLCS, "value":50}
                {"target":KST.NANI, "value":60}
                {"target":KST.AOZT, "value":10}
            ]
        )
    )
    ;;Add Special Fee
    (ref-TS01-C3::SWP|C_UpdateFee KST.ANHD pool1 20.0 false)
    (ref-TS01-C3::SWP|C_UpdateFee KST.ANHD pool2 20.0 false)
    (ref-TS01-C3::SWP|C_UpdateFee KST.ANHD pool3 20.0 false)
    (ref-TS01-C3::SWP|C_UpdateFee KST.ANHD pool4 20.0 false)
    (ref-TS01-C3::SWP|C_UpdateFee KST.ANHD pool5 20.0 false)
    (ref-TS01-C3::SWP|C_UpdateFee KST.ANHD pool6 20.0 false)
    (ref-TS01-C3::SWP|C_UpdateFee KST.ANHD pool6a 50.0 false)
    (ref-TS01-C3::SWP|C_UpdateFee KST.ANHD pool7 20.0 false)
    (ref-TS01-C3::SWP|C_UpdateFee KST.ANHD pool8 20.0 false)
    ;;Add Fee Targets
    (ref-TS01-C3::SWP|C_UpdateSpecialFeeTargets KST.ANHD pool1 spt2)
    (ref-TS01-C3::SWP|C_UpdateSpecialFeeTargets KST.ANHD pool2 spt2)
    (ref-TS01-C3::SWP|C_UpdateSpecialFeeTargets KST.ANHD pool3 spt1)
    (ref-TS01-C3::SWP|C_UpdateSpecialFeeTargets KST.ANHD pool4 spt1)
    ;(ref-TS01-C3::SWP|C_UpdateSpecialFeeTargets KST.ANHD pool5 spt2)
    (ref-TS01-C3::SWP|C_UpdateSpecialFeeTargets KST.ANHD pool6 spt2)
    (ref-TS01-C3::SWP|C_UpdateSpecialFeeTargets KST.ANHD pool6a spt2)
    (ref-TS01-C3::SWP|C_UpdateSpecialFeeTargets KST.ANHD pool7 spt2)
    (ref-TS01-C3::SWP|C_UpdateSpecialFeeTargets KST.ANHD pool8 spt2)
    ;;Enable Asymetric Liquidity Addition and Primordial Pool
    (ref-TS01-A::SWP|A_DefinePrimordialPool pool1)
    (ref-TS01-A::SWP|A_ToggleAsymetricLiquidityAddition true)
    ;;Toggle Add Liquidity
    (ref-TS01-C3::SWP|C_ToggleAddLiquidity KST.ANHD pool1 true)
    (ref-TS01-C3::SWP|C_ToggleAddLiquidity KST.ANHD pool2 true)
    (ref-TS01-C3::SWP|C_ToggleAddLiquidity KST.ANHD pool3 true)
    (ref-TS01-C3::SWP|C_ToggleAddLiquidity KST.ANHD pool4 true)
    (ref-TS01-C3::SWP|C_ToggleAddLiquidity KST.ANHD pool5 true)
    (ref-TS01-C3::SWP|C_ToggleAddLiquidity KST.ANHD pool6 true)
    (ref-TS01-C3::SWP|C_ToggleAddLiquidity KST.ANHD pool6a true)
    (ref-TS01-C3::SWP|C_ToggleAddLiquidity KST.ANHD pool7 true)
    (ref-TS01-C3::SWP|C_ToggleAddLiquidity KST.ANHD pool8 true)
    ;;Toggle Swap Functionality
    (ref-TS01-C3::SWP|C_ToggleSwapCapability KST.ANHD pool1 true)
    (ref-TS01-C3::SWP|C_ToggleSwapCapability KST.ANHD pool2 true)
    (ref-TS01-C3::SWP|C_ToggleSwapCapability KST.ANHD pool3 true)
    (ref-TS01-C3::SWP|C_ToggleSwapCapability KST.ANHD pool4 true)
    (ref-TS01-C3::SWP|C_ToggleSwapCapability KST.ANHD pool5 true)
