(begin-tx "SWP|TX 032z8d - #65hL Targeted-BFS Early-Exit Proof (Permanent)")
(namespace "ouronet-ns")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(print "--- [SWP|TX 032z8d - Targeted-BFS Early-Exit Proof · 01 · env-sigs (caps)] ---")
(env-sigs [ { "key": "PK_AncientHodler", "caps": [] } ])
;;#65hL: owner asked whether the search algorithm itself could be made
;;cheaper "if something is closer" — BFS as an algorithm CLASS was already
;;optimal for this unweighted shortest-path problem, but the IMPLEMENTATION
;;never exploited BFS's own early-termination property: <UC_BFS> always
;;computed shortest chains to EVERY reachable node before the caller
;;post-filtered down to the one target needed. <UC_BFSTargeted> stops once
;;<target> is first visited — correct because BFS visits nodes in
;;strictly non-decreasing distance order, so a node's shortest chain is
;;fixed the first time it's seen; nothing recorded for <target> can change
;;by continuing to explore other nodes afterward. This proof compares the
;;OLD, still-fully-intact <UC_BFS> (used unchanged by
;;<URC_ShortestChainPerNode> for any caller wanting chains to every
;;reachable node) against the NEW <UC_BFSTargeted> (used by
;;<URC_ComputeGraphPath> via <URCx_ShortestChainToTarget>) on the exact
;;same real ~102-active-pool topology and the same deliberately-adversarial
;;6-hop pair (W1 -> W7, the same pair SWP|TX 032z2b/#38M/M4 isolates) —
;;both functions remain real, permanent production code paths, so this
;;stays a fair, honest, non-transient before/after comparison forever.
(print "--- [SWP|TX 032z8d - Targeted-BFS Early-Exit Proof · 02 · UC_BFS vs UC_BFSTargeted, same graph] ---")
(let*
    (
        (ref-SWP:module{SwapperV4} SWP)
        (ref-SWPT:module{SwapTracerV3} SWPT)
        (ref-U|BFS:module{BreadthFirstSearchV2} U|BFS)
        (active-swpairs:[string] (ref-SWP::URC_ActiveSwpairs))
        (graph:[object{BreadthFirstSearchV2.GraphNode}]
            (ref-SWPT::URC_MakeGraph "W1-98c486052a51" "W7-98c486052a51" active-swpairs))
    )
    (env-gas 0)
    (let
        (
            (old-bfs:object{BreadthFirstSearchV2.BFS}
                (ref-U|BFS::UC_BFS graph "W1-98c486052a51"))
        )
        (print (format "#65hL: OLD UC_BFS (full reachable-set expansion) gas: {}" [(env-gas)]))
    )
    (env-gas 0)
    (let
        (
            (new-bfs:object{BreadthFirstSearchV2.BFS}
                (ref-U|BFS::UC_BFSTargeted graph "W1-98c486052a51" "W7-98c486052a51"))
        )
        (print (format "#65hL: NEW UC_BFSTargeted (stops once W7 first visited) gas: {}" [(env-gas)]))
    )
    (let
        (
            (old-chains:[[string]] (at "chains" (ref-U|BFS::UC_BFS graph "W1-98c486052a51")))
            (new-chains:[[string]] (at "chains" (ref-U|BFS::UC_BFSTargeted graph "W1-98c486052a51" "W7-98c486052a51")))
            (target-chain-old:[string]
                (at 0
                    (filter (lambda (c:[string]) (= (at 0 (take -1 c)) "W7-98c486052a51")) old-chains)
                )
            )
            (target-chain-new:[string]
                (at 0
                    (filter (lambda (c:[string]) (= (at 0 (take -1 c)) "W7-98c486052a51")) new-chains)
                )
            )
        )
        (map print
            [
                (expect "#65hL: UC_BFSTargeted's own recorded chain to W7 is byte-identical to UC_BFS's — early-exit changes cost, never correctness"
                    target-chain-old
                    target-chain-new
                )
                (expect "#65hL: UC_BFSTargeted visits strictly fewer-or-equal nodes than the full UC_BFS scan (it stops once W7 is found instead of exploring the whole graph)"
                    true
                    (<= (length new-chains) (length old-chains))
                )
            ]
        )
    )
)
(env-sigs [])
(commit-tx)
;;||>>>>>>>>>>>>>>>>>>>>>>>>>
;;|| NEXT                   >
;;||>>>>>>>>>>>>>>>>>>>>>>>>>
(begin-tx "SWP|TX 032z8e - #73C Depth-Skew Proportionality Proof (Permanent)")
(namespace "ouronet-ns")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(print "--- [SWP|TX 032z8e - #73C Depth-Skew Proportionality Proof · 01 · env-sigs (caps)] ---")
(env-sigs [])
;;#73C: owner's own finding — "worth of a big amount" computed by simulating a REAL swap
;;of that whole amount is NOT proportional to "worth of 1 unit" x amount, once the amount
;;is large enough to eat into real pool depth (AMM slippage). URC_WorthWSTOA's graph-search
;;fallback used to do exactly that (simulate a swap of the FULL requested amount) — and
;;URC_PoolValue's own real caller passes a POOL'S ENTIRE reserve as that amount, so this
;;wasn't a hypothetical edge case, it was the function's actual, everyday call pattern.
;;Fixed by pricing exactly 1 unit through the real route, then scaling linearly — this
;;proof asserts the fixed behavior is now EXACTLY proportional (by construction), and the
;;adversarial revert (recorded in ROUND-02-FIXES.md, not repeated as a live test here)
;;confirmed the pre-fix code was NOT: worth(300) came back as 272.09 (rate 0.907/unit)
;;instead of 300 x the true 1-unit rate (1.496/unit, worth=448.71) — a 39% collapse purely
;;from an unrealistic "swap the whole holding in one shot" simulation.
(print "--- [SWP|TX 032z8e - #73C Depth-Skew Proportionality Proof · 02 · direct comparison] ---")
(let*
    (
        (ref-SWPI:module{SwapperIssueV4} SWPI)
        (mptest:string "MPTEST-98c486052a51")
        (small:decimal 1.0)
        (large:decimal 300.0)
        (worth-small:decimal (ref-SWPI::URC_WorthWSTOA mptest small))
        (worth-large:decimal (ref-SWPI::URC_WorthWSTOA mptest large))
        (rate-small:decimal (/ worth-small small))
        (rate-large:decimal (/ worth-large large))
    )
    (map print
        [
            (expect "#73C: worth(1 unit) is genuinely non-zero (real route, not an empty fallback)" true (> worth-small 0.0))
            (expect (format "#73C: worth({}) is EXACTLY {} x worth(1) — no depth-skew, by construction" [large large])
                (floor (* large worth-small) 24)
                worth-large
            )
            (format "#73C: worth({})={}, rate={} | worth({})={}, rate={} | rate ratio={}"
                [small worth-small rate-small large worth-large rate-large (/ rate-large rate-small)])
        ]
    )
)
(env-sigs [])
(commit-tx)
;;||>>>>>>>>>>>>>>>>>>>>>>>>>
;;|| NEXT                   >
;;||>>>>>>>>>>>>>>>>>>>>>>>>>
(begin-tx "SWP|TX 032z8 - #34 Phase 10 Adversarial Malformed-Bundle Proof (Permanent)")
(namespace "ouronet-ns")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
;;==== SWP|TX 032z8 - Adversarial Malformed-Bundle Proof · 01 · env-sigs (caps) ====
(print "--- [SWP|TX 032z8 - Adversarial Malformed-Bundle Proof · 01 · env-sigs (caps)] ---")
(env-sigs
    [
        { "key": "PK_AncientHodler", "caps": [] }
    ]
)
;;#34 Phase 10: proves the bundle-based path's validation model actually rejects
;;malformed/adversarial input, not just in theory. Two categories, per the
;;architecture doc's §2 split:
;;1) swap-route (funds-moving) — any structural/endpoint/depth-cap/active violation
;;   must abort the WHOLE transaction, cleanly, before any state changes
;;   (SWPU|X>SMART-SWAP-EXPLICIT-ROUTE's defcap enforces run before the body).
;;2) boost-path/stoa-paths (pricing-only) — malformed data must degrade gracefully
;;   instead: the swap still succeeds, the bad path is simply never used/priced,
;;   never a crash, never a corrupted state.
;;==== SWP|TX 032z8 - Adversarial Malformed-Bundle Proof · 02 · swap-route rejections ====
(print "--- [SWP|TX 032z8 - Adversarial Malformed-Bundle Proof · 02 · swap-route rejections] ---")
(let*
    (
        (ref-TS01-C3:module{TalosStageOne_ClientThreeV4} TS01-C3)
        (input-id "W1-98c486052a51")
        (output-id "W7-98c486052a51")
        (stub-boost {"nodes" : [], "edges" : [], "is-new" : false})
        (wrong-endpoint-bundle
            {"swap-route" :
                {"nodes" : ["W1-98c486052a51" "W2-98c486052a51"]
                ,"edges" : ["S|W1-98c486052a51|W2-98c486052a51|W1A-98c486052a51|W1B-98c486052a51|W1C-98c486052a51|W1D-98c486052a51|W1E-98c486052a51"]}
            ,"boost-path" : stub-boost
            ,"stoa-paths" : []}
        )
        (depth-cap-bundle
            {"swap-route" :
                {"nodes" : [input-id "FAKE1" "FAKE2" "FAKE3" "FAKE4" "FAKE5" "FAKE6" output-id]
                ,"edges" : ["e1" "e2" "e3" "e4" "e5" "e6" "e7"]}
            ,"boost-path" : stub-boost
            ,"stoa-paths" : []}
        )
        (fabricated-edge-bundle
            {"swap-route" :
                {"nodes" : [input-id output-id]
                ,"edges" : ["TotallyMadeUpSwpairThatIsNotReal"]}
            ,"boost-path" : stub-boost
            ,"stoa-paths" : []}
        )
        (inactive-edge-bundle
            {"swap-route" :
                {"nodes" : ["W1-98c486052a51" "OURO-98c486052a51"]
                ,"edges" : ["P|OURO-98c486052a51|W1-98c486052a51"]}
            ,"boost-path" : stub-boost
            ,"stoa-paths" : []}
        )
    )
    (map print
        [
            (expect-failure
                "Adversarial: swap-route claiming input-id but ending at a different (real, connected) token is rejected"
                (ref-TS01-C3::SWP|C_SmartSwapNoSlippage KST.ANHD KST.ANHD input-id 1.0 output-id wrong-endpoint-bundle)
            )
            (expect-failure
                "Adversarial: swap-route exceeding the P0.4 depth cap (8 nodes) is rejected"
                (ref-TS01-C3::SWP|C_SmartSwapNoSlippage KST.ANHD KST.ANHD input-id 1.0 output-id depth-cap-bundle)
            )
            (expect-failure
                "Adversarial: swap-route with a fabricated, non-existent pool as its edge is rejected"
                (ref-TS01-C3::SWP|C_SmartSwapNoSlippage KST.ANHD KST.ANHD input-id 1.0 output-id fabricated-edge-bundle)
            )
        ]
    )
    ;;Inactive-edge case needs the pool actually toggled off first (a genuinely real,
    ;;structurally-connected, but can-swap=false pool) — same revert/restore pattern
    ;;as SWP|TX 032z5.
    (ref-TS01-C3::SWP|C_ToggleSwapCapability KST.ANHD "P|OURO-98c486052a51|W1-98c486052a51" false)
    (print
        (expect-failure
            "Adversarial: swap-route over a real, connected, but can-swap=false pool is rejected"
            (ref-TS01-C3::SWP|C_SmartSwapNoSlippage KST.ANHD KST.ANHD "W1-98c486052a51" 1.0 "OURO-98c486052a51" inactive-edge-bundle)
        )
    )
    (ref-TS01-C3::SWP|C_ToggleSwapCapability KST.ANHD "P|OURO-98c486052a51|W1-98c486052a51" true)
)
;;==== SWP|TX 032z8 - Adversarial Malformed-Bundle Proof · 03 · pricing-path graceful degrade ====
(print "--- [SWP|TX 032z8 - Adversarial Malformed-Bundle Proof · 03 · pricing-path graceful degrade] ---")
(let ((ref-TS01-A:module{TalosStageOne_AdminV2} TS01-A)) (ref-TS01-A::SWP|A_UpdateLiquidBoost true))
(let*
    (
        (ref-SWPI:module{SwapperIssueV4} SWPI)
        (ref-SWP:module{SwapperV4} SWP)
        (ref-TS01-C3:module{TalosStageOne_ClientThreeV4} TS01-C3)
        (input-id "W1-98c486052a51")
        (output-id "OURO-98c486052a51")
        (route-h:object{SwapperIssueV4.Hopper} (ref-SWPI::URC_HopperActive input-id output-id 1.0))
        (real-route {"nodes" : (at "nodes" route-h), "edges" : (at "edges" route-h)})
        ;;Fabricated boost-path: disconnected, non-existent nodes/edges, claimed
        ;;is-new=true. URC_ValidatePathActive will reject it (fails to connect at
        ;;all) -- XI_RawLiquidPump must degrade to "no boost pumped this round",
        ;;never crash, never abort the swap itself.
        (fabricated-boost {"nodes" : ["FakeBoostA" "FakeBoostB"], "edges" : ["NotARealBoostPool"], "is-new" : true})
        ;;Fabricated stoa-path: a real pool's real first-token, paired with garbage
        ;;nodes/edges that don't actually connect it to DWK. URC_PoolStoaValueFromPath
        ;;must return its -1.0 skip-sentinel for this one entry -- URC_ComputeStoaValueResults
        ;;must simply omit it from the results, never crash, never corrupt other pools' pricing.
        (real-first-token:string (at 0 (ref-SWP::UR_PoolTokens (at 0 (at "edges" route-h)))))
        (fabricated-stoa-paths
            [{"first-token" : real-first-token
             ,"path" : {"nodes" : ["FakeStoaA" "FakeStoaB"], "edges" : ["NotARealStoaPool"], "is-new" : true}}]
        )
        (bundle-bad-boost {"swap-route" : real-route, "boost-path" : fabricated-boost, "stoa-paths" : []})
        (bundle-bad-stoa {"swap-route" : real-route, "boost-path" : {"nodes" : [], "edges" : [], "is-new" : false}, "stoa-paths" : fabricated-stoa-paths})
        ;;Bound here (not inline in the assertion list below) so each call's actual
        ;;result gets a real check, not a placebo true==true — if either call had
        ;;thrown (crashed) instead of degrading gracefully, this whole transaction
        ;;would already be dead by the time the assertions below run.
        (result-bad-boost:string (ref-TS01-C3::SWP|C_SmartSwapNoSlippage KST.ANHD KST.ANHD input-id 1.0 output-id bundle-bad-boost))
        (result-bad-stoa:string (ref-TS01-C3::SWP|C_SmartSwapNoSlippage KST.ANHD KST.ANHD input-id 1.0 output-id bundle-bad-stoa))
    )
    (map print
        [
            (format "Adversarial fabricated-boost-path swap result: {}" [result-bad-boost])
            (expect
                "Adversarial: swap with a fabricated boost-path still succeeds (boost gracefully skipped, no crash)"
                true
                (contains "Succesfully smart-swapped" result-bad-boost)
            )
            (format "Adversarial fabricated-stoa-path swap result: {}" [result-bad-stoa])
            (expect
                "Adversarial: swap with a fabricated stoa-path entry still succeeds (that pool's pricing gracefully skipped, no crash)"
                true
                (contains "Succesfully smart-swapped" result-bad-stoa)
            )
        ]
    )
)
(let ((ref-TS01-A:module{TalosStageOne_AdminV2} TS01-A)) (ref-TS01-A::SWP|A_UpdateLiquidBoost false))
(env-sigs [])
(commit-tx)
