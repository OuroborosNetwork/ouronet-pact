(begin-tx "SWP|TX 050 - #34 Phase 11 Issue TSTE/TSTF Diamond-Extension Pools (4-Route Proof)")
(namespace "ouronet-ns")
;;env-gaslimit raised well above the usual 10,000,000 — by this point in the file the
;;graph is huge (P2-scale topology, 102+ active pools), so OURO-anchored issuance's own
;;worth-check searches cost much more than early in the file (same scaling finding as
;;P0.6's P2-scale probe). This setup transaction's own cost isn't what's being measured.
(env-gasmodel "table")(env-gaslimit 2000000000)(env-gas 0)
;;==== SWP|TX 050 - Issue TSTE/TSTF Diamond-Extension Pools · 01 · let / invocation ====
(print "--- [SWP|TX 050 - Issue TSTE/TSTF Diamond-Extension Pools · 01 · let / invocation] ---")
(let
    (
        (ref-DALOS:module{OuronetDalosV2} DALOS)
        (ref-TS01-C3:module{TalosStageOne_ClientThreeV4} TS01-C3)
        (split-stoa:[decimal]
            (ref-DALOS::URC_SplitSTOAPrices
                KST.ANHD
                (* (+ (ref-DALOS::UR_UsagePrice "dptf") (ref-DALOS::UR_UsagePrice "swp")) 4.0)
            )
        )
    )
;;==== SWP|TX 050 - Issue TSTE/TSTF Diamond-Extension Pools · 02 · env-sigs (caps) ====
(print "--- [SWP|TX 050 - Issue TSTE/TSTF Diamond-Extension Pools · 02 · env-sigs (caps)] ---")
    (env-sigs
        [
            { "key": "PK_AncientHodler", "caps": [] }
            { "key": "6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263" ,
              "caps":
                [
                    (coin.TRANSFER
                        "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263"
                        "k:50d6c59b21e5e6e55baecaa75a1007de37576bde12d8230dc82459cc01b9484b"
                        (at 2 split-stoa)
                    )
                    (coin.TRANSFER
                        "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263"
                        "k:0cb30c0121ff919266121a99ff9359871818932211df94dae4137c29bc0e8f7e"
                        (at 0 split-stoa)
                    )
                    (coin.TRANSFER
                        "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263"
                        "c:XM-pkmuB5XUQlp87ZYSbfKt8qzmHY6O2EHAzMRVBt3k"
                        (at 3 split-stoa)
                    )
                    (coin.TRANSFER
                        "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263"
                        "c:iQQFWj6gWtpGEzhM_O5ekW1QtnQQy55R8BRPGhj_0FU"
                        (at 1 split-stoa)
                    )
                ]
            }
        ]
    )
    ;;#34 Phase 11 / P4.1: extends the existing OURO->{TSTC,TSTD}->TSTZ diamond
    ;;(032e/032f) with 2 MORE parallel routes, TSTE (deliberately WORSE than both
    ;;C and D — thinner second hop than C's 2000/2000) and TSTF (deliberately
    ;;BETTER than all three — 10x deeper second hop than D's 200000/200000).
    ;;Issued in this order (C, D already existed; E then F here) so BFS discovers
    ;;C/D/E as the FIRST three chains reaching TSTZ, and F only as the fourth —
    ;;URC_ComputeAlternateRoutes' fixed best-of-3 structurally cannot see F at
    ;;all, proving the exhaustive search (URC_ComputeAllRoutes, max-attempts>=4)
    ;;finds a genuinely better route the old approximation provably misses (P4.1,
    ;;still open from Phase 4, closed here as part of Phase 11's own proof).
    (ref-TS01-C3::SWP|C_IssueStandard KST.ANHD KST.ANHD
        [
            { "token-id": "OURO-98c486052a51", "token-supply": 5000.0}
            { "token-id": "TSTE-98c486052a51", "token-supply": 6000.0}
        ]
        25.0 false
    )
    (ref-TS01-C3::SWP|C_IssueStable KST.ANHD KST.ANHD
        [
            { "token-id": "TSTE-98c486052a51", "token-supply": 800.0}
            { "token-id": "TSTZ-98c486052a51", "token-supply": 800.0}
        ]
        25.0 10.0 false
    )
    ;;First-hop ratio raised to 5000/40000 (was 9000) — empirically measured (not
    ;;hand-guessed) via a diagnostic isolating each candidate route: the CURRENT
    ;;live state (after many intervening transactions since 032e) has C, not D, as
    ;;the actual best-of-3 winner (195.16 for a 100 OURO test, vs D's 16.66 and
    ;;E's 116.81) — the original 032e-era "D beats C" narrative no longer holds by
    ;;this point in the file. F must beat 195.16, not D's now-tiny figure.
    (ref-TS01-C3::SWP|C_IssueStandard KST.ANHD KST.ANHD
        [
            { "token-id": "OURO-98c486052a51", "token-supply": 5000.0}
            { "token-id": "TSTF-98c486052a51", "token-supply": 40000.0}
        ]
        25.0 false
    )
    ;;TSTZ's existing (pre-minted) balance for this patron is ~802,906 by this point
    ;;in the file — 700,000.0 stays safely within that while still being generously
    ;;deep (minimal second-hop price impact).
    (ref-TS01-C3::SWP|C_IssueStable KST.ANHD KST.ANHD
        [
            { "token-id": "TSTF-98c486052a51", "token-supply": 700000.0}
            { "token-id": "TSTZ-98c486052a51", "token-supply": 700000.0}
        ]
        25.0 10.0 false
    )
)
(print "")
(print "")
