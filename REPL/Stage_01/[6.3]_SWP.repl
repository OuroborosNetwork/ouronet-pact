            (index-value:decimal (ref-ATS::URC_Index stoaliquindex))
        )
        [
            (format "Initial Liquindex is {}, Projected Liquindex is {}, from {} STOA to be used for fueling" [(at 0 indices) (at 1 indices) (at 2 indices)])
            (format "After Manual Fuel, Current Liquindex is {}" [index-value])
        ]
    )
)

