(begin-tx "SWP|TX 052 - #34 Phase 11 Genuine Exhaustive Route Discovery Proof (Permanent)")
(namespace "ouronet-ns")
;;env-gaslimit raised — URC_ComputeAllRoutes/URC_HopperExhaustive walk the FULL
;;active-swpairs universe (100+ pools by this point) up to max-attempts times each;
;;this is a dirty-read-only function (never called on a paid path in production), so
;;its real cost here is purely a REPL-testing safety-valve concern, not the thing
;;being measured.
(env-gasmodel "table")(env-gaslimit 2000000000)(env-gas 0)
;;==== SWP|TX 052 - Exhaustive Route Discovery Proof · 01 · env-sigs (caps) ====
(print "--- [SWP|TX 052 - Exhaustive Route Discovery Proof · 01 · env-sigs (caps)] ---")
(env-sigs
    [
        { "key": "PK_AncientHodler", "caps": [] }
    ]
)
;;#34 Phase 11 (the original #34 ask) — hand-verified proof against a known
;;topology (P1.5-P1.9's requirement), on the OURO->{TSTC,TSTD,TSTE,TSTF}->TSTZ
;;4-route diamond built above. Hand-computed expectation: exactly 4 distinct
;;2-hop routes exist for OURO->TSTZ in this topology (no other connection to the
;;dedicated TSTZ test token exists anywhere else in the whole active universe);
;;URC_ComputeAlternateRoutes' fixed cap can only ever see the first 3 (C, D, E —
;;TSTF was issued last); URC_ComputeAllRoutes with max-attempts>=4 sees all 4.
;;Closes P4.1 (still open since Phase 4): a real scenario where the true-best
;;route is provably outside best-of-3's reach, and the exhaustive search finds
;;it while the old approximation structurally cannot.
;;==== SWP|TX 052 - Exhaustive Route Discovery Proof · 02 · let / invocation ====
(print "--- [SWP|TX 052 - Exhaustive Route Discovery Proof · 02 · let / invocation] ---")
(let*
    (
        (ref-SWPT:module{SwapTracerV3} SWPT)
        (ref-SWPI:module{SwapperIssueV4} SWPI)
        (ref-SWP:module{SwapperV4} SWP)
        (ouro "OURO-98c486052a51")
        (tstz "TSTZ-98c486052a51")
        (tstc "TSTC-98c486052a51")
        (active-swpairs:[string] (ref-SWP::URC_ActiveSwpairs))
        (best-of-3-routes:[[string]] (ref-SWPT::URC_ComputeAlternateRoutes ouro tstz active-swpairs))
        (exhaustive-routes:[[string]] (ref-SWPT::URC_ComputeAllRoutes ouro tstz active-swpairs 10))
        (best-of-3-has-f:bool (fold (or) false (map (lambda (r:[string]) (contains "TSTF-98c486052a51" r)) best-of-3-routes)))
        (exhaustive-has-f:bool (fold (or) false (map (lambda (r:[string]) (contains "TSTF-98c486052a51" r)) exhaustive-routes)))
        (active-hopper:object{SwapperIssueV4.Hopper} (ref-SWPI::URC_HopperActive ouro tstz 100.0))
        (exhaustive-hopper:object{SwapperIssueV4.Hopper} (ref-SWPI::URC_HopperExhaustive ouro tstz 100.0 active-swpairs 10))
        (active-final:decimal (at 0 (take -1 (at "output-values" active-hopper))))
        (exhaustive-final:decimal (at 0 (take -1 (at "output-values" exhaustive-hopper))))
        ;;DIAGNOSTIC: isolate each candidate route's own computed value by
        ;;restricting the search universe to just that route's 2 pools.
        (c-only:[string] ["P|OURO-98c486052a51|TSTC-98c486052a51" "S|TSTC-98c486052a51|TSTZ-98c486052a51"])
        (d-only:[string] ["P|OURO-98c486052a51|TSTD-98c486052a51" "S|TSTD-98c486052a51|TSTZ-98c486052a51"])
        (e-only:[string] ["P|OURO-98c486052a51|TSTE-98c486052a51" "S|TSTE-98c486052a51|TSTZ-98c486052a51"])
        (f-only:[string] ["P|OURO-98c486052a51|TSTF-98c486052a51" "S|TSTF-98c486052a51|TSTZ-98c486052a51"])
        (c-hopper:object{SwapperIssueV4.Hopper} (ref-SWPI::URC_HopperExhaustive ouro tstz 100.0 c-only 10))
        (d-hopper:object{SwapperIssueV4.Hopper} (ref-SWPI::URC_HopperExhaustive ouro tstz 100.0 d-only 10))
        (e-hopper:object{SwapperIssueV4.Hopper} (ref-SWPI::URC_HopperExhaustive ouro tstz 100.0 e-only 10))
        (f-hopper:object{SwapperIssueV4.Hopper} (ref-SWPI::URC_HopperExhaustive ouro tstz 100.0 f-only 10))
        ;;P1.9 edge case: a single-pool universe must work correctly with no
        ;;special-casing needed by the caller — 1 route when connected, 0 when not.
        (single-pool-universe:[string] ["P|OURO-98c486052a51|TSTC-98c486052a51"])
        (single-pool-connected:[[string]] (ref-SWPT::URC_ComputeAllRoutes ouro tstc single-pool-universe 10))
        (single-pool-disconnected:[[string]] (ref-SWPT::URC_ComputeAllRoutes ouro tstz single-pool-universe 10))
    )
    (map print
        [
            (format "DIAGNOSTIC C-only final output: {}" [(at 0 (take -1 (at "output-values" c-hopper)))])
            (format "DIAGNOSTIC D-only final output: {}" [(at 0 (take -1 (at "output-values" d-hopper)))])
            (format "DIAGNOSTIC E-only final output: {}" [(at 0 (take -1 (at "output-values" e-hopper)))])
            (format "DIAGNOSTIC F-only final output: {}" [(at 0 (take -1 (at "output-values" f-hopper)))])
            (format "best-of-3 routes found: {}" [best-of-3-routes])
            (format "exhaustive routes found: {}" [exhaustive-routes])
            (format "URC_HopperActive (best-of-3) final output for 100 OURO: {}" [active-final])
            (format "URC_HopperExhaustive (all 4) final output for 100 OURO: {}" [exhaustive-final])
            (expect
                "Hand-computed expectation: exactly 3 routes found by best-of-3 (fixed cap)"
                3
                (length best-of-3-routes)
            )
            (expect
                "Hand-computed expectation: exactly 4 routes found by exhaustive search (max-attempts=10, naturally exhausted at 4)"
                4
                (length exhaustive-routes)
            )
            (expect
                "best-of-3 structurally CANNOT see the TSTF route (issued 4th, outside its fixed cap)"
                false
                best-of-3-has-f
            )
            (expect
                "Exhaustive search DOES find the TSTF route"
                true
                exhaustive-has-f
            )
            (expect
                "P4.1: exhaustive search finds a genuinely better route than best-of-3 on the identical topology/amount — the true redesign value, not an approximation"
                true
                (> exhaustive-final active-final)
            )
            (expect
                "P1.9: single-pool universe, connected pair — exactly 1 route, no crash, no special-casing"
                1
                (length single-pool-connected)
            )
            (expect
                "P1.9: single-pool universe, disconnected pair — exactly 0 routes, no crash"
                0
                (length single-pool-disconnected)
            )
        ]
    )
)
(print "")
(print "")
;;==== SWP|TX 052 - Exhaustive Route Discovery Proof · 03 · gas echo ====
(print "--- [SWP|TX 052 - Exhaustive Route Discovery Proof · 03 · gas echo] ---")
(format "<<<<<<<SWP|TX 052 #34 Phase 11 Exhaustive Discovery Proof ==> {} STOA GAS>>>>>>>" [(env-gas)])
(print "")
(print "")
(print "===^^^===")
(env-sigs [])
(commit-tx)
