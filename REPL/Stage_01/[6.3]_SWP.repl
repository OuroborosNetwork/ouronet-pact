        (split-stoa:[decimal]
            (ref-DALOS::URC_SplitSTOAPrices
                patron
                (* (+ (ref-DALOS::UR_UsagePrice "dptf") (ref-DALOS::UR_UsagePrice "swp")) 80.0)
            )
        )
    )
    (env-sigs
        [
            { "key": "PK_AncientHodler", "caps": [] }
            { "key": "6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263" ,
              "caps":
                [
                    (coin.TRANSFER
                        "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263"
                        "k:50d6c59b21e5e6e55baecaa75a1007de37576bde12d8230dc82459cc01b9484b"
                        (at 2 split-stoa)
                    )
                    (coin.TRANSFER
                        "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263"
                        "k:0cb30c0121ff919266121a99ff9359871818932211df94dae4137c29bc0e8f7e"
                        (at 0 split-stoa)
                    )
                    (coin.TRANSFER
                        "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263"
                        "c:XM-pkmuB5XUQlp87ZYSbfKt8qzmHY6O2EHAzMRVBt3k"
                        (at 3 split-stoa)
                    )
                    (coin.TRANSFER
                        "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263"
                        "c:iQQFWj6gWtpGEzhM_O5ekW1QtnQQy55R8BRPGhj_0FU"
                        (at 1 split-stoa)
                    )
                ]
            }
        ]
    )
    (let*
        (
            (ref-TS01-C1:module{TalosStageOne_ClientOneV2} TS01-C1)
            (ref-TS01-C3:module{TalosStageOne_ClientThreeV4} TS01-C3)
        )
        (map (lambda (t:string) (ref-TS01-C1::DPTF|C_Mint patron t patron 1000.0 true)) tok-ids)
        ;;permissioned=true (skips the issuance-time worth/spawn-limit search only —
        ;;irrelevant for these noise pools; SWP|C_ToggleSwapCapability's own worth
        ;;check below is unconditional regardless and still runs).
        (map
            (lambda (t:string)
                (ref-TS01-C3::SWP|C_IssueStandard patron patron
                    [
                        { "token-id": "OURO-98c486052a51", "token-supply": 1000.0}
                        { "token-id": t, "token-supply": 1000.0}
                    ]
                    25.0 true
                )
            )
            tok-ids
        )
        ;;First batch: activate the first 20 (baseline 22 -> ~42 active).
        (map (lambda (t:string) (ref-TS01-C3::SWP|C_ToggleSwapCapability patron (format "P|OURO-98c486052a51|{}" [t]) true)) (take 20 tok-ids))
    )
)
