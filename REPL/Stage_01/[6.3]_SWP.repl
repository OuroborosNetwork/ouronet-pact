(print "--- [SWP|TX 050 - Issue TSTE/TSTF Diamond-Extension Pools · 03 · gas echo] ---")
(format "<<<<<<<SWP|TX 050 Issue TSTE/TSTF Pools ==> {} STOA GAS>>>>>>>" [(env-gas)])
