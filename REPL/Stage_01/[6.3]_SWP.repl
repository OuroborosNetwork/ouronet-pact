(namespace "ouronet-ns")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
;;==== SWP|TX 032e - Issue Diamond-Topology Pools (#34M Proof) · 01 · let / invocation ==== ===========
(print "--- [SWP|TX 032e - Issue Diamond-Topology Pools (#34M Proof) · 01 · let / invocation] ---")
(let
    (
        (ref-DALOS:module{OuronetDalosV2} DALOS)
        (ref-TS01-C3:module{TalosStageOne_ClientThreeV4} TS01-C3)
        (split-stoa:[decimal]
            (ref-DALOS::URC_SplitSTOAPrices
                KST.ANHD
                (* (+ (ref-DALOS::UR_UsagePrice "dptf") (ref-DALOS::UR_UsagePrice "swp")) 4.0)
            )
        )
    )
;;==== SWP|TX 032e - Issue Diamond-Topology Pools (#34M Proof) · 02 · env-sigs (caps) ==== ============
(print "--- [SWP|TX 032e - Issue Diamond-Topology Pools (#34M Proof) · 02 · env-sigs (caps)] ---")
    (env-sigs
        [
            { "key": "PK_AncientHodler", "caps": [] }
            { "key": "6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263" ,
              "caps":
                [
                    (coin.TRANSFER
                        "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263"
                        "k:50d6c59b21e5e6e55baecaa75a1007de37576bde12d8230dc82459cc01b9484b"
                        (at 2 split-stoa)
                    )
                    (coin.TRANSFER
                        "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263"
                        "k:0cb30c0121ff919266121a99ff9359871818932211df94dae4137c29bc0e8f7e"
                        (at 0 split-stoa)
                    )
                    (coin.TRANSFER
                        "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263"
                        "c:XM-pkmuB5XUQlp87ZYSbfKt8qzmHY6O2EHAzMRVBt3k"
                        (at 3 split-stoa)
                    )
                    (coin.TRANSFER
                        "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263"
                        "c:iQQFWj6gWtpGEzhM_O5ekW1QtnQQy55R8BRPGhj_0FU"
                        (at 1 split-stoa)
                    )
                ]
            }
        ]
    )
    ;;Diamond topology: OURO -> {TSTC, TSTD} -> TSTZ, sized for a 10,000-OURO
    ;;test swap. Route via C looks fine on the FIRST hop (5000/10000) but
    ;;bottlenecks badly on the SECOND hop (2000/2000 — thin enough that the
    ;;~6667 TSTC hop-1 delivers is 3x the pool's own reserve). Route via D looks
    ;;only mediocre on the first hop (5000/7500) but the second hop is very deep
    ;;(200000/200000) — barely any price impact even for a large hop. Issued in
    ;;this exact order (C-side pools first) so BFS's first-discovered route is
    ;;the WORSE one — proving #34M/M2 needs the best-of-K comparison to find D.
    ;;(CB/DB reserves sized generously above SWP's 1000.0 DWK spawn-limit floor —
    ;;measured via a scratch diagnostic that TSTC's own DWK-worth rises very
    ;;slowly/asymptotically with reserve size, so a naive small thin pool like
    ;;500/500 undershoots it.)
    (ref-TS01-C3::SWP|C_IssueStandard KST.ANHD KST.ANHD
        [
            { "token-id": "OURO-98c486052a51", "token-supply": 5000.0}
            { "token-id": "TSTC-98c486052a51", "token-supply": 10000.0}
        ]
        25.0 false
    )
    ;;Neither TSTC nor TSTZ is a principal, so this can't be a W/P pool (first
    ;;token must be a principal) — must be Stable; TSTC is already transitively
    ;;DLK-connected via the OURO|TSTC pool just issued above, satisfying Stable's
    ;;own no-principal-tokens escape hatch (first token needs a DLK route via
    ;;existing pools, not to literally be a principal).
    (ref-TS01-C3::SWP|C_IssueStable KST.ANHD KST.ANHD
        [
            { "token-id": "TSTC-98c486052a51", "token-supply": 2000.0}
            { "token-id": "TSTZ-98c486052a51", "token-supply": 2000.0}
        ]
        25.0 10.0 false
    )
    (ref-TS01-C3::SWP|C_IssueStandard KST.ANHD KST.ANHD
        [
            { "token-id": "OURO-98c486052a51", "token-supply": 5000.0}
            { "token-id": "TSTD-98c486052a51", "token-supply": 7500.0}
        ]
        25.0 false
    )
    ;;Same reasoning as the TSTC|TSTZ pool above.
    (ref-TS01-C3::SWP|C_IssueStable KST.ANHD KST.ANHD
        [
            { "token-id": "TSTD-98c486052a51", "token-supply": 200000.0}
            { "token-id": "TSTZ-98c486052a51", "token-supply": 200000.0}
        ]
        25.0 10.0 false
    )
)
