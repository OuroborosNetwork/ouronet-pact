(begin-tx "SWP|TX 032o2 - Throwaway OURO|W1 Worth-Anchor Pool (P0.5)")
(namespace "ouronet-ns")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
;;#34bM/P0.5 note: URC_PoolValue prices a pool using only its FIRST token's DWK
;;worth (URC_WorthWSTOA -> URC_Hopper(token, DWK, amount) — a real swap-reachability
;;search), and SWP|C_ToggleSwapCapability requires that worth clear an
;;inactive-limit floor. The isolated W1-W7 chain has zero path to DWK on its own.
;;This one small OURO|W1 pool (never referenced by the intended swap route) gives
;;W1 real DWK-reachable worth — and since the whole chain is transitively
;;connected through W1, W2/W4/W5/W7's worth (each pool's own first token) becomes
;;computable too, without creating any shortcut: W7 remains reachable from OURO
;;only via the same 6-hop chain either way, since nothing else touches it.
(print "--- [SWP|TX 032o2 - Throwaway OURO|W1 Anchor (P0.5) · 01 · let / invocation] ---")
(let
    (
        (ref-DALOS:module{OuronetDalosV2} DALOS)
        (ref-TS01-C3:module{TalosStageOne_ClientThreeV4} TS01-C3)
        (split-stoa:[decimal]
            (ref-DALOS::URC_SplitSTOAPrices
                KST.ANHD
                (+ (ref-DALOS::UR_UsagePrice "dptf") (ref-DALOS::UR_UsagePrice "swp"))
            )
        )
    )
;;==== SWP|TX 032o2 - Throwaway OURO|W1 Anchor (P0.5) · 02 · env-sigs (caps) ==== =========================
(print "--- [SWP|TX 032o2 - Throwaway OURO|W1 Anchor (P0.5) · 02 · env-sigs (caps)] ---")
    (env-sigs
        [
            { "key": "PK_AncientHodler", "caps": [] }
            { "key": "6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263" ,
              "caps":
                [
                    (coin.TRANSFER
                        "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263"
                        "k:50d6c59b21e5e6e55baecaa75a1007de37576bde12d8230dc82459cc01b9484b"
                        (at 2 split-stoa)
                    )
                    (coin.TRANSFER
                        "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263"
                        "k:0cb30c0121ff919266121a99ff9359871818932211df94dae4137c29bc0e8f7e"
                        (at 0 split-stoa)
                    )
                    (coin.TRANSFER
                        "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263"
                        "c:XM-pkmuB5XUQlp87ZYSbfKt8qzmHY6O2EHAzMRVBt3k"
                        (at 3 split-stoa)
                    )
                    (coin.TRANSFER
                        "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263"
                        "c:iQQFWj6gWtpGEzhM_O5ekW1QtnQQy55R8BRPGhj_0FU"
                        (at 1 split-stoa)
                    )
                ]
            }
        ]
    )
    (ref-TS01-C3::SWP|C_IssueStandard KST.ANHD KST.ANHD
        [
            { "token-id": "OURO-98c486052a51", "token-supply": 1000.0}
            { "token-id": "W1-98c486052a51", "token-supply": 1000.0}
        ]
        25.0 false
    )
    ;;#P0.5 correction: this anchor DOES need to be swap-enabled after all — not
    ;;for the main W1->W7 route search (that stays forced through the intended
    ;;6-hop chain regardless, since nothing else ever connects to W7), but
    ;;because XI_RawLiquidPump's own internal Liquid-Boost bookkeeping searches
    ;;URC_HopperActive(hop-token, DLK, amount) per hop when Liquid Boost is on,
    ;;and that search is active-filtered — an inactive anchor is invisible to it
    ;;and the search comes back empty. Discovered a real, separate bug this way:
    ;;XI_RawLiquidPump indexes into that result unguarded ((at 0 (take -1 ovs)))
    ;;instead of handling the empty case, so an inactive/missing DLK route
    ;;crashes instead of failing cleanly. Worth its own tracked finding — not
    ;;fixing it here, just routing around it to keep this specific pool
    ;;genuinely DLK-reachable so the swap can execute at all.
    (ref-TS01-C3::SWP|C_ToggleSwapCapability KST.ANHD "P|OURO-98c486052a51|W1-98c486052a51" true)
)
(print "")
(print "")
;;==== SWP|TX 032o2 - Throwaway OURO|W1 Anchor (P0.5) · 03 · gas echo ==== ================================
(print "--- [SWP|TX 032o2 - Throwaway OURO|W1 Anchor (P0.5) · 03 · gas echo] ---")
(format "<<<<<<<SWP|TX 032o2 Throwaway Anchor ==> {} STOA GAS>>>>>>>" [(env-gas)])
(print "")
(print "")
(print "===^^^===")
(env-sigs [])
(commit-tx)
