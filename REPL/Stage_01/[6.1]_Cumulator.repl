                (at "ignis" (at 0 (at "cumulator-chain" (ref-DPTF::URCi_Wipe ouro)))))
            ;;deterrence-only readers (no components leg): issuance gas rail + token-account
            (expect "<<TX-IGC-006>> DPTF issue gas (1 token) == deter(issue-tf), no components"
