;;
;; REPL/Stage_01/[6.11]_INFO.repl — INFO-layer (#78) per-module smoke tests.
;;   INFO functions are URC_<MOD>|<Op> thin wrappers over the <MOD>|URCi_ readers,
;;   living in INFO-ONE (Stage-1) / INFO-TWO (Stage-2). Each returns an
;;   object{OuronetInfoV1.ClientInfo}. Runs AFTER [4.0]_Sovereign-Executor (usage
;;   prices, incl ignis|medium, must be populated). Add a block per module as the
;;   rehaul proceeds (DALOS -> DPTF -> DPOF -> VST -> ATS -> SWP -> LIQUID -> ORBR).
;;
(print "")
(print "================================================================")
(print "FILE  REPL/Stage_01/[6.11]_INFO.repl")
(print "================================================================")
(print "")
;;==== TX-I01 · 01 · DALOS INFO — URC_DALOS|* return well-formed ClientInfo ====
(begin-tx "TX-I01 - INFO DALOS: URC_DALOS|* previews return well-formed ClientInfo")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(namespace "ouronet-ns")
(print "--- [TX-I01 · 01 · DALOS INFO smoke] ---")
(env-sigs [{ "key": "PK_AncientHodler", "caps": [] }])
(let
    (
        (p:string KST.ANHD)
        (a:string KST.ANHD)
    )
    (map print
        [ (expect "URC_DALOS|ControlSmartAccount -> ClientInfo{ignis}" true (contains "ignis" (INFO-ONE.URC_DALOS|ControlSmartAccount p a)))
          (expect "URC_DALOS|DeploySmartAccount -> ClientInfo{stoa}" true (contains "stoa" (INFO-ONE.URC_DALOS|DeploySmartAccount a)))
          (expect "URC_DALOS|DeployStandardAccount -> ClientInfo{stoa}" true (contains "stoa" (INFO-ONE.URC_DALOS|DeployStandardAccount a)))
          (expect "URC_DALOS|RotateGovernor -> ClientInfo{ignis}" true (contains "ignis" (INFO-ONE.URC_DALOS|RotateGovernor p a)))
          (expect "URC_DALOS|RotateGuard -> ClientInfo{ignis}" true (contains "ignis" (INFO-ONE.URC_DALOS|RotateGuard p a)))
          (expect "URC_DALOS|RotateStoa -> ClientInfo{ignis}" true (contains "ignis" (INFO-ONE.URC_DALOS|RotateStoa p a)))
          (expect "URC_DALOS|RotateSovereign -> ClientInfo{ignis}" true (contains "ignis" (INFO-ONE.URC_DALOS|RotateSovereign p a)))
          (expect "URC_DALOS|UpdateEliteAccount -> ClientInfo{ignis}" true (contains "ignis" (INFO-ONE.URC_DALOS|UpdateEliteAccount p a)))
          (expect "URC_DALOS|UpdateEliteAccountSquared -> ClientInfo{ignis}" true (contains "ignis" (INFO-ONE.URC_DALOS|UpdateEliteAccountSquared p a a))) ]))
(print "")
(commit-tx)
(print "")
;;||>>>>>>>>>>>>>>>>>>>>>>>>>
;;|| NEXT                   >
;;||>>>>>>>>>>>>>>>>>>>>>>>>>
(print "")
;;==== TX-I02 · 01 · DPTF INFO — URC_DPTF|* return well-formed ClientInfo ====
(begin-tx "TX-I02 - INFO DPTF: URC_DPTF|* previews return well-formed ClientInfo (URCi-sourced)")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(namespace "ouronet-ns")
(print "--- [TX-I02 · 01 · DPTF INFO smoke] ---")
(env-sigs [{ "key": "PK_AncientHodler", "caps": [] }])
(let
    (
        (p:string KST.ANHD)
        (a:string KST.ANHD)
        (ouro:string (DALOS.UR_OuroborosID))
    )
    (map print
        ;; IGNIS-cumulator ops (previously SIP tier buckets → now exact DPTF|URCi_*)
        [ (expect "URC_DPTF|Control -> ClientInfo{ignis}" true (contains "ignis" (INFO-ONE.URC_DPTF|Control p ouro)))
          (expect "URC_DPTF|Burn -> ClientInfo{ignis}" true (contains "ignis" (INFO-ONE.URC_DPTF|Burn p ouro a 1.0)))
          (expect "URC_DPTF|Mint -> ClientInfo{ignis}" true (contains "ignis" (INFO-ONE.URC_DPTF|Mint p ouro a 1.0 false)))
          (expect "URC_DPTF|SetFee -> ClientInfo{ignis}" true (contains "ignis" (INFO-ONE.URC_DPTF|SetFee p ouro 5.0)))
          (expect "URC_DPTF|SetMinMove -> ClientInfo{ignis}" true (contains "ignis" (INFO-ONE.URC_DPTF|SetMinMove p ouro 1.0)))
          (expect "URC_DPTF|TogglePause -> ClientInfo{ignis}" true (contains "ignis" (INFO-ONE.URC_DPTF|TogglePause p ouro true)))
          (expect "URC_DPTF|ToggleReservation -> ClientInfo{ignis}" true (contains "ignis" (INFO-ONE.URC_DPTF|ToggleReservation p ouro true)))
          (expect "URC_DPTF|UpdatePendingBranding -> ClientInfo{ignis}" true (contains "ignis" (INFO-ONE.URC_DPTF|UpdatePendingBranding p ouro)))
          ;; cost-mismatch fixes (Medium/Biggest → Big at exec): verify still well-formed
          (expect "URC_DPTF|RotateOwnership -> ClientInfo{ignis}" true (contains "ignis" (INFO-ONE.URC_DPTF|RotateOwnership p ouro a)))
          (expect "URC_DPTF|ToggleFreezeAccount -> ClientInfo{ignis}" true (contains "ignis" (INFO-ONE.URC_DPTF|ToggleFreezeAccount p ouro a true)))
          (expect "URC_DPTF|ToggleTransferRole -> ClientInfo{ignis}" true (contains "ignis" (INFO-ONE.URC_DPTF|ToggleTransferRole p ouro a true)))
          ;; gap ops now sourced from new core readers
          (expect "URC_DPTF|DeployAccount -> ClientInfo{ignis}" true (contains "ignis" (INFO-ONE.URC_DPTF|DeployAccount p ouro a)))
          (expect "URC_DPTF|ToggleFeeLock -> ClientInfo{stoa}" true (contains "stoa" (INFO-ONE.URC_DPTF|ToggleFeeLock p ouro false 0)))
          ;; STOA / dual-leg ops
          (expect "URC_DPTF|UpgradeBranding -> ClientInfo{stoa}" true (contains "stoa" (INFO-ONE.URC_DPTF|UpgradeBranding p ouro 3)))
          (expect "URC_DPTF|Issue -> ClientInfo{ignis}" true (contains "ignis" (INFO-ONE.URC_DPTF|Issue p a ["testtoken"])))
          ;; entity-completion: role toggles + transmute (previously had no INFO)
          (expect "URC_DPTF|ToggleBurnRole -> ClientInfo{ignis}" true (contains "ignis" (INFO-ONE.URC_DPTF|ToggleBurnRole p ouro a true)))
          (expect "URC_DPTF|ToggleMintRole -> ClientInfo{ignis}" true (contains "ignis" (INFO-ONE.URC_DPTF|ToggleMintRole p ouro a true)))
          (expect "URC_DPTF|ToggleFeeExemptionRole -> ClientInfo{ignis}" true (contains "ignis" (INFO-ONE.URC_DPTF|ToggleFeeExemptionRole p ouro a true)))
          (expect "URC_DPTF|Transmute -> ClientInfo{ignis}" true (contains "ignis" (INFO-ONE.URC_DPTF|Transmute p ouro a 10.0))) ]))
(print "")
(commit-tx)
(print "")
;;||>>>>>>>>>>>>>>>>>>>>>>>>>
;;|| NEXT                   >
;;||>>>>>>>>>>>>>>>>>>>>>>>>>
(print "")
;;==== TX-I03 · 01 · DPOF INFO — URC_DPOF|* return well-formed ClientInfo ====
(begin-tx "TX-I03 - INFO DPOF: URC_DPOF|* previews return well-formed ClientInfo (URCi-sourced)")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(namespace "ouronet-ns")
(print "--- [TX-I03 · 01 · DPOF INFO smoke] ---")
(env-sigs [{ "key": "PK_AncientHodler", "caps": [] }])
;; NOTE: [6.11] loads before any DPOF is issued, so id-dependent DPOF readers (Control/Mint/
;; AddQuantity/Burn/UpdatePendingBranding) have no valid DPOF id here. They mirror the proven
;; DPTF UDC_*Cumulator(UR_Konto id) pattern exactly (green in TX-I02). Assert the id-independent
;; readers (Issue / DeployAccount / UpgradeBranding), which fully exercise the URCi wiring.
(let
    (
        (p:string KST.ANHD)
        (a:string KST.ANHD)
    )
    (map print
        [ (expect "URC_DPOF|Issue -> ClientInfo{ignis}" true (contains "ignis" (INFO-ONE.URC_DPOF|Issue p a ["testorto"])))
          (expect "URC_DPOF|Issue -> ClientInfo{stoa}" true (contains "stoa" (INFO-ONE.URC_DPOF|Issue p a ["testorto"])))
          (expect "URC_DPOF|DeployAccount -> ClientInfo{ignis}" true (contains "ignis" (INFO-ONE.URC_DPOF|DeployAccount p "ORTO-x" a)))
          (expect "URC_DPOF|UpgradeBranding -> ClientInfo{stoa}" true (contains "stoa" (INFO-ONE.URC_DPOF|UpgradeBranding p "ORTO-x" 3))) ]))
(print "")
(commit-tx)
(print "")
;;||>>>>>>>>>>>>>>>>>>>>>>>>>
;;|| NEXT                   >
;;||>>>>>>>>>>>>>>>>>>>>>>>>>
(print "")
;;==== TX-I04 · 01 · VST INFO — URC_VST|* return well-formed ClientInfo ====
(begin-tx "TX-I04 - INFO VST: URC_VST|* previews return well-formed ClientInfo (URCi-sourced)")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(namespace "ouronet-ns")
(print "--- [TX-I04 · 01 · VST INFO smoke] ---")
(env-sigs [{ "key": "PK_AncientHodler", "caps": [] }])
;; NOTE: [6.11] loads before any VST special-link / vesting / sleeping / hibernating state is
;; created, so the state-dependent VST readers have nothing to read here. All 27 URC_VST|* are
;; wiring-verified at load; their cost is the exec single-source (URCi_*), exercised by [6.7]_VST.
;; The two TrueFungible-link readers only read the underlying DPTF Konto (OURO exists), so they
;; execute end-to-end here and confirm the URC_VST| wrapper shape.
(let
    (
        (p:string KST.ANHD)
        (ouro:string (DALOS.UR_OuroborosID))
    )
    (map print
        [ (expect "URC_VST|CreateFrozenLink -> ClientInfo{ignis}" true (contains "ignis" (INFO-ONE.URC_VST|CreateFrozenLink p ouro)))
          (expect "URC_VST|CreateReservationLink -> ClientInfo{ignis}" true (contains "ignis" (INFO-ONE.URC_VST|CreateReservationLink p ouro))) ]))
(print "")
(commit-tx)
(print "")
(print "=== [6.11]_INFO — DALOS + DPTF + DPOF + VST blocks complete ===")
