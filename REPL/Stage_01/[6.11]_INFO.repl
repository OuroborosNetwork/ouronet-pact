;;
;; REPL/Stage_01/[6.11]_INFO.repl — INFO-layer (#78) per-module smoke tests.
;;   INFO functions are URC_<MOD>|<Op> thin wrappers over the <MOD>|URCi_ readers,
;;   living in INFO-ONE (Stage-1) / INFO-TWO (Stage-2). Each returns an
;;   object{OuronetInfoV2.ClientInfo}. Runs AFTER [4.0]_Sovereign-Executor (usage
;;   prices, incl ignis|medium, must be populated). Add a block per module as the
;;   rehaul proceeds (DALOS -> DPTF -> DPOF -> VST -> ATS -> SWP -> LIQUID -> ORBR).
;;
(print "")
(print "================================================================")
(print "FILE  REPL/Stage_01/[6.11]_INFO.repl")
(print "================================================================")
(print "")
;;==== TX-I01 · 01 · DALOS INFO — INFO_DALOS|* return well-formed ClientInfo ====
(begin-tx "TX-I01 - INFO DALOS: INFO_DALOS|* previews return well-formed ClientInfo")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(namespace "ouronet-ns")
(print "--- [TX-I01 · 01 · DALOS INFO smoke] ---")
;;==== TX-I01 - INFO DALOS: INFO_DALOS|* previews return well-formed ClientInfo · 01 · env-sigs (caps) ==== 
(print "--- [TX-I01 - INFO DALOS: INFO_DALOS|* previews return well-formed ClientInfo · 01 · env-sigs (caps)] ---")
(env-sigs [{ "key": "PK_AncientHodler", "caps": [] }])
;;==== TX-I01 - INFO DALOS: INFO_DALOS|* previews return well-formed ClientInfo · 02 · let / invocation ==== 
(print "--- [TX-I01 - INFO DALOS: INFO_DALOS|* previews return well-formed ClientInfo · 02 · let / invocation] ---")
(let
    (
        (p:string KST.ANHD)
        (a:string KST.ANHD)
    )
    (map print
        [ (expect "INFO_DALOS|ControlSmartAccount -> ClientInfo{ignis}" true (contains "ignis" (INFO-ONE.INFO_DALOS|ControlSmartAccount p a)))
          (expect "INFO_DALOS|DeploySmartAccount -> ClientInfo{stoa}" true (contains "stoa" (INFO-ONE.INFO_DALOS|DeploySmartAccount a)))
          (expect "INFO_DALOS|DeployStandardAccount -> ClientInfo{stoa}" true (contains "stoa" (INFO-ONE.INFO_DALOS|DeployStandardAccount a)))
          (expect "INFO_DALOS|RotateGovernor -> ClientInfo{ignis}" true (contains "ignis" (INFO-ONE.INFO_DALOS|RotateGovernor p a)))
          (expect "INFO_DALOS|RotateGuard -> ClientInfo{ignis}" true (contains "ignis" (INFO-ONE.INFO_DALOS|RotateGuard p a)))
          (expect "INFO_DALOS|RotateStoa -> ClientInfo{ignis}" true (contains "ignis" (INFO-ONE.INFO_DALOS|RotateStoa p a)))
          (expect "INFO_DALOS|RotateSovereign -> ClientInfo{ignis}" true (contains "ignis" (INFO-ONE.INFO_DALOS|RotateSovereign p a)))
          (expect "INFO_DALOS|UpdateEliteAccount -> ClientInfo{ignis}" true (contains "ignis" (INFO-ONE.INFO_DALOS|UpdateEliteAccount p a)))
          (expect "INFO_DALOS|UpdateEliteAccountSquared -> ClientInfo{ignis}" true (contains "ignis" (INFO-ONE.INFO_DALOS|UpdateEliteAccountSquared p a a)))
          ;;EXEC coverage, not just the preview: both Talos elite ops called (ref-DALOS::EliteAurynID),
          ;;a member DALOS does not have (it is UR_EliteAurynID). Pact resolves module-reference
          ;;members at RUNTIME, so this loaded clean and only the caller died — and nothing called it.
          (expect "DALOS|C_UpdateEliteAccount executes (was a dead modref call)" true
              (!= "" (TS01-C1.DALOS|C_UpdateEliteAccount p a)))
          (expect "DALOS|C_UpdateEliteAccountSquared executes (was a dead modref call)" true
              (!= "" (TS01-C1.DALOS|C_UpdateEliteAccountSquared p a a))) ]))
(print "")
(commit-tx)
(print "")
;;||>>>>>>>>>>>>>>>>>>>>>>>>>
;;|| NEXT                   >
;;||>>>>>>>>>>>>>>>>>>>>>>>>>
(print "")
;;==== TX-I02 · 01 · DPTF INFO — INFO_DPTF|* return well-formed ClientInfo ====
(begin-tx "TX-I02 - INFO DPTF: INFO_DPTF|* previews return well-formed ClientInfo (URCi-sourced)")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(namespace "ouronet-ns")
(print "--- [TX-I02 · 01 · DPTF INFO smoke] ---")
;;==== TX-I02 - INFO DPTF: INFO_DPTF|* previews return well-formed ClientInfo (URCi-sourced) · 01 · env-sigs (caps) ==== 
(print "--- [TX-I02 - INFO DPTF: INFO_DPTF|* previews return well-formed ClientInfo (URCi-sourced) · 01 · env-sigs (caps)] ---")
(env-sigs [{ "key": "PK_AncientHodler", "caps": [] }])
;;==== TX-I02 - INFO DPTF: INFO_DPTF|* previews return well-formed ClientInfo (URCi-sourced) · 02 · let / invocation ==== 
(print "--- [TX-I02 - INFO DPTF: INFO_DPTF|* previews return well-formed ClientInfo (URCi-sourced) · 02 · let / invocation] ---")
(let
    (
        (p:string KST.ANHD)
        (a:string KST.ANHD)
        (ouro:string (DALOS.UR_OuroborosID))
    )
    (map print
        ;; IGNIS-cumulator ops (previously SIP tier buckets → now exact DPTF|URCi_*)
        [ (expect "INFO_DPTF|Control -> ClientInfo{ignis}" true (contains "ignis" (INFO-ONE.INFO_DPTF|Control p ouro)))
          (expect "INFO_DPTF|Burn -> ClientInfo{ignis}" true (contains "ignis" (INFO-ONE.INFO_DPTF|Burn p ouro a 1.0)))
          (expect "INFO_DPTF|Mint -> ClientInfo{ignis}" true (contains "ignis" (INFO-ONE.INFO_DPTF|Mint p ouro a 1.0 false)))
          (expect "INFO_DPTF|SetFee -> ClientInfo{ignis}" true (contains "ignis" (INFO-ONE.INFO_DPTF|SetFee p ouro 5.0)))
          (expect "INFO_DPTF|SetMinMove -> ClientInfo{ignis}" true (contains "ignis" (INFO-ONE.INFO_DPTF|SetMinMove p ouro 1.0)))
          (expect "INFO_DPTF|TogglePause -> ClientInfo{ignis}" true (contains "ignis" (INFO-ONE.INFO_DPTF|TogglePause p ouro true)))
          (expect "INFO_DPTF|ToggleReservation -> ClientInfo{ignis}" true (contains "ignis" (INFO-ONE.INFO_DPTF|ToggleReservation p ouro true)))
          (expect "INFO_DPTF|UpdatePendingBranding -> ClientInfo{ignis}" true (contains "ignis" (INFO-ONE.INFO_DPTF|UpdatePendingBranding p ouro)))
          ;; cost-mismatch fixes (Medium/Biggest → Big at exec): verify still well-formed
          (expect "INFO_DPTF|RotateOwnership -> ClientInfo{ignis}" true (contains "ignis" (INFO-ONE.INFO_DPTF|RotateOwnership p ouro a)))
          (expect "INFO_DPTF|ToggleFreezeAccount -> ClientInfo{ignis}" true (contains "ignis" (INFO-ONE.INFO_DPTF|ToggleFreezeAccount p ouro a true)))
          (expect "INFO_DPTF|ToggleTransferRole -> ClientInfo{ignis}" true (contains "ignis" (INFO-ONE.INFO_DPTF|ToggleTransferRole p ouro a true)))
          ;; gap ops now sourced from new core readers
          (expect "INFO_DPTF|DeployAccount -> ClientInfo{ignis}" true (contains "ignis" (INFO-ONE.INFO_DPTF|DeployAccount p ouro a)))
          (expect "INFO_DPTF|ToggleFeeLock -> ClientInfo{stoa}" true (contains "stoa" (INFO-ONE.INFO_DPTF|ToggleFeeLock p ouro false 0)))
          ;; STOA / dual-leg ops
          (expect "INFO_DPTF|UpgradeBranding -> ClientInfo{stoa}" true (contains "stoa" (INFO-ONE.INFO_DPTF|UpgradeBranding p ouro 3)))
          (expect "INFO_DPTF|Issue -> ClientInfo{ignis}" true (contains "ignis" (INFO-ONE.INFO_DPTF|Issue p a ["testtoken"])))
          ;; entity-completion: role toggles + transmute (previously had no INFO)
          (expect "INFO_DPTF|ToggleBurnRole -> ClientInfo{ignis}" true (contains "ignis" (INFO-ONE.INFO_DPTF|ToggleBurnRole p ouro a true)))
          (expect "INFO_DPTF|ToggleMintRole -> ClientInfo{ignis}" true (contains "ignis" (INFO-ONE.INFO_DPTF|ToggleMintRole p ouro a true)))
          (expect "INFO_DPTF|ToggleFeeExemptionRole -> ClientInfo{ignis}" true (contains "ignis" (INFO-ONE.INFO_DPTF|ToggleFeeExemptionRole p ouro a true)))
          (expect "INFO_DPTF|Transmute -> ClientInfo{ignis}" true (contains "ignis" (INFO-ONE.INFO_DPTF|Transmute p ouro a 10.0))) ]))
(print "")
(commit-tx)
(print "")
;;||>>>>>>>>>>>>>>>>>>>>>>>>>
;;|| NEXT                   >
;;||>>>>>>>>>>>>>>>>>>>>>>>>>
(print "")
;;==== TX-I03 · 01 · DPOF INFO — INFO_DPOF|* return well-formed ClientInfo ====
(begin-tx "TX-I03 - INFO DPOF: INFO_DPOF|* previews return well-formed ClientInfo (URCi-sourced)")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(namespace "ouronet-ns")
(print "--- [TX-I03 · 01 · DPOF INFO smoke] ---")
;;==== TX-I03 - INFO DPOF: INFO_DPOF|* previews return well-formed ClientInfo (URCi-sourced) · 01 · env-sigs (caps) ==== 
(print "--- [TX-I03 - INFO DPOF: INFO_DPOF|* previews return well-formed ClientInfo (URCi-sourced) · 01 · env-sigs (caps)] ---")
(env-sigs [{ "key": "PK_AncientHodler", "caps": [] }])
;; NOTE: [6.11] loads before any DPOF is issued, so id-dependent DPOF readers (Control/Mint/
;; AddQuantity/Burn/UpdatePendingBranding) have no valid DPOF id here. They mirror the proven
;; DPTF UDC_*Cumulator(UR_Konto id) pattern exactly (green in TX-I02). Assert the id-independent
;; readers (Issue / DeployAccount / UpgradeBranding), which fully exercise the URCi wiring.
;;==== TX-I03 - INFO DPOF: INFO_DPOF|* previews return well-formed ClientInfo (URCi-sourced) · 02 · let / invocation ==== 
(print "--- [TX-I03 - INFO DPOF: INFO_DPOF|* previews return well-formed ClientInfo (URCi-sourced) · 02 · let / invocation] ---")
(let
    (
        (p:string KST.ANHD)
        (a:string KST.ANHD)
    )
    (map print
        [ (expect "INFO_DPOF|Issue -> ClientInfo{ignis}" true (contains "ignis" (INFO-ONE.INFO_DPOF|Issue p a ["testorto"])))
          (expect "INFO_DPOF|Issue -> ClientInfo{stoa}" true (contains "stoa" (INFO-ONE.INFO_DPOF|Issue p a ["testorto"])))
          ;;REAL id, not the "ORTO-x" placeholder this line used until 2026-09-16. The assertion is
          ;;a SHAPE check (does the ClientInfo carry an "ignis" key), and it was passing a token
          ;;that does not exist -- which only worked because the preview did not validate its id.
          ;;RT-K-003 gave INFO_DPOF|DeployAccount the same existence check its exec runs, so the
          ;;shape check now needs a token that exists. The intent of the line is unchanged.
          (expect "INFO_DPOF|DeployAccount -> ClientInfo{ignis}" true (contains "ignis" (INFO-ONE.INFO_DPOF|DeployAccount p "V|OURO-98c486052a51" a)))
          (expect "INFO_DPOF|UpgradeBranding -> ClientInfo{stoa}" true (contains "stoa" (INFO-ONE.INFO_DPOF|UpgradeBranding p "ORTO-x" 3))) ]))
(print "")
(commit-tx)
(print "")
;;||>>>>>>>>>>>>>>>>>>>>>>>>>
;;|| NEXT                   >
;;||>>>>>>>>>>>>>>>>>>>>>>>>>
(print "")
