            (HibernatedPensionID:string 
                (at 1 (ref-TS01-C2::C_VST|CreateHibernatingLink patron PensionID))
            )
            (KoriID:string
                (at 0
                    (ref-TS01-C2::C_ATS|Issue
                        patron
                        patron
                        ["KORIndex" ]
                        [24]
                        [sstoa-id]
                        [false]
                        [PensionID ]
                        [false]
                    )
                )
            )
        )
        (acquire-module-admin ouronet-ns.DPTF)
        [
            [
                (format "Cumulated Resident on Kori is {}" [(ref-ATS::UR_SingleRewardTokenRUR KoriID sstoa-id 1)])
                (format "Cumulated Unbonding on Kori is {}" [(ref-ATS::UR_SingleRewardTokenRUR KoriID sstoa-id 2)])
                (format "Cumulated Royalty on Kori is {}" [(ref-ATS::UR_SingleRewardTokenRUR KoriID sstoa-id 3)])
            ]
            [
                (ref-TS01-C2::C_LQD|WrapStoa patron patron stoa-wrap-amount)
                (ref-TS01-C2::C_ATS|Coil patron patron "StoaLiquindex-98c486052a51" wstoa-id 98000.0)
                ;(format "Account AH existence for WSTOA is {}" [(ref-DPTF::UR_IzAccount wstoa-id patron)])
                ;(format "Read is {}" [(read DPTF.DPTF|BalanceTable (ref-DPTF::UC_IdAccount wstoa-id patron))])
            ]
            [
                (format "AH has Native Stoa {}" [(ref-coin::get-balance patron-stoa)])
                (format "AH has WSTOA {}" [(ref-DPTF::UR_AccountSupply wstoa-id patron)])
                (format "AH has SSTOA {}" [(ref-DPTF::UR_AccountSupply sstoa-id patron)])
                (ref-TS01-C1::C_DPTF|Transfer patron sstoa-id patron KST.EMMA 2000.0 false)
            ]
            [
                PensionID HibernatedPensionID KoriID
            ]
            [
                (ref-TS01-C2::C_ATS|SwitchDirectRecovery patron KoriID true)
                (ref-TS01-C2::C_ATS|Control patron KoriID true false true)
                (ref-TS01-C2::C_ATS|UpdateRoyalty patron KoriID 10.0)
                (ref-TS01-C2::C_ATS|SetDirectRecoveryFee patron KoriID 100.0)
            ]
        ]
    )
)


