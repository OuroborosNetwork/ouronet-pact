(begin-tx "TX-05 [4.1.5] - Dalos INIT [05]: Mint Primordial Tokens")
(namespace "ouronet-ns")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)

;;==== TX-05 [4.1.5] - Dalos INIT [05]: Mint Primordial Tokens · 01 · env-sigs (caps) ==== ========
(print "--- [TX-05 [4.1.5] - Dalos INIT [05]: Mint Primordial Tokens · 01 · env-sigs (caps)] ---")
(env-sigs
    [
        { "key": "PK_AncientHodler", "caps": [] }
        { "key": "PK_GasTanker", "caps": [] }
    ]
)

;;==== TX-05 [4.1.5] - Dalos INIT [05]: Mint Primordial Tokens · 02 · let / invocation ==== =======
(print "--- [TX-05 [4.1.5] - Dalos INIT [05]: Mint Primordial Tokens · 02 · let / invocation] ---")
(let
    (
        (ref-DALOS:module{OuronetDalosV1} DALOS)
        (ref-TS01-C1:module{TalosStageOne_ClientOneV1} TS01-C1)
        ;;
        (patron:string KST.ANHD)
        (info:string (ref-DALOS::CT_Info))
        (dalos:string (ref-DALOS::GOV|DALOS|SC_NAME))
        (ouroboros:string (ref-DALOS::GOV|OUROBOROS|SC_NAME))
        (ids:list
            (ref-TS01-C1::C_DPTF|Issue
                patron
                dalos
                ["Ouroboros" "Auryn" "EliteAuryn" "Ignis" "DalosWrappedStoa" "DalosLiquidStoa"]
                ["OURO" "AURYN" "ELITEAURYN" "GAS" "DWK" "DLK"]
                [24 24 24 24 12 24]
                [true true true true true true]         ;;can change owner
                [true true true true true true]         ;;can upgrade
                [true true true true true true]         ;;can can-add-special-role
                [true false true true false false]      ;;can-freeze
                [true false true false false false]     ;;can-wipe
                [true false false true false false]     ;;can pause
            )
        )
        (OuroID:string (at 0 ids))
        (AurynID:string (at 1 ids))
        (EliteAurynID:string (at 2 ids))
        (GasID:string (at 3 ids))
        (WrappedStoaID:string (at 4 ids))
        (StakedStoaID:string (at 5 ids))
        ;;
        (treasury-sc:string (ref-DALOS::GOV|DHV2|SC_NAME))        
    )
    [
        ;;REPL-VARIANT:
        (acquire-module-admin ouronet-ns.DALOS)
        ;;MAIN-NET VARIANT
        ;;(acquire-module-admin n_7d40ccda457e374d8eb07b658fd38c282c545038.DALOS)

        (update ref-DALOS::DALOS|PropertiesTable info
            { "gas-source-id"           : OuroID
            , "gas-id"                  : GasID
            , "ats-gas-source-id"       : AurynID
            , "elite-ats-gas-source-id" : EliteAurynID
            , "wrapped-stoa-id"          : WrappedStoaID
            , "silver-stoa-id"           : StakedStoaID
            }
        )
        ;;Set Token Roles Part I
        (ref-TS01-C1::C_DPTF|SetFee patron AurynID 50.0)
        (ref-TS01-C1::C_DPTF|SetFee patron EliteAurynID 100.0)
        (ref-TS01-C1::C_DPTF|ToggleFee patron AurynID true)
        (ref-TS01-C1::C_DPTF|ToggleFee patron EliteAurynID true)
        (ref-TS01-C1::C_DPTF|ToggleFeeLock patron AurynID true)
        (ref-TS01-C1::C_DPTF|ToggleFeeLock patron EliteAurynID true)
        ;;
        ;;Set Token Roles Part II
        (ref-TS01-C1::C_DPTF|SetMinMove patron GasID 1000.0)
        (ref-TS01-C1::C_DPTF|SetFee patron GasID -1.0)
        (ref-TS01-C1::C_DPTF|SetFeeTarget patron GasID dalos)
        (ref-TS01-C1::C_DPTF|ToggleFee patron GasID true)
        (ref-TS01-C1::C_DPTF|ToggleFeeLock patron GasID true)
        ;(ref-TS01-C1::C_DPTF|ToggleBurnRole patron GasID ouroboros true)
        ;(ref-TS01-C1::C_DPTF|ToggleBurnRole patron OuroID ouroboros true)
        ;(ref-TS01-C1::C_DPTF|ToggleMintRole patron GasID ouroboros true)
        ;(ref-TS01-C1::C_DPTF|ToggleMintRole patron OuroID ouroboros true)
        ;(ref-TS01-C1::C_DPTF|ToggleMintRole patron OuroID treasury-sc true)
    ]
)

