;;==== TX-03 [4.1.3] - Dalos INIT [03]: Insert Dalos Table Data · 02 · let / invocation ==== ======
(print "--- [TX-03 [4.1.3] - Dalos INIT [03]: Insert Dalos Table Data · 02 · let / invocation] ---")
(let
    (
        (ref-U|CT:module{OuronetConstantsV1} U|CT)
        (ref-DALOS:module{OuronetDalosV1} DALOS)
        (ref-LIQUID:module{StoaLiquidStakingV1} LIQUID)
        (ref-TS01-A:module{TalosStageOne_AdminV1} TS01-A)
        ;;
        (bar:string (ref-U|CT::CT_BAR))
        (info:string (ref-DALOS::CT_Info))
        (vgd:string (ref-DALOS::CT_VirtualGasData))
        (lqd:string (ref-LIQUID::CT_Info))
    )
    [
        ;;Stoa Prices (Main-Net Prices x1000)
        (ref-TS01-A::A_DALOS|UpdateUsagePrice "standard"      0.01)
        (ref-TS01-A::A_DALOS|UpdateUsagePrice "smart"         0.02)
        (ref-TS01-A::A_DALOS|UpdateUsagePrice "ats"            0.1)
        (ref-TS01-A::A_DALOS|UpdateUsagePrice "swp"           0.15)
        (ref-TS01-A::A_DALOS|UpdateUsagePrice "dptf"           0.2)
        (ref-TS01-A::A_DALOS|UpdateUsagePrice "dpmf"           0.3)
        (ref-TS01-A::A_DALOS|UpdateUsagePrice "dpsf"           0.4)
        (ref-TS01-A::A_DALOS|UpdateUsagePrice "dpnf"           0.5)
        (ref-TS01-A::A_DALOS|UpdateUsagePrice "blue"         0.025)
        (ref-TS01-A::A_DALOS|UpdateUsagePrice "codex"        100.0)

        ;;Ignis Prices
        (ref-TS01-A::A_DALOS|UpdateUsagePrice "ignis|smallest"            1.0)
        (ref-TS01-A::A_DALOS|UpdateUsagePrice "ignis|small"               2.0)
        (ref-TS01-A::A_DALOS|UpdateUsagePrice "ignis|medium"              3.0)
        (ref-TS01-A::A_DALOS|UpdateUsagePrice "ignis|big"                 4.0)
        (ref-TS01-A::A_DALOS|UpdateUsagePrice "ignis|biggest"             5.0)
        (ref-TS01-A::A_DALOS|UpdateUsagePrice "ignis|branding"          100.0)
        (ref-TS01-A::A_DALOS|UpdateUsagePrice "ignis|token-issue"       500.0)
        (ref-TS01-A::A_DALOS|UpdateUsagePrice "ignis|ats-issue"        5000.0)
        (ref-TS01-A::A_DALOS|UpdateUsagePrice "ignis|swp-issue"        4000.0)
        (ref-TS01-A::A_DALOS|UpdateUsagePrice "ignis|swp-liquidity"      20.0)

