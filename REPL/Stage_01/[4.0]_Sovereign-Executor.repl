;;==== TX-07 [4.1.7] - Dalos INIT [07]: Issue Primordial Autostake Pairs · 02 · let / invocation ==== 
(print "--- [TX-07 [4.1.7] - Dalos INIT [07]: Issue Primordial Autostake Pairs · 02 · let / invocation] ---")
(let
    (
        (ref-DALOS:module{OuronetDalosV1} DALOS)
        (ref-TS01-C2:module{TalosStageOne_ClientTwoV1} TS01-C2)
        ;;
        (patron:string KST.ANHD)
        (OuroID:string (ref-DALOS::UR_OuroborosID))
        (AurynID:string (ref-DALOS::UR_AurynID))
        (EliteAurynID:string (ref-DALOS::UR_EliteAurynID))
        (WrappedStoaID:string (ref-DALOS::UR_WrappedStoaID))
        (StakedStoaID:string (ref-DALOS::UR_SilverStoaID))
        (ats-ids:list
            (ref-TS01-C2::C_ATS|Issue
                patron
                patron
                ["Auryndex" "EliteAuryndex" "StoaLiquindex"]
                [24 24 24]
                [OuroID AurynID WrappedStoaID]
                [true true false]
                [AurynID EliteAurynID StakedStoaID]
                [false true true]
            )
        )
        (Auryndex:string (at 0 ats-ids))
        (Elite-Auryndex:string (at 1 ats-ids))
        (Stoa-Liquid-Index:string (at 2 ats-ids))            
    )
    [
        ;;Set Up <Auryndex> 4795
        (ref-TS01-C2::C_ATS|SetColdRecoveryFees patron Auryndex
            7
            [50.0 100.0 200.0 350.0 550.0 800.0]
            [
                [8.0 7.0 6.0 5.0 4.0 3.0 2.0]
                [9.0 8.0 7.0 6.0 5.0 4.0 3.0]
                [10.0 9.0 8.0 7.0 6.0 5.0 4.0]
                [11.0 10.0 9.0 8.0 7.0 6.0 5.0]
                [12.0 11.0 10.0 9.0 8.0 7.0 6.0]
                [13.0 12.0 11.0 10.0 9.0 8.0 7.0]
                [14.0 13.0 12.0 11.0 10.0 9.0 8.0]
            ]
        )
        (ref-TS01-C2::C_ATS|SwitchColdRecovery patron Auryndex true)
        ;;Set Up <EliteAuryndex>
        (ref-TS01-C2::C_ATS|SetColdRecoveryFees patron Elite-Auryndex 7 [0.0] [[0.0]])
        (ref-TS01-C2::C_ATS|SetColdRecoveryDuration patron Elite-Auryndex false 360 24)
        (ref-TS01-C2::C_ATS|ToggleElite patron Elite-Auryndex true)
        (ref-TS01-C2::C_ATS|SwitchColdRecovery patron Elite-Auryndex true)
        ;;Set Up <StoaLiquindex>
        (ref-TS01-C2::C_ATS|SetColdRecoveryFees patron Stoa-Liquid-Index -1 [0.0] [[0.0]])
        (ref-TS01-C2::C_ATS|SetColdRecoveryDuration patron Stoa-Liquid-Index false 12 6)
        (ref-TS01-C2::C_ATS|SwitchColdRecovery patron Stoa-Liquid-Index true)
        ats-ids
    ]
)

