(load "../2_CITIZEN/4_VaultsMinter/04_AQP-BOOT.pact")
;;==== TX-02 [5.5] - AQP-BOOT Module · 03 · gas echo ==== =====================================
(print "--- [TX-02 [5.5] - AQP-BOOT Module · 03 · gas echo] ---")
(format "<<<<<<<AQP-BOOT Costs {} GAS>>>>>>>" [(env-gas)])
(print "")
(commit-tx)
(print "")
(begin-tx "TX-02 [5.6] - AQP-BOOT Step0 IMC + vault governor")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(namespace "ouronet-ns")
;;==== TX-02 [5.6] - AQP-BOOT Step0 · 01 · env-sigs (caps) ==== ==================================
(print "--- [TX-02 [5.6] - AQP-BOOT Step0 · 01 · env-sigs (caps)] ---")
(env-sigs
  [
    { "key": "PK_AncientHodler", "caps": [] }
  ])
;;==== TX-02 [5.6] - AQP-BOOT Step0 · 02 · C_Step0_WireImcAndGovernor ==== =======================
(print "--- [TX-02 [5.6] - AQP-BOOT Step0 · 02 · C_Step0_WireImcAndGovernor] ---")
(print (format "<(AQP-BOOT|C_Step0_WireImcAndGovernor)> => \"{}\"" [(AQP-BOOT.C_Step0_WireImcAndGovernor KST.ANHD)]))
;;==== TX-02 [5.6] - AQP-BOOT Step0 · 03 · gas echo ==== =========================================
(print "--- [TX-02 [5.6] - AQP-BOOT Step0 · 03 · gas echo] ---")
(format "<<<<<<<AQP-BOOT Step0 Costs {} GAS>>>>>>>" [(env-gas)])
(print "")
(commit-tx)
