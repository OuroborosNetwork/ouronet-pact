(print "")
(begin-tx "TX-02 [5.4a] - KBN slave module (deploy only — AQP-BOOT load prerequisite)")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(namespace "ouronet-ns")
(print "--- [TX-02 [5.4a] - KBN slave · 01 · env-sigs] ---")
(env-sigs
  [{"key": "1a4e15d3c51e0b73e92644600487ba8eaae312e1a178b91801d54e13c1b350a5", "caps": []}])
(print "--- [TX-02 [5.4a] - KBN slave · 02 · load module] ---")
(load "../2_CITIZEN/3_BunniesMinter/02_KBunnies.pact")
(print "--- [TX-02 [5.4a] - KBN slave · 03 · gas echo] ---")
(format "<<<<<<<KBN slave (deploy only) Costs {} GAS>>>>>>>" [(env-gas)])
(print "")
(commit-tx)
(print "")
(begin-tx "TX-02 [5.5] - AQP-BOOT Module")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(namespace "ouronet-ns")
;;==== TX-02 [5.5] - AQP-BOOT Module · 01 · env-sigs (caps) ==== ==============================
(print "--- [TX-02 [5.5] - AQP-BOOT Module · 01 · env-sigs (caps)] ---")
(env-sigs
  [{"key": "1a4e15d3c51e0b73e92644600487ba8eaae312e1a178b91801d54e13c1b350a5", "caps": []}])
;;==== TX-02 [5.5] - AQP-BOOT Module · 02 · load module ==== ==================================
