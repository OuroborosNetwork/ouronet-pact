;;
;; REPL/deb-staleness-sweep-cc.repl — sibling of deb-staleness-proof.repl for the
;; sweep CC-batch (defun+gate) equivalence proof. Loads the IDENTICAL fixture chain
;; (through [6.4]_AQP-EXHAUSTIVE-COLLECT.repl, which stands up the SnakePower triplet +
;; ANHD's AurynRain/Silver stake in OuroLpFarm), then retires the AurynRain anchor via
;; the paginated CC-batch instead of the 2-step defpact.
;;
;; WHY A SEPARATE DRIVER: the sweep RETIRES AurynRain destructively. deb-staleness-proof.repl
;; retires it via the defpact ([6.2.7] SWEEP01); this driver retires the SAME anchor via the
;; CC-batch ([6.2.8]) in its OWN pact process (fresh AurynRain). Both assert the same
;; end-state — a true apples-to-apples defpact-vs-defun+gate equivalence on one fixture.
;;
(print "")
(print "================================================================")
(print "FILE  REPL/deb-staleness-sweep-cc.repl  —  sweep CC-batch equivalence")
(print "================================================================")
(load "Stage00_Sanboxes.repl")
(load "Stage01_Tester.repl")
;;#P2 REPAIR: this hand-rolled Stage-2 deploy block predated deploy-stage02.repl and no longer
;;provisions everything the suites below need -- notably KBN, which [5.4]_PopulateBunnies stopped
;;deploying itself ("no longer redeployed here", [5.4] line 50) once deploy-stage02 took it over.
;;The result was "Module KBN has no such member: A_Step01" partway through, killing the run.
;;deploy-stage02.repl IS this block plus [Z]_Reads, KBN, AQP-BOOT and Step0, so it replaces both
;;this and the hand-rolled AQP-BOOT transactions that used to follow.
(load "deploy-stage02.repl")
(load "Stage_02/[5.2]_PopulateBloodshed.repl")
(load "Stage_02/[5.1]_PopulateNosferatu.repl")
(load "Stage_02/[5.4]_PopulateBunnies.repl")
(load "Stage_02/[6.2.1]_AQP-ANK.repl")
(load "Stage_02/[6.2.2]_AQP-SCORE.repl")
(load "Stage_02/[6.2.3]_AQP-POOL.repl")
(load "Stage_02/[6.2.9]_AQP-BOOT-FULL.repl")
(load "Stage_02/[6.4]_AQP-EXHAUSTIVE-PREP.repl")
(load "Stage_02/[6.4]_AQP-EXHAUSTIVE-BOOT-POOLS.repl")
(load "Stage_02/[6.4]_AQP-EXHAUSTIVE-RPS.repl")
(load "Stage_02/[6.4]_AQP-EXHAUSTIVE-COLLECT.repl")

;;AQP-INFO is loaded HERE, not inside the suites below, because those suites are shared files and a
;;shared file may only name what its NARROWEST loader provides (the lesson from the launchpad gate
;;failure: `[5.3]_Launchpad.repl` compiled under one Stage-02 chain and died under the other).
;;`[6.2.8]`/`[6.2.8b]` are loaded live ONLY from this runner — AQP-FULL keeps both COMMENTED OUT —
;;so this is the one chain that can supply the reader for the cost blocks inside them.
;;IF AQP-FULL EVER UNCOMMENTS THEM, it already loads AQP-INFO at `[6.5]_AQP-INFO.repl`, but LATER in
;;the file than the commented sweep block: that load would have to move ahead of it, or the suites
;;would have to carry their own.
(begin-tx "AQP-INFO - load module for the sweep cost blocks")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(namespace "ouronet-ns")
;;==== AQP-INFO - load module for the sweep cost blocks · 01 · env-sigs (caps) ==== ===============
(print "--- [AQP-INFO - load module for the sweep cost blocks · 01 · env-sigs (caps)] ---")
(env-sigs [{ "key": "1a4e15d3c51e0b73e92644600487ba8eaae312e1a178b91801d54e13c1b350a5", "caps": [] }])
;;==== AQP-INFO - load module for the sweep cost blocks · 02 · load module ==== ===================
(print "--- [AQP-INFO - load module for the sweep cost blocks · 02 · load module] ---")
(load "../1_SOVEREIGN/STAGE_02/2_Core/03_AQP/09_AQP-INFO.pact")
(commit-tx)
(load "Stage_02/[6.2.8b]_AQP-UNSTALE.repl")
(load "Stage_02/[6.2.8]_AQP-SWEEP-CC.repl")
