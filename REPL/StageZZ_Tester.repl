;;
;; REPL/StageZZ_Tester.repl — canonical integration layout (OuronetInformational/ARCHITECTURE/REPL_AND_TESTS.md)
;;   Inter-tx:   ;;|| NEXT >  (same three lines as REPL/Stage_01/[2.2]_Core.repl)
;;   Intra-tx:   ;;==== <TX label> · mm · <slug> ====  + next-line (print "--- [<label> · mm · …] ---"); mm = 01.. within each (begin-tx …) (see OuronetInformational/ARCHITECTURE/REPL_AND_TESTS.md).
;;   format "{}": Talos / module echoes and (env-gas) — document additional prefixes in this file's (print …) lines as needed.
;;
(print "")
(print "================================================================")
(print "FILE  REPL/StageZZ_Tester.repl")
(print "================================================================")
(print "Legend (terminal observability): see ;; preface; echoes use <(…)> where helpful.")
(print "Source: ;;|| NEXT > between txs; ;;==== … · mm · … ==== + banner before each begin-tx.")
(print "")
;;
;;
;;================================================================================
;;                                                                              ;;
;;              STAGE ZZ — DPL-UR + EXPLORER (read-only / UI helpers)          ;;
;;                                                                              ;;
;;  Deploys 2_SLAVE/Stage_Z/01_DPL-UR.pact and 02_EXPLORER.pact.                ;;
;;                                                                              ;;
;;  Requires Stage 1 + Stage 2 (incl. DPDC for DPL-UR URC_0021–0026). Run after  ;;
;;  Stage02_Tester.repl (e.g. from Z.repl). Loads only — no bundled REPL tests.   ;;
;;                                                                              ;;
;;================================================================================
;;
;;
(print "")
(begin-tx "TX-ZZ [Stage_Z] - DPL-UR unified module (Stage_Z/01_DPL-UR.pact)")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(namespace "ouronet-ns")
;;==== TX-ZZ [Stage_Z] - DPL-UR unified module (Stage_Z/01_DPL-UR.pact) · 01 · env-sigs (caps) ==== 
(print "--- [TX-ZZ [Stage_Z] - DPL-UR unified module (Stage_Z/01_DPL-UR.pact) · 01 · env-sigs (caps)] ---")
(env-sigs
  [{"key": "1a4e15d3c51e0b73e92644600487ba8eaae312e1a178b91801d54e13c1b350a5", "caps": []}])
;;==== TX-ZZ [Stage_Z] - DPL-UR unified module (Stage_Z/01_DPL-UR.pact) · 02 · load module ==== ===
(print "--- [TX-ZZ [Stage_Z] - DPL-UR unified module (Stage_Z/01_DPL-UR.pact) · 02 · load module] ---")
(load "../2_SLAVE/Stage_Z/01_DPL-UR.pact")
;;==== TX-ZZ [Stage_Z] - DPL-UR unified module (Stage_Z/01_DPL-UR.pact) · 03 · gas echo ==== ======
(print "--- [TX-ZZ [Stage_Z] - DPL-UR unified module (Stage_Z/01_DPL-UR.pact) · 03 · gas echo] ---")
(format "<<<<<<<DPL-UR (Stage_Z unified) Costs {} GAS>>>>>>>" [(env-gas)])
(print "")
(commit-tx)
(print "")
;;||>>>>>>>>>>>>>>>>>>>>>>>>>
;;|| NEXT                   >
;;||>>>>>>>>>>>>>>>>>>>>>>>>>
(print "")
(begin-tx "TX-ZZ [Stage_Z] - EXPLORER read module (Stage_Z/02_EXPLORER.pact)")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(namespace "ouronet-ns")
;;==== TX-ZZ [Stage_Z] - EXPLORER read module · 01 · env-sigs (caps) ==== ==========================
(print "--- [TX-ZZ [Stage_Z] - EXPLORER read module · 01 · env-sigs (caps)] ---")
(env-sigs
  [{"key": "1a4e15d3c51e0b73e92644600487ba8eaae312e1a178b91801d54e13c1b350a5", "caps": []}])
;;==== TX-ZZ [Stage_Z] - EXPLORER read module · 02 · load module ==== ===============================
(print "--- [TX-ZZ [Stage_Z] - EXPLORER read module · 02 · load module] ---")
(load "../2_SLAVE/Stage_Z/02_EXPLORER.pact")
;;==== TX-ZZ [Stage_Z] - EXPLORER read module · 03 · gas echo ==== =================================
(print "--- [TX-ZZ [Stage_Z] - EXPLORER read module · 03 · gas echo] ---")
(format "<<<<<<<EXPLORER (Stage_Z) Costs {} GAS>>>>>>>" [(env-gas)])
(print "")
(commit-tx)
(print "")
