(print "")
(begin-tx "TX-ZZ [Stage_Z] - DPL-UR unified module (Stage_Z/01_DPL-UR.pact)")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(namespace "ouronet-ns")
(env-sigs
