(print "")
(print "=== AQP FVT integration (TF / OF / DC / NF stake suites) ===")
;; [6.2.4]_AQP-FVT self-loads FVT-OF / FVT-DC / FVT-NF at its tail (pulls Stage_01/[6.5]_DPOF).
(load "Stage_02/[6.2.4]_AQP-FVT.repl")
(print "")
