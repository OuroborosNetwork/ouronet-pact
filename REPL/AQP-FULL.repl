(load "Stage_02/[6.2.9]_AQP-BOOT-FULL.repl")
(print "")
(print "=== AQP exhaustive prep (E|DH equity split, DHCD RPS weights) ===")
(load "Stage_02/[6.4]_AQP-EXHAUSTIVE-PREP.repl")
(print "")
(print "=== AQP exhaustive boot pools (all C_Step7 entities stake/unstake) ===")
(load "Stage_02/[6.4]_AQP-EXHAUSTIVE-BOOT-POOLS.repl")
(print "")
(print "=== AQP exhaustive proportional RPS (expected collect amounts) ===")
(load "Stage_02/[6.4]_AQP-EXHAUSTIVE-RPS.repl")
(print "")
