;;
;; REPL/AQP-FULL.repl — SINGLE-BOOT unified AQP audit.
;;
;; The whole AQP surface exercised in ONE pact process: one full deploy + population +
;; AQP-BOOT (Steps 0-12), then every AQP scenario in state-dependency order. This is the
;; seed of the eventual "one run tests everything" gate — it collapses the 15 redundant
;; per-suite boots of run-aqp-audit.sh into a single shared boot.
;;
;; ORDER CONTRACT (why the tail is sequenced the way it is):
;;   BOOT ............. Stage 00 -> 01 -> 02 core/talos/executor + population + AQP-BOOT
;;   NON-DESTRUCTIVE .. ANK/SCORE/POOL, BOOT-FULL, EXHAUSTIVE prep/pools/RPS/collect,
;;                      FVT stake suites, [6.3] golden paths, DPNF, ANK-LP, triplet-diag,
;;                      FVT-admin. Read-heavy; leaves pools staked and anchors live.
;;   DESTRUCTIVE TAIL . ordered FRESHEN -> DRAIN -> RETIRE so no scenario invalidates a
;;                      later one's baseline:
;;                        1. inject-cc / unstale / unstale-all  (freshen stale scores; pools intact)
;;                        2. deb-mtx                            (MTX inject+sweep defpacts)
;;                        3. triplet-collect                    (dual-stream vacate on triplet)
;;                        4. vct vacate                         (drains stake pools)
;;                        5. sweep-cc                           (retires AurynRain — most destructive, last)
;;
;; Phase B (info/stream/DSA inline bodies) folds in after extraction — see AQP-FULL notes.
;;
;; Run:  cd REPL && pact AQP-FULL.repl
;;
(print "")
(print "================================================================")
(print "FILE  REPL/AQP-FULL.repl")
(print "================================================================")
(print "AQP-FULL START — single-boot unified AQP audit")
(print "")

;; ================================================================
;; BOOT — full deploy + population (shared by ALL scenarios below)
;; ================================================================
(load "Stage00_Sanboxes.repl")
(load "Stage01_Tester.repl")
(load "Stage_02/[0.1]_Interfaces.repl")
(load "Stage_02/[2.1]_DpdcCore.repl")
(load "Stage_02/[2.2]_DemiPad.repl")
(load "Stage_02/[2.3]_EarningPools.repl")
(load "Stage_02/[3]_Talos.repl")
(load "Stage_02/[4.0]_Sovereign-Executor.repl")
(print "")
(print "=== POPULATION — Bloodshed / Nosferatu / Bunnies (full DPNF mint) ===")
(print "Note: KBN deploy is TX-01 inside PopulateBunnies — do not pre-load KBN here.")
(load "Stage_02/[5.2]_PopulateBloodshed.repl")
(load "Stage_02/[5.1]_PopulateNosferatu.repl")
(load "Stage_02/[5.4]_PopulateBunnies.repl")
(print "")
(begin-tx "TX-AQP-BOOT - AQP-BOOT module")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(namespace "ouronet-ns")
(env-sigs [{"key": "1a4e15d3c51e0b73e92644600487ba8eaae312e1a178b91801d54e13c1b350a5", "caps": []}])
(load "../2_SLAVE/Stage_02/04_AQP-BOOT.pact")
(commit-tx)
(print "")
(begin-tx "TX-AQP-BOOT - AQP-BOOT Step0 IMC + vault governor")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(namespace "ouronet-ns")
(env-sigs [{ "key": "PK_AncientHodler", "caps": [] }])
(print (format "<(AQP-BOOT|C_Step0_WireImcAndGovernor)> => \"{}\"" [(AQP-BOOT.C_Step0_WireImcAndGovernor KST.ANHD)]))
(commit-tx)
(print "")

;; ================================================================
;; NON-DESTRUCTIVE CORE  (comprehensive's proven composition)
;; ================================================================
(print "=== AQP module integration (ANK / SCORE / POOL probe suites) ===")
(load "Stage_02/[6.2.1]_AQP-ANK.repl")
(load "Stage_02/[6.2.2]_AQP-SCORE.repl")
(load "Stage_02/[6.2.3]_AQP-POOL.repl")
(print "")
