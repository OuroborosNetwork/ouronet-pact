(load "Stage_02/[6.4]_AQP-EXHAUSTIVE-FVT-ADMIN.repl")
(print "")

;; ================================================================
;; DESTRUCTIVE TAIL — DEFERRED (needs hermetic fixture isolation)
;; ================================================================
;; The five destructive tails below each assume a PRISTINE post-COLLECT world (absolute
;; pre-state asserts like "no forced-fix penalty yet: expected 0" + physical claims on the
;; SAME shared fixtures the non-destructive core already consumed — e.g. DHBunnies-98 NFs).
;; Concatenated after the core they fail with cross-scenario state bleed (proven: 424 core
;; asserts GREEN, then 9 fails + 1 load-fail starting in tail 1-2 — DHBunnies-98 double-stake).
;;
;; To fold them into this single boot, each must be made HERMETIC: own account / DEB entity /
;; NFs / anchor, and delta-based (not absolute) pre-state asserts. That is test-code work only
;; (no module/interface change) and is TRACKED — see:
;;   OuronetInformational/memories/2026-08-27-aqp-full-unified-test.md
;;
;; Until then these run as separate boots via run-aqp-audit.sh. Uncomment + isolate one at a
;; time (freshen -> drain -> retire order) as each is made hermetic:
;;   (load "Stage_02/[6.2.8c]_AQP-INJECT-CC.repl")        ; freshen
;;   (load "Stage_02/[6.2.8b]_AQP-UNSTALE.repl")          ; freshen
;;   (load "Stage_02/[6.2.8d]_AQP-UNSTALE-ALL-CC.repl")   ; freshen
;;   (load "Stage_02/[6.2.7]_AQP-DEB-MTX.repl")           ; deb/mtx defpacts
;;   (load "Stage_02/[6.4]_AQP-TRIPLET-COLLECT.repl")     ; triplet dual-stream vacate
;;   (load "Stage_02/[6.2.5]_AQP-VCT.repl")               ; vacate (drains pools)
;;   (load "Stage_02/[6.2.8]_AQP-SWEEP-CC.repl")          ; retire AurynRain (LAST)

(print "================================================================")
(print "AQP-FULL — NON-DESTRUCTIVE CORE COMPLETE (single boot)")
(print "(destructive tails deferred — see 2026-08-27-aqp-full-unified-test.md)")
(print "AQP-FULL END")
(print "================================================================")
