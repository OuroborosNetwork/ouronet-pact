;; deploy-stage01.repl — Stage 1 deploy core (the "blockchain env": interfaces → utilities →
;; DALOS → cores → Talos → Z_Reads → sovereign executor → citizen AOZ/Dispenser). Deploy ONLY,
;; no [6.x] scenario suites. Shared by Stage01_Tester, ZALL.repl, and standalone module testers.
;; Assumes Stage 00 (deploy-stage00.repl) already loaded.
;;STARTER
(load "Stage_01/[0.0]_Starter.repl")
;;SOVEREIGN DEPLOYER
(load "Stage_01/[0.1]_Interfaces.repl")
(load "Stage_01/[1]_Utilities.repl")
(load "Stage_01/[2.1]_Dalos.repl")
(load "Stage_01/[2.2]_Core.repl")
(load "Stage_01/[3]_Talos.repl")
;;Z_READS — read-only presentation layer, deployed LAST (after 3_Talos): INFO-ZERO
(load "Stage_01/[Z]_Reads.repl")
;;SOVEREIGN EXECUTOR (initialise sovereign functionality)
(load "Stage_01/[4.0]_Sovereign-Executor.repl")
;;CITIZEN DEPLOYER + EXECUTOR
(load "Stage_01/[5.1]_Aoz+.repl")
(load "Stage_01/[5.2]_Dispenser+.repl")
