(begin-tx "TX-LPG-03 - a NON-ladder lane answers the whole payout on token-0")
(namespace "ouronet-ns")
(env-gasmodel "table")(env-gaslimit 200000000)(env-gas 0)
(print "")
(print "=== TX-LPG-03 — non-ladder lane degenerates correctly =========================")
;;==== TX-LPG-03 - non-ladder lane · 01 · assertions ==== =========================================
(print "--- [TX-LPG-03 - non-ladder lane · 01 · assertions] ---")
;;A collected-out lane has payout 0, which is the branch a client hits most often (every lane the
;;user is not currently owed anything on). It must answer with the lane's own token and zeros
;;above it -- NOT with BAR on token-0, which would make a client render an unknown ticker.
(let
    (
        (patron:string KST.ANHD)
        (ouro-id:string "OURO-98c486052a51")
        (fvt-id:string (U|DALOS.UDC_Makeid "CustodiansVault"))
        (pool-id:string (U|DALOS.UDC_Makeid "CustodiansPool"))
    )
    (let*
        (
            (auryn:string (DALOS.UR_AurynID))
            (elite:string (DALOS.UR_EliteAurynID))
            (anhd-triplet:string (AQP-SCORE.UC_ComputeTripletId
                (U|DALOS.UDC_Makeid "OuronetPrimeBronze")
                (U|DALOS.UDC_Makeid "OuronetPrimeSilver")
                (U|DALOS.UDC_Makeid "OuronetPrimeGolden")))
            (pv:object (RPS.URC_CollectLadderPreview patron pool-id fvt-id 3 anhd-triplet ouro-id))
        )
        (print (format "ZZZ drained preview = {}" [pv]))
        (map print
            [
                (expect "<<LPG-11>> a drained lane previews payout 0"
                    0.0 (at "payout" pv))
                (expect "<<LPG-13>> a drained lane previews zero on every leg"
                    [0.0 0.0 0.0]
                    [(at "token-0-amount" pv) (at "token-1-amount" pv) (at "token-2-amount" pv)])
                ;;THE REGRESSION. The first cut short-circuited on `payout <= 0` BEFORE looking at
                ;;the reward kind, so a drained LADDER lane answered mode=BAR with BAR token ids --
                ;;indistinguishable from a plain single-token lane, and that is the branch every
                ;;lane the user is not currently owed anything on takes. A client cannot render
                ;;three tokens at zero from an answer that names one unknown ticker.
                (expect "<<LPG-12>> a drained LADDER lane still names all THREE ladder tokens"
                    [ouro-id auryn elite]
                    [(at "token-0-id" pv) (at "token-1-id" pv) (at "token-2-id" pv)])
                (expect "<<LPG-14>> ...and still reports the mode it would route under"
                    "HETEROGENEOUS" (at "mode" pv))
            ])
        ""
    )
)
(env-sigs [])
(commit-tx)

