(begin-tx "TX-LPG-06 - HOMOGENEOUS with BOTH silver and golden: the keep/ladder SPLIT")
(namespace "ouronet-ns")
(env-gasmodel "table")(env-gaslimit 200000000)(env-gas 0)
(print "")
(print "=== TX-LPG-06 — HOMOGENEOUS, silver AND golden (the subtraction case) =========")
;;==== TX-LPG-06 - keep/ladder split · 01 · give the holder a SILVER lane too ==== ================
(print "--- [TX-LPG-06 - keep/ladder split · 01 · give the holder a SILVER lane too] ---")
;;THE LAST CELL OF THE MATRIX, and the only one where the arithmetic matters. With silver ALONE
;;rbt1-ladder is exactly 0 (both sides are the same call on the same argument); with golden ALONE
;;rbt1-keep is 0 and the ladder takes everything. Only when BOTH lanes carry weight does the
;;collect actually evaluate
;;      rbt1-ladder = RBT(ats-01, token-0, silver+golden) - RBT(ats-01, token-0, silver)
;;and only then can the second coil be fed the wrong amount. ANHD's agency is golden-only
;;(lane-g 10,000,000), so staking a SILVER Custodians nonce is what reaches this branch.
;;Custodians nonce 2 = Silver, 10 000 quintessence per whole unit (BOOT|CUSTODIANS_* values).
(let
    (
        (patron:string KST.ANHD)
        (ouro-id:string "OURO-98c486052a51")
        (dhoc-id:string "DHOC-98c486052a51")
        (fvt-id:string (U|DALOS.UDC_Makeid "CustodiansVault"))
        (pool-id:string (U|DALOS.UDC_Makeid "CustodiansPool"))
    )
    (env-sigs [{ "key": "PK_AncientHodler", "caps": [] }])
    (print (format "<(ANHD stakes 1x nonce 2 = SILVER)> => \"{}\""
        [(TS02-C3.AQP-POOL|CC_StakeSemiFungibleCollectable patron patron patron pool-id dhoc-id [2])]))
    (print (format "<(CC_Inject 3000 OURO)> => \"{}\""
        [(TS02-C3.AQP-FVT|CC_Inject patron patron fvt-id ouro-id 3000.0)]))
)
(env-sigs [])
(commit-tx)

