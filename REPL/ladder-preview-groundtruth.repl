(begin-tx "TX-LPG-05 - HOMOGENEOUS preview vs real deltas, asserted against the LANES")
(namespace "ouronet-ns")
(env-gasmodel "table")(env-gaslimit 200000000)(env-gas 0)
(print "")
(print "=== TX-LPG-05 — HOMOGENEOUS preview vs deltas =================================")
;;==== TX-LPG-05 - homogeneous preview · 01 · preview, collect, compare ==== ======================
(print "--- [TX-LPG-05 - homogeneous preview · 01 · preview, collect, compare] ---")
(let
    (
        (patron:string KST.ANHD)
        (ouro-id:string "OURO-98c486052a51")
        (fvt-id:string (U|DALOS.UDC_Makeid "CustodiansVault"))
        (pool-id:string (U|DALOS.UDC_Makeid "CustodiansPool"))
    )
    (let*
        (
            (auryn:string (DALOS.UR_AurynID))
            (elite:string (DALOS.UR_EliteAurynID))
            (anhd-triplet:string (AQP-SCORE.UC_ComputeTripletId
                (U|DALOS.UDC_Makeid "OuronetPrimeBronze")
                (U|DALOS.UDC_Makeid "OuronetPrimeSilver")
                (U|DALOS.UDC_Makeid "OuronetPrimeGolden")))
            (lanes:object (RPS.URC_ComputeTripletLanes patron pool-id anhd-triplet))
            (pv:object (RPS.URC_CollectLadderPreview patron pool-id fvt-id 3 anhd-triplet ouro-id))
            (o0:decimal (DPTF.UR_AccountSupply ouro-id patron))
            (a0:decimal (DPTF.UR_AccountSupply auryn   patron))
            (e0:decimal (DPTF.UR_AccountSupply elite   patron))
        )
        (env-sigs [{ "key": "PK_AncientHodler", "caps": [] }])
        (print (format "ZZZ lanes   = {}" [lanes]))
        (print (format "ZZZ preview = {}" [pv]))
        (print (format "<(CC_Collect)> => \"{}\""
            [(TS02-C3.AQP-FVT|CC_Collect patron patron fvt-id 3 anhd-triplet ouro-id)]))
        ;;==== TX-LPG-05 - homogeneous preview · 02 · assertions ==== =============================
        (print "--- [TX-LPG-05 - homogeneous preview · 02 · assertions] ---")
        (let
            (
                (d-ouro:decimal  (- (DPTF.UR_AccountSupply ouro-id patron) o0))
                (d-auryn:decimal (- (DPTF.UR_AccountSupply auryn   patron) a0))
                (d-elite:decimal (- (DPTF.UR_AccountSupply elite   patron) e0))
            )
            (print (format "ZZZ deltas ouro={} auryn={} elite={}" [d-ouro d-auryn d-elite]))
            (map print
                [
                    (expect (format "<<LPG-15>> HOMOGENEOUS preview token-0 == real OURO delta (got={})" [d-ouro])
                        d-ouro (at "token-0-amount" pv))
                    (expect (format "<<LPG-16>> HOMOGENEOUS preview token-1 == real AURYN delta (got={})" [d-auryn])
                        d-auryn (at "token-1-amount" pv))
                    (expect (format "<<LPG-17>> HOMOGENEOUS preview token-2 == real ELITE delta (got={})" [d-elite])
                        d-elite (at "token-2-amount" pv))
                    (expect "<<LPG-18>> ...and it reports the HOMOGENEOUS mode it routed under"
                        "HOMOGENEOUS" (at "mode" pv))
                    ;;THE PROPERTY THE OWNER ASKED FOR, stated as an assertion rather than as
                    ;;reasoning: in HOMOGENEOUS mode each ladder token is paid EXACTLY WHEN the
                    ;;score that feeds it carries weight. token-2 being paid is the same thing as
                    ;;"the holder has a golden score", which is the same thing as "the second coil
                    ;;was needed". If the second-hop amount were derived from anything other than
                    ;;the golden share, one of these three breaks.
                    (expect (format "<<LPG-19>> token-0 paid IFF the bronze lane carries weight (lane-b={})" [(at "lane-b" lanes)])
                        (> (at "lane-b" lanes) 0.0) (> d-ouro 0.0))
                    (expect (format "<<LPG-20>> token-1 paid IFF the silver lane carries weight (lane-s={})" [(at "lane-s" lanes)])
                        (> (at "lane-s" lanes) 0.0) (> d-auryn 0.0))
                    (expect (format "<<LPG-21>> token-2 paid IFF the golden lane carries weight (lane-g={})" [(at "lane-g" lanes)])
                        (> (at "lane-g" lanes) 0.0) (> d-elite 0.0))
                ])
            ""
        )
    )
)
(env-sigs [])
(commit-tx)


