;;
;; REPL/ladder-preview-groundtruth.repl — RPS.URC_CollectLadderPreview vs REAL balance deltas
;;   Legend (terminal observability): "ZZZ" = observed value; <(…)> = module/Talos echo.
;;   Source: ;;|| NEXT > between txs; ;;==== … · mm · … ==== + banner before each group.
;;   REPL tests: <<LPG-nn>>.
;;
;;WHY THIS EXISTS. A MULTIPLET_BASE triplet lane pays in up to THREE tokens, and the collect's
;;ladder shape is now encoded in FOUR places that must agree: the exec route
;;(XI_TransferRewardDptfFromVault / XI_1|HeterogeneousLaneRoute), its IGNIS mirror
;;(URC_CollectTransferLegIgnis / URC_HeterogeneousLaneRouteIgnis), and the client AMOUNT preview
;;(URC_CollectLadderPreview). Nothing in the language makes them agree. This suite is what makes
;;them agree: it reads the preview BEFORE the collect and asserts it against the DELTAS the
;;collect actually produced on the three token balances. A preview compared only to itself is a
;;fourth copy of the ladder waiting to drift -- which is exactly what
;;Audit/module-audits/AQP/MULTIPLET-COLLECT-OPTIMISATION.md §3 reports had already happened
;;three ways by composition.
;;
(print "")
(print "================================================================")
(print "FILE  REPL/ladder-preview-groundtruth.repl")
(print "================================================================")
(print "")
;;triplet-collect-golden.repl is the boot chain: sandboxes + Stage 1 + Stage 2 deploy + the three
;;populate suites + AQP-BOOT Step4/Step5 + [6.2.9]_AQP-BOOT-FULL (which COMMITS the Custodians
;;vault in TX-BOOT-1314 -- Steps 13/14 -- while its economic experiment is rolled back) +
;;[6.4]_AQP-TRIPLET-COLLECT.
(load "triplet-collect-golden.repl")

;;||>>>>>>>>>>>>>>>>>>>>>>>>>
;;|| NEXT                   >
;;||>>>>>>>>>>>>>>>>>>>>>>>>>
(print "")
(print "")
(begin-tx "TX-LPG-01 - oracle the ANHD agency and inject, so the ladder lane has a payout")
(namespace "ouronet-ns")
(env-gasmodel "table")(env-gaslimit 200000000)(env-gas 0)
(print "")
(print "=== TX-LPG-01 — oracle + inject ===============================================")
;;==== TX-LPG-01 - oracle + inject · 01 · let / invocation ==== ===================================
(print "--- [TX-LPG-01 - oracle + inject · 01 · let / invocation] ---")
;;The Custodians vault is the ONLY fixture in the tree with a HETEROGENEOUS quality split, so it
;;is the only one that reaches XI_1|HeterogeneousLaneRoute at all. capture-units =
;;min(floor(Q / unit-score), NODES) and `nodes` starts at 0, so the agency earns nothing until an
;;oracle reports -- [6.2.9] does this inside its ROLLED-BACK block, hence the redo here.
(env-data { "dsa-oracle": { "keys": ["dsa-oracle-key"], "pred": "keys-all" } })
(let
    (
        (patron:string KST.ANHD)
        (ouro-id:string "OURO-98c486052a51")
        (fvt-id:string (U|DALOS.UDC_Makeid "CustodiansVault"))
    )
    (let
        (
            (anhd-triplet:string (AQP-SCORE.UC_ComputeTripletId
                (U|DALOS.UDC_Makeid "OuronetPrimeBronze")
                (U|DALOS.UDC_Makeid "OuronetPrimeSilver")
                (U|DALOS.UDC_Makeid "OuronetPrimeGolden")))
        )
        (env-sigs
            [ { "key": "PK_AncientHodler", "caps": [] }
              { "key": "dsa-oracle-key", "caps": [] } ])
        (TS02-C3.AQP-DSA|C_SetOracleAuth patron patron fvt-id (read-keyset "dsa-oracle"))
        (TS02-C3.AQP-DSA|C_OracleWrite patron fvt-id anhd-triplet 2 1000)
        (print (format "ZZZ capture after oracle = {}" [(AQP-DSA.URC_CaptureUnits fvt-id anhd-triplet)]))
        (print (format "<(CC_Inject 3000 OURO)> => \"{}\""
            [(TS02-C3.AQP-FVT|CC_Inject patron patron fvt-id ouro-id 3000.0)]))
    )
)
(env-sigs [])
(commit-tx)

;;||>>>>>>>>>>>>>>>>>>>>>>>>>
;;|| NEXT                   >
;;||>>>>>>>>>>>>>>>>>>>>>>>>>
(print "")
(print "")
(begin-tx "TX-LPG-02 - the preview, then the collect, then the deltas")
(namespace "ouronet-ns")
(env-gasmodel "table")(env-gaslimit 200000000)(env-gas 0)
(print "")
(print "=== TX-LPG-02 — preview vs real deltas (HETEROGENEOUS ladder) ==================")
;;==== TX-LPG-02 - preview vs deltas · 01 · read the preview BEFORE collecting ==== ===============
(print "--- [TX-LPG-02 - preview vs deltas · 01 · read the preview BEFORE collecting] ---")
(let
    (
        (patron:string KST.ANHD)
        (ouro-id:string "OURO-98c486052a51")
        (fvt-id:string (U|DALOS.UDC_Makeid "CustodiansVault"))
        (pool-id:string (U|DALOS.UDC_Makeid "CustodiansPool"))
    )
    (let*
        (
            (auryn:string (DALOS.UR_AurynID))
            (elite:string (DALOS.UR_EliteAurynID))
            (anhd-triplet:string (AQP-SCORE.UC_ComputeTripletId
                (U|DALOS.UDC_Makeid "OuronetPrimeBronze")
                (U|DALOS.UDC_Makeid "OuronetPrimeSilver")
                (U|DALOS.UDC_Makeid "OuronetPrimeGolden")))
            ;;THE PREVIEW, read while the reward is still unclaimed.
            (pv:object (RPS.URC_CollectLadderPreview patron pool-id fvt-id 3 anhd-triplet ouro-id))
            (o0:decimal (DPTF.UR_AccountSupply ouro-id patron))
            (a0:decimal (DPTF.UR_AccountSupply auryn   patron))
            (e0:decimal (DPTF.UR_AccountSupply elite   patron))
        )
        (env-sigs [{ "key": "PK_AncientHodler", "caps": [] }])
        (print (format "ZZZ preview = {}" [pv]))
        (print (format "<(CC_Collect)> => \"{}\""
            [(TS02-C3.AQP-FVT|CC_Collect patron patron fvt-id 3 anhd-triplet ouro-id)]))
        ;;==== TX-LPG-02 - preview vs deltas · 02 · assertions ==== ===============================
        (print "--- [TX-LPG-02 - preview vs deltas · 02 · assertions] ---")
        (let
            (
                (d-ouro:decimal  (- (DPTF.UR_AccountSupply ouro-id patron) o0))
                (d-auryn:decimal (- (DPTF.UR_AccountSupply auryn   patron) a0))
                (d-elite:decimal (- (DPTF.UR_AccountSupply elite   patron) e0))
            )
            (print (format "ZZZ deltas ouro={} auryn={} elite={}" [d-ouro d-auryn d-elite]))
            (map print
                [
                    ;;THE WHOLE POINT: the three predicted amounts are the three amounts paid.
                    (expect (format "<<LPG-01>> preview token-0 == real OURO delta (got={})" [d-ouro])
                        d-ouro (at "token-0-amount" pv))
                    (expect (format "<<LPG-02>> preview token-1 == real AURYN delta (got={})" [d-auryn])
                        d-auryn (at "token-1-amount" pv))
                    (expect (format "<<LPG-03>> preview token-2 == real ELITE-AURYN delta (got={})" [d-elite])
                        d-elite (at "token-2-amount" pv))
                    ;;...and it names the tokens it is quoting, so a client cannot mislabel them.
                    (expect "<<LPG-04>> preview names token-0 as the family's token-0"
                        ouro-id (at "token-0-id" pv))
                    (expect "<<LPG-05>> preview names token-1 as the family's token-1"
                        auryn (at "token-1-id" pv))
                    (expect "<<LPG-06>> preview names token-2 as the family's token-2"
                        elite (at "token-2-id" pv))
                    ;;the mode that decided the routing is reported, not inferred by the client
                    (expect "<<LPG-07>> preview reports the HETEROGENEOUS mode it routed under"
                        "HETEROGENEOUS" (at "mode" pv))
                    ;;the basis is conserved: nothing is created or stranded by the ladder.
                    ;;NOT an equality against `payout`: hop-1 coils (t1+t2) in ONE derivation where
                    ;;the pre-2026-10-26 route coiled t1 and t2 separately, and flooring is not
                    ;;additive -- so the ladder legs may differ from the payout by single ulps of
                    ;;the ladder tokens, which are DIFFERENT tokens with their own precision. The
                    ;;conserved quantity is token-0 + what was laddered, not a sum across tickers.
                    (expect (format "<<LPG-08>> every leg is non-negative (ouro={} auryn={} elite={})"
                                [d-ouro d-auryn d-elite])
                        true (and (>= d-ouro 0.0) (and (>= d-auryn 0.0) (>= d-elite 0.0))))
                    (expect (format "<<LPG-09>> the ladder paid all three tokens (payout={})" [(at "payout" pv)])
                        true (and (> d-ouro 0.0) (and (> d-auryn 0.0) (> d-elite 0.0))))
                    (expect (format "<<LPG-10>> preview payout basis == URC_CollectClaimableRewards" [])
                        3000.0 (at "payout" pv))
                ])
            ""
        )
    )
)
(env-sigs [])
(commit-tx)

