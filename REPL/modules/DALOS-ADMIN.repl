(begin-tx "DALOS-G4 — transferability, the smart-account control no-op, and account glyphs")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(namespace "ouronet-ns")
(print "--- [DALOS-G4 · 01 · who may be paid, and what an account id may look like] ---")
;;P3.3. Four guards, all argument-driven once you have one standard and one smart account --
;;which this suite already has.
;;
;;UEV_EnforceTransferability is driven TWICE because URC_Transferability underneath it is a
;;DECISION TREE, and the two rejections land on different leaves of it:
;;
;;    sender standard, receiver smart, method=false  ->  consults receiver's PAYABLE-AS
;;    sender smart,    receiver smart, method=false  ->  consults receiver's PAYABLE-BY
;;
;;Those are separate fields with separate meanings ("may a user pay this contract directly" vs
;;"may another contract pay it"), and a refactor that collapsed the tree into a single
;;payable-anything flag would still pass a test that only drove one of them.
;;==== DALOS-G4 — transferability, the smart-account control no-op, and account glyphs · 01 · env-sigs (caps) ==== 
(print "--- [DALOS-G4 — transferability, the smart-account control no-op, and account glyphs · 01 · env-sigs (caps)] ---")
(env-sigs [{ "key": "PK_AncientHodler", "caps": [] }])
;;==== DALOS-G4 — transferability, the smart-account control no-op, and account glyphs · 02 · let / invocation ==== 
(print "--- [DALOS-G4 — transferability, the smart-account control no-op, and account glyphs · 02 · let / invocation] ---")
(let
    (
        (ref-DALOS:module{OuronetDalosV2} DALOS)
        (ref-TS01-C1:module{TalosStageOne_ClientOneV2} TS01-C1)
        (std:string KST.ANHD)
    )
    (let
        (
            (smart:string (ref-DALOS::GOV|DALOS|SC_NAME))
            (smart2:string (ref-DALOS::GOV|OUROBOROS|SC_NAME))
            (g:guard (ref-DALOS::UR_AccountGuard KST.ANHD))
        )
        (map print
            [
                ;;preconditions. These are what make the two rejections below MEAN something: the
                ;;receiver is payable BY METHOD but neither payable-as nor payable-by, so each
                ;;rejection is attributable to the specific field its branch consults.
                (expect "<<DALOS-G4>> the smart receiver is payable by METHOD only"
                    [false false true]
                    [(ref-DALOS::UR_AccountPayableAs smart)
                     (ref-DALOS::UR_AccountPayableBy smart)
                     (ref-DALOS::UR_AccountPayableByMethod smart)])
                ;;--- leaf 1: standard -> smart, method off, so PAYABLE-AS decides. It is false.
                (expect-failure "<<DALOS-G4>> a standard account cannot pay a smart one that is not payable-AS"
                    "Method is not ensured"
                    (ref-DALOS::UEV_EnforceTransferability std smart false))
                ;;--- leaf 2: smart -> smart, method off, so PAYABLE-BY decides. Also false.
                (expect-failure "<<DALOS-G4>> nor can another smart account, when it is not payable-BY"
                    "Method is not ensured"
                    (ref-DALOS::UEV_EnforceTransferability smart2 smart false))
                ;;...and the SAME pair succeeds with method on, which is the field that IS set.
                ;;Without this, a guard that refused every transfer would satisfy both rejections.
                (expect "<<DALOS-G4>> ...but the same pair transfers fine BY METHOD"
                    true (!= "" (format "{}" [(ref-DALOS::UEV_EnforceTransferability std smart true)])))
                ;;--- a control call that turns every smart-account parameter off is refused. It
                ;;would be a no-op that still emits an event and bills IGNIS, leaving an audit
                ;;record of a permission change that never happened.
                (expect-failure "<<DALOS-G4>> controlling a smart account with ALL parameters false is refused"
                    "At least one Smart DALOS Account parameter must be true"
                    (ref-TS01-C1::DALOS|C_ControlSmartAccount std smart false false false))
                ;;--- the two account-id glyph guards. Each is driven with the OTHER kind's glyph
                ;;rather than a random character: confusing the two deploy entrypoints is the
                ;;realistic caller error, and it is the one a prefix check exists to catch.
                ;;Both fail inside the defcap, so neither creates an account.
                (expect-failure "<<DALOS-G4>> the STANDARD deploy rejects a Sigma-prefixed id"
                    "Format for a Standard DALOS Account"
                    (ref-TS01-C1::DALOS|C_DeployStandardAccount (+ "Σ" "WrongKind") g "stoa" "pub"))
                (expect-failure "<<DALOS-G4>> the SMART deploy rejects an Ouroboros-prefixed id"
                    "Format for a Smart DALOS Account"
                    (ref-TS01-C1::DALOS|C_DeploySmartAccount (+ "Ѻ" "WrongKind") g "stoa" std "pub"))
            ]
        )
        ""
    )
)
(env-sigs [])
(commit-tx)

;;|| NEXT >
