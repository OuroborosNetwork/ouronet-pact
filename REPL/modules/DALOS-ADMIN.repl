(begin-tx "DALOS-G1 — the account-type guard family, probed DIRECTLY")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(namespace "ouronet-ns")
(print "--- [DALOS-G1 · 01 · standard vs smart: the guards DISCRIMINATE] ---")
;;P3.3, fourth module. DALOS's guards are the most interesting shape yet: UEV_StandardAccOwn and
;;UEV_SmartAccOwn are not two names for one check -- they enforce OPPOSITE structural properties
;;of the account they are given.
;;
;;    standard: (enforce (=  sovereign account) …)   the account is its own sovereign
;;    smart:    (enforce (!= sovereign account) …)   it is governed by another account
;;
;;So crossing two account KINDS against two guards gives a 2x2 where the diagonal must pass and
;;the off-diagonal must reject. That is strictly stronger than testing either guard alone: it
;;proves each one refuses the other's input, which is the property a caller actually relies on
;;when it picks which to call.
;;==== DALOS-G1 — the account-type guard family, probed DIRECTLY · 01 · env-sigs (caps) ==== ======
(print "--- [DALOS-G1 — the account-type guard family, probed DIRECTLY · 01 · env-sigs (caps)] ---")
(env-sigs [{ "key": "PK_AncientHodler", "caps": [] }])
;;==== DALOS-G1 — the account-type guard family, probed DIRECTLY · 02 · let / invocation ==== =====
(print "--- [DALOS-G1 — the account-type guard family, probed DIRECTLY · 02 · let / invocation] ---")
(let
    (
        (ref-DALOS:module{OuronetDalosV2} DALOS)
        (standard:string KST.ANHD)
    )
    (let
        (
            (smart:string (ref-DALOS::GOV|DALOS|SC_NAME))
        )
        (map print
            [
                ;;preconditions: the two accounts really are of different kinds
                (expect "<<DALOS-G1>> the standard account is its own sovereign"
                    standard (ref-DALOS::UR_AccountSovereign standard))
                (expect "<<DALOS-G1>> the smart account is NOT"
                    false (= smart (ref-DALOS::UR_AccountSovereign smart)))
                (expect "<<DALOS-G1>> and only the smart one carries autonomic roles"
                    [false true] [(ref-DALOS::UR_AutonomicRoles standard)
                                  (ref-DALOS::UR_AutonomicRoles smart)])
                ;;--- the diagonal: each guard accepts its own kind
                (expect "<<DALOS-G1>> UEV_StandardAccOwn accepts a standard account"
                    true (!= "" (format "{}" [(ref-DALOS::UEV_StandardAccOwn standard)])))
                ;;--- the off-diagonal: each guard REFUSES the other's kind
                (expect-failure "<<DALOS-G1>> UEV_StandardAccOwn refuses a SMART account"
                    "Incompatible Sovereign detected for a Standard DALOS Account"
                    (ref-DALOS::UEV_StandardAccOwn smart))
                (expect-failure "<<DALOS-G1>> UEV_SmartAccOwn refuses a STANDARD account"
                    "Incompatible Sovereign detected for Smart DALOS Account"
                    (ref-DALOS::UEV_SmartAccOwn standard))
                ;;--- the smart-account predicate, both directions
                (expect "<<DALOS-G1>> UEV_NotSmartOuronetAccount accepts a standard account"
                    true (!= "" (format "{}" [(ref-DALOS::UEV_NotSmartOuronetAccount standard)])))
                (expect-failure "<<DALOS-G1>> ...and refuses a smart one"
                    "Non Smart Ouronet Accounts required for exec"
                    (ref-DALOS::UEV_NotSmartOuronetAccount smart))
                ;;--- UEV_EnforceAccountType takes the kind as an ARGUMENT, so it is the same
                ;;    2x2 expressed the other way round.
                (expect "<<DALOS-G1>> UEV_EnforceAccountType agrees on both kinds"
                    true (!= "" (format "{}{}" [(ref-DALOS::UEV_EnforceAccountType standard false)
                                                (ref-DALOS::UEV_EnforceAccountType smart true)])))
                ;;The expected messages here are the FULL literal run of each `format` template,
                ;;not a short word. `"Account"` was the first draft and it is worthless twice
                ;;over: it matches almost any DALOS rejection, and _enforce_coverage.py discards
                ;;expected-messages under 8 characters, so it pinned nothing either.
                (expect-failure "<<DALOS-G1>> ...and rejects a standard account claimed as smart"
                    "Operation requires a Smart DALOS Account"
                    (ref-DALOS::UEV_EnforceAccountType standard true))
                (expect-failure "<<DALOS-G1>> ...and a smart account claimed as standard"
                    "Operation requires a Standard DALOS Account"
                    (ref-DALOS::UEV_EnforceAccountType smart false))
                ;;--- existence
                (expect-failure "<<DALOS-G1>> UEV_EnforceAccountExists rejects an unknown account"
                    "DALOS Account doesnt exist"
                    (ref-DALOS::UEV_EnforceAccountExists "Ouronet-nonexistent-account"))
            ]
        )
    )
    ""
)
(print "--- [DALOS-G1 · 02 · guard PROTOCOL: key-based vs not, both directions] ---")
;;UEV_EnforceGuardProtocol is the structural counterpart of the account-kind 2x2 above: an
;;account's GUARD must be key-based (k:/w:/r:) while its GOVERNOR must not be (u:/c:/m:/p:).
;;Crossing the two guard kinds against the two modes is the same shape of test, one level down.
(let
    (
        (ref-DALOS:module{OuronetDalosV2} DALOS)
    )
    (env-data { "gp-ks": { "keys": ["PK_AncientHodler"], "pred": "keys-all" } })
    (let
        (
            (keyed:guard (read-keyset "gp-ks"))
            (capg:guard (create-capability-guard (DALOS.SECURE)))
        )
        (map print
            [
                (expect "<<DALOS-G1>> a keyset guard IS key-based, a capability guard is not"
                    true (!= "" (format "{}{}" [(ref-DALOS::UEV_EnforceGuardProtocol keyed true)
                                                (ref-DALOS::UEV_EnforceGuardProtocol capg false)])))
                (expect-failure "<<DALOS-G1>> a capability guard is refused where a KEY is required"
                    "Guard must be key-based"
                    (ref-DALOS::UEV_EnforceGuardProtocol capg true))
                (expect-failure "<<DALOS-G1>> a keyset guard is refused where a NON-key is required"
                    "Governor must be non-key-based"
                    (ref-DALOS::UEV_EnforceGuardProtocol keyed false))
            ]
        )
    )
    ""
)
(print "--- [DALOS-G1 · 03 · the global collection toggles, tripped from live state] ---")
(let
    (
        (ref-DALOS:module{OuronetDalosV2} DALOS)
    )
    (let
        (
            (virt:bool (ref-DALOS::UR_VirtualToggle))
            (natv:bool (ref-DALOS::UR_NativeToggle))
        )
        (map print
            [
                (expect "<<DALOS-G1>> UEV_IgnisCollectionState agrees with the live toggle"
                    true (!= "" (format "{}" [(ref-DALOS::UEV_IgnisCollectionState virt)])))
                (expect-failure "<<DALOS-G1>> ...and rejects its negation"
                    "Invalid virtual gas collection state"
                    (ref-DALOS::UEV_IgnisCollectionState (not virt)))
                (expect-failure "<<DALOS-G1>> UEV_StoaCollectionState rejects the negation of the live toggle"
                    "collection state" (ref-DALOS::UEV_StoaCollectionState (not natv)))
            ]
        )
    )
    ""
)
(print "===^^^===")
(commit-tx)

;;|| NEXT >
;;|| DALOS-G8 — the second arm of UEV_StandardAccOwn: a backstop, EXECUTED.
;;
(begin-tx "DALOS-G8 - UEV_StandardAccOwn's governor check, driven")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(namespace "ouronet-ns")
;;==== DALOS-G8 - UEV_StandardAccOwn's governor check, driven · 01 · env-sigs (caps) ==== =========
(print "--- [DALOS-G8 - UEV_StandardAccOwn's governor check, driven · 01 · env-sigs (caps)] ---")
(env-sigs [{ "key": "PK_AncientHodler", "caps": [] }])
(print "--- [DALOS-G8 · 01 · guard and governor forced apart] ---")
;;`01_DALOS.pact:1215` -- "Incompatible Governer Guard detected for Standard DALOS Account",
;;`(= account-guard governor)`. NO LEGITIMATE FLOW CAN TRIP IT, and that was proven three ways:
;;account creation writes `"governor" : guard` on BOTH branches; `XI_RotateGuard` updates both
;;fields on a standard account and says so in its @doc; and `XI_RotateGovernor` -- the only writer
;;that touches `governor` alone -- is gated to SMART accounts. The two fields cannot diverge here.
;;
;;THE STANDING PROPOSAL WAS TO ANNOTATE IT `;;UNREACHABLE` and drop it from the worklist. Executing
;;it is strictly better, and the difference matters: an `;;UNREACHABLE` annotation is a claim about
;;today's call graph, and it goes stale silently the first time someone adds a writer. This guard is
;;a BACKSTOP AGAINST CORRUPTION -- its whole job is to fire in a state the writers are supposed to
;;prevent -- so the honest test is to produce that state and watch it fire. `env-module-admin` does
;;exactly that, and `rollback-tx` discards it.
;;
;;So this is not "pinning an unreachable guard". It is the one case where the two techniques give
;;different answers, and the executing one answers the question actually being asked: if the
;;invariant upstream ever breaks, does this catch it? It does.
;;==== DALOS-G8 - UEV_StandardAccOwn's governor check, driven · 02 · let / invocation ==== ========
(print "--- [DALOS-G8 - UEV_StandardAccOwn's governor check, driven · 02 · let / invocation] ---")
(let
    (
        (ref-DALOS:module{OuronetDalosV2} DALOS)
        (standard:string KST.ANHD)
        (other:string KST.EMMA)
    )
    (map print
        [
            ;;the premise the writers maintain, asserted rather than assumed
            (expect "<<DALOS-G8>> guard and governor agree on an untouched standard account"
                true (= (ref-DALOS::UR_AccountGuard standard) (ref-DALOS::UR_AccountGovernor standard)))
            (expect "<<DALOS-G8>> ...and the guard accepts it"
                true (!= "" (format "{}" [(ref-DALOS::UEV_StandardAccOwn standard)])))
        ]
    )
    ;;force the corruption: ANHD keeps its own guard but is given EMMA's governor. Nothing in DALOS
    ;;writes this combination; it is what a partial or mis-ordered write would leave behind.
    (env-module-admin DALOS)
    (update DALOS.DALOS|AccountTable standard
        { "governor" : (ref-DALOS::UR_AccountGuard other) })
    (map print
        [
            (expect "<<DALOS-G8>> the two fields now disagree"
                false (= (ref-DALOS::UR_AccountGuard standard) (ref-DALOS::UR_AccountGovernor standard)))
            ;;THE ITEM. Note this fires even though the SIGNATURE is valid -- ANHD's own key is in
            ;;scope and `enforce-guard` on the third line would have passed. The guard rejects on the
            ;;structural mismatch BEFORE authority is considered, which is the correct order for a
            ;;corruption check and is the part worth pinning.
            (expect-failure "<<DALOS-G8>> ...and the backstop fires, with a correctly-signed caller"
                "Incompatible Governer Guard detected for Standard DALOS Account"
                (ref-DALOS::UEV_StandardAccOwn standard))
            ;;and the FIRST arm still discriminates in the corrupted state, so the two enforces are
            ;;independent rather than one masking the other.
            (expect-failure "<<DALOS-G8>> ...while the sovereign arm still rejects a smart account"
                "Incompatible Sovereign detected for a Standard DALOS Account"
                (ref-DALOS::UEV_StandardAccOwn (ref-DALOS::GOV|DALOS|SC_NAME)))
        ]
    )
    ""
)
(env-sigs [])
;;the corruption is discarded -- DALOS-G8b checks it
(rollback-tx)

;;|| NEXT >
;;|| DALOS-G8b — the forced divergence left no trace.
;;
(begin-tx "DALOS-G8b - no leakage")
(namespace "ouronet-ns")
(print "--- [DALOS-G8b · 01 · no leakage] ---")
;;ANHD is the patron of nearly every transaction in this suite. A leaked governor would fail far
;;from here and look like an authorisation bug rather than a test artefact.
(print
    (expect "<<DALOS-G8b>> ANHD's guard and governor agree again"
        true (= (DALOS.UR_AccountGuard KST.ANHD) (DALOS.UR_AccountGovernor KST.ANHD))))
(commit-tx)

;;|| NEXT >
;;|| DALOS-G9 — the OURO-price permission gate, reached by failing all three branches.
;;
(begin-tx "DALOS-G9 - DALOS|S>SET-OURO-PRICE: who may move the IGNIS source price")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(namespace "ouronet-ns")
(print "--- [DALOS-G9 · 01 · an enforce-one over three DALOS-account guards] ---")
;;`01_DALOS.pact:713`. The OURO source price feeds compression and sublimation, so moving it moves
;;what every IGNIS operation on the chain costs. It is gated by an `enforce-one` over THREE guards --
;;the DALOS smart-contract account's own guard, its sovereign's, and its governor's -- and reaching
;;the enforce-one's OWN message means failing all three.
;;
;;THAT IS THE TRAP THIS BLOCK EXISTS TO AVOID, and it has bitten twice before in this campaign
;;(ATS-G14, DEMIPAD's launchpad access gate): signing PK_AncientHodler satisfies the admin branch,
;;the call sails through, and the test ends up pinning something else entirely. LUMY is a funded
;;third party holding none of the three, which is the only way the outer message can surface.
;;
;;Reached through the real Talos path (TS01-A), not the core function, so this is the permission a
;;client would actually meet.
;;==== DALOS-G9 - DALOS|S>SET-OURO-PRICE: who may move the IGNIS source price · 01 · let / invocation ==== 
(print "--- [DALOS-G9 - DALOS|S>SET-OURO-PRICE: who may move the IGNIS source price · 01 · let / invocation] ---")
(let
    (
        (ref-TS01-A:module{TalosStageOne_AdminV2} TS01-A)
        (ref-DALOS:module{OuronetDalosV2} DALOS)
    )
    (env-sigs [{ "key": "PK_Lumy", "caps": [] }])
    (print
        (expect-failure "<<DALOS-G9>> a third party holding none of the three guards is refused"
            "Permission not granted to Update OURO Price !"
            (ref-TS01-A::DALOS|A_SetIgnisSourcePrice 42.0)))
    ;;...and with NO signature at all, the same message -- so the refusal is about holding none of
    ;;the three, not about LUMY specifically.
    (env-sigs [])
    (print
        (expect-failure "<<DALOS-G9>> ...and so is an unsigned call"
            "Permission not granted to Update OURO Price !"
            (ref-TS01-A::DALOS|A_SetIgnisSourcePrice 42.0)))
    ;;CONTRAST: the DALOS admin key DOES satisfy the first branch, so the same call succeeds. Without
    ;;this the two refusals are equally consistent with the operation being broken outright -- and it
    ;;is exactly the signature that would have hidden the guard.
    (env-sigs [{ "key": "PK_AncientHodler", "caps": [] }])
    (print
        (expect "<<DALOS-G9>> ...while the DALOS admin key satisfies the first branch"
            true (!= "" (format "{}" [(ref-TS01-A::DALOS|A_SetIgnisSourcePrice 42.0)]))))
    ""
)
(env-sigs [])
;;the price write is discarded -- DALOS-G9b checks it
(rollback-tx)

;;|| NEXT >
;;|| DALOS-G9b — the price write left no trace.
;;
(begin-tx "DALOS-G9b - no leakage")
(namespace "ouronet-ns")
(print "--- [DALOS-G9b · 01 · no leakage] ---")
;;The OURO source price is chain-wide and feeds every IGNIS cost computation. A leaked 42.0 would
;;silently reprice the whole suite, and the pricing assertions live in a different file.
(print
    (expect "<<DALOS-G9b>> the OURO price is not the probe value"
        false (= 42.0 (DALOS.UR_OuroborosPrice))))
(commit-tx)

