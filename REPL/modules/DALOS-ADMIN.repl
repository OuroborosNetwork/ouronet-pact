(begin-tx "DALOS-G3 — the idempotent-toggle family: setting a flag to what it already is")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(namespace "ouronet-ns")
(print "--- [DALOS-G3 · 01 · already-in-that-state] ---")
;;Three admin guards that share one idea: a toggle refuses a no-op write. That is not fussiness --
;;each of these emits an event and bills IGNIS, so a silent no-op would leave an audit record of
;;a change that never happened.
;;
;;Every one reads its CURRENT value and feeds it straight back, so the tests stay correct whatever
;;state earlier blocks leave behind. Hardcoding `false` would pass today and silently stop testing
;;anything the day something flips one of them.
;;==== DALOS-G3 — the idempotent-toggle family: setting a flag to what it already is · 01 · env-sigs (caps) ==== 
(print "--- [DALOS-G3 — the idempotent-toggle family: setting a flag to what it already is · 01 · env-sigs (caps)] ---")
(env-sigs [{ "key": "PK_AncientHodler", "caps": [] }])
;;==== DALOS-G3 — the idempotent-toggle family: setting a flag to what it already is · 02 · let / invocation ==== 
(print "--- [DALOS-G3 — the idempotent-toggle family: setting a flag to what it already is · 02 · let / invocation] ---")
(let
    (
        (ref-TS01-A:module{TalosStageOne_AdminV2} TS01-A)
        (ref-DALOS:module{OuronetDalosV2} DALOS)
    )
    (map print
        [
            (expect-failure "<<DALOS-G3>> toggling GAP to the value it already holds is refused"
                "GAP is already toggled to"
                (ref-TS01-A::DALOS|A_ToggleGAP (ref-DALOS::UR_GAP)))
            (expect-failure "<<DALOS-G3>> ...and likewise the account-creation STOA switch"
                "Account-creation STOA collection is already in that state"
                (ref-TS01-A::DALOS|A_AccountCreationStoaToggle (ref-DALOS::UR_AccountCreationStoa)))
            ;;the usage-price floor. A zero or negative price would make account deployment free
            ;;or, worse, pay the depositor.
            (expect-failure "<<DALOS-G3>> a negative usage price is refused"
                "New price must be a positive amount"
                (ref-TS01-A::DALOS|A_UpdateUsagePrice "smart" -1.0))
            (expect-failure "<<DALOS-G3>> ...and so is zero"
                "New price must be a positive amount"
                (ref-TS01-A::DALOS|A_UpdateUsagePrice "smart" 0.0))
        ]
    )
    ""
)
(env-sigs [])
(print "===^^^===")
(commit-tx)

