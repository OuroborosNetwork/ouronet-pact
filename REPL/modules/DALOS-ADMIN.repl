(begin-tx "DALOS-G2e — GAS_PAYER: two guards that cannot fire, and why")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(namespace "ouronet-ns")
(print "--- [DALOS-G2e · 01 · two dead guards] ---")
;;FINDING 1: "Only for transactions with code" cannot fire.
;;
;;    (iz-single:bool      (contains "exec-code" (read-msg)))
;;    (exec-lines:[string] (at "exec-code" (read-msg)))
;;
;;Both bindings sit in the SAME let and Pact evaluates them eagerly, so the `at` on a message
;;without the key raises before <iz-single> is ever consulted. A caller who omits exec-code gets
;;`Key "exec-code" not found in object: {}` instead of the written message. THIRD instance of
;;this exact shape (PYTHIA <<TX007e-03>>, FVT <<TX-BOOT-G1>>): a guard's own subject is bound
;;eagerly above it, so the binding fails first and the guard is mute. Pinned AS IT BEHAVES so a
;;fix has to update this line deliberately.
;;
;;FINDING 2: the form-count enforce below "Empty exec code" is DEAD, and needs no test.
;;
;;    (enforce (>= n 1) "Empty exec code")
;;    (enforce (fold (or) false [(= n 1) (= n 2) (>= n 3)]) "Exec code must be 1 form, 2 coin …")
;;
;;Once n >= 1 is enforced, `n=1 or n=2 or n>=3` is a tautology covering every remaining integer.
;;It reads like a whitelist of accepted shapes and is a no-op; the real shape enforcement is the
;;enforce-one below it, pinned in DALOS-G2c. Annotated at the source.
;;
;;Likewise "First form must be coin.C_, ouronet-ns.TS, or ouronet-ns.DSP" is the message of an
;;enforce-one NESTED in the outer enforce-one's branch list. Pact discards a failed branch's
;;message and reports the OUTER one -- which is exactly what DALOS-G2c observes.
;;==== DALOS-G2e — GAS_PAYER: two guards that cannot fire, and why · 01 · env-sigs (caps) ==== ====
(print "--- [DALOS-G2e — GAS_PAYER: two guards that cannot fire, and why · 01 · env-sigs (caps)] ---")
(env-sigs [{ "key": "PK_Emma", "caps": [] }])
(env-chain-data { "gas-limit": 1000, "gas-price": 0.0000001 })
(env-data {})
(map print
    [
        (expect-failure "<<DALOS-G2e>> FINDING: omitting exec-code aborts in the BINDING, not the guard"
            "not found in object"
            (test-capability (DALOS.GAS_PAYER KST.EMMA 1000 0.0000001)))
    ]
)
(env-data {})
(print "===^^^===")
(commit-tx)

