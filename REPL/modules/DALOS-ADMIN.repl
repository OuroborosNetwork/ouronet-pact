(begin-tx "DALOS-G5 — the gas-station notional allowance, driven directly")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(namespace "ouronet-ns")
(print "--- [DALOS-G5 · 01 · UEV_enforce-notional-at-floor] ---")
;;P3.3. DALOS-G2d already drives this rule THROUGH GAS_PAYER — but there it sits inside an
;;enforce-one, so the message a caller sees is the enforce-one's own ("Add multiple conditions
;;needed to use Ouronet DALOS Gas-Station") and this function's message never surfaces. Called
;;DIRECTLY it does, which is what makes the site pinnable at all.
;;
;;The function takes NO arguments on purpose: it reads gas-price and gas-limit from (chain-data)
;;and the protocol floor live from <coin>. So `env-chain-data` IS the fixture — and it is GLOBAL
;;REPL state, not pool state, which is why the prior values are captured and put back at the end.
;;(env-chain-data returns a string, not a bool, so it cannot be folded into a let binding typed
;;:bool — the calls stay as their own statements.)
;;==== DALOS-G5 — the gas-station notional allowance, driven directly · 01 · let / invocation ==== 
(print "--- [DALOS-G5 — the gas-station notional allowance, driven directly · 01 · let / invocation] ---")
(let
    (
        (prior-price:decimal (at "gas-price" (chain-data)))
        (prior-limit:integer (at "gas-limit" (chain-data)))
    )
    ;;--- a modest notional is funded. Established FIRST so the rejection below is about the SIZE
    ;;of the notional and not about the function refusing every input.
    (env-chain-data {"gas-price": 0.0000001, "gas-limit": 1000})
    (print
        (expect "<<DALOS-G5>> a 1000-gas notional at the protocol minimum is within the allowance"
            true (!= "" (format "{}" [(DALOS.UEV_enforce-notional-at-floor)]))))
    ;;--- and a large one is not. This is the station's own spending cap: gas-price x gas-limit is
    ;;what the project pays for someone else's transaction, so the ceiling is the difference
    ;;between subsidising a client call and funding an arbitrarily expensive one.
    (env-chain-data {"gas-price": 0.001, "gas-limit": 10000000})
    (print
        (expect-failure "<<DALOS-G5>> ...while a 10M-gas notional at a 10,000x price is refused"
            "Gas notional exceeds the Gas-Station allowance of"
            (DALOS.UEV_enforce-notional-at-floor)))
    ;;--- restore, and assert the restoration.
    (env-chain-data {"gas-price": prior-price, "gas-limit": prior-limit})
    (print
        (expect "<<DALOS-G5>> chain-data restored to what this block found"
            [prior-price prior-limit]
            [(at "gas-price" (chain-data)) (at "gas-limit" (chain-data))]))
    ""
)
(commit-tx)

;;|| NEXT >
