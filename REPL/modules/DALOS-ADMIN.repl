;; REPL/modules/DALOS-ADMIN.repl — canonical integration layout (OuronetInformational/ARCHITECTURE/REPL_AND_TESTS.md)
;;   Inter-tx:   ;;|| NEXT >  (same three lines as REPL/Stage_01/[2.2]_Core.repl)
;;   Intra-tx:   ;;==== <TX label> · mm · <slug> ====  + next-line (print "--- [<label> · mm · …] ---"); mm = 01.. within each (begin-tx …) (see OuronetInformational/ARCHITECTURE/REPL_AND_TESTS.md).
;;   format "{}": Talos / module echoes and (env-gas) — document additional prefixes in this file's (print …) lines as needed.
;;
(print "")
(print "================================================================")
(print "FILE  REPL/modules/DALOS-ADMIN.repl")
(print "================================================================")
(print "Legend (terminal observability): see ;; preface; echoes use <(…)> where helpful.")
(print "Source: ;;|| NEXT > between txs; ;;==== … · mm · … ==== + banner before each begin-tx.")
(print "")
;; REPL/modules/DALOS-ADMIN.repl — STANDALONE DALOS admin-surface tester.
;;
;; P2 rebuild: 4 net assertions against a 20-entrypoint admin surface, now covering the toggles
;; and the usage-price setter with observable outcomes, plus the invariant that admin ops are
;; IGNIS/STOA exempt.
;;
;; Every op here is admin-gated (A_*), so this doubles as a check that the admin path is
;; reachable at all after boot.
;;
;; Run: cd REPL && pact modules/DALOS-ADMIN.repl
(load "../deploy-stage00.repl")
(load "../deploy-stage01.repl")
(load "../Stage_01/[6.12]_DALOS-ADMIN.repl")

;;|| NEXT >
;;
(begin-tx "DALOS-ADMIN-01 — global toggles round-trip")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(namespace "ouronet-ns")
(print "--- [DALOS-ADMIN-01 · 01 · toggles] ---")
;;==== DALOS-ADMIN-01 — global toggles round-trip · 01 · env-sigs (caps) ==== =====================
(print "--- [DALOS-ADMIN-01 — global toggles round-trip · 01 · env-sigs (caps)] ---")
(env-sigs [{ "key": "PK_AncientHodler", "caps": [] }])
;;==== DALOS-ADMIN-01 — global toggles round-trip · 02 · let / invocation ==== ====================
(print "--- [DALOS-ADMIN-01 — global toggles round-trip · 02 · let / invocation] ---")
(let
    (
        (ref-DALOS:module{OuronetDalosV2} DALOS)
        (ref-TS01-A:module{TalosStageOne_AdminV2} TS01-A)
    )
    (let ((gap0:bool (ref-DALOS::UR_GAP)) (acs0:bool (ref-DALOS::UR_AccountCreationStoa)))
        ;;GAP — the global administrative pause. Flipping it ON must be observable, and flipping
        ;;it back must restore EXACTLY the prior value (metamorphic, not a hardcoded default).
        (ref-TS01-A::DALOS|A_ToggleGAP true)
        (map print [(expect "<<DALOS-ADMIN-01>> A_ToggleGAP turned the global pause ON"
                        true (ref-DALOS::UR_GAP))])
        (ref-TS01-A::DALOS|A_ToggleGAP gap0)
        (map print [(expect "<<DALOS-ADMIN-01>> A_ToggleGAP restored the original GAP state"
                        gap0 (ref-DALOS::UR_GAP))])
        ;;Account-creation STOA switch — added in the #76 pricing work, default OFF (onboarding).
        (ref-TS01-A::DALOS|A_AccountCreationStoaToggle true)
        (map print [(expect "<<DALOS-ADMIN-01>> A_AccountCreationStoaToggle turned it ON"
                        true (ref-DALOS::UR_AccountCreationStoa))])
        (ref-TS01-A::DALOS|A_AccountCreationStoaToggle acs0)
        (map print
            [
                (expect "<<DALOS-ADMIN-01>> A_AccountCreationStoaToggle restored the original"
                    acs0 (ref-DALOS::UR_AccountCreationStoa))
                (expect "<<DALOS-ADMIN-01>> account-creation STOA is OFF by default (onboarding)"
                    false acs0)
            ]
        )
    )
    ""
)
(commit-tx)

;;|| NEXT >
;;
(begin-tx "DALOS-ADMIN-02 — A_UpdateUsagePrice writes the price the pricing layer reads")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(namespace "ouronet-ns")
(print "--- [DALOS-ADMIN-02 · 01 · usage price] ---")
;;==== DALOS-ADMIN-02 — A_UpdateUsagePrice writes the price the pricing layer reads · 01 · env-sigs (caps) ==== 
(print "--- [DALOS-ADMIN-02 — A_UpdateUsagePrice writes the price the pricing layer reads · 01 · env-sigs (caps)] ---")
(env-sigs [{ "key": "PK_AncientHodler", "caps": [] }])
;;==== DALOS-ADMIN-02 — A_UpdateUsagePrice writes the price the pricing layer reads · 02 · let / invocation ==== 
(print "--- [DALOS-ADMIN-02 — A_UpdateUsagePrice writes the price the pricing layer reads · 02 · let / invocation] ---")
(let
    (
        (ref-DALOS:module{OuronetDalosV2} DALOS)
        (ref-IGNIS:module{IgnisCollectorV3} IGNIS)
        (ref-TS01-A:module{TalosStageOne_AdminV2} TS01-A)
    )
    (let ((p0:decimal (ref-DALOS::UR_UsagePrice "dptf")))
        (ref-TS01-A::DALOS|A_UpdateUsagePrice "dptf" 12345.0)
        (map print [(expect "<<DALOS-ADMIN-02>> A_UpdateUsagePrice stored the new price"
                        12345.0 (ref-DALOS::UR_UsagePrice "dptf"))])
        (ref-TS01-A::DALOS|A_UpdateUsagePrice "dptf" p0)
        (map print
            [
                (expect "<<DALOS-ADMIN-02>> A_UpdateUsagePrice restored the original price"
                    p0 (ref-DALOS::UR_UsagePrice "dptf"))
                ;;#76 INVARIANT: the seeded per-asset STOA price must equal what UC_StoaPrice
                ;;derives from IG|DETER. If these ever diverge, the sheet and the chain disagree.
                (expect "<<DALOS-ADMIN-02>> INVARIANT: the dptf STOA price IS UC_StoaPrice(issue-tf)"
                    (ref-IGNIS::UC_StoaPrice "issue-tf") p0)
                (expect "<<DALOS-ADMIN-02>> INVARIANT: the smart-account STOA price IS UC_StoaPrice(acct-smart)"
                    (ref-IGNIS::UC_StoaPrice "acct-smart") (ref-DALOS::UR_UsagePrice "smart"))
                (expect "<<DALOS-ADMIN-02>> INVARIANT: blue branding IS UC_StoaPrice(branding-blue)"
                    (ref-IGNIS::UC_StoaPrice "branding-blue") (ref-DALOS::UR_UsagePrice "blue"))
            ]
        )
    )
    ""
)
(commit-tx)

;;|| NEXT >
;;
(begin-tx "DALOS-ADMIN-03 — A_MigrateLiquidFunds: the gas-station escape hatch")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(namespace "ouronet-ns")
(print "--- [DALOS-ADMIN-03 · 01 · migrate the gas station] ---")
;; A_MigrateLiquidFunds is the highest-value admin op in DALOS: it sweeps the ENTIRE STOA
;; balance of the Ouronet gas station to an arbitrary target, so that the funds can follow a
;; namespace/module migration. It is deliberately the LAST test in this file -- it drains the
;; gas station, and it lives in the module tester (not [6.12], which ZALL loads) precisely so
;; that drain can never leak into the full run.
;;
;; Three preconditions. The first one USED to be stated backwards in the code:
;;
;;   (enforce gap "Migration can only be executed when Global Administrative Pause is offline")
;;
;; `enforce gap` passes when gap is TRUE -- i.e. when the pause is ONLINE -- and the message claimed
;; the opposite, so an operator following it would disarm the pause and retry forever. The BEHAVIOUR
;; was always right and deliberate: P|TS (the cap behind nearly every other Talos client op)
;; enforces (not gap), so requiring GAP ON means the chain is frozen for the whole window in which
;; the gas station is empty. FIXED 2026-09-14 -- one word, offline -> online. DALOS-ADMIN-03b below
;; now pins the corrected wording, and still pins the real behaviour behind it.
(env-data
    { "MIGRATE_TARGET_KS": { "keys": ["PK_AncientHodler"], "pred": "keys-all" } }
)
;;==== DALOS-ADMIN-03 — A_MigrateLiquidFunds: the gas-station escape hatch · 01 · env-sigs (caps) ==== 
(print "--- [DALOS-ADMIN-03 — A_MigrateLiquidFunds: the gas-station escape hatch · 01 · env-sigs (caps)] ---")
(env-sigs [{ "key": "PK_AncientHodler", "caps": [] }])
;;==== DALOS-ADMIN-03 — A_MigrateLiquidFunds: the gas-station escape hatch · 02 · let / invocation ==== 
(print "--- [DALOS-ADMIN-03 — A_MigrateLiquidFunds: the gas-station escape hatch · 02 · let / invocation] ---")
(let
    (
        (ref-DALOS:module{OuronetDalosV2} DALOS)
        (ref-TS01-A:module{TalosStageOne_AdminV2} TS01-A)
        (ref-coin:module{stoa-ns.fungible-v1} coin)
    )
    (let
        (
            (sc-stoa:string (ref-DALOS::GOV|DALOS|SC_STOA-NAME))
            (target:string (create-principal (read-keyset "MIGRATE_TARGET_KS")))
        )
        (ref-coin::create-account target (read-keyset "MIGRATE_TARGET_KS"))
        (let
            (
                (sc-before:decimal (ref-coin::get-balance sc-stoa))
                (gap0:bool (ref-DALOS::UR_GAP))
            )
            (map print
                [
                    ;;The gas station is NOT empty after a bare boot: deploying the sovereign
                    ;;accounts already paid STOA into it. Migration therefore has something
                    ;;real to move -- and a zero-balance station would abort inside coin's own
                    ;;"amount must be positive" guard, never reaching a DALOS message.
                    (expect "<<DALOS-ADMIN-03>> the gas station holds STOA after boot"
                        true (> sc-before 0.0))
                    (expect "<<DALOS-ADMIN-03>> the migration target starts empty (cap precondition)"
                        0.0 (ref-coin::get-balance target))
                    (expect "<<DALOS-ADMIN-03>> GAP is OFF before we arm the migration"
                        false gap0)
                ]
            )
            ;;PRECONDITION (a): arm the pause. Without this the op is rejected -- see 03b.
            (ref-TS01-A::DALOS|A_ToggleGAP true)
            (let
                (
                    (moved:decimal (ref-TS01-A::DALOS|A_MigrateLiquidFunds target))
                )
                (map print
                    [
                        ;;The return value is the CONTRACT: an operator scripting the migration
                        ;;reads it to confirm how much followed. It must be the pre-balance, not
                        ;;a post-read (which is always 0.0 and would look identical on success
                        ;;while hiding a partial transfer).
                        (expect "<<DALOS-ADMIN-03>> A_MigrateLiquidFunds returns the amount moved"
                            sc-before moved)
                        (expect "<<DALOS-ADMIN-03>> the gas station is swept to exactly zero"
                            0.0 (ref-coin::get-balance sc-stoa))
                        (expect "<<DALOS-ADMIN-03>> the target received the full balance"
                            sc-before (ref-coin::get-balance target))
                        ;;CONSERVATION: nothing was minted or burned, only relocated.
                        (expect "<<DALOS-ADMIN-03>> STOA is conserved across the migration"
                            sc-before
                            (+ (ref-coin::get-balance sc-stoa) (ref-coin::get-balance target)))
                    ]
                )
                ""
            )
        )
    )
)
(commit-tx)

;;|| NEXT >
