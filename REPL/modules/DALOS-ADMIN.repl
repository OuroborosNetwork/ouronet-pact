(begin-tx "DALOS-G6 — the Global Administrative Pause freezes every Stage-1 Talos client")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(namespace "ouronet-ns")
(print "--- [DALOS-G6 · 01 · P|TS under GAP, every Stage-1 Talos module] ---")
;;P3.3, and the highest-leverage fixture left: ONE toggle reaches a guard in EVERY Talos module.
;;
;;Each Talos module carries its own copy of P|TS — the cap every client function composes first —
;;and each copy independently refuses while GAP is on. That duplication is the point: GAP is the
;;protocol's emergency stop, and it only works if NO module has its own unpaused path. A module
;;added later without the check would leave a live entrypoint during a freeze, and nothing else in
;;the suite would notice. So all five Stage-1 modules are driven separately rather than sampled.
;;
;;P|TS is NOT an @event cap, so test-capability acquires it directly — no client call, no account,
;;no signing beyond the admin key needed for the toggle itself.
;;
;;GAP is restored to whatever it was found as (not to a hardcoded false), and the restoration is
;;asserted: this is global state and DALOS-ADMIN-03 later depends on GAP being off.
;;==== DALOS-G6 — the Global Administrative Pause freezes every Stage-1 Talos client · 01 · env-sigs (caps) ==== 
(print "--- [DALOS-G6 — the Global Administrative Pause freezes every Stage-1 Talos client · 01 · env-sigs (caps)] ---")
(env-sigs [{ "key": "PK_AncientHodler", "caps": [] }])
;;==== DALOS-G6 — the Global Administrative Pause freezes every Stage-1 Talos client · 02 · let / invocation ==== 
(print "--- [DALOS-G6 — the Global Administrative Pause freezes every Stage-1 Talos client · 02 · let / invocation] ---")
(let
    (
        (ref-DALOS:module{OuronetDalosV2} DALOS)
        (ref-TS01-A:module{TalosStageOne_AdminV2} TS01-A)
    )
    (let
        (
            (gap0:bool (ref-DALOS::UR_GAP))
        )
        (ref-TS01-A::DALOS|A_ToggleGAP true)
        (map print
            [
                (expect "<<DALOS-G6>> the global pause is ON" true (ref-DALOS::UR_GAP))
                ;;one per Talos module. TS01-CP is the module inside 05_TS01-P.pact — the file and
                ;;the module disagree, which is worth knowing: my first attempt addressed TS01-P and
                ;;got "Module TS01-P has no such member: P|TS".
                (expect-failure "<<DALOS-G6>> TS01-C1 refuses every client function"
                    "While Global Administrative Pause is online" (test-capability (TS01-C1.P|TS)))
                (expect-failure "<<DALOS-G6>> ...TS01-C2 likewise"
                    "While Global Administrative Pause is online" (test-capability (TS01-C2.P|TS)))
                (expect-failure "<<DALOS-G6>> ...TS01-C3 likewise"
                    "While Global Administrative Pause is online" (test-capability (TS01-C3.P|TS)))
                (expect-failure "<<DALOS-G6>> ...TS01-CP likewise"
                    "While Global Administrative Pause is online" (test-capability (TS01-CP.P|TS)))
                (expect-failure "<<DALOS-G6>> ...TS01-C4 likewise"
                    "While Global Administrative Pause is online" (test-capability (TS01-C4.P|TS)))
            ]
        )
        (ref-TS01-A::DALOS|A_ToggleGAP gap0)
        (map print
            [
                (expect "<<DALOS-G6>> GAP restored to the value this block found" gap0 (ref-DALOS::UR_GAP))
                ;;...and the same cap is acquirable again, which proves the refusals above were
                ;;about GAP and not about P|TS being unacquirable in a REPL.
                (expect "<<DALOS-G6>> ...and TS01-C1's P|TS is acquirable once more"
                    true (!= "" (format "{}" [(test-capability (TS01-C1.P|TS))])))
            ]
        )
        ""
    )
)
(env-sigs [])
(commit-tx)

