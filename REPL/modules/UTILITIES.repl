(begin-tx "UTIL-10 — UEV_Fee, twice: two functions, one name, different rules")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
;;==== UTIL-10 — UEV_Fee, twice: two functions, one name, different rules · 01 · namespace ==== ===
(print "--- [UTIL-10 — UEV_Fee, twice: two functions, one name, different rules · 01 · namespace] ---")
(namespace "ouronet-ns")
(print "--- [UTIL-10 · 01 · the two fee validators] ---")
;;There are TWO UEV_Fee functions in the utilities and they do not agree:
;;
;;   U|ATS::UEV_Fee    one enforce, one message:  0.0 <= fee <= 999.0, 4 dp
;;   U|DALOS::UEV_Fee  two enforces, two messages: fee is -1.0, or 0.0, or in [1.0, 999.0]
;;
;;So the DALOS validator has a HOLE the ATS one does not: 0.5 is a perfectly good fee to the ATS
;;rule and refused by the DALOS rule. Asserted directly against each other below, because a
;;caller holding a fee and choosing between them has no way to know that from the names.
;;==== UTIL-10 — UEV_Fee, twice: two functions, one name, different rules · 02 · let / invocation ==== 
(print "--- [UTIL-10 — UEV_Fee, twice: two functions, one name, different rules · 02 · let / invocation] ---")
(let
    (
        (ref-U|ATS:module{UtilityAtsV3} U|ATS)
        (ref-U|DALOS:module{UtilityDalosV2} U|DALOS)
    )
    (map print
        [
            ;;the DALOS validator's three ACCEPTED shapes -- the sentinel, zero, and the band.
            (expect "<<UTIL-10>> -1.0 is the DALOS 'no fee' sentinel and is accepted"
                true (!= "" (format "{}" [(ref-U|DALOS::UEV_Fee -1.0)])))
            (expect "<<UTIL-10>> 0.0 is accepted"
                true (!= "" (format "{}" [(ref-U|DALOS::UEV_Fee 0.0)])))
            (expect "<<UTIL-10>> 1.0 is accepted (the bottom of the band)"
                true (!= "" (format "{}" [(ref-U|DALOS::UEV_Fee 1.0)])))
            (expect "<<UTIL-10>> 999.0 is accepted (the top)"
                true (!= "" (format "{}" [(ref-U|DALOS::UEV_Fee 999.0)])))
            ;;THE HOLE. Between the 0.0 point and the band's 1.0 floor there is a gap, and a
            ;;naive (and (>= fee 0.0) (<= fee 999.0)) would swallow it silently.
            (expect-failure "<<UTIL-10>> FINDING: 0.5 falls in the HOLE between 0.0 and the 1.0 floor"
                "The fee amount of 0.5 is not a valid fee amount value wise"
                (ref-U|DALOS::UEV_Fee 0.5))
            ;;...and the SAME value is perfectly valid to the ATS validator. This pair is the
            ;;point of the block: one name, two rules, opposite verdicts on one input.
            (expect "<<UTIL-10>> ...while U|ATS::UEV_Fee accepts that very same 0.5"
                true (!= "" (format "{}" [(ref-U|ATS::UEV_Fee 0.5)])))
            ;;the two DALOS enforces are separately reachable, by distinct messages.
            (expect-failure "<<UTIL-10>> a fee finer than FEE_PRECISION fails the DECIMAL rule"
                "is not a valid fee amount decimal wise"
                (ref-U|DALOS::UEV_Fee 1.000001))
            (expect-failure "<<UTIL-10>> ...and one past the ceiling fails the VALUE rule"
                "The fee amount of 1000.0 is not a valid fee amount value wise"
                (ref-U|DALOS::UEV_Fee 1000.0))
            ;;-2.0 is neither the sentinel nor in the band.
            (expect-failure "<<UTIL-10>> only -1.0 is a sentinel; -2.0 is just invalid"
                "The fee amount of -2.0 is not a valid fee amount value wise"
                (ref-U|DALOS::UEV_Fee -2.0))
        ]
    )
    ""
)
(print "--- [UTIL-10 · 02 · decimals and designations] ---")
(let
    (
        (ref-U|DALOS:module{UtilityDalosV2} U|DALOS)
    )
    (map print
        [
            ;;UEV_Decimals — both edges of 2..24 accepted, both neighbours refused.
            (expect "<<UTIL-10>> 2 decimals is the minimum and is accepted"
                true (!= "" (format "{}" [(ref-U|DALOS::UEV_Decimals 2)])))
            (expect "<<UTIL-10>> 24 decimals is the maximum and is accepted"
                true (!= "" (format "{}" [(ref-U|DALOS::UEV_Decimals 24)])))
            (expect-failure "<<UTIL-10>> 1 decimal is below the standard"
                "Decimal Size is not between 2 and 24 as per DALOS Standard!"
                (ref-U|DALOS::UEV_Decimals 1))
            (expect-failure "<<UTIL-10>> 25 decimals is above it"
                "Decimal Size is not between 2 and 24 as per DALOS Standard!"
                (ref-U|DALOS::UEV_Decimals 25))
            ;;UEV_NameOrTicker — the two enforces are size then charset, and the SPECIAL flag
            ;;widens the size ceiling (LP names concatenate up to 7 constituents). Asserted as a
            ;;pair: a name too long for a standard token that the special form accepts.
            (expect "<<UTIL-10>> a plain token name is accepted"
                true (!= "" (format "{}" [(ref-U|DALOS::UEV_NameOrTicker "MyToken" true false)])))
            (expect-failure "<<UTIL-10>> a 1-character designation is below the minimum"
                "Designation does not conform to the DALOS Name Standard for Size!"
                (ref-U|DALOS::UEV_NameOrTicker "M" true false))
            ;;charset: passes the size rule, fails on content.
            (expect-failure "<<UTIL-10>> a name with a space fails the CHARACTER rule, not the size one"
                "Designation does not conform character-wise"
                (ref-U|DALOS::UEV_NameOrTicker "My Token" true false))
        ]
    )
    ""
)
(commit-tx)
