(begin-tx "UTIL-09 — the glyph account shape guards, mutated from REAL accounts")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
;;==== UTIL-09 — the glyph account shape guards, mutated from REAL accounts · 01 · namespace ==== =
(print "--- [UTIL-09 — the glyph account shape guards, mutated from REAL accounts · 01 · namespace] ---")
(namespace "ouronet-ns")
(print "--- [UTIL-09 · 01 · DALOS account shape] ---")
;;A 162-character glyph account has four independent shape rules, and each trip below is the
;;LIVE account with exactly one of them broken -- never a string typed from scratch. That
;;matters here more than usual: any hand-written 162-char glyph would fail several rules at once
;;and every test would land on whichever fires first, proving only that one.
;;
;;   1  (= account-len 162)                "...does not conform to the DALOS Standard..."
;;   2  enforce-one on the first character  "Address|Account format is invalid"
;;   3  (= second ".")                      "...second Character must be a <.>"
;;   4  GLYPH|UEV_MsDc on the body          "Characters do not conform to the DALOS|CHARSET"
;;==== UTIL-09 — the glyph account shape guards, mutated from REAL accounts · 02 · let / invocation ==== 
(print "--- [UTIL-09 — the glyph account shape guards, mutated from REAL accounts · 02 · let / invocation] ---")
(let
    (
        (ref-U|DALOS:module{UtilityDalosGlyphsV3} U|DALOS)
        (std:string KST.ANHD)
        (smt:string KC.BJ)
    )
    (map print
        [
            ;;HAPPY PATH on BOTH identifiers. Rule 2 accepts Ѻ (standard) or Σ (smart), so a test
            ;;on one alone would pass against a guard that only knew that one.
            (expect "<<UTIL-09>> a real standard account (Ѻ.) is accepted"
                true (!= "" (format "{}" [(ref-U|DALOS::GLYPH|UEV_DalosAccount std)])))
            (expect "<<UTIL-09>> a real smart account (Σ.) is accepted too"
                true (!= "" (format "{}" [(ref-U|DALOS::GLYPH|UEV_DalosAccount smt)])))
            (expect "<<UTIL-09>> ...and both really are 162 characters"
                [162 162] [(length std) (length smt)])
            ;;1] one character short. Everything else about the string is still valid.
            (expect-failure "<<UTIL-09>> guard 1: 161 characters is refused"
                "Address|Account does not conform to the DALOS Standard for Addresses|Accounts"
                (ref-U|DALOS::GLYPH|UEV_DalosAccount (drop 1 std)))
            ;;2] length preserved, only the IDENTIFIER swapped. This is the enforce-one, and it
            ;;demonstrates in live code what the tool now counts as unreachable: the two inner
            ;;messages ("...checking for a Standard Account", "...for a Smart Account") can NEVER
            ;;be observed, because Pact raises the enforce-one's own message once both branches
            ;;fail. What a caller gets is the generic outer text, with no hint which identifier
            ;;it should have used.
            (expect-failure "<<UTIL-09>> guard 2: a wrong identifier gives the OUTER enforce-one message"
                "Address|Account format is invalid"
                (ref-U|DALOS::GLYPH|UEV_DalosAccount (+ "X" (drop 1 std))))
            ;;3] identifier kept, separator broken.
            (expect-failure "<<UTIL-09>> guard 3: the second character must be a dot"
                "Account|Address Format is invalid, second Character must be a <.>"
                (ref-U|DALOS::GLYPH|UEV_DalosAccount (+ (take 1 std) (+ "X" (drop 2 std)))))
            ;;4] prefix intact, one BODY character outside the DALOS charset.
            (expect-failure "<<UTIL-09>> guard 4: a body character outside DALOS|CHARSET"
                "Characters do not conform to the DALOS|CHARSET"
                (ref-U|DALOS::GLYPH|UEV_DalosAccount (+ (take 2 std) (+ " " (drop 3 std)))))
        ]
    )
    ""
)
(print "--- [UTIL-09 · 02 · Apollo account shape: the same rules, different identifiers] ---")
;;Apollo accounts reuse the body charset but take ₱ (standard) or Π (smart), and unlike the
;;DALOS guard the identifier is chosen by an ARGUMENT rather than accepted either way. So this
;;is a 2x2 like the DALOS account-kind pair: each flag must accept its own glyph and refuse the
;;other's. Built by swapping the identifier of a real account, so only that byte differs.
(let
    (
        (ref-U|DALOS:module{UtilityDalosGlyphsV3} U|DALOS)
    )
    (let
        (
            (apollo-std:string (+ "₱" (drop 1 KST.ANHD)))
            (apollo-smt:string (+ "Π" (drop 1 KST.ANHD)))
        )
        (map print
            [
                (expect "<<UTIL-09>> ₱. is a valid STANDARD apollo account"
                    true (!= "" (format "{}" [(ref-U|DALOS::GLYPH|UEV_ApolloAccount apollo-std false)])))
                (expect "<<UTIL-09>> Π. is a valid SMART apollo account"
                    true (!= "" (format "{}" [(ref-U|DALOS::GLYPH|UEV_ApolloAccount apollo-smt true)])))
                ;;the off-diagonal -- each flag refuses the other's glyph, and by DISTINCT
                ;;messages, unlike the DALOS enforce-one above. Same problem, better diagnostics.
                (expect-failure "<<UTIL-09>> the SMART check refuses a ₱ account, and names what it wanted"
                    "Apollo Smart account must begin with Π"
                    (ref-U|DALOS::GLYPH|UEV_ApolloAccount apollo-std true))
                (expect-failure "<<UTIL-09>> the STANDARD check refuses a Π account, likewise"
                    "Apollo Standard account must begin with ₱"
                    (ref-U|DALOS::GLYPH|UEV_ApolloAccount apollo-smt false))
                (expect-failure "<<UTIL-09>> a short apollo account is refused on length"
                    "Apollo account string does not conform to length 162"
                    (ref-U|DALOS::GLYPH|UEV_ApolloAccount (drop 1 apollo-std) false))
                (expect-failure "<<UTIL-09>> ...and a broken separator on its own rule"
                    "Apollo account format is invalid, second character must be <.>"
                    (ref-U|DALOS::GLYPH|UEV_ApolloAccount
                        (+ (take 1 apollo-std) (+ "X" (drop 2 apollo-std))) false))
                (expect-failure "<<UTIL-09>> ...and a bad body character on its own rule"
                    "Apollo account characters do not conform to the DALOS|CHARSET"
                    (ref-U|DALOS::GLYPH|UEV_ApolloAccount
                        (+ (take 2 apollo-std) (+ " " (drop 3 apollo-std))) false))
            ]
        )
        ""
    )
)
(commit-tx)

