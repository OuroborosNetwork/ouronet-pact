(begin-tx "UTIL-02 — the interval builders: two guards that differ by ONE divisor")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
;;==== UTIL-02 — the interval builders: two guards that differ by ONE divisor · 01 · namespace ==== 
(print "--- [UTIL-02 — the interval builders: two guards that differ by ONE divisor · 01 · namespace] ---")
(namespace "ouronet-ns")
(print "--- [UTIL-02 · 01 · hard vs soft intervals] ---")
;;UCv_MakeHardIntervals and UCv_MakeSoftIntervals are near-twins: Soft carries the SAME
;;divisibility guard as Hard, plus one more (growth must divide by 3, because Soft splits each
;;growth step into thirds). Testing them as a pair is what shows the extra guard exists —
;;a single test on Soft would pass against a copy of Hard.
;;==== UTIL-02 — the interval builders: two guards that differ by ONE divisor · 02 · let / invocation ==== 
(print "--- [UTIL-02 — the interval builders: two guards that differ by ONE divisor · 02 · let / invocation] ---")
(let
    (
        (ref-U|ATS:module{UtilityAtsV3} U|ATS)
    )
    (map print
        [
            ;;happy path on both, with the SAME arguments, so the only difference measured
            ;;below is the extra guard.
            (expect "<<UTIL-02>> hard intervals build for a divisible (start, growth)"
                true (> (length (ref-U|ATS::UCv_MakeHardIntervals 30 3)) 0))
            (expect "<<UTIL-02>> soft intervals build for the same pair"
                true (> (length (ref-U|ATS::UCv_MakeSoftIntervals 30 3)) 0))
            ;;the SHARED guard: start must divide by growth. Both must refuse.
            (expect-failure "<<UTIL-02>> hard refuses a start not divisible by growth"
                "10 must be divisible by 3 and it is not"
                (ref-U|ATS::UCv_MakeHardIntervals 10 3))
            (expect-failure "<<UTIL-02>> soft refuses it too, by the same rule"
                "10 must be divisible by 3 and it is not"
                (ref-U|ATS::UCv_MakeSoftIntervals 10 3))
            ;;THE DIVERGENCE. growth 4 divides start 4 cleanly, so the shared guard passes --
            ;;and only Soft has anything left to object to. Hard accepts the very same input.
            (expect "<<UTIL-02>> hard ACCEPTS growth=4 (it has no thirds rule)"
                true (> (length (ref-U|ATS::UCv_MakeHardIntervals 4 4)) 0))
            (expect-failure "<<UTIL-02>> ...while soft refuses it: its growth must divide into thirds"
                "4 must be divisible by 3 and it is not"
                (ref-U|ATS::UCv_MakeSoftIntervals 4 4))
        ]
    )
    ""
)
(commit-tx)

