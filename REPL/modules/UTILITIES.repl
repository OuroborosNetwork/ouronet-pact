(begin-tx "UTIL-06 — UEV_AutostakeIndex: four guards, and one that ONE input can reach")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
;;==== UTIL-06 — UEV_AutostakeIndex: four guards, and one that ONE input can reach · 01 · namespace ==== 
(print "--- [UTIL-06 — UEV_AutostakeIndex: four guards, and one that ONE input can reach · 01 · namespace] ---")
(namespace "ouronet-ns")
(print "--- [UTIL-06 · 01 · the atspair name guards, in order] ---")
;;Four sequential enforces, so again each trip must pass the ones before it:
;;
;;   1  (is-charset 0 ats)                    "...does not conform to the required charset: {}"
;;   2  (not (contains ats aipc))             "...contained a prohibited character: {}"
;;   3  (UC_IzStringANC ats false false)      "Atspair does not conform character-wise ..."
;;   4  (and (>= al min) (<= al max))         "...does not conform to the ATS-Pair Standards for Size!"
;;
;;FINDING on guard 2, and it is two separate problems stacked.
;;
;;(a) THE CHECK DOES NOT DO WHAT ITS MESSAGE SAYS. `(contains ats aipc)` asks whether the LIST
;;    ["$" "¢" "£"] contains the atspair -- i.e. whether the whole name IS one of those three
;;    characters. The message says "contained a prohibited character", which would be a SUBSTRING
;;    test. "AB$CD" sails past this guard untouched.
;;(b) SO ONLY ONE INPUT IN THE UNIVERSE CAN REACH IT. Of the three prohibited characters, "¢" and
;;    "£" are non-ASCII, so guard 1 (charset 0 = ASCII) rejects them first. That leaves exactly
;;    "$" -- a single string, out of every string there is, that can make guard 2 fire.
;;
;;Both are asserted below rather than described. The guard is not load-bearing: guard 3's
;;alphanumeric check catches "AB$CD" anyway, which is why this has never surfaced as a bug. But
;;a guard whose message describes a check it does not perform is a trap for the next reader.
;;==== UTIL-06 — UEV_AutostakeIndex: four guards, and one that ONE input can reach · 02 · let / invocation ==== 
(print "--- [UTIL-06 — UEV_AutostakeIndex: four guards, and one that ONE input can reach · 02 · let / invocation] ---")
(let
    (
        (ref-U|ATS:module{UtilityAtsV3} U|ATS)
    )
    (map print
        [
            ;;HAPPY PATH first: a plain alphanumeric name of legal length.
            (expect "<<UTIL-06>> a plain alphanumeric atspair is accepted"
                true (!= "" (format "{}" [(ref-U|ATS::UEV_AutostakeIndex "AtsPair01")])))
            ;;1] non-ASCII trips the charset guard before anything else looks at the string.
            (expect-failure "<<UTIL-06>> guard 1: a non-ASCII name fails the charset check"
                "Account ID does not conform to the required charset: Ats€Pair"
                (ref-U|ATS::UEV_AutostakeIndex "Ats€Pair"))
            ;;2] the ONLY input that reaches guard 2.
            (expect-failure "<<UTIL-06>> guard 2 is reachable by exactly one string: \"$\""
                "Account ID contained a prohibited character: $"
                (ref-U|ATS::UEV_AutostakeIndex "$"))
            ;;(a) proven: a name that genuinely CONTAINS "$" does NOT trip guard 2 -- it falls
            ;;through to guard 3, which is a different message entirely. If guard 2 did what its
            ;;wording claims, this would say "contained a prohibited character".
            (expect-failure "<<UTIL-06>> FINDING: a name CONTAINING $ falls through to guard 3, not guard 2"
                "Atspair does not conform character-wise (Alphanumeric)"
                (ref-U|ATS::UEV_AutostakeIndex "AB$CD"))
            ;;(b) proven: the other two prohibited characters never reach guard 2 at all.
            (expect-failure "<<UTIL-06>> FINDING: the other prohibited chars are eaten by the charset guard first"
                "Account ID does not conform to the required charset"
                (ref-U|ATS::UEV_AutostakeIndex "£"))
            ;;4] length. Both sides of the boundary, derived from CT_MIN_DESIGNATION_LENGTH (2)
            ;;rather than guessed -- my first draft asserted "AB" was too short and it PASSED,
            ;;which is precisely the "an expect-failure that does not fail proves nothing" trap
            ;;this phase exists to catch. The accepting half is what makes the rejecting half
            ;;mean something: it shows the guard is at 2, not merely present.
            (expect "<<UTIL-06>> a 2-character name IS accepted (the minimum is 2)"
                true (!= "" (format "{}" [(ref-U|ATS::UEV_AutostakeIndex "AB")])))
            (expect-failure "<<UTIL-06>> guard 4: one character below it is refused"
                "Atspair does not conform to the ATS-Pair Standards for Size!"
                (ref-U|ATS::UEV_AutostakeIndex "A"))
            ;;UEV_StoicTagIndex is the same rules minus capitals -- so a name the ATS guard
            ;;ACCEPTS must be refused here. Asserted as a pair, since that difference is the
            ;;whole reason the second function exists.
            (expect "<<UTIL-06>> a lowercase name is a valid StoicTag index"
                true (!= "" (format "{}" [(ref-U|ATS::UEV_StoicTagIndex "atspair01")])))
            (expect-failure "<<UTIL-06>> ...while the SAME name with capitals is refused (ATS accepts it)"
                "StoicTag name AtsPair01 does not conform to index standards (Autostake rules, lowercase only)"
                (ref-U|ATS::UEV_StoicTagIndex "AtsPair01"))
        ]
    )
    ""
)
(commit-tx)

