(begin-tx "UTIL-05 — UCv_SolidifyUnstakeObject: a bounds guard with one message for both ends")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
;;==== UTIL-05 — UCv_SolidifyUnstakeObject: a bounds guard with one message for both ends · 01 · namespace ==== 
(print "--- [UTIL-05 — UCv_SolidifyUnstakeObject: a bounds guard with one message for both ends · 01 · namespace] ---")
(namespace "ouronet-ns")
(print "--- [UTIL-05 · 01 · remove-position bounds] ---")
;;(and (> remove-position 0) (< remove-position how-many-rts)) under a single "Invalid
;;<remove-position>". Position 0 is excluded deliberately: index 0 is the PRIMAL reward token
;;that everything else folds INTO, so removing it is meaningless rather than merely out of
;;range. Both ends asserted; both give the same text.
;;==== UTIL-05 — UCv_SolidifyUnstakeObject: a bounds guard with one message for both ends · 02 · let / invocation ==== 
(print "--- [UTIL-05 — UCv_SolidifyUnstakeObject: a bounds guard with one message for both ends · 02 · let / invocation] ---")
(let
    (
        (ref-U|ATS:module{UtilityAtsV3} U|ATS)
    )
    (let
        (
            (awo:object{UtilityAtsV3.Awo}
                { "reward-tokens" : [10.0 5.0 2.0]
                , "cull-time"     : (time "2026-01-01T00:00:00Z")})
        )
        (map print
            [
                ;;HAPPY PATH: removing position 1 folds its 5.0 into the primal 10.0.
                (expect "<<UTIL-05>> solidifying position 1 folds its value into the primal"
                    [15.0 2.0] (at "reward-tokens" (ref-U|ATS::UCv_SolidifyUnstakeObject awo 1)))
                (expect "<<UTIL-05>> ...and the list is one shorter"
                    2 (length (at "reward-tokens" (ref-U|ATS::UCv_SolidifyUnstakeObject awo 1))))
                (expect "<<UTIL-05>> ...while the cull-time rides through untouched"
                    (time "2026-01-01T00:00:00Z")
                    (at "cull-time" (ref-U|ATS::UCv_SolidifyUnstakeObject awo 1)))
                ;;INVARIANT: solidifying moves value, it never creates or destroys it.
                (expect "<<UTIL-05>> INVARIANT: the total is conserved by solidification"
                    (fold (+) 0.0 (at "reward-tokens" awo))
                    (fold (+) 0.0 (at "reward-tokens" (ref-U|ATS::UCv_SolidifyUnstakeObject awo 1))))
                ;;both ends of the bound, same message.
                (expect-failure "<<UTIL-05>> position 0 (the primal itself) is refused"
                    "Invalid <remove-position>" (ref-U|ATS::UCv_SolidifyUnstakeObject awo 0))
                (expect-failure "<<UTIL-05>> position == length is refused (the last valid index is length-1)"
                    "Invalid <remove-position>" (ref-U|ATS::UCv_SolidifyUnstakeObject awo 3))
            ]
        )
        ""
    )
)
(commit-tx)
;;|| NEXT >
