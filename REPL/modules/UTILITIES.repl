(begin-tx "UTIL-11 — the small utility guards, swept")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
;;==== UTIL-11 — the small utility guards, swept · 01 · namespace ==== ============================
(print "--- [UTIL-11 — the small utility guards, swept · 01 · namespace] ---")
(namespace "ouronet-ns")
(print "--- [UTIL-11 · 01 · guard combinators, lists, integers, decimals] ---")
;;The tail of the utility worklist: one or two guards each, across six modules. Cheap enough
;;that leaving them unpinned would be pure neglect -- every one is a pure function reached by a
;;direct call. Each still gets its accepting case, because a guard that always fires satisfies
;;every rejection test ever written against it.
;;==== UTIL-11 — the small utility guards, swept · 02 · let / invocation ==== =====================
(print "--- [UTIL-11 — the small utility guards, swept · 02 · let / invocation] ---")
(let
    (
        (ref-U|G:module{OuronetGuardsV2} U|G)
        (ref-U|LST:module{StringProcessorV2} U|LST)
        (ref-U|INT:module{OuronetIntegersV2} U|INT)
        (ref-U|DEC:module{OuronetDecimalsV2} U|DEC)
    )
    (let
        (
            (g:guard (keyset-ref-guard "ouronet-ns.dh_master-keyset"))
        )
        (map print
            [
                ;;--- U_G: the combinators refuse an EMPTY guard list. That matters more than it
                ;;looks: UEV_GuardOfAll over zero guards would vacuously succeed, handing back a
                ;;guard that authorises everything. The empty case is the dangerous one, not an
                ;;edge case.
                (expect "<<UTIL-11>> GuardOfAll over a non-empty list returns a guard"
                    true (!= "" (format "{}" [(ref-U|G::UEV_GuardOfAll [g])])))
                (expect "<<UTIL-11>> GuardOfAny likewise"
                    true (!= "" (format "{}" [(ref-U|G::UEV_GuardOfAny [g])])))
                (expect-failure "<<UTIL-11>> GuardOfAll refuses an EMPTY list (which would authorise everything)"
                    "Guard list cannot be empty" (ref-U|G::UEV_GuardOfAll []))
                (expect-failure "<<UTIL-11>> GuardOfAny refuses an empty list too"
                    "Guard list cannot be empty" (ref-U|G::UEV_GuardOfAny []))
                ;;--- U_LST: two index guards and two emptiness guards.
                (expect "<<UTIL-11>> RemoveItemAt drops the addressed element"
                    [1 3] (ref-U|LST::UC_RemoveItemAt [1 2 3] 1))
                (expect-failure "<<UTIL-11>> ...and refuses a position at the length (last valid is length-1)"
                    "Position must be non-negative and within" (ref-U|LST::UC_RemoveItemAt [1 2 3] 3))
                (expect-failure "<<UTIL-11>> ...and a negative position"
                    "Position must be non-negative and within" (ref-U|LST::UC_RemoveItemAt [1 2 3] -1))
                (expect "<<UTIL-11>> ReplaceAt substitutes in place"
                    [1 9 3] (ref-U|LST::UC_ReplaceAt [1 2 3] 1 9))
                (expect-failure "<<UTIL-11>> ...and refuses an out-of-range index"
                    "Index out of bounds" (ref-U|LST::UC_ReplaceAt [1 2 3] 3 9))
                (expect-failure "<<UTIL-11>> UEV_NotEmpty refuses the empty list"
                    "List cannot be empty" (ref-U|LST::UEV_NotEmpty []))
                (expect "<<UTIL-11>> UEV_StringPresence accepts a member"
                    true (!= "" (format "{}" [(ref-U|LST::UEV_StringPresence "b" ["a" "b"])])))
                (expect-failure "<<UTIL-11>> ...and reports the missing item AND the list it searched"
                    "String c is not present in list [\"a\", \"b\"]."
                    (ref-U|LST::UEV_StringPresence "c" ["a" "b"]))
                ;;--- U_INT
                (expect "<<UTIL-11>> MaxInteger picks the largest"
                    9 (ref-U|INT::UEV_MaxInteger [3 9 1]))
                (expect-failure "<<UTIL-11>> ...and refuses an empty list rather than returning a default"
                    "UEV_MaxInteger: list cannot be empty" (ref-U|INT::UEV_MaxInteger []))
                ;;--- U_DEC: percent and promille share a shape but NOT a ceiling, so they are
                ;;asserted against each other at 100.0 -- valid for one, mid-range for the other.
                (expect "<<UTIL-11>> Percent accepts its 100.0 ceiling"
                    true (!= "" (format "{}" [(ref-U|DEC::UCv_Percent 10.0 100.0 2)])))
                (expect-failure "<<UTIL-11>> ...and refuses anything past it"
                    "Invalid percent amount" (ref-U|DEC::UCv_Percent 10.0 100.0001 2))
                (expect "<<UTIL-11>> Promille accepts 100.0 as an ordinary mid-range value"
                    true (!= "" (format "{}" [(ref-U|DEC::UCv_Promille 10.0 100.0 2)])))
                (expect-failure "<<UTIL-11>> ...and has its own, higher ceiling at 1000.0"
                    "Invalid permille amount" (ref-U|DEC::UCv_Promille 10.0 1000.0001 2))
                ;;DecimalArray: every inner list must be the same length -- a ragged array would
                ;;silently mis-index every consumer downstream.
                (expect "<<UTIL-11>> a rectangular decimal array is accepted"
                    true (!= "" (format "{}" [(ref-U|DEC::UEV_DecimalArray [[1.0 2.0] [3.0 4.0]])])))
                (expect-failure "<<UTIL-11>> ...and a RAGGED one is refused"
                    "All Fee-Array Lists must be of equal length !"
                    (ref-U|DEC::UEV_DecimalArray [[1.0 2.0] [3.0]]))
            ]
        )
        ""
    )
)
(print "--- [UTIL-11 · 02 · vesting milestones and the inverse swap bound] ---")
(let
    (
        (ref-U|VST:module{UtilityVstV2} U|VST)
        (ref-U|SWP:module{UtilitySwpV2} U|SWP)
    )
    (map print
        [
            ;;--- U_VST: milestone bounds, both edges.
            (expect "<<UTIL-11>> 1 milestone is valid (the floor)"
                true (!= "" (format "{}" [(ref-U|VST::UEV_Milestone 1)])))
            (expect "<<UTIL-11>> 250 milestones is valid (the ceiling)"
                true (!= "" (format "{}" [(ref-U|VST::UEV_Milestone 250)])))
            (expect-failure "<<UTIL-11>> 0 milestones is refused"
                "Milestone splitting number 0 is out of bounds" (ref-U|VST::UEV_Milestone 0))
            (expect-failure "<<UTIL-11>> 251 is one past the ceiling"
                "Milestone splitting number 251 is out of bounds" (ref-U|VST::UEV_Milestone 251))
            ;;UEV_MilestoneWithTime delegates to UEV_Milestone and then adds two of its own, so
            ;;each trip has to carry a VALID milestone count to reach them.
            (expect "<<UTIL-11>> a schedule inside the upper lock limit is accepted"
                true (!= "" (format "{}" [(ref-U|VST::UEV_MilestoneWithTime 0 86400 10 788400000)])))
            (expect-failure "<<UTIL-11>> a negative offset is refused"
                "Offset and Duration cannot be negative"
                (ref-U|VST::UEV_MilestoneWithTime -1 86400 10 788400000))
            (expect-failure "<<UTIL-11>> ...and a negative duration, by the same rule"
                "Offset and Duration cannot be negative"
                (ref-U|VST::UEV_MilestoneWithTime 0 -1 10 788400000))
            ;;milestones x duration + offset must fit the limit. 250 x 788400000 blows past the
            ;;25-year vesting ceiling while every individual argument stays legal -- the guard is
            ;;on the PRODUCT, which no single-argument test would reach.
            (expect-failure "<<UTIL-11>> individually-legal arguments whose PRODUCT exceeds the lock limit"
                "Upper Lock Time Exceeded"
                (ref-U|VST::UEV_MilestoneWithTime 0 788400000 250 788400000))
            ;;--- U_SWP: the inverse swap cannot ask for at-or-more than the pool holds.
            ;;Requesting exactly the reserve is the interesting case: it would drain the side to
            ;;zero and make the constant-product term undefined, so the bound is STRICT.
            (expect-failure "<<UTIL-11>> asking for the pool's ENTIRE output reserve is refused (strict bound)"
                "output-amount must be strictly less than"
                (ref-U|SWP::UCv_ComputeInverseY
                    { "A" : 1.0, "X" : [1000.0 1000.0], "output-amount" : 1000.0
                    , "output-position" : 1, "input-position" : 0, "input-precision" : 12
                    , "weights" : [1.0 1.0] }))
        ]
    )
    ""
)
(commit-tx)
