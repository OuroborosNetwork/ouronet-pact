(begin-tx "AQP-G18 — FVT|C>ISSUE-FVT: class bounds, name reuse, and the denominator contract")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(namespace "ouronet-ns")
(print "--- [AQP-G18 · 01 · FVT issuance admission] ---")
;;Three guards, reached through the Talos client path because FVT|C>ISSUE-FVT is an @event defcap.
;;
;;The first is a fold over class bounds AND name availability, so it is driven TWICE — once with
;;an out-of-range class, once by reusing a name that already exists. A fold that had lost its
;;second conjunct would still reject the first input and silently allow an FVT to be issued over
;;the top of a live one, which is the more damaging of the two failures.
;;
;;The other two are the halves of one contract, and they are worth pinning together because they
;;are mutually exclusive by construction: a FARM (class 0) must name a real DPTF as its common
;;denominator, while a VAULT or TREASURY (class 1-2) must leave it BAR. Either rule alone reads
;;like an arbitrary restriction; the pair is the actual invariant — only farms denominate.
;;==== AQP-G18 — FVT|C>ISSUE-FVT: class bounds, name reuse, and the denominator contract · 01 · env-sigs (caps) ==== 
(print "--- [AQP-G18 — FVT|C>ISSUE-FVT: class bounds, name reuse, and the denominator contract · 01 · env-sigs (caps)] ---")
(env-sigs [{ "key": "PK_AncientHodler", "caps": [] }])
;;==== AQP-G18 — FVT|C>ISSUE-FVT: class bounds, name reuse, and the denominator contract · 02 · let / invocation ==== 
(print "--- [AQP-G18 — FVT|C>ISSUE-FVT: class bounds, name reuse, and the denominator contract · 02 · let / invocation] ---")
(let
    (
        (ref-TS02-C3:module{TalosStageTwo_ClientThreeV1} TS02-C3)
    )
    (map print
        [
            (expect-failure "<<AQP-G18>> an fvt-class outside 0..2 is refused"
                "Invalid FVT issue: fvt-class must be 0..2 and fvt-name must be unused"
                (ref-TS02-C3::AQP-FVT|C_Issue KST.ANHD "BadClassFvt" KST.ANHD 9 "|"))
            ;;valid class, but the name is already taken by a live FVT in this suite
            (expect-failure "<<AQP-G18>> ...and a name already in use is refused by the same fold"
                "Invalid FVT issue: fvt-class must be 0..2 and fvt-name must be unused"
                (ref-TS02-C3::AQP-FVT|C_Issue KST.ANHD "SfStakeVault" KST.ANHD 1 "|"))
            ;;--- the denominator contract, both directions
            (expect-failure "<<AQP-G18>> a FARM issued without a common denominator is refused"
                "Farm FVT requires a full native DPTF common-denominator"
                (ref-TS02-C3::AQP-FVT|C_Issue KST.ANHD "FarmNoDenom" KST.ANHD 0 "|"))
            (expect-failure "<<AQP-G18>> ...and a VAULT issued WITH one is refused too"
                "Vault/Treasury FVT common-denominator must be |"
                (ref-TS02-C3::AQP-FVT|C_Issue KST.ANHD "VaultWithDenom" KST.ANHD 1 "OURO-98c486052a51"))
        ]
    )
    ""
)
(env-sigs [])
(commit-tx)

