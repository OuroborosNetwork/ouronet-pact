(begin-tx "AQP-G36 — the anchor-counter fixture left no trace")
(namespace "ouronet-ns")
(print "--- [AQP-G36 · 01 · no leakage] ---")
;;AQP-G35 deactivated a boost class and moved two counters. Committing any of it would make later
;;anchor tests read a class that admits nothing, or an asset permanently at its cap -- and the
;;failures would surface as "anchor issuance broke", far from the cause.
(let
    (
        (bc:string "TfStakeBoost-98c486052a51")
        (as:string "OURO-98c486052a51")
    )
    (map print
        [
            (expect "<<AQP-G36>> the boost class is active again with its original slot count"
                [true 1]
                [(at "class-active" (AQP-ANK.UR_BC|Data bc))
                 (at "anchors" (AQP-ANK.UR_BC|Data bc))])
            (expect "<<AQP-G36>> ...and the asset is back at 2 anchors, not 48 or 49"
                2 (at "anchors-active" (AQP-ANK.UR_AA|Data as)))
            (expect "<<AQP-G36>> ...so both admission guards pass again"
                [true true]
                [(AQP-ANK.UEV_IssueAnchor as bc) (AQP-ANK.UEV_AssetAnchorCap as)])
        ]
    )
    ""
)
(commit-tx)

