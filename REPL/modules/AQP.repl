(begin-tx "AQP-F2 — RPS: the zero-guards, the singular/plural staleness pair, and the stake-flow previews")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
;;==== AQP-F2 — RPS: the zero-guards, the singular/plural staleness pair, and the stake-flow previews · 01 · namespace ==== 
(print "--- [AQP-F2 — RPS: the zero-guards, the singular/plural staleness pair, and the stake-flow previews · 01 · namespace] ---")
(namespace "ouronet-ns")
(print "--- [AQP-F2 · 01 · the IGNIS mirrors' zero-guards, both arms] ---")
;;FUNCTION COVERAGE (G6, Tier 1: RPS). The `URC_*Ignis` family are read-only IFP MIRRORS of write
;;paths -- each one is supposed to predict exactly what its exec twin will charge. They feed the
;;INFO_ cost previews a client sees before signing, so a mirror that drifts from its twin quotes the
;;user a price the chain will not honour. None of them had ever been called.
;;
;;Each carries an explicit zero-guard in its @doc ("0 when amount<=0", "0 when ffc<=0"). Both arms
;;are asserted for each: a guard tested only on its zero side passes on a function that always
;;returns zero, which for a PRICE reader is the failure that would go unnoticed longest.
;;==== AQP-F2 — RPS: the zero-guards, the singular/plural staleness pair, and the stake-flow previews · 02 · let / invocation ==== 
(print "--- [AQP-F2 — RPS: the zero-guards, the singular/plural staleness pair, and the stake-flow previews · 02 · let / invocation] ---")
(let
    (
        (ouro:string "OURO-98c486052a51")
    )
    (map print
        [
            ;;URC_CollectXferIgnis — "0 when amount<=0"
            (expect "<<AQP-F2>> URC_CollectXferIgnis is 0.0 at a zero amount"
                0.0 (RPS.URC_CollectXferIgnis ouro KST.ANHD 0.0))
            (expect "<<AQP-F2>> ...and at a negative one"
                0.0 (RPS.URC_CollectXferIgnis ouro KST.ANHD -5.0))
            ;;THE OTHER ARM: a real transfer costs something. Without this the two above are
            ;;satisfied by a function that never charges at all.
            (expect "<<AQP-F2>> ...but a REAL amount is priced above zero"
                true (> (RPS.URC_CollectXferIgnis ouro KST.ANHD 100.0) 0.0))
            ;;...and the price does not depend on the amount (it mirrors ONE transfer, not a
            ;;per-unit charge) -- which is the shape a reviewer would most likely get wrong.
            (expect "<<AQP-F2>> ...and it is a FLAT per-transfer price, not proportional to the amount"
                (RPS.URC_CollectXferIgnis ouro KST.ANHD 100.0)
                (RPS.URC_CollectXferIgnis ouro KST.ANHD 1000000.0))
        ]
    )
    ""
)
(print "--- [AQP-F2 · 02 · the staleness pair must agree with each other] ---")
;;`URC_FvtUserHasStaleMember` and `URC_FvtUserStaleMemberCount` are a boolean/count pair over the
;;same scan, and `URC_FvtHasAnyMemberLink` is the same idea at vault level. Pairs like this are
;;where drift hides: each is individually plausible, and nothing forces them to agree.
;;
;;THE INVARIANT IS THE TEST -- `has == (count > 0)` -- asserted on real vaults rather than on a
;;hand-built case, because it must hold for every vault whatever its state.
(let
    (
        (ref-U|DALOS:module{UtilityDalosV2} U|DALOS)
        (ref-RPS:module{AcquisitionRewardPerShareV1} RPS)
    )
    (let
        (
            (vaults:[string]
                [(ref-U|DALOS::UDC_Makeid "TfStakeVault")
                 (ref-U|DALOS::UDC_Makeid "SfStakeVault")
                 (ref-U|DALOS::UDC_Makeid "OfStakeVault")])
        )
        (map print
            [
                ;;the boolean and the count agree, on every vault in the suite, for two users
                (expect "<<AQP-F2>> HasStaleMember agrees with (StaleMemberCount > 0) on every vault, for ANHD"
                    true
                    (fold (and) true
                        (map (lambda (v:string)
                                (= (RPS.URC_FvtUserHasStaleMember v KST.ANHD)
                                   (> (RPS.URC_FvtUserStaleMemberCount v KST.ANHD) 0)))
                            vaults)))
                (expect "<<AQP-F2>> ...and for EMMA"
                    true
                    (fold (and) true
                        (map (lambda (v:string)
                                (= (RPS.URC_FvtUserHasStaleMember v KST.EMMA)
                                   (> (RPS.URC_FvtUserStaleMemberCount v KST.EMMA) 0)))
                            vaults)))
                ;;the count is never negative -- a fold over a map of 0/1 that went negative would
                ;;mean the per-member predicate returned something other than a boolean
                (expect "<<AQP-F2>> ...and the count is never negative"
                    true
                    (fold (and) true
                        (map (lambda (v:string) (>= (RPS.URC_FvtUserStaleMemberCount v KST.ANHD) 0))
                            vaults)))
                ;;vault-level: HasAnyMemberLink must agree with the link COUNT it is a wrapper over
                (expect "<<AQP-F2>> URC_FvtHasAnyMemberLink agrees with (MemberLinkCount > 0) on every vault"
                    true
                    (fold (and) true
                        (map (lambda (v:string)
                                (= (RPS.URC_FvtHasAnyMemberLink v)
                                   (> (RPS.UR_FVT|MemberLinkCount v) 0)))
                            vaults)))
                ;;...and at least one vault DOES have a link, so the agreement above is not
                ;;"false == false" three times over
                (expect "<<AQP-F2>> ...and at least one vault really has a member link"
                    true
                    (fold (or) false (map (lambda (v:string) (RPS.URC_FvtHasAnyMemberLink v)) vaults)))
            ]
        )
    )
    ""
)
(print "--- [AQP-F2 · 03 · the stake-flow cost previews, both directions] ---")
;;`URCi_TrueFungibleStakeFlow` and its orto/collectable twins quote the total IGNIS of a stake or
;;unstake before the user signs. `direction=true` is stake (owner -> vault), `false` is unstake.
;;The two directions do NOT carry the same legs, so a preview that ignored the flag would quote one
;;price for both -- asserted here as an INEQUALITY, which is the only thing that catches it.
(let
    (
        (ref-U|DALOS:module{UtilityDalosV2} U|DALOS)
        (ouro:string "OURO-98c486052a51")
    )
    (let
        (
            (pool:string (ref-U|DALOS::UDC_Makeid "ResumeVacPool"))
        )
        (map print
            [
                (expect "<<AQP-F2>> a TF stake flow is quoted above zero"
                    true (> (RPS.URCi_TrueFungibleStakeFlow pool KST.ANHD KST.ANHD ouro 10.0 true) 0.0))
                (expect "<<AQP-F2>> ...and so is the unstake direction"
                    true (> (RPS.URCi_TrueFungibleStakeFlow pool KST.ANHD KST.ANHD ouro 10.0 false) 0.0))
                ;;THE TWO DIRECTIONS PRICE THE SAME HERE, and the first draft of this block asserted
                ;;they would DIFFER -- wrong, and worth keeping the correction visible. <direction>
                ;;does not select a different set of legs: all nine legs are direction-independent.
                ;;It is read in exactly one place, to swap sender and receiver
                ;;(`(sender (if direction owner-id vault))` / `(receiver (if direction vault owner-id))`),
                ;;and that pair feeds `TFT::URC_TransferClasses` -> xfer-type -> the custody-transfer
                ;;leg. So the price differs by direction ONLY when the transfer CLASSIFICATION is
                ;;asymmetric between the two accounts.
                ;;
                ;;For OURO between a plain account and the AQP vault it is symmetric, so equal prices
                ;;are the CORRECT answer. Asserting the equality alone would not distinguish that from
                ;;a dropped flag, so the classification itself is pinned below -- that is what
                ;;explains the equality instead of merely recording it.
                (expect "<<AQP-F2>> ...and the two directions price the same, because the transfer CLASS is symmetric here"
                    (RPS.URCi_TrueFungibleStakeFlow pool KST.ANHD KST.ANHD ouro 10.0 true)
                    (RPS.URCi_TrueFungibleStakeFlow pool KST.ANHD KST.ANHD ouro 10.0 false))
                (expect "<<AQP-F2>> ...which is the reason: OURO classifies identically in both directions"
                    (at "type" (TFT.URC_TransferClasses ouro KST.ANHD AQP-POOL.AQP|SC_NAME 10.0))
                    (at "type" (TFT.URC_TransferClasses ouro AQP-POOL.AQP|SC_NAME KST.ANHD 10.0)))
                ;;and the flag does reach a real computation rather than being inert: the quoted
                ;;total is strictly above the single transfer leg it contains, i.e. the other eight
                ;;legs are present too.
                (expect "<<AQP-F2>> ...and the quote covers more than the transfer leg alone"
                    true (> (RPS.URCi_TrueFungibleStakeFlow pool KST.ANHD KST.ANHD ouro 10.0 true)
                            (RPS.URC_CollectXferIgnis ouro KST.ANHD 10.0)))
            ]
        )
    )
    ""
)
(commit-tx)

