(begin-tx "AQP-F11 — SCORE: the NF score-definition WRITE path, which nothing had ever run")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(namespace "ouronet-ns")
(print "--- [AQP-F11 · 01 · issue a trait definition and a class definition on a real DPNF score] ---")
;;FOURTEEN never-reached readers in one family (`UR_N-DEF|NFTraitScore*`, `UR_N-DEF|NFClassScore*`,
;;`UR_N-DEF-REV|*`), and unlike most of this phase it is NOT a naming artefact: the state they read
;;did not exist anywhere. Grepping every `.repl` for `AQP-SCR|C_IssueNonFungible{,Set}ScoreDefinition`
;;finds only INFO cost-previews and `expect-failure`s -- the SUCCESSFUL write path had never once
;;been executed. So this block builds the fixture, which also runs that client entrypoint for the
;;first time.
;;
;;TWO FIXTURE FACTS HAD TO BE DISCOVERED, and both are worth recording because they are why this
;;looked impossible at first:
;;
;;  1] TRAIT-mode definitions validate the trait KEY against the collection's own metadata --
;;     `(contains trait-key (UR_N|RawMetaData (UR_NativeNonceData dpnf-id false 1)))`. Every DPNF in
;;     this suite (DHB / DHN / KBN) carries `{}` on nonce 1, so NO trait key is valid on any of them.
;;     The one collection with real metadata is TNF, from `[6.2.15]`, carrying {"rarity": "golden"}.
;;     A trait definition is therefore only possible with key "rarity".
;;  2] TNF had no score at all, so one is issued here. Precision must be in [3, 24].
;;score issuance is STOA-priced, so the gas-station key must sign the four coin.TRANSFER legs --
;;the same block [6.2.9] and the grand tour use. Without it the issue aborts on
;;"Managed capability not installed", which is a funding signal, not a logic failure.
;;==== AQP-F11 — SCORE: the NF score-definition WRITE path, which nothing had ever run · 01 · env-sigs (caps) ==== 
(print "--- [AQP-F11 — SCORE: the NF score-definition WRITE path, which nothing had ever run · 01 · env-sigs (caps)] ---")
(env-sigs
  [ { "key": "PK_AncientHodler", "caps": [] }
    { "key": "6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263"
    , "caps":
      [ (coin.TRANSFER "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263" "k:50d6c59b21e5e6e55baecaa75a1007de37576bde12d8230dc82459cc01b9484b" 1000000.0)
        (coin.TRANSFER "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263" "k:0cb30c0121ff919266121a99ff9359871818932211df94dae4137c29bc0e8f7e" 1000000.0)
        (coin.TRANSFER "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263" "c:XM-pkmuB5XUQlp87ZYSbfKt8qzmHY6O2EHAzMRVBt3k" 1000000.0)
        (coin.TRANSFER "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263" "c:iQQFWj6gWtpGEzhM_O5ekW1QtnQQy55R8BRPGhj_0FU" 1000000.0) ] } ])
;;==== AQP-F11 — SCORE: the NF score-definition WRITE path, which nothing had ever run · 02 · let / invocation ==== 
(print "--- [AQP-F11 — SCORE: the NF score-definition WRITE path, which nothing had ever run · 02 · let / invocation] ---")
(let
    (
        (ref-U|DALOS:module{UtilityDalosV2} U|DALOS)
        (ref-DPDC:module{DpdcV2} DPDC)
        (ref-SCR:module{AcquisitionScoresV1} AQP-SCORE)
        (ref-TS02-C3:module{TalosStageTwo_ClientThreeV1} TS02-C3)
        (tnf:string "TNF-98c486052a51")
    )
    (map print
        [
            ;;the premise the whole block rests on: TNF is the only collection here whose nonce-1
            ;;metadata declares a trait key, and that key is "rarity"
            (expect "<<AQP-F11>> TNF declares a 'rarity' trait key; DHB declares none"
                [true false]
                [(contains "rarity" (ref-DPDC::UR_N|RawMetaData (ref-DPDC::UR_NativeNonceData tnf false 1)))
                 (contains "rarity" (ref-DPDC::UR_N|RawMetaData (ref-DPDC::UR_NativeNonceData "DHB-98c486052a51" false 1)))])
        ]
    )
    ;;--- issue a class-4 score on TNF, then both definition kinds against it
    (print (format "<(AQP-SCR|C_IssueNonFungibleScore TnfTraitScore)> => \"{}\""
        [(ref-TS02-C3::AQP-SCR|C_IssueNonFungibleScore KST.ANHD KST.ANHD "TnfTraitScore" 6 0)]))
    (let
        (
            (nf-score:string (ref-U|DALOS::UDC_Makeid "TnfTraitScore"))
        )
        (print (format "<(AQP-SCR|C_IssueNonFungibleScoreDefinition trait)> => \"{}\""
            [(ref-TS02-C3::AQP-SCR|C_IssueNonFungibleScoreDefinition
                KST.ANHD nf-score tnf ["rarity"] ["golden"] [25.0])]))
        (print (format "<(AQP-SCR|C_IssueNonFungibleSetScoreDefinition class)> => \"{}\""
            ;;the nonce-class must satisfy `(<= nc (UR_SetClassesUsed dpnf false))`. TNF has no set
            ;;classes beyond the implicit 0, so class 0 is the only admissible one here -- which is
            ;;itself the boundary the validator is enforcing.
            [(ref-TS02-C3::AQP-SCR|C_IssueNonFungibleSetScoreDefinition
                KST.ANHD nf-score tnf [0] [7.0])]))
        (map print
            [
                (expect "<<AQP-F11>> the issued score is class 4 (DPNF), as the definition path requires"
                    4 (ref-SCR::UR_SCR|ScoreClass nf-score))
                ;;TRAIT definitions: the key is (score, dpnf, trait-key, trait-value) -- four
                ;;components, three of them strings, so the same transposition hazard as the tracker
                ;;families. Every per-field reader checked against the key it was looked up by.
                (expect "<<AQP-F11>> the TRAIT definition row round-trips its key and carries its value"
                    [nf-score tnf "rarity" "golden" 25.0]
                    [(ref-SCR::UR_N-DEF|NFTraitScoreScoreId nf-score tnf "rarity" "golden")
                     (ref-SCR::UR_N-DEF|NFTraitScoreDpnfId nf-score tnf "rarity" "golden")
                     (ref-SCR::UR_N-DEF|NFTraitScoreTraitKey nf-score tnf "rarity" "golden")
                     (ref-SCR::UR_N-DEF|NFTraitScoreTraitValue nf-score tnf "rarity" "golden")
                     (ref-SCR::UR_N-DEF|NFTraitScoreTraitScoreValue nf-score tnf "rarity" "golden")])
                ;;the full-row reader agrees with the per-field ones
                (expect "<<AQP-F11>> the full trait row agrees with its per-field readers"
                    25.0 (at "trait-score-value" (ref-SCR::UR_N-DEF|NFTraitScore nf-score tnf "rarity" "golden")))
                ;;CLASS definitions: same shape, keyed on an INTEGER nonce-class
                (expect "<<AQP-F11>> the CLASS definition row round-trips its key and carries its value"
                    [nf-score tnf 0 7.0]
                    [(ref-SCR::UR_N-DEF|NFClassScoreScoreId nf-score tnf 0)
                     (ref-SCR::UR_N-DEF|NFClassScoreDpnfId nf-score tnf 0)
                     (ref-SCR::UR_N-DEF|NFClassScoreNonceClass nf-score tnf 0)
                     (ref-SCR::UR_N-DEF|NFClassScoreTraitScoreValue nf-score tnf 0)])
                ;;note the column is `trait-score-value` in BOTH tables -- the class table reuses the
                ;;trait table's column name, which is why the per-field reader is also spelled
                ;;`NFClassScoreTraitScoreValue`. Worth pinning so the naming is not mistaken for a bug.
                (expect "<<AQP-F11>> the full class row agrees with its per-field readers"
                    7.0 (at "trait-score-value" (ref-SCR::UR_N-DEF|NFClassScore nf-score tnf 0)))
                ;;THE BOUND the validator enforces, driven: a class ABOVE the collection's
                ;;set-classes-used is refused. This is the assertion that shows class 0 was not an
                ;;arbitrary choice but the only admissible one on this collection.
                (expect-failure "<<AQP-F11>> a nonce-class above the collection's set-classes-used is refused"
                    "Invalid DPNF set score definition"
                    (ref-TS02-C3::AQP-SCR|C_IssueNonFungibleSetScoreDefinition
                        KST.ANHD nf-score tnf [99] [7.0]))
                ;;the REVISION counter -- consumers re-read when it moves, so it must exist and have
                ;;advanced past its initial value after the two issues above
                (expect "<<AQP-F11>> the NF revision row exists and round-trips its key"
                    [nf-score tnf]
                    [(ref-SCR::UR_N-DEF-REV|NFDefRevisionScoreId nf-score tnf)
                     (ref-SCR::UR_N-DEF-REV|NFDefRevisionDpnfId nf-score tnf)])
                ;;THE THREE REVISION COUNTERS, and their documented independence is the real claim:
                ;;   "global-revision-nonce bumps on any trait OR class definition change;
                ;;    trait-revision-nonce ONLY on TraitScore change;
                ;;    class-revision-nonce ONLY on ClassScore change."
                ;;This block issued exactly ONE trait definition and ONE class definition, so the
                ;;three counters must read 2 / 1 / 1. A single shared counter, or a bump wired to the
                ;;wrong table, shows up here and nowhere else -- consumers use these to decide whether
                ;;to re-read, so a counter that fails to move serves stale scores silently.
                (expect "<<AQP-F11>> one trait def + one class def move the three counters to 2 / 1 / 1"
                    [2 1 1]
                    (let ((r (ref-SCR::UR_N-DEF-REV|NFDefRevision nf-score tnf)))
                        [(at "global-revision-nonce" r)
                         (at "trait-revision-nonce" r)
                         (at "class-revision-nonce" r)]))
            ]
        )
    )
    ""
)
(env-sigs [])
;;the score and its definitions are discarded -- this suite leaves as it arrived
(rollback-tx)

