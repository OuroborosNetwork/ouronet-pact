(begin-tx "AQP-F8 — VCT: the batch cost estimators, against their own documented decomposition")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
;;==== AQP-F8 — VCT: the batch cost estimators, against their own documented decomposition · 01 · namespace ==== 
(print "--- [AQP-F8 — VCT: the batch cost estimators, against their own documented decomposition · 01 · namespace] ---")
(namespace "ouronet-ns")
(print "--- [AQP-F8 · 01 · FullVacate is the sum of the per-lane batch readers] ---")
;;FUNCTION COVERAGE (G6, Tier 1: VCT). The `URCi_Batch*` / `URCi_FullVacate` family are IFP MIRRORS:
;;each is documented as tracking its exec twin "byte-for-byte", and they feed the cost a client is
;;quoted before signing a vacate. None had ever been called. A mirror that drifts from its twin
;;quotes a price the chain will not honour -- and vacate is the most expensive op in the module.
;;
;;TWO STRUCTURAL CLAIMS ARE ASSERTABLE WITHOUT KNOWING THE PRICES, which is what makes this cheap:
;;
;;  1] COMPOSITION. `URCi_FullVacate` is "Σ over lanes of the per-asset vacate recipe. Reuses the
;;     three per-batch vacate readers." So a FullVacate over exactly one TF lane and no others must
;;     equal `URCi_BatchVacateTrueFungible` on that lane's legs -- exactly, not approximately.
;;  2] DRAIN IS SCORE-FREE. The drain doc says so outright: "NO score-delta (drain leaves the score
;;     live for finalize)", against vacate which includes it. So for the SAME legs, vacate must cost
;;     strictly MORE than drain, and the gap is the score-delta term -- which is separately readable
;;     as `RPS::URC_StakeScoreDeltaSum`.
;;
;;Both are differentials between functions, so neither depends on a hardcoded price that would rot
;;the next time the IGNIS tiers move.
;;==== AQP-F8 — VCT: the batch cost estimators, against their own documented decomposition · 02 · let / invocation ==== 
(print "--- [AQP-F8 — VCT: the batch cost estimators, against their own documented decomposition · 02 · let / invocation] ---")
(let
    (
        (ref-U|DALOS:module{UtilityDalosV2} U|DALOS)
        (ref-VCT:module{AcquisitionVacateV1} AQP-VCT)
        (ref-RPS:module{AcquisitionRewardPerShareV1} RPS)
        (ouro:string "OURO-98c486052a51")
    )
    (let
        (
            (pool:string (ref-U|DALOS::UDC_Makeid "DrainVacPool"))
            ;;one real leg, built through the module's own constructor rather than a hand-written
            ;;object, so the test cannot drift from the schema
            ;;untyped on purpose: VCT|VacateTfLeg is a MODULE schema, not an interface member, so
            ;;`object{AcquisitionVacateV1.VCT|VacateTfLeg}` does not resolve through a modref. Built
            ;;via the module's own constructor rather than a literal so the shape cannot drift.
            (legs (ref-VCT::UC_TfLegsFromParallelArrays [KST.ANHD] [KST.ANHD] [20.0]))
        )
        (map print
            [
                ;;the estimator prices a real batch above zero -- non-vacuity for everything below
                (expect "<<AQP-F8>> a one-leg TF vacate batch is priced above zero"
                    true (> (ref-VCT::URCi_BatchVacateTrueFungible pool ouro legs) 0.0))
                ;;CLAIM 1 — composition. One TF lane, no OF lanes, no collectable lanes.
                (expect "<<AQP-F8>> FullVacate over ONE TF lane equals the TF batch reader exactly"
                    (ref-VCT::URCi_BatchVacateTrueFungible pool ouro legs)
                    (ref-VCT::URCi_FullVacate pool [{"asset-id": ouro, "legs": legs}] [] [] true))
                ;;...and it is ADDITIVE: the same lane twice costs exactly twice. This is what
                ;;distinguishes a genuine Σ from a function that merely returns the first lane.
                (expect "<<AQP-F8>> ...and two identical lanes cost exactly twice one"
                    (* 2.0 (ref-VCT::URCi_BatchVacateTrueFungible pool ouro legs))
                    (ref-VCT::URCi_FullVacate pool
                        [{"asset-id": ouro, "legs": legs} {"asset-id": ouro, "legs": legs}] [] [] true))
                ;;...and an EMPTY lane plan costs nothing -- the Σ's identity element
                (expect "<<AQP-F8>> ...while a plan with no lanes at all costs zero"
                    0.0 (ref-VCT::URCi_FullVacate pool [] [] [] true))
                ;;CLAIM 2 — drain is score-free, so it is strictly cheaper than vacate for the same legs
                (expect "<<AQP-F8>> DRAIN is strictly cheaper than VACATE for the same legs"
                    true (< (ref-VCT::URCi_BatchDrainTrueFungible pool ouro legs)
                            (ref-VCT::URCi_BatchVacateTrueFungible pool ouro legs)))
                ;;...and the pool's score-delta -- the term the drain doc says it omits -- is itself
                ;;non-zero, so "strictly cheaper" is attributable to that omission rather than to
                ;;some unrelated difference.
                (expect "<<AQP-F8>> ...and the score-delta term it omits is itself non-zero"
                    true (> (ref-RPS::URC_StakeScoreDeltaSum pool) 0.0))
                ;;drain is still priced above zero -- it does real work, it just skips the score leg
                (expect "<<AQP-F8>> ...and drain is not free either"
                    true (> (ref-VCT::URCi_BatchDrainTrueFungible pool ouro legs) 0.0))
            ]
        )
    )
    ""
)
(commit-tx)

;;|| NEXT >
