(begin-tx "AQP-G3 — SCORE's NF-definition branch selector, as a 2x2 on its two list arguments")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
;;==== AQP-G3 — SCORE's NF-definition branch selector, as a 2x2 on its two list arguments · 01 · namespace ==== 
(print "--- [AQP-G3 — SCORE's NF-definition branch selector, as a 2x2 on its two list arguments · 01 · namespace] ---")
(namespace "ouronet-ns")
(print "--- [AQP-G3 · 01 · trait-xor-set branch] ---")
;;P3.3. UEV_IzNonFungibleScoreDefinitionTraitBranch enforces that EXACTLY ONE of two definition
;;modes is selected -- trait-keys (trait mode) xor dpnf-nonce-classes (set mode) -- and returns
;;which one. Both arguments are lists and nothing is read, so the whole truth table is reachable
;;with no fixture at all: it is the cheapest guard shape there is.
;;
;;All FOUR cells are asserted. The two rejections alone would be satisfied by a guard that always
;;threw; the two acceptances alone by one that never did. Only the pair proves the XOR, and the
;;RETURN VALUE is checked too, because the function's job is not just to reject -- it tells the
;;caller which branch was chosen, and a guard that accepted correctly while mis-reporting the
;;branch would pass every rejection test written.
;;==== AQP-G3 — SCORE's NF-definition branch selector, as a 2x2 on its two list arguments · 02 · let / invocation ==== 
(print "--- [AQP-G3 — SCORE's NF-definition branch selector, as a 2x2 on its two list arguments · 02 · let / invocation] ---")
(let
    (
        (ref-SCR:module{AcquisitionScoresV1} AQP-SCORE)
    )
    (map print
        [
            ;;--- accepted: exactly one mode selected, and the reported branch must match
            (expect "<<AQP-G3>> trait mode selected -> reports TRUE"
                true (ref-SCR::UEV_IzNonFungibleScoreDefinitionTraitBranch ["rarity"] []))
            (expect "<<AQP-G3>> set mode selected -> reports FALSE"
                false (ref-SCR::UEV_IzNonFungibleScoreDefinitionTraitBranch [] [1]))
            ;;--- rejected: neither mode
            (expect-failure "<<AQP-G3>> neither branch selected is refused"
                "requires exactly one branch"
                (ref-SCR::UEV_IzNonFungibleScoreDefinitionTraitBranch [] []))
            ;;--- rejected: both modes
            (expect-failure "<<AQP-G3>> both branches selected is refused"
                "requires exactly one branch"
                (ref-SCR::UEV_IzNonFungibleScoreDefinitionTraitBranch ["rarity"] [1]))
        ]
    )
    ""
)
(commit-tx)

;;|| NEXT >
