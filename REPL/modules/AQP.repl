(begin-tx "AQP-F14 — VCT: the vacate leg validators, on both sides of every bound they state")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
;;==== AQP-F14 — VCT: the vacate leg validators, on both sides of every bound they state · 01 · namespace ==== 
(print "--- [AQP-F14 — VCT: the vacate leg validators, on both sides of every bound they state · 01 · namespace] ---")
(namespace "ouronet-ns")
(print "--- [AQP-F14 · 01 · vacate is ALL-OR-NOTHING per leg] ---")
;;FUNCTION COVERAGE (G6, Tier 1: VCT). These predicates gate every vacate batch and none had ever
;;been called. Each states a BOUND in its @doc, so each is tested on both sides of it -- a predicate
;;checked only where it returns true is indistinguishable from one that always does.
;;
;;THE RULE WORTH KNOWING is `URC_VacateTfLegBalancesOk`: "amount must equal full DPTFTracker row
;;(NO PARTIAL VACATE)". It is not a lower bound, it is an EQUALITY -- a vacate leg must take the
;;whole staked balance or nothing. Under-vacating and over-vacating are both refused, and only a
;;three-point test (under / exact / over) shows that; a `>=` bound would pass the first two.
;;==== AQP-F14 — VCT: the vacate leg validators, on both sides of every bound they state · 02 · let / invocation ==== 
(print "--- [AQP-F14 — VCT: the vacate leg validators, on both sides of every bound they state · 02 · let / invocation] ---")
(let
    (
        (ref-U|DALOS:module{UtilityDalosV2} U|DALOS)
        (ref-VCT:module{AcquisitionVacateV1} AQP-VCT)
        (ref-AQP:module{AcquisitionPoolsV1} AQP-POOL)
        (ouro:string "OURO-98c486052a51")
    )
    (let
        (
            (pool:string (ref-U|DALOS::UDC_Makeid "DrainVacPool"))
        )
        (let
            (
                (staked:decimal (ref-AQP::UR_AQP|DPTFTrackerBalance pool ouro KST.ANHD KST.ANHD))
            )
            (map print
                [
                    ;;premise: a real staked leg, read live rather than assumed
                    (expect "<<AQP-F14>> ANHD's DrainVacPool leg really is staked at 20.0"
                        20.0 staked)
                    ;;THE EQUALITY, from all three sides
                    (expect "<<AQP-F14>> the EXACT staked balance is accepted"
                        true (ref-VCT::URC_VacateTfLegBalancesOk pool ouro KST.ANHD KST.ANHD staked))
                    (expect "<<AQP-F14>> ...a PARTIAL vacate is refused -- there is no partial vacate"
                        false (ref-VCT::URC_VacateTfLegBalancesOk pool ouro KST.ANHD KST.ANHD (- staked 1.0)))
                    (expect "<<AQP-F14>> ...and so is vacating MORE than is staked"
                        false (ref-VCT::URC_VacateTfLegBalancesOk pool ouro KST.ANHD KST.ANHD (+ staked 1.0)))
                    ;;the positivity half of the same predicate
                    (expect "<<AQP-F14>> ...and a zero amount is refused even on a leg with nothing staked"
                        false (ref-VCT::URC_VacateTfLegBalancesOk pool ouro "ghost" "ghost" 0.0))
                ]
            )
        )
    )
    ""
)
(print "--- [AQP-F14 · 02 · the batch-size bounds, at the boundary] ---")
;;`URC_VacateBatchNonceTotalOk` -- "total nonce count across legs is positive and <= VACATE-MAX-NONCES"
;;(64). `URC_VacateTfLegsOk` -- "positive leg count <= VACATE-FULL-MAX-LEGS" (128). Both are tested AT
;;the boundary and one past it, because an off-by-one in a `<=`/`<` is invisible anywhere else.
(let
    (
        (ref-U|DALOS:module{UtilityDalosV2} U|DALOS)
        (ref-VCT:module{AcquisitionVacateV1} AQP-VCT)
        (ouro:string "OURO-98c486052a51")
    )
    (let
        (
            (pool:string (ref-U|DALOS::UDC_Makeid "DrainVacPool"))
        )
        (map print
            [
                ;;the nonce-total bound: 64 is IN, 65 is OUT, and the count is a SUM across rows --
                ;;so the boundary is exercised as two rows that add to the limit, not one row of 64.
                (expect "<<AQP-F14>> a nonce total of exactly 64 across two rows is admitted"
                    true (ref-VCT::URC_VacateBatchNonceTotalOk
                             [(enumerate 1 32) (enumerate 33 64)]))
                (expect "<<AQP-F14>> ...and 65 is refused"
                    false (ref-VCT::URC_VacateBatchNonceTotalOk
                             [(enumerate 1 32) (enumerate 33 65)]))
                ;;...and the positive half: an empty batch, and a batch of empty rows, both refused
                (expect "<<AQP-F14>> ...as is an empty batch, and a batch of empty rows"
                    [false false]
                    [(ref-VCT::URC_VacateBatchNonceTotalOk [])
                     (ref-VCT::URC_VacateBatchNonceTotalOk [[] []])])
                ;;the leg-count bound, using legs built by the module's own constructor. 128 legs is
                ;;admitted on COUNT (each leg then fails its balance check, which is a different
                ;;conjunct); 129 is refused on count alone.
                (expect "<<AQP-F14>> a 129-leg batch is refused on leg COUNT"
                    false (ref-VCT::URC_VacateTfLegsOk pool ouro
                              (ref-VCT::UC_TfLegsFromParallelArrays
                                  (make-list 129 KST.ANHD) (make-list 129 KST.ANHD) (make-list 129 20.0))))
                ;;...and an EMPTY leg list too, which is the other end of the same bound -- and which
                ;;only answers at all because the leg builder was made total (<<AQP-F6>>)
                (expect "<<AQP-F14>> ...and so is an empty one, at the other end of the bound"
                    false (ref-VCT::URC_VacateTfLegsOk pool ouro []))
            ]
        )
    )
    ""
)
(print "--- [AQP-F14 · 03 · the vacate-kind dispatch, including its unknown-kind default] ---")
;;`URC_VacateKindAssetOk` dispatches per kind and its @doc ends "unknown kind returns false". A
;;dispatch chain whose final `else` is the reject branch is exactly where a new kind gets silently
;;accepted, so the unknown case is pinned alongside the four real ones.
(let
    (
        (ref-U|DALOS:module{UtilityDalosV2} U|DALOS)
        (ref-VCT:module{AcquisitionVacateV1} AQP-VCT)
        (ouro:string "OURO-98c486052a51")
        (dhcd:string "DHCD-98c486052a51")
    )
    (let
        (
            (tf-pool:string (ref-U|DALOS::UDC_Makeid "DrainVacPool"))
            (sf-pool:string (ref-U|DALOS::UDC_Makeid "SfStakePool"))
        )
        (map print
            [
                ;;each pool admits its OWN kind
                (expect "<<AQP-F14>> a TF pool admits the TF kind; a collectable pool admits DPSF"
                    [true true]
                    [(ref-VCT::URC_VacateKindAssetOk tf-pool ouro 1)
                     (ref-VCT::URC_VacateKindAssetOk sf-pool dhcd 3)])
                ;;...and refuses the other's
                (expect "<<AQP-F14>> ...and each refuses the other's kind"
                    [false false]
                    [(ref-VCT::URC_VacateKindAssetOk tf-pool ouro 3)
                     (ref-VCT::URC_VacateKindAssetOk sf-pool dhcd 1)])
                ;;THE DEFAULT BRANCH: a kind outside 1..4 must be refused, not fall through to the
                ;;last real branch. Both a too-high kind and a negative one.
                (expect "<<AQP-F14>> an UNKNOWN vacate kind is refused, not defaulted into the last branch"
                    [false false]
                    [(ref-VCT::URC_VacateKindAssetOk tf-pool ouro 99)
                     (ref-VCT::URC_VacateKindAssetOk tf-pool ouro -1)])
                ;;...and a mismatched ASSET is refused even for the right kind
                (expect "<<AQP-F14>> ...and the right kind with the WRONG asset is refused too"
                    false (ref-VCT::URC_VacateKindAssetOk tf-pool dhcd 1))
            ]
        )
    )
    ""
)
(commit-tx)

