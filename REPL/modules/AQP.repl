(begin-tx "AQP-F13 — RPS: the multiplet LADDER, and the two stake-flow previews' documented asymmetry")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
;;==== AQP-F13 — RPS: the multiplet LADDER, and the two stake-flow previews' documented asymmetry · 01 · namespace ==== 
(print "--- [AQP-F13 — RPS: the multiplet LADDER, and the two stake-flow previews' documented asymmetry · 01 · namespace] ---")
(namespace "ouronet-ns")
(print "--- [AQP-F13 · 01 · the multiplet family is a ladder, and its id encodes its own rungs] ---")
;;FUNCTION COVERAGE (G6, Tier 1: RPS). The `UR_FVT-MF|*` readers describe a MULTIPLET FAMILY -- the
;;chain-wide OURO -> Auryn -> Elite-Auryn autostake ladder that a MULTIPLET_BASE reward routes
;;through. None had ever been called.
;;
;;THE ROW IS SELF-DESCRIBING, and that is what makes a sharp test possible without hardcoding much:
;;the family id is literally `F|token0|token1|token2`, so the three token readers must agree with the
;;id they were looked up by. And the two `ats-*` fields name the autostake pair joining consecutive
;;rungs -- so the pair at rung i->i+1 must be the one whose REWARD TOKEN is token-i. That is a
;;cross-module consistency check (RPS row vs ATS registry) that nothing else in the suite makes.
;;==== AQP-F13 — RPS: the multiplet LADDER, and the two stake-flow previews' documented asymmetry · 02 · let / invocation ==== 
(print "--- [AQP-F13 — RPS: the multiplet LADDER, and the two stake-flow previews' documented asymmetry · 02 · let / invocation] ---")
(let
    (
        (ref-RPS:module{AcquisitionRewardPerShareV1} RPS)
        (ref-ATS:module{AutostakeV3} ATS)
        (ref-DALOS:module{OuronetDalosV2} DALOS)
    )
    (let
        (
            (ouro:string (ref-DALOS::UR_OuroborosID))
            (auryn:string (ref-DALOS::UR_AurynID))
            (elite:string (ref-DALOS::UR_EliteAurynID))
        )
        (let
            (
                (fam:string (concat ["F" "|" ouro "|" auryn "|" elite]))
            )
            (map print
                [
                    ;;the id round-trips, and the three rung tokens match the id's own components
                    (expect "<<AQP-F13>> the family id round-trips and its three rungs match the id itself"
                        [fam ouro auryn elite]
                        [(ref-RPS::UR_FVT-MF|MultipletFamilyId fam)
                         (ref-RPS::UR_FVT-MF|Token0Id fam)
                         (ref-RPS::UR_FVT-MF|Token1Id fam)
                         (ref-RPS::UR_FVT-MF|Token2Id fam)])
                    ;;rank is the rung count, not an arbitrary label
                    (expect "<<AQP-F13>> the rank is 3 -- one per rung"
                        3 (ref-RPS::UR_FVT-MF|Rank fam))
                    ;;THE LADDER INVARIANT, checked against the ATS registry rather than restated:
                    ;;the pair joining rung 0->1 must be the autostake pair whose reward token IS
                    ;;token-0, and likewise 1->2 with token-1. A family wired to the wrong pair would
                    ;;route MULTIPLET rewards through the wrong index and nothing else would notice.
                    (expect "<<AQP-F13>> the 0->1 pair's reward token is rung 0, and the 1->2 pair's is rung 1"
                        [[ouro] [auryn]]
                        [(ref-ATS::UR_RewardTokenList (ref-RPS::UR_FVT-MF|Ats01Id fam))
                         (ref-ATS::UR_RewardTokenList (ref-RPS::UR_FVT-MF|Ats12Id fam))])
                    ;;the full-row reader agrees with the per-field ones
                    (expect "<<AQP-F13>> the full family row agrees with its per-field readers"
                        [3 true]
                        (let ((r (ref-RPS::UR_FVT-MF|MultipletFamily fam)))
                            [(at "rank" r) (at "active" r)]))
                    ;;the lane segmentation flag, on a lane that is not segmented
                    (expect "<<AQP-F13>> the TfStakeVault OURO lane is not segmented"
                        false (ref-RPS::UR_FVT-RG|Segmentation
                                  (U|DALOS.UDC_Makeid "TfStakeVault") ouro))
                ]
            )
        )
    )
    ""
)
(print "--- [AQP-F13 · 02 · orto is direction-INdependent, collectable is direction-dependent] ---")
;;The two remaining stake-flow cost previews, and their @docs disagree with each other ON PURPOSE:
;;
;;   URCi_OrtoFungibleStakeFlow   -- "transfer(DPOF, direction-INDEPENDENT)"
;;   URCi_CollectableStakeFlow    -- "transfer(DPDC-T, direction-dependent)"
;;
;;So the SAME differential that was uninformative for the true-fungible flow (<<AQP-F2>>, where the
;;transfer classification happened to be symmetric) is the decisive test here: orto must price both
;;directions alike, collectable must not. Asserting them together is what makes each meaningful --
;;either one alone could be explained by the flag being ignored.
(let
    (
        (ref-U|DALOS:module{UtilityDalosV2} U|DALOS)
        (ref-RPS:module{AcquisitionRewardPerShareV1} RPS)
        (mvst:string "MVST-98c486052a51")
        (dhcd:string "DHCD-98c486052a51")
    )
    (let
        (
            (of-pool:string (ref-U|DALOS::UDC_Makeid "OfStakePool"))
            (sf-pool:string (ref-U|DALOS::UDC_Makeid "SfStakePool"))
        )
        (map print
            [
                ;;both quote something -- non-vacuity before any comparison
                (expect "<<AQP-F13>> both flows quote a positive price"
                    [true true]
                    [(> (ref-RPS::URCi_OrtoFungibleStakeFlow of-pool KST.ANHD KST.ANHD mvst [1] true) 0.0)
                     (> (ref-RPS::URCi_CollectableStakeFlow sf-pool KST.ANHD KST.ANHD dhcd true [1] [1] true) 0.0)])
                ;;ORTO: direction-INDEPENDENT, exactly as documented
                (expect "<<AQP-F13>> the ORTO flow prices both directions identically, as its @doc says"
                    (ref-RPS::URCi_OrtoFungibleStakeFlow of-pool KST.ANHD KST.ANHD mvst [1] true)
                    (ref-RPS::URCi_OrtoFungibleStakeFlow of-pool KST.ANHD KST.ANHD mvst [1] false))
                ;;COLLECTABLE: its @doc says "direction-dependent", and I first asserted the two
                ;;directions would therefore DIFFER. They do not, and the distinction between the two
                ;;flows is sharper than "dependent vs independent" -- it is STRUCTURAL vs INCIDENTAL:
                ;;
                ;;   ORTO        `DPOF.URCi_MoveCumulator dpof-id nonces false`
                ;;               -- takes NO sender/receiver at all. Direction cannot reach the
                ;;                  transfer leg, so the equality above holds for EVERY input.
                ;;   COLLECTABLE `DPDC-T.URCi_MultiTransferCumulator [id] [son] sender receiver …`
                ;;               -- DOES take them, and `direction` swaps which is which. So the price
                ;;                  CAN differ; it simply does not for a self-stake against the vault,
                ;;                  where the transfer classification is symmetric.
                ;;
                ;;Asserting the equality alone would not distinguish that from a dropped flag, so the
                ;;symmetry of the underlying cumulator is pinned too -- that is what explains it.
                (expect "<<AQP-F13>> ...and the COLLECTABLE flow happens to match here, for a symmetric transfer"
                    (ref-RPS::URCi_CollectableStakeFlow sf-pool KST.ANHD KST.ANHD dhcd true [1] [1] true)
                    (ref-RPS::URCi_CollectableStakeFlow sf-pool KST.ANHD KST.ANHD dhcd true [1] [1] false))
                ;;THE REASON, and it is finer than "the cumulators are equal" -- they are NOT. Swapping
                ;;sender and receiver produces cumulators with DIFFERENT `interactor` fields (BAR one
                ;;way, the vault account the other) but the SAME `ignis` figure. `URCi_CollectableStakeFlow`
                ;;consumes only the IFP via `OI|UC_IfpFromOutputCumulator`, so the interactor
                ;;difference never reaches the price. Asserted on the IFP -- the thing the flow
                ;;actually reads -- rather than on the whole object, which would fail for a reason
                ;;that has nothing to do with cost.
                (expect "<<AQP-F13>> ...which is the reason: the transfer IFP is symmetric, even though the cumulators differ"
                    (IGNIS.OI|UC_IfpFromOutputCumulator
                        (DPDC-T.URCi_MultiTransferCumulator [dhcd] [true] KST.ANHD AQP-POOL.AQP|SC_NAME [[1]] [[1]]))
                    (IGNIS.OI|UC_IfpFromOutputCumulator
                        (DPDC-T.URCi_MultiTransferCumulator [dhcd] [true] AQP-POOL.AQP|SC_NAME KST.ANHD [[1]] [[1]])))
                ;;...and the cumulators really do differ in their interactor, so the line above is a
                ;;statement about COST specifically and not a restatement of "these are the same call"
                (expect "<<AQP-F13>> ...while the cumulators themselves differ, in the interactor"
                    false
                    (= (DPDC-T.URCi_MultiTransferCumulator [dhcd] [true] KST.ANHD AQP-POOL.AQP|SC_NAME [[1]] [[1]])
                       (DPDC-T.URCi_MultiTransferCumulator [dhcd] [true] AQP-POOL.AQP|SC_NAME KST.ANHD [[1]] [[1]])))
                ;;both scale with the NONCE COUNT -- "tracker(medium x |nonces|)" -- so two nonces
                ;;cost strictly more than one. A preview that priced per-CALL would be flat here.
                (expect "<<AQP-F13>> both flows scale with the nonce count, not per call"
                    [true true]
                    [(> (ref-RPS::URCi_OrtoFungibleStakeFlow of-pool KST.ANHD KST.ANHD mvst [1 2] true)
                        (ref-RPS::URCi_OrtoFungibleStakeFlow of-pool KST.ANHD KST.ANHD mvst [1] true))
                     (> (ref-RPS::URCi_CollectableStakeFlow sf-pool KST.ANHD KST.ANHD dhcd true [1 2] [1 1] true)
                        (ref-RPS::URCi_CollectableStakeFlow sf-pool KST.ANHD KST.ANHD dhcd true [1] [1] true))])
                ;;...and the orto increment DECOMPOSES exactly. My first attempt asserted it was one
                ;;medium tier -- the @doc's "tracker(medium x |nonces|)" -- and got 4.0 against a
                ;;medium of 3.0. The @doc is not wrong, it is partial: TWO legs scale with the nonce
                ;;list, because the transfer leg is `DPOF.URCi_MoveCumulator dpof-id NONCES false` and
                ;;takes the list too. So the per-nonce increment is the tracker medium PLUS the
                ;;transfer cumulator's own per-nonce cost, and asserting the sum pins both.
                (expect "<<AQP-F13>> ...and the orto increment is the tracker medium PLUS the transfer leg's own per-nonce cost"
                    (+ (ref-RPS::URC_TierMedium)
                       (- (IGNIS.OI|UC_IfpFromOutputCumulator (DPOF.URCi_MoveCumulator mvst [1 2] false))
                          (IGNIS.OI|UC_IfpFromOutputCumulator (DPOF.URCi_MoveCumulator mvst [1] false))))
                    (- (ref-RPS::URCi_OrtoFungibleStakeFlow of-pool KST.ANHD KST.ANHD mvst [1 2] true)
                       (ref-RPS::URCi_OrtoFungibleStakeFlow of-pool KST.ANHD KST.ANHD mvst [1] true)))
                ;;...and BOTH components are non-zero, so the sum above is not one term in disguise
                (expect "<<AQP-F13>> ...and both of those components are genuinely non-zero"
                    [true true]
                    [(> (ref-RPS::URC_TierMedium) 0.0)
                     (> (- (IGNIS.OI|UC_IfpFromOutputCumulator (DPOF.URCi_MoveCumulator mvst [1 2] false))
                           (IGNIS.OI|UC_IfpFromOutputCumulator (DPOF.URCi_MoveCumulator mvst [1] false))) 0.0)])
            ]
        )
    )
    ""
)
(commit-tx)

