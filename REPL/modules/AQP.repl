(begin-tx "AQP-G40 — the COLLECTABLE leg guard (the sibling of AQP-G10's true-fungible one)")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(namespace "ouronet-ns")
(print "--- [AQP-G40 · 01 · collectable canonical-asset leg check] ---")
;;`05_FVT.pact:1186` — "Invalid collectable-id: leg does not match pool canonical asset". AQP-G9
;;already drives the collectable flow, but it hands SfStakePool its OWN asset (DHCD) and therefore
;;sails past this enforce on the way to the arity check below it. The guard itself was never fired.
;;
;;It sits THIRD, behind stake-admission and the son/class check, so the input has to clear both:
;;SfStakePool with son=true does. The leg offered is MVST — a REAL ortofungible held by this suite,
;;not a ghost id. A ghost would fail here too but would prove less, since it would also fail every
;;existence check downstream and the rejection would not be attributable to the leg rule.
;;==== AQP-G40 — the COLLECTABLE leg guard (the sibling of AQP-G10's true-fungible one) · 01 · env-sigs (caps) ==== 
(print "--- [AQP-G40 — the COLLECTABLE leg guard (the sibling of AQP-G10's true-fungible one) · 01 · env-sigs (caps)] ---")
(env-sigs [{ "key": "PK_AncientHodler", "caps": [] }])
(let*
    (
        (ref-U|DALOS:module{UtilityDalosV2} U|DALOS)
        (ref-AQP:module{AcquisitionPoolsV1} AQP-POOL)
        (sf:string (ref-U|DALOS::UDC_Makeid "SfStakePool"))
    )
    (map print
        [
            (expect "<<AQP-G40>> SfStakePool clears the two gates that front the leg check"
                [true true]
                [(ref-AQP::URC_PoolStakeAdmissionOk sf)
                 (ref-AQP::URC_StakeCollectablePoolClassOk sf true)])
            (expect "<<AQP-G40>> ...and its canonical asset is DHCD, not MVST"
                "DHCD-98c486052a51" (ref-AQP::UR_AQP|PoolAssetId sf))
            (expect-failure "<<AQP-G40>> a real collectable that is NOT the pool's asset is refused"
                "Invalid collectable-id: leg does not match pool canonical asset"
                (test-capability (AQP-FVT.FVT|C>COLLECTABLE-STAKE-FLOW
                    sf KST.ANHD KST.ANHD "MVST-98c486052a51" true [1] [1] true)))
        ]
    )
    ""
)
(commit-tx)

