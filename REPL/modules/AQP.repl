(begin-tx "AQP-G46 - UEV_AddScoreEntityTripletContext: three of its five enforces")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(namespace "ouronet-ns")
;;==== AQP-G46 - UEV_AddScoreEntityTripletContext: three of its five enforces · 01 · env-sigs (caps) ==== 
(print "--- [AQP-G46 - UEV_AddScoreEntityTripletContext: three of its five enforces · 01 · env-sigs (caps)] ---")
(env-sigs [{ "key": "PK_AncientHodler", "caps": [] }])
(let*
    (
        (ref-U|DALOS:module{UtilityDalosV2} U|DALOS)
        (ref-RPS:module{AcquisitionRewardPerShareV1} RPS)
        (vault:string (ref-U|DALOS::UDC_Makeid "SfStakeVault"))
        (bronze:string (ref-U|DALOS::UDC_Makeid "G28Bronze"))
        (silver:string (ref-U|DALOS::UDC_Makeid "G25Score"))
        (golden:string (ref-U|DALOS::UDC_Makeid "G28Golden"))
        (triplet:string (concat ["T" "|" bronze "|" silver "|" golden]))
    )
    ;;`UEV_AddScoreEntityTripletContext` (`05_FVT.pact:1898`) carries FIVE enforces plus a
    ;;CAP_EnforceAccountOwnership, and they run in a fixed order, so each one is only reachable
    ;;once every guard above it passes. That ordering is what the fixture above exists for.
    ;;
    ;;THREE ARE PINNED HERE, chosen because the <<AQP-G46a/b>> fixture reaches them without
    ;;building a second FVT:
    ;;  1] the HOISTED existence check -- and this one is the interesting one. It used to sit
    ;;     INSIDE the inner `let`, underneath five hard reads of `SCR|T|Triplet` keyed by the very
    ;;     id it was meant to validate. Pact binds `let` eagerly, so a triplet that did not exist
    ;;     died on "row not found" and the guard was unreachable FOR EVERY INPUT. It was hoisted
    ;;     above the let; this assertion is what proves the hoist actually works, because the
    ;;     message it demands is the guard's own and not the table's.
    ;;  4] the composite validity fold -- driven through the <swpair> disjunct.
    ;;  5] the class-branch weight rule -- the vault/treasury arm.
    ;;
    ;;THE OTHER TWO ARE COVERED ELSEWHERE, not skipped: the category/class match and the
    ;;non-mosaic membership-mode rule are both driven by `Kursan/dsa-grand-tour.repl <<GT-16>>`,
    ;;which builds the non-mosaic vault this file does not have. (That mode guard is also where
    ;;the binary-`or` arity break was found: a 3-argument `or` that raised instead of evaluating,
    ;;invisible because the outer `or` short-circuited on mosaic.)
    (map print
        [
            ;;1] reached only because the existence check was hoisted out of the eager let
            (expect-failure "<<AQP-G46>> a triplet that was never issued is refused BY THE GUARD, not by a table miss"
                "Triplet must be issued in AQP-SCORE"
                (AQP-FVT.UEV_AddScoreEntityTripletContext vault
                    (concat ["T" "|" "NoSuchBronze" "|" "NoSuchSilver" "|" "NoSuchGolden"]) "|" 0.0))
            ;;4] a real triplet, but pointed at a swpair this entity does not resolve to
            (expect-failure "<<AQP-G46>> a real triplet with the WRONG swpair is refused"
                "Invalid AddScoreEntity triplet: row exists, links, or swpair mismatch"
                (AQP-FVT.UEV_AddScoreEntityTripletContext vault triplet
                    (ref-U|DALOS::UDC_Makeid "NotThisPair") 0.0))
            ;;5] past every guard above, and refused on the class-branch weight rule alone
            (expect-failure "<<AQP-G46>> a vault/treasury triplet may not carry a ghost weight"
                "Vault/Treasury triplet: swpair | and zero ghost weight"
                (AQP-FVT.UEV_AddScoreEntityTripletContext vault triplet "|" 1.0))
            ;;and the NON-VACUITY witness for all three: the vault really is a non-farm class, so
            ;;the branch taken at 5] is the one this block claims it is
            (expect "<<AQP-G46>> ...and the FVT under test is genuinely NOT class 0 (the farm arm)"
                true (!= (ref-RPS::UR_FVT|FvtClass vault) 0))
        ]
    )
    ""
)
(env-sigs [])
(commit-tx)

;;|| NEXT >
