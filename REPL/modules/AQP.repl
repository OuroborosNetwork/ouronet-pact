                ["|" "|"]
                [(ref-SCR::UR_SCR|ScoreFvtLink emma-score) (ref-SCR::UR_SCR|ScoreFvtLink anhd-score)])
            (expect "<<AQP-G24e>> ...and the EMMA score's owner differs from the vault's"
                false (= (ref-SCR::UR_SCR|ScoreOwnerKonto emma-score)
                         (ref-RPS::UR_FVT|OwnerKonto vault)))
            ;;--- guard 1: a score cannot be admitted to an FVT owned by someone else. Without it
            ;;one account could attach its score to another's vault and draw on its rewards.
            (expect-failure "<<AQP-G24e>> a score owned by a DIFFERENT account is refused"
                "Score owner must match FVT owner"
                (AQP-FVT.UEV_AddScoreEntityScoreContext vault emma-score "|" 0.0))
            ;;--- the class branch: owner matches and the admission fold passes, so the only thing
            ;;left to object to is the non-zero ghost weight on a class-1 (vault) FVT. Farms carry
            ;;ghost weight; vaults and treasuries must not.
            (expect-failure "<<AQP-G24e>> a VAULT score with a non-zero ghost weight is refused"
                "Vault/Treasury score: swpair | and zero ghost weight"
                (AQP-FVT.UEV_AddScoreEntityScoreContext vault anhd-score "|" 1.0))
        ]
    )
    ""
)
(env-sigs [])
