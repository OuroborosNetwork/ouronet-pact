(begin-tx "AQP-G45 — backing the ANK non-negativity annotation")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(namespace "ouronet-ns")
(print "--- [AQP-G45 · 01 · why the anchor-refresh amount guard cannot be driven] ---")
;;`01_ANK.pact:453` is annotated `;;UNREACHABLE`, and an annotation is only worth as much as the
;;assertion behind it. These are that assertion. They do not pretend to fire the guard — they show
;;the two independent reasons nothing can.
;;
;;REASON 1 — NO EXTERNAL CALLER. The cap's sole entry, `XE_UpdateTrueFungibleUserAnchorValues`,
;;opens with `(P|UEV_IMC)`. A REPL caller is not in the module's caller policy table, so the guard
;;set rejects it ("None of the guards passed" — the policy-table form of the IMC refusal, not the
;;"Inter Module Call" text some other modules use) and the argument never reaches the enforce.
;;
;;REASON 2 — THE ARGUMENT IS DERIVED, NOT SUPPLIED. Even for the one caller that IS allowed (FVT),
;;the value is a sum over `AQP|T|DPTFTracker` balances. Those balances are floored at zero by the
;;custody cap — `AQP|XE>TRUE-FUNGIBLE-POOL-CUSTODY` refuses an unstake larger than the staked
;;balance (that is the conjunct pinned by <<AQP-G41>>) — so a row can reach 0.0 and stop, never go
;;below. Asserted below over every live pool in the suite rather than one hand-picked row.
(env-sigs [{ "key": "PK_AncientHodler", "caps": [] }])
(let
    (
        (ref-ANK:module{AcquisitionAnchorsV1} AQP-ANK)
        (ref-AQP:module{AcquisitionPoolsV1} AQP-POOL)
        (ouro:string "OURO-98c486052a51")
    )
    (map print
        [
            (expect-failure "<<AQP-G45>> REASON 1: the only entry to the cap is closed to outside callers"
                "None of the guards passed"
                (ref-ANK::XE_UpdateTrueFungibleUserAnchorValues KST.ANHD ouro -1.0))
            ;;...and the refusal is the IMC gate, not the amount: the SAME call with a perfectly
            ;;legal amount is refused identically. So no argument, valid or not, reaches :453.
            (expect-failure "<<AQP-G45>> ...and it refuses a LEGAL amount in exactly the same way"
                "None of the guards passed"
                (ref-ANK::XE_UpdateTrueFungibleUserAnchorValues KST.ANHD ouro 5.0))
            ;;REASON 2: the derivation's inputs, swept across every pool the suite holds — not one
            ;;chosen row. If any tracker balance could go negative this would catch it.
            (expect "<<AQP-G45>> REASON 2: no DPTF tracker row in the whole suite is negative"
                true
                (fold (and) true
                    (map (lambda (r:object) (>= (at "balance" r) 0.0))
                        (fold (+) []
                            (map (lambda (p:string)
                                    (ref-AQP::URH_AQP|ActiveDptfTrackerRows p (ref-AQP::UR_AQP|PoolAssetId p)))
                                (ref-AQP::URH_AQP|AllPoolIds))))))
        ]
    )
    ""
)
(commit-tx)

