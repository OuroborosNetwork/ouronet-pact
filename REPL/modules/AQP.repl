(begin-tx "AQP-G42 — the DPNF score-definition class gate")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(namespace "ouronet-ns")
(print "--- [AQP-G42 · 01 · issuing a NON-FUNGIBLE definition against a class-1 score] ---")
;;`02_SCORE.pact:869` — `(and (= score-row-id score-id) (= score-class 4))`.
;;
;;ONLY THE SECOND CONJUNCT IS LIVE, and the source says so at the site: `score-row-id` is the row's
;;own id field read with `score-id` as the key, so the first half is a tautology on every well-formed
;;row and an abort ("row not found") on a missing one. It is kept as a data-integrity assertion
;;against a corrupt write. So the input that fires this enforce is a score that EXISTS and is simply
;;the wrong class — TfStakeScore, class 1, asserted below.
;;
;;Driven on `SCR|XI>X_ISSUE-NF-SCORE-DEFINITION` directly rather than through the client, because
;;the client cap runs `UEV_NonFungibleScoreDefinition` first and that validator rejects a class-1
;;score with its own wording — which would have credited this enforce for a rejection it never made.
;;==== AQP-G42 — the DPNF score-definition class gate · 01 · env-sigs (caps) ==== =================
(print "--- [AQP-G42 — the DPNF score-definition class gate · 01 · env-sigs (caps)] ---")
(env-sigs [{ "key": "PK_AncientHodler", "caps": [] }])
(let*
    (
        (ref-U|DALOS:module{UtilityDalosV2} U|DALOS)
        (ref-SCR:module{AcquisitionScoresV1} AQP-SCORE)
        (tf-score:string (ref-U|DALOS::UDC_Makeid "TfStakeScore"))
    )
    (map print
        [
            (expect "<<AQP-G42>> TfStakeScore exists and is class 1, not the class 4 this path needs"
                1 (ref-SCR::UR_SCR|ScoreClass tf-score))
            (expect-failure "<<AQP-G42>> a class-1 score is refused a NON-FUNGIBLE score definition"
                "Invalid score/dpnf: score must exist as DPNF (class 4) with matching score-id"
                (test-capability (AQP-SCORE.SCR|XI>X_ISSUE-NF-SCORE-DEFINITION
                    tf-score "DHCD-98c486052a51")))
        ]
    )
    ""
)
(commit-tx)

