(begin-tx "AQP-F7 — the four tracker row-reader families, on a REAL row and an ABSENT one")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
;;==== AQP-F7 — the four tracker row-reader families, on a REAL row and an ABSENT one · 01 · namespace ==== 
(print "--- [AQP-F7 — the four tracker row-reader families, on a REAL row and an ABSENT one · 01 · namespace] ---")
(namespace "ouronet-ns")
(print "--- [AQP-F7 · 01 · tracker identity round-trips, with existence established first] ---")
;;FUNCTION COVERAGE (G6, Tier 1: AQP). Twenty per-field tracker readers -- UR_AQP|{DPTF,DPOF,DPSF,
;;DPNF}Tracker{PoolId,*Id,OwnerId,BeneficiaryId,Nonce} -- none ever called from a test. They are the
;;projection of the stake-tracker rows that every balance, unstake and vacate path reads.
;;
;;THE ROUND TRIP IS THE TEST, and it earns its keep on these four tables because the keys are
;;COMPOSITE and their components are all the same TYPE. `(pool-id, dptf-id, owner-id, beneficiary-id)`
;;is four strings: transpose any two in a key builder or a writer and every downstream read still
;;returns plausible-looking ids. Nothing else in the suite would notice. Asserting that each field
;;comes back equal to the key component it was looked up by is what makes a transposition visible.
;;
;;AND IT IS VACUOUS WITHOUT THE PREMISE. These are `with-default-read` readers whose DEFAULT OBJECT
;;IS BUILT FROM THE KEY (`UDC_AQP|TrueFungibleTracker 0.0 pool-id dptf-id owner-id beneficiary-id`),
;;so on a missing row they echo the arguments and the whole sweep would pass against an EMPTY TABLE.
;;This is the third reader family in this codebase with that shape -- see RPS's UR_FVT-RU|* in
;;Kursan/AQP-stream-tests.repl <<T-STREAM-RT>> and SCORE's UR_U-SCR|* in <<AQP-F5>>. So existence is
;;established first, from the BALANCE, which is the only field that cannot be faked by the default.
;;==== AQP-F7 — the four tracker row-reader families, on a REAL row and an ABSENT one · 02 · let / invocation ==== 
(print "--- [AQP-F7 — the four tracker row-reader families, on a REAL row and an ABSENT one · 02 · let / invocation] ---")
(let
    (
        (ref-U|DALOS:module{UtilityDalosV2} U|DALOS)
        (ref-AQP:module{AcquisitionPoolsV1} AQP-POOL)
        (ouro:string "OURO-98c486052a51")
        (dhcd:string "DHCD-98c486052a51")
    )
    (let
        (
            (tf-pool:string (ref-U|DALOS::UDC_Makeid "DrainVacPool"))
            (sf-pool:string (ref-U|DALOS::UDC_Makeid "SfStakePool"))
        )
        (map print
            [
                ;;PREMISE — both rows are REAL. A default row would carry balance 0.0.
                (expect "<<AQP-F7>> both tracker rows are real: non-zero balances, not defaults"
                    [20.0 500.0]
                    [(ref-AQP::UR_AQP|DPTFTrackerBalance tf-pool ouro KST.ANHD KST.ANHD)
                     (ref-AQP::UR_AQP|DPSFTrackerBalance sf-pool dhcd KST.ANHD KST.ANHD 1)])
                ;;DPTF — four string components, all round-tripping
                (expect "<<AQP-F7>> the DPTF tracker returns all four key components unchanged"
                    [tf-pool ouro KST.ANHD KST.ANHD]
                    [(ref-AQP::UR_AQP|DPTFTrackerPoolId tf-pool ouro KST.ANHD KST.ANHD)
                     (ref-AQP::UR_AQP|DPTFTrackerDptfId tf-pool ouro KST.ANHD KST.ANHD)
                     (ref-AQP::UR_AQP|DPTFTrackerOwnerId tf-pool ouro KST.ANHD KST.ANHD)
                     (ref-AQP::UR_AQP|DPTFTrackerBeneficiaryId tf-pool ouro KST.ANHD KST.ANHD)])
                ;;DPSF — five components, and the nonce is the one of a DIFFERENT type, so it also
                ;;proves the reader is not simply echoing a uniform string tuple
                (expect "<<AQP-F7>> the DPSF tracker likewise, including the INTEGER nonce"
                    [sf-pool dhcd KST.ANHD KST.ANHD 1]
                    [(ref-AQP::UR_AQP|DPSFTrackerPoolId sf-pool dhcd KST.ANHD KST.ANHD 1)
                     (ref-AQP::UR_AQP|DPSFTrackerDpsfId sf-pool dhcd KST.ANHD KST.ANHD 1)
                     (ref-AQP::UR_AQP|DPSFTrackerOwnerId sf-pool dhcd KST.ANHD KST.ANHD 1)
                     (ref-AQP::UR_AQP|DPSFTrackerBeneficiaryId sf-pool dhcd KST.ANHD KST.ANHD 1)
                     (ref-AQP::UR_AQP|DPSFTrackerNonce sf-pool dhcd KST.ANHD KST.ANHD 1)])
                ;;THE KEY IS ORDER-SENSITIVE. Transposing owner and beneficiary is a no-op HERE only
                ;;because this is a self-stake; transposing POOL and TOKEN is not, and must miss.
                ;;This is the assertion that would fail if the key builder ignored a component.
                (expect "<<AQP-F7>> transposing pool-id and token-id MISSES the row -- the key is order-sensitive"
                    0.0 (ref-AQP::UR_AQP|DPTFTrackerBalance ouro tf-pool KST.ANHD KST.ANHD))
                ;;THE ECHO TRAP, consistent with the other two families: the miss above still hands
                ;;back the transposed key as though it were stored data.
                (expect "<<AQP-F7>> ...yet the identity readers still echo the transposed key, confidently"
                    [ouro tf-pool]
                    [(ref-AQP::UR_AQP|DPTFTrackerPoolId ouro tf-pool KST.ANHD KST.ANHD)
                     (ref-AQP::UR_AQP|DPTFTrackerDptfId ouro tf-pool KST.ANHD KST.ANHD)])
                ;;so BALANCE is the existence oracle for these tables, not any identity field
                (expect "<<AQP-F7>> only the BALANCE distinguishes a real tracker row from a defaulted one"
                    [true 0.0]
                    [(> (ref-AQP::UR_AQP|DPTFTrackerBalance tf-pool ouro KST.ANHD KST.ANHD) 0.0)
                     (ref-AQP::UR_AQP|DPTFTrackerBalance tf-pool ouro "ghost-owner" "ghost-ben")])
                ;;and the DPOF/DPNF families answer their defaults cleanly rather than aborting --
                ;;these two have no live row here, which is itself the case worth pinning: a UI
                ;;asking about an un-staked family must get zero, not an error.
                (expect "<<AQP-F7>> the DPOF and DPNF trackers default to zero rather than aborting"
                    [0.0 0.0]
                    [(ref-AQP::UR_AQP|DPOFTrackerBalance tf-pool "MVST-98c486052a51" KST.ANHD KST.ANHD 1)
                     (ref-AQP::UR_AQP|DPNFTrackerBalance tf-pool "DHB-98c486052a51" KST.ANHD KST.ANHD 1)])
            ]
        )
    )
    ""
)
(commit-tx)

