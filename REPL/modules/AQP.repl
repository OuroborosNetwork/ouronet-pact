(begin-tx "AQP-G34 — the three vacate-batch admission caps")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(namespace "ouronet-ns")
(print "--- [AQP-G34 · 01 · VCT TF / OF / collectable vacate input validation] ---")
;;P3.3. Three plain (non-@event) defcaps, so test-capability reaches them directly. Each opens with
;;a fold over the batch's structural predicates, and the ownership check sits AFTER — so the fold is
;;what answers and no pool ownership is needed to reach it.
;;
;;A vacate batch is the operator force-unstaking other people's positions, so these are the checks
;;standing between a malformed batch and touching stakes that were never named: the parallel arrays
;;must line up, the asset must belong to the pool, and every (owner, beneficiary) leg must actually
;;be staked for the amount claimed.
;;
;;Each cap is driven TWICE — once on array misalignment, once on a WRONG ASSET with well-formed
;;arrays. The fold is a conjunction, so one input proves one conjunct; and the asset case is the one
;;that matters most, because a batch naming another pool's token with valid-looking legs is the
;;shape an attacker would actually send.
;;==== AQP-G34 — the three vacate-batch admission caps · 01 · env-sigs (caps) ==== ================
(print "--- [AQP-G34 — the three vacate-batch admission caps · 01 · env-sigs (caps)] ---")
(env-sigs [{ "key": "PK_AncientHodler", "caps": [] }])
(let*
    (
        (ref-U|DALOS:module{UtilityDalosV2} U|DALOS)
        (tfp:string (ref-U|DALOS::UDC_Makeid "TfStakePool"))
        (ofp:string (ref-U|DALOS::UDC_Makeid "OfStakePool"))
        (sfp:string (ref-U|DALOS::UDC_Makeid "SfStakePool"))
        (ouro:string (ref-U|DALOS::UDC_Makeid "OURO"))
        (mvst:string (ref-U|DALOS::UDC_Makeid "MVST"))
        (dhcd:string (ref-U|DALOS::UDC_Makeid "DHCD"))
    )
    (map print
        [
            ;;--- TRUE FUNGIBLE: one owner against two beneficiaries.
            (expect-failure "<<AQP-G34>> a TF vacate batch with misaligned parallel arrays is refused"
                "Invalid TF vacate cap input"
                (test-capability (AQP-VCT.VCT|C>TRUE-FUNGIBLE-VACATE
                    tfp ouro [KST.ANHD] [KST.EMMA KST.ANHD] [1.0])))
            ;;    ...and aligned arrays naming the WRONG asset for this pool.
            (expect-failure "<<AQP-G34>> ...and one naming an asset that is not the pool's is refused"
                "Invalid TF vacate cap input"
                (test-capability (AQP-VCT.VCT|C>TRUE-FUNGIBLE-VACATE
                    tfp mvst [KST.ANHD] [KST.EMMA] [1.0])))
            ;;--- ORTO FUNGIBLE batch.
            (expect-failure "<<AQP-G34>> an OF vacate batch with misaligned arrays is refused"
                "Invalid OF vacate batch"
                (test-capability (AQP-VCT.VCT|C>ORTO-FUNGIBLE-VACATE-BATCH
                    ofp mvst [KST.ANHD] [KST.EMMA KST.ANHD] [[1]] [[1.0]])))
            (expect-failure "<<AQP-G34>> ...and one naming the wrong asset is refused"
                "Invalid OF vacate batch"
                (test-capability (AQP-VCT.VCT|C>ORTO-FUNGIBLE-VACATE-BATCH
                    ofp ouro [KST.ANHD] [KST.EMMA] [[1]] [[1.0]])))
            ;;--- COLLECTABLE batch (son = set vs native nonce).
            (expect-failure "<<AQP-G34>> a collectable vacate batch with misaligned arrays is refused"
                "Invalid collectable vacate batch"
                (test-capability (AQP-VCT.VCT|C>COLLECTABLE-VACATE-BATCH
                    sfp dhcd true [KST.ANHD] [KST.EMMA KST.ANHD] [[1]] [[1]])))
            (expect-failure "<<AQP-G34>> ...and one naming the wrong collectable is refused"
                "Invalid collectable vacate batch"
                (test-capability (AQP-VCT.VCT|C>COLLECTABLE-VACATE-BATCH
                    sfp mvst true [KST.ANHD] [KST.EMMA] [[1]] [[1]])))
        ]
    )
    ""
)
(env-sigs [])
(commit-tx)

