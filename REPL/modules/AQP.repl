(begin-tx "AQP-F9 — RPS: URCi_CollectFull against the three legs it says it is made of")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
;;==== AQP-F9 — RPS: URCi_CollectFull against the three legs it says it is made of · 01 · namespace ==== 
(print "--- [AQP-F9 — RPS: URCi_CollectFull against the three legs it says it is made of · 01 · namespace] ---")
(namespace "ouronet-ns")
(print "--- [AQP-F9 · 01 · the collect cost preview, decomposed] ---")
;;FUNCTION COVERAGE (G6, Tier 1: RPS). `URCi_CollectFull` is the number a client is quoted before
;;signing a collect, and its @doc states the composition outright:
;;
;;   "FULL reconstructed IGNIS ifp of CC_Collect = reward-payout leg (URC_CollectTransferLegIgnis)
;;    + Phase-7 forced-fix penalty (URC_CollectForcedFixIgnis) + the URCi_Collect leg."
;;
;;None of the three had ever been called. Rebuilding the sum from its named parts tests all of them
;;at once AND tests the claim -- if a leg is dropped, added or re-weighted, the identity breaks. It
;;is also price-independent: nothing here hardcodes an IGNIS figure, so it survives a re-pricing.
;;
;;THE POOL-ID DERIVATION IS PART OF THE TEST. `URC_CollectTransferLegIgnis` needs a pool-id that
;;`URCi_CollectFull` does NOT take as an argument -- it derives it from the score entity
;;(`UR_SCR|ScoreAqpoolLink`, or the TRIPLET's silver score when the entity is a triplet). The rebuild
;;below derives it the same way, so a change to that resolution shows up here rather than silently
;;pricing a different pool's legs.
;;==== AQP-F9 — RPS: URCi_CollectFull against the three legs it says it is made of · 02 · let / invocation ==== 
(print "--- [AQP-F9 — RPS: URCi_CollectFull against the three legs it says it is made of · 02 · let / invocation] ---")
(let
    (
        (ref-U|DALOS:module{UtilityDalosV2} U|DALOS)
        (ref-RPS:module{AcquisitionRewardPerShareV1} RPS)
        (ref-SCR:module{AcquisitionScoresV1} AQP-SCORE)
        (ref-INFO:module{OuronetInfoV2} IGNIS)
        (ouro:string "OURO-98c486052a51")
    )
    (let
        (
            (fvt:string (ref-U|DALOS::UDC_Makeid "TfStakeVault"))
            (score:string (ref-U|DALOS::UDC_Makeid "TfStakeScore"))
        )
        (let
            (
                ;;derived exactly as the function does for a non-triplet entity
                (pool:string (ref-SCR::UR_SCR|ScoreAqpoolLink score))
            )
            (map print
                [
                    ;;premise: this vault really does carry that member and that reward, so the
                    ;;three legs below are being computed over a live configuration
                    (expect "<<AQP-F9>> TfStakeVault carries TfStakeScore as a member and OURO as a reward"
                        [[score] [ouro]]
                        [(ref-RPS::URH_FvtEnabledScoreEntityIdsForFvt fvt)
                         (ref-RPS::URH_FVT-RG|EnabledRewardRows fvt)])
                    ;;THE IDENTITY: the quoted total is exactly its three named legs, summed.
                    (expect "<<AQP-F9>> URCi_CollectFull equals payout-leg + forced-fix + the collect leg"
                        (fold (+) 0.0
                            [ (ref-RPS::URC_CollectTransferLegIgnis KST.ANHD pool fvt 1 score ouro)
                              (ref-RPS::URC_CollectForcedFixIgnis KST.ANHD fvt ouro)
                              (ref-INFO::OI|UC_IfpFromOutputCumulator
                                  (ref-RPS::URCi_Collect fvt [fvt score ouro])) ])
                        (ref-RPS::URCi_CollectFull KST.ANHD fvt 1 score ouro))
                    ;;non-vacuity: the total is not zero, so the identity is not 0 = 0 + 0 + 0
                    (expect "<<AQP-F9>> ...and the quoted total is above zero"
                        true (> (ref-RPS::URCi_CollectFull KST.ANHD fvt 1 score ouro) 0.0))
                    ;;the forced-fix leg's documented zero-guard: "0 when ffc<=0". This account has no
                    ;;forced-fix count on this lane, so the penalty term is absent -- which is also
                    ;;why the identity above is dominated by the other two legs.
                    (expect "<<AQP-F9>> the forced-fix penalty is 0 for an account with no stale-fix count"
                        0.0 (ref-RPS::URC_CollectForcedFixIgnis KST.ANHD fvt ouro))
                    ;;...so the remaining two legs alone must already account for the whole total.
                    ;;This is what stops the identity passing on a function that silently ignores a leg.
                    (expect "<<AQP-F9>> ...so payout-leg + collect-leg alone reproduce the total"
                        (+ (ref-RPS::URC_CollectTransferLegIgnis KST.ANHD pool fvt 1 score ouro)
                           (ref-INFO::OI|UC_IfpFromOutputCumulator
                               (ref-RPS::URCi_Collect fvt [fvt score ouro])))
                        (ref-RPS::URCi_CollectFull KST.ANHD fvt 1 score ouro))
                    ;;and the pool the function derives is a real one, not BAR -- the derivation is
                    ;;silent on failure, so an unlinked score would price against a ghost pool
                    (expect "<<AQP-F9>> the derived pool-id is a real pool, not the BAR sentinel"
                        true (!= pool (U|CT.CT_BAR)))
                ]
            )
        )
    )
    ""
)
(commit-tx)

