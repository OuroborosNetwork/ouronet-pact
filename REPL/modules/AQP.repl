;;  ######################################################################################
;;  ##  AQP-G27 MUST REMAIN THE LAST TRANSACTION IN THIS FILE.  DO NOT APPEND BELOW IT.  ##
;;  ######################################################################################
;;
(begin-tx "AQP-G27 — SCORE's own defensive fvt-link guard (leaks state; keep last)")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(namespace "ouronet-ns")
(print "--- [AQP-G27 · 01 · SCR|XE>CREATE-FVT-LINK one-time-link guard] ---")
;;P3.3. SCR|XE>CREATE-FVT-LINK refuses to overwrite a score's fvt-link once it is set -- a score
;;belongs to exactly one FVT, and re-pointing it would leave the OLD FVT still carrying that
;;score's weight in its reward share while the score earns in the new one.
;;
;;WHY THIS GUARD SAT UNPINNED, AND WHY THE TEST LOOKS ODD
;;Every PRODUCTION caller checks the same condition first, so none of them can reach it:
;;  AQP|C>ADD-SCORE     -> UEV_AddScorePoolAndScore     asserts aqpool-link = BAR
;;  AQP|C>REVOKE-SCORE  -> UEV_RevokeScorePoolAndScore   asserts aqpool-link = pool-id
;;  FVT C_AddScoreEntity-> UEV_AddScoreEntityScoreContext asserts fvt-link  = BAR  <- this one
;;  RPS triplet admit   -> UEV_AddScoreEntityTripletContext asserts all three fvt-links BAR
;;That is correct defence-in-depth (SCORE owns the row and does not trust its callers), but it
;;means the only caller that can actually reach the enforce is the REPL-only helper
;;REPL_BootstrapVault, which writes the FVT rows first and links the score afterwards.
;;
;;CONSEQUENCE -- THE REASON FOR THE BANNER ABOVE: expect-failure does NOT roll back database
;;writes (verified: an FVT row inserted before a failing enforce survives both the expect-failure
;;AND the commit-tx). `try` is the opposite -- it forces read-only mode, so the write itself
;;errors out and the guard is never reached. So this block leaves an orphan FVT row plus its
;;score-entity-link behind. That is harmless ONLY because this is the final transaction of a
;;leaf tester (nothing loads modules/AQP.repl -- not Z.repl, not ZALL.repl). Move this block, or
;;append after it, and the orphan becomes visible to whatever follows.
;;==== AQP-G27 — SCORE's own defensive fvt-link guard (leaks state; keep last) · 01 · env-sigs (caps) ==== 
(print "--- [AQP-G27 — SCORE's own defensive fvt-link guard (leaks state; keep last) · 01 · env-sigs (caps)] ---")
(env-sigs [{ "key": "PK_AncientHodler", "caps": [] }])
;;==== AQP-G27 — SCORE's own defensive fvt-link guard (leaks state; keep last) · 02 · let / invocation ==== 
(print "--- [AQP-G27 — SCORE's own defensive fvt-link guard (leaks state; keep last) · 02 · let / invocation] ---")
(let
    (
        (ref-U|DALOS:module{UtilityDalosV2} U|DALOS)
        (ref-SCR:module{AcquisitionScoresV1} AQP-SCORE)
        (ref-TS02-C3:module{TalosStageTwo_ClientThreeV1} TS02-C3)
        (tf-score:string (ref-U|DALOS::UDC_Makeid "TfStakeScore"))
        (tf-vault:string (ref-U|DALOS::UDC_Makeid "TfStakeVault"))
        (ouro:string (ref-U|DALOS::UDC_Makeid "OURO"))
        (orphan:string (ref-U|DALOS::UDC_Makeid "G27OrphanVault"))
    )
    (map print
        [
            ;;precondition: the score is ALREADY linked, which is the whole point -- a score with
            ;;a BAR fvt-link would be bootstrapped successfully and prove nothing.
            (expect "<<AQP-G27>> TfStakeScore's fvt-link is already set to TfStakeVault"
                tf-vault (ref-SCR::UR_SCR|ScoreFvtLink tf-score))
            ;;--- the guard: a second FVT cannot claim a score that already belongs to one.
            (expect-failure "<<AQP-G27>> a second FVT cannot claim an already-linked score"
                "FVT link slot must be unset and fvt-id must be non-BAR"
                (ref-TS02-C3::AQP-FVT|REPL_BootstrapVault KST.ANHD orphan KST.ANHD tf-score ouro))
            ;;...and the original link is UNCHANGED. This is the assertion that makes the test
            ;;about the invariant rather than about the error string: the guard's job is to leave
            ;;the existing ownership intact, not merely to raise.
            (expect "<<AQP-G27>> ...and the original fvt-link survived the attempt"
                tf-vault (ref-SCR::UR_SCR|ScoreFvtLink tf-score))
        ]
    )
    ""
)
(env-sigs [])
(commit-tx)
;;NOT PINNED — the aqpool-link twins (SCR|XE>CREATE-AQPOOL-LINK "Aqpool link slot must be unset…"
;;and SCR|XE>REVOKE-AQPOOL-LINK "Aqpool link must match pool-id…") have no unshadowed caller at
;;all: AQP is their ONLY caller and it checks both conditions in its own defcap, and there is no
;;REPL_Bootstrap-style helper for pool links. They stay on the worklist rather than being marked
;;UNREACHABLE, because they are reachable in principle -- just not from anything deployed today.

;;|| NEXT >
;;
(begin-tx "AQP-G25 — UEV_IssueAnchor: a REVOKED boost class cannot take new anchors")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
;;==== AQP-G25 — UEV_IssueAnchor: a REVOKED boost class cannot take new anchors · 01 · namespace ==== 
(print "--- [AQP-G25 — UEV_IssueAnchor: a REVOKED boost class cannot take new anchors · 01 · namespace] ---")
(namespace "ouronet-ns")
(print "--- [AQP-G25 · 01 · boost-class activity] ---")
;;Found via _cheapseam.py, which ranks the remaining plain-callable guards by how many enforces sit
;;ABOVE them in the same function. This one has zero predecessors, so a single call reaches it.
;;
;;A boost class multiplies the score an anchor contributes. Revoking one is how an operator retires
;;a boost programme; the guard is what stops new anchors being attached to a retired programme and
;;silently earning nothing. The [6.2.1] ANK suite revokes three classes, so an inactive one already
;;exists here -- no fixture needed, which is exactly why this guard was cheap and still unpinned.
;;
;;The precondition is asserted rather than assumed: if that class were somehow still active this
;;test would pass for an entirely different reason.
;;==== AQP-G25 — UEV_IssueAnchor: a REVOKED boost class cannot take new anchors · 02 · let / invocation ==== 
(print "--- [AQP-G25 — UEV_IssueAnchor: a REVOKED boost class cannot take new anchors · 02 · let / invocation] ---")
;;SIGNED AS THE CLASS OWNER, added 2026-09-19 with the boost-class ownership field. UEV_IssueAnchor
;;now enforces class ownership BEFORE the class-active check, per CLAUDE.md's "authorisation
;;precedes validation" ruling. Unsigned, this block refused with "Keyset failure" and the
;;active-check below became unreachable -- the test would have kept passing while proving nothing
;;about revocation. The remedy is the one that ruling prescribes: a FIXTURE that satisfies the
;;first guard, so BOTH are exercised, rather than reordering the enforces.
(env-sigs [{ "key": "PK_AncientHodler", "caps": [] }])
(let
    (
        (ref-ANK:module{AcquisitionAnchorsV1} AQP-ANK)
        (revoked:string "TempClassTF-98c486052a51")
    )
    (map print
        [
            (expect "<<AQP-G25>> the boost class really is revoked"
                false (ref-ANK::UR_BC|Active revoked))
            (expect-failure "<<AQP-G25>> a revoked boost class cannot take a new anchor"
                "must be active"
                (ref-ANK::UEV_IssueAnchor "OURO-98c486052a51" revoked))
        ]
    )
    ""
)
(commit-tx)

;;|| NEXT >
;;|| AQP-G38 — the SCORE side of the same activity rule.
;;
(begin-tx "AQP-G38 - a score cannot be linked to an inactive BoostClass")
(env-gasmodel "table")(env-gaslimit 150000000)(env-gas 0)
(namespace "ouronet-ns")
;;==== AQP-G38 - a score cannot be linked to an inactive BoostClass · 01 · env-sigs (caps) ==== ===
(print "--- [AQP-G38 - a score cannot be linked to an inactive BoostClass · 01 · env-sigs (caps)] ---")
(env-sigs [{ "key": "PK_AncientHodler", "caps": [] }])
(print "--- [AQP-G38 · 01 · SCR|C>CREATE-BOOST-CLASS-LINK-SCORE activity] ---")
;;`02_SCORE.pact:894`. AQP-G25 just above pins the ANCHOR side of the boost-class activity rule
;;(`UEV_IssueAnchor`); this is the SCORE side, and it is a different check in a different module --
;;an anchor attaches an ASSET to a class, a score link attaches a STAKING SURFACE to it. Both have
;;to refuse a retired programme or stakers accrue against a class that pays nothing.
;;
;;Reuses AQP-G25's fixture exactly: `TempClassTF` was revoked by the [6.2.1] ANK suite, so the
;;inactive class already exists. What is new is that this guard lives in a DEFCAP, so it needs the
;;Talos client rather than a direct call, and the score must satisfy the conjunct above it
;;(nzs-count = 0) before the activity check is even consulted -- asserted, not assumed.
;;
;;THE CONTRAST IS THE SAME CLASS, REACTIVATED, rather than a different active class. One variable
;;changes between the refusal and the acceptance, so the acceptance cannot be explained by anything
;;else about the two classes. `rollback-tx` discards both the reactivation and the link it allows.
;;==== AQP-G38 - a score cannot be linked to an inactive BoostClass · 02 · let / invocation ==== ==
(print "--- [AQP-G38 - a score cannot be linked to an inactive BoostClass · 02 · let / invocation] ---")
(let
    (
        (ref-U|DALOS:module{UtilityDalosV2} U|DALOS)
        (ref-ANK:module{AcquisitionAnchorsV1} AQP-ANK)
        (ref-SCR:module{AcquisitionScoresV1} AQP-SCORE)
        (ref-TS02-C3:module{TalosStageTwo_ClientThreeV1} TS02-C3)
        (revoked:string "TempClassTF-98c486052a51")
    )
    (let
        (
            (score:string (ref-U|DALOS::UDC_Makeid "G25Score"))
        )
        (map print
            [
                ;;preconditions -- both conjuncts of the guard ABOVE the one under test must hold,
                ;;or a pass here would be the wrong guard firing.
                (expect "<<AQP-G38>> the score is owned by the patron and has no stakers"
                    [KST.ANHD 0]
                    [(ref-SCR::UR_SCR|ScoreOwnerKonto score) (ref-SCR::UR_SCR|ScoreNzsCount score)])
                (expect "<<AQP-G38>> ...and the boost class is inactive"
                    false (ref-ANK::UR_BC|Active revoked))
                ;;THE ITEM
                (expect-failure "<<AQP-G38>> a score cannot be linked to an inactive BoostClass"
                    "BoostClass must be active"
                    (ref-TS02-C3::AQP-SCR|C_CreateScoreBoostClassLink KST.ANHD score revoked))
            ]
        )
        ;;flip the ONE variable
        (env-module-admin AQP-ANK)
        (update AQP-ANK.ANK|T|BoostClass revoked { "class-active" : true })
        (map print
            [
                (expect "<<AQP-G38>> the boost class is active again" true (ref-ANK::UR_BC|Active revoked))
                (expect "<<AQP-G38>> ...and the identical link call is now admitted"
                    true (!= "" (format "{}"
                        [(ref-TS02-C3::AQP-SCR|C_CreateScoreBoostClassLink KST.ANHD score revoked)])))
                (expect "<<AQP-G38>> ...and the link is recorded on the score"
                    revoked (ref-SCR::UR_SCR|ScoreBoostClassLink score))
            ]
        )
        ""
    )
)
(env-sigs [])
;;both the reactivation and the link are discarded -- AQP-G38b checks it
(rollback-tx)

;;|| NEXT >
;;|| AQP-G38b — the reactivation and the link left no trace.
;;
(begin-tx "AQP-G38b - no leakage")
(namespace "ouronet-ns")
(print "--- [AQP-G38b · 01 · no leakage] ---")
;;A leaked reactivation would silently re-arm a retired boost programme, and a leaked score link
;;would change what later stake tests in this file accrue. Neither fails loudly on its own.
(let
    (
        (ref-U|DALOS:module{UtilityDalosV2} U|DALOS)
    )
    (map print
        [
            (expect "<<AQP-G38b>> the boost class is revoked again"
                false (AQP-ANK.UR_BC|Active "TempClassTF-98c486052a51"))
            (expect "<<AQP-G38b>> ...and the score carries no boost-class link"
                "|" (AQP-SCORE.UR_SCR|ScoreBoostClassLink (ref-U|DALOS::UDC_Makeid "G25Score")))
        ]
    )
    ""
)
(commit-tx)

;;|| NEXT >
;;|| AQP-G39 — can-upgrade is a ONE-WAY DOOR, and this is the guard that makes it one.
;;
(begin-tx "AQP-G39 - score control requires can-upgrade, which control itself can revoke")
(env-gasmodel "table")(env-gaslimit 150000000)(env-gas 0)
(namespace "ouronet-ns")
;;==== AQP-G39 - score control requires can-upgrade, which control itself can revoke · 01 · env-sigs (caps) ==== 
(print "--- [AQP-G39 - score control requires can-upgrade, which control itself can revoke · 01 · env-sigs (caps)] ---")
(env-sigs [{ "key": "PK_AncientHodler", "caps": [] }])
(print "--- [AQP-G39 · 01 · SCR|C>CONTROL-SCORE requires can-upgrade true] ---")
;;`02_SCORE.pact:744`. NO `env-module-admin` HERE, and that is the point worth recording: the
;;rejecting state is produced by the CLIENT ITSELF. `C_ControlScore` takes the new can-upgrade as an
;;argument, so calling it with `false` writes the very flag the guard requires -- and the guard then
;;refuses every later call, including the one that would set it back to `true`.
;;
;;That makes can-upgrade a ONE-WAY DOOR: an owner can permanently renounce control of a score, and
;;cannot undo it, because undoing it needs the control operation the flag has just disabled. The
;;whole property is behavioural rather than a matter of message wording, so both halves are asserted
;;-- the door closing, and the door refusing to reopen.
;;
;;Preferred over driving the field directly, on the rule this suite has been following: use the
;;client path when one exists, and `env-module-admin` only when NO legitimate flow produces the
;;state (AQP-G38 above, where the boost class had to be retired by a different module).
;;==== AQP-G39 - score control requires can-upgrade, which control itself can revoke · 02 · let / invocation ==== 
(print "--- [AQP-G39 - score control requires can-upgrade, which control itself can revoke · 02 · let / invocation] ---")
(let
    (
        (ref-U|DALOS:module{UtilityDalosV2} U|DALOS)
        (ref-SCR:module{AcquisitionScoresV1} AQP-SCORE)
        (ref-TS02-C3:module{TalosStageTwo_ClientThreeV1} TS02-C3)
    )
    (let
        (
            (score:string (ref-U|DALOS::UDC_Makeid "G25Score"))
        )
        (map print
            [
                (expect "<<AQP-G39>> the score starts controllable"
                    true (ref-SCR::UR_SCR|ScoreCanUpgrade score))
                ;;the door closes -- a normal, admitted control call that happens to renounce control
                (expect "<<AQP-G39>> a control call that sets can-upgrade FALSE is admitted"
                    true (!= "" (format "{}"
                        [(ref-TS02-C3::AQP-SCR|C_ControlScore KST.ANHD score false true)])))
                (expect "<<AQP-G39>> ...and the flag is now false"
                    false (ref-SCR::UR_SCR|ScoreCanUpgrade score))
                ;;THE ITEM
                (expect-failure "<<AQP-G39>> ...so any further control call is refused"
                    "Score control requires can-upgrade true"
                    (ref-TS02-C3::AQP-SCR|C_ControlScore KST.ANHD score false false))
                ;;THE ONE-WAY PROPERTY: the owner cannot buy the capability back. Same message, and
                ;;it is the same guard -- but this is the call that matters, because an owner who
                ;;set the flag by mistake would try exactly this one.
                (expect-failure "<<AQP-G39>> ...INCLUDING the call that would set can-upgrade back to true"
                    "Score control requires can-upgrade true"
                    (ref-TS02-C3::AQP-SCR|C_ControlScore KST.ANHD score true true))
                ;;and it is specifically the FLAG, not the score: the owner is unchanged and other
                ;;score operations are unaffected, so this is a targeted renunciation.
                (expect "<<AQP-G39>> the owner is unchanged -- only control was renounced"
                    KST.ANHD (ref-SCR::UR_SCR|ScoreOwnerKonto score))
            ]
        )
        ""
    )
)
(env-sigs [])
;;the renunciation is IRREVERSIBLE, so it must not be committed -- AQP-G39b checks it
(rollback-tx)

;;|| NEXT >
;;|| AQP-G39b — the renunciation left no trace.
;;
(begin-tx "AQP-G39b - no leakage")
(namespace "ouronet-ns")
(print "--- [AQP-G39b · 01 · no leakage] ---")
;;This one MUST be checked rather than assumed: the operation under test is irreversible by
;;construction, so a leak could not be repaired by a later test even if one noticed. `rollback-tx`
;;is the only thing standing between this assertion and a permanently uncontrollable G25Score.
(let
    (
        (ref-U|DALOS:module{UtilityDalosV2} U|DALOS)
    )
    (print
        (expect "<<AQP-G39b>> G25Score is controllable again"
            true (AQP-SCORE.UR_SCR|ScoreCanUpgrade (ref-U|DALOS::UDC_Makeid "G25Score"))))
)
(commit-tx)

