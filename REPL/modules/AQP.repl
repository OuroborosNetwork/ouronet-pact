(begin-tx "AQP-D1a — the STOA peg claim: baseline at $0.10")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
;;==== AQP-D1a — the STOA peg claim: baseline at $0.10 · 01 · namespace ==== ======================
(print "--- [AQP-D1a — the STOA peg claim: baseline at $0.10 · 01 · namespace] ---")
(namespace "ouronet-ns")
(print "--- [AQP-D1a · 01 · dollar-denominated STOA prices at the hard peg] ---")
;;DOC-CLAIM VERIFICATION (`_docclaims.py` G5), three claims at once.
;;
;;  `02_IGNIS.pact` UC_StoaPrice   — "the SAME DOLLAR VALUE as the deter, converted at the live
;;                                   STOA price ... when a real price lands the AMOUNT moves but
;;                                   the VALUE holds."
;;  `01_ANK.pact`   URCi_IssueAnchorStoa — "anchor = $5 => 50 STOA ... Doubled when <acnoi>."
;;  `02_SCORE.pact` URCi_IssueScoreStoa  — "issue-score = $10 => 100 STOA."
;;
;;All three docs say the same thing about the SAME bug: each previously read a raw usage price
;;("standard" 0.01, "smart" 0.02) that "was never dollar-denominated and so ignored the peg
;;entirely". So the claim worth testing is not the arithmetic at today's peg -- it is that the
;;figures TRACK the peg. A test that only checked 50.0 and 100.0 would have passed on the old
;;broken code too, which is exactly the trap this pair of transactions is built to avoid.
;;
;;This block pins the baseline; AQP-D1b moves the peg and shows the dollar value survive it.
;;==== AQP-D1a — the STOA peg claim: baseline at $0.10 · 02 · let / invocation ==== ===============
(print "--- [AQP-D1a — the STOA peg claim: baseline at $0.10 · 02 · let / invocation] ---")
(let
    (
        (ref-IGNIS:module{IgnisCollectorV3} IGNIS)
        (ref-ANK:module{AcquisitionAnchorsV1} AQP-ANK)
        (ref-SCR:module{AcquisitionScoresV1} AQP-SCORE)
        (ref-DALOS:module{OuronetDalosV2} DALOS)
    )
    (map print
        [
            (expect "<<AQP-D1a>> the STOA oracle is at its hard peg of $0.10"
                0.1 (ref-DALOS::UR_UsagePrice "stoa|price"))
            ;;the two documented figures, exactly as written in the @docs
            (expect "<<AQP-D1a>> anchor-issue is 50 STOA ($5 at the peg), as documented"
                50.0 (ref-ANK::URCi_IssueAnchorStoa false))
            (expect "<<AQP-D1a>> score-issue is 100 STOA ($10 at the peg), as documented"
                100.0 (ref-SCR::URCi_IssueScoreStoa))
            ;;"Doubled when <acnoi>" -- the only branch in the anchor reader
            (expect "<<AQP-D1a>> ...and the anchor price DOUBLES under acnoi"
                100.0 (ref-ANK::URCi_IssueAnchorStoa true))
            ;;and both are exactly UC_StoaPrice on their own deter key -- no second price path
            (expect "<<AQP-D1a>> both readers are UC_StoaPrice on their own deter key, not a parallel price"
                [(ref-IGNIS::UC_StoaPrice "anchor") (ref-IGNIS::UC_StoaPrice "issue-score")]
                [(ref-ANK::URCi_IssueAnchorStoa false) (ref-SCR::URCi_IssueScoreStoa)])
        ]
    )
    ""
)
(commit-tx)

;;|| NEXT >
;;
(begin-tx "AQP-D1b — move the peg: the AMOUNT moves, the VALUE holds")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(namespace "ouronet-ns")
(print "--- [AQP-D1b · 01 · repricing STOA at $0.25] ---")
;;THE ASSERTION THE CLAIM ACTUALLY MAKES. The peg is moved from $0.10 to $0.25 -- a real admin
;;operation (`TS01-A::DALOS|A_UpdateUsagePrice "stoa|price"`), the same one [4.0] uses at boot, not
;;a forced table write. At the new peg the STOA AMOUNTS must fall to 2/5 of what they were, while
;;`amount x peg` -- the DOLLARS the user actually pays -- must not move at all.
;;
;;This is what fails on the pre-rehaul code the @docs describe: a hardcoded 0.01/0.02 usage price
;;does not move when the peg does, so the dollar value would swing by 2.5x here.
;;==== AQP-D1b — move the peg: the AMOUNT moves, the VALUE holds · 01 · env-sigs (caps) ==== ======
(print "--- [AQP-D1b — move the peg: the AMOUNT moves, the VALUE holds · 01 · env-sigs (caps)] ---")
(env-sigs [{ "key": "PK_AncientHodler", "caps": [] }])
;;==== AQP-D1b — move the peg: the AMOUNT moves, the VALUE holds · 02 · let / invocation ==== =====
(print "--- [AQP-D1b — move the peg: the AMOUNT moves, the VALUE holds · 02 · let / invocation] ---")
(let
    (
        (ref-TS01-A:module{TalosStageOne_AdminV2} TS01-A)
        (ref-ANK:module{AcquisitionAnchorsV1} AQP-ANK)
        (ref-SCR:module{AcquisitionScoresV1} AQP-SCORE)
    )
    (ref-TS01-A::DALOS|A_UpdateUsagePrice "stoa|price" 0.25)
    (map print
        [
            ;;the AMOUNT moved, and moved the right way -- inversely, by exactly the peg ratio
            (expect "<<AQP-D1b>> at $0.25 the anchor AMOUNT falls from 50 to 20 STOA"
                20.0 (ref-ANK::URCi_IssueAnchorStoa false))
            (expect "<<AQP-D1b>> ...and the score amount from 100 to 40 STOA"
                40.0 (ref-SCR::URCi_IssueScoreStoa))
            ;;THE INVARIANT: the dollars are unchanged. This is the sentence under test.
            (expect "<<AQP-D1b>> INVARIANT: the anchor still costs exactly $5"
                5.0 (* (ref-ANK::URCi_IssueAnchorStoa false) 0.25))
            (expect "<<AQP-D1b>> INVARIANT: the score still costs exactly $10"
                10.0 (* (ref-SCR::URCi_IssueScoreStoa) 0.25))
            ;;the acnoi doubling is a multiplier on the converted amount, so it survives the move
            (expect "<<AQP-D1b>> ...and acnoi still doubles, at the new peg"
                40.0 (ref-ANK::URCi_IssueAnchorStoa true))
        ]
    )
    ;;restore the peg in the SAME transaction it was moved in, so no later assertion in this suite
    ;;can observe the altered oracle even if this block is reordered.
    (ref-TS01-A::DALOS|A_UpdateUsagePrice "stoa|price" 0.1)
    (map print
        [
            (expect "<<AQP-D1b>> the peg is restored to $0.10 and the amounts come back"
                [50.0 100.0]
                [(ref-ANK::URCi_IssueAnchorStoa false) (ref-SCR::URCi_IssueScoreStoa)])
        ]
    )
    ""
)
(env-sigs [])
(commit-tx)

;;|| NEXT >
;;
(begin-tx "AQP-D2 — URC_VacatePoolTfIds: both documented branches of the existence filter")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
;;==== AQP-D2 — URC_VacatePoolTfIds: both documented branches of the existence filter · 01 · namespace ==== 
(print "--- [AQP-D2 — URC_VacatePoolTfIds: both documented branches of the existence filter · 01 · namespace] ---")
(namespace "ouronet-ns")
(print "--- [AQP-D2 · 01 · the native id always, the F| counterpart only when it exists] ---")
;;DOC-CLAIM VERIFICATION (`_docclaims.py` G5). `06_VCT.pact` URC_VacatePoolTfIds:
;;
;;   "The pool's DPTF vacate-lane ids: the native asset-id (always) + its F| frozen counterpart
;;    WHEN it exists (DPTF::UR_Frozen -> BAR if never frozen -> dropped)."
;;
;;Two branches, and the suite only ever exercised one: every TF pool here is denominated in OURO,
;;which has never been frozen, so the reader always returned a single-element list and the entire
;;`filter` half of the claim was untested. A vacate that silently forgot the F| lane would leave
;;frozen balances stranded in the pool -- the exact failure this filter exists to prevent -- and
;;nothing would have caught it.
;;
;;So the frozen counterpart is FORCED here rather than waited for, and reverted with `rollback-tx`.
;;`env-module-admin DPTF` is needed for the cross-module write and MUST sit at transaction top
;;level -- inside the `let` it silently aborts the whole file with no FAILURE line at all, which is
;;the "grep -c FAILURE = 0 is not proof of success" shape. That is why the block is split.
;;==== AQP-D2 — URC_VacatePoolTfIds: both documented branches of the existence filter · 02 · let / invocation ==== 
(print "--- [AQP-D2 — URC_VacatePoolTfIds: both documented branches of the existence filter · 02 · let / invocation] ---")
(let
    (
        (ref-U|DALOS:module{UtilityDalosV2} U|DALOS)
        (ref-VCT:module{AcquisitionVacateV1} AQP-VCT)
        (ref-DPTF:module{DemiourgosPactTrueFungibleV2} DPTF)
        (ref-U|CT:module{OuronetConstantsV2} U|CT)
    )
    (map print
        [
            ;;BRANCH 1 — never frozen. UR_Frozen answers BAR and the counterpart is dropped.
            (expect "<<AQP-D2>> OURO has never been frozen, so UR_Frozen is the BAR sentinel"
                (ref-U|CT::CT_BAR) (ref-DPTF::UR_Frozen "OURO-98c486052a51"))
            (expect "<<AQP-D2>> ...so the vacate lane is the native id ALONE"
                ["OURO-98c486052a51"]
                (ref-VCT::URC_VacatePoolTfIds (ref-U|DALOS::UDC_Makeid "ResumeVacPool")))
        ]
    )
    ""
)
;;force the counterpart into existence -- the state no fixture in this harness produces
(env-module-admin DPTF)
(update DPTF.DPTF|PropertiesTable "OURO-98c486052a51" { "frozen-link" : "F|OURO-98c486052a51" })
(print "--- [AQP-D2 · 02 · with a frozen counterpart present] ---")
(let
    (
        (ref-U|DALOS:module{UtilityDalosV2} U|DALOS)
        (ref-VCT:module{AcquisitionVacateV1} AQP-VCT)
        (ref-DPTF:module{DemiourgosPactTrueFungibleV2} DPTF)
    )
    (let
        (
            (pool:string (ref-U|DALOS::UDC_Makeid "ResumeVacPool"))
        )
        (map print
            [
                (expect "<<AQP-D2>> with a frozen counterpart present, UR_Frozen answers it"
                    "F|OURO-98c486052a51" (ref-DPTF::UR_Frozen "OURO-98c486052a51"))
                ;;BRANCH 2 — the counterpart survives the filter and is APPENDED, native id first.
                ;;Order is asserted too: the @doc says native "(always)" then the F| one, and a
                ;;vacate walking these in the wrong order would drain the wrong lane first.
                (expect "<<AQP-D2>> ...and the lane becomes BOTH ids, native first"
                    ["OURO-98c486052a51" "F|OURO-98c486052a51"]
                    (ref-VCT::URC_VacatePoolTfIds pool))
                (expect "<<AQP-D2>> ...which is a two-element lane, not a replacement of the native one"
                    2 (length (ref-VCT::URC_VacatePoolTfIds pool)))
            ]
        )
    )
    ""
)
;;the forced frozen counterpart is discarded -- OURO leaves this suite exactly as it arrived
(rollback-tx)

;;|| NEXT >
;;
(begin-tx "AQP-D2b — the forced counterpart left no trace")
(namespace "ouronet-ns")
(print "--- [AQP-D2b · 01 · no leakage] ---")
;;AQP-D2 wrote a frozen counterpart onto OURO. Leaking that would make every later DPTF assertion
;;in a consolidated run read a token this suite invented, so the revert is asserted, not assumed.
(let
    (
        (ref-DPTF:module{DemiourgosPactTrueFungibleV2} DPTF)
        (ref-U|CT:module{OuronetConstantsV2} U|CT)
    )
    (map print
        [
            (expect "<<AQP-D2b>> OURO is un-frozen again"
                (ref-U|CT::CT_BAR) (ref-DPTF::UR_Frozen "OURO-98c486052a51"))
        ]
    )
    ""
)
(commit-tx)

;;|| NEXT >
;;
(begin-tx "AQP-D3 — XI_SetPoolFvtsVacateFrozen: the derivation, and the blast radius it claims")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(namespace "ouronet-ns")
(print "--- [AQP-D3 · 01 · which FVTs a pool's vacate freezes, and which it must not] ---")
;;DOC-CLAIM VERIFICATION (`_docclaims.py` G5). `06_VCT.pact` XI_SetPoolFvtsVacateFrozen:
;;
;;   "...on every FVT the vacating pool's employed scores link to: walk URC_PoolActiveScoreIds ->
;;    UR_SCR|ScoreFvtLink (BAR dropped) -> distinct FVTs -> FVT::XE_SetFvtVacateFrozen.
;;    Bounded (<=7 scores). THE FVTs ARE THE POOL'S OWN, SO THIS NEVER FREEZES ANOTHER POOL."
;;
;;The last sentence is the one that matters: this function freezes collect+inject, so an
;;over-broad derivation would silently halt earning on vaults belonging to pools that are not
;;vacating at all -- a denial-of-service reachable by any pool owner starting a vacate on their own
;;pool. Nothing tested the blast radius.
;;
;;Driven for real, not just derived: `AQP-VCT.SECURE` is `(defcap SECURE () true)`, so the writer
;;is reachable with `test-capability`, and the whole block is wrapped in `rollback-tx` so the
;;freeze flags it sets never reach a later assertion.
;;==== AQP-D3 — XI_SetPoolFvtsVacateFrozen: the derivation, and the blast radius it claims · 01 · env-sigs (caps) ==== 
(print "--- [AQP-D3 — XI_SetPoolFvtsVacateFrozen: the derivation, and the blast radius it claims · 01 · env-sigs (caps)] ---")
(env-sigs [{ "key": "PK_AncientHodler", "caps": [] }])
;;==== AQP-D3 — XI_SetPoolFvtsVacateFrozen: the derivation, and the blast radius it claims · 02 · let / invocation ==== 
(print "--- [AQP-D3 — XI_SetPoolFvtsVacateFrozen: the derivation, and the blast radius it claims · 02 · let / invocation] ---")
(let
    (
        (ref-U|DALOS:module{UtilityDalosV2} U|DALOS)
        (ref-AQP:module{AcquisitionPoolsV1} AQP-POOL)
        (ref-SCR:module{AcquisitionScoresV1} AQP-SCORE)
        (ref-FVT:module{AcquisitionFarmsVaultsTreasuriesV1} AQP-FVT)
        (ref-U|CT:module{OuronetConstantsV2} U|CT)
    )
    (let
        (
            (pool:string (ref-U|DALOS::UDC_Makeid "TfStakePool"))
            (other:string (ref-U|DALOS::UDC_Makeid "SfStakePool"))
        )
        (let
            (
                ;;the derivation, rebuilt here exactly as the @doc describes it
                (derived:[string]
                    (distinct
                        (filter (lambda (f:string) (!= f (ref-U|CT::CT_BAR)))
                            (map (lambda (s:string) (ref-SCR::UR_SCR|ScoreFvtLink s))
                                (ref-AQP::URC_PoolActiveScoreIds pool)))))
                (derived-other:[string]
                    (distinct
                        (filter (lambda (f:string) (!= f (ref-U|CT::CT_BAR)))
                            (map (lambda (s:string) (ref-SCR::UR_SCR|ScoreFvtLink s))
                                (ref-AQP::URC_PoolActiveScoreIds other)))))
            )
            (map print
                [
                    ;;"Bounded (<=7 scores)" -- the pool has at most 7 score slots, so the walk is
                    ;;O(1) and cannot fan out
                    (expect "<<AQP-D3>> the score walk is bounded at 7 slots, so the FVT set is too"
                        true (<= (length (ref-AQP::URC_PoolActiveScoreIds pool)) 7))
                    ;;"BAR dropped" and "distinct" -- both shape claims, both assertable
                    (expect "<<AQP-D3>> the derived FVT set drops BAR and de-duplicates"
                        true (and (not (contains (ref-U|CT::CT_BAR) derived))
                                  (= (length derived) (length (distinct derived)))))
                    ;;the premise for the blast-radius test: there IS a second pool with its own
                    ;;FVTs, so "never freezes another pool" has something to be false about
                    (expect "<<AQP-D3>> ...and it is non-empty, so the test is not vacuous"
                        true (> (length derived) 0))
                    (expect "<<AQP-D3>> a DIFFERENT pool derives a DIFFERENT FVT set"
                        true (!= derived derived-other))
                ]
            )
            ;;now actually run the writer and watch the blast radius
            (test-capability (AQP-VCT.SECURE))
            (AQP-VCT.XI_SetPoolFvtsVacateFrozen pool true)
            (map print
                [
                    ;;every FVT the derivation named is now frozen...
                    (expect "<<AQP-D3>> after the freeze, every derived FVT is frozen"
                        true (fold (and) true
                                (map (lambda (f:string) (ref-FVT::UR_FVT|VacateFrozen f)) derived)))
                    ;;...AND THE OTHER POOL'S ARE NOT. This is the claim the whole block exists for.
                    (expect "<<AQP-D3>> ...and NOT ONE of the other pool's FVTs was touched"
                        true (fold (and) true
                                (map (lambda (f:string) (not (ref-FVT::UR_FVT|VacateFrozen f)))
                                    (filter (lambda (f:string) (not (contains f derived)))
                                        derived-other))))
                ]
            )
            ;;and the documented inverse: false at finalize puts them back
            (AQP-VCT.XI_SetPoolFvtsVacateFrozen pool false)
            (map print
                [
                    (expect "<<AQP-D3>> the finalize call (frozen=false) unfreezes exactly the same set"
                        true (fold (and) true
                                (map (lambda (f:string) (not (ref-FVT::UR_FVT|VacateFrozen f))) derived)))
                ]
            )
        )
    )
    ""
)
(env-sigs [])
(rollback-tx)

;;|| NEXT >
;;
(begin-tx "AQP-F1 — RPS: the virtual-gas toggle family, the class-matched delta sum, and the two stake validators")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(namespace "ouronet-ns")
(print "--- [AQP-F1 · 01 · three RPS clusters that no test had ever called] ---")
;;FUNCTION COVERAGE (G6, Tier 1: RPS). `04_RPS.pact` is the single largest coverage gap in the
;;codebase and it is reward + billing math, so it is where an untested function can silently pay or
;;charge the wrong number. Three clusters here, each picked because it has a DIFFERENTIAL that a
;;single-call smoke test would miss.
;;
;;CLUSTER 1 — the virtual-gas toggle. `UC_GasPrice` is two lines ("Full price when live billing is
;;on (trigger=false); 0.0 when the gas toggle zeroes it") and three public tier readers are built on
;;it. Both arms are asserted: a one-armed test would pass on `(if trigger 0.0 0.0)`.
(let
    (
        (ref-IGNIS:module{IgnisCollectorV3} IGNIS)
    )
    (map print
        [
            (expect "<<AQP-F1>> UC_GasPrice passes the full price through when billing is LIVE"
                42.5 (RPS.UC_GasPrice 42.5 false))
            (expect "<<AQP-F1>> ...and zeroes it when the virtual-gas toggle is on"
                0.0 (RPS.UC_GasPrice 42.5 true))
            ;;the three tier readers are that function applied to a named IGNIS leg. Asserted as
            ;;equalities against the leg, so a tier silently re-pointed at the wrong leg fails here.
            (expect "<<AQP-F1>> the three tier readers are UC_GasPrice over their own named leg"
                [(RPS.UC_GasPrice (ref-IGNIS::UC_IgnisLeg "tier-medium")  (ref-IGNIS::URC_IsVirtualGasZero))
                 (RPS.UC_GasPrice (ref-IGNIS::UC_IgnisLeg "tier-biggest") (ref-IGNIS::URC_IsVirtualGasZero))
                 (RPS.UC_GasPrice 7.0 (ref-IGNIS::URC_IsVirtualGasZero))]
                [(RPS.URC_TierMedium) (RPS.URC_TierBiggest) (RPS.URC_TierFixed 7.0)])
            ;;...and the tiers are ORDERED and non-zero, so the equalities above are not all 0.0
            (expect "<<AQP-F1>> ...and biggest > medium > 0, so those equalities are not vacuous"
                true (and (> (RPS.URC_TierBiggest) (RPS.URC_TierMedium))
                          (> (RPS.URC_TierMedium) 0.0)))
        ]
    )
    ""
)
(print "--- [AQP-F1 · 02 · the class-matched phase-4 delta sum] ---")
;;CLUSTER 2 — `URC_StakeScoreDeltaSum` vs `URC_StakeScoreDeltaSumForClasses`. The second exists to
;;mirror XE_Apply{OrtoFungible,Collectable}StakeDelta, "which emit 0.0 for non-matching classes
;;(OF: {0,2}; SF: {3}; NF: {4})". The whole point is the FILTER, so the test is differential: the
;;same pool, asked for its own score class and then for one it does not hold.
(let
    (
        (ref-U|DALOS:module{UtilityDalosV2} U|DALOS)
        (ref-SCR:module{AcquisitionScoresV1} AQP-SCORE)
    )
    (let
        (
            (pool:string (ref-U|DALOS::UDC_Makeid "TfStakePool"))
            (tf-score:string (ref-U|DALOS::UDC_Makeid "TfStakeScore"))
        )
        (map print
            [
                ;;the premise: this pool's employed score is class 1
                (expect "<<AQP-F1>> TfStakePool's employed score is class 1"
                    1 (ref-SCR::UR_SCR|ScoreClass tf-score))
                ;;asking for class 1 returns the WHOLE ungated sum -- the filter admits everything
                (expect "<<AQP-F1>> ForClasses [1] equals the ungated sum: the filter admits the pool's own class"
                    (RPS.URC_StakeScoreDeltaSum pool)
                    (RPS.URC_StakeScoreDeltaSumForClasses pool [1]))
                ;;...and asking for a class it does not hold returns exactly 0.0
                (expect "<<AQP-F1>> ...while ForClasses [3] (semi-fungible) is 0.0 on a class-1 pool"
                    0.0 (RPS.URC_StakeScoreDeltaSumForClasses pool [3]))
                ;;the ungated sum is itself non-zero, so the equality above is discriminating
                (expect "<<AQP-F1>> ...and the ungated sum is non-zero, so that equality has content"
                    true (> (RPS.URC_StakeScoreDeltaSum pool) 0.0))
            ]
        )
    )
    ""
)
(print "--- [AQP-F1 · 03 · owner vs beneficiary: the validator that is strictly stricter] ---")
;;CLUSTER 3 — the two stake-account validators. They look like a pair but they are NOT symmetric:
;;    UEV_TrueFungibleStakeOwnerAccount        -> UEV_EnforceAccountExists
;;    UEV_TrueFungibleStakeBeneficiaryAccount  -> UEV_EnforceAccountExists + UEV_EnforceAccountType false
;;The beneficiary must additionally be a STANDARD (non-smart) account. A test that fed both a plain
;;account would pass on an implementation where the two were identical, so the input that matters is
;;a SMART account: it must clear the owner check and be refused by the beneficiary one.
(let
    (
        (ref-DPDC:module{DpdcV2} DPDC)
    )
    (let
        (
            (smart:string (ref-DPDC::GOV|DPDC|SC_NAME))
        )
        (map print
            [
                ;;both accept an ordinary activated account -- the shared half
                (expect "<<AQP-F1>> both validators accept an ordinary standard account"
                    "ok"
                    (let ((p1 (RPS.UEV_TrueFungibleStakeOwnerAccount KST.ANHD))
                          (p2 (RPS.UEV_TrueFungibleStakeBeneficiaryAccount KST.ANHD)))
                        "ok"))
                ;;THE ASYMMETRY: a smart account is a legal stake OWNER...
                (expect "<<AQP-F1>> a SMART account is accepted as a stake OWNER"
                    "ok"
                    (let ((p (RPS.UEV_TrueFungibleStakeOwnerAccount smart))) "ok"))
                ;;...but not a legal BENEFICIARY, which is the whole reason the second one exists
                (expect-failure "<<AQP-F1>> ...and REFUSED as a beneficiary -- the extra account-type check"
                    "Operation requires a Standard DALOS Account"
                    (RPS.UEV_TrueFungibleStakeBeneficiaryAccount smart))
                ;;and a non-existent account fails BOTH, on the shared existence check
                (expect-failure "<<AQP-F1>> a non-existent account fails the owner check too"
                    "DALOS Account doesnt exist"
                    (RPS.UEV_TrueFungibleStakeOwnerAccount "definitely-not-an-account"))
            ]
        )
    )
    ""
)
(commit-tx)

;;|| NEXT >
