(begin-tx "AQP-G5 — SCORE's NF-definition list alignment, in both definition modes")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
;;==== AQP-G5 — SCORE's NF-definition list alignment, in both definition modes · 01 · namespace ==== 
(print "--- [AQP-G5 — SCORE's NF-definition list alignment, in both definition modes · 01 · namespace] ---")
(namespace "ouronet-ns")
(print "--- [AQP-G5 · 01 · trait-mode and set-mode input alignment] ---")
;;P3.3, list-shape class. AQP-G3 pinned the BRANCH SELECTOR (trait xor set); these are the two
;;validators it dispatches to, and each opens with the same rule in its own words: the parallel
;;input lists must be NON-EMPTY and the SAME LENGTH.
;;
;;Both read the DPNF before enforcing -- set-mode reads UR_SetClassesUsed, trait-mode reads the
;;first nonce's metadata -- so unlike AQP-G3 these are not pure functions of their arguments and
;;need a real collection. DHB is minted by [6.2.4]_AQP-FVT-NF, which this tester's chain loads.
;;
;;Two rejections per validator, because the rule is a CONJUNCTION and one input cannot prove
;;both halves: an empty pair isolates the non-empty clause (lengths are equal, so alignment
;;cannot be what fires), and a mismatched pair isolates the alignment clause (both non-empty).
;;==== AQP-G5 — SCORE's NF-definition list alignment, in both definition modes · 02 · let / invocation ==== 
(print "--- [AQP-G5 — SCORE's NF-definition list alignment, in both definition modes · 02 · let / invocation] ---")
(let
    (
        (ref-DPDC:module{DpdcV2} DPDC)
        (ref-SCR:module{AcquisitionScoresV1} AQP-SCORE)
        (dhb:string "DHB-98c486052a51")
    )
    (map print
        [
            ;;precondition: the collection the validators read really is there
            (expect "<<AQP-G5>> DHB exists as a DPNF collection"
                true (!= "" (format "{}" [(ref-DPDC::UR_OwnerKonto dhb false)])))
            ;;--- SET mode
            (expect-failure "<<AQP-G5>> set mode refuses EMPTY nonce-class/score lists"
                "nonce-class and score value lists must be non-empty and aligned"
                (ref-SCR::UEV_NonFungibleScoreDefinitionSet dhb 6 [] []))
            (expect-failure "<<AQP-G5>> set mode refuses MISALIGNED lists (both non-empty)"
                "nonce-class and score value lists must be non-empty and aligned"
                (ref-SCR::UEV_NonFungibleScoreDefinitionSet dhb 6 [0] [1.0 2.0]))
            ;;--- TRAIT mode
            (expect-failure "<<AQP-G5>> trait mode refuses EMPTY key/value/score lists"
                "trait key/value/score lists must be non-empty and aligned"
                (ref-SCR::UEV_NonFungibleScoreDefinitionTrait dhb 6 [] [] []))
            (expect-failure "<<AQP-G5>> trait mode refuses MISALIGNED lists (keys non-empty)"
                "trait key/value/score lists must be non-empty and aligned"
                (ref-SCR::UEV_NonFungibleScoreDefinitionTrait dhb 6 ["rarity"] [] []))
        ]
    )
    ""
)
(commit-tx)

