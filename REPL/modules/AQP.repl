(begin-tx "AQP-F15 — VCT: the collectable leg validators and the nonce-leg array builders")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
;;==== AQP-F15 — VCT: the collectable leg validators and the nonce-leg array builders · 01 · namespace ==== 
(print "--- [AQP-F15 — VCT: the collectable leg validators and the nonce-leg array builders · 01 · namespace] ---")
(namespace "ouronet-ns")
(print "--- [AQP-F15 · 01 · the collectable twin of the all-or-nothing rule] ---")
;;FUNCTION COVERAGE (G6, Tier 1: VCT). The collectable-side vacate validators, none ever called.
;;They mirror the TF ones pinned in <<AQP-F14>>, over the live DPSF tracker row this suite holds
;;(SfStakePool / DHCD / ANHD / nonce 1 / 500 units), so the same all-or-nothing rule can be checked
;;on the nonce-keyed tables rather than only the amount-keyed one.
;;==== AQP-F15 — VCT: the collectable leg validators and the nonce-leg array builders · 02 · let / invocation ==== 
(print "--- [AQP-F15 — VCT: the collectable leg validators and the nonce-leg array builders · 02 · let / invocation] ---")
(let
    (
        (ref-U|DALOS:module{UtilityDalosV2} U|DALOS)
        (ref-VCT:module{AcquisitionVacateV1} AQP-VCT)
        (ref-AQP:module{AcquisitionPoolsV1} AQP-POOL)
        (dhcd:string "DHCD-98c486052a51")
    )
    (let
        (
            (pool:string (ref-U|DALOS::UDC_Makeid "SfStakePool"))
        )
        (let
            (
                (staked:decimal (ref-AQP::UR_AQP|DPSFTrackerBalance pool dhcd KST.ANHD KST.ANHD 1))
            )
            (map print
                [
                    ;;premise, read live
                    (expect "<<AQP-F15>> ANHD's DHCD nonce-1 leg really is staked at 500 units"
                        500.0 staked)
                    ;;=== A TAUTOLOGY, FOUND BY ASSERTING THE WRONG THING ===
                    ;;`URC_VacateCollectableLegBeneficiaryOk`'s @doc says "each nonce tracker row
                    ;;beneficiary-id must equal the supplied beneficiary-id", so I asserted it would
                    ;;REJECT a mismatched beneficiary. It does not, and cannot: <beneficiary-id> is a
                    ;;COMPONENT OF THE LOOKUP KEY, so the value compared against it is always itself
                    ;;-- the stored column when the row exists, and the echoed key when it does not
                    ;;(the key-echo default documented in <<AQP-F7>>). The function can only return
                    ;;true. The source now carries that note.
                    (expect "<<AQP-F15>> the beneficiary check is a TAUTOLOGY -- true even for a beneficiary that never staked"
                        [true true]
                        [(ref-VCT::URC_VacateCollectableLegBeneficiaryOk pool dhcd true KST.ANHD KST.ANHD [1])
                         (ref-VCT::URC_VacateCollectableLegBeneficiaryOk pool dhcd true KST.ANHD KST.EMMA [1])])
                    ;;...and true for a wholly fictional owner AND beneficiary, which is the clearest
                    ;;statement of it: nothing about the answer is evidence of anything.
                    (expect "<<AQP-F15>> ...and true for a leg whose every party is fictional"
                        true (ref-VCT::URC_VacateCollectableLegBeneficiaryOk pool dhcd true "ghost-o" "ghost-b" [1]))
                    ;;THE ORTOFUNGIBLE TWIN carries the identical tautology -- found by sweeping for
                    ;;other comparisons of a key-echo reader against its own key component. Both are
                    ;;now annotated at the source; pinned here so neither can be "fixed" into looking
                    ;;meaningful without the test noticing.
                    (expect "<<AQP-F15>> ...and the ORTO twin is a tautology in exactly the same way"
                        true (ref-VCT::URC_VacateOrtoLegBeneficiaryOk
                                 (U|DALOS.UDC_Makeid "OfStakePool") "MVST-98c486052a51" "ghost-o" "ghost-b" [1]))
                    ;;THE BINDING IS STILL ENFORCED, one conjunct over. A leg naming the wrong
                    ;;beneficiary addresses a DIFFERENT, absent tracker row whose balance is zero, so
                    ;;the SUFFICIENCY checks reject it on amount. That is the real protection, and
                    ;;asserting it here is what stops the tautology above reading as a hole.
                    (expect "<<AQP-F15>> ...while the SUFFICIENCY check does reject a wrong-beneficiary leg"
                        false (ref-VCT::URC_VacateCollectableNoncesSufficient pool dhcd true KST.ANHD KST.EMMA [1] [500]))
                    ;;ALL-OR-NOTHING again, now per nonce: the exact staked count is sufficient,
                    ;;one more is not
                    (expect "<<AQP-F15>> the exact staked nonce amount is sufficient; more is not"
                        [true false]
                        [(ref-VCT::URC_VacateCollectableNoncesSufficient pool dhcd true KST.ANHD KST.ANHD [1] [500])
                         (ref-VCT::URC_VacateCollectableNoncesSufficient pool dhcd true KST.ANHD KST.ANHD [1] [501])])
                    ;;and the rollup must cover it too -- a separate conjunct over a separate table,
                    ;;so a leg can be tracker-sufficient and still rollup-insufficient
                    (expect "<<AQP-F15>> the beneficiary rollup covers the exact amount, and not an inflated one"
                        [true false]
                        [(ref-VCT::URC_VacateCollectableRollupSufficient pool dhcd true KST.ANHD KST.ANHD [1] [500])
                         (ref-VCT::URC_VacateCollectableRollupSufficient pool dhcd true KST.ANHD KST.ANHD [1] [999999])])
                    ;;the composite validator over the same leg, both ways
                    (expect "<<AQP-F15>> the composite collectable leg check agrees with its parts"
                        [true false]
                        [(ref-VCT::URC_VacateCollectableLegsOk pool dhcd true [KST.ANHD] [KST.ANHD] [[1]] [[500]])
                         (ref-VCT::URC_VacateCollectableLegsOk pool dhcd true [KST.ANHD] [KST.ANHD] [[1]] [[501]])])
                ]
            )
        )
    )
    ""
)
(print "--- [AQP-F15 · 02 · the nonce-leg array builders, and the drain previews] ---")
;;`UC_Vacate{Of,Collectable}LegsToVacateArrays` project a list of leg objects into the four parallel
;;arrays the bulk writers consume. The projection is the place a column can be dropped or two swapped
;;-- all four arrays are built from the same list by four separate `map`s -- so each is checked
;;against the legs it came from.
(let
    (
        (ref-U|DALOS:module{UtilityDalosV2} U|DALOS)
        (ref-VCT:module{AcquisitionVacateV1} AQP-VCT)
        (dhcd:string "DHCD-98c486052a51")
        (mvst:string "MVST-98c486052a51")
    )
    (let
        (
            (sf-pool:string (ref-U|DALOS::UDC_Makeid "SfStakePool"))
            (of-pool:string (ref-U|DALOS::UDC_Makeid "OfStakePool"))
            (legs:[object]
                [(ref-VCT::UDC_VacateNonceLeg KST.ANHD KST.EMMA [1 2] [10.0 20.0])
                 (ref-VCT::UDC_VacateNonceLeg KST.EMMA KST.LUMY [3] [30.0])])
        )
        (map print
            [
                ;;OF projection: four arrays, each in leg order, each from its own column
                (expect "<<AQP-F15>> the OF leg projection keeps owner, beneficiary, nonces and amounts aligned"
                    { "owner-ids"          : [KST.ANHD KST.EMMA]
                    , "beneficiary-ids"    : [KST.EMMA KST.LUMY]
                    , "nonces-array"       : [[1 2] [3]]
                    , "nonce-amounts-array": [[10.0 20.0] [30.0]] }
                    (ref-VCT::UC_VacateOfLegsToVacateArrays legs))
                ;;COLLECTABLE projection: same three string/nonce columns, but amounts are floored to
                ;;INTEGERS for the DPDC-T bulk path -- which is the one real difference between the two
                (expect "<<AQP-F15>> the COLLECTABLE projection is the same, with amounts floored to integers"
                    [[KST.ANHD KST.EMMA] [[1 2] [3]] [[10 20] [30]]]
                    (let ((a (ref-VCT::UC_VacateCollectableLegsToVacateArrays legs)))
                        [(at "owner-ids" a) (at "nonces-array" a) (at "amounts-array" a)]))
                ;;...and both are total on an empty leg list, which is the edge the four sibling
                ;;functions were made total for in <<AQP-F6>>
                (expect "<<AQP-F15>> ...and both projections are total on an empty leg list"
                    [[] []]
                    [(at "owner-ids" (ref-VCT::UC_VacateOfLegsToVacateArrays []))
                     (at "owner-ids" (ref-VCT::UC_VacateCollectableLegsToVacateArrays []))])
                ;;the two drain cost previews price a real leg above zero, and scale with leg count
                (expect "<<AQP-F15>> both drain previews price a batch above zero and scale with it"
                    [true true]
                    [(> (ref-VCT::URCi_BatchDrainOrtoFungible of-pool mvst legs) 0.0)
                     (> (ref-VCT::URCi_BatchDrainCollectable sf-pool dhcd true legs)
                        (ref-VCT::URCi_BatchDrainCollectable sf-pool dhcd true (take 1 legs)))])
            ]
        )
    )
    ""
)
(commit-tx)

