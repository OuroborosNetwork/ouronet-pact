;;
(begin-tx "AQP-G37 — four ANK admission guards, none of which needed a fixture")
(env-gasmodel "table")(env-gaslimit 150000000)(env-gas 0)
(namespace "ouronet-ns")
;;==== AQP-G37 — four ANK admission guards, none of which needed a fixture · 01 · env-sigs (caps) ==== 
(print "--- [AQP-G37 — four ANK admission guards, none of which needed a fixture · 01 · env-sigs (caps)] ---")
(env-sigs [{ "key": "PK_AncientHodler", "caps": [] }])
(print "--- [AQP-G37 · 01 · what may carry an anchor] ---")
;;Four unpinned guards in 01_ANK.pact, and the chain this file builds already satisfies every one of
;;them. Three are pure argument-domain; the fourth needed a boost class that is empty AND inactive, and
;;this suite leaves eight of those lying around (CoreBoostTFa..g and TempClassTF). Nothing had called
;;any of them.
;;==== AQP-G37 — four ANK admission guards, none of which needed a fixture · 02 · let / invocation ==== 
(print "--- [AQP-G37 — four ANK admission guards, none of which needed a fixture · 02 · let / invocation] ---")
(let
    (
        (ref-ANK:module{AcquisitionAnchorsV1} AQP-ANK)
        (ref-DPDC:module{DpdcV2} DPDC)
        (ref-TS02-C3:module{TalosStageTwo_ClientThreeV1} TS02-C3)
        (bc:string "TfStakeBoost-98c486052a51")
        (nf:string "TNF-98c486052a51")
        (lp:string "S|DLK-98c486052a51|OURO-98c486052a51|DWK-98c486052a51")
    )
    ;;GUARD 1 -- ANK|C>ISSUE-DPTF refuses LP and special tokens as anchor subjects. The test is on the
    ;;id's SHAPE: the 4th character must not be a bar (which is what a special-of-a-prefixed-token
    ;;looks like) and the first two must not be "S|". An LP id fails the second.
    ;;
    ;;The shape components are asserted alongside the refusal, because the guard is a `fold (and)` over
    ;;several conditions that all share one message -- without this, the refusal alone would not say
    ;;WHICH conjunct answered.
    (map print
        [
            (expect "<<AQP-G37>> the LP id starts with S| and so is excluded by shape"
                ["S|" true] [(take 2 lp) (!= "|" (drop 3 (take 4 lp)))])
            (expect-failure "<<AQP-G37>> an LP token cannot carry a DPTF anchor"
                "Anchor cannot be issued for the DPTF S|DLK-98c486052a51|OURO-98c486052a51|DWK-98c486052a51."
                (ref-TS02-C3::AQP-ANK|C_IssueTrueFungibleAnchor
                    KST.ANHD KST.ANHD "Probe1" lp false bc 3 10.0 1.0))
        ]
    )
    (print "--- [AQP-G37 · 02 · the DPNF trait and nonce-class domains] ---")
    ;;GUARD 2 -- ANK|C>ISSUE-DPNF requires the trait KEY to exist in the collection's metadata and the
    ;;trait VALUE to be at least 2 characters. One message covers both, so the absence of the key is
    ;;asserted separately -- otherwise a passing test proves only that *something* was wrong.
    (map print
        [
            (expect "<<AQP-G37>> the probe trait key is genuinely absent from the collection metadata"
                false (contains "no-such-key"
                    (format "{}" [(ref-DPDC::UR_NativeNonceData nf false 1)])))
            (expect-failure "<<AQP-G37>> a trait anchor on a key the collection does not have is refused"
                "Invalid Non-Fungible Key or Invalid Promile DPNF Trait-Value"
                (ref-TS02-C3::AQP-ANK|C_IssueNonFungibleAnchor
                    KST.ANHD KST.ANHD "Probe2" nf false bc 3 10.0 "no-such-key" "x"))
        ]
    )
    ;;GUARD 3 -- ANK|C>ISSUE-DPNF-SET bounds the nonce-class to [0, classes-used]. BOTH ends are driven,
    ;;and the upper one is read from the collection rather than hardcoded: a constant here would stop
    ;;testing the rule the day a set-class is added.
    (let ((cu:integer (ref-DPDC::UR_SetClassesUsed nf false)))
        (map print
            [
                (expect "<<AQP-G37>> the collection reports how many set-classes it uses"
                    true (>= cu 0))
                (expect-failure "<<AQP-G37>> a negative nonce-class is refused, and quoted back"
                    "Invalid DPNF nonce-class -1 for collection TNF-98c486052a51."
                    (ref-TS02-C3::AQP-ANK|C_IssueNonFungibleSetAnchor
                        KST.ANHD KST.ANHD "Probe3" nf false bc 3 10.0 -1))
                (expect-failure "<<AQP-G37>> ...and so is one past the classes the collection uses"
                    "Invalid DPNF nonce-class"
                    (ref-TS02-C3::AQP-ANK|C_IssueNonFungibleSetAnchor
                        KST.ANHD KST.ANHD "Probe4" nf false bc 3 10.0 (+ cu 1)))
            ]
        )
    )
    (print "--- [AQP-G37 · 03 · revoking a boost class that is already inactive] ---")
    ;;GUARD 4 -- ANK|C>REVOKE-BOOST-CLASS has TWO enforces in sequence and the first fronts the second:
    ;;    (= (at "anchors" bc) 0)   "… BoostClass … not empty"      <- already pinned elsewhere
    ;;    (at "class-active" bc)    "… BoostClass … already inactive"
    ;;so reaching the second needs a class that is EMPTY and ALREADY INACTIVE. This suite leaves eight
    ;;in exactly that state; `TempClassTF` is one, and its state is asserted first so the refusal is
    ;;attributable to the flag rather than to the anchor count.
    ;;
    ;;(The message begins with an object dump, not a label -- see AQP-G35 · 02 for that finding. The
    ;;expected string below therefore starts after the prefix.)
    (let ((tc:string "TempClassTF-98c486052a51"))
        (map print
            [
                (expect "<<AQP-G37>> TempClassTF is empty AND already inactive"
                    [0 false]
                    [(at "anchors" (ref-ANK::UR_BC|Data tc))
                     (at "class-active" (ref-ANK::UR_BC|Data tc))])
                (expect-failure "<<AQP-G37>> ...so revoking it again is refused as already inactive"
                    "BoostClass TempClassTF-98c486052a51 already inactive"
                    (ref-TS02-C3::AQP-ANK|C_RevokeBoostClass KST.ANHD tc))
                ;;...and an ACTIVE class is refused by the OTHER guard instead, which locates the
                ;;boundary between the two: TfStakeBoost is active but carries an anchor.
                (expect-failure "<<AQP-G37>> ...while an ACTIVE class with an anchor hits the first guard"
                    "BoostClass TfStakeBoost-98c486052a51 not empty"
                    (ref-TS02-C3::AQP-ANK|C_RevokeBoostClass KST.ANHD bc))
            ]
        )
    )
    ""
)
(env-sigs [])
(commit-tx)

;;|| NEXT >
