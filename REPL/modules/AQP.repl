(begin-tx "AQP-G19 — the pool/score wiring validators, called directly")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(namespace "ouronet-ns")
(print "--- [AQP-G19 · 01 · pool issue, score slots, staked legs] ---")
;;Five guards, all on ordinary UEV_ functions — no capability, no Talos shell, just a call with a
;;malformed argument against the live pool and score this suite already holds.
;;
;;UEV_IssuePoolClassAndAsset is driven TWICE and the pair is the interesting part. Its two enforces
;;look similar and mean different things: the first rejects a class outside the enum; the second
;;rejects an asset that is the WRONG KIND for an otherwise-valid class. OURO is a perfectly good
;;asset — it just is not a liquidity asset, so offering it to class 0 trips the second guard while
;;class 9 trips the first. One input would have proved only one of them.
;;==== AQP-G19 — the pool/score wiring validators, called directly · 01 · env-sigs (caps) ==== ====
(print "--- [AQP-G19 — the pool/score wiring validators, called directly · 01 · env-sigs (caps)] ---")
(env-sigs [{ "key": "PK_AncientHodler", "caps": [] }])
(let*
    (
        (ref-U|DALOS:module{UtilityDalosV2} U|DALOS)
        (ref-AQP:module{AcquisitionPoolsV1} AQP-POOL)
        (pool:string (ref-U|DALOS::UDC_Makeid "ResumeVacPool"))
        (score:string (ref-U|DALOS::UDC_Makeid "SfStakeScore"))
    )
    (map print
        [
            ;;--- the RESERVED-token stake ban. A reserved (R|) DPTF is a pool's own locked
            ;;backing, so staking one would let a user earn rewards on collateral that is not
            ;;theirs. Same rule as AQP-VCT's vacate ban pinned in AQP-G7 — two separate guards in
            ;;two modules guarding the two ends of the same position.
            (expect-failure "<<AQP-G19>> a RESERVED (R|) DPTF cannot be staked"
                "Reserved DPTF (R|) cannot be staked"
                (ref-AQP::UEV_StakeTrueFungibleDptfLeg "R|OURO-98c486052a51"))
            ;;and an ordinary DPTF passes the prefix test and goes on to the existence check, so
            ;;the guard is not simply refusing everything
            (expect "<<AQP-G19>> ...while the ordinary form of the same token is accepted"
                true (!= "" (format "{}"
                    [(ref-AQP::UEV_StakeTrueFungibleDptfLeg "OURO-98c486052a51")])))
            ;;--- pool issuance: class enum, then asset-kind-for-class
            (expect-failure "<<AQP-G19>> an aqp-class outside the enum is refused"
                "Invalid pool issue aqp-class or asset-id"
                (ref-AQP::UEV_IssuePoolClassAndAsset 9 "OURO-98c486052a51"))
            (expect-failure "<<AQP-G19>> ...and a valid class offered the wrong KIND of asset is refused"
                "Invalid pool issue asset-id for aqp-class"
                (ref-AQP::UEV_IssuePoolClassAndAsset 0 "OURO-98c486052a51"))
            ;;--- score slots. A pool has a fixed number of score slots; 99 is not one of them.
            (expect-failure "<<AQP-G19>> a score slot index outside the pool's range is refused"
                "Invalid or unavailable score slot index for pool"
                (ref-AQP::UEV_AddScorePoolAndScore pool score 99))
            ;;--- and revoking a score that was never assigned to this pool
            (expect-failure "<<AQP-G19>> revoking a score that is not assigned to the pool is refused"
                "Invalid score revoke for pool (slot, aqpool-link, zero totals, fvt-link, or boost-link dependents)"
                (ref-AQP::UEV_RevokeScorePoolAndScore pool score 0))
        ]
    )
    ""
)
(env-sigs [])
(commit-tx)

