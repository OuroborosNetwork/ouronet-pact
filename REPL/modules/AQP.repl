(begin-tx "AQP-F3 — VCT: the pure vacate shape-converters, on the edges that bit")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
;;==== AQP-F3 — VCT: the pure vacate shape-converters, on the edges that bit · 01 · namespace ==== 
(print "--- [AQP-F3 — VCT: the pure vacate shape-converters, on the edges that bit · 01 · namespace] ---")
(namespace "ouronet-ns")
(print "--- [AQP-F3 · 01 · the decimal→integer row converters, now a single implementation] ---")
;;FUNCTION COVERAGE (G6, Tier 1: VCT). The `UC_Vacate*` / `UC_*AmountsRow*` family are PURE shape
;;transforms with no table reads -- the cheapest functions in the module to test and the easiest
;;place for a silent transposition or an off-by-one to survive. None had ever been called.
;;
;;A REAL DEFECT CAME OUT OF WRITING THIS. `UC_VacateDecimalAmountsToIntegers` and
;;`UC_DecimalAmountsRowToInt` do the identical job -- floor a decimal row to integers -- and returned
;;identical results on every non-empty input. On the EMPTY list they did not:
;;
;;    UC_DecimalAmountsRowToInt        []  ->  []
;;    UC_VacateDecimalAmountsToIntegers []  ->  FAULT, "Array index out of bounds. Length (0), Index (0)"
;;
;;because the second indexed its own argument through `(enumerate 0 (- (length amounts) 1))`, and
;;`(enumerate 0 -1)` in Pact is the DESCENDING PAIR `[0, -1]`, not the empty list. It was NOT a live
;;bug -- `UC_MergeVacateNonceRowIntoLegs` always builds legs with at least one element and only
;;appends, so an empty amounts row is unreachable -- but it was a footgun armed for whoever next
;;changed the leg builder. The function now delegates to its twin, so there is one implementation.
;;These assertions are what hold it there.
;;==== AQP-F3 — VCT: the pure vacate shape-converters, on the edges that bit · 02 · let / invocation ==== 
(print "--- [AQP-F3 — VCT: the pure vacate shape-converters, on the edges that bit · 02 · let / invocation] ---")
(let
    (
        (ref-VCT:module{AcquisitionVacateV1} AQP-VCT)
    )
    (map print
        [
            ;;the two are now the SAME function, so they agree everywhere -- including the empty list
            (expect "<<AQP-F3>> both row converters agree on a normal row"
                [1 2 -1]
                (ref-VCT::UC_VacateDecimalAmountsToIntegers [1.9 2.1 -0.5]))
            (expect "<<AQP-F3>> ...and they agree with each other, element for element"
                (ref-VCT::UC_DecimalAmountsRowToInt [1.9 2.1 -0.5])
                (ref-VCT::UC_VacateDecimalAmountsToIntegers [1.9 2.1 -0.5]))
            ;;THE EDGE THAT WAS BROKEN: an empty row is now the empty row, in BOTH. Before the fix
            ;;the second of these faulted.
            (expect "<<AQP-F3>> an EMPTY row converts to an empty row -- no longer a fault"
                [] (ref-VCT::UC_VacateDecimalAmountsToIntegers []))
            (expect "<<AQP-F3>> ...matching its twin, which was always total"
                [] (ref-VCT::UC_DecimalAmountsRowToInt []))
            ;;`floor` on a NEGATIVE rounds AWAY from zero (-0.5 -> -1), not toward it. Pinned because
            ;;"whole units" reads as truncation, and a tracker balance that ever went slightly
            ;;negative would be converted to a MORE negative integer, not to 0.
            (expect "<<AQP-F3>> floor rounds negatives DOWN (-0.5 -> -1), it does not truncate toward zero"
                [-1 -1 0] (ref-VCT::UC_DecimalAmountsRowToInt [-0.5 -1.0 0.9]))
            ;;the zero-row builder is length-preserving and value-independent
            (expect "<<AQP-F3>> UC_ZeroIntAmountsRow matches its input's LENGTH and zeroes the values"
                [0 0 0] (ref-VCT::UC_ZeroIntAmountsRow [7 8 9]))
            (expect "<<AQP-F3>> ...and an empty nonce row gives an empty amount row"
                [] (ref-VCT::UC_ZeroIntAmountsRow []))
        ]
    )
    ""
)
(print "--- [AQP-F3 · 02 · the all-zero sentinel, including its empty-matrix answer] ---")
;;`URC_NonceAmountsAreZeroSentinel` is the OF marker -- "true when every amount across the matrix is
;;0 (OF vacate carries no per-nonce amount)". It is a `fold (and) true` over a `map`, so the EMPTY
;;matrix answers TRUE: an OF vacate with no legs at all reads as "the sentinel holds". That is
;;vacuous-true rather than wrong, but it is the kind of answer a caller can misread as "this is an
;;OF vacate" when in fact there is nothing to vacate, so it is pinned explicitly.
(let
    (
        (ref-VCT:module{AcquisitionVacateV1} AQP-VCT)
    )
    (map print
        [
            (expect "<<AQP-F3>> an all-zero matrix is the sentinel"
                true (ref-VCT::URC_NonceAmountsAreZeroSentinel [[0 0] [0 0 0]]))
            ;;one non-zero anywhere breaks it -- including in a LATER row, which a fold that
            ;;short-circuited on the first row would miss
            (expect "<<AQP-F3>> ...and a single non-zero in a LATER row breaks it"
                false (ref-VCT::URC_NonceAmountsAreZeroSentinel [[0 0] [0 1]]))
            (expect "<<AQP-F3>> ...as does one in the FIRST row"
                false (ref-VCT::URC_NonceAmountsAreZeroSentinel [[1 0] [0 0]]))
            ;;the vacuous-true edge, stated rather than discovered later
            (expect "<<AQP-F3>> an EMPTY matrix answers TRUE -- vacuously, which callers must not read as 'is OF'"
                true (ref-VCT::URC_NonceAmountsAreZeroSentinel []))
            ;;...and a matrix of empty rows likewise
            (expect "<<AQP-F3>> ...and so does a matrix of empty rows"
                true (ref-VCT::URC_NonceAmountsAreZeroSentinel [[] []]))
        ]
    )
    ""
)
(commit-tx)

;;|| NEXT >
