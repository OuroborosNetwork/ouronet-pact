(begin-tx "AQP-F4 — AQP: the M5 cross-pool stake scans, owner side against beneficiary side")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
;;==== AQP-F4 — AQP: the M5 cross-pool stake scans, owner side against beneficiary side · 01 · namespace ==== 
(print "--- [AQP-F4 — AQP: the M5 cross-pool stake scans, owner side against beneficiary side · 01 · namespace] ---")
(namespace "ouronet-ns")
(print "--- [AQP-F4 · 01 · the same leg, seen from both ends] ---")
;;FUNCTION COVERAGE (G6, Tier 1: AQP). `URH_AQP|{Dptf,Dpof,Dpsf,Dpnf}StakesBy{Owner,Beneficiary}` are
;;the M5 UI observability scans -- eight functions, four symmetric pairs, NONE of them ever called
;;from a test. They are what a wallet uses to show "your stakes", so a scan that silently drops a
;;leg makes a position invisible to the person who owns it.
;;
;;THE PAIRING IS THE TEST. Each pair walks the SAME tracker rows from opposite ends: the owner-side
;;row names the beneficiary, the beneficiary-side row names the owner, and everything else (pool,
;;token, balance) must be identical. Two independently-written scans that must agree is a far
;;stronger check than either one asserted against a hand-written expectation, and it needs no new
;;fixture: this suite already holds a SELF-stake (owner = beneficiary = ANHD), which is the case
;;where both scans must return the very same leg.
;;==== AQP-F4 — AQP: the M5 cross-pool stake scans, owner side against beneficiary side · 02 · let / invocation ==== 
(print "--- [AQP-F4 — AQP: the M5 cross-pool stake scans, owner side against beneficiary side · 02 · let / invocation] ---")
(let
    (
        (ref-AQP:module{AcquisitionPoolsV1} AQP-POOL)
    )
    (let
        (
            (by-owner:[object] (ref-AQP::URH_AQP|DptfStakesByOwner KST.ANHD))
            (by-ben:[object]   (ref-AQP::URH_AQP|DptfStakesByBeneficiary KST.ANHD))
        )
        (map print
            [
                ;;non-vacuity first: there IS a leg to see. Without this the symmetry below is
                ;;"[] equals []", which every broken scan also satisfies.
                (expect "<<AQP-F4>> ANHD really does hold a TF stake leg, seen from both ends"
                    [true true]
                    [(> (length by-owner) 0) (> (length by-ben) 0)])
                ;;the two views agree on COUNT...
                (expect "<<AQP-F4>> the owner-side and beneficiary-side scans see the same NUMBER of legs"
                    (length by-owner) (length by-ben))
                ;;...and on the shared columns, leg by leg
                (expect "<<AQP-F4>> ...and on the pool, the token and the balance of each leg"
                    (map (lambda (r:object) [(at "pool-id" r) (at "dptf-id" r) (at "balance" r)]) by-owner)
                    (map (lambda (r:object) [(at "pool-id" r) (at "dptf-id" r) (at "balance" r)]) by-ben))
                ;;THE CROSS-REFERENCE: on a self-stake the owner-side row must name ANHD as the
                ;;beneficiary, and the beneficiary-side row must name ANHD as the owner. A scan that
                ;;projected the wrong column would pass every assertion above and fail here.
                (expect "<<AQP-F4>> the owner-side row names the BENEFICIARY, and it is ANHD (a self-stake)"
                    [KST.ANHD] (map (lambda (r:object) (at "beneficiary-id" r)) by-owner))
                (expect "<<AQP-F4>> ...and the beneficiary-side row names the OWNER, also ANHD"
                    [KST.ANHD] (map (lambda (r:object) (at "owner-id" r)) by-ben))
                ;;the documented filter: "balance>0". A scan that returned emptied legs would show a
                ;;user positions they have already withdrawn.
                (expect "<<AQP-F4>> every returned leg has a POSITIVE balance, as documented"
                    true (fold (and) true (map (lambda (r:object) (> (at "balance" r) 0.0)) by-owner)))
                ;;an account with no legs gets the empty list, not an abort -- these are UI readers
                ;;and a wallet must be able to ask about a fresh account
                (expect "<<AQP-F4>> ...and an account with no stakes reads as the empty list, not an abort"
                    [0 0]
                    [(length (ref-AQP::URH_AQP|DptfStakesByOwner "definitely-not-a-staker"))
                     (length (ref-AQP::URH_AQP|DptfStakesByBeneficiary "definitely-not-a-staker"))])
            ]
        )
    )
    ""
)
(print "--- [AQP-F4 · 02 · the other three asset families, same symmetry] ---")
;;The remaining three pairs are the same shape over DPOF / DPSF / DPNF trackers. ANHD holds a
;;collectable leg and no orto/non-fungible ones in this suite, so the sweep below asserts the
;;symmetry across all four families at once -- the pairs must agree whether or not they are empty,
;;and the empty ones still prove the two scans do not disagree about ABSENCE.
(let
    (
        (ref-AQP:module{AcquisitionPoolsV1} AQP-POOL)
    )
    (map print
        [
            (expect "<<AQP-F4>> all four owner/beneficiary scan pairs agree on leg count for ANHD"
                [true true true true]
                [(= (length (ref-AQP::URH_AQP|DptfStakesByOwner KST.ANHD))
                    (length (ref-AQP::URH_AQP|DptfStakesByBeneficiary KST.ANHD)))
                 (= (length (ref-AQP::URH_AQP|DpofStakesByOwner KST.ANHD))
                    (length (ref-AQP::URH_AQP|DpofStakesByBeneficiary KST.ANHD)))
                 (= (length (ref-AQP::URH_AQP|DpsfStakesByOwner KST.ANHD))
                    (length (ref-AQP::URH_AQP|DpsfStakesByBeneficiary KST.ANHD)))
                 (= (length (ref-AQP::URH_AQP|DpnfStakesByOwner KST.ANHD))
                    (length (ref-AQP::URH_AQP|DpnfStakesByBeneficiary KST.ANHD)))])
            ;;...and the collectable pair is NOT one of the empty ones, so at least two families
            ;;above are carrying real rows rather than agreeing trivially
            (expect "<<AQP-F4>> ...and the DPSF pair is non-empty, so that sweep is not all-empty agreement"
                true (> (length (ref-AQP::URH_AQP|DpsfStakesByOwner KST.ANHD)) 0))
        ]
    )
    ""
)
(commit-tx)

;;|| NEXT >
