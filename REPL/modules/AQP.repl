(begin-tx "AQP-F16 — the ownership caps and leg validators, each on both sides of its gate")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(namespace "ouronet-ns")
(print "--- [AQP-F16 · 01 · the four ownership caps, signed and unsigned] ---")
;;FUNCTION COVERAGE (G6, Tier 1). Four `CAP_*` ownership gates across AQP and VCT, none ever called.
;;Each is a thin delegation to `DALOS::CAP_EnforceAccountOwnership` over a DIFFERENT resolution of
;;"who owns this" -- and the resolution is the part worth testing, because a cap pointed at the
;;wrong konto still enforces ownership, just of the wrong account.
;;
;;THE SIGNATURE IS THE DIFFERENTIAL. These are the only functions in this phase whose behaviour
;;depends on `env-sigs`, so each is driven twice: once signed by the real owner (passes) and once
;;with NO signature at all (refuses). A cap tested only while signed is indistinguishable from a
;;no-op -- which, as <<AQP-F15>> just showed, is a live hazard in this module.
;;==== AQP-F16 — the ownership caps and leg validators, each on both sides of its gate · 01 · env-sigs (caps) ==== 
(print "--- [AQP-F16 — the ownership caps and leg validators, each on both sides of its gate · 01 · env-sigs (caps)] ---")
(env-sigs [{ "key": "PK_AncientHodler", "caps": [] }])
;;==== AQP-F16 — the ownership caps and leg validators, each on both sides of its gate · 02 · let / invocation ==== 
(print "--- [AQP-F16 — the ownership caps and leg validators, each on both sides of its gate · 02 · let / invocation] ---")
(let
    (
        (ref-U|DALOS:module{UtilityDalosV2} U|DALOS)
        (ref-AQP:module{AcquisitionPoolsV1} AQP-POOL)
        (ref-VCT:module{AcquisitionVacateV1} AQP-VCT)
        (ouro:string "OURO-98c486052a51")
    )
    (let
        (
            (pool:string (ref-U|DALOS::UDC_Makeid "DrainVacPool"))
        )
        (map print
            [
                ;;all four pass while ANHD is signed. `CAP_AqpAssetOwner` is checked at class 1
                ;;(DPTF), which resolves the owner through DPTF::UR_Konto rather than the pool row.
                (expect "<<AQP-F16>> all four ownership caps pass for the signed owner"
                    "granted"
                    (let ((a (ref-AQP::CAP_PoolOwner pool))
                          (b (ref-AQP::CAP_StakeOwner KST.ANHD))
                          (c (ref-AQP::CAP_AqpAssetOwner 1 ouro))
                          (d (ref-VCT::CAP_VctVacatePoolOwner pool)))
                        "granted"))
                ;;...and the konto it resolves to is a SMART account, not ANHD directly. That was a
                ;;surprise worth keeping: DrainVacPool's canonical asset is owned by a smart account
                ;;whose governor ANHD controls, so the pass above is NOT "ANHD owns it" -- it is the
                ;;governor chain being walked. Pinned by shape rather than by value, since the
                ;;principal is 200-odd characters and hardcoding it would rot on any rotation.
                (expect "<<AQP-F16>> ...and the konto it resolves to is a SMART account, reached via its governor"
                    "Σ." (take 2 (ref-AQP::URC_AqpOwnerKonto pool)))
                (expect "<<AQP-F16>> ...which is NOT ANHD itself, so the pass above walked the governor chain"
                    false (= KST.ANHD (ref-AQP::URC_AqpOwnerKonto pool)))
            ]
        )
    )
    ""
)
;;--- the same four with NO signature: every one must refuse
(env-sigs [])
(let
    (
        (ref-U|DALOS:module{UtilityDalosV2} U|DALOS)
        (ref-AQP:module{AcquisitionPoolsV1} AQP-POOL)
        (ref-VCT:module{AcquisitionVacateV1} AQP-VCT)
        (ouro:string "OURO-98c486052a51")
    )
    (let
        (
            (pool:string (ref-U|DALOS::UDC_Makeid "DrainVacPool"))
        )
        (map print
            [
                ;;THE TWO ACCOUNT KINDS FAIL DIFFERENTLY, which is the real content here and was
                ;;not something I expected. A SMART account's ownership is verified through its
                ;;governor and reports "Ownership could not be verified"; a STANDARD account's is a
                ;;plain keyset check and reports a keyset failure. Three of these four caps resolve
                ;;to the smart konto; CAP_StakeOwner is handed ANHD directly and takes the other path.
                (expect-failure "<<AQP-F16>> CAP_PoolOwner refuses an unsigned caller (smart-account path)"
                    "Ownership could not be verified" (ref-AQP::CAP_PoolOwner pool))
                (expect-failure "<<AQP-F16>> CAP_AqpAssetOwner likewise"
                    "Ownership could not be verified" (ref-AQP::CAP_AqpAssetOwner 1 ouro))
                (expect-failure "<<AQP-F16>> CAP_VctVacatePoolOwner likewise"
                    "Ownership could not be verified" (ref-VCT::CAP_VctVacatePoolOwner pool))
                ;;...and the STANDARD-account cap fails on the keyset instead, which is what shows
                ;;the three above are exercising the governor path and not a shared code route
                (expect-failure "<<AQP-F16>> ...while CAP_StakeOwner on a STANDARD account fails on the keyset"
                    "Keyset failure" (ref-AQP::CAP_StakeOwner KST.ANHD))
            ]
        )
    )
    ""
)
(print "--- [AQP-F16 · 02 · the stake leg / account validators] ---")
;;`UEV_StakeOrtoFungibleDpofLeg` and `UEV_StakeCollectableLeg` delegate to their asset modules'
;;`UEV_id`; `UEV_StakeBeneficiaryAccount` adds the standard-account rule on top of existence. Each
;;is driven on a real id and a bad one, so the delegation is shown to actually reach the validator.
(let
    (
        (ref-AQP:module{AcquisitionPoolsV1} AQP-POOL)
        (ref-DPDC:module{DpdcV2} DPDC)
        (mvst:string "MVST-98c486052a51")
        (dhcd:string "DHCD-98c486052a51")
    )
    (map print
        [
            ;;real ids pass
            (expect "<<AQP-F16>> a real DPOF and a real DPSF pass their leg validators"
                "ok"
                (let ((a (ref-AQP::UEV_StakeOrtoFungibleDpofLeg mvst))
                      (b (ref-AQP::UEV_StakeCollectableLeg dhcd true)))
                    "ok"))
            ;;...and an id that no chain can hold is refused by each
            (expect-failure "<<AQP-F16>> a non-existent ortofungible id is refused"
                "DPOF ID NOSUCHOF-98c486052a51 does not exist"
                (ref-AQP::UEV_StakeOrtoFungibleDpofLeg "NOSUCHOF-98c486052a51"))
            (expect-failure "<<AQP-F16>> ...and a non-existent collectable id likewise"
                "DPSF ID NOSUCHSF-98c486052a51 does not exist"
                (ref-AQP::UEV_StakeCollectableLeg "NOSUCHSF-98c486052a51" true))
            ;;THE SON FLAG SELECTS THE TABLE, and the message proves it: the SAME real id offered
            ;;with son=false is looked up in the DPNF table and reported as a missing DPNF. So `son`
            ;;is part of the identity, not a hint -- a leg that lied about it would miss its own row.
            (expect-failure "<<AQP-F16>> ...and a real DPSF presented with son=false is looked up as a DPNF, and missing"
                "DPNF ID DHCD-98c486052a51 does not exist"
                (ref-AQP::UEV_StakeCollectableLeg dhcd false))
            ;;the beneficiary rule is STRICTLY stronger than existence -- the same asymmetry pinned
            ;;for the RPS twin in <<AQP-F1>>: a SMART account exists but cannot be a beneficiary
            (expect-failure "<<AQP-F16>> a SMART account is refused as a stake beneficiary"
                "Operation requires a Standard DALOS Account"
                (ref-AQP::UEV_StakeBeneficiaryAccount (ref-DPDC::GOV|DPDC|SC_NAME)))
            (expect "<<AQP-F16>> ...while an ordinary standard account is accepted"
                "ok" (let ((p (ref-AQP::UEV_StakeBeneficiaryAccount KST.ANHD))) "ok"))
        ]
    )
    ""
)
(commit-tx)

;;|| NEXT >
;;
(begin-tx "AQP-F17 — the last of Tier 1: royalty custody previews, inject plans, unstake sufficiency")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
;;==== AQP-F17 — the last of Tier 1: royalty custody previews, inject plans, unstake sufficiency · 01 · namespace ==== 
(print "--- [AQP-F17 — the last of Tier 1: royalty custody previews, inject plans, unstake sufficiency · 01 · namespace] ---")
(namespace "ouronet-ns")
(print "--- [AQP-F17 · 01 · the three royalty-custody cost previews] ---")
;;FUNCTION COVERAGE (G6, Tier 1). The last client-reachable functions in RPS / AQP / SCORE.
;;
;;`URCi_{Fuel,Burn,Withdraw}RoyaltyCustody` quote the three things an FVT owner can do with royalty
;;held in custody: fuel a swap pair with it, burn it, or withdraw it. All three are priced previews
;;with no state requirement beyond the vault, so the testable content is that they are DISTINCT --
;;three different operations must not collapse to one number, which is what a copy-pasted preview
;;would produce.
;;==== AQP-F17 — the last of Tier 1: royalty custody previews, inject plans, unstake sufficiency · 02 · let / invocation ==== 
(print "--- [AQP-F17 — the last of Tier 1: royalty custody previews, inject plans, unstake sufficiency · 02 · let / invocation] ---")
(let
    (
        (ref-U|DALOS:module{UtilityDalosV2} U|DALOS)
        (ref-RPS:module{AcquisitionRewardPerShareV1} RPS)
        (ouro:string "OURO-98c486052a51")
        (swpair:string "W|DLK-98c486052a51|OURO-98c486052a51|DWK-98c486052a51")
    )
    (let
        (
            (fvt:string (ref-U|DALOS::UDC_Makeid "TfStakeVault"))
        )
        (map print
            [
                ;;all three quote a positive price
                ;;BURN and WITHDRAW need only the vault, so they are quoted here. FUEL additionally
                ;;reads a SWAP PAIR (`SWP|Pairs`), and this harness builds none -- `URC_Swpairs` is
                ;;empty -- so it aborts on the missing row rather than pricing anything. It is
                ;;covered instead in `Kursan/dsa-grand-tour.repl` <<GT-DOC2>>, which holds both an FVT
                ;;and real swap pairs. Recorded here so the split is deliberate rather than a gap.
                (expect "<<AQP-F17>> burn and withdraw are both priced above zero"
                    [true true]
                    [(> (ref-RPS::URCi_BurnRoyaltyCustody fvt ouro) 0.0)
                     (> (ref-RPS::URCi_WithdrawRoyaltyCustody fvt ouro KST.ANHD) 0.0)])
                ;;...and they are DIFFERENT numbers. Two distinct operations with distinct leg sets;
                ;;a shared constant would mean one preview is wrong and nothing else would show it.
                (expect "<<AQP-F17>> ...and burning is priced differently from withdrawing"
                    false (= (ref-RPS::URCi_BurnRoyaltyCustody fvt ouro)
                             (ref-RPS::URCi_WithdrawRoyaltyCustody fvt ouro KST.ANHD)))
                ;;...and FUEL genuinely cannot be priced here, for the stated reason
                (expect-failure "<<AQP-F17>> ...while FUEL aborts here: this harness has no swap pairs at all"
                    "No value found in table"
                    (ref-RPS::URCi_FuelRoyaltyCustody fvt ouro swpair))
                (expect "<<AQP-F17>> ...confirmed: the swpair registry is empty in this harness"
                    0 (length (SWP.URC_Swpairs)))
            ]
        )
    )
    ""
)
(print "--- [AQP-F17 · 02 · the inject score-plan builder] ---")
;;`URHC_BuildInjectScorePlans` -- "Enabled ScoreEntityLinks on FVT x enabled reward dptf-ids". It is
;;a CROSS PRODUCT, so its size is the product of two readable lists. Asserting that relationship
;;rather than a hardcoded count is what keeps the test alive as the fixture grows.
(let
    (
        (ref-U|DALOS:module{UtilityDalosV2} U|DALOS)
        (ref-RPS:module{AcquisitionRewardPerShareV1} RPS)
    )
    (let
        (
            (fvt:string (ref-U|DALOS::UDC_Makeid "TfStakeVault"))
        )
        (map print
            [
                (expect "<<AQP-F17>> the plan count is members x enabled rewards, exactly"
                    (* (length (ref-RPS::URH_FvtEnabledScoreEntityIdsForFvt fvt))
                       (length (ref-RPS::URH_FVT-RG|EnabledRewardRows fvt)))
                    (length (ref-RPS::URHC_BuildInjectScorePlans fvt)))
                ;;...and it is non-empty, so the product above is not 0 x 0
                (expect "<<AQP-F17>> ...and it is non-empty on a live vault"
                    true (> (length (ref-RPS::URHC_BuildInjectScorePlans fvt)) 0))
            ]
        )
    )
    ""
)
(print "--- [AQP-F17 · 03 · unstake sufficiency, and the SCORE stake-context validators] ---")
;;`URC_CollectableUnstakeNoncesSufficient` / `...RollupSufficient` are the UNSTAKE twins of the
;;vacate checks pinned in <<AQP-F15>> -- but unstake is PARTIAL-legal where vacate is not, so the
;;bound is `>=` rather than `=`. That difference is the whole point of having both, and it is what
;;this asserts: a partial unstake is fine, an over-unstake is not.
(let
    (
        (ref-U|DALOS:module{UtilityDalosV2} U|DALOS)
        (ref-AQP:module{AcquisitionPoolsV1} AQP-POOL)
        (ref-SCR:module{AcquisitionScoresV1} AQP-SCORE)
        (dhcd:string "DHCD-98c486052a51")
    )
    (let
        (
            (pool:string (ref-U|DALOS::UDC_Makeid "SfStakePool"))
            (sf-score:string (ref-U|DALOS::UDC_Makeid "SfStakeScore"))
        )
        (map print
            [
                ;;PARTIAL is allowed on unstake -- the contrast with vacate's all-or-nothing rule
                (expect "<<AQP-F17>> a PARTIAL unstake is sufficient, unlike a partial VACATE"
                    true (ref-AQP::URC_CollectableUnstakeNoncesSufficient
                             pool dhcd true KST.ANHD KST.ANHD [1] [100]))
                ;;...while over-unstaking is not
                (expect "<<AQP-F17>> ...and over-unstaking is not"
                    false (ref-AQP::URC_CollectableUnstakeNoncesSufficient
                              pool dhcd true KST.ANHD KST.ANHD [1] [999999]))
                ;;the rollup twin, same two sides
                (expect "<<AQP-F17>> the rollup check agrees on both sides"
                    [true false]
                    [(ref-AQP::URC_CollectableUnstakeRollupSufficient pool dhcd true KST.ANHD KST.ANHD [1] [100])
                     (ref-AQP::URC_CollectableUnstakeRollupSufficient pool dhcd true KST.ANHD KST.ANHD [1] [999999])])
                ;;the SCORE stake-context validators: class-3 (DPSF) accepts a class-3 score on its
                ;;own pool; the class-4 (DPNF) validator refuses the same score, because the class
                ;;check is the point of having two.
                (expect "<<AQP-F17>> the DPSF stake context accepts a class-3 score on its own pool"
                    "ok" (let ((p (ref-SCR::UEV_DpsfStakeScoreContext KST.ANHD pool sf-score))) "ok"))
                (expect-failure "<<AQP-F17>> ...and the DPNF validator refuses that same class-3 score"
                    "score" (ref-SCR::UEV_DpnfStakeScoreContext KST.ANHD pool sf-score))
            ]
        )
    )
    ""
)
(commit-tx)
