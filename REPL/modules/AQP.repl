;;P3.3. The Stage-2 half of DALOS-G6 (which covers the five Stage-1 Talos modules). Each Talos
;;module carries its OWN copy of P|TS, and GAP is the protocol emergency stop — it only works if no
;;module has an unpaused path, so every module is driven rather than sampled. A Talos module added
;;later without the check would leave a live entrypoint open during a freeze and nothing else in the
;;suite would catch it.
;;
;;P|TS is not an @event cap, so test-capability acquires it directly. GAP is restored to the value
;;found, and the restoration is asserted: it is global state shared with every later block.
;;==== AQP-G32 — the Global Administrative Pause freezes every Stage-2 Talos client too · 01 · env-sigs (caps) ==== 
(print "--- [AQP-G32 — the Global Administrative Pause freezes every Stage-2 Talos client too · 01 · env-sigs (caps)] ---")
(env-sigs [{ "key": "PK_AncientHodler", "caps": [] }])
;;==== AQP-G32 — the Global Administrative Pause freezes every Stage-2 Talos client too · 02 · let / invocation ==== 
(print "--- [AQP-G32 — the Global Administrative Pause freezes every Stage-2 Talos client too · 02 · let / invocation] ---")
(let
    (
        (ref-DALOS:module{OuronetDalosV2} DALOS)
        (ref-TS01-A:module{TalosStageOne_AdminV2} TS01-A)
    )
    (let
        (
            (gap0:bool (ref-DALOS::UR_GAP))
        )
        (ref-TS01-A::DALOS|A_ToggleGAP true)
        (map print
            [
                (expect "<<AQP-G32>> the global pause is ON" true (ref-DALOS::UR_GAP))
                (expect-failure "<<AQP-G32>> TS02-C1 refuses every client function"
                    "While Global Administrative Pause is online" (test-capability (TS02-C1.P|TS)))
                (expect-failure "<<AQP-G32>> ...TS02-C2 likewise"
                    "While Global Administrative Pause is online" (test-capability (TS02-C2.P|TS)))
                (expect-failure "<<AQP-G32>> ...TS02-C3 likewise"
                    "While Global Administrative Pause is online" (test-capability (TS02-C3.P|TS)))
                (expect-failure "<<AQP-G32>> ...TS02-DPAD likewise"
                    "While Global Administrative Pause is online" (test-capability (TS02-DPAD.P|TS)))
                ;;...and the CITIZEN launchpad Talos, which is the one most likely to be forgotten:
                ;;it is authored alongside the citizen sales rather than with the sovereign Talos set.
                (expect-failure "<<AQP-G32>> ...and the CITIZEN launchpad Talos TS02-CPAD likewise"
                    "While Global Administrative Pause is online" (test-capability (TS02-CPAD.P|TS)))
            ]
        )
        (ref-TS01-A::DALOS|A_ToggleGAP gap0)
