(begin-tx "AQP-G28 — the Hydra chunk bounds, and a drain with no sweep to drain")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(namespace "ouronet-ns")
(print "--- [AQP-G28 · 01 · inject-fix / unstale chunk bounds + sweep cursor] ---")
;;P3.3. Three FVT guards on the Hydra parallel-slice paths -- the ones a UI drives in a loop.
;;
;;WHY OfStakeVault AND NOT TfStakeVault: my first attempt used TfStakeVault and all three chunk
;;cases came back with "FVT is frozen: a pool it serves is mid-vacate". That vault is left
;;vacate-frozen by the VCT suites, and the freeze guard sits TWO enforces above the chunk bound,
;;so nothing past it was ever reached and the assertions would have proved the wrong thing.
;;OfStakeVault is unfrozen, ANHD-owned, and carries an enabled OURO reward link -- which is
;;exactly the three predecessors these guards need satisfied.
;;
;;Each bound is driven on BOTH sides, because the guard is a conjunction -- (> chunk 0) AND
;;(<= chunk MAX) -- and one input can only ever prove one half. The upper case is computed from
;;the module's own constant rather than written as a literal, so a gas-budget retune of
;;INJECT-FIX-CHUNK-MAX moves the test with the code instead of silently making it vacuous.
;;==== AQP-G28 — the Hydra chunk bounds, and a drain with no sweep to drain · 01 · env-sigs (caps) ==== 
(print "--- [AQP-G28 — the Hydra chunk bounds, and a drain with no sweep to drain · 01 · env-sigs (caps)] ---")
(env-sigs [{ "key": "PK_AncientHodler", "caps": [] }])
(let*
    (
        (ref-U|DALOS:module{UtilityDalosV2} U|DALOS)
        (ref-FVT:module{AcquisitionFarmsVaultsTreasuriesV1} AQP-FVT)
        (ref-RPS:module{AcquisitionRewardPerShareV1} RPS)
        (ref-TS02-C3:module{TalosStageTwo_ClientThreeV1} TS02-C3)
        (ouro:string (ref-U|DALOS::UDC_Makeid "OURO"))
        (ofv:string (ref-U|DALOS::UDC_Makeid "OfStakeVault"))
        (over:integer (+ AQP-FVT.INJECT-FIX-CHUNK-MAX 1))
    )
    (map print
        [
            ;;preconditions -- all three predecessors of the chunk bound, asserted rather than
            ;;assumed. If any were wrong a DIFFERENT guard would answer and the test would pass
            ;;for the wrong reason, which is precisely what happened on the first attempt.
            (expect "<<AQP-G28>> OfStakeVault is NOT vacate-frozen"
                false (ref-FVT::UR_FVT|VacateFrozen ofv))
            (expect "<<AQP-G28>> ...and its OURO reward link exists and is enabled"
                [true true]
                [(ref-RPS::URC_FvtRpsGlobalRowExists ofv ouro)
                 (ref-RPS::UR_FVT-RG|RewardEnabled ofv ouro)])
            (expect "<<AQP-G28>> ...and ANHD owns it, which CCp_UnstaleAll requires"
                KST.ANHD (ref-RPS::UR_FVT|OwnerKonto ofv))
            ;;--- inject-fix: the permissionless fix slice of an inject flow.
            (expect-failure "<<AQP-G28>> an inject-fix chunk of ZERO is refused"
                "Inject-fix chunk out of range"
                (ref-TS02-C3::AQP-FVT|CCp_InjectFixChunk KST.ANHD ofv ouro 0))
            (expect-failure "<<AQP-G28>> ...and one past INJECT-FIX-CHUNK-MAX is refused"
                "Inject-fix chunk out of range"
                (ref-TS02-C3::AQP-FVT|CCp_InjectFixChunk KST.ANHD ofv ouro over))
            ;;--- unstale-all: the owner-gated standalone prep. Same bound, its own message, and
            ;;a separate enforce in a separate cap -- so it needs its own two cases. A reader
            ;;could easily assume the inject-fix pair covered this; it does not.
            (expect-failure "<<AQP-G28>> an unstale chunk of ZERO is refused"
                "Unstale chunk out of range"
                (ref-TS02-C3::AQP-FVT|CCp_UnstaleAll KST.ANHD ofv ouro 0))
            (expect-failure "<<AQP-G28>> ...and one past the same ceiling is refused"
                "Unstale chunk out of range"
                (ref-TS02-C3::AQP-FVT|CCp_UnstaleAll KST.ANHD ofv ouro over))
            ;;--- sweep-drain re-checks the cursor on EVERY chunk rather than trusting the caller
            ;;to stop. Without it a stale UI could keep draining against a finished sweep, past
            ;;the unfreeze, with the pools already reopened to staking.
            (expect-failure "<<AQP-G28>> a sweep chunk against an anchor with NO active sweep is refused"
                "No active sweep for this anchor"
                (ref-TS02-C3::AQP-FVT|CCp_SweepRecomputeChunk KST.ANHD "no-such-anchor" 5))
        ]
    )
    ""
)
(env-sigs [])
(commit-tx)
;;NOT PINNED — the sweep CHUNK bound ("Sweep chunk out of range") sits one enforce BELOW the
;;cursor check just driven, so it needs a sweep that is genuinely ACTIVE. Starting one
;;(CC_SweepBegin) freezes every pool the anchor serves and swept-revokes the anchor; that is a
;;large, multi-pool mutation of shared state, not a toggle, and there is no cheap restore. Its
;;twin "A sweep is already in progress for this anchor" in CC_SweepBegin needs the same fixture.
;;Both would be closed together by one dedicated sweep suite.

