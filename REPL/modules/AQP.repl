(begin-tx "AQP-G14 — SCR|C>ISSUE-TRIPLET distinctness, via the real Talos client path")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(namespace "ouronet-ns")
(print "--- [AQP-G14 · 01 · triplet admission] ---")
;;TECHNIQUE NOTE, and it is the important part of this block. SCR|C>ISSUE-TRIPLET is an @event
;;defcap, and `test-capability` CANNOT acquire those — Pact tries to INSTALL them and fails with
;;"capability is not managed and cannot be installed". That blocks 141 guards across the codebase,
;;so it was worth establishing whether the ordinary client path reaches them instead. It does:
;;calling the Talos shell with a deliberately bad argument runs the cap body and trips the guard.
;;
;;The argument has to be a REAL score, though. Three ghost ids abort in a hard table read inside
;;the cap's own let — the same eager-binding degradation already recorded at PYTHIA <<TX007e-03>>,
;;FVT <<TX-BOOT-G1>> and DALOS <<DALOS-G2e>> — and would prove nothing about the guard. Passing
;;ONE real score three times satisfies existence and fails only distinctness, which is the point.
;;==== AQP-G14 — SCR|C>ISSUE-TRIPLET distinctness, via the real Talos client path · 01 · env-sigs (caps) ==== 
(print "--- [AQP-G14 — SCR|C>ISSUE-TRIPLET distinctness, via the real Talos client path · 01 · env-sigs (caps)] ---")
(env-sigs [{ "key": "PK_AncientHodler", "caps": [] }])
(let*
    (
        (ref-U|DALOS:module{UtilityDalosV2} U|DALOS)
        (ref-SCR:module{AcquisitionScoresV1} AQP-SCORE)
        (ref-TS02-C3:module{TalosStageTwo_ClientThreeV1} TS02-C3)
        (score:string (ref-U|DALOS::UDC_Makeid "ResumeVacScore"))
    )
    (map print
        [
            ;;the score really exists, so "must exist" is not what answers below
            (expect "<<AQP-G14>> the score used three times is a real, issued score"
                true (> (ref-SCR::UR_SCR|ScoreClass score) -1))
            (expect-failure "<<AQP-G14>> a triplet built from ONE score repeated three times is refused"
                "scores must exist, be distinct, same owner and score-class"
                (ref-TS02-C3::AQP-SCR|C_IssueTriplet KST.ANHD KST.ANHD score score score))
        ]
    )
    ""
)
(commit-tx)

