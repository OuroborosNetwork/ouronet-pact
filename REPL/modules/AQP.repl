(begin-tx "AQP-F5 — SCORE: the user-score identity readers, real row against defaulted row")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
;;==== AQP-F5 — SCORE: the user-score identity readers, real row against defaulted row · 01 · namespace ==== 
(print "--- [AQP-F5 — SCORE: the user-score identity readers, real row against defaulted row · 01 · namespace] ---")
(namespace "ouronet-ns")
(print "--- [AQP-F5 · 01 · identity is preserved whether or not the row exists] ---")
;;FUNCTION COVERAGE (G6, Tier 1: SCORE). `UR_U-SCR|UserScore{OuronetAccount,PoolId,ScoreId}` had
;;never been called. They are the identity projection of the user-score row, and `UR_U-SCR|UserScore`
;;carries an unusually explicit @doc about what happens when the row is stale or missing:
;;
;;   "...the VALUE fields read as 0 (stale) while IDENTITY (account/pool/score) is PRESERVED;
;;    a fresh stake re-stamps the row live. Absent rows read as zero via the UDC default."
;;
;;THE FIXTURE GIVES BOTH CASES FROM ONE ACCOUNT AND ONE POOL, which is what makes this sharp rather
;;than a smoke test. DrainVacPool employs two scores; ANHD has staked against one of them and not
;;the other, so:
;;    DrainVacScore -> a REAL row, base-score 20.0
;;    G24Score      -> no row, reads as the UDC default, base-score 0.0
;;Identity must be correct in the first case and ECHOED in the second, and the values must
;;distinguish them. That is the whole documented contract in four assertions.
;;==== AQP-F5 — SCORE: the user-score identity readers, real row against defaulted row · 02 · let / invocation ==== 
(print "--- [AQP-F5 — SCORE: the user-score identity readers, real row against defaulted row · 02 · let / invocation] ---")
(let
    (
        (ref-U|DALOS:module{UtilityDalosV2} U|DALOS)
        (ref-SCR:module{AcquisitionScoresV1} AQP-SCORE)
    )
    (let
        (
            (dv:string (ref-U|DALOS::UDC_Makeid "DrainVacPool"))
            (real-score:string (ref-U|DALOS::UDC_Makeid "DrainVacScore"))
            (no-row-score:string (ref-U|DALOS::UDC_Makeid "G24Score"))
        )
        (map print
            [
                ;;PREMISE: the two scores really are in the states this block assumes. Without this
                ;;the contrast below could be two identical defaulted rows.
                (expect "<<AQP-F5>> ANHD has a REAL row on DrainVacScore and NO row on G24Score"
                    [20.0 0.0]
                    [(ref-SCR::UR_U-SCR|UserScoreBaseScore KST.ANHD dv real-score)
                     (ref-SCR::UR_U-SCR|UserScoreBaseScore KST.ANHD dv no-row-score)])
                ;;IDENTITY ON THE REAL ROW -- these come from stored columns, so a writer that
                ;;transposed account/pool/score is caught here.
                (expect "<<AQP-F5>> the REAL row's identity fields round-trip to the key exactly"
                    [KST.ANHD dv real-score]
                    [(ref-SCR::UR_U-SCR|UserScoreOuronetAccount KST.ANHD dv real-score)
                     (ref-SCR::UR_U-SCR|UserScorePoolId KST.ANHD dv real-score)
                     (ref-SCR::UR_U-SCR|UserScoreScoreId KST.ANHD dv real-score)])
                ;;IDENTITY ON THE ABSENT ROW -- the documented "identity preserved" behaviour. It is
                ;;the same ECHO trap as RPS's UR_FVT-RU|* family (see Kursan/AQP-stream-tests.repl
                ;;<<T-STREAM-RT>>): a caller cannot use these to ask whether the row exists, because
                ;;they answer with whatever key they were handed.
                (expect "<<AQP-F5>> the ABSENT row echoes the same identity -- so these are NOT existence checks"
                    [KST.ANHD dv no-row-score]
                    [(ref-SCR::UR_U-SCR|UserScoreOuronetAccount KST.ANHD dv no-row-score)
                     (ref-SCR::UR_U-SCR|UserScorePoolId KST.ANHD dv no-row-score)
                     (ref-SCR::UR_U-SCR|UserScoreScoreId KST.ANHD dv no-row-score)])
                ;;...and they echo for a key that is nonsense in EVERY component, which is the
                ;;strongest statement of the trap: nothing about the answer is evidence of anything.
                (expect "<<AQP-F5>> ...including for a key whose every component is fictional"
                    ["ghost-account" "ghost-pool" "ghost-score"]
                    [(ref-SCR::UR_U-SCR|UserScoreOuronetAccount "ghost-account" "ghost-pool" "ghost-score")
                     (ref-SCR::UR_U-SCR|UserScorePoolId "ghost-account" "ghost-pool" "ghost-score")
                     (ref-SCR::UR_U-SCR|UserScoreScoreId "ghost-account" "ghost-pool" "ghost-score")])
                ;;THE VALUE FIELDS are what actually distinguish present from absent, exactly as the
                ;;@doc says. This is the reader a caller should be using for that question.
                (expect "<<AQP-F5>> only the VALUE fields distinguish a real row from a defaulted one"
                    true (and (> (ref-SCR::UR_U-SCR|UserScoreDebScore KST.ANHD dv real-score) 0.0)
                              (= (ref-SCR::UR_U-SCR|UserScoreDebScore KST.ANHD dv no-row-score) 0.0)))
                ;;and the score-level totals read consistently with the per-user row: a score with a
                ;;20.0 staker cannot have a zero total base deb-score
                (expect "<<AQP-F5>> the score's TOTAL base deb-score covers its one staker"
                    true (>= (ref-SCR::UR_SCR|ScoreTotalBaseDebScore real-score)
                             (ref-SCR::UR_U-SCR|UserScoreBaseDebScore KST.ANHD dv real-score)))
                ;;THE DOCUMENTED AGGREGATE INVARIANT, and the first draft of this block got it
                ;;wrong in an instructive way. I asserted `boosted >= base`, reading "boosted" as
                ;;"base after a multiplier". It is not: the schema says outright
                ;;    "total-base-deb + total-boosted-deb = total-deb-score"
                ;;so the two are a DECOMPOSITION of one total, and the boosted half is the boosted
                ;;PORTION -- naturally below the base half whenever most stakers are unboosted, which
                ;;is the case here. The additive identity is the real invariant and is strictly
                ;;stronger than the ordering I guessed: it pins all three fields against each other.
                (expect "<<AQP-F5>> the deb aggregates DECOMPOSE: base-deb + boosted-deb = total-deb"
                    (ref-SCR::UR_SCR|ScoreTotalDebScore real-score)
                    (+ (ref-SCR::UR_SCR|ScoreTotalBaseDebScore real-score)
                       (ref-SCR::UR_SCR|ScoreTotalBoostedDebScore real-score)))
                ;;...and the total is non-zero, so that identity is not 0 = 0 + 0
                (expect "<<AQP-F5>> ...on a score whose total is non-zero, so the identity has content"
                    true (> (ref-SCR::UR_SCR|ScoreTotalDebScore real-score) 0.0))
            ]
        )
    )
    ""
)
(commit-tx)

