(begin-tx "AQP-G41 — the TF pool-custody composite, driven on its tracker-balance conjunct")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(namespace "ouronet-ns")
(print "--- [AQP-G41 · 01 · unstaking more than was ever staked] ---")
;;`03_AQP.pact:678` — a five-way `fold (and)` over class / stake-admission / dptf / tracker / rollup.
;;Four of those five are ALREADY enforced, with sharper wording, in the FVT stake flow that fronts
;;this custody cap, so the only conjunct a client can still be the first to break is `tracker-ok` —
;;and only on an UNSTAKE, since `(or direction (>= staked-bal amount))` is vacuously true when
;;direction is true. That is the single input this test uses.
;;
;;WHY ResumeVacPool AND NOT TfStakePool. TfStakePool is left stake-DISABLED by the suite, which
;;makes `stake-admission-ok` the conjunct that fails — the same message, the wrong reason, and the
;;assertion would have been green while proving nothing about the tracker rule. ResumeVacPool ends
;;[6.2.5] fully vacated and auto-finalised, so it passes admission in BOTH directions; the four
;;preconditions are asserted below rather than assumed, precisely because the message cannot tell
;;the five conjuncts apart.
;;==== AQP-G41 — the TF pool-custody composite, driven on its tracker-balance conjunct · 01 · env-sigs (caps) ==== 
(print "--- [AQP-G41 — the TF pool-custody composite, driven on its tracker-balance conjunct · 01 · env-sigs (caps)] ---")
(env-sigs [{ "key": "PK_AncientHodler", "caps": [] }])
(let*
    (
        (ref-U|DALOS:module{UtilityDalosV2} U|DALOS)
        (ref-AQP:module{AcquisitionPoolsV1} AQP-POOL)
        (pool:string (ref-U|DALOS::UDC_Makeid "ResumeVacPool"))
        (ouro:string "OURO-98c486052a51")
    )
    (map print
        [
            (expect "<<AQP-G41>> the four conjuncts that are NOT under test all hold on this pool"
                [true true true]
                [(ref-AQP::URC_StakeTrueFungiblePoolClassOk pool)
                 (ref-AQP::URC_PoolUnstakeAdmissionOk pool)
                 (ref-AQP::URC_StakeTrueFungibleDptfMatchesPool pool ouro)])
            ;;...so `tracker-ok` is the only one left that this amount can break.
            (expect-failure "<<AQP-G41>> unstaking more than the tracker holds is refused"
                "Invalid TF pool custody: pool class/stake admission/dptf-id or insufficient staked/rollup balance"
                (test-capability (AQP-POOL.AQP|XE>TRUE-FUNGIBLE-POOL-CUSTODY
                    pool KST.ANHD KST.ANHD ouro 999999999.0 false)))
            ;;POSITIVE CONTROL, and it is the strongest form available: the SAME pool, the SAME
            ;;absurd amount, flipped to direction=true, is ACCEPTED OUTRIGHT. `tracker-ok` and
            ;;`rollup-ok` are both `(or direction …)`, so a stake short-circuits both to true and
            ;;the whole five-way fold passes — the amount is never compared to anything. The cap
            ;;grants cleanly (KST.ANHD is signed for above), so this is a success assertion rather
            ;;than a different-message one. It fixes the refusal above onto the balance conjunct:
            ;;the only thing that changed between the two calls is the direction flag.
            (expect "<<AQP-G41>> ...while the SAME amount in the STAKE direction is accepted outright"
                "granted"
                (let ((probe (test-capability (AQP-POOL.AQP|XE>TRUE-FUNGIBLE-POOL-CUSTODY
                                 pool KST.ANHD KST.ANHD ouro 999999999.0 true))))
                    "granted"))
        ]
    )
    ""
)
(commit-tx)

