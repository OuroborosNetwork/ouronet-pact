(begin-tx "AQP-F10 — AQP: the 7-slot score constructor, the leg validators, and the OF/NF tracker echo")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
;;==== AQP-F10 — AQP: the 7-slot score constructor, the leg validators, and the OF/NF tracker echo · 01 · namespace ==== 
(print "--- [AQP-F10 — AQP: the 7-slot score constructor, the leg validators, and the OF/NF tracker echo · 01 · namespace] ---")
(namespace "ouronet-ns")
(print "--- [AQP-F10 · 01 · every score slot must be independently addressable] ---")
;;FUNCTION COVERAGE (G6, Tier 1: AQP). `UDC_AQP|SchemaWithScoreAtSlot` writes one score-id into one
;;of SEVEN named slots via a seven-branch if-chain, each branch re-reading the other six from the
;;input row. It had never been called.
;;
;;THIS IS THE HIGHEST-VALUE SHAPE IN THE WHOLE TIER. Seven near-identical branches over seven
;;same-typed fields is the textbook home for a copy-paste slip -- write slot 4, land in slot 5 -- and
;;NOTHING downstream would notice, because a score-id in the wrong slot is still a valid score-id in
;;a valid slot. The only way to see it is to address each slot in turn and assert that exactly one
;;field moved. So that is what this does: seven writes, each checked against all seven fields.
;;==== AQP-F10 — AQP: the 7-slot score constructor, the leg validators, and the OF/NF tracker echo · 02 · let / invocation ==== 
(print "--- [AQP-F10 — AQP: the 7-slot score constructor, the leg validators, and the OF/NF tracker echo · 02 · let / invocation] ---")
(let
    (
        (ref-U|DALOS:module{UtilityDalosV2} U|DALOS)
        (ref-AQP:module{AcquisitionPoolsV1} AQP-POOL)
        (probe:string "SLOT-PROBE-SCORE")
    )
    (let
        (
            ;;untyped: AQP|Schema is a MODULE schema, not an interface member, so
            ;;`object{AcquisitionPoolsV1.AQP|Schema}` does not resolve through a modref.
            (pool-row (ref-AQP::UR_AQP|Pool (ref-U|DALOS::UDC_Makeid "TfStakePool")))
        )
        (let
            (
                (slots:[string]
                    ["score-primary" "score-secondary" "score-tertiary" "score-quaternary"
                     "score-quinary" "score-senary" "score-septenary"])
            )
            (map print
                [
                    ;;each slot index writes the probe into ITS OWN field -- so the if-chain's
                    ;;index-to-field mapping is pinned position by position
                    (expect "<<AQP-F10>> slot index N writes the score into the Nth named slot, for all seven"
                        [probe probe probe probe probe probe probe]
                        (map (lambda (i:integer)
                                (at (at i slots)
                                    (ref-AQP::UDC_AQP|SchemaWithScoreAtSlot pool-row i probe)))
                            (enumerate 0 6)))
                    ;;...and writing slot N leaves the OTHER SIX exactly as they were. This is the
                    ;;half that catches a branch writing two fields, or clobbering a neighbour.
                    (expect "<<AQP-F10>> ...and leaves the other six slots untouched, for all seven"
                        true
                        (fold (and) true
                            (map (lambda (i:integer)
                                    (let ((patched (ref-AQP::UDC_AQP|SchemaWithScoreAtSlot pool-row i probe)))
                                        (fold (and) true
                                            (map (lambda (j:integer)
                                                    (if (= i j)
                                                        true
                                                        (= (at (at j slots) patched)
                                                           (at (at j slots) pool-row))))
                                                (enumerate 0 6)))))
                                (enumerate 0 6))))
                    ;;the row's non-slot fields must survive too -- the constructor rebuilds the whole
                    ;;object, so a dropped field would be silent until something read it
                    (expect "<<AQP-F10>> ...and the pool's identity and class survive the rebuild"
                        [(at "aqp-id" pool-row) (at "aqp-class" pool-row) (at "asset-id" pool-row)]
                        (let ((p (ref-AQP::UDC_AQP|SchemaWithScoreAtSlot pool-row 3 probe)))
                            [(at "aqp-id" p) (at "aqp-class" p) (at "asset-id" p)]))
                    ;;the full-row reader and the id reader agree, which is the round-trip for this table
                    (expect "<<AQP-F10>> UR_AQP|PoolAqpId agrees with the full row's own aqp-id field"
                        (at "aqp-id" pool-row)
                        (ref-AQP::UR_AQP|PoolAqpId (ref-U|DALOS::UDC_Makeid "TfStakePool")))
                ]
            )
        )
    )
    ""
)
(print "--- [AQP-F10 · 02 · the OF leg validators, discriminated by pool class] ---")
;;`URC_StakeOrtoFungiblePoolClassOk` / `URC_StakeOrtoFungibleDpofMatchesPool` / `URC_DpofLegPrefix`.
;;The matcher's @doc is class-dependent ("class 2 native circulating; class 1 Z|/H| satellite;
;;class 0 Z| orto LP"), so the test that means anything is a DIFFERENTIAL across pool classes rather
;;than one call per function.
(let
    (
        (ref-U|DALOS:module{UtilityDalosV2} U|DALOS)
        (ref-AQP:module{AcquisitionPoolsV1} AQP-POOL)
        (mvst:string "MVST-98c486052a51")
    )
    (let
        (
            (of-pool:string (ref-U|DALOS::UDC_Makeid "OfStakePool"))
            (tf-pool:string (ref-U|DALOS::UDC_Makeid "TfStakePool"))
        )
        (map print
            [
                ;;THE CLASS GATE, and my first expectation here was wrong in a way worth keeping.
                ;;I assumed only class-2 (ortofungible) pools admit the OF flow and asserted that a
                ;;class-1 TF pool would be refused. It is not: the matcher's @doc lists THREE
                ;;OF-bearing classes -- "class 2 native circulating; class 1 Z|/H| satellite linked
                ;;to pool DPTF; class 0 Z| orto LP" -- because a true-fungible pool can carry
                ;;sleeping/hibernating ORTO satellites of its own token. The pool class that is
                ;;genuinely refused is a COLLECTABLE one (3/4), which has no OF lane at all.
                (expect "<<AQP-F10>> the OF class gate admits BOTH the orto (2) and true-fungible (1) pools"
                    [true true]
                    [(ref-AQP::URC_StakeOrtoFungiblePoolClassOk of-pool)
                     (ref-AQP::URC_StakeOrtoFungiblePoolClassOk tf-pool)])
                ;;...and refuses a COLLECTABLE pool, which is what makes the gate a gate
                (expect "<<AQP-F10>> ...and refuses a class-3 COLLECTABLE pool, which has no OF lane"
                    false (ref-AQP::URC_StakeOrtoFungiblePoolClassOk
                              (ref-U|DALOS::UDC_Makeid "SfStakePool")))
                ;;the leg matcher: the pool's own asset is accepted, a foreign one is not
                (expect "<<AQP-F10>> the OF leg matcher accepts the pool's own asset and refuses a foreign one"
                    [true false]
                    [(ref-AQP::URC_StakeOrtoFungibleDpofMatchesPool of-pool mvst)
                     (ref-AQP::URC_StakeOrtoFungibleDpofMatchesPool of-pool "DHCD-98c486052a51")])
                ;;the prefix helper the matcher leans on -- two chars, and the special prefixes it
                ;;is there to recognise
                (expect "<<AQP-F10>> URC_DpofLegPrefix is the first two characters, special or not"
                    ["Z|" "H|" "MV"]
                    [(ref-AQP::URC_DpofLegPrefix "Z|MVST-98c486052a51")
                     (ref-AQP::URC_DpofLegPrefix "H|MVST-98c486052a51")
                     (ref-AQP::URC_DpofLegPrefix mvst)])
            ]
        )
    )
    ""
)
(print "--- [AQP-F10 · 03 · the DPOF/DPNF tracker identity readers] ---")
;;The other two tracker families from <<AQP-F7>>. Neither has a live row in this suite, and that is
;;exactly the case the key-echo trap is about: these readers answer with the key they were handed and
;;a caller cannot tell that from stored data. Pinned so the behaviour is documented for all four
;;families rather than only the two that happen to be staked here.
(let
    (
        (ref-U|DALOS:module{UtilityDalosV2} U|DALOS)
        (ref-AQP:module{AcquisitionPoolsV1} AQP-POOL)
        (mvst:string "MVST-98c486052a51")
        (dhb:string "DHB-98c486052a51")
    )
    (let
        (
            (pool:string (ref-U|DALOS::UDC_Makeid "OfStakePool"))
        )
        (map print
            [
                ;;the rows are ABSENT -- established from the balance, the only honest field
                (expect "<<AQP-F10>> neither the DPOF nor the DPNF row exists here (balance 0.0)"
                    [0.0 0.0]
                    [(ref-AQP::UR_AQP|DPOFTrackerBalance pool mvst KST.ANHD KST.ANHD 1)
                     (ref-AQP::UR_AQP|DPNFTrackerBalance pool dhb KST.ANHD KST.ANHD 1)])
                ;;...and yet every identity field answers, with the key. Same trap as the other two
                ;;families; documented here so it is known for all four.
                (expect "<<AQP-F10>> the DPOF identity readers echo the key on the absent row"
                    [pool mvst KST.ANHD 1]
                    [(ref-AQP::UR_AQP|DPOFTrackerPoolId pool mvst KST.ANHD KST.ANHD 1)
                     (ref-AQP::UR_AQP|DPOFTrackerDpofId pool mvst KST.ANHD KST.ANHD 1)
                     (ref-AQP::UR_AQP|DPOFTrackerOwnerId pool mvst KST.ANHD KST.ANHD 1)
                     (ref-AQP::UR_AQP|DPOFTrackerNonce pool mvst KST.ANHD KST.ANHD 1)])
                (expect "<<AQP-F10>> ...and so do the DPNF ones"
                    [pool dhb KST.ANHD KST.ANHD 1]
                    [(ref-AQP::UR_AQP|DPNFTrackerPoolId pool dhb KST.ANHD KST.ANHD 1)
                     (ref-AQP::UR_AQP|DPNFTrackerDpnfId pool dhb KST.ANHD KST.ANHD 1)
                     (ref-AQP::UR_AQP|DPNFTrackerOwnerId pool dhb KST.ANHD KST.ANHD 1)
                     (ref-AQP::UR_AQP|DPNFTrackerBeneficiaryId pool dhb KST.ANHD KST.ANHD 1)
                     (ref-AQP::UR_AQP|DPNFTrackerNonce pool dhb KST.ANHD KST.ANHD 1)])
            ]
        )
    )
    ""
)
(commit-tx)

