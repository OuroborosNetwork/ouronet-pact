(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(namespace "ouronet-ns")
(print "--- [AQP-G17 · 01 · models, SF definitions, boost-class links] ---")
;;Three more @event-cap guards through the Talos path, grouped because each is the entry check of
;;a different SCORE lifecycle operation.
;;==== AQP-G17 — score models, definitions and boost links · 01 · env-sigs (caps) ==== ============
(print "--- [AQP-G17 — score models, definitions and boost links · 01 · env-sigs (caps)] ---")
(env-sigs [{ "key": "PK_AncientHodler", "caps": [] }])
;;==== AQP-G17 — score models, definitions and boost links · 02 · let / invocation ==== ===========
(print "--- [AQP-G17 — score models, definitions and boost links · 02 · let / invocation] ---")
(let
    (
        (ref-U|DALOS:module{UtilityDalosV2} U|DALOS)
        (ref-TS02-C3:module{TalosStageTwo_ClientThreeV1} TS02-C3)
    )
    (map print
        [
            ;;--- issuing from a model that was never created. Unlike the triplet case in AQP-G14,
            ;;a non-existent id here is CORRECT input for the test: the guard is an existence
            ;;check and answers before anything reads the row.
            (expect-failure "<<AQP-G17>> issuing a score from a model that does not exist is refused"
                "Model must exist"
                (ref-TS02-C3::AQP-SCR|C_IssueScoreFromModel KST.ANHD KST.ANHD
                    (ref-U|DALOS::UDC_Makeid "NoSuchModel") "AgencyX"))
            ;;--- an SF score definition whose nonce and value lists disagree. The score and the
            ;;collectable are both REAL, so the only thing wrong is the pairing.
            (expect-failure "<<AQP-G17>> an SF score definition with misaligned nonce/value lists is refused"
                "Invalid score/dpsf inputs: score must exist, sft-equality false, nonce/value lists aligned"
                (ref-TS02-C3::AQP-SCR|C_IssueSemiFungibleScoreDefinition KST.ANHD
                    (ref-U|DALOS::UDC_Makeid "SfStakeScore") "DHCD-98c486052a51" [1] [1.0 2.0]))
            ;;--- a boost-class link with a BAR class id. The score is real and has no stakers, so
            ;;the guard's other half is satisfied and this is attributable to the BAR check.
            (expect-failure "<<AQP-G17>> a boost-class link with a BAR class id is refused"
                "boost-class-id must be non-BAR and the score must have no stakers"
                (ref-TS02-C3::AQP-SCR|C_CreateScoreBoostClassLink KST.ANHD
                    (ref-U|DALOS::UDC_Makeid "ResumeVacScore") "|"))
        ]
    )
    ""
)
(env-sigs [])
(commit-tx)

