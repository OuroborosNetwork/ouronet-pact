;; REPL/modules/AQP.repl — STANDALONE AQP tester (ANK/SCORE/POOL/RPS/FVT/VCT/MTX/DSA).
;; Fresh boot: Stage 00 + Stage 1 + Stage 2 deploy cores + the AQP suite umbrella.
;; Run: cd REPL && pact modules/AQP.repl
(load "../deploy-stage00.repl")
(load "../deploy-stage01.repl")
(load "../deploy-stage02.repl")
(load "../Stage_02/[6.2]_AQP.repl")

;;|| NEXT >
;;
(begin-tx "AQP-G1 — the FVT UEV_*Context validators, probed DIRECTLY")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(namespace "ouronet-ns")
(print "--- [AQP-G1 · 01 · the vacate-freeze guard, asserted DIFFERENTIALLY] ---")
;;The suite leaves TfStakeVault, NfDrainVault and OfDrainVault vacate-FROZEN and TfMosaicVault,
;;OfStakeVault, SfStakeVault, NfSyncVault unfrozen -- discovered by probing, not assumed. That
;;split is what makes the freeze guard assertable in both directions from the existing fixture,
;;and it is why the rest of this block uses SfStakeVault: on a frozen FVT the freeze enforce
;;fires FIRST and masks the other six, so every "rejection" below would have been rejecting for
;;the wrong reason. The first draft of this block did exactly that.
(env-sigs [{ "key": "PK_AncientHodler", "caps": [] }])
(let
    (
        (ref-U|DALOS:module{UtilityDalosV2} U|DALOS)
        (ref-FVT:module{AcquisitionFarmsVaultsTreasuriesV2} AQP-FVT)
        (ref-DALOS:module{OuronetDalosV2} DALOS)
        (patron:string KST.ANHD)
    )
    (let
        (
            (frozen:string (ref-U|DALOS::UDC_Makeid "TfStakeVault"))
            (live:string   (ref-U|DALOS::UDC_Makeid "SfStakeVault"))
            (ouro:string   (ref-DALOS::UR_OuroborosID))
        )
        (map print
            [
                (expect "<<AQP-G1>> TfStakeVault is vacate-frozen"
                    true (ref-FVT::UR_FVT|VacateFrozen frozen))
                (expect "<<AQP-G1>> SfStakeVault is not"
                    false (ref-FVT::UR_FVT|VacateFrozen live))
                (expect-failure "<<AQP-G1>> UEV_InjectContext refuses a FROZEN fvt before anything else"
                    "FVT is frozen: a pool it serves is mid-vacate"
                    (ref-FVT::UEV_InjectContext patron frozen ouro 1.0))
            ]
        )
    )
    ""
)
(print "--- [AQP-G1 · 02 · inject + collect context, tripped by ARGUMENT] ---")
;;FVT is the first module in this pass where the guards are COMPOSITE context validators rather
;;than single-flag checks -- UEV_CollectContext alone carries 7 enforces. They are still `UEV_`
;;and therefore unprotected, so they can be called directly; what changes is the lever. DPTF and
;;DPOF flipped a flag on the token; here the cheap trip is a BAD ARGUMENT against a live fixture.
(let
    (
        (ref-U|DALOS:module{UtilityDalosV2} U|DALOS)
        (ref-FVT:module{AcquisitionFarmsVaultsTreasuriesV2} AQP-FVT)
        (ref-DALOS:module{OuronetDalosV2} DALOS)
        (patron:string KST.ANHD)
    )
    (let
        (
            (fvt:string (ref-U|DALOS::UDC_Makeid "SfStakeVault"))
            (scr:string (ref-U|DALOS::UDC_Makeid "SfStakeScore"))
            (ouro:string (ref-DALOS::UR_OuroborosID))
            (nope:string "NOPE-98c486052a51")
        )
        (map print
            [
                ;;the happy path FIRST: without it, every rejection below could be rejecting for
                ;;the wrong reason and the block would still look green.
                (expect "<<AQP-G1>> UEV_InjectContext passes on the live fixture"
                    true (!= "" (format "{}" [(ref-FVT::UEV_InjectContext patron fvt ouro 1.0)])))
                (expect-failure "<<AQP-G1>> UEV_InjectContext rejects a zero amount"
                    "Inject amount must be positive"
                    (ref-FVT::UEV_InjectContext patron fvt ouro 0.0))
                (expect-failure "<<AQP-G1>> UEV_InjectContext rejects a negative amount"
                    "Inject amount must be positive"
                    (ref-FVT::UEV_InjectContext patron fvt ouro -1.0))
                (expect-failure "<<AQP-G1>> UEV_InjectContext rejects a reward token with no link row"
                    "Reward link row must exist"
                    (ref-FVT::UEV_InjectContext patron fvt nope 1.0))
                ;;--- collect
                (expect "<<AQP-G1>> UEV_CollectContext passes on the live fixture"
                    true (!= "" (format "{}"
                        [(ref-FVT::UEV_CollectContext patron fvt 1 scr ouro)])))
                (expect-failure "<<AQP-G1>> ...rejects a reward token with no link row"
                    "Reward link row must exist"
                    (ref-FVT::UEV_CollectContext patron fvt 1 scr nope))
                ;;entity type 2 is a REAL type, just the wrong one for this link -- a sharper
                ;;probe than an out-of-range integer, which any bounds check would also catch.
                (expect-failure "<<AQP-G1>> ...rejects a VALID entity type that is the wrong one"
                    "score-entity-type mismatch"
                    (ref-FVT::UEV_CollectContext patron fvt 2 scr ouro))
            ]
        )
    )
    ""
)
(print "===^^^===")
(commit-tx)

;;|| NEXT >
;;
(begin-tx "AQP-G2 — the SCORE stake-context family, as a CROSS-KIND matrix")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(namespace "ouronet-ns")
(print "--- [AQP-G2 · 01 · each asset kind's validator refuses the others] ---")
;;P3.3, fifth module. SCORE has five stake-context validators -- one per asset kind -- and they
;;differ in exactly one enforce: the score's CLASS. So the useful test is not five independent
;;rejections but a MATRIX: give each validator a score of the wrong class and it must refuse.
;;
;;That is the same shape as DALOS's standard/smart 2x2, widened. It proves each validator is
;;discriminating rather than merely present -- five validators that all accepted everything
;;would satisfy five independent "it rejects garbage" tests and still be broken.
(env-sigs [{ "key": "PK_AncientHodler", "caps": [] }])
(let
    (
        (ref-U|DALOS:module{UtilityDalosV2} U|DALOS)
        (ref-SCR:module{AcquisitionScoresV2} AQP-SCORE)
        (patron:string KST.ANHD)
    )
    (let
        (
            (tf-score:string (ref-U|DALOS::UDC_Makeid "TfStakeScore"))
            (tf-pool:string  (ref-U|DALOS::UDC_Makeid "TfStakePool"))
            (of-score:string (ref-U|DALOS::UDC_Makeid "OfStakeScore"))
            (of-pool:string  (ref-U|DALOS::UDC_Makeid "OfStakePool"))
            (sf-score:string (ref-U|DALOS::UDC_Makeid "SfStakeScore"))
            (sf-pool:string  (ref-U|DALOS::UDC_Makeid "SfStakePool"))
        )
        (map print
            [
                ;;preconditions -- the classes really are what the matrix assumes
                (expect "<<AQP-G2>> TfStakeScore is class 1 (true fungible)"
                    1 (ref-SCR::UR_SCR|ScoreClass tf-score))
                (expect "<<AQP-G2>> OfStakeScore is class 2 (orto fungible)"
                    2 (ref-SCR::UR_SCR|ScoreClass of-score))
                ;;--- the diagonal: each validator accepts its own kind
                (expect "<<AQP-G2>> the DPTF validator accepts a class-1 score"
                    true (!= "" (format "{}"
                        [(ref-SCR::UEV_DptfStakeScoreContext patron tf-pool tf-score)])))
                (expect "<<AQP-G2>> the DPOF validator accepts a class-2 score"
                    true (!= "" (format "{}"
                        [(ref-SCR::UEV_DpofStakeScoreContext patron of-pool of-score)])))
                ;;--- the off-diagonal: each refuses the other's class
                ;;NOTE: both halves of this guard share ONE message. CLAUDE.md prescribes
                ;;combining 3+ booleans into a single `(enforce (fold (and) true [...]) "msg")`,
                ;;which is good for brevity and bad for diagnosis: a class mismatch and a
                ;;pool-link mismatch are INDISTINGUISHABLE from the error text. These two tests
                ;;tell them apart only because each varies a different argument -- a caller
                ;;debugging in production has no such handle.
                (expect-failure "<<AQP-G2>> the DPTF validator refuses a class-2 score"
                    "score-class must be 1 (true fungible score)"
                    (ref-SCR::UEV_DptfStakeScoreContext patron of-pool of-score))
                (expect-failure "<<AQP-G2>> the DPOF validator refuses a class-1 score"
                    "score-class must be 2"
                    (ref-SCR::UEV_DpofStakeScoreContext patron tf-pool tf-score))
                ;;--- and the pool-link half of the same enforce: right class, WRONG pool
                (expect-failure "<<AQP-G2>> the DPTF validator refuses a score linked to another pool"
                    "pool-id must match aqpool-link"
                    (ref-SCR::UEV_DptfStakeScoreContext patron sf-pool tf-score))
            ]
        )
    )
    ""
)
(print "===^^^===")
(commit-tx)
