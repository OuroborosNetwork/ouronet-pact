(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(namespace "ouronet-ns")
(print "--- [AQP-G24b · 01 · issue G25Score] ---")
;;Owned by the patron, matching SfStakeVault, so the owner check passes and the
;;class-branch rule is reached instead.
(let*
    (
        (ref-DALOS:module{OuronetDalosV2} DALOS)
