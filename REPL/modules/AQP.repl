(begin-tx "AQP-G26 — the PER-ELEMENT NF score-definition rules, both modes")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
;;==== AQP-G26 — the PER-ELEMENT NF score-definition rules, both modes · 01 · namespace ==== ======
(print "--- [AQP-G26 — the PER-ELEMENT NF score-definition rules, both modes · 01 · namespace] ---")
(namespace "ouronet-ns")
(print "--- [AQP-G26 · 01 · per-element trait/set score-definition folds] ---")
;;P3.3. AQP-G5 pinned the FIRST enforce in each of these two validators -- the one demanding the
;;parallel input lists be non-empty and aligned. These are the SECOND enforce in each: the fold
;;that runs once PER ELEMENT inside the (map (lambda ...)) below it. Every case here passes
;;aligned, non-empty lists on purpose, so the already-pinned alignment guard provably cannot be
;;what answers -- only the per-element fold can.
;;
;;SET mode has four conjuncts and all four are driven separately, because the fold would still
;;reject three of these inputs if any ONE conjunct had been dropped. The negative-score clause
;;in particular is load-bearing: a negative class score flows straight into the reward
;;arithmetic, so silently admitting one mangles every payout denominated in it.
;;==== AQP-G26 — the PER-ELEMENT NF score-definition rules, both modes · 02 · let / invocation ==== 
(print "--- [AQP-G26 — the PER-ELEMENT NF score-definition rules, both modes · 02 · let / invocation] ---")
(let
    (
        (ref-DPDC:module{DpdcV2} DPDC)
        (ref-SCR:module{AcquisitionScoresV1} AQP-SCORE)
        (dhb:string "DHB-98c486052a51")
    )
    (map print
        [
            ;;preconditions. Both matter: classes-used = 0 is what makes nonce-class 1 genuinely
            ;;OUT OF RANGE below (not merely unusual), and the empty nonce-1 metadata is why only
            ;;one of trait mode's conjuncts is reachable here -- see the note at the end.
            (expect "<<AQP-G26>> DHB has 0 set-classes used, so only nonce-class 0 is in range"
                0 (ref-DPDC::UR_SetClassesUsed dhb false))
            (expect "<<AQP-G26>> ...and its first nonce carries NO trait metadata"
                "{}" (format "{}" [(ref-DPDC::UR_N|RawMetaData (ref-DPDC::UR_NativeNonceData dhb false 1))]))
            ;;--- SET mode, one conjunct at a time (the other three satisfied in each case)
            (expect-failure "<<AQP-G26>> set mode refuses a NEGATIVE nonce-class"
                "Invalid DPNF set score definition (nonce-class="
                (ref-SCR::UEV_NonFungibleScoreDefinitionSet dhb 6 [-1] [1.0]))
            (expect-failure "<<AQP-G26>> set mode refuses a nonce-class ABOVE set-classes-used"
                "Invalid DPNF set score definition (nonce-class="
                (ref-SCR::UEV_NonFungibleScoreDefinitionSet dhb 6 [1] [1.0]))
            (expect-failure "<<AQP-G26>> set mode refuses a NEGATIVE class score value"
                "Invalid DPNF set score definition (nonce-class="
                (ref-SCR::UEV_NonFungibleScoreDefinitionSet dhb 6 [0] [-1.0]))
            (expect-failure "<<AQP-G26>> set mode refuses a score value FINER than the precision"
                "Invalid DPNF set score definition (nonce-class="
                (ref-SCR::UEV_NonFungibleScoreDefinitionSet dhb 1 [0] [1.55]))
            ;;...and the in-range form is ACCEPTED. Without this the four rejections above would
            ;;be satisfied just as well by a fold that refused every input.
            (expect "<<AQP-G26>> set mode ACCEPTS nonce-class 0 with a precision-clean score"
                true (!= "" (format "{}" [(ref-SCR::UEV_NonFungibleScoreDefinitionSet dhb 6 [0] [1.0])])))
            ;;--- TRAIT mode: the trait key must be present in the first nonce's metadata.
            (expect-failure "<<AQP-G26>> trait mode refuses a key ABSENT from the nonce metadata"
                "Invalid DPNF trait definition (key="
                (ref-SCR::UEV_NonFungibleScoreDefinitionTrait dhb 6 ["nope"] ["ab"] [1.0]))
        ]
    )
    ""
)
;;NOT PINNED — trait mode's other three conjuncts (trait-value length 2..256, score precision,
;;non-negative score) cannot be ISOLATED against DHB: its nonce-1 metadata is {}, so
;;iz-key-present is false for every possible key and that conjunct answers first whatever else
;;the input does. Driving them needs a DPNF whose first nonce carries real traits; DHB is minted
;;by [6.2.4]_AQP-FVT-NF without metadata. One mint with a populated meta-data-array would close
;;all three at once.
(commit-tx)

