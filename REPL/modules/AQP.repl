(begin-tx "AQP-G21 — UEV_IssueMultipletFamilyContext: the OURO → Auryn → Elite-Auryn chain")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(namespace "ouronet-ns")
(print "--- [AQP-G21 · 01 · multiplet family admission] ---")
;;A multiplet family is a three-token chain where each token is the REWARD-BEARING output of the
;;ATS pair below it: OURO --Coil--> Auryn --Curl--> Elite-Auryn. The validator enforces that
;;shape, and it is an ordinary UEV_ so it is called directly with no capability at all.
;;
;;THE HAPPY PATH IS ASSERTED FIRST and it is what makes the rest meaningful: the live chain
;;(OURO, Auryn, Elite-Auryn over Auryndex and EliteAuryndex) is accepted. Every rejection below is
;;that exact tuple with ONE element changed, so each failure is attributable to the change.
;;==== AQP-G21 — UEV_IssueMultipletFamilyContext: the OURO → Auryn → Elite-Auryn chain · 01 · env-sigs (caps) ==== 
(print "--- [AQP-G21 — UEV_IssueMultipletFamilyContext: the OURO → Auryn → Elite-Auryn chain · 01 · env-sigs (caps)] ---")
(env-sigs [{ "key": "PK_AncientHodler", "caps": [] }])
(let*
    (
        (ref-DALOS:module{OuronetDalosV2} DALOS)
        (ouro:string "OURO-98c486052a51")
        (auryn:string (ref-DALOS::UR_AurynID))
        (elite:string (ref-DALOS::UR_EliteAurynID))
        (a1:string "Auryndex-98c486052a51")
        (a2:string "EliteAuryndex-98c486052a51")
    )
    (map print
        [
            (expect "<<AQP-G21>> the real OURO→Auryn→Elite chain is accepted"
                true (AQP-FVT.UEV_IssueMultipletFamilyContext ouro auryn elite a1 a2))
            ;;token-1 replaced by one that is NOT the Coil output of the first pair
            (expect-failure "<<AQP-G21>> token-1 that is not reward-bearing on the first pair is refused"
                "MultipletFamily token-1 must be reward-bearing on first ATS pair (Coil output)"
                (AQP-FVT.UEV_IssueMultipletFamilyContext ouro ouro elite a1 a2))
            ;;token-2 valid as a token but not the Curl output of the SECOND pair
            (expect-failure "<<AQP-G21>> ...and token-2 not reward-bearing on the second pair likewise"
                "MultipletFamily token-2 must be reward-bearing on second ATS pair (Curl output)"
                (AQP-FVT.UEV_IssueMultipletFamilyContext ouro auryn elite a1 a1))
            ;;both RBT relationships hold — auryn IS the Coil output of a1 — so the only thing
            ;;wrong is that token-0 and token-1 are the same token. That is what makes this
            ;;attributable to the distinctness guard rather than to either check above it.
            (expect-failure "<<AQP-G21>> a chain that repeats a token is refused on distinctness"
                "Invalid MultipletFamily issue: tokens and ATS pairs must be distinct"
                (AQP-FVT.UEV_IssueMultipletFamilyContext auryn auryn elite a1 a2))
        ]
    )
    ""
)
(commit-tx)

