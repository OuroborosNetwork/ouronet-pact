            [
                (expect "<<AQP-G32>> GAP restored to the value this block found" gap0 (ref-DALOS::UR_GAP))
                (expect "<<AQP-G32>> ...and TS02-C3's P|TS is acquirable once more"
                    true (!= "" (format "{}" [(test-capability (TS02-C3.P|TS))])))
            ]
        )
        ""
    )
)
(env-sigs [])
(commit-tx)

