(begin-tx "AQP-G4 — ANK's fungibility tuple, as a truth table on one list argument")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
;;==== AQP-G4 — ANK's fungibility tuple, as a truth table on one list argument · 01 · namespace ==== 
(print "--- [AQP-G4 — ANK's fungibility tuple, as a truth table on one list argument · 01 · namespace] ---")
(namespace "ouronet-ns")
(print "--- [AQP-G4 · 01 · asset-fungibility tuple] ---")
;;P3.3, list-shape class. UEV_AnkFungibility enforces (and (= l 2) (!= tuple [true false])) on a
;;single [bool] argument -- no state, so the whole domain is reachable for free. TWO independent
;;reasons to reject, and they must be separated: a wrong LENGTH and a forbidden VALUE of the
;;right length. A single bad input would prove neither clause on its own.
;;
;;[true false] is the one 2-element tuple that is excluded, so it isolates the value clause --
;;length 2 passes the first conjunct and only the second can fire. [true] isolates the length
;;clause the same way.
;;
;;The message "Invalid Fungibility" is a SUBSTRING of DEMIPAD's "Invalid Fungibility variable",
;;so this is pinned through ref-ANK:: -- the module reference is what keeps the attribution on
;;AQP-ANK rather than crediting both.
;;==== AQP-G4 — ANK's fungibility tuple, as a truth table on one list argument · 02 · let / invocation ==== 
(print "--- [AQP-G4 — ANK's fungibility tuple, as a truth table on one list argument · 02 · let / invocation] ---")
(let
    (
        (ref-ANK:module{AcquisitionAnchorsV1} AQP-ANK)
    )
    (map print
        [
            ;;--- accepted: length 2 and not the excluded tuple
            (expect "<<AQP-G4>> [true true] is a valid fungibility tuple"
                true (!= "" (format "{}" [(ref-ANK::UEV_AnkFungibility [true true])])))
            (expect "<<AQP-G4>> [false false] is a valid fungibility tuple"
                true (!= "" (format "{}" [(ref-ANK::UEV_AnkFungibility [false false])])))
            (expect "<<AQP-G4>> [false true] is a valid fungibility tuple"
                true (!= "" (format "{}" [(ref-ANK::UEV_AnkFungibility [false true])])))
            ;;--- rejected: the VALUE clause, at the right length
            (expect-failure "<<AQP-G4>> [true false] is the one excluded 2-tuple"
                "Invalid Fungibility" (ref-ANK::UEV_AnkFungibility [true false]))
            ;;--- rejected: the LENGTH clause, on each side of 2
            (expect-failure "<<AQP-G4>> a 1-element tuple is refused"
                "Invalid Fungibility" (ref-ANK::UEV_AnkFungibility [true]))
            (expect-failure "<<AQP-G4>> a 3-element tuple is refused"
                "Invalid Fungibility" (ref-ANK::UEV_AnkFungibility [true true true]))
        ]
    )
    ""
)
(commit-tx)

;;|| NEXT >
