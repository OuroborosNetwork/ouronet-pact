(begin-tx "AQP-G15 — SCR|XE>UPDATE-STAKE-DPSF: a zero nonce amount is not a stake")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(namespace "ouronet-ns")
(print "--- [AQP-G15 · 01 · dpsf positive amount] ---")
;;This guard sits BELOW the arity check pinned in AQP-G8d, so the lists here are deliberately
;;well-formed — one nonce, one amount, equal positive length. The only thing wrong is that the
;;amount is zero, which would credit a score for a stake of nothing.
;;==== AQP-G15 — SCR|XE>UPDATE-STAKE-DPSF: a zero nonce amount is not a stake · 01 · env-sigs (caps) ==== 
(print "--- [AQP-G15 — SCR|XE>UPDATE-STAKE-DPSF: a zero nonce amount is not a stake · 01 · env-sigs (caps)] ---")
(env-sigs [{ "key": "PK_AncientHodler", "caps": [] }])
(let*
    (
        (ref-U|DALOS:module{UtilityDalosV2} U|DALOS)
        (pool:string (ref-U|DALOS::UDC_Makeid "SfStakePool"))
        (score:string (ref-U|DALOS::UDC_Makeid "SfStakeScore"))
    )
    (map print
        [
            (expect-failure "<<AQP-G15>> a well-formed pair carrying a ZERO amount is refused"
                "DPSF stake nonce amount must be positive"
                (test-capability (AQP-SCORE.SCR|XE>UPDATE-STAKE-DPSF
                    KST.ANHD pool score "DHCD-98c486052a51" [1] [0] true)))
            (expect-failure "<<AQP-G15>> ...and so is a negative one"
                "DPSF stake nonce amount must be positive"
                (test-capability (AQP-SCORE.SCR|XE>UPDATE-STAKE-DPSF
                    KST.ANHD pool score "DHCD-98c486052a51" [1] [-1] true)))
        ]
    )
    ""
)
;;NOT PINNED: the DPNF twin of the guard above needs a real NON-fungible collectable id. This
;;suite's only collectable is DHCD, which is semi-fungible, so UEV_id rejects it as a DPNF two
;;lines before the amount is examined. modules/DPNF.repl has such an id but no AQP pool to stake
;;it against.
(commit-tx)

;;|| NEXT >
