(begin-tx "AQP-G11a — close the ORTO pool for staking (borrowing [6.2.10]'s disable/restore recipe)")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(namespace "ouronet-ns")
(print "--- [AQP-G11a · 01 · disable OfStakePool] ---")
;;WHY THIS EXISTS. "pool stake disabled or has no employed scores" occurs at THREE sites in FVT —
;;one per stake flow — with identical text. AQP-G9 drives only the true-fungible one, and the
;;coverage tool credits shared wording within a module without being able to tell the sites apart,
;;so two of those three credits were NOMINAL. This block and the next make them real.
;;
;;The recipe is lifted from [6.2.10]_AQP-NEGATIVES: disable in its own transaction, assert, restore
;;in another. One IGNIS-collecting client op per transaction, and the toggle is called WITHOUT a
;;(try …) wrapper because it writes — Pact forbids database writes inside `try`.
;;==== AQP-G11a — close the ORTO pool for staking (borrowing [6.2.10]'s disable/restore recipe) · 01 · env-sigs (caps) ==== 
(print "--- [AQP-G11a — close the ORTO pool for staking (borrowing [6.2.10]'s disable/restore recipe) · 01 · env-sigs (caps)] ---")
(env-sigs [{ "key": "PK_AncientHodler", "caps": [] }])
(let*
    (
        (ref-U|DALOS:module{UtilityDalosV2} U|DALOS)
        (ref-TS02-C3:module{TalosStageTwo_ClientThreeV1} TS02-C3)
        (of:string (ref-U|DALOS::UDC_Makeid "OfStakePool"))
    )
    (ref-TS02-C3::AQP-POOL|C_DisablePoolStake KST.ANHD (AQP-POOL.URC_AqpOwnerKonto of) of)
    ""
)
(commit-tx)

