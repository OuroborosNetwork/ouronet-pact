(begin-tx "AQP-F6 — VCT: the shadowed batch guard gets its voice back")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
;;==== AQP-F6 — VCT: the shadowed batch guard gets its voice back · 01 · namespace ==== ===========
(print "--- [AQP-F6 — VCT: the shadowed batch guard gets its voice back · 01 · namespace] ---")
(namespace "ouronet-ns")
(print "--- [AQP-F6 · 01 · an empty vacate batch is REFUSED, not faulted] ---")
;;MUTE-GUARD FIX, verified live before and after (2026-09-13).
;;
;;`VCT|C>TRUE-FUNGIBLE-VACATE-BATCH` validates its parallel owner/beneficiary/amount arrays through
;;`URC_TfOwnerArraysGasOk`, which really does test `(> l 0)`. But that verdict lands in a `let`
;;BINDING, and a SIBLING binding in the same group builds the legs:
;;
;;    (gas-ok:bool  (URC_TfOwnerArraysGasOk owner-ids beneficiary-ids amounts))
;;    (legs:[...]   (UC_TfLegsFromParallelArrays owner-ids beneficiary-ids amounts))   ;; <- faulted
;;    ...
;;    (enforce (fold (and) true [class-ok asset-ok gas-ok owners-ok]) "Invalid TF vacate cap input")
;;
;;Pact evaluates let bindings eagerly, so on an empty batch `legs` faulted on
;;`(enumerate 0 -1)` -> `[0, -1]` -> `(at 0 [])` BEFORE the enforce could read `gas-ok`. The guard
;;computed the right answer and never got to say it; the caller saw "Array index out of bounds".
;;
;;MEASURED BEFORE THE FIX, which is what makes this a regression test and not a hopeful one:
;;    (URC_TfOwnerArraysGasOk [] [] [])      => false      <- the guard KNEW
;;    (UC_TfLegsFromParallelArrays [] [] []) => FAULT      <- but this ran first
;;
;;Four functions in this module carried the same trap; all four are now total.
;;==== AQP-F6 — VCT: the shadowed batch guard gets its voice back · 02 · let / invocation ==== ====
(print "--- [AQP-F6 — VCT: the shadowed batch guard gets its voice back · 02 · let / invocation] ---")
(let
    (
        (ref-VCT:module{AcquisitionVacateV1} AQP-VCT)
    )
    (map print
        [
            ;;the guard still says what it always said -- the fix did not touch it
            (expect "<<AQP-F6>> the shape guard still rejects an empty batch"
                false (ref-VCT::URC_TfOwnerArraysGasOk [] [] []))
            ;;...and it accepts a well-formed one, so it is not simply always-false
            (expect "<<AQP-F6>> ...and accepts a well-formed one-leg batch"
                true (ref-VCT::URC_TfOwnerArraysGasOk [KST.ANHD] [KST.ANHD] [1.0]))
            ;;THE REPAIR: the leg builder is now TOTAL, so it no longer pre-empts the enforce.
            ;;Before the fix this line faulted.
            (expect "<<AQP-F6>> the leg builder returns NO legs for an empty batch, instead of faulting"
                [] (ref-VCT::UC_TfLegsFromParallelArrays [] [] []))
            ;;and it still builds real legs from a real batch, unchanged
            (expect "<<AQP-F6>> ...while a one-leg batch still builds exactly one leg"
                1 (length (ref-VCT::UC_TfLegsFromParallelArrays [KST.ANHD] [KST.EMMA] [5.0])))
            ;;the three siblings that carried the same trap, now total too. Each returns its own
            ;;natural empty: the merges return the fold's zero object, the tracker resolver [].
            (expect "<<AQP-F6>> the DECIMAL per-beneficiary merge is total on an empty batch"
                {"nonces": [], "amounts": []}
                (ref-VCT::UC_VacateMergeDecimalNonceRowsForBeneficiary KST.ANHD [] [] []))
            (expect "<<AQP-F6>> ...and so is the INTEGER one"
                {"nonces": [], "amounts": []}
                (ref-VCT::UC_VacateMergeIntNonceRowsForBeneficiary KST.ANHD [] [] []))
            ;;...and they still merge a real row, so totality did not cost correctness
            (expect "<<AQP-F6>> ...and the merge still concatenates a matching row"
                {"nonces": [1 2], "amounts": [10 20]}
                (ref-VCT::UC_VacateMergeIntNonceRowsForBeneficiary
                    KST.ANHD [KST.ANHD] [[1 2]] [[10 20]]))
            ;;...and still SKIPS a non-matching beneficiary, which is the function's actual job
            (expect "<<AQP-F6>> ...and still skips a row belonging to a different beneficiary"
                {"nonces": [], "amounts": []}
                (ref-VCT::UC_VacateMergeIntNonceRowsForBeneficiary
                    KST.ANHD [KST.EMMA] [[1 2]] [[10 20]]))
        ]
    )
    ""
)
(commit-tx)

;;|| NEXT >
