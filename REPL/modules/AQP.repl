(begin-tx "AQP-G20b — the vault-class rule and the oracle-validity floor")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(namespace "ouronet-ns")
(print "--- [AQP-G20b · 01 · vault class, oracle validity] ---")
;;A delegation vault must be a class-0 FARM. Vaults and treasuries (class 1-2) have no LP
;;denominator, and the agency's capture arithmetic is denominated in one — so binding one would
;;produce a vault whose capture cannot be computed. SfStakeVault is class 1, which is what makes
;;it the right negative input rather than a nonsense id.
;;==== AQP-G20b — the vault-class rule and the oracle-validity floor · 01 · env-sigs (caps) ==== ==
(print "--- [AQP-G20b — the vault-class rule and the oracle-validity floor · 01 · env-sigs (caps)] ---")
(env-sigs [{ "key": "PK_AncientHodler", "caps": [] }])
(let*
    (
        (ref-U|DALOS:module{UtilityDalosV2} U|DALOS)
        (ref-RPS:module{AcquisitionRewardPerShareV1} RPS)
        (ref-TS02-C3:module{TalosStageTwo_ClientThreeV1} TS02-C3)
        (vault:string (ref-U|DALOS::UDC_Makeid "SfStakeVault"))
    )
    (map print
        [
            (expect "<<AQP-G20b>> SfStakeVault is class 1, not a farm"
                1 (ref-RPS::UR_FVT|FvtClass vault))
            (expect-failure "<<AQP-G20b>> binding a non-farm FVT as a delegation vault is refused"
                "DSA vault must be a class-0 FVT"
                (ref-TS02-C3::AQP-DSA|C_DefineDelegationVault KST.ANHD KST.ANHD vault
                    (ref-U|DALOS::UDC_Makeid "NoModel") 10))
            ;;the oracle-validity window is how long an oracle write stays fresh; zero or negative
            ;;would make every write instantly stale, or permanently fresh.
            (expect-failure "<<AQP-G20b>> a negative oracle-validity window is refused"
                "oracle-validity must be positive"
                (AQP-DSA.A_SetOracleValidity -1))
            (expect-failure "<<AQP-G20b>> ...and zero likewise"
                "oracle-validity must be positive"
                (AQP-DSA.A_SetOracleValidity 0))
        ]
    )
    ""
)
;;NOT PINNED, with the reason: the four "Only the FVT owner may …" guards (set-oracle-auth, burn
;;royalty, fuel royalty, set agency fee) and both "Score entity is not a delegation member" guards
;;all sit BEHIND a "DSA vault not defined or inactive" check. No DSA vault is defined in any suite,
;;so that check answers first every time. Defining one needs a class-0 FVT (OuroLpFarm, which lives
;;in the BOOT suite) plus a score model — a real fixture build rather than a cross-load.
(env-sigs [])
(commit-tx)

