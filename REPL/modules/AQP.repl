(begin-tx "AQP-G23a — issue a SECOND class-0 farm, unlinked (the missing second instance)")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(namespace "ouronet-ns")
(print "--- [AQP-G23a · 01 · issue G23Farm] ---")
;;A recurring blocker across this module: several guards need a SECOND instance of something the
;;suites hold exactly one of. UEV_SetCommonDenominatorContext is the clearest case — its shape
;;guard only speaks for a class-0 farm with ZERO linked score entities, and the only farm anywhere
;;(OuroLpFarm, in the BOOT suite) is linked, so the immutability guard above it always answers
;;first (see TX-BOOT-G2).
;;
;;So this issues one: a real class-0 farm through the real Talos client path, denominated in OURO.
;;It is ADDITIVE — a new row, no existing state touched — and it is created at the END of this
;;file, so nothing earlier can see it.
;;
;;The STOA fee wiring is the fiddly part and is why guards like this stay unpinned: C_Issue
;;collects 100 STOA, split four ways, so the signer needs four coin.TRANSFER capabilities with the
;;exact split amounts. They are DERIVED from URC_SplitSTOAPrices rather than hardcoded, so the
;;block survives a price change.
(let*
    (
        (ref-DALOS:module{OuronetDalosV2} DALOS)
        (ref-TS02-C3:module{TalosStageTwo_ClientThreeV1} TS02-C3)
        (patron:string KST.ANHD)
        (patron-stoa:string (ref-DALOS::UR_AccountStoa patron))
        (demiurgoi:[string] (ref-DALOS::UR_DemiurgoiID))
        (split-stoa:[decimal] (ref-DALOS::URC_SplitSTOAPrices patron 100.0))
    )
    (env-sigs
        [
            { "key": "PK_AncientHodler", "caps": [] }
            { "key": "6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263",
              "caps":
                [
                    (coin.TRANSFER patron-stoa (ref-DALOS::UR_AccountStoa (at 1 demiurgoi)) (at 2 split-stoa))
                    (coin.TRANSFER patron-stoa (ref-DALOS::UR_AccountStoa (at 2 demiurgoi)) (at 0 split-stoa))
                    (coin.TRANSFER patron-stoa (ref-DALOS::UR_AccountStoa (ref-DALOS::GOV|OUROBOROS|SC_NAME)) (at 3 split-stoa))
                    (coin.TRANSFER patron-stoa (ref-DALOS::UR_AccountStoa (ref-DALOS::GOV|DALOS|SC_NAME)) (at 1 split-stoa))
                ]
            }
        ]
    )
    (ref-TS02-C3::AQP-FVT|C_Issue patron "G23Farm" patron 0 "OURO-98c486052a51")
    ""
)
(env-sigs [])
(commit-tx)

;;|| NEXT >
