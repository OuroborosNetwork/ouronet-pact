(begin-tx "AQP-F12 — SCORE: the SEMI-FUNGIBLE definition family, which the suite already populates")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(namespace "ouronet-ns")
(print "--- [AQP-F12 · 01 · SF per-nonce score definitions and their revision counter] ---")
;;The semi-fungible twin of <<AQP-F11>>, and the contrast between them is the point: these readers
;;were unreached for the opposite reason. `[6.2.2]` issues FOUR SF definitions for
;;TheCodingDivision / DHCD, so the rows have existed all along -- nothing had simply ever read them.
;;
;;THE REVISION COUNTER IS THE VALUABLE PART. `[6.2.2]` deliberately RE-ISSUES the same nonce range
;;with a different value (1-10 at 1.0, then nonce 11 at 10.0, then 1-10 again at 5.0, then 11 at
;;75.0). So the stored value must be the LAST write, not the first, and the revision counter must
;;have counted every one -- which is what a consumer polls to know its cached weights are stale.
(let
    (
        (ref-SCR:module{AcquisitionScoresV1} AQP-SCORE)
        (tcd:string "TheCodingDivision-98c486052a51")
        (dhcd:string "DHCD-98c486052a51")
    )
    (map print
        [
            ;;the per-field readers round-trip the three-component key
            (expect "<<AQP-F12>> the SF definition row round-trips its key"
                [tcd dhcd 1]
                [(ref-SCR::UR_S-DEF|SFScoreScoreId tcd dhcd 1)
                 (ref-SCR::UR_S-DEF|SFScoreDpsfId tcd dhcd 1)
                 (ref-SCR::UR_S-DEF|SFScoreNonce tcd dhcd 1)])
            ;;LAST WRITE WINS: nonce 1 was issued at 1.0 and then re-issued at 5.0. A definition path
            ;;that inserted rather than updated would still hold 1.0 here.
            (expect "<<AQP-F12>> nonce 1 holds the RE-ISSUED value (5.0), not the original 1.0"
                5.0 (at "nonce-score-value" (ref-SCR::UR_S-DEF|SFScore tcd dhcd 1)))
            ;;...and nonce 11, whose two issues were 10.0 then 75.0, is independent of the 1-10 range
            (expect "<<AQP-F12>> ...and nonce 11 holds ITS re-issued value (75.0), independently"
                75.0 (at "nonce-score-value" (ref-SCR::UR_S-DEF|SFScore tcd dhcd 11)))
            ;;the revision row round-trips its two-component key
            (expect "<<AQP-F12>> the SF revision row round-trips its key"
                [tcd dhcd]
                [(ref-SCR::UR_S-DEF-REV|SFDefRevisionScoreId tcd dhcd)
                 (ref-SCR::UR_S-DEF-REV|SFDefRevisionDpsfId tcd dhcd)])
            ;;...and counted all four issues. Unlike the NF row this table carries ONE counter, since
            ;;SF has no trait/class split -- pinned so the asymmetry with <<AQP-F11>>'s 2/1/1 is
            ;;recorded rather than read as an inconsistency.
            (expect "<<AQP-F12>> the revision counter counted all FOUR definition issues"
                4 (at "revision-nonce" (ref-SCR::UR_S-DEF-REV|SFDefRevision tcd dhcd)))
        ]
    )
    ""
)
(commit-tx)

;;|| NEXT >
