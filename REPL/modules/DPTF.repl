(begin-tx "DPTF-G8 — the fee-promile backstop, reached by writing the state directly")
(env-gasmodel "table")(env-gaslimit 100000000)(env-gas 0)
(namespace "ouronet-ns")
(print "--- [DPTF-G8 · 01 · a promile no setter would accept] ---")
;;This guard was recorded here as unreachable, with a reason that was correct but incomplete:
;;
;;    (or (= promile -1.0) (and (>= promile 0.0) (<= promile 1000.0)))
;;    -- "every value C_SetFee will accept already satisfies it, so no supported path can produce
;;       a violating promile."
;;
;;True, and that makes it a fail-closed BACKSTOP rather than a live rule -- but "no supported path
;;produces the state" is not the same as "the guard cannot be tested". `env-module-admin DPTF`
;;writes the promile directly, which is what a corrupted row or a future careless setter would look
;;like, and the guard answers. See 2026-09-12-state-driven-guard-coverage.md for the pattern and
;;its boundary: this pins the guard's REACTION and claims nothing about reachability in production.
(env-sigs
    [ { "key": "PK_AncientHodler", "caps": [] }
      ;;AKOSON is an AOZ-owned token; CAP_Owner runs after the promile enforce, so the owner signer
      ;;is needed only for the PASSING contrast below.
      { "key": "PK_AOZ", "caps": [] }
    ]
)
(let ((tok:string "AKOSON-98c486052a51"))
    (map print
        [
            (expect "<<DPTF-G8>> the token starts with a legal promile and fee collection off"
                [0.0 false] [(DPTF.UR_FeePromile tok) (DPTF.UR_FeeToggle tok)])
        ]
    )
    (env-module-admin DPTF)
    ;;1500 promile = 150%, outside the [0,1000] band and not the -1.0 sentinel.
    (update DPTF.DPTF|PropertiesTable tok { "fee-promile" : 1500.0 })
    (map print
        [
            (expect-failure "<<DPTF-G8>> fee collection cannot be turned on with an out-of-band promile"
                "Please Set up Fee Promile before Turning Fee Collection on !"
                (TS01-C1.DPTF|C_ToggleFee KST.ANHD (DPTF.UR_Konto tok) tok true))
            ;;the -1.0 SENTINEL is explicitly allowed by the same condition -- it means "fee not
            ;;configured", and the guard's own message reads as if it should reject that. It does
            ;;not. Pinned because the message is misleading about what it enforces.
            (expect "<<DPTF-G8>> ...and the -1.0 sentinel IS accepted, despite what the message says"
                true
                (let ((ignore (update DPTF.DPTF|PropertiesTable tok { "fee-promile" : -1.0 })))
                    (!= "" (TS01-C1.DPTF|C_ToggleFee KST.ANHD (DPTF.UR_Konto tok) tok true))))
        ]
    )
    ""
)
(rollback-tx)

;;|| NEXT >
;;
(begin-tx "DPTF-G9 — DPTF-G7 and DPTF-G8 left no trace")
(namespace "ouronet-ns")
(print "--- [DPTF-G9 · 01 · no leakage from either fixture] ---")
;;G7 froze an account, wiped 1.0 OURO and destroyed supply; G8 wrote an illegal fee promile twice
;;and turned fee collection on. Both ended in rollback-tx. If either had committed, later suites
;;would inherit a frozen ANHD or a token charging 150% fees, and nothing downstream would question
;;it. Two lines to assert, so asserted.
(map print
    [
        (expect "<<DPTF-G9>> ANHD is unfrozen for OURO again"
            false (DPTF.UR_AccountFrozenState (DALOS.UR_OuroborosID) KST.ANHD))
        (expect "<<DPTF-G9>> ...and its OURO balance is whole, so the 1.0 wipe was rolled back"
            true (> (DPTF.UR_AccountSupply (DALOS.UR_OuroborosID) KST.ANHD) 1567573.0))
        (expect "<<DPTF-G9>> the AKOSON fee promile and toggle are the originals"
            [0.0 false]
            [(DPTF.UR_FeePromile "AKOSON-98c486052a51") (DPTF.UR_FeeToggle "AKOSON-98c486052a51")])
    ]
)
(commit-tx)

;;|| NEXT >
