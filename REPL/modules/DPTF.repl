(begin-tx "DPTF-G10 — clearing a dispo: the two preconditions, and the smart-account exclusion")
(env-gasmodel "table")(env-gaslimit 100000000)(env-gas 0)
(namespace "ouronet-ns")
(print "--- [DPTF-G10 · 01 · a dispo clear needs a DEBT to clear] ---")
;;TFT's DPTF|C>CLEAR-DISPO (09_TFT.pact:310-311) carries two guards, in this order:
;;    (enforce (< ouro-amount 0.0) "Dispo Clear requires Negative OURO")
;;    (enforce (not account-type)  "Standard Dispo can only be cleared on Standard Ouronet Accounts")
;;Both were unpinned. The FIRST needs no fixture whatsoever -- every funded account in this suite holds
;;positive OURO, so the guard fires on the first account you try. It had simply never been called.
;;
;;"Dispo" is the OURO credit line: an account may go NEGATIVE in OURO down to a floor, and clearing the
;;dispo settles that debt. So "requires Negative OURO" is not a sanity check, it is the operation's
;;whole premise -- there is nothing to clear on an account in credit.
;;==== DPTF-G10 — clearing a dispo: the two preconditions, and the smart-account exclusion · 01 · env-sigs (caps) ==== 
(print "--- [DPTF-G10 — clearing a dispo: the two preconditions, and the smart-account exclusion · 01 · env-sigs (caps)] ---")
;;BOTH principals sign, because after the patron/executor canon sweep every clear below is a
;;SELF clear and each one must prove its own ownership. Before the sweep DPTF|C>CLEAR-DISPO
;;enforced ownership of NOBODY and ANHD's single signature carried EMMA's clear too -- see
;;DPTF-G10c, which is the assertion that would have caught it.
(env-sigs [{ "key": "PK_AncientHodler", "caps": [] }, { "key": "PK_Emma", "caps": [] }])
;;==== DPTF-G10 — clearing a dispo: the two preconditions, and the smart-account exclusion · 02 · let / invocation ==== 
(print "--- [DPTF-G10 — clearing a dispo: the two preconditions, and the smart-account exclusion · 02 · let / invocation] ---")
(let
    (
        (ref-DALOS:module{OuronetDalosV2} DALOS)
        (ref-DPTF:module{DemiourgosPactTrueFungibleV2} DPTF)
        (ref-TS01-C1:module{TalosStageOne_ClientOneV2} TS01-C1)
    )
    (let
        (
            (ouro:string (ref-DALOS::UR_OuroborosID))
            (treasury:string (at 0 (ref-DALOS::UR_DemiurgoiID)))
        )
        (map print
            [
                (expect "<<DPTF-G10>> ANHD is a STANDARD account holding POSITIVE OURO"
                    [false true]
                    [(ref-DALOS::UR_AccountType KST.ANHD)
                     (> (ref-DPTF::UR_AccountSupply ouro KST.ANHD) 0.0)])
                ;;GUARD 1, zero-fixture: nothing to clear.
                (expect-failure "<<DPTF-G10>> clearing a dispo on an account in credit is refused"
                    "Dispo Clear requires Negative OURO"
                    (ref-TS01-C1::DPTF|C_ClearDispo KST.ANHD KST.ANHD))
            ]
        )
        (print "--- [DPTF-G10 · 02 · ...and then only on a STANDARD account] ---")
        ;;GUARD 2 sits BEHIND guard 1, so reaching it needs an account that is SMART *and* in debt.
        ;;The treasury is the one smart account whose OURO balance is meaningful, and DPTF-G6 already
        ;;established how to put it in debt: its balance lives at
        ;;DALOS|AccountTable[treasury]."ouroboros"."balance". Same pattern, same rollback discipline
        ;;(2026-09-12-state-driven-guard-coverage.md); DPTF-G10b is the leakage check.
        ;;
        ;;Why the exclusion exists: a smart account's debt is settled by its owning contract's own
        ;;logic (A_WipeTreasuryDebt for the treasury, pinned by DPTF-G6), not by the generic
        ;;standard-account dispo path -- so the generic path refuses rather than half-settling it.
        ;;GUARD 2 NOW SITS BEHIND AN OWNERSHIP GATE, so the fixture has to satisfy the gate to
        ;;reach the guard -- the CLAUDE.md rule "a fixture that satisfies the first guard exposes
        ;;BOTH", rather than reordering the capability to expose one at a time. Ownership of a
        ;;SMART account is enforce-one over {account-guard, sovereign-guard, governor}; pointing
        ;;the treasury's GOVERNOR at ANHD's guard is the cheapest of the three to satisfy and is
        ;;rolled back with everything else in this tx (DPTF-G10b is the leakage check).
        (env-module-admin DALOS)
        (update ref-DALOS::DALOS|AccountTable treasury
            { "ouroboros" :
                (+ { "balance" : -500.0 } (ref-DALOS::UR_TrueFungible treasury true))
            , "governor" : (ref-DALOS::UR_AccountGuard KST.ANHD) })
        (map print
            [
                (expect "<<DPTF-G10>> the treasury is SMART and now in debt -- past guard 1"
                    [true -500.0]
                    [(ref-DALOS::UR_AccountType treasury)
                     (ref-DPTF::UR_AccountSupply ouro treasury)])
                (expect-failure "<<DPTF-G10>> ...so guard 2 answers: a SMART account's dispo is not clearable here"
                    "Standard Dispo can only be cleared on Standard Ouronet Accounts"
                    (ref-TS01-C1::DPTF|C_ClearDispo KST.ANHD treasury))
                ;;...and the message is the POINT, not the refusal. Reaching guard 2 at all proves
                ;;the ownership gate above it passed; if the governor line were dropped from the
                ;;fixture this same call would still fail, on "Keyset failure", and a test that
                ;;only asserted "it failed" could not tell the two apart.
                ;;...and the SAME debt on a STANDARD account CLEARS. Without this the assertion above
                ;;would also pass if clear-dispo were broken for every account, and the pair is what
                ;;shows guard 2 is about the account TYPE rather than about the debt. The clear mints
                ;;the owed OURO back, so the balance lands on exactly 0.0.
                (expect "<<DPTF-G10>> ...while the identical debt on a STANDARD account clears to zero"
                    0.0
                    (let ((ignore0 (update ref-DALOS::DALOS|AccountTable KST.ANHD
                                       { "ouroboros" :
                                           (+ { "balance" : -500.0 }
                                              (ref-DALOS::UR_TrueFungible KST.ANHD true)) })))
                        (let ((ignore1 (ref-TS01-C1::DPTF|C_ClearDispo KST.ANHD KST.ANHD)))
                            (ref-DPTF::UR_AccountSupply ouro KST.ANHD))))
                ;;WHAT THE CLEAR COSTS, found by trying EMMA first and reading the failure: clearing a
                ;;dispo is PAID FOR IN ELITEAURYN, so an account with a debt it cannot afford to settle
                ;;is refused -- not by either guard above, but by the EliteAuryn debit underneath
                ;;("Cannot Debit DPTF ELITEAURYN-… into the negatives", pinned elsewhere in this file).
                ;;EMMA holds none. Recorded because "standard account + negative OURO" is NOT sufficient
                ;;for a clear to succeed, and the two guards above say nothing about the third condition.
                (expect "<<DPTF-G10>> EMMA holds no ELITEAURYN, which is what a clear is paid in"
                    0.0 (ref-DPTF::UR_AccountSupply (ref-DALOS::UR_EliteAurynID) KST.EMMA))
                ;;NOTE THE EXECUTOR. Pre-sweep this line read `DPTF|C_ClearDispo KST.ANHD KST.EMMA`
                ;;-- ANHD, holding only ANHD's key, clearing EMMA's dispo -- and it got as far as
                ;;EMMA's EliteAuryn balance. It is EMMA's own clear now, and ANHD remains the
                ;;PATRON, which is the separation the canon is for: paying for an operation and
                ;;being its subject are different things.
                (expect-failure "<<DPTF-G10>> ...so her debt cannot be cleared, on cost rather than on type"
                    "Cannot Debit DPTF"
                    (let ((ignore0 (update ref-DALOS::DALOS|AccountTable KST.EMMA
                                       { "ouroboros" :
                                           (+ { "balance" : -500.0 }
                                              (ref-DALOS::UR_TrueFungible KST.EMMA true)) })))
                        (ref-TS01-C1::DPTF|C_ClearDispo KST.ANHD KST.EMMA)))
            ]
        )
    )
    ""
)
(env-sigs [])
;;this tx fabricated debt on two accounts and settled one of them
(rollback-tx)

;;|| NEXT >
;;
(begin-tx "DPTF-G10b — the dispo fixture left no trace")
(namespace "ouronet-ns")
(print "--- [DPTF-G10b · 01 · no leakage] ---")
;;EMMA's balance was driven negative and then CLEARED, which mints OURO. If that committed, the OURO
;;supply would carry 500 units that no mint path accounts for, and every supply assertion downstream
;;would be off by exactly that -- with nothing pointing back here.
(map print
    [
        (expect "<<DPTF-G10b>> the treasury is back in credit at zero"
            0.0 (DPTF.UR_AccountSupply (DALOS.UR_OuroborosID) (at 0 (DALOS.UR_DemiurgoiID))))
        (expect "<<DPTF-G10b>> ...and EMMA's OURO is non-negative again"
            true (>= (DPTF.UR_AccountSupply (DALOS.UR_OuroborosID) KST.EMMA) 0.0))
        (expect "<<DPTF-G10b>> ...and ANHD's OURO is whole, so the mint from the clear was rolled back"
            true (> (DPTF.UR_AccountSupply (DALOS.UR_OuroborosID) KST.ANHD) 1000000.0))
    ]
)
(commit-tx)

;;|| NEXT >
;;
(begin-tx "DPTF-G10c — a foreign dispo clear needs the SUBJECT's signature, not just the executor's")
(env-gasmodel "table")(env-gaslimit 100000000)(env-gas 0)
(namespace "ouronet-ns")
;;THE SECURITY FIX OF THE PATRON/EXECUTOR CANON SWEEP, pinned in both directions.
;;
;;Clearing a dispo is not a favour. It force-converts the subject's Elite-Auryn at 2.5x the debt
;;(C_ClearDispo's `total-ea`) and burns it. Before the sweep, DPTF|C>CLEAR-DISPO enforced ownership
;;of NEITHER party -- it checked only that the target was standard and in debt -- so ANY caller
;;could liquidate ANY qualifying account's Elite-Auryn. DPTF-G10 above had in fact been driving
;;exactly that call since it was written (`DPTF|C_ClearDispo KST.ANHD KST.EMMA`, one signature,
;;two accounts) and reported a PASS, because the only thing that refused was EMMA's empty balance.
;;A balance is not a gate: fund the victim and the attack works.
;;
;;The core now takes patron/executor/executee and Talos exposes two doors:
;;    DPTF|C_ClearDispo        (patron executor)           self  -- one ownership
;;    DPTF|C_ClearDispoForeign (patron executor executee)   foreign -- BOTH ownerships
;;The foreign door grants no authority the self door does not (anyone able to sign for the
;;executee could simply BE the executor); what it adds is an audit trail naming who executed.
;;
;;Both directions are asserted, which is the part that matters. "ANHD is refused" alone would also
;;pass if the operation were broken for everyone -- so the same call, with EMMA's signature added,
;;is driven past the gate and onto the cost floor underneath it.
;;==== DPTF-G10c · 01 · env-sigs (caps) ==== =====================================================
(print "--- [DPTF-G10c · 01 · env-sigs (caps)] ---")
;;ANHD alone. He is the patron AND the executor; EMMA is the subject and has signed nothing.
(env-sigs [{ "key": "PK_AncientHodler", "caps": [] }])
;;==== DPTF-G10c · 02 · let / invocation ==== ====================================================
(print "--- [DPTF-G10c · 02 · let / invocation] ---")
(let
    (
        (ref-DALOS:module{OuronetDalosV2} DALOS)
        (ref-DPTF:module{DemiourgosPactTrueFungibleV2} DPTF)
        (ref-TS01-C1:module{TalosStageOne_ClientOneV2} TS01-C1)
    )
    (let
        (
            (ouro:string (ref-DALOS::UR_OuroborosID))
        )
        ;;Put EMMA in debt so the business guards are SATISFIED -- the refusal below must be the
        ;;ownership gate and nothing else. Same fabricate-and-roll-back discipline as DPTF-G10.
        (env-module-admin DALOS)
        (update ref-DALOS::DALOS|AccountTable KST.EMMA
            { "ouroboros" :
                (+ { "balance" : -500.0 } (ref-DALOS::UR_TrueFungible KST.EMMA true)) })
        (map print
            [
                (expect "<<DPTF-G10c>> EMMA is STANDARD and in debt -- both business guards pass"
                    [false -500.0]
                    [(ref-DALOS::UR_AccountType KST.EMMA)
                     (ref-DPTF::UR_AccountSupply ouro KST.EMMA)])
                ;;THE ATTACK. Nothing about EMMA refuses this except her signature.
                (expect-failure "<<DPTF-G10c>> ANHD cannot clear EMMA's dispo: her ownership is enforced"
                    "Keyset failure"
                    (ref-TS01-C1::DPTF|C_ClearDispoForeign KST.ANHD KST.ANHD KST.EMMA))
                ;;...and the SELF door is no way around it either: the executor is the subject there,
                ;;so an unsigned subject is refused by the very same gate.
                (expect-failure "<<DPTF-G10c>> ...and the self door refuses him too, for the same reason"
                    "Keyset failure"
                    (ref-TS01-C1::DPTF|C_ClearDispo KST.ANHD KST.EMMA))
            ]
        )
    )
    ""
)
;;NOW ADD EMMA'S SIGNATURE and nothing else. If the refusals above were caused by anything other
;;than the missing signature, this call refuses identically and the pair proves nothing.
(env-sigs [{ "key": "PK_AncientHodler", "caps": [] }, { "key": "PK_Emma", "caps": [] }])
;;==== DPTF-G10c · 03 · the same call, with the subject's signature ==== ==========================
(print "--- [DPTF-G10c · 03 · the same call, with the subject's signature] ---")
(let
    (
        (ref-TS01-C1:module{TalosStageOne_ClientOneV2} TS01-C1)
    )
    (map print
        [
            ;;It gets PAST ownership and dies on the EliteAuryn cost floor instead -- a different
            ;;message from a deeper layer, which is what shows the gate was the only thing in the way.
            (expect-failure "<<DPTF-G10c>> ...with EMMA signing, the gate opens and the COST refuses instead"
                "Cannot Debit DPTF"
                (ref-TS01-C1::DPTF|C_ClearDispoForeign KST.ANHD KST.ANHD KST.EMMA))
        ]
    )
    ""
)
(env-sigs [])
;;this tx fabricated debt on EMMA
(rollback-tx)

;;|| NEXT >
;;
(begin-tx "DPTF-G11 — the multi-transfer list parity check")
(env-gasmodel "table")(env-gaslimit 100000000)(env-gas 0)
(namespace "ouronet-ns")
;;==== DPTF-G11 — the multi-transfer list parity check · 01 · env-sigs (caps) ==== ================
(print "--- [DPTF-G11 — the multi-transfer list parity check · 01 · env-sigs (caps)] ---")
(env-sigs [{ "key": "PK_AncientHodler", "caps": [] }])
(print "--- [DPTF-G11 · 01 · one amount per token, and the tokens must be distinct] ---")
;;`DPTF|C>MULTI-TRANSFER` (09_TFT.pact:432) takes parallel token and amount lists and requires them to
;;agree in length -- otherwise tokens would move amounts the caller never named for them.
;;
;;It sits behind `UEV_IzUnique id-lst`, which is the interesting ordering detail: the uniqueness check
;;comes FIRST, so a duplicated token id answers with its own message and never reaches the parity test.
;;Both are driven, because one message would otherwise stand in for two different mistakes.
;;
;;Neither needs the tokens to exist: both checks are list-shape and run ahead of every id lookup. That is
;;why this test can name MOCKA/MOCKB without caring whether this chain has issued them.
;;==== DPTF-G11 — the multi-transfer list parity check · 02 · let / invocation ==== ===============
(print "--- [DPTF-G11 — the multi-transfer list parity check · 02 · let / invocation] ---")
(let
    (
        (ref-TS01-C1:module{TalosStageOne_ClientOneV2} TS01-C1)
        (a:string "MOCKA-98c486052a51")
        (b:string "MOCKB-98c486052a51")
    )
    (map print
        [
            (expect-failure "<<DPTF-G11>> two tokens against one amount is refused"
                "Invalid Multi Transfer Lists"
                (ref-TS01-C1::DPTF|C_MultiTransfer KST.ANHD KST.ANHD KST.EMMA [a b] [1.0] false))
            (expect-failure "<<DPTF-G11>> ...and so is one token against two amounts"
                "Invalid Multi Transfer Lists"
                (ref-TS01-C1::DPTF|C_MultiTransfer KST.ANHD KST.ANHD KST.EMMA [a] [1.0 2.0] false))
            ;;...and a DUPLICATE id is caught earlier, by the uniqueness check, even though the lists
            ;;are the same length. This is what shows the parity guard is not doing the uniqueness work.
            (expect-failure "<<DPTF-G11>> ...while a duplicated token is caught by uniqueness first"
                "Unique"
                (ref-TS01-C1::DPTF|C_MultiTransfer KST.ANHD KST.ANHD KST.EMMA [a a] [1.0 2.0] false))
        ]
    )
    ""
)
(env-sigs [])
(commit-tx)

;;|| NEXT >
;;|| DPTF-G12 — the supply-underflow backstop, driven; and its arithmetically-dead twin.
;;
(begin-tx "DPTF-G12 - XBv_UpdateSupply: supply cannot go negative")
(env-gasmodel "table")(env-gaslimit 100000000)(env-gas 0)
(namespace "ouronet-ns")
;;==== DPTF-G12 - XBv_UpdateSupply: supply cannot go negative · 01 · env-sigs (caps) ==== =========
(print "--- [DPTF-G12 - XBv_UpdateSupply: supply cannot go negative · 01 · env-sigs (caps)] ---")
(env-sigs [{ "key": "PK_AncientHodler", "caps": [] }])
(print "--- [DPTF-G12 · 01 · the DEBIT branch, on a broken invariant] ---")
;;`05_DPTF.pact:2328`. `XBv_UpdateSupply` carries the SAME message on both branches:
;;    direction TRUE   (enforce (>= (+ s amount) 0.0) "DPTF Token Supply cannot be updated ...")
;;    direction FALSE  (enforce (>= (- s amount) 0.0) "DPTF Token Supply cannot be updated ...")
;;and only one of them can ever fire. `UEV_Amount` runs FIRST and enforces `amount > 0.0`, and a
;;supply is never negative -- so on the CREDIT branch `(+ s amount)` is a positive added to a
;;non-negative and cannot be < 0. That site is annotated `;;UNREACHABLE` with this arithmetic.
;;
;;THE DEBIT BRANCH IS A REAL BACKSTOP, and it guards an INVARIANT rather than an argument: no account
;;may hold more than the token's total supply. Every credit path maintains that, so no ordinary
;;sequence reaches it. Per the rule this campaign settled on (2026-09-11-HANDOFF, item 2): when a
;;guard is unreachable because an INVARIANT holds, drive the invariant false and EXECUTE it --
;;annotate only when no state could ever reach it. So the balance is forced above the supply and the
;;burn is attempted, which is precisely the corruption this enforce exists to stop.
;;==== DPTF-G12 - XBv_UpdateSupply: supply cannot go negative · 02 · let / invocation ==== ========
(print "--- [DPTF-G12 - XBv_UpdateSupply: supply cannot go negative · 02 · let / invocation] ---")
(let
    (
        (ref-DPTF:module{DemiourgosPactTrueFungibleV2} DPTF)
        (ref-TS01-C1:module{TalosStageOne_ClientOneV2} TS01-C1)
        (a:string "MOCKA-98c486052a51")
    )
    (map print
        [
            ;;the premise the invariant normally holds: the holder has no more than exists
            (expect "<<DPTF-G12>> ANHD's balance does not exceed the total supply"
                true (<= (ref-DPTF::UR_AccountSupply a KST.ANHD) (ref-DPTF::UR_Supply a)))
        ]
    )
    ;;break it -- give the holder more than exists. Nothing in DPTF writes this combination; it is
    ;;what a partial or mis-ordered credit would leave behind.
    (env-module-admin DPTF)
    (update DPTF.DPTF|BalanceTable (ref-DPTF::UC_IdAccount a KST.ANHD)
        { "balance" : (+ (ref-DPTF::UR_Supply a) 1000.0) })
    (map print
        [
            (expect "<<DPTF-G12>> the invariant is now broken -- the holder has more than exists"
                true (> (ref-DPTF::UR_AccountSupply a KST.ANHD) (ref-DPTF::UR_Supply a)))
            ;;THE ITEM. The account-side debit succeeds (the holder really does "have" it), so the
            ;;only thing standing between a corrupted balance and a NEGATIVE token supply is this
            ;;enforce. That is what makes it worth executing rather than annotating away.
            (expect-failure "<<DPTF-G12>> burning more than exists is stopped by the supply backstop"
                "DPTF Token Supply cannot be updated to negative values!"
                (ref-TS01-C1::DPTF|C_Burn KST.ANHD KST.ANHD a (+ (ref-DPTF::UR_Supply a) 500.0)))
            ;;...and a burn WITHIN the real supply still works, so the backstop is a bound and not a
            ;;blanket refusal introduced by the forced state.
            (expect "<<DPTF-G12>> ...while a burn within the real supply still succeeds"
                true (!= "" (format "{}" [(ref-TS01-C1::DPTF|C_Burn KST.ANHD KST.ANHD a 1.0)])))
        ]
    )
    ""
)
(env-sigs [])
;;the forced balance is discarded -- DPTF-G12b checks it
(rollback-tx)

;;|| NEXT >
;;|| DPTF-G12b — the forced balance left no trace.
;;
(begin-tx "DPTF-G12b - no leakage")
(namespace "ouronet-ns")
(print "--- [DPTF-G12b · 01 · no leakage] ---")
;;A leaked over-balance would let a later test burn or transfer tokens that do not exist, and would
;;surface as an arithmetic mismatch somewhere unrelated.
(print
    (expect "<<DPTF-G12b>> ANHD's balance is back within the total supply"
        true (<= (DPTF.UR_AccountSupply "MOCKA-98c486052a51" KST.ANHD)
                 (DPTF.UR_Supply "MOCKA-98c486052a51"))))
(commit-tx)

;;|| NEXT >
;;
(begin-tx "DPTF-I1 — C_ToggleFeeExemptionRole's FIRST successful execution, and its INFO_ preview")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(namespace "ouronet-ns")
(print "--- [DPTF-I1 · 01 · the other op that had never once succeeded] ---")
;;OWNER RULING: "If an op exec counterpart is missing it has to be added, it means we missed it."
;;
;;`DPTF|C_ToggleFeeExemptionRole` had NEVER executed successfully anywhere in this repo. Every site
;;was a refusal: <<DPTF-06>> above (standard account), `_scratch_dptf_h4_missing_imc.repl` (IMC gate),
;;and two COMMENTED-OUT lines in `[4.0]_Sovereign-Executor.repl`. So the success path, and
;;`INFO_DPTF|ToggleFeeExemptionRole`'s quote, were both unverified.
;;
;;WHY IT WAS NEVER BUILT. The defcap's two account guards look contradictory, and that is the trap:
;;    (ref-DALOS::UEV_NotSmartOuronetAccount account)      ;;05_DPTF.pact:819
;;    (ref-DALOS::UEV_EnforceAccountType account true)     ;;05_DPTF.pact:820
;;Read casually, line 819 says "not smart" and line 820 says "must be smart". They are different
;;predicates. `UEV_NotSmartOuronetAccount` rejects the EIGHT hard-coded PROTOCOL smart-contract
;;accounts (DALOS, ATS, VST, LIQUID, OUROBOROS, SWP, DHV2, AQP — `01_DALOS.pact:1111`), while
;;`UEV_EnforceAccountType … true` demands a Σ-prefixed account flagged smart. The intersection is
;;exactly one class: a USER-DEPLOYED smart DALOS account.
;;
;;Both earlier attempts picked from outside that class and neither author noticed the set was
;;non-empty:
;;  - <<DPTF-06>> passes `emma`, a standard Ѻ. account -> dies on line 820. Pinned as a refusal.
;;  - `[4.0]:1587/1591` pass the SWP contract -> would die on line 819 instead. Commented out.
;;  - `_scratch_dptf_h4` says outright that "no such fixture was readily available in this harness's
;;    boot chain" and routes around it.
;;The fixture DID exist the whole time: `KC.BJ`, deployed at `[2.1]_Dalos.repl:192` as a "Banana
;;Example" and therefore easy to miss. It is smart, and it is not one of the eight protocol accounts.
;;THE LESSON: when a guard pair reads as a contradiction, it usually is not — it is an intersection,
;;and the honest move is to work out which class satisfies both rather than conclude "unreachable".
;;Three separate attempts concluded unreachable; the class had one member sitting in the boot chain.
(env-sigs [{ "key": "PK_AncientHodler", "caps": [] }])
(let
    (
        (ref-TS01-C1:module{TalosStageOne_ClientOneV2} TS01-C1)
        (ref-DPTF:module{DemiourgosPactTrueFungibleV2} DPTF)
        (ref-DALOS:module{OuronetDalosV2} DALOS)
        (a:string "MOCKA-98c486052a51")
        (patron:string KST.ANHD)
        ;;the one user-deployed smart account in the boot chain
        (smart:string KC.BJ)
    )
    (map print
        [
            ;;the two halves of the intersection, asserted separately so a future reader can see
            ;;WHY this account and not another
            (expect "<<DPTF-I1>> the target is a SMART account (satisfies UEV_EnforceAccountType true)"
                true (ref-DALOS::UR_AccountType smart))
            (expect "<<DPTF-I1>> ...and is NOT one of the eight protocol contracts (satisfies UEV_NotSmartOuronetAccount)"
                false (ref-DALOS::UR_AutonomicRoles smart))
            (expect "<<DPTF-I1>> precondition: it does not already hold the role"
                false (ref-DPTF::UR_AccountRoleFeeExemption a smart))
        ]
    )
    (let
        (
            ;;FUNCTION COVERAGE (G6) — `INFO_DPTF|ToggleFeeExemptionRole`, per the owner's spec.
            (predicted:object{OuronetInfoV2.ClientInfo}
                (INFO-ONE.INFO_DPTF|ToggleFeeExemptionRole patron a smart true))
            (ignis-before:decimal (ref-DALOS::UR_TF_AccountSupply patron false))
            (msg:string (ref-TS01-C1::DPTF|C_ToggleFeeExemptionRole patron (DPTF.UR_Konto a) smart a true))
        )
        (map print
            [
                (format "<(DPTF|C_ToggleFeeExemptionRole)> => \"{}\"" [msg])
                ;;1] it actually ran
                (expect "<<DPTF-I1>> the fee-exemption role is now GRANTED — the op's first success"
                    true (ref-DPTF::UR_AccountRoleFeeExemption a smart))
                ;;2] the quote the client was shown is the price they paid
                (expect "<<DPTF-I1>> INFO_DPTF|ToggleFeeExemptionRole's quote equals what it charged"
                    (- ignis-before (ref-DALOS::UR_TF_AccountSupply patron false))
                    (at "ignis-need" (at "ignis" predicted)))
                (expect "<<DPTF-I1>> ...and it is a real, non-zero charge"
                    true (> (- ignis-before (ref-DALOS::UR_TF_AccountSupply patron false)) 0.0))
            ]
        )
    )
    ;;3] and it is reversible — the revoke arm of the same toggle, which no test had reached either
    (ref-TS01-C1::DPTF|C_ToggleFeeExemptionRole patron (DPTF.UR_Konto a) smart a false)
    (map print
        [
            (expect "<<DPTF-I1>> ...and the role can be revoked again"
                false (ref-DPTF::UR_AccountRoleFeeExemption a smart))
        ]
    )
    ""
)
(env-sigs [])
;;discarded — MOCKA's role table is left exactly as the suite had it
(rollback-tx)

;;|| NEXT >
;;
(begin-tx "DPTF-I2 — INFO_DPTF|UpgradeBranding, the family's only unconditional STOA charge")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(namespace "ouronet-ns")
(print "--- [DPTF-I2 · 01 · a two-currency quote, measured in both currencies] ---")
;;FUNCTION COVERAGE (G6) — `INFO_DPTF|UpgradeBranding`, per the owner's spec. Template:
;;`modules/ATS.repl <<ATS-I1>>`.
;;
;;WHY THIS OP SPECIFICALLY. It is the only one in the whole DPTF/DPOF family whose STOA collect is
;;UNCONDITIONAL: `05_DPTF.pact:2854` calls `XB_CollectStoaWithTrigger patron (URCi_UpgradeBranding months)
;;false` — the trigger is the hardcoded literal `false`, not `(URC_IsNativeGasZero)` as in
;;`C_Issue` and `C_ToggleFeeLock`. So this charge cannot be switched off by protocol state, which
;;makes it the one place a wrong STOA quote would reach every client unconditionally.
;;
;;Both currencies are checked. Checking only IGNIS is what let `INFO_EQUITY|IssueCompany` quote a
;;918-STOA operation as free: half the quote was right, and the half that was tested was the right
;;half. `ClientInfo` carries an `ignis` AND a `stoa` leg; an op can be exact in one and silently
;;wrong in the other.
(let
    (
        (ref-DALOS:module{OuronetDalosV2} DALOS)
    )
    ;;The STOA fee is a real coin.transfer split 10/20/30/40 across the four fee targets, so it needs
    ;;a managed coin.TRANSFER per leg. Sized from the same split the collector uses, never hardcoded.
    ;;NOTE the `months` here (1) must match the exec below: the price is per-month, so a mismatch
    ;;would under-size the caps and die inside coin.pact rather than in this file.
    (let ((split-stoa:[decimal]
              (ref-DALOS::URC_SplitSTOAPrices KST.ANHD (ref-DALOS::UR_UsagePrice "blue"))))
        (env-sigs
            [ { "key": "PK_AncientHodler", "caps": [] }
              { "key": "6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263"
              , "caps":
                [ (coin.TRANSFER "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263"
                      "k:50d6c59b21e5e6e55baecaa75a1007de37576bde12d8230dc82459cc01b9484b" (at 2 split-stoa))
                  (coin.TRANSFER "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263"
                      "k:0cb30c0121ff919266121a99ff9359871818932211df94dae4137c29bc0e8f7e" (at 0 split-stoa))
                  (coin.TRANSFER "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263"
                      "c:XM-pkmuB5XUQlp87ZYSbfKt8qzmHY6O2EHAzMRVBt3k" (at 3 split-stoa))
                  (coin.TRANSFER "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263"
                      "c:iQQFWj6gWtpGEzhM_O5ekW1QtnQQy55R8BRPGhj_0FU" (at 1 split-stoa)) ] } ]
        )
    )
)
(let
    (
        (ref-TS01-C1:module{TalosStageOne_ClientOneV2} TS01-C1)
        (ref-DALOS:module{OuronetDalosV2} DALOS)
        (a:string "MOCKA-98c486052a51")
        (patron:string KST.ANHD)
        (months:integer 1)
    )
    (let
        (
            (predicted:object{OuronetInfoV2.ClientInfo}
                (INFO-ONE.INFO_DPTF|UpgradeBranding patron a months))
            (stoa-acct:string (ref-DALOS::UR_AccountStoa patron))
        )
        (let
            (
                (stoa-before:decimal (coin.get-balance stoa-acct))
                (ignis-before:decimal (ref-DALOS::UR_TF_AccountSupply patron false))
                (msg:string (ref-TS01-C1::DPTF|C_UpgradeBranding patron (DPTF.UR_Konto (DPTF.URCv_Parent a)) a months))
            )
            (map print
                [
                    (format "<<DPTF-I2>> IGNIS predicted={} real={} | STOA predicted={} real={}"
                        [(at "ignis-need" (at "ignis" predicted))
                         (- ignis-before (ref-DALOS::UR_TF_AccountSupply patron false))
                         (at "stoa-need" (at "stoa" predicted))
                         (- stoa-before (coin.get-balance stoa-acct))])
                    (expect "<<DPTF-I2>> the STOA quote equals the STOA the upgrade charged"
                        (- stoa-before (coin.get-balance stoa-acct))
                        (at "stoa-need" (at "stoa" predicted)))
                    (expect "<<DPTF-I2>> ...and branding is NOT free in STOA"
                        true (> (- stoa-before (coin.get-balance stoa-acct)) 0.0))
                    (expect "<<DPTF-I2>> the IGNIS quote equals the IGNIS it charged"
                        (- ignis-before (ref-DALOS::UR_TF_AccountSupply patron false))
                        (at "ignis-need" (at "ignis" predicted)))
                ]
            )
        )
    )
    ""
)
(env-sigs [])
(rollback-tx)

