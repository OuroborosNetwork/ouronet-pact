(begin-tx "DPTF-03 — C_Transfer moves balance, conserving supply")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(namespace "ouronet-ns")
(print "--- [DPTF-03 · 01 · transfer] ---")
(env-sigs [{ "key": "PK_AncientHodler", "caps": [] }])
(let
    (
        (ref-DPTF:module{DemiourgosPactTrueFungibleV2} DPTF)
        (ref-TS01-C1:module{TalosStageOne_ClientOneV2} TS01-C1)
        (a:string "MOCKA-98c486052a51")
        (patron:string KST.ANHD)
        (emma:string KST.EMMA)
    )
    (let
        (
            (s0:decimal (ref-DPTF::UR_Supply a))
            (p0:decimal (ref-DPTF::UR_AccountSupply a patron))
            (e0:decimal (try 0.0 (ref-DPTF::UR_AccountSupply a emma)))
        )
        (ref-TS01-C1::DPTF|C_Transfer patron a patron emma 100.0 false)
        (map print
            [
                (expect "<<DPTF-03>> C_Transfer debited the sender by exactly the amount"
                    (- p0 100.0) (ref-DPTF::UR_AccountSupply a patron))
                (expect "<<DPTF-03>> C_Transfer credited the receiver by exactly the amount"
                    (+ e0 100.0) (ref-DPTF::UR_AccountSupply a emma))
                (expect "<<DPTF-03>> INVARIANT: transfer conserves total supply"
                    s0 (ref-DPTF::UR_Supply a))
            ]
        )
    )
    ""
)
(commit-tx)

