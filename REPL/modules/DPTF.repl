(env-gasmodel "table")(env-gaslimit 100000000)(env-gas 0)
(namespace "ouronet-ns")
(print "--- [DPTF-I5 · 01 · a plain transfer] ---")
;;FUNCTION COVERAGE (G6) — `INFO_DPTF|Transfer`, per the owner's spec: an INFO_ must report the same cost
;;the op actually charges. Template and rationale: `modules/ATS.repl <<ATS-I1>>`.
;;NOTE the arity difference: the preview takes 5 arguments and the exec 6 — the exec's trailing
;;`method:bool` has no bearing on price, so the preview omits it. Anything pairing previews to ops by
;;signature shape will mis-flag this one.
(env-sigs [{ "key": "PK_AncientHodler", "caps": [] }])
(let
    (
        (ref-TS01-C1:module{TalosStageOne_ClientOneV2} TS01-C1)
        (ref-DPTF:module{DemiourgosPactTrueFungibleV2} DPTF)
        (ref-DALOS:module{OuronetDalosV2} DALOS)
        (a:string "MOCKA-98c486052a51")
        (patron:string KST.ANHD)
        (lumy:string KST.LUMY)
        (emma:string KST.EMMA)
    )
    (let
        (
            (predicted:object{OuronetInfoV2.ClientInfo} (INFO-ONE.INFO_DPTF|Transfer patron a patron lumy 10.0))
            (ignis-before:decimal (ref-DALOS::UR_TF_AccountSupply patron false))
            (m (ref-TS01-C1::DPTF|C_Transfer patron patron lumy a 10.0 false))
        )
        (map print
            [
                (expect "<<DPTF-I5>> INFO_DPTF|Transfer's quote equals what the op actually charged"
                    (- ignis-before (ref-DALOS::UR_TF_AccountSupply patron false))
                    (at "ignis-need" (at "ignis" predicted)))
                (expect "<<DPTF-I5>> ...and it is a real, non-zero charge"
                    true (> (- ignis-before (ref-DALOS::UR_TF_AccountSupply patron false)) 0.0))
                ;;the amount really moved — MOCKA's min-move is 7.0 and its fee toggle is off,
                ;;so 10.0 arrives whole and no fee leg can blur the measurement
                (expect "<<DPTF-I5>> ...and the receiver really got the tokens"
                    true (> (ref-DPTF::UR_AccountSupply a lumy) 0.0))
            ]
        )
    )
    ""
)
(env-sigs [])
(rollback-tx)

