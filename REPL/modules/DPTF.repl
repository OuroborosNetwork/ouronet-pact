(begin-tx "DPTF-07 — C_Control flips properties; C_RotateOwnership moves the konto")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(namespace "ouronet-ns")
(print "--- [DPTF-07 · 01 · control + ownership] ---")
;;==== DPTF-07 — C_Control flips properties; C_RotateOwnership moves the konto · 01 · env-sigs (caps) ==== 
(print "--- [DPTF-07 — C_Control flips properties; C_RotateOwnership moves the konto · 01 · env-sigs (caps)] ---")
(env-sigs [{ "key": "PK_AncientHodler", "caps": [] }, { "key": "PK_Emma", "caps": [] }])
;;==== DPTF-07 — C_Control flips properties; C_RotateOwnership moves the konto · 02 · let / invocation ==== 
(print "--- [DPTF-07 — C_Control flips properties; C_RotateOwnership moves the konto · 02 · let / invocation] ---")
(let
    (
        (ref-DPTF:module{DemiourgosPactTrueFungibleV2} DPTF)
        (ref-TS01-C1:module{TalosStageOne_ClientOneV2} TS01-C1)
        (b:string "MOCKB-98c486052a51")
        (patron:string KST.ANHD)
        (emma:string KST.EMMA)
    )
    ;;C_Control (cu cco casr cf cw cp) — turn can-pause OFF on MOCKB, leave the rest as issued
    (ref-TS01-C1::DPTF|C_Control patron (DPTF.UR_Konto b) b true true true false false false)
    (map print
        [
            (expect "<<DPTF-07>> C_Control turned can-pause OFF"   false (ref-DPTF::UR_CanPause b))
            (expect "<<DPTF-07>> C_Control left can-upgrade ON"    true  (ref-DPTF::UR_CanUpgrade b))
            (expect "<<DPTF-07>> C_Control left can-change-owner ON" true (ref-DPTF::UR_CanChangeOwner b))
        ]
    )
    ;;--- adversarial window: put MOCKB into two guard-tripping states, assert, then restore.
    ;;DPTF|S>CONTROL and DPTF|S>TOGGLE_RESERVATION both gate on owner + can-upgrade only, so
    ;;these flips are REVERSIBLE -- which is what makes them usable here. UEV_CanAddSpecialRoleON
    ;;and UEV_ReservationState's <state>=false arm have no other live input anywhere in the
    ;;suite: every token is issued with special roles allowed and reservations closed.
    (ref-TS01-C1::DPTF|C_Control patron (DPTF.UR_Konto b) b true true false false false false)
    (map print
        [
            (expect "<<DPTF-07>> can-add-special-role is now OFF on MOCKB"
                false (ref-DPTF::UR_CanAddSpecialRole b))
            (expect-failure "<<DPTF-07>> UEV_CanAddSpecialRoleON rejects a token that forbids them"
                "no special roles can be added" (ref-DPTF::UEV_CanAddSpecialRoleON b))
        ]
    )
    (ref-TS01-C1::DPTF|C_ToggleReservation patron (DPTF.UR_Konto b) b true)
    (map print
        [
            (expect "<<DPTF-07>> reservations are now OPEN on MOCKB"
                true (ref-DPTF::UR_IzReservationOpen b))
            ;;The <state>=false arm: it fires when reservations ARE open, and must SAY so. This is
            ;;the arm that was inverted before 2026-09-10 -- it used to report "already closed".
            (expect-failure "<<DPTF-07>> UEV_ReservationState names the OPEN state that tripped it"
                "is already open for reservations" (ref-DPTF::UEV_ReservationState b false))
        ]
    )
    ;;RESTORE, so DPTF-G1 further down still sees the state it asserts.
    (ref-TS01-C1::DPTF|C_ToggleReservation patron (DPTF.UR_Konto b) b false)
    (ref-TS01-C1::DPTF|C_Control patron (DPTF.UR_Konto b) b true true true false false false)
    (map print
        [
            (expect "<<DPTF-07>> reservations restored to CLOSED" false (ref-DPTF::UR_IzReservationOpen b))
            (expect "<<DPTF-07>> can-add-special-role restored to ON" true (ref-DPTF::UR_CanAddSpecialRole b))
        ]
    )
    ;;NOTE: the smart-account requirement belongs to the FEE-EXEMPTION role (DPTF-06), NOT to
    ;;ownership rotation -- rotation to a standard account is legitimate. An earlier draft of
    ;;this file asserted the opposite and the suite corrected it.
    (ref-TS01-C1::DPTF|C_RotateOwnership patron (DPTF.UR_Konto b) emma b)
    (map print
        [
            (expect "<<DPTF-07>> C_RotateOwnership moved the konto to the new owner"
                emma (ref-DPTF::UR_Konto b))
        ]
    )
    ""
)
(commit-tx)

