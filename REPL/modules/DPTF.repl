(begin-tx "DPTF-G2 — the special-link existence family, as 2x2s on their own boolean argument")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
;;==== DPTF-G2 — the special-link existence family, as 2x2s on their own boolean argument · 01 · namespace ==== 
(print "--- [DPTF-G2 — the special-link existence family, as 2x2s on their own boolean argument · 01 · namespace] ---")
(namespace "ouronet-ns")
(print "--- [DPTF-G2 · 01 · vesting / sleeping / hibernation / frozen / reserved] ---")
;;P3.3. Five guards with one shape: (enforce (= has-X existance) ...). Each takes the EXPECTED
;;answer as an argument, so one token gives both cells -- the live value must be accepted and its
;;negation refused. Testing a single cell would pass against a guard that ignores its argument
;;entirely, which is exactly what this parameter shape invites (same reasoning as ATS-G1).
;;
;;Every expectation is DERIVED from the live token, never a constant: these five links are set by
;;VST operations that this tester does not run, so hardcoding "false" would silently stop testing
;;the rule the day a fixture gains a vesting or sleeping link.
;;
;;The messages share the tail "is not satisfied with existance" with DPOF and DPMF, so each
;;expectation is anchored on its own leading noun and the calls go through ref-DPTF:: -- the
;;module reference is what makes the attribution exact (see _enforce_coverage.py --ambiguous).
;;==== DPTF-G2 — the special-link existence family, as 2x2s on their own boolean argument · 02 · let / invocation ==== 
(print "--- [DPTF-G2 — the special-link existence family, as 2x2s on their own boolean argument · 02 · let / invocation] ---")
(let
    (
        (ref-DPTF:module{DemiourgosPactTrueFungibleV2} DPTF)
        (a:string "MOCKA-98c486052a51")
    )
    (let
        (
            (ves:bool (ref-DPTF::URC_HasVesting a))
            (slp:bool (ref-DPTF::URC_HasSleeping a))
            (hib:bool (ref-DPTF::URC_HasHibernation a))
            (frz:bool (ref-DPTF::URC_HasFrozen a))
            (rsv:bool (ref-DPTF::URC_HasReserved a))
        )
        (map print
            [
                ;;--- the accepting cell: the guard agrees with the live value
                (expect "<<DPTF-G2>> all five guards accept the token's LIVE link state"
                    true (!= "" (format "{}{}{}{}{}"
                        [(ref-DPTF::UEV_Vesting a ves)     (ref-DPTF::UEV_Sleeping a slp)
                         (ref-DPTF::UEV_Hibernation a hib) (ref-DPTF::UEV_Frozen a frz)
                         (ref-DPTF::UEV_Reserved a rsv)])))
                ;;--- the rejecting cell: one per guard, each on the negation of its own flag
                (expect-failure "<<DPTF-G2>> UEV_Vesting rejects the state the token is NOT in"
                    "Vesting for the Token" (ref-DPTF::UEV_Vesting a (not ves)))
                (expect-failure "<<DPTF-G2>> UEV_Sleeping rejects the state the token is NOT in"
                    "Sleeping for the Token" (ref-DPTF::UEV_Sleeping a (not slp)))
                (expect-failure "<<DPTF-G2>> UEV_Hibernation rejects the state the token is NOT in"
                    "Hibernation for the Token" (ref-DPTF::UEV_Hibernation a (not hib)))
                (expect-failure "<<DPTF-G2>> UEV_Frozen rejects the state the token is NOT in"
                    "Frozen for the Token" (ref-DPTF::UEV_Frozen a (not frz)))
                (expect-failure "<<DPTF-G2>> UEV_Reserved rejects the state the token is NOT in"
                    "Reserved for the Token" (ref-DPTF::UEV_Reserved a (not rsv)))
            ]
        )
        ""
    )
)
(commit-tx)

