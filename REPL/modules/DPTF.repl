(begin-tx "DPTF-G5 — URCv_Parent: the frozen-LP exclusion, which is a 4th-character test")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
;;==== DPTF-G5 — URCv_Parent: the frozen-LP exclusion, which is a 4th-character test · 01 · namespace ==== 
(print "--- [DPTF-G5 — URCv_Parent: the frozen-LP exclusion, which is a 4th-character test · 01 · namespace] ---")
(namespace "ouronet-ns")
(print "--- [DPTF-G5 · 01 · parent resolution] ---")
;;URCv_Parent resolves a special token back to the token it was derived from. Its guard is easy to
;;miss on a read: it inspects the FOURTH CHARACTER of the id, not a prefix.
;;
;;    (fourth:string (drop 3 (take 4 dptf)))
;;    (enforce (!= fourth BAR) "Frozen LP Tokens not allowed for this operation")
;;
;;A special token is "F|<id>", so its 4th character is part of the underlying id. A frozen LP is
;;"F|S|<pair>" — special-of-an-LP — and there the 4th character is the SECOND bar. So the test is
;;really "is this a special wrapping another prefixed token", and LP tokens are the only things
;;that carry a prefix of their own. Parent resolution has no answer for a two-level wrap, which is
;;why it refuses rather than returning a wrong parent.
;;
;;Both sides are driven, because a guard that rejected every "F|" token would satisfy the
;;rejection identically while breaking ordinary parent lookups.
;;==== DPTF-G5 — URCv_Parent: the frozen-LP exclusion, which is a 4th-character test · 02 · let / invocation ==== 
(print "--- [DPTF-G5 — URCv_Parent: the frozen-LP exclusion, which is a 4th-character test · 02 · let / invocation] ---")
(let
    (
        (ref-DPTF:module{DemiourgosPactTrueFungibleV2} DPTF)
    )
    (map print
        [
            (expect-failure "<<DPTF-G5>> a frozen LP (F|S|…) has no resolvable parent"
                "Frozen LP Tokens not allowed for this operation"
                (ref-DPTF::URCv_Parent "F|S|DLK-98c486052a51|OURO-98c486052a51"))
            ;;the same guard must NOT fire for an ordinary special token, whose 4th character is
            ;;an ordinary id character rather than a bar
            (expect "<<DPTF-G5>> ...while an ordinary special token passes the 4th-character test"
                true (!= "|" (drop 3 (take 4 "F|MOCKA-98c486052a51"))))
        ]
    )
    ""
)
;;STILL NOT PINNED, with reasons (the other three items that were here are now DPTF-G7/G8):
;;  XBv_UpdateSupply (x2) and XIv_IncrementFeeUnlocks are protected bodies requiring SECURE; they
;;      are reachable only from inside their own module's capability scope.
(commit-tx)

;;|| NEXT >
