(begin-tx "DPTF-06 — C_SetMinMove / C_TogglePause / C_ToggleTransferRole / C_ToggleFeeExemptionRole")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(namespace "ouronet-ns")
(print "--- [DPTF-06 · 01 · properties + roles] ---")
;;==== DPTF-06 — C_SetMinMove / C_TogglePause / C_ToggleTransferRole / C_ToggleFeeExemptionRole · 01 · env-sigs (caps) ==== 
(print "--- [DPTF-06 — C_SetMinMove / C_TogglePause / C_ToggleTransferRole / C_ToggleFeeExemptionRole · 01 · env-sigs (caps)] ---")
(env-sigs [{ "key": "PK_AncientHodler", "caps": [] }])
;;==== DPTF-06 — C_SetMinMove / C_TogglePause / C_ToggleTransferRole / C_ToggleFeeExemptionRole · 02 · let / invocation ==== 
(print "--- [DPTF-06 — C_SetMinMove / C_TogglePause / C_ToggleTransferRole / C_ToggleFeeExemptionRole · 02 · let / invocation] ---")
(let
    (
        (ref-DPTF:module{DemiourgosPactTrueFungibleV2} DPTF)
        (ref-TS01-C1:module{TalosStageOne_ClientOneV2} TS01-C1)
        (a:string "MOCKA-98c486052a51")
        (patron:string KST.ANHD)
        (emma:string KST.EMMA)
    )
    (ref-TS01-C1::DPTF|C_SetMinMove patron (DPTF.UR_Konto a) a 7.0)
    (ref-TS01-C1::DPTF|C_ToggleTransferRole patron (DPTF.UR_Konto a) emma a true)

    (map print
        [
            (expect "<<DPTF-06>> C_SetMinMove stored the minimum move"  7.0  (ref-DPTF::UR_MinMove a))
            ;;GUARD 1 of DPTF|S>SET_MIN-MOVE: the value must fit the token's decimal count.
            ;;MOCKA carries 24, so 25 decimals is one too many -- the same boundary UEV_Amount
            ;;is pinned at in DPTF-G1, asserted here against the MIN-MOVE path instead.
            (expect-failure "<<DPTF-06>> C_SetMinMove rejects one more decimal than the token has"
                "does not conform with the"
                (ref-TS01-C1::DPTF|C_SetMinMove patron (DPTF.UR_Konto a) a 0.0000000000000000000000001))
            ;;GUARD 2: -1.0 (disabled) or strictly positive. 0.0 clears guard 1 -- (floor 0.0 24)
            ;;is 0.0 -- so it reaches guard 2 and is the input that isolates it.
            (expect-failure "<<DPTF-06>> C_SetMinMove rejects a zero minimum move"
                "Min-Move Value does not compute"
                (ref-TS01-C1::DPTF|C_SetMinMove patron (DPTF.UR_Konto a) a 0.0))
            (expect "<<DPTF-06>> ...and the rejected calls left the stored value untouched"
                7.0 (ref-DPTF::UR_MinMove a))
            (expect "<<DPTF-06>> C_ToggleTransferRole granted transfer" true (ref-DPTF::UR_AccountRoleTransfer a emma))
            ;;GATE: the fee-exemption role targets a SMART account only.
            (expect-failure "<<DPTF-06>> C_ToggleFeeExemptionRole on a STANDARD account is rejected"
                "Operation requires a Smart DALOS Account"
                (ref-TS01-C1::DPTF|C_ToggleFeeExemptionRole patron (DPTF.UR_Konto a) emma a true))
            (expect "<<DPTF-06>> token starts unpaused"                 false (ref-DPTF::UR_Paused a))
        ]
    )
    (ref-TS01-C1::DPTF|C_TogglePause patron (DPTF.UR_Konto a) a true)
    (map print
        [
            (expect "<<DPTF-06>> C_TogglePause paused the token" true (ref-DPTF::UR_Paused a))
            ;;The token is PAUSED for exactly these two lines, and this is the ONLY window in the
            ;;suite where UEV_PauseState's <state>=false arm can be tripped -- the guard-family
            ;;block in DPTF-G1 runs after the unpause below, so it can only ever reach the
            ;;<state>=true arm. Both arms are therefore pinned, in the two places each is live.
            ;;Read-only calls, so nothing here disturbs the state the unpause below expects.
            (expect-failure "<<DPTF-06>> UEV_PauseState rejects <state> false while the token IS paused"
                "is paused; transfers are paused" (ref-DPTF::UEV_PauseState a false))
            (expect "<<DPTF-06>> ...and accepts <state> true, which is the live value"
                true (!= "" (format "{}" [(ref-DPTF::UEV_PauseState a true)])))
        ]
    )
    (ref-TS01-C1::DPTF|C_TogglePause patron (DPTF.UR_Konto a) a false)
    (map print [(expect "<<DPTF-06>> C_TogglePause unpaused the token" false (ref-DPTF::UR_Paused a))])
    ""
)
(commit-tx)

;;|| NEXT >
