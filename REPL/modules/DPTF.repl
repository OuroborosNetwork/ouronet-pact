(begin-tx "DPTF-I24 — INFO_DPTF|Issue: both currencies measured")
(env-gasmodel "table")(env-gaslimit 100000000)(env-gas 0)
(namespace "ouronet-ns")
(print "--- [DPTF-I24 · 01 · issue a fresh true fungible] ---")
;;FUNCTION COVERAGE (G6) — `INFO_DPTF|Issue`, per the owner's spec: an INFO_ must report the same cost
;;the op actually charges. Template and rationale: `modules/ATS.repl <<ATS-I1>>`.
;;
;;THIS PREVIEW WAS ALREADY "COVERED" AND HAD NEVER BEEN WEIGHED. It is named by a shape-check or an
;;abort-pin elsewhere in the suite, which satisfies `_scale_report.py --untested` — a tool that asks
;;"was it reached", not "does the quote equal the charge". `REPL/tools/_info_measured.py` separates the two.
;;A FRESH TICKER is mandatory — ids derive from the ticker, so reusing MOCKA collides on insert
;;rather than on price, and that failure would read like a pricing problem.
(env-sigs
    [
        { "key": "PK_AncientHodler", "caps": [] }
        { "key": "6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263" ,
          "caps":
            [
                (coin.TRANSFER "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263" "k:50d6c59b21e5e6e55baecaa75a1007de37576bde12d8230dc82459cc01b9484b" 1000000.0)
                (coin.TRANSFER "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263" "k:0cb30c0121ff919266121a99ff9359871818932211df94dae4137c29bc0e8f7e" 1000000.0)
