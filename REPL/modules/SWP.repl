(begin-tx "SWP-G5 — SWPLC liquidity admission: a disabled mode and an over-large withdrawal")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
;;==== SWP-G5 — SWPLC liquidity admission: a disabled mode and an over-large withdrawal · 01 · namespace ==== 
(print "--- [SWP-G5 — SWPLC liquidity admission: a disabled mode and an over-large withdrawal · 01 · namespace] ---")
(namespace "ouronet-ns")
(print "--- [SWP-G5 · 01 · dormant mode / remove bound] ---")
;;P3.3, first sweep of SWPLC. Two guards whose rejecting input needs no new fixture:
;;
;;  UEV_AddDormantLiquidity  — sleeping-LP must be ENABLED on the pair. Pool2 has it disabled
;;                             (asserted in SWP-G3 and again here), so the guard is live against
;;                             it with a single argument and no setup.
;;  UEV_RemoveLiquidity      — the requested LP amount must not exceed the pool's total LP
;;                             SUPPLY. That bound is a pure comparison against a read, so any
;;                             amount above the supply trips it.
;;
;;The removal bound is derived from the live supply rather than a constant: asking for supply+1
;;is always one past the limit, whatever the pool currently holds, and the accepted case at
;;exactly the supply pins the bound as INCLUSIVE. A hardcoded "huge number" would prove the guard
;;rejects something, but not WHERE it draws the line.
;;==== SWP-G5 — SWPLC liquidity admission: a disabled mode and an over-large withdrawal · 02 · let / invocation ==== 
(print "--- [SWP-G5 — SWPLC liquidity admission: a disabled mode and an over-large withdrawal · 02 · let / invocation] ---")
(let
    (
        (ref-SWP:module{SwapperV4} SWP)
        (ref-DPTF:module{DemiourgosPactTrueFungibleV2} DPTF)
        (ref-SWPLC:module{SwapperLiquidityClientV2} SWPLC)
        (pool:string "S|DLK-98c486052a51|OURO-98c486052a51|DWK-98c486052a51")
    )
    (let
        (
            (supply:decimal (ref-DPTF::UR_Supply (ref-SWP::UR_TokenLP pool)))
        )
        (map print
            [
                ;;--- dormant mode
                (expect "<<SWP-G5>> sleeping-LP is DISABLED on this pool" false (ref-SWP::UR_IzSleepingLP pool))
                (expect-failure "<<SWP-G5>> dormant liquidity is refused while sleeping-LP is off"
                    "Sleeping LP Functionality is not enabled"
                    (ref-SWPLC::UEV_AddDormantLiquidity pool))
                ;;--- removal bound, at and past the live supply
                (expect "<<SWP-G5>> the pool holds LP tokens to remove" true (> supply 0.0))
                (expect "<<SWP-G5>> removing EXACTLY the whole supply is allowed (bound is inclusive)"
                    true (!= "" (format "{}" [(ref-SWPLC::UEV_RemoveLiquidity pool supply)])))
                (expect-failure "<<SWP-G5>> ...and one unit more is refused"
                    "is an invalid LP Amount for removing Liquidity"
                    (ref-SWPLC::UEV_RemoveLiquidity pool (+ supply 1.0)))
            ]
        )
        ""
    )
)
(commit-tx)

