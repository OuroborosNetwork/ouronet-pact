(begin-tx "SWP-G22b -- and the guard rejects it")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
;;==== SWP-G22b -- and the guard rejects it · 01 · namespace ==== =================================
(print "--- [SWP-G22b -- and the guard rejects it · 01 · namespace] ---")
(namespace "ouronet-ns")
(print "--- [SWP-G22b . 01 . the previously unreachable rejection] ---")
;;The pin itself. A real, issued sleeping-LP id now exists on this chain, so the eager read of
;;<parent> succeeds and the enforce is finally reached.
;;==== SWP-G22b -- and the guard rejects it · 02 · let / invocation ==== ==========================
(print "--- [SWP-G22b -- and the guard rejects it · 02 · let / invocation] ---")
(let ((zlp:string (concat ["Z|" (SWP.UR_TokenLP "S|DLK-98c486052a51|OURO-98c486052a51|DWK-98c486052a51")])))
    (map print
        [
            (expect-failure "<<SWP-G22>> a sleeping-LP token is rejected for parent-ownership operations"
                "Sleeping LP Tokens not allowed for this operation"
                (DPOF.UEV_ParentOwnership zlp))
        ]
