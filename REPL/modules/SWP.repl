(begin-tx "SWP-G2 — pool identity, membership and fee-shape validators")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
;;==== SWP-G2 — pool identity, membership and fee-shape validators · 01 · namespace ==== ==========
(print "--- [SWP-G2 — pool identity, membership and fee-shape validators · 01 · namespace] ---")
(namespace "ouronet-ns")
(print "--- [SWP-G2 · 01 · identity, membership, fee shape] ---")
;;P3.3 continued. Four unprotected SWP validators, each tripped on the ONE property it owns.
;;Same pool2 fixture SWP-G1 uses, so nothing new is issued and no state is touched.
;;
;;NOTE on expected-message wording: "does not exist" alone appears in SEVEN modules, so it is
;;anchored here on the SWP-only prefix. _enforce_coverage.py --ambiguous exists to catch exactly
;;that mistake, and it was made once already (a rotate-ownership test credited both AQP-SCORE and
;;AQP-FVT because it matched only the shared tail).
;;==== SWP-G2 — pool identity, membership and fee-shape validators · 02 · let / invocation ==== ===
(print "--- [SWP-G2 — pool identity, membership and fee-shape validators · 02 · let / invocation] ---")
(let
    (
        (ref-SWP:module{SwapperV4} SWP)
        (pool:string "S|DLK-98c486052a51|OURO-98c486052a51|DWK-98c486052a51")
        (outsider:string "NOTATOKEN-98c486052a51")
    )
    (map print
        [
            ;;--- UEV_id. with-default-read, so a missing pair returns the -1 sentinel and the
            ;;guard FIRES rather than dying in the read: not a shadowed guard.
            (expect "<<SWP-G2>> UEV_id accepts the real pool"
                true (!= "" (format "{}" [(ref-SWP::UEV_id pool)])))
            (expect-failure "<<SWP-G2>> UEV_id rejects a pair that was never issued"
                "SWP-Pair NOPOOL does not exist." (ref-SWP::UEV_id "NOPOOL"))
            ;;--- membership, twice over. UCv_ parses the pool STRING; URv_ READS the pool row.
            ;;Two different functions, two different messages, same rule -- pinned separately so
            ;;a change to either is caught. The happy paths come first so the trips below cannot
            ;;be passing for the wrong reason.
            (expect "<<SWP-G2>> UCv_PoolTokenPosition locates a real token in the pool STRING"
                1 (ref-SWP::UCv_PoolTokenPosition pool "OURO-98c486052a51"))
            (expect-failure "<<SWP-G2>> ...and rejects one that is not in the string"
                "is not part of the Pool String" (ref-SWP::UCv_PoolTokenPosition pool outsider))
            (expect "<<SWP-G2>> URv_PoolTokenPosition locates a real token in the pool ROW"
                1 (ref-SWP::URv_PoolTokenPosition pool "OURO-98c486052a51"))
            (expect-failure "<<SWP-G2>> ...and rejects one that is not in the row"
                "is not part of Pool " (ref-SWP::URv_PoolTokenPosition pool outsider))
            ;;--- UEV_PoolFee: two guards, and the second is a CONJUNCTION whose halves are
            ;;separately reachable. CT_FEE_PRECISION is 4, so 5 decimals is one too many; the
            ;;size bound is [0.0001, 320.0] in per-mille, so 500.0 breaks the ceiling and 0.0 the
            ;;floor. All three inputs are 4-decimal-clean except the first, which is the point:
            ;;each trip isolates exactly one clause.
            (expect "<<SWP-G2>> UEV_PoolFee accepts a well-formed fee"
                true (!= "" (format "{}" [(ref-SWP::UEV_PoolFee 10.0)])))
            (expect-failure "<<SWP-G2>> UEV_PoolFee rejects one decimal past CT_FEE_PRECISION (4)"
                "is invalid decimal wise" (ref-SWP::UEV_PoolFee 10.00001))
            (expect-failure "<<SWP-G2>> UEV_PoolFee rejects a fee above the 320.0 promille ceiling"
                "is invalid size wise" (ref-SWP::UEV_PoolFee 500.0))
            (expect-failure "<<SWP-G2>> ...and one below the 0.0001 floor -- the other half of the same conjunction"
                "is invalid size wise" (ref-SWP::UEV_PoolFee 0.0))
        ]
    )
    ""
)
(commit-tx)

;;|| NEXT >
