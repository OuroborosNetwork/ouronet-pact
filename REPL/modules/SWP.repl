(begin-tx "SWP-G22 -- a REAL sleeping-LP token, and the guard that rejects it")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(namespace "ouronet-ns")
(print "--- [SWP-G22 . 01 . issue a sleeping link on the LP token] ---")
;;DPOF::UEV_ParentOwnership's "Sleeping LP Tokens not allowed for this operation" was UNPINNED, and
;;the source carries a note explaining why: the guard is shielded by an EAGER let-binding of
;;<parent>, which reads the properties table, so a made-up sleeping-LP id aborts in that read before
;;the enforce runs. The note ends "Reaching it needs a REAL issued sleeping-LP token, which no suite
;;creates."
;;
;;This creates one. The trick is that the guard tests the FOURTH CHARACTER of the id against BAR --
;;so an ordinary sleeping DPOF (Z|MOCKA…) does NOT trip it; only the sleeping counterpart of an
;;LP token does, because an LP id is itself prefixed (S|…), making "Z|S|" the fourth character a
;;bar. This suite owns LP tokens, which is why the fixture exists here and nowhere else.
;;
;;NOTE FOR MAINTENANCE: the source comment at 06_DPOF.pact:2014 now understates the state of things
;;-- a suite does create one. It also proposes the fix (bind <parent> lazily inside the `if` below
;;the enforce, matching the DPTF twin URCv_Parent, which enforces before its read and is pinned by
;;modules/DPTF.repl <<DPTF-G5>>). Left for the owner; canonical sources are not edited from here.
(let* ((lp:string (SWP.UR_TokenLP "S|DLK-98c486052a51|OURO-98c486052a51|DWK-98c486052a51"))
       (split-stoa:[decimal] (DALOS.URC_SplitSTOAPrices KST.ANHD (DALOS.UR_UsagePrice "dpmf"))))
    (env-sigs
        [ { "key": "PK_AncientHodler", "caps": [] }
          { "key": "6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263", "caps":
            [ (coin.TRANSFER "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263"
                  "k:50d6c59b21e5e6e55baecaa75a1007de37576bde12d8230dc82459cc01b9484b" (at 2 split-stoa))
              (coin.TRANSFER "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263"
                  "k:0cb30c0121ff919266121a99ff9359871818932211df94dae4137c29bc0e8f7e" (at 0 split-stoa))
              (coin.TRANSFER "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263"
                  "c:XM-pkmuB5XUQlp87ZYSbfKt8qzmHY6O2EHAzMRVBt3k" (at 3 split-stoa))
              (coin.TRANSFER "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263"
                  "c:iQQFWj6gWtpGEzhM_O5ekW1QtnQQy55R8BRPGhj_0FU" (at 1 split-stoa)) ] } ])
    (let ((created:[string] (TS01-C2.VST|C_CreateSleepingLink KST.ANHD (ouronet-ns.DPTF.UR_Konto lp) lp)))
        (map print
            [
                ;;the sleeping counterpart of an LP token is itself double-prefixed
                (expect "<<SWP-G22>> the sleeping counterpart of an LP token is Z| over the LP id"
                    (concat ["Z|" lp]) (at 1 created))
                ;;...which is what puts a BAR in the fourth character -- the thing the guard tests.
                ;;Asserted explicitly so the test does not silently stop exercising the guard if
                ;;the id scheme ever changes.
                (expect "<<SWP-G22>> ...putting a BAR in the 4th character, which is what the guard reads"
                    "|" (drop 3 (take 4 (at 1 created))))
            ]
        )
    )
)
(commit-tx)

;;|| NEXT >
