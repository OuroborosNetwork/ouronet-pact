(begin-tx "SWP-I30 — INFO_SWP|SmartSwapNoSlippageBundle quote vs measured charge")
(env-gasmodel "table")(env-gaslimit 100000000)(env-gas 0)
(namespace "ouronet-ns")
(print "--- [SWP-I30 · 01 · bundle-routed swap, no bounds] ---")
;;FUNCTION COVERAGE (G6) — `INFO_SWP|SmartSwapNoSlippageBundle`, per the owner's spec. Template: `modules/ATS.repl <<ATS-I1>>`;
;;the patron/interactor hazard is written out at <<SWP-I2>>.
;;THE OTHER HALF OF THE NAME INVERSION pinned at <<SWP-I20>>: the preview WITH `Bundle` in its name
;;maps to the exec WITHOUT the doubled prefix. `C_SmartSwap*` takes a pre-computed route bundle;
;;`CC_SmartSwap*` searches for one. Wiring these two blocks by name alone would have them measure
;;each other's op, and both would still pass.
(env-sigs [{ "key": "PK_AncientHodler", "caps": [] }])
(let*
    (
        (ref-TS01-C3:module{TalosStageOne_ClientThreeV4} TS01-C3)
        (ref-SWPU:module{SwapperUsageV3} SWPU)
        (ref-SWP:module{SwapperV4} SWP)
        (ref-DALOS:module{OuronetDalosV2} DALOS)
        (patron:string KST.ANHD)
        (sd:string "S|DLK-98c486052a51|OURO-98c486052a51|DWK-98c486052a51")
        (pt:[string] (ref-SWP::UR_PoolTokens sd))
        (a:string (at 0 pt))
        (b:string (at 1 pt))
        ;;SWPU publishes no UDC for these, so they are object literals — the same construction
        ;;<<SWP-G17>> uses. `boost-path` is a deliberate MISS and `stoa-paths` is empty: both sides of
        ;;the comparison receive the identical bundle, so whatever the boost branch decides, it decides
        ;;the same way for the preview and for the exec.
        (miss:object{SwapperUsageV3.CachedPathOrMiss} {"nodes":[],"edges":[],"is-new":false})
        (bundle:object{SwapperUsageV3.SmartSwapPathBundle}
            {"swap-route":{"nodes":[a b],"edges":[sd]},"boost-path":miss,"stoa-paths":[]})
        (sb:object{SwapperUsageV3.Slippage}
            (ref-SWPU::UDC_SpawnSmartSwapSlippageBounds a 1.0 b 1.0))
    )
    (let
        (
            (predicted:object{OuronetInfoV2.ClientInfo} (INFO-ONE.INFO_SWP|SmartSwapNoSlippageBundle patron patron a 1.0 b bundle))
            (ignis-before:decimal (ref-DALOS::UR_TF_AccountSupply patron false))
            (m (ref-TS01-C3::SWP|C_SmartSwapNoSlippage patron patron a 1.0 b bundle))
        )
        (map print
            [
                (format "<<SWP-I30>> predicted={} real={}"
                    [(at "ignis-need" (at "ignis" predicted))
                     (- ignis-before (ref-DALOS::UR_TF_AccountSupply patron false))])
                (expect "<<SWP-I30>> INFO_SWP|SmartSwapNoSlippageBundle's quote equals what the op actually charged"
                    (- ignis-before (ref-DALOS::UR_TF_AccountSupply patron false))
                    (at "ignis-need" (at "ignis" predicted)))
                (expect "<<SWP-I30>> ...and it is a real, non-zero charge"
                    true (> (- ignis-before (ref-DALOS::UR_TF_AccountSupply patron false)) 0.0))
            ]
        )
    )
    ""
)
(env-sigs [])
(rollback-tx)

