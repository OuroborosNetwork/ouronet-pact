;; REPL/modules/SWP.repl — STANDALONE SWP tester (liquidity pools).
;; Fresh boot: Stage 00 + Stage 1 deploy core + [6.2]_DPTF (SWP pairs need its BUSD/token
;; fixtures) + the SWP suite. Run: cd REPL && pact modules/SWP.repl
(load "../deploy-stage00.repl")
(load "../deploy-stage01.repl")
(load "../Stage_01/[6.2]_DPTF.repl")
(load "../Stage_01/[6.3]_SWP.repl")

;;|| NEXT >
;;
;; P2 additions. The three MTX (matrix / multi-token) pool issuance entrypoints on TS01-P are
;; mutually exclusive inside one file -- each starts a 3-step defpact -- so [6.3] runs
;; SWP|C_IssueStablePool live and leaves C_IssueStandardPool and C_IssueWeightedPool COMMENTED
;; OUT at [6.3]:986-1002. The ledger counted them as exercised until it learned to strip
;; comments; they had never run. They run here, after [6.3]'s defpact has completed.
;;
;;|| NEXT >
;;
(begin-tx "SWPX-01a — SWP|C_IssueStandardPool, defpact step 0|2")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(namespace "ouronet-ns")
(print "--- [SWPX-01a · 01 · the first token must be a PRINCIPAL] ---")
(env-sigs [{ "key": "PK_AncientHodler", "caps": [] }])
;; SWPI::UEV_Issue applies an extra rule to W and P pools (the two with amp = -1.0) that stable
;; pools do not carry: the FIRST pool token must be a Principal. A stable pool may lead with any
;; token that is one hop from a principal; a weighted or standard pool may not. Rejecting first
;; proves the rule exists before the happy path relies on satisfying it. Step 0 of the defpact is
;; validation only -- no writes -- so catching this abort inline leaves nothing behind (Rule 9).
(let
    (
        (ref-SWP:module{SwapperV4} SWP)
        (ref-TS01-CP:module{TalosStageOne_ClientPactsV4} TS01-CP)
        (patron:string KST.ANHD)
    )
    (print (format "principals = {}" [(ref-SWP::UR_Principals)]))
    (map print
        [
            (expect-failure "<<SWPX-01a>> a STANDARD pool led by a non-principal is refused"
                "1st Token is not a Principal"
                (ref-TS01-CP::SWP|C_IssueStandardPool patron patron
                    [
                        { "token-id":  "BUSD-98c486052a51", "token-supply": 100000.0}
                        { "token-id":  "TUSD-98c486052a51", "token-supply": 100000.0}
                        { "token-id":  "USDT-98c486052a51", "token-supply": 100000.0}
                    ]
                    10.0 false))
        ]
    )
    ""
)
(print "--- [SWPX-01a · 02 · a new pool must be worth at least the SPAWN LIMIT] ---")
;; The second rule W/P/S pools all share: unless the pool is flagged a principal pool (p=true),
;; its opening liquidity must be worth at least SWP::UR_SpawnLimit in wSTOA. For an S or P pool
;; the worth is measured from the FIRST token's deposit alone, scaled by the token count -- so it
;; is the first token that decides admission, not the sum. Both sides of the bound are proven
;; below; a one-sided test would pass against a guard that never rejects.
(let
    (
        (ref-SWP:module{SwapperV4} SWP)
        (ref-SWPI:module{SwapperIssueV4} SWPI)
        (ref-TS01-CP:module{TalosStageOne_ClientPactsV4} TS01-CP)
        (patron:string KST.ANHD)
        (dlk:string "DLK-98c486052a51")
    )
    (map print
        [
            (expect "<<SWPX-01a>> the spawn limit is a real, non-zero floor"
                true (> (ref-SWP::UR_SpawnLimit) 0.0))
            (expect-failure "<<SWPX-01a>> under the floor, the pool is refused"
                "More liquidity is needed to open a new pool"
                (ref-TS01-CP::SWP|C_IssueStandardPool patron patron
                    [
                        { "token-id":  dlk,                 "token-supply": 100.0}
                        { "token-id":  "BUSD-98c486052a51", "token-supply": 100000.0}
                        { "token-id":  "TUSD-98c486052a51", "token-supply": 100000.0}
                        { "token-id":  "USDT-98c486052a51", "token-supply": 100000.0}
                    ]
                    10.0 false))
        ]
    )
    (print (format "DLK worth at 100/1000/5000 = {} / {} / {}"
        [(ref-SWPI::URC_WorthWSTOA dlk 100.0) (ref-SWPI::URC_WorthWSTOA dlk 1000.0)
         (ref-SWPI::URC_WorthWSTOA dlk 5000.0)]))
    (print (format "DLK held = {}" [(DPTF.UR_AccountSupply dlk KST.ANHD)]))
    ;;over the floor: this one starts the defpact
    (ref-TS01-CP::SWP|C_IssueStandardPool patron patron
        [
            { "token-id":  dlk,                 "token-supply": 5000.0}
            { "token-id":  "BUSD-98c486052a51", "token-supply": 100000.0}
            { "token-id":  "TUSD-98c486052a51", "token-supply": 100000.0}
            { "token-id":  "USDT-98c486052a51", "token-supply": 100000.0}
        ]
        10.0 false)
    ""
)
(print "===^^^===")
(commit-tx)

;;|| NEXT >
;;
(begin-tx "SWPX-01b — standard pool, defpact step 1|2 (ignis + STOA)")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(namespace "ouronet-ns")
(print "--- [SWPX-01b · 01 · paying step] ---")
(let
    (
        (ref-DALOS:module{OuronetDalosV2} DALOS)
        (split-stoa:[decimal]
            (ref-DALOS::URC_SplitSTOAPrices KST.ANHD
                (+ (ref-DALOS::UR_UsagePrice "dptf") (ref-DALOS::UR_UsagePrice "swp"))))
    )
    (env-sigs
        [
            { "key": "PK_AncientHodler", "caps": [] }
            { "key": "6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263",
              "caps":
                [
                    (coin.TRANSFER "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263"
                        "k:50d6c59b21e5e6e55baecaa75a1007de37576bde12d8230dc82459cc01b9484b" (at 2 split-stoa))
                    (coin.TRANSFER "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263"
                        "k:0cb30c0121ff919266121a99ff9359871818932211df94dae4137c29bc0e8f7e" (at 0 split-stoa))
                    (coin.TRANSFER "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263"
                        "c:XM-pkmuB5XUQlp87ZYSbfKt8qzmHY6O2EHAzMRVBt3k" (at 3 split-stoa))
                    (coin.TRANSFER "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263"
                        "c:iQQFWj6gWtpGEzhM_O5ekW1QtnQQy55R8BRPGhj_0FU" (at 1 split-stoa))
                ]
            }
        ]
    )
    ;; The REPL hands every defpact the same constant id -- (pact-state) reports
    ;; "2n12TVKIdyigszwESxXUSOkAtK48XfsKcVoUGxWYSSE" here exactly as it does for [6.3]'s stable
    ;; pool -- so the literal is stable, not a hash that shifts when transactions move. Bare
    ;; (continue-pact 1) does NOT work across a commit-tx boundary: the environment is gone.
    (continue-pact 1 false "2n12TVKIdyigszwESxXUSOkAtK48XfsKcVoUGxWYSSE")
)
(print "===^^^===")
(env-sigs [])
(commit-tx)

;;|| NEXT >
;;
(begin-tx "SWPX-01c — standard pool, defpact step 2|2 + assertions")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(namespace "ouronet-ns")
(print "--- [SWPX-01c · 01 · finalising step] ---")
(env-sigs [{ "key": "PK_AncientHodler", "caps": [] }])
(continue-pact 2 false "2n12TVKIdyigszwESxXUSOkAtK48XfsKcVoUGxWYSSE")
(print "--- [SWPX-01c · 02 · the pool that was built] ---")
(let
    (
        (ref-SWP:module{SwapperV4} SWP)
        (ref-U|SWP:module{UtilitySwpV2} U|SWP)
        (toks:[string] ["DLK-98c486052a51" "BUSD-98c486052a51" "TUSD-98c486052a51" "USDT-98c486052a51"])
    )
    ;; The pool id is DERIVED from (tokens, weights, amp) -- it is not chosen. Computing it here
    ;; instead of pasting a literal is what makes the next two assertions mean something: a
    ;; STANDARD pool is exactly "weights all 1.0, amplifier -1.0", and that is what names it.
    (let ((sp:string (ref-U|SWP::UC_PoolID toks (make-list 4 1.0) -1.0)))
        (map print
            [
                (expect "<<SWPX-01>> C_IssueStandardPool created the pool at its derived id"
                    KST.ANHD (ref-SWP::UR_OwnerKonto sp))
                (expect "<<SWPX-01>> a STANDARD pool carries uniform weights"
                    (make-list 4 1.0) (ref-SWP::UR_Weigths sp))
                ;; -1.0 is the "no amplifier" marker; only stable pools carry a real one.
                (expect "<<SWPX-01>> a STANDARD pool has NO amplifier (-1.0 marker)"
                    -1.0 (ref-SWP::UR_Amplifier sp))
                (expect "<<SWPX-01>> the LP fee the caller asked for was stored"
                    10.0 (ref-SWP::UR_FeeLP sp))
                (expect "<<SWPX-01>> the pool holds exactly the 4 tokens it was issued with"
                    toks (ref-SWP::UR_PoolTokens sp))
                ;; Issuing a pool does NOT make it usable. BOTH capabilities start OFF and the
                ;; owner must turn each on (C_ToggleSwapCapability / C_ToggleAddLiquidity). A
                ;; freshly issued pool is completely inert -- it holds its genesis liquidity and
                ;; accepts neither swaps nor deposits. "The pool exists" and "the pool works" are
                ;; separate states, and an integrator that conflates them routes into a dead pool.
                (expect "<<SWPX-01>> a freshly issued pool has swapping OFF until enabled"
                    false (ref-SWP::UR_CanSwap sp))
                (expect "<<SWPX-01>> ...and adding liquidity is OFF too -- the pool starts inert"
                    false (ref-SWP::UR_CanAdd sp))
                ;; [6.3]'s 7-token STABLE pool is untouched and still amplified: id derivation
                ;; keeps pool TYPES apart rather than colliding them.
                (expect "<<SWPX-01>> [6.3]'s stable pool still carries its amplifier"
                    85.0 (ref-SWP::UR_Amplifier
                        (ref-U|SWP::UC_PoolID
                            ["BUSD-98c486052a51" "TUSD-98c486052a51" "USDT-98c486052a51"
                             "USDC-98c486052a51" "USDD-98c486052a51" "AUSD-98c486052a51"
                             "CUSD-98c486052a51"] (make-list 7 1.0) 85.0)))
            ]
        )
    )
    ""
)
(print "===^^^===")
(commit-tx)

;;|| NEXT >
;;
(begin-tx "SWPX-02a — SWP|C_IssueWeightedPool, defpact step 0|2")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(namespace "ouronet-ns")
(print "--- [SWPX-02a · 01 · weight validation, then the real issue] ---")
(env-sigs [{ "key": "PK_AncientHodler", "caps": [] }])
;; The weight rules are an enforce-one: weights either sum to EXACTLY 1.0 (weighted) or are all
;; 1.0 (standard/stable). Anything between is refused, and each weight must be at least 0.1.
;; Both rejections are validation-only (defpact step 0 writes nothing), so probing them inline
;; leaves no residue -- Rule 9.
(let
    (
        (ref-TS01-CP:module{TalosStageOne_ClientPactsV4} TS01-CP)
        (patron:string KST.ANHD)
        (dlk:string "DLK-98c486052a51")
        (pt:[object{SwapperV4.PoolTokens}]
            [
                { "token-id":  "DLK-98c486052a51",  "token-supply": 5000.0}
                { "token-id":  "BUSD-98c486052a51", "token-supply": 100000.0}
                { "token-id":  "TUSD-98c486052a51", "token-supply": 100000.0}
                { "token-id":  "USDC-98c486052a51", "token-supply": 100000.0}
            ]
        )
    )
    (map print
        [
            (expect-failure "<<SWPX-02a>> weights that sum to neither 1.0 nor the token count are refused"
                "Invalid Weight Values"
                (ref-TS01-CP::SWP|C_IssueWeightedPool patron patron pt 10.0 [0.4 0.2 0.2 0.1] false))
            (expect-failure "<<SWPX-02a>> a weight below the 0.1 minimum is refused"
                "must respect fee precision and be at least 0.1"
                (ref-TS01-CP::SWP|C_IssueWeightedPool patron patron pt 10.0 [0.7 0.1 0.1 0.05] false))
        ]
    )
    ;;valid: sums to exactly 1.0, every weight >= 0.1
    (ref-TS01-CP::SWP|C_IssueWeightedPool patron patron pt 10.0 [0.4 0.2 0.2 0.2] false)
    ""
)
(print "===^^^===")
(commit-tx)

;;|| NEXT >
