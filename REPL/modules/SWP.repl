(begin-tx "SWP-G20c -- the cap value ITSELF is accepted, and the fee is restored after")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(namespace "ouronet-ns")
;;==== SWP-G20c -- the cap value ITSELF is accepted, and the fee is restored after · 01 · env-sigs (caps) ==== 
(print "--- [SWP-G20c -- the cap value ITSELF is accepted, and the fee is restored after · 01 · env-sigs (caps)] ---")
(env-sigs [{ "key": "PK_AncientHodler", "caps": [] }])
(print "--- [SWP-G20c . 01 . inclusive upper bound, then restore] ---")
;;320.0 EXACTLY must be accepted -- that is what makes the bound inclusive, and it is the assertion
;;an off-by-one would break while every rejection above still passed.
;;
;;The original fee is captured and RESTORED at the end, and the restore is itself asserted. This
;;block changes real pool state; leaving a 320-promile fee behind would silently re-price every
;;later test that touches this pair.
(let* ((sp:string "S|DLK-98c486052a51|OURO-98c486052a51|DWK-98c486052a51")
       (original:decimal (SWP.UR_FeeLP sp)))
    (TS01-C3.SWP|C_UpdateFee KST.ANHD (SWP.UR_OwnerKonto sp) sp 320.0 true)
    (let ((at-cap:decimal (SWP.UR_FeeLP sp)))
        (TS01-C3.SWP|C_UpdateFee KST.ANHD (SWP.UR_OwnerKonto sp) sp original true)
        (map print
            [
                (expect "<<SWP-G20>> the cap value 320.0 is ACCEPTED -- the bound is inclusive"
                    320.0 at-cap)
                ;;and the restore really happened, so nothing downstream inherits a 32% fee
                (expect "<<SWP-G20>> ...and the original fee is restored afterwards"
                    original (SWP.UR_FeeLP sp))
                ;;guard against the restore being vacuous: the two values must actually differ,
                ;;or this block proved nothing about either setting
                (expect "<<SWP-G20>> ...and the original differed from the cap, so the restore mattered"
                    true (!= original 320.0))
            ]
        )
    )
)
(commit-tx)

