(begin-tx "SWP-G11b — with swapping off, both inactive-pool guards fire")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(namespace "ouronet-ns")
(print "--- [SWP-G11b · 01 · the two inactive-pool refusals] ---")
;;The single-pool guard and the smart-swap PATH guard are separate checks with separate messages:
;;the first refuses a swap AT a dead pool, the second refuses a multi-hop route that merely passes
;;THROUGH one. A router that only checked the endpoints would still send funds down a dead hop.
;;==== SWP-G11b — with swapping off, both inactive-pool guards fire · 01 · env-sigs (caps) ==== ===
(print "--- [SWP-G11b — with swapping off, both inactive-pool guards fire · 01 · env-sigs (caps)] ---")
(env-sigs [{ "key": "PK_Emma", "caps": [] }])
;;==== SWP-G11b — with swapping off, both inactive-pool guards fire · 02 · let / invocation ==== ==
(print "--- [SWP-G11b — with swapping off, both inactive-pool guards fire · 02 · let / invocation] ---")
(let
    (
        (pool:string "S|DLK-98c486052a51|OURO-98c486052a51|DWK-98c486052a51")
    )
    (map print
        [
            (expect-failure "<<SWP-G11b>> a direct swap at the disabled pool is refused"
                "swap functionality is inactive"
                (test-capability (SWPU.SWPU|X>SWAP pool
                    (U|SWP.UDC_DirectSwapInputData ["DLK-98c486052a51"] [1.0] "OURO-98c486052a51"))))
            ;;the route case: real tokens, a NON-empty edge list, so the first four guards pass
            ;;and the only thing wrong is that a hop on the path is dead.
            (expect-failure "<<SWP-G11b>> ...and a smart-swap ROUTE that passes through it is refused too"
                "along the Smart Swap path has swap functionality inactive"
                (test-capability (SWPU.SWPU|X>SMART-SWAP "a" "DLK-98c486052a51" 1.0
                    "OURO-98c486052a51"
                    (SWPI.UDC_Hopper ["DLK-98c486052a51" "OURO-98c486052a51"] [pool] [1.0]))))
        ]
    )
    ;;--- DOC-CLAIM VERIFICATION (`_docclaims.py` G5), three claims that all need exactly the state
    ;;this transaction already holds: TWO PARALLEL POOLS between DLK and OURO, one of them disabled.
    ;;That configuration is the ONLY one in which any of these three claims has content, and it
    ;;exists here for two transactions and nowhere else in the suite. Free to assert; expensive to
    ;;rebuild later.
    ;;
    ;;  `14_SWPT.pact` URC_Edges       — "All swpairs directly connecting <t1> and <t2> — REGARDLESS
    ;;                                    of can-swap state."
    ;;  `14_SWPT.pact` URC_EdgesActive — "...restricted to swpairs also present in <whitelist> — so a
    ;;                                    disabled parallel pool is never offered as an edge candidate."
    ;;  `16_SWPI.pact` URC_BestEdgeFiltered — same, for the chosen hop (#19H).
    (let
        (
            (dlk:string "DLK-98c486052a51")
            (ouro:string "OURO-98c486052a51")
            (dead:string "S|DLK-98c486052a51|OURO-98c486052a51|DWK-98c486052a51")
            (live:string "W|DLK-98c486052a51|OURO-98c486052a51|DWK-98c486052a51")
        )
        (map print
            [
                ;;the premise: one of the two parallel pools really is disabled right now
                (expect "<<SWP-G11b>> DOC: the S| pool is disabled and the W| parallel pool is not"
                    [false true]
                    [(SWP.UR_CanSwap dead) (SWP.UR_CanSwap live)])
                ;;CLAIM 1 — URC_Edges ignores can-swap. Asserted while one pool IS disabled, which is
                ;;what makes this a statement about can-swap-independence rather than a count.
                (expect "<<SWP-G11b>> DOC: URC_Edges returns BOTH parallel pools, ignoring can-swap"
                    [true true]
                    [(contains dead (SWPT.URC_Edges dlk ouro))
                     (contains live (SWPT.URC_Edges dlk ouro))])
                ;;CLAIM 2 — URC_EdgesActive drops the disabled one and keeps the other. Both halves,
                ;;because "returns fewer" would also be satisfied by returning nothing.
                (expect "<<SWP-G11b>> DOC: URC_EdgesActive DROPS the disabled pool"
                    false (contains dead (SWPT.URC_EdgesActive dlk ouro (SWP.URC_ActiveSwpairs))))
                (expect "<<SWP-G11b>> DOC: ...and KEEPS the active parallel pool"
                    true (contains live (SWPT.URC_EdgesActive dlk ouro (SWP.URC_ActiveSwpairs))))
                ;;CLAIM 3 — the chosen hop. THE FIRST LINE IS WHAT MAKES THIS NON-VACUOUS: at this
                ;;input the UNFILTERED chooser genuinely prefers the DISABLED pool, so the filtered
                ;;chooser returning the live one is a real difference and not a coincidence of
                ;;ordering. Asserting only the second line would prove nothing -- an implementation
                ;;that ignored the whitelist entirely could still return `live` at some other input.
                (expect "<<SWP-G11b>> DOC: unfiltered URC_BestEdge PREFERS the disabled pool here"
                    dead (SWPI.URC_BestEdge 1.0 dlk ouro))
                (expect "<<SWP-G11b>> DOC: ...and URC_BestEdgeFiltered refuses it for the live one (#19H)"
                    live (SWPI.URC_BestEdgeFiltered 1.0 dlk ouro (SWP.URC_ActiveSwpairs)))
            ]
        )
    )
    ""
)
(commit-tx)

