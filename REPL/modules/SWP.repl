;;FUNCTION COVERAGE (G6) — `INFO_SWP|SmartSwapWithSlippage`, per the owner's spec: an INFO_ must report the same cost
;;the op actually charges. Template: `modules/ATS.repl <<ATS-I1>>`; the patron/interactor hazard that
;;decides whether such a measurement is valid at all is written out at <<SWP-I2>>.
;;THE NAME INVERSION — the single easiest place in this codebase to wire a test backwards.
;;`04_TS01-C3.pact` declares BOTH `SWP|C_SmartSwap*` and `SWP|CC_SmartSwap*`, and they are NOT the
;;heavy/light pair the prefix convention implies:
;;    CC_SmartSwap*  takes NO bundle -> it SEARCHES the route (BFS) -> pairs with INFO_...SmartSwap*
;;    C_SmartSwap*   takes a bundle  -> route already known         -> pairs with INFO_...*Bundle
;;So the preview WITHOUT `Bundle` in its name maps to the exec WITH the doubled prefix, and vice
;;versa. Matching by name alone yields two green tests that each measure the other's op.
;;AOZT is the swapper because the proven route in `[6.3]` TX-016a is AKOSON -> TUSD out of AOZ's
;;holdings; the patron paying gas stays ANHD.
(env-sigs [{ "key": "PK_AncientHodler", "caps": [] } { "key": "PK_AOZ", "caps": [] }])
(let
    (
        (ref-TS01-C3:module{TalosStageOne_ClientThreeV4} TS01-C3)
        (ref-SWPU:module{SwapperUsageV3} SWPU)
        (ref-SWP:module{SwapperV4} SWP)
        (ref-DALOS:module{OuronetDalosV2} DALOS)
        (eur:string "W|OURO-98c486052a51|TEUR-98c486052a51|EURT-98c486052a51|EURC-98c486052a51|EURD-98c486052a51|AEUR-98c486052a51|CEUR-98c486052a51")
        (prim:string "W|DLK-98c486052a51|OURO-98c486052a51|DWK-98c486052a51")
        (patron:string KST.ANHD)
        (aozt:string KST.AOZT)
    )
    (let
        (
            (predicted:object{OuronetInfoV2.ClientInfo} (INFO-ONE.INFO_SWP|SmartSwapWithSlippage patron aozt "AKOSON-98c486052a51" 5.0 "TUSD-98c486052a51" (ref-SWPU::UDC_SpawnSmartSwapSlippageBounds "AKOSON-98c486052a51" 5.0 "TUSD-98c486052a51" 1.0)))
            (ignis-before:decimal (ref-DALOS::UR_TF_AccountSupply patron false))
            (m (ref-TS01-C3::SWP|CC_SmartSwapWithSlippage patron aozt "AKOSON-98c486052a51" 5.0 "TUSD-98c486052a51" (ref-SWPU::UDC_SpawnSmartSwapSlippageBounds "AKOSON-98c486052a51" 5.0 "TUSD-98c486052a51" 1.0)))
        )
        (map print
            [
                (format "<<SWP-I20>> predicted={} real={}"
                    [(at "ignis-need" (at "ignis" predicted))
                     (- ignis-before (ref-DALOS::UR_TF_AccountSupply patron false))])
                (expect "<<SWP-I20>> INFO_SWP|SmartSwapWithSlippage's quote equals what the op actually charged"
                    (- ignis-before (ref-DALOS::UR_TF_AccountSupply patron false))
                    (at "ignis-need" (at "ignis" predicted)))
                (expect "<<SWP-I20>> ...and it is a real, non-zero charge"
                    true (> (- ignis-before (ref-DALOS::UR_TF_AccountSupply patron false)) 0.0))
