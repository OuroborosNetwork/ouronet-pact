(begin-tx "SWP-G11c — restore: swapping back ON, and the worth floor that gates the restart")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(namespace "ouronet-ns")
(print "--- [SWP-G11c · 01 · re-enable and assert the pool is usable again] ---")
;;Turning swapping back ON runs the worth floor: a pool may only be restarted if it is worth more
;;than UR_InactiveLimit. This pool is well above it, so the restart succeeds -- and asserting the
;;margin FIRST is what makes that a statement about the guard rather than a hope.
;;==== SWP-G11c — restore: swapping back ON, and the worth floor that gates the restart · 01 · env-sigs (caps) ==== 
(print "--- [SWP-G11c — restore: swapping back ON, and the worth floor that gates the restart · 01 · env-sigs (caps)] ---")
(env-sigs [{ "key": "PK_AncientHodler", "caps": [] }])
