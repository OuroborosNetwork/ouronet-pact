(begin-tx "SWPX-02c — weighted pool, defpact step 2|2 + assertions")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(namespace "ouronet-ns")
(print "--- [SWPX-02c · 01 · finalising step] ---")
;;==== SWPX-02c — weighted pool, defpact step 2|2 + assertions · 01 · env-sigs (caps) ==== ========
(print "--- [SWPX-02c — weighted pool, defpact step 2|2 + assertions · 01 · env-sigs (caps)] ---")
(env-sigs [{ "key": "PK_AncientHodler", "caps": [] }])
(continue-pact 2 false "2n12TVKIdyigszwESxXUSOkAtK48XfsKcVoUGxWYSSE")
(print "--- [SWPX-02c · 02 · the weighted pool, and how it differs] ---")
;;==== SWPX-02c — weighted pool, defpact step 2|2 + assertions · 02 · let / invocation ==== =======
(print "--- [SWPX-02c — weighted pool, defpact step 2|2 + assertions · 02 · let / invocation] ---")
(let
    (
        (ref-SWP:module{SwapperV4} SWP)
        (ref-U|SWP:module{UtilitySwpV2} U|SWP)
        (toks:[string] ["DLK-98c486052a51" "BUSD-98c486052a51" "TUSD-98c486052a51" "USDC-98c486052a51"])
        (w:[decimal] [0.4 0.2 0.2 0.2])
    )
    (let
        (
            (wp:string (ref-U|SWP::UC_PoolID toks w -1.0))
            (pp:string (ref-U|SWP::UC_PoolID toks (make-list 4 1.0) -1.0))
        )
        (map print
            [
                (expect "<<SWPX-02>> C_IssueWeightedPool created the pool at its derived id"
                    KST.ANHD (ref-SWP::UR_OwnerKonto wp))
                (expect "<<SWPX-02>> the asked-for weights are what the pool stores"
                    w (ref-SWP::UR_Weigths wp))
                (expect "<<SWPX-02>> genesis weights are recorded alongside the live ones"
                    w (ref-SWP::UR_GenesisWeigths wp))
                (expect "<<SWPX-02>> a WEIGHTED pool also carries the -1.0 no-amplifier marker"
                    -1.0 (ref-SWP::UR_Amplifier wp))
                ;; WEIGHTS ARE PART OF THE IDENTITY. The same four tokens with uniform weights
                ;; would be a different pool entirely -- so a weighted pool can never silently
                ;; overwrite the standard one, and the two coexist.
                (expect "<<SWPX-02>> weights are part of the pool id, so this is NOT the P pool"
                    false (= wp pp))
                (expect "<<SWPX-02>> ...and the uniform-weight pool over the SAME tokens is unissued"
                    "" (try "" (ref-SWP::UR_OwnerKonto pp)))
            ]
        )
    )
    ""
)
(print "===^^^===")
(commit-tx)

;;|| NEXT >
;;|| SWPX-02d — the CHANGE-weights path, which the issue path could not pin.
;;
(begin-tx "SWPX-02d - SWP|S>WEIGHTS: modifying weights on a live weighted pool")
(env-gasmodel "table")(env-gaslimit 100000000)(env-gas 0)
(namespace "ouronet-ns")
;;==== SWPX-02d - SWP|S>WEIGHTS: modifying weights on a live weighted pool · 01 · env-sigs (caps) ==== 
(print "--- [SWPX-02d - SWP|S>WEIGHTS: modifying weights on a live weighted pool · 01 · env-sigs (caps)] ---")
(env-sigs [{ "key": "PK_AncientHodler", "caps": [] }])
(print "--- [SWPX-02d · 01 · all weights must add to exactly 1.0] ---")
;;`15_SWP.pact:516`. SWPX-02a above records why this could not be pinned there: the ISSUE path
;;(`SWPI::UEV_Issue`) and this CHANGE path carry byte-identical wording, so a rejection from the
;;issue client credits both and proves only one. The note ends "SWP|S>WEIGHTS remains genuinely
;;unpinned and still needs a change-weights test." This is that test.
;;
;;IT COSTS NOTHING TO RUN HERE because SWPX-02a/b/c have just issued the weighted pool it needs --
;;[0.4 0.2 0.2 0.2] over four tokens, owned by the patron. A change-weights call cannot be made
;;against a standard pool at all (the `pp = "W"` enforce sits between the per-weight rule and this
;;one), so a weighted pool is the whole precondition.
;;
;;THE INPUT IS CHOSEN TO ISOLATE THIS ENFORCE. [0.4 0.2 0.2 0.1] sums to 0.9, but every element is
;;>= 0.1 and respects fee precision, so the per-weight lambda ABOVE passes and the sum rule is the
;;first thing that can refuse. Dropping a weight to 0.05 would have been the obvious way to make an
;;invalid list and would have pinned the wrong guard.
;;==== SWPX-02d - SWP|S>WEIGHTS: modifying weights on a live weighted pool · 02 · let / invocation ==== 
(print "--- [SWPX-02d - SWP|S>WEIGHTS: modifying weights on a live weighted pool · 02 · let / invocation] ---")
(let
    (
        (ref-SWP:module{SwapperV4} SWP)
        (ref-U|SWP:module{UtilitySwpV2} U|SWP)
        (ref-TS01-C3:module{TalosStageOne_ClientThreeV4} TS01-C3)
        (toks:[string] ["DLK-98c486052a51" "BUSD-98c486052a51" "TUSD-98c486052a51" "USDC-98c486052a51"])
        (w:[decimal] [0.4 0.2 0.2 0.2])
    )
    (let
        (
            (wp:string (ref-U|SWP::UC_PoolID toks w -1.0))
        )
        (map print
            [
                (expect "<<SWPX-02d>> the weighted pool is live, owned by the patron, at its genesis weights"
                    [KST.ANHD w] [(ref-SWP::UR_OwnerKonto wp) (ref-SWP::UR_Weigths wp)])
                ;;THE ITEM
                (expect-failure "<<SWPX-02d>> weights summing to 0.9 are refused on the CHANGE path"
                    "All weights must add to exactly 1.0"
                    (ref-TS01-C3::SWP|C_ModifyWeights KST.ANHD (SWP.UR_OwnerKonto wp) wp [0.4 0.2 0.2 0.1]))
                ;;...and over 1.0 as well, so this is an equality and not a ceiling
                (expect-failure "<<SWPX-02d>> ...and so are weights summing to 1.1"
                    "All weights must add to exactly 1.0"
                    (ref-TS01-C3::SWP|C_ModifyWeights KST.ANHD (SWP.UR_OwnerKonto wp) wp [0.5 0.2 0.2 0.2]))
                ;;CONTRAST -- a different, valid distribution IS accepted, so the two refusals are
                ;;about the sum and not about the pool refusing all modification.
                (expect "<<SWPX-02d>> ...while a different distribution summing to 1.0 is accepted"
                    true (!= "" (format "{}"
                        [(ref-TS01-C3::SWP|C_ModifyWeights KST.ANHD (SWP.UR_OwnerKonto wp) wp [0.25 0.25 0.25 0.25])])))
                (expect "<<SWPX-02d>> ...and the pool now stores the new weights"
                    [0.25 0.25 0.25 0.25] (ref-SWP::UR_Weigths wp))
                ;;GENESIS weights are NOT rewritten -- the pool remembers what it was issued with,
                ;;which is what keeps the pool id meaningful after a reweight.
                (expect "<<SWPX-02d>> ...while the GENESIS weights are untouched"
                    w (ref-SWP::UR_GenesisWeigths wp))
            ]
        )
        ""
    )
)
(env-sigs [])
;;the reweight is discarded -- SWPX-02e checks it
(rollback-tx)

;;|| NEXT >
;;|| SWPX-02e — the reweight left no trace.
;;
(begin-tx "SWPX-02e - no leakage")
(namespace "ouronet-ns")
(print "--- [SWPX-02e · 01 · no leakage] ---")
;;Weights drive every price this pool quotes. A leaked reweight would not fail loudly -- it would
;;quietly change swap outputs in whatever test runs next.
(let
    (
        (ref-U|SWP:module{UtilitySwpV2} U|SWP)
        (toks:[string] ["DLK-98c486052a51" "BUSD-98c486052a51" "TUSD-98c486052a51" "USDC-98c486052a51"])
    )
    (print
        (expect "<<SWPX-02e>> the pool is back at its issued weights"
            [0.4 0.2 0.2 0.2]
            (SWP.UR_Weigths (ref-U|SWP::UC_PoolID toks [0.4 0.2 0.2 0.2] -1.0))))
)
(commit-tx)

