(begin-tx "SWPX-03 — SWP|C_ChangeOwnership and SWP|C_UpgradeBranding")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(namespace "ouronet-ns")
(print "--- [SWPX-03 · 01 · branding upgrade on a pool] ---")
;; Both appear in no live invocation anywhere in the suite. SWP|C_ChangeOwnership in particular
;; was counted as covered by the ledger purely on the strength of a COMMENTED-OUT line, which is
;; what motivated stripping comments before measuring (Rule 10).
;;==== SWPX-03 — SWP|C_ChangeOwnership and SWP|C_UpgradeBranding · 01 · let / invocation ==== =====
(print "--- [SWPX-03 — SWP|C_ChangeOwnership and SWP|C_UpgradeBranding · 01 · let / invocation] ---")
(let
    (
        (unused:bool true)
    )
    ;; The four STOA recipients are the usual split targets; the caps are deliberately generous
    ;; because this test is about branding STATE, not about the exact fee arithmetic (which
    ;; [6.4]_Admin already pins).
    (env-sigs
        [
            { "key": "PK_AncientHodler", "caps": [] }
            { "key": "6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263",
              "caps":
                [
                    (coin.TRANSFER "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263"
                        "k:50d6c59b21e5e6e55baecaa75a1007de37576bde12d8230dc82459cc01b9484b" 100000.0)
                    (coin.TRANSFER "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263"
                        "k:0cb30c0121ff919266121a99ff9359871818932211df94dae4137c29bc0e8f7e" 100000.0)
                    (coin.TRANSFER "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263"
                        "c:XM-pkmuB5XUQlp87ZYSbfKt8qzmHY6O2EHAzMRVBt3k" 100000.0)
                    (coin.TRANSFER "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263"
                        "c:iQQFWj6gWtpGEzhM_O5ekW1QtnQQy55R8BRPGhj_0FU" 100000.0)
                ]
            }
        ]
    )
    (let
        (
            (ref-BRD:module{BrandingV2} BRD)
            (ref-U|SWP:module{UtilitySwpV2} U|SWP)
            (ref-TS01-C3:module{TalosStageOne_ClientThreeV4} TS01-C3)
            (toks:[string] ["DLK-98c486052a51" "BUSD-98c486052a51" "TUSD-98c486052a51" "USDT-98c486052a51"])
        )
        (let ((sp:string (ref-U|SWP::UC_PoolID toks (make-list 4 1.0) -1.0)))
            (let ((f0:integer (at "flag" (ref-BRD::UR_Branding sp false))))
                ;; A pool is NOT born unbranded: issuance seeds a branding row at flag 3. The
                ;; flag is a TIER, not a counter, and it counts DOWN as branding improves --
                ;; 3 is the default and the upgrade lands on 1. Reading it as "higher is more
                ;; branded" gets the relationship exactly backwards.
                (map print
                    [
                        (expect "<<SWPX-03>> issuance already seeds a branding flag on the pool"
                            3 f0)
                    ]
                )
                (ref-TS01-C3::SWP|C_UpgradeBranding KST.ANHD (SWP.UR_OwnerKonto sp) sp 2)
                (let ((b:object{BrandingV2.Schema} (ref-BRD::UR_Branding sp false)))
                    (map print
                        [
                            (expect "<<SWPX-03>> the upgrade moves the tier DOWN, 3 -> 1"
                                1 (at "flag" b))
                            (expect "<<SWPX-03>> ...which is strictly better than where it started"
                                true (< (at "flag" b) f0))
                            ;; The <months> argument buys months measured from branding genesis --
                            ;; the same rule the DPSF collection branding follows.
                            (expect "<<SWPX-03>> two months of premium were bought"
                                (add-time (at "genesis" b) (days 60)) (at "premium-until" b))
                        ]
                    )
                )
            )
        )
    )
    ""
)
(print "--- [SWPX-03 · 02 · ownership moves] ---")
(env-sigs [{ "key": "PK_AncientHodler", "caps": [] }])
(let
    (
        (ref-SWP:module{SwapperV4} SWP)
        (ref-U|SWP:module{UtilitySwpV2} U|SWP)
        (ref-TS01-C3:module{TalosStageOne_ClientThreeV4} TS01-C3)
        (toks:[string] ["DLK-98c486052a51" "BUSD-98c486052a51" "TUSD-98c486052a51" "USDT-98c486052a51"])
    )
    (let ((sp:string (ref-U|SWP::UC_PoolID toks (make-list 4 1.0) -1.0)))
        (map print
            [
                (expect "<<SWPX-03>> precondition: the pool is still the issuer's"
                    KST.ANHD (ref-SWP::UR_OwnerKonto sp))
                (expect "<<SWPX-03>> precondition: the pool permits an owner change"
                    true (ref-SWP::UR_CanChangeOwner sp))
            ]
        )
        (ref-TS01-C3::SWP|C_ChangeOwnership KST.ANHD (ref-SWP::UR_OwnerKonto sp) KST.EMMA sp)
        (map print
            [
                (expect "<<SWPX-03>> C_ChangeOwnership moved the pool to the new owner"
                    KST.EMMA (ref-SWP::UR_OwnerKonto sp))
                ;; Ownership is per-pool: the weighted pool built from an overlapping token set
                ;; must not follow along.
                (expect "<<SWPX-03>> the sibling weighted pool keeps ITS owner"
                    KST.ANHD (ref-SWP::UR_OwnerKonto
                        (ref-U|SWP::UC_PoolID
                            ["DLK-98c486052a51" "BUSD-98c486052a51" "TUSD-98c486052a51"
                             "USDC-98c486052a51"] [0.4 0.2 0.2 0.2] -1.0)))
            ]
        )
        ;;and the FORMER owner can no longer act as owner
        (map print
            [
                ;;THE FIXTURE IS WHAT KEEPS THIS TEST HONEST (2026-09-21, executor canon).
                ;;C_ChangeOwnership now runs UEV_ExecutorIsOwnerKonto BEFORE the capability. Had
                ;;the executor been written as the literal KST.ANHD -- the account this test is
                ;;about -- the binder would refuse first with "Executor is not the Entity Owner"
                ;;and this assertion would go on passing while no longer testing the AUTHORITY
                ;;gate it was written for. Reading the owner instead names EMMA, the binder is
                ;;satisfied, and CAP_Owner is the only thing left that can refuse -- which is the
                ;;refusal under test. <<SWP-G29>> below covers the binder itself.
                (expect-failure "<<SWPX-03>> the former owner cannot change ownership again"
                    "Keyset failure"
                    (ref-TS01-C3::SWP|C_ChangeOwnership KST.ANHD (ref-SWP::UR_OwnerKonto sp) KST.ANHD sp))
                (expect "<<SWPX-03>> ...and the pool still belongs to the new owner"
                    KST.EMMA (ref-SWP::UR_OwnerKonto sp))
                ;;<<SWP-G29>> THE ATTRIBUTION HALF, new with the executor canon (2026-09-21).
                ;;
                ;;Every one of 15_SWP's 18 entrypoints enforced ownership on a DERIVED account --
                ;;(UR_OwnerKonto swpair) -- and named no actor: HANDOFF 4g, across a whole module
                ;;rather than one function. UEV_ExecutorIsOwnerKonto supplies the missing half.
                ;;
                ;;SWPX-03 above pins AUTHORITY: a non-owner is refused. It cannot pin ATTRIBUTION,
                ;;because a caller who names the RIGHT owner while holding no key is already
                ;;stopped by CAP_Owner. The gap is the other direction -- the true owner naming
                ;;SOMEONE ELSE as the actor, where every signature check passes and only the
                ;;binder can object. That is what this asserts, and the distinct message is what
                ;;makes it an attribution test rather than a second liveness one.
                ;;
                ;;The two messages are the whole point: "Keyset failure" is authority,
                ;;"Executor is not the Entity Owner" is attribution. Delete the binder and this
                ;;goes red while SWPX-03 stays green.
                (expect-failure "<<SWP-G29>> the true owner may not attribute the change to another account"
                    "Executor is not the Entity Owner"
                    (ref-TS01-C3::SWP|C_ChangeOwnership KST.ANHD KST.ANHD KST.LUMY sp))
                ;;...and the pool is untouched by that refusal, so the binder refused BEFORE the
                ;;write rather than after it. An expect-failure alone cannot tell those apart --
                ;;the lesson <<ORBR-FEE3b>> paid for on 2026-09-21.
                (expect "<<SWP-G29>> ...and the refusal moved nothing"
                    KST.EMMA (ref-SWP::UR_OwnerKonto sp))
            ]
        )
    )
    ""
)
(print "===^^^===")
(commit-tx)

