(begin-tx "SWP-G20b -- zero is below the floor")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(namespace "ouronet-ns")
;;==== SWP-G20b -- zero is below the floor · 01 · env-sigs (caps) ==== ============================
(print "--- [SWP-G20b -- zero is below the floor · 01 · env-sigs (caps)] ---")
(env-sigs [{ "key": "PK_AncientHodler", "caps": [] }])
(print "--- [SWP-G20b . 01 . the floor] ---")
;;0.0 is the interesting low value rather than a negative: a zero LP-fee is the one a caller might
;;set deliberately, meaning to disable the fee, and it is refused. Disabling is a different
;;operation than setting the fee to nothing.
(map print
    [
        (expect-failure "<<SWP-G20>> a ZERO fee is refused -- disabling is not 'set it to nothing'"
            "SWP Pool Fee amount of 0.0 is invalid size wise"
            (TS01-C3.SWP|C_UpdateFee KST.ANHD (SWP.UR_OwnerKonto "S|DLK-98c486052a51|OURO-98c486052a51|DWK-98c486052a51")
                "S|DLK-98c486052a51|OURO-98c486052a51|DWK-98c486052a51" 0.0 true))
    ]
)
(commit-tx)

;;|| NEXT >
