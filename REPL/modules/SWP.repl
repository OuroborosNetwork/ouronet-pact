(begin-tx "SWP-I23 — INFO_SWP|AddIcedLiquidity quote vs measured charge")
(env-gasmodel "table")(env-gaslimit 100000000)(env-gas 0)
(namespace "ouronet-ns")
(print "--- [SWP-I23 · 01 · add liquidity with an iced secondary LP] ---")
;;FUNCTION COVERAGE (G6) — `INFO_SWP|AddIcedLiquidity`, per the owner's spec. Template: `modules/ATS.repl <<ATS-I1>>`;
;;the patron/interactor hazard is written out at <<SWP-I2>>.
;;`P|OURO|BUSD` is one of the two pools whose frozen-LP lane is already OPEN ([6.3]:3272), which the
;;iced variant needs — the delta over the standard add is the `VST::URCi_Freeze` leg on the secondary LP.;;
;;NO ASYMMETRY-TAX SPLIT HERE, and the reason is worth recording. `<<SWP-I14>>` had to subtract an
;;IGNIS leg that the STANDARD add takes as principal. This variant does not take one, because the
;;CLAD collection FLAGS differ per variant: standard passes `(asymmetric-collection=true,
;;gaseous-collection=true)`, iced and glacial pass `(false, true)`. With asymmetric collection off
;;there is no IGNIS in `mt-ids` at all, so a plain balance-delta is exact — and a split copied over
;;from <<SWP-I14>> would subtract a tax that was never charged, turning a correct preview into a
;;reported defect.
(env-sigs [{ "key": "PK_AncientHodler", "caps": [] }])
(let
    (
        (ref-TS01-C3:module{TalosStageOne_ClientThreeV4} TS01-C3)
        (ref-DALOS:module{OuronetDalosV2} DALOS)
        (ref-U|CT|DIA:module{DiaStoaPidV2} U|CT)
        (pool:string "P|OURO-98c486052a51|BUSD-98c486052a51")
        (patron:string KST.ANHD)
        (amounts:[decimal] [10.0 10.0])
    )
    (let
        (
            (info:object{OuronetInfoV2.ClientInfo}
                (INFO-ONE.INFO_SWP|AddIcedLiquidity patron patron pool amounts (ref-U|CT|DIA::UR_STOA-PID|Price)))
            (predicted:decimal
                (at "ignis-need" (at "ignis"
                    (INFO-ONE.INFO_SWP|AddIcedLiquidity patron patron pool amounts (ref-U|CT|DIA::UR_STOA-PID|Price)))))
            (ignis-before:decimal (ref-DALOS::UR_TF_AccountSupply patron false))
            (m (ref-TS01-C3::SWP|C_AddIcedLiquidity patron patron pool amounts))
        )
        (map print
            [
                (format "<<SWP-I23>> predicted={} real={}"
                    [predicted (- ignis-before (ref-DALOS::UR_TF_AccountSupply patron false))])
                (expect "<<SWP-I23>> INFO_SWP|AddIcedLiquidity's quote equals what the op actually charged"
                    (- ignis-before (ref-DALOS::UR_TF_AccountSupply patron false)) predicted)
                (expect "<<SWP-I23>> ...and it is a real, non-zero charge"
                    true (> (- ignis-before (ref-DALOS::UR_TF_AccountSupply patron false)) 0.0))
                ;;the OTHER branch of the 2026-09-14 tax declaration (<<SWP-I14>>). The equality above
                ;;proves this shape takes no asymmetry tax; this proves the preview SAYS so, rather
                ;;than staying silent the way all six previews used to. Together with <<SWP-I14>> it
                ;;pins both arms of `UC_LiquidityTaxDeclaration`, so a flag flip on any variant changes
                ;;one of these two blocks.
                (expect "<<SWP-I23>> ...and the preview states plainly that there is NO asymmetry tax"
                    true (contains "No Asymmetric-Liquidity TAX" (concat (at "pre-text" info))))
            ]
        )
    )
    ""
)
(env-sigs [])
(rollback-tx)

