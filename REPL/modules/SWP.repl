(begin-tx "SWP-G23 -- the amplifier is a STABLE-pool-only parameter")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(namespace "ouronet-ns")
;;==== SWP-G23 -- the amplifier is a STABLE-pool-only parameter · 01 · env-sigs (caps) ==== =======
(print "--- [SWP-G23 -- the amplifier is a STABLE-pool-only parameter · 01 · env-sigs (caps)] ---")
(env-sigs [{ "key": "PK_AncientHodler", "caps": [] } { "key": "PK_AOZ", "caps": [] }])
(print "--- [SWP-G23 . 01 . amplifier on a product pool vs a stable pool] ---")
;;SWP|S>UPDATE-AMPLIFIER's "Amplifier can only be updated for Stable Pools" was UNPINNED. It needs
;;a NON-stable pool, which this suite already has -- no fixture, just the right argument. That is
;;what the cost-split of the worklist is for: 57 of the 163 live unpinned guards sit in functions
;;the suite already calls.
;;
;;The mechanism is a sentinel again: a non-stable pool stores amplifier -1.0, and the guard is
;;`(> current-amp 0.0)`. So "is this a stable pool" is answered by the amplifier's own sign rather
;;than by the pool-type letter -- asserted below, because those are two different things that
;;happen to agree, and a reader would reasonably assume the letter is what is checked.
(let* ((pools:[string] (SWP.URC_Swpairs))
       (pp:string (at 0 (filter (lambda (s:string) (= "P" (take 1 s))) pools)))
       (sp:string (at 0 (filter (lambda (s:string) (= "S" (take 1 s))) pools)))
       (original:decimal (SWP.UR_Amplifier sp)))
    (map print
        [
            ;;the sentinel, stated: a product pool's amplifier is -1.0, not 0 and not absent
            (expect "<<SWP-G23>> a product pool carries the -1.0 amplifier sentinel"
                -1.0 (SWP.UR_Amplifier pp))
            (expect "<<SWP-G23>> ...while a stable pool carries a positive one"
                true (> original 0.0))
            ;;and the guard keys on that sign
            (expect-failure "<<SWP-G23>> updating the amplifier of a PRODUCT pool is refused"
                "Amplifier can only be updated for Stable Pools"
                (TS01-C3.SWP|C_UpdateAmplifier KST.AOZT (SWP.UR_OwnerKonto pp) pp 50.0))
        ]
    )
    ;;the contrast, so this is not satisfied by a function that refuses every pool
    (TS01-C3.SWP|C_UpdateAmplifier KST.ANHD (SWP.UR_OwnerKonto sp) sp 50.0)
    (let ((updated:decimal (SWP.UR_Amplifier sp)))
        (TS01-C3.SWP|C_UpdateAmplifier KST.ANHD (SWP.UR_OwnerKonto sp) sp original)
        (map print
            [
                (expect "<<SWP-G23>> ...while a STABLE pool accepts the same call"
                    50.0 updated)
                ;;restored: this is shared pool state and a 50.0 amplifier would re-price every
                ;;later swap through this pair
                (expect "<<SWP-G23>> ...and the original amplifier is restored afterwards"
                    original (SWP.UR_Amplifier sp))
                (expect "<<SWP-G23>> ...with the original differing from the probe, so the restore mattered"
                    true (!= original 50.0))
            ]
        )
    )
)
(commit-tx)

