(begin-tx "SWP-G7 — SWPL liquidity-shape validators, and the mixed-sign list that used to pass")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
;;==== SWP-G7 — SWPL liquidity-shape validators, and the mixed-sign list that used to pass · 01 · namespace ==== 
(print "--- [SWP-G7 — SWPL liquidity-shape validators, and the mixed-sign list that used to pass · 01 · namespace] ---")
(namespace "ouronet-ns")
(print "--- [SWP-G7 · 01 · the SWPL URCv_ band] ---")
;;URCv_AreAmountsBalanced carries a history worth pinning. Its @doc records that the check used
;;to be sum-only, and a mixed-sign list like [-5.0, 10.0] passed it clean — sum 5.0 > 0 — while
;;containing a negative deposit. A per-element non-negative check was added alongside the sum.
;;
;;Both guards are asserted here, and they must be tripped by DIFFERENT inputs or the second one
;;is untested: an all-zero list trips the sum, and a mixed-sign list whose sum is still POSITIVE
;;is the only shape that reaches the per-element rule. That mixed-sign case is precisely the
;;regression the fix was written for, so it is now a standing test rather than a comment.
;;==== SWP-G7 — SWPL liquidity-shape validators, and the mixed-sign list that used to pass · 02 · let / invocation ==== 
(print "--- [SWP-G7 — SWPL liquidity-shape validators, and the mixed-sign list that used to pass · 02 · let / invocation] ---")
(let
    (
        (ref-SWPL:module{SwapperLiquidityV2} SWPL)
        (pool:string "S|DLK-98c486052a51|OURO-98c486052a51|DWK-98c486052a51")
    )
    (map print
        [
            ;;happy path: a genuinely balanced vector. "Balanced" here does NOT mean "all sides
            ;;funded" — it means the vector matches the pools own reserve ratio, so it is derived
            ;;from URC_BalancedLiquidity rather than guessed. A hand-picked [1.0 1.0 1.0] reads
            ;;balanced and is not, which is exactly the confusion this assertion exists to fix.
            (expect "<<SWP-G7>> the pools OWN balanced vector is recognised as balanced"
                true (ref-SWPL::URCv_AreAmountsBalanced pool
                        (ref-SWPL::URC_BalancedLiquidity pool "DLK-98c486052a51" 1.0 false)))
            ;;...and a fully-funded but DISPROPORTIONATE deposit is unbalanced — an answer, not a
            ;;rejection. The difference between "false" and "throws" is this functions contract.
            (expect "<<SWP-G7>> a funded but disproportionate deposit is UNbalanced (false, not a throw)"
                false (ref-SWPL::URCv_AreAmountsBalanced pool [1.0 1.0 1.0]))
            (expect "<<SWP-G7>> a deposit with a zero side is UNbalanced too"
                false (ref-SWPL::URCv_AreAmountsBalanced pool [1.0 0.0 1.0]))
            ;;--- guard 1: nothing was actually deposited
            (expect-failure "<<SWP-G7>> an all-zero deposit is refused outright"
                "At least a single input value must be greater than zero"
                (ref-SWPL::URCv_AreAmountsBalanced pool [0.0 0.0 0.0]))
            ;;--- guard 2: the regression. Sum is POSITIVE, so guard 1 passes and this is the
            ;;only guard left to catch it.
            (expect-failure "<<SWP-G7>> a mixed-sign deposit with a positive SUM is still refused"
                "No input amount may be negative"
                (ref-SWPL::URCv_AreAmountsBalanced pool [-5.0 10.0 1.0]))
            ;;--- URCv_CustomLpBreakAmounts: ONE message, TWO independent failure modes folded
            ;;into a single enforce. Both are exercised, because a folded enforce that only ever
            ;;gets tripped one way leaves the other conjunct untested and indistinguishable.
            (expect "<<SWP-G7>> breaking half the LP supply returns one amount per pool token"
                3 (length (ref-SWPL::URCv_CustomLpBreakAmounts pool [100.0 100.0 100.0] 100.0 50.0)))
            (expect "<<SWP-G7>> breaking the ENTIRE supply returns the supplies themselves"
                [100.0 100.0 100.0]
                (ref-SWPL::URCv_CustomLpBreakAmounts pool [100.0 100.0 100.0] 100.0 100.0))
            (expect-failure "<<SWP-G7>> mode A: breaking MORE LP than exists is refused"
                "Invalid Input Data for Break LP Computation"
                (ref-SWPL::URCv_CustomLpBreakAmounts pool [100.0 100.0 100.0] 100.0 101.0))
            (expect-failure "<<SWP-G7>> mode B: a supply vector that doesnt match the pools arity"
                "Invalid Input Data for Break LP Computation"
                (ref-SWPL::URCv_CustomLpBreakAmounts pool [100.0 100.0] 100.0 50.0))
        ]
    )
    ""
)
(commit-tx)

