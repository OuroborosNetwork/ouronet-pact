(begin-tx "SWP-I32 — INFO_SWP|UpdateAmplifier quote vs measured charge")
(env-gasmodel "table")(env-gaslimit 100000000)(env-gas 0)
(namespace "ouronet-ns")
(print "--- [SWP-I32 · 01 · re-amplify a stable pool] ---")
;;FUNCTION COVERAGE (G6) — `INFO_SWP|UpdateAmplifier`, per the owner's spec. Template:
;;`modules/ATS.repl <<ATS-I1>>`; the patron/interactor hazard is written out at <<SWP-I2>>.
;;
;;STABLE POOLS ONLY. `<<SWP-G23>>` pins the refusal on every other prefix — the amplifier is the
;;constant-sum weight of a stable curve and simply does not exist on a `W|` or `P|` pool. `S|DLK|OURO|DWK`
;;is the file's stable pool, and the whole block rolls back so its live amplifier is untouched: the
;;value is load-bearing for `[6.3]_SWP`'s swap expectations downstream.
;;The new amplifier is DERIVED by doubling the current one rather than written as a literal, so the
;;block cannot silently become a no-op if an earlier suite re-amplifies the pool.
(env-sigs [{ "key": "PK_AncientHodler", "caps": [] }])
(let
    (
        (ref-TS01-C3:module{TalosStageOne_ClientThreeV4} TS01-C3)
        (ref-SWP:module{SwapperV4} SWP)
        (ref-DALOS:module{OuronetDalosV2} DALOS)
        (sd:string "S|DLK-98c486052a51|OURO-98c486052a51|DWK-98c486052a51")
        (patron:string KST.ANHD)
    )
    (let
        (
            (amp-before:decimal (ref-SWP::UR_Amplifier sd))
        )
        (let
            (
                (new-amp:decimal (* 2.0 amp-before))
                (predicted:object{OuronetInfoV2.ClientInfo}
                    (INFO-ONE.INFO_SWP|UpdateAmplifier patron sd (* 2.0 amp-before)))
                (ignis-before:decimal (ref-DALOS::UR_TF_AccountSupply patron false))
            )
            (let
                (
                    (m (ref-TS01-C3::SWP|C_UpdateAmplifier patron (SWP.UR_OwnerKonto sd) sd new-amp))
                )
                (map print
                    [
                        (format "<<SWP-I32>> amp {} -> {} ; predicted={} real={}"
                            [amp-before new-amp (at "ignis-need" (at "ignis" predicted))
                             (- ignis-before (ref-DALOS::UR_TF_AccountSupply patron false))])
                        (expect "<<SWP-I32>> INFO_SWP|UpdateAmplifier's quote equals what the op actually charged"
                            (- ignis-before (ref-DALOS::UR_TF_AccountSupply patron false))
                            (at "ignis-need" (at "ignis" predicted)))
                        (expect "<<SWP-I32>> ...and it is a real, non-zero charge"
                            true (> (- ignis-before (ref-DALOS::UR_TF_AccountSupply patron false)) 0.0))
                        ;;witness — the amplifier really moved, so the quote is not for a no-op
                        (expect "<<SWP-I32>> ...witness: the pool's amplifier really changed"
                            new-amp (ref-SWP::UR_Amplifier sd))
                    ]
                )
            )
        )
    )
    ""
)
(env-sigs [])
(rollback-tx)

