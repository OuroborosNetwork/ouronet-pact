(begin-tx "SWP-G24 — BRD's branding-flag hierarchy, reached through the SWP upgrade client")
(env-gasmodel "table")(env-gaslimit 150000000)(env-gas 0)
(namespace "ouronet-ns")
(print "--- [SWP-G24 · 01 · the flag hierarchy and the months bound] ---")
;;FIVE unpinned guards, all in 04_BRD.pact, none of them previously reachable from any suite -- because
;;BRD has no client of its own for them. `BRD|C>UPGRADE` is acquired only by `XE_UpgradeBranding`, and
;;that is called from SWP (15_SWP.pact:2048) and ATS (08_ATS.pact:2918). So the way in is a SWP pair's
;;branding, which is why these live here rather than in a BRD harness.
;;
;;The flags form a hierarchy: 0 Golden, 1 Blue (premium), 2 Green, 3 Gray, 4 Red. Upgrading means
;;"become Blue", so the two ends of the hierarchy refuse -- Golden is ABOVE Blue, Red is excluded --
;;and that is two of the five guards. `BRD|A_SetFlag` is a real admin client, so the flag can be moved
;;to each rejecting value and back without touching a table: no module admin needed here, just the
;;admin signer the operation already requires. The transaction still ends in rollback-tx, with SWP-G25
;;as the leakage check, because the upgrade at the end mints premium time and spends STOA.
;;==== SWP-G24 — BRD's branding-flag hierarchy, reached through the SWP upgrade client · 01 · env-sigs (caps) ==== 
(print "--- [SWP-G24 — BRD's branding-flag hierarchy, reached through the SWP upgrade client · 01 · env-sigs (caps)] ---")
(env-sigs
    [ { "key": "PK_AncientHodler", "caps": [] }
      ;;the upgrade is priced in STOA and settled as coin transfers, so the managed caps have to be in
      ;;scope or the successful case dies in `coin.TRANSFER` long before BRD's own guards. There is
      ;;more than one leg -- the fee is SPLIT -- which the first attempt found the hard way: granting
      ;;only the first receiver got past one transfer and failed on the next, for 57.375 to a
      ;;different key. Both legs are granted here with headroom rather than exact amounts, because the
      ;;split is a pricing detail and pinning it would make this test fail on every price change.
      { "key": "6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263"
      , "caps":
        [ (coin.TRANSFER "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263"
                         "k:0cb30c0121ff919266121a99ff9359871818932211df94dae4137c29bc0e8f7e" 1000.0)
          (coin.TRANSFER "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263"
                         "k:50d6c59b21e5e6e55baecaa75a1007de37576bde12d8230dc82459cc01b9484b" 1000.0)
          (coin.TRANSFER "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263"
                         "c:XM-pkmuB5XUQlp87ZYSbfKt8qzmHY6O2EHAzMRVBt3k" 1000.0)
          (coin.TRANSFER "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263"
                         "c:iQQFWj6gWtpGEzhM_O5ekW1QtnQQy55R8BRPGhj_0FU" 1000.0) ] } ])
;;==== SWP-G24 — BRD's branding-flag hierarchy, reached through the SWP upgrade client · 02 · let / invocation ==== 
(print "--- [SWP-G24 — BRD's branding-flag hierarchy, reached through the SWP upgrade client · 02 · let / invocation] ---")
(let ((sp:string "S|DLK-98c486052a51|OURO-98c486052a51|DWK-98c486052a51"))
    (map print
        [
            ;;the starting state, asserted because every refusal below is a statement about the flag
            (expect "<<SWP-G24>> the pair starts on a GRAY flag (3), which IS upgradable"
                3 (BRD.UR_Flag sp false))
            (expect "<<SWP-G24>> ...and ANHD's elite tier allows at most 3 months per upgrade"
                3 (BRD.URC_MaxBluePayment KST.ANHD))
            ;;GUARD 1 -- BRD|C>ADMIN_SET, the flag DOMAIN. `(contains flag (enumerate 0 4))`, so 5 is
            ;;out of range. The enforce is the FIRST statement in the defcap, before the admin compose,
            ;;so it answers even though the call is an admin one.
            (expect-failure "<<SWP-G24>> a flag outside 0..4 is refused by the setter"
                "Invalid Integer Flag"
                (TS01-A.BRD|A_SetFlag KST.ANHD sp 5))
            ;;GUARD 2 -- the months bound, read from the caller's elite tier rather than a constant.
            ;;99 months exceeds any tier's allowance.
            (expect-failure "<<SWP-G24>> more months than the owner's tier allows is refused"
                "Invalid Months Integer"
                (TS01-C3.SWP|C_UpgradeBranding KST.ANHD (SWP.UR_OwnerKonto sp) sp 99))
            ;;...and the bound is the tier value itself, not some larger cap: one over it fails too.
            (expect-failure "<<SWP-G24>> ...and the bound is exactly the tier allowance, not a looser cap"
                "Invalid Months Integer"
                (TS01-C3.SWP|C_UpgradeBranding KST.ANHD (SWP.UR_OwnerKonto sp) sp
                    (+ 1 (BRD.URC_MaxBluePayment KST.ANHD))))
        ]
    )
    ;;GUARD 3 -- GOLDEN is above Blue in the hierarchy, so "upgrading" it would be a demotion.
    (TS01-A.BRD|A_SetFlag KST.ANHD sp 0)
    (print
        (expect-failure "<<SWP-G24>> a GOLDEN flag cannot be upgraded -- Blue is below it"
            "Golden Flag cannot be upgraded"
            (TS01-C3.SWP|C_UpgradeBranding KST.ANHD (SWP.UR_OwnerKonto sp) sp 1)))
    ;;GUARD 4 -- RED is the excluded flag; it is not a rung on the ladder at all.
    (TS01-A.BRD|A_SetFlag KST.ANHD sp 4)
    (print
        (expect-failure "<<SWP-G24>> ...and a RED flag cannot be upgraded either"
            "Red Flag cannot be upgraded"
            (TS01-C3.SWP|C_UpgradeBranding KST.ANHD (SWP.UR_OwnerKonto sp) sp 1)))
    (print "--- [SWP-G24 · 02 · the 15-day rule, created by a successful upgrade] ---")
    ;;GUARD 5 is the interesting one: it cannot be reached without FIRST succeeding. A Blue flag may be
    ;;extended only when less than 15 days of premium remain, so the refusal needs premium time on the
    ;;clock -- and the only thing that puts it there is an upgrade. So the success IS the fixture.
    ;;
    ;;GREEN (2) is upgradable, so the pair is moved there and upgraded for 1 month = 30 days of
    ;;premium. With both BRD fixes in place that lands premium 30 days in the FUTURE, which is what
    ;;finally makes guard 5 reachable -- the immediate second attempt then has ~30 days remaining,
    ;;over the 15-day threshold, and the guard answers.
    (TS01-A.BRD|A_SetFlag KST.ANHD sp 2)
    ;;PIN THE CLOCK, and here is why -- it is a consequence of FIX 1 worth knowing.
    ;;
    ;;Now that <premium-until> is the entity's ISSUANCE time rather than a module-load constant, it
    ;;is a real point on the suite's timeline. And that timeline is NOT monotonic: each loaded file
    ;;sets its own `env-chain-data`, so the block-time at THIS transaction can be EARLIER than the
    ;;one at which [6.3]_SWP issued the pair. The first run after the fix hit exactly that -- the
    ;;pair looked like it had months of premium left, and the upgrade was refused by guard 5 before
    ;;the lapsed case could be reached at all.
    ;;
    ;;A real chain cannot run backwards; a REPL can. So the fixture is the clock: set it 100 days
    ;;past the pair's OWN genesis, which makes "lapsed" true by construction and independent of
    ;;whatever the previously loaded file left behind. Restored at the end, and asserted.
    (let
        (
            (inherited:time (at "block-time" (chain-data)))
            (genesis:time (BRD.UR_Genesis sp false))
        )
        (env-chain-data { "block-time": (add-time genesis 8640000.0) })
        (let
            (
                (before:time (BRD.UR_PremiumUntil sp false))
                (now:time (at "block-time" (chain-data)))
            )
            (map print
                [
                    ;;FIX 1 (04_BRD.pact, XE_Issue) -- <genesis> and <premium-until> are stamped PER
                    ;;ISSUANCE. They used to come straight from the BRD|DEFAULT `defconst`, and Pact
                    ;;evaluates a defconst ONCE AT MODULE LOAD -- so every entity ever issued
                    ;;inherited BRD's own DEPLOY timestamp as its birth date, identical for all.
                    ;;
                    ;;On this chain the old value was the EPOCH, because nothing had set chain-data
                    ;;when BRD loaded; on a live chain it was the deploy date. The discriminator used
                    ;;here is that a genesis after 2000 can only have come from the issuance.
                    (expect "<<SWP-G24>> genesis is the pair's own issuance time, not BRD's deploy time"
                        true (> (diff-time genesis (time "2000-01-01T00:00:00Z")) 0.0))
                    ;;<premium-until> deliberately does NOT follow genesis. A fresh entity has never
                    ;;held premium, and BRD|NO_PREMIUM (1970-01-01) says exactly that at a fixed point
                    ;;no clock can overtake. Stamping it with the issuance time instead would read as
                    ;;"premium expired this instant" -- a different claim, and one whose truth depends
                    ;;on when the row happened to be written. That distinction is not academic: this
                    ;;suite's simulated clock runs BACKWARDS between files, so an issuance-stamped
                    ;;premium made fresh entities look months-premium to earlier transactions and
                    ;;refused three upgrades that had always worked. The sentinel is clock-proof.
                    (expect "<<SWP-G24>> ...while premium-until is the NO_PREMIUM sentinel, not the issuance time"
                        true (and (= before (time "1970-01-01T00:00:00Z"))
                                  (!= before genesis)))
                    ;;...so the premium is LAPSED going in -- the input FIX 2 exists for, and the state
                    ;;every never-upgraded entity is in, on any chain, at any clock.
                    (expect "<<SWP-G24>> ...so the premium is LAPSED going into the upgrade"
                        true (< (diff-time before now) 0.0))
                ]
            )
            (TS01-C3.SWP|C_UpgradeBranding KST.ANHD (SWP.UR_OwnerKonto sp) sp 1)
            (map print
                [
                    (expect "<<SWP-G24>> the upgrade moved the pair to a BLUE flag (1)"
                        1 (BRD.UR_Flag sp false))
                    ;;FIX 2 (04_BRD.pact, XE_UpgradeBranding) -- the extension base is CLAMPED TO NOW
                    ;;when the premium has lapsed. It used to be `(add-time premium seconds)` flat,
                    ;;measuring 30 days from a date already gone: the buyer paid and received a BLUE
                    ;;flag with ZERO usable premium. This assertion INVERTED with the fix -- it used
                    ;;to read "premium-until is STILL in the past after paying".
                    (expect "<<SWP-G24>> a month bought on a LAPSED premium now runs 30 days from NOW"
                        2592000.0 (diff-time (BRD.UR_PremiumUntil sp false) now))
                    (expect "<<SWP-G24>> ...so the BLUE flag is backed by premium the entity really has"
                        true (> (diff-time (BRD.UR_PremiumUntil sp false)
                                           (at "block-time" (chain-data))) 0.0))
                    ;;...and measured from NOW, not from the old stamp. Without this the assertion
                    ;;above would also hold if the clamp had been written "ignore the stored value
                    ;;always" -- the opposite error, which would confiscate a renewal's remaining
                    ;;days. The old stamp is the 1970 sentinel, so the two are decades apart.
                    (expect "<<SWP-G24>> ...and NOT 30 days from the old lapsed stamp"
                        true (> (diff-time (BRD.UR_PremiumUntil sp false)
                                           (add-time before 2592000.0)) 0.0))
                    ;;GUARD 5, REACHABLE FOR THE FIRST TIME. It was unpinnable while FIX 2 stood:
                    ;;premium was always behind the clock, `remaining` was always negative, the guard
                    ;;always passed, and a user could pay again and again. On this chain it would
                    ;;have taken ~660 paid upgrades to climb from 1970 to the suite's clock.
                    ;;One fix, one guard off the worklist.
                    (expect-failure "<<SWP-G24>> a Blue flag with over 15 days left cannot be extended again"
                        "Blue Flag has more than 15 days remainig!"
                        (TS01-C3.SWP|C_UpgradeBranding KST.ANHD (SWP.UR_OwnerKonto sp) sp 1))
                ]
            )
            (print "--- [SWP-G24 · 03 · a LIVE subscription renews without losing its days] ---")
            ;;THE OTHER BRANCH OF THE CLAMP. FIX 2 must not become "always extend from now" -- that
            ;;is the mirror-image bug, silently discarding whatever premium was left at renewal. The
            ;;`if` keeps the stored date whenever it is still ahead of the clock, and this is the
            ;;case that proves it.
            ;;
            ;;Moving the CLOCK rather than the data: 20 days on leaves 10 days of premium, under the
            ;;15-day threshold, so the renewal is permitted.
            (env-chain-data { "block-time": (add-time now 1728000.0) })
            (map print
                [
                    (expect "<<SWP-G24>> 20 days on, the pair has 10 days of premium left"
                        864000.0 (diff-time (BRD.UR_PremiumUntil sp false)
                                            (at "block-time" (chain-data))))
                    (expect "<<SWP-G24>> ...which is under the threshold, so the renewal is allowed"
                        true (!= "" (TS01-C3.SWP|C_UpgradeBranding KST.ANHD (SWP.UR_OwnerKonto sp) sp 1)))
                    ;;the renewal added 30 days to the STORED date, not to now -- so the entity keeps
                    ;;its 10 remaining days PLUS the 30 it just bought, 40 in total. Had the clamp
                    ;;been unconditional this would read 30, and the 10 days would be confiscated.
                    (expect "<<SWP-G24>> ...and it kept its 10 remaining days, for 40 -- no time lost"
                        3456000.0 (diff-time (BRD.UR_PremiumUntil sp false)
                                             (at "block-time" (chain-data))))
                ]
            )
            ;;undo the 20-day shift before leaving the inner scope. (The first version of this test
            ;;asserted the shift was undone WITHOUT undoing it, and the assertion caught it -- which
            ;;is the argument for asserting a restore rather than trusting it.)
            (env-chain-data { "block-time": now })
            (print
                (expect "<<SWP-G24>> the 20-day shift is undone"
                    now (at "block-time" (chain-data))))
        )
        ;;...and the pinned clock is put back, so SWP-G25 and anything appended after this file sees
        ;;the timeline it was written against.
        (env-chain-data { "block-time": inherited })
        (print
            (expect "<<SWP-G24>> ...and the pinned clock is restored to what this file inherited"
                inherited (at "block-time" (chain-data))))
    )
    ""
)
(env-sigs [])
;;this tx moved the flag four times, spent STOA and minted premium time
(rollback-tx)

;;|| NEXT >
;;
(begin-tx "SWP-G25 — the branding fixture left no trace")
(namespace "ouronet-ns")
(print "--- [SWP-G25 · 01 · no leakage] ---")
;;SWP-G24 left the pair on a BLUE flag with a month of paid premium and moved STOA out of ANHD's
;;account. Committing it would hand every later branding or pricing assertion a premium pair, and the
;;STOA balance would be short by the upgrade fee with nothing naming this transaction.
(let ((sp:string "S|DLK-98c486052a51|OURO-98c486052a51|DWK-98c486052a51"))
    (map print
        [
            (expect "<<SWP-G25>> the pair is back on its original GRAY flag"
                3 (BRD.UR_Flag sp false))
            ;;premium-until is back to the BRD|NO_PREMIUM sentinel, so every paid upgrade in SWP-G24 is
            ;;gone. Asserted against the sentinel rather than against "in the past" -- "in the past"
            ;;would still hold if one upgrade had leaked through, since an upgrade from the sentinel
            ;;lands 30 days after a clock that is itself long past by the end of this file.
            (expect "<<SWP-G25>> ...and premium-until is back to the NO_PREMIUM sentinel"
                (time "1970-01-01T00:00:00Z") (BRD.UR_PremiumUntil sp false))
        ]
    )
    ""
)
(commit-tx)

;;|| NEXT >
;;
(begin-tx "SWP-G26 — removing a token that was never a principal")
(env-gasmodel "table")(env-gaslimit 150000000)(env-gas 0)
(namespace "ouronet-ns")
;;==== SWP-G26 — removing a token that was never a principal · 01 · env-sigs (caps) ==== ==========
(print "--- [SWP-G26 — removing a token that was never a principal · 01 · env-sigs (caps)] ---")
(env-sigs [{ "key": "PK_AncientHodler", "caps": [] }])
(print "--- [SWP-G26 · 01 · the remove branch's membership check] ---")
;;`SWP|C>PRINCIPAL` has two branches, and the remove side opens with `(contains principal current)`.
;;Argument-domain -- but the token must EXIST, because an id-existence check fronts the whole capability.
;;The first attempt passed a token this chain does not have and got "DPTF ID MOCKA-… does not exist",
;;which is a different guard: "not a principal" and "not a token" are distinct failures and only the
;;first is what this pins.
;;==== SWP-G26 — removing a token that was never a principal · 02 · let / invocation ==== =========
(print "--- [SWP-G26 — removing a token that was never a principal · 02 · let / invocation] ---")
(let
    (
        (ref-SWP:module{SwapperV4} SWP)
        (ref-TS01-A:module{TalosStageOne_AdminV2} TS01-A)
        (tok:string "AURYN-98c486052a51")
    )
    (map print
        [
            ;;the premise: AURYN is a real DPTF on this chain and is NOT in the principal set
            (expect "<<SWP-G26>> AURYN exists as a DPTF but is not a principal"
                false (contains tok (ref-SWP::UR_Principals)))
            (expect "<<SWP-G26>> ...while OURO is one, so the set is populated and the check is live"
                true (contains "OURO-98c486052a51" (ref-SWP::UR_Principals)))
            (expect-failure "<<SWP-G26>> removing a token that was never a principal is refused"
                "AURYN-98c486052a51 is not currently a principal"
                (ref-TS01-A::SWP|A_UpdatePrincipal KST.ANHD tok false))
            ;;...and the ADD branch refuses the opposite case, which locates the two branches against
            ;;each other: the same capability, the same token set, opposite polarity.
            (expect-failure "<<SWP-G26>> ...and ADDING one that already is, is refused too"
                "OURO-98c486052a51 is already a principal"
                (ref-TS01-A::SWP|A_UpdatePrincipal KST.ANHD "OURO-98c486052a51" true))
        ]
    )
    ""
)
(env-sigs [])
(commit-tx)

;;|| NEXT >
;;|| SWPX-10 — the defpact drift guard: pool state must not move between step 0 and step 1.
;;
(begin-tx "SWPX-10a - MTX add-liquidity defpact, step 0|2")
(env-gasmodel "table")(env-gaslimit 100000000)(env-gas 0)
(namespace "ouronet-ns")
;;==== SWPX-10a - MTX add-liquidity defpact, step 0|2 · 01 · env-sigs (caps) ==== =================
(print "--- [SWPX-10a - MTX add-liquidity defpact, step 0|2 · 01 · env-sigs (caps)] ---")
(env-sigs [{ "key": "PK_AncientHodler", "caps": [] }])
(print "--- [SWPX-10a · 01 · begin the pact] ---")
;;`20_MTX-SWP.pact:524` -- and the SAME message at :671 (frozen) and :803 (sleeping), so the three
;;are one rule expressed three times.
;;
;;WHAT IT PROTECTS. `MTX|C_AddLiquidity` is a DEFPACT: step 0 quotes the pool and stores the state
;;it quoted against, step 1 executes. Between them the world can move -- another user's swap, an
;;owner reweight -- and executing a quote against a pool that has since changed is how a liquidity
;;provider silently gets a worse ratio than the one they agreed to. Step 1 re-reads the state and
;;refuses if it differs.
;;
;;THE MUTATION IS A REAL OWNER OPERATION, not a forced write. `UR_PoolState` composes amplifier,
;;fees, token supplies, **weights**, LP capacity and the special-fee targets -- so `C_ModifyWeights`
;;(pinned by SWPX-02d above) moves it through the front door. That makes this the exact production
;;scenario: the owner reweights while a provider's add is mid-flight.
;;==== SWPX-10a - MTX add-liquidity defpact, step 0|2 · 02 · let / invocation ==== ================
(print "--- [SWPX-10a - MTX add-liquidity defpact, step 0|2 · 02 · let / invocation] ---")
(let
    (
        (ref-TS01-CP:module{TalosStageOne_ClientPactsV4} TS01-CP)
        (ref-U|SWP:module{UtilitySwpV2} U|SWP)
        (toks:[string] ["DLK-98c486052a51" "BUSD-98c486052a51" "TUSD-98c486052a51" "USDC-98c486052a51"])
    )
    (ref-TS01-CP::SWP|C_AddStandardLiquidity KST.ANHD KST.ANHD
        (ref-U|SWP::UC_PoolID toks [0.4 0.2 0.2 0.2] -1.0)
        [10.0 10.0 10.0 10.0])
)
(commit-tx)

;;|| NEXT >
;;
(begin-tx "SWPX-10b - move the pool underneath the open pact, then continue")
(env-gasmodel "table")(env-gaslimit 100000000)(env-gas 0)
(namespace "ouronet-ns")
;;==== SWPX-10b - move the pool underneath the open pact, then continue · 01 · env-sigs (caps) ==== 
(print "--- [SWPX-10b - move the pool underneath the open pact, then continue · 01 · env-sigs (caps)] ---")
(env-sigs [{ "key": "PK_AncientHodler", "caps": [] }])
(print "--- [SWPX-10b · 01 · the pool moves, and step 1 refuses] ---")
;;==== SWPX-10b - move the pool underneath the open pact, then continue · 02 · let / invocation ==== 
(print "--- [SWPX-10b - move the pool underneath the open pact, then continue · 02 · let / invocation] ---")
(let
    (
        (ref-SWP:module{SwapperV4} SWP)
        (ref-U|SWP:module{UtilitySwpV2} U|SWP)
        (ref-TS01-C3:module{TalosStageOne_ClientThreeV4} TS01-C3)
        (toks:[string] ["DLK-98c486052a51" "BUSD-98c486052a51" "TUSD-98c486052a51" "USDC-98c486052a51"])
    )
    (let
        (
            (wp:string (ref-U|SWP::UC_PoolID toks [0.4 0.2 0.2 0.2] -1.0))
        )
        ;;the owner reweights -- legitimate, and it changes a field PoolState is built from
        (ref-TS01-C3::SWP|C_ModifyWeights KST.ANHD (SWP.UR_OwnerKonto wp) wp [0.25 0.25 0.25 0.25])
        (map print
            [
                (expect "<<SWPX-10>> the pool has moved since the pact quoted it"
                    [0.25 0.25 0.25 0.25] (ref-SWP::UR_Weigths wp))
                ;;THE ITEM. The pact id is the REPL's constant -- see the note in SWPX-01b: every
                ;;defpact here reports the same id, so the literal is stable rather than a hash that
                ;;shifts when transactions move.
                (expect-failure "<<SWPX-10>> step 1 refuses to execute against the altered pool"
                    "Execution Step of Adding Liquidity cannot execute on altered pool state!"
                    (continue-pact 1 false "2n12TVKIdyigszwESxXUSOkAtK48XfsKcVoUGxWYSSE"))
                ;;CONTRAST, and it is what makes this a DRIFT check rather than "step 1 is broken":
                ;;put the weights back and the identical continuation stops hitting this guard. It
                ;;does not then SUCCEED -- this pool has liquidity operations switched off, so the
                ;;failure lands on the next gate down. Stating it as a different named error is the
                ;;honest form: the guard under test is proven to pass without claiming the whole add
                ;;works. (The first draft asserted success here and the run said otherwise, which is
                ;;how the disabled flag was found -- step 0 does not check it, step 1 does.)
                (expect-failure "<<SWPX-10>> ...and once the pool is restored, the drift guard stops answering"
                    "Adding|Removing Liquidity isn't enabled on pool"
                    (let ((restore (ref-TS01-C3::SWP|C_ModifyWeights KST.ANHD (SWP.UR_OwnerKonto wp) wp [0.4 0.2 0.2 0.2])))
                        (continue-pact 1 false "2n12TVKIdyigszwESxXUSOkAtK48XfsKcVoUGxWYSSE")))
            ]
        )
        ""
    )
)
(env-sigs [])
;;everything here -- the reweights and the executed step -- is discarded
(rollback-tx)

;;|| NEXT >
;;|| SWPX-11 — the firestarter eligibility bound, both directions.
;;
(begin-tx "SWPX-11 - SWP|C_Firestarter only serves (almost) empty accounts")
(env-gasmodel "table")(env-gaslimit 100000000)(env-gas 0)
(namespace "ouronet-ns")
(env-sigs [{ "key": "PK_AncientHodler", "caps": [] }])
(print "--- [SWPX-11 · 01 · who may firestart] ---")
;;`04_TS01-C3.pact:833`. Firestarting seeds a brand-new account with enough OURO/IGNIS to transact
;;at all -- it is the bootstrap for someone who has nothing. So it is gated on the caller having
;;(almost) nothing: under 1.0 OURO and under 100.0 IGNIS. An account that can already pay its own
;;way does not need it, and letting it through would be a free top-up.
;;
;;THE PATRON IS THE NATURAL NEGATIVE. ANHD has funded every transaction in this file, so it is the
;;clearest possible "not empty" case -- and its balances are READ rather than assumed, so the test
;;states why it is ineligible instead of relying on it.
(let
    (
        (ref-DALOS:module{OuronetDalosV2} DALOS)
        (ref-DPTF:module{DemiourgosPactTrueFungibleV2} DPTF)
        (ref-TS01-C3:module{TalosStageOne_ClientThreeV4} TS01-C3)
    )
    (let
        (
            (ouro:string (ref-DALOS::UR_OuroborosID))
            (ignis:string (ref-DALOS::UR_IgnisID))
        )
        (map print
            [
                ;;the premise, read live: ANHD is over BOTH bounds, so either conjunct alone would
                ;;refuse it. That is worth knowing -- it means this assertion does not tell us WHICH
                ;;conjunct answered, only that the rule holds.
                (expect "<<SWPX-11>> the patron is over both bounds (>= 1 OURO and >= 100 IGNIS)"
                    [true true]
                    [(>= (ref-DPTF::UR_AccountSupply ouro KST.ANHD) 1.0)
                     (>= (ref-DPTF::UR_AccountSupply ignis KST.ANHD) 100.0)])
                (expect-failure "<<SWPX-11>> a funded account cannot firestart"
                    "Only empty or allmost empty Ouronet Accounts can firestart"
                    (ref-TS01-C3::SWP|C_Firestarter KST.ANHD))
            ]
        )
        ""
    )
)
(env-sigs [])
(commit-tx)

;;|| NEXT >
;;|| SWPX-12 — the special-fee-target count is bounded by the OWNER'S elite tier.
;;
(begin-tx "SWPX-12 - SPW|S>UPDATE_SPECIAL-FEE-TARGETS: how many targets a tier buys")
(env-gasmodel "table")(env-gaslimit 100000000)(env-gas 0)
(namespace "ouronet-ns")
;;==== SWPX-12 - SPW|S>UPDATE_SPECIAL-FEE-TARGETS: how many targets a tier buys · 01 · env-sigs (caps) ==== 
(print "--- [SWPX-12 - SPW|S>UPDATE_SPECIAL-FEE-TARGETS: how many targets a tier buys · 01 · env-sigs (caps)] ---")
(env-sigs [{ "key": "PK_AncientHodler", "caps": [] }])
(print "--- [SWPX-12 · 01 · the target-count bound, both ends] ---")
;;`15_SWP.pact:613`. The number of special fee targets a pool may carry is bounded by its OWNER'S
;;Major Elite Tier, not by the pool: tier 2 buys 2, tier 3 buys 3, tier 4 buys 4, tiers 5-7 buy 7,
;;anything else buys 1. The enforce is `(and (>= target-no 1) (<= target-no max))`, so BOTH ends can
;;refuse, and this drives both.
;;
;;THE MAX IS COMPUTED FROM THE LIVE TIER, not typed. ANHD is tier 7 here, which buys 7 -- so the
;;over-bound case needs EIGHT targets, and hardcoding a smaller number would pass and prove nothing.
;;Reading the tier and asserting the derived max first is what makes the count below meaningful.
;;==== SWPX-12 - SPW|S>UPDATE_SPECIAL-FEE-TARGETS: how many targets a tier buys · 02 · let / invocation ==== 
(print "--- [SWPX-12 - SPW|S>UPDATE_SPECIAL-FEE-TARGETS: how many targets a tier buys · 02 · let / invocation] ---")
(let
    (
        (ref-DALOS:module{OuronetDalosV2} DALOS)
        (ref-SWP:module{SwapperV4} SWP)
        (ref-U|SWP:module{UtilitySwpV2} U|SWP)
        (ref-TS01-C3:module{TalosStageOne_ClientThreeV4} TS01-C3)
        (toks:[string] ["DLK-98c486052a51" "BUSD-98c486052a51" "TUSD-98c486052a51" "USDC-98c486052a51"])
        (one:object{SwapperV4.FeeSplit} { "target" : KST.EMMA, "value" : 1 })
    )
    (let
        (
            (wp:string (ref-U|SWP::UC_PoolID toks [0.4 0.2 0.2 0.2] -1.0))
        )
        (map print
            [
                (expect "<<SWPX-12>> the pool's owner is the patron, at Major Elite Tier 7"
                    [KST.ANHD 7]
                    [(ref-SWP::UR_OwnerKonto wp) (ref-DALOS::UR_Elite-Tier-Major KST.ANHD)])
                ;;the BASELINE, asserted so the leakage check below has something true to compare
                ;;against. The pool is not empty of targets -- SWPX-02 issued it with one -- and the
                ;;first draft of SWPX-12b assumed zero and went red. Read the state; do not guess it.
                (expect "<<SWPX-12>> ...and it already carries exactly one special fee target"
                    1 (length (ref-SWP::UR_SpecialFeeTargets wp)))
                ;;LOWER END -- an EMPTY target list. "Special targets" with none of them is not a
                ;;configuration, it is a no-op, and the guard says so rather than writing an empty row.
                (expect-failure "<<SWPX-12>> an EMPTY target list is refused"
                    "Increase Major Elite Tier to add more Special Targets"
                    (ref-TS01-C3::SWP|C_UpdateSpecialFeeTargets KST.ANHD (SWP.UR_OwnerKonto wp) wp []))
                ;;UPPER END -- tier 7 buys 7, so EIGHT is one past the bound. The list is built with
                ;;make-list so the count is the only thing wrong with it.
                (expect-failure "<<SWPX-12>> ...and one MORE than the tier buys is refused"
                    "Increase Major Elite Tier to add more Special Targets"
                    (ref-TS01-C3::SWP|C_UpdateSpecialFeeTargets KST.ANHD (SWP.UR_OwnerKonto wp) wp (make-list 8 one)))
                ;;...and exactly AT the bound it is ACCEPTED. That is what makes the two refusals a
                ;;bound rather than a blanket rejection, and it puts the boundary where the tier table
                ;;says it is: tier 7 buys exactly 7, not 6 and not 8.
                (expect "<<SWPX-12>> ...while exactly 7 -- the tier's maximum -- is accepted"
                    true (!= "" (format "{}"
                        [(ref-TS01-C3::SWP|C_UpdateSpecialFeeTargets KST.ANHD (SWP.UR_OwnerKonto wp) wp (make-list 7 one))])))
                (expect "<<SWPX-12>> ...and the pool now carries all seven"
                    7 (length (ref-SWP::UR_SpecialFeeTargets wp)))
            ]
        )
        ""
    )
)
(env-sigs [])
;;the accepted 7-target write is discarded -- SWPX-12b checks it
(rollback-tx)

;;|| NEXT >
;;|| SWPX-12b — the accepted target write left no trace.
;;
(begin-tx "SWPX-12b - no leakage")
(namespace "ouronet-ns")
(print "--- [SWPX-12b · 01 · no leakage] ---")
;;Special fee targets redirect a slice of every swap fee on this pool. A leaked set would quietly
;;reroute fees in whatever test runs next, and nothing downstream asserts on them.
(let
    (
        (ref-U|SWP:module{UtilitySwpV2} U|SWP)
        (toks:[string] ["DLK-98c486052a51" "BUSD-98c486052a51" "TUSD-98c486052a51" "USDC-98c486052a51"])
    )
    (print
        (expect "<<SWPX-12b>> the pool is back to its single issued target, not the seven"
            1 (length (SWP.UR_SpecialFeeTargets (ref-U|SWP::UC_PoolID toks [0.4 0.2 0.2 0.2] -1.0)))))
)
(commit-tx)

;;|| NEXT >
;;|| SWPX-13 — swap cannot be enabled on a pool worth less than the inactive limit.
;;
(begin-tx "SWPX-13 - SPWU|C>TOGGLE-SWAP: the pool-worth floor")
(env-gasmodel "table")(env-gaslimit 100000000)(env-gas 0)
(namespace "ouronet-ns")
;;==== SWPX-13 - SPWU|C>TOGGLE-SWAP: the pool-worth floor · 01 · env-sigs (caps) ==== =============
(print "--- [SWPX-13 - SPWU|C>TOGGLE-SWAP: the pool-worth floor · 01 · env-sigs (caps)] ---")
(env-sigs [{ "key": "PK_AncientHodler", "caps": [] }])
(print "--- [SWPX-13 · 01 · the worth floor for enabling swap] ---")
;;`19_SWPU.pact:367`. A pool whose total value is at or below the INACTIVE LIMIT may not have swap
;;switched on: quoting swaps against a near-empty pool gives wild prices, so the pool stays inactive
;;until it is worth trading against. Note the rule is one-sided -- the `if toggle` means switching
;;swap OFF is never gated, which is correct (you can always retire a pool).
;;
;;NO POOL IN THIS SUITE IS BELOW THE FLOOR -- all 112 pairs are worth more than 100.0 WSTOA, measured
;;by enumerating the pair table rather than sampling. So the state has to be produced, and there are
;;two ways: drain a pool, or RAISE THE LIMIT. Raising the limit is the better one and not just the
;;cheaper one: `inactive-limit` is a single governance-set field and raising it is exactly the
;;operational lever this rule exists to serve, whereas rewriting a pool's supplies would fabricate a
;;balance sheet that no sequence of withdrawals produced.
;;==== SWPX-13 - SPWU|C>TOGGLE-SWAP: the pool-worth floor · 02 · let / invocation ==== ============
(print "--- [SWPX-13 - SPWU|C>TOGGLE-SWAP: the pool-worth floor · 02 · let / invocation] ---")
(let
    (
        (ref-SWP:module{SwapperV4} SWP)
        (ref-SWPI:module{SwapperIssueV4} SWPI)
        (ref-U|SWP:module{UtilitySwpV2} U|SWP)
        (ref-TS01-C3:module{TalosStageOne_ClientThreeV4} TS01-C3)
        (toks:[string] ["DLK-98c486052a51" "BUSD-98c486052a51" "TUSD-98c486052a51" "USDC-98c486052a51"])
    )
    (let
        (
            (wp:string (ref-U|SWP::UC_PoolID toks [0.4 0.2 0.2 0.2] -1.0))
        )
        (map print
            [
                ;;the premise: as configured, this pool clears the floor comfortably
                (expect "<<SWPX-13>> the pool is worth more than the live inactive limit"
                    true (> (at 0 (ref-SWPI::URC_PoolValue wp)) (ref-SWP::UR_InactiveLimit)))
            ]
        )
        ;;raise the bar above the pool -- governance tightening the floor
        (env-module-admin SWP)
        (update SWP.SWP|Properties SWP.SWP|INFO
            { "inactive-limit" : (+ (at 0 (ref-SWPI::URC_PoolValue wp)) 1000.0) })
        (map print
            [
                (expect "<<SWPX-13>> the floor now sits above the pool's worth"
                    true (< (at 0 (ref-SWPI::URC_PoolValue wp)) (ref-SWP::UR_InactiveLimit)))
                ;;THE ITEM. The message quotes both figures, so it tells the operator exactly how far
                ;;short the pool is -- asserted by substring on the stable prefix, since the worth is
                ;;a long decimal derived at runtime.
                (expect-failure "<<SWPX-13>> swap cannot be switched ON below the floor"
                    "cannot have its Swap Functionality turned on because its worth is"
                    (ref-TS01-C3::SWP|C_ToggleSwapCapability KST.ANHD wp true))
                ;;...and the OFF direction is NOT gated by worth -- that is the `if toggle` branch,
                ;;and driving it is what shows the rule is one-sided by design rather than merely
                ;;unreached. Swap is already off on this pool, so what answers is the no-op rule, NOT
                ;;the worth rule: the pool is still below the floor, and the floor says nothing.
                ;;Pinning the message it DOES give is the honest form -- asserting success here would
                ;;have been wrong, and the first draft did exactly that.
                (expect-failure "<<SWPX-13>> ...while the OFF direction is answered by the no-op rule, not the floor"
                    "Similar boolean unallowed for <can-add> or <can-swap>"
                    (ref-TS01-C3::SWP|C_ToggleSwapCapability KST.ANHD wp false))
                ;;the pool really is below the floor at this moment, so the line above is a genuine
                ;;"the worth rule declined to answer" and not an accident of ordering.
                (expect "<<SWPX-13>> ...and the pool is still below the floor while that happens"
                    true (< (at 0 (ref-SWPI::URC_PoolValue wp)) (ref-SWP::UR_InactiveLimit)))
            ]
        )
        ""
    )
)
(env-sigs [])
;;the raised limit and the swap-off are discarded -- SWPX-13b checks it
(rollback-tx)

;;|| NEXT >
;;|| SWPX-13b — the raised limit left no trace.
;;
(begin-tx "SWPX-13b - no leakage")
(namespace "ouronet-ns")
(print "--- [SWPX-13b · 01 · no leakage] ---")
;;`inactive-limit` is chain-wide: a leaked raise would silently forbid enabling swap on EVERY pool,
;;and nothing else in the suite asserts on it.
(print
    (expect "<<SWPX-13b>> the inactive limit is back to its configured value"
        100.0 (SWP.UR_InactiveLimit)))
(commit-tx)

;;|| NEXT >
;;
(begin-tx "SWP-D1 — the topology-version counter, which no REPL has ever read")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(namespace "ouronet-ns")
(print "--- [SWP-D1 · 01 · XI_UpdatePair bumps the version IFF something really changed] ---")
;;DOC-CLAIM VERIFICATION (`_docclaims.py` G5), and this one was a genuine hole rather than a naming
;;artefact: `UR_TopologyVersion` is read by ZERO `.repl` files in the whole suite, so the entire
;;#65bL Phase 1 version-counter mechanism ran unobserved.
;;
;;  `14_SWPT.pact` XI_UpdatePair          — "creating the neighbour entry if this is the first
;;                                           connection ... or appending ... Called only when it
;;                                           detects a genuine change — never unconditionally."
;;  `14_SWPT.pact` XI_BumpTopologyVersion — "increments the global topology-version counter by 1."
;;
;;WHY THE COUNTER MATTERS: it is the freshness oracle for the path cache. `URC_ReadPathCacheFresh`
;;compares a cached row's stored version against this counter, so a bump that FAILS to happen leaves
;;stale routes being served as fresh — a silent wrong-answer bug, not a crash. The claim under test
;;is therefore the negative one: a replay must NOT bump.
;;
;;Driven through `acquire-module-admin` + `with-capability (SWPT.SECURE)`, the idiom already used by
;;`[6.3]` TX 032z4. SWPT's SECURE is `(defcap SECURE () true)`, so this is a legitimate internal
;;route rather than a forged one; synthetic token names keep the writes off every real pair.
;;
;;NOTE ON THE LADDER: a bump of exactly +1 is only expected for a SINGLE ordered pair. Issuing a real
;;pool calls XI_UpdatePair for every ordered pair, so an n-token pool bumps by n*(n-1) -- which is
;;why this drives the primitive directly instead of issuing a pool and asserting (+ v 1).
;;==== SWP-D1 — the topology-version counter, which no REPL has ever read · 01 · env-sigs (caps) ==== 
(print "--- [SWP-D1 — the topology-version counter, which no REPL has ever read · 01 · env-sigs (caps)] ---")
(env-sigs [{ "key": "PK_AncientHodler", "caps": [] }])
(acquire-module-admin ouronet-ns.SWPT)
(with-capability (SWPT.SECURE)
    (let
        (
            (ref-SWPT:module{SwapTracerV3} SWPT)
            (a:string "TopoTestTokenA")
            (b:string "TopoTestTokenB")
        )
        (let
            (
                (v0:integer (ref-SWPT::UR_TopologyVersion))
            )
            ;;STEP 1 — a pair that has never been connected. This is a genuine change.
            (SWPT.XI_UpdatePair a b "topo-fake-pool-1")
            (let
                (
                    (v1:integer (ref-SWPT::UR_TopologyVersion))
                )
                ;;STEP 2 — a SECOND, parallel pool on the SAME pair. Still a genuine change (the
                ;;neighbour entry gains an edge), so it must bump again.
                (SWPT.XI_UpdatePair a b "topo-fake-pool-2")
                (let
                    (
                        (v2:integer (ref-SWPT::UR_TopologyVersion))
                    )
                    ;;STEP 3 — THE CLAIM. Replaying the identical call changes nothing, so the
                    ;;counter must NOT move. This is the assertion the whole block exists for: an
                    ;;unconditional bump would pass steps 1 and 2 and fail only here.
                    (SWPT.XI_UpdatePair a b "topo-fake-pool-2")
                    (map print
                        [
                            (expect "<<SWP-D1>> a first-ever connection bumps the counter by exactly 1"
                                (+ v0 1) v1)
                            (expect "<<SWP-D1>> ...a new PARALLEL pool on the same pair bumps it again"
                                (+ v1 1) v2)
                            (expect "<<SWP-D1>> ...and an IDENTICAL replay does NOT bump it"
                                v2 (ref-SWPT::UR_TopologyVersion))
                            ;;the counter only ever moves forward -- a decrement would break every
                            ;;freshness comparison that reads it
                            (expect "<<SWP-D1>> the counter never went backwards across the ladder"
                                true (and (> v1 v0) (> v2 v1)))
                        ]
                    )
                )
            )
        )
    )
)
(env-sigs [])
;;the synthetic pair is discarded -- no real route table is touched
(rollback-tx)

;;|| NEXT >
;;
(begin-tx "SWP-D2 — UR_PathCacheRaw's missing-row sentinel is always stale")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(namespace "ouronet-ns")
(print "--- [SWP-D2 · 01 · a cache miss defaults BELOW any real version] ---")
;;`14_SWPT.pact` UR_PathCacheRaw — "raw keyed read against SWPT|PathCache, [BAR]-sentinel default
;;for a missing row."
;;
;;The testable content is not the sentinel itself but its RELATION to the live counter: the default
;;`topology-version` is -1, and the counter starts at 0 and only ever increases, so a missing row is
;;classified STALE by every freshness check, always. If the default were ever raised to 0, a cache
;;miss on a brand-new chain would read as FRESH and the router would serve an empty route as though
;;it were a valid one.
;;
;;Called module-qualified on purpose: UR_PathCacheRaw is deliberately NOT on the SwapTracerV3
;;interface (the @doc says callers go through URC_ReadPathCache), so a `module{SwapTracerV3}` ref
;;cannot reach it.
(let
    (
        (ref-SWPT:module{SwapTracerV3} SWPT)
        (miss:string "NoSuchTokenA|NoSuchTokenB")
    )
    (map print
        [
            (expect "<<SWP-D2>> a missing cache row defaults to topology-version -1"
                -1 (at "topology-version" (SWPT.UR_PathCacheRaw miss)))
            ;;THE RELATION, which is the part that actually protects the router
            (expect "<<SWP-D2>> ...which is strictly below the live counter, so a miss is ALWAYS stale"
                true (< (at "topology-version" (SWPT.UR_PathCacheRaw miss))
                        (ref-SWPT::UR_TopologyVersion)))
            ;;and the live counter is non-negative, which is what makes -1 unreachable as a real value
            (expect "<<SWP-D2>> ...and the live counter is non-negative, so -1 is not a value it can hold"
                true (>= (ref-SWPT::UR_TopologyVersion) 0))
        ]
    )
    ""
)
(commit-tx)

;;|| NEXT >
;;
(begin-tx "SWP-D3 — the remaining SWP doc claims: two IMC gates, one crash residual, one identity")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
;;==== SWP-D3 — the remaining SWP doc claims: two IMC gates, one crash residual, one identity · 01 · namespace ==== 
(print "--- [SWP-D3 — the remaining SWP doc claims: two IMC gates, one crash residual, one identity · 01 · namespace] ---")
(namespace "ouronet-ns")
(print "--- [SWP-D3 · 01 · four claims whose docs are mostly changelog] ---")
;;DOC-CLAIM VERIFICATION (`_docclaims.py` G5), four functions grouped because they share a shape:
;;each @doc is LARGELY A CHANGELOG of a removed check, and the scanner flagged them on words like
;;"never" and "already guaranteed" that describe code which no longer exists. Recording that is
;;half the value here -- the next reader should not go looking for a live invariant in them.
;;What IS testable in each is drawn out below.
;;
;;  `12_U_SWP.pact` UC_LpID              — #40L history. Its only forward-looking statement is an
;;                                         explicit NON-guarantee: mismatched-length inputs "hit a
;;                                         plain out-of-bounds crash instead of a clean enforce".
;;  `14_SWPT.pact` XE_RegisterPath       — rationale for why callers must not grant SWPT.SECURE
;;                                         themselves. Testable residue: the IMC gate.
;;  `15_SWP.pact`  XE_CanAddOrSwapToggle — #55L history. Testable residue: the IMC gate -- and here
;;                                         that gate is the ENTIRE authorization story, because
;;                                         C_ToggleAddOrSwap's own doc says this entrypoint carries
;;                                         "no ownership check" of its own.
;;  `16_SWPI.pact` URC_SingleSSTOAWorthWSTOA — #65fL extraction. Testable residue: URC_WorthWSTOA's
;;                                         SSTOA branch must now BE this function, not a copy of it.
;;==== SWP-D3 — the remaining SWP doc claims: two IMC gates, one crash residual, one identity · 02 · let / invocation ==== 
(print "--- [SWP-D3 — the remaining SWP doc claims: two IMC gates, one crash residual, one identity · 02 · let / invocation] ---")
(let
    (
        (ref-U|SWP:module{UtilitySwpV2} U|SWP)
        (ref-SWPI:module{SwapperIssueV4} SWPI)
        (ref-DPTF:module{DemiourgosPactTrueFungibleV2} DPTF)
        (ref-DALOS:module{OuronetDalosV2} DALOS)
        (dead:string "S|DLK-98c486052a51|OURO-98c486052a51|DWK-98c486052a51")
    )
    (let
        (
            (dlk:string (ref-DALOS::UR_SilverStoaID))
        )
        (map print
            [
                ;;--- UC_LpID: the doc's ADMITTED RESIDUAL, pinned as a non-guarantee. It is worth a
                ;;test precisely because it is the opposite of a guard: the #40L fix deliberately
                ;;REMOVED the length-parity enforce as a UC_* purity violation, accepting a native
                ;;fault in its place. Pinning it stops anyone "restoring" the enforce by accident
                ;;and stops anyone assuming a clean message exists.
                (expect-failure "<<SWP-D3>> UC_LpID does NOT enforce on mismatched lengths -- it faults"
                    "Array index out of bounds"
                    (ref-U|SWP::UC_LpID ["a" "b"] ["A"] [0.5 0.5] -1.0))
                ;;...and on equal-length input it is total and enforce-free
                (expect "<<SWP-D3>> ...while equal-length input returns the [pool-name lp-id] pair"
                    ["W|a^b" "W|A-B|LP"]
                    (ref-U|SWP::UC_LpID ["a" "b"] ["A" "B"] [0.5 0.5] -1.0))

                ;;--- XE_RegisterPath: the IMC gate is the only claim the doc makes that can be
                ;;driven. The POSITIVE path is already covered anonymously (a real smart swap leaves
                ;;a non-BAR URC_ReadPathCache row, asserted in [6.3] TX 032z6/z7 -- that state can
                ;;only exist if this ran), so the negative is what was missing.
                (expect-failure "<<SWP-D3>> XE_RegisterPath is closed to a direct outside caller"
                    "None of the guards passed"
                    (SWPT.XE_RegisterPath "A" "B" ["A" "B"] ["p"]))

                ;;--- XE_CanAddOrSwapToggle: same gate, but this one carries real security weight.
                ;;The entrypoint does `P|UEV_IMC` then a RAW UPDATE of can-add / can-swap with NO
                ;;ownership check -- C_ToggleAddOrSwap's own @doc says so out loud. So the IMC guard
                ;;is the entire thing standing between an outside caller and disabling any pool on
                ;;the chain. Nothing pinned it until now.
                (expect-failure "<<SWP-D3>> XE_CanAddOrSwapToggle: the IMC gate is the ONLY thing protecting a raw pool toggle"
                    "None of the guards passed"
                    (SWP.XE_CanAddOrSwapToggle dead false false))
                ;;...and the pool it was aimed at is untouched by the rejected call
                (expect "<<SWP-D3>> ...and the targeted pool's flags are unchanged by the refusal"
                    true (SWP.UR_CanSwap dead))

                ;;--- URC_SingleSSTOAWorthWSTOA: the #65fL extraction claim. If URC_WorthWSTOA's
                ;;SSTOA branch had kept its own inline copy, the two could drift silently; this
                ;;identity is what would catch that. DLK *is* SSTOA, which is why the branch fires.
                (expect "<<SWP-D3>> URC_WorthWSTOA's SSTOA branch IS the extracted single-unit reader"
                    (floor (* 1000.0 (ref-SWPI::URC_SingleSSTOAWorthWSTOA)) (ref-DPTF::UR_Decimals dlk))
                    (ref-SWPI::URC_WorthWSTOA dlk 1000.0))
                ;;and it is not trivially zero, which would make the identity vacuous
                (expect "<<SWP-D3>> ...and the single-unit worth is non-zero, so that identity has content"
                    true (> (ref-SWPI::URC_SingleSSTOAWorthWSTOA) 0.0))
            ]
        )
    )
    ""
)
(commit-tx)

;;|| NEXT >
;;
(begin-tx "SWP-D4 — SWP|C>ROTATE-PRINCIPAL: the two claims its own tests never made")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(namespace "ouronet-ns")
(print "--- [SWP-D4 · 01 · the new-id existence check and count preservation] ---")
;;DOC-CLAIM VERIFICATION (`_docclaims.py` G5). `15_SWP.pact` SWP|C>ROTATE-PRINCIPAL was flagged as
;;untested, and that is a NAME-MATCH ARTEFACT rather than a hole: four of its five rejections are
;;already driven through the Talos wrapper `SWP|A_RotatePrincipal` in `[6.2+3]` and `SWP-G12`, so
;;the cap is exercised -- the scanner just never sees the defcap's own name. Worth recording,
;;because it is the same false-positive class the tool's own docstring warns about.
;;
;;TWO CLAIMS GENUINELY WERE UNTESTED, and both are in the doc:
;;
;;  1] `(ref-DPTF::UEV_id new)` is the FIRST statement in the cap -- ahead of every principal rule --
;;     so a rotation naming a token that does not exist is refused on existence, not on membership.
;;     No existing test passes a non-token as <new>.
;;  2] "Count-preserving — never interacts with the 7-principal cap." Nothing asserted the count.
;;
;;This cap is `@event`, so `test-capability` cannot acquire it (it routes to the install path); the
;;Talos admin wrapper is the only driver, which is what SWP-G12 already notes.
;;==== SWP-D4 — SWP|C>ROTATE-PRINCIPAL: the two claims its own tests never made · 01 · env-sigs (caps) ==== 
(print "--- [SWP-D4 — SWP|C>ROTATE-PRINCIPAL: the two claims its own tests never made · 01 · env-sigs (caps)] ---")
(env-sigs [{ "key": "PK_AncientHodler", "caps": [] }])
;;==== SWP-D4 — SWP|C>ROTATE-PRINCIPAL: the two claims its own tests never made · 02 · let / invocation ==== 
(print "--- [SWP-D4 — SWP|C>ROTATE-PRINCIPAL: the two claims its own tests never made · 02 · let / invocation] ---")
(let
    (
        (ref-TS01-A:module{TalosStageOne_AdminV2} TS01-A)
        (ref-SWP:module{SwapperV4} SWP)
    )
    (let
        (
            (before:[string] (ref-SWP::UR_Principals))
        )
        (map print
            [
                ;;CLAIM 1 — <new> must be a real DPTF. The id below is well-formed but nothing on
                ;;this chain, so the refusal can only be the existence check.
                (expect-failure "<<SWP-D4>> a rotation whose NEW id is not a real token is refused"
                    "DPTF ID NOTATOKEN-98c486052a51 does not exist"
                    (ref-TS01-A::SWP|A_RotatePrincipal KST.ANHD "OURO-98c486052a51" "NOTATOKEN-98c486052a51"))
                ;;...and it is refused on EXISTENCE, not on OURO being a major principal -- which is
                ;;the rejection the same call gets when <new> IS real. Two different messages from
                ;;one argument change is what shows the ordering the doc describes.
                (expect-failure "<<SWP-D4>> ...whereas the same rotation with a REAL new id fails later, on the major rule"
                    "is a major (primordial-pool) principal"
                    (ref-TS01-A::SWP|A_RotatePrincipal KST.ANHD "OURO-98c486052a51" "BUSD-98c486052a51"))
                ;;CLAIM 2 — count preservation. Both rejections above left the register untouched,
                ;;which is the weaker half; the doc's actual claim is that a rotation never changes
                ;;the COUNT, so the length is asserted rather than the list.
                (expect "<<SWP-D4>> the refused rotations changed neither the principals nor their count"
                    [before (length before)]
                    [(ref-SWP::UR_Principals) (length (ref-SWP::UR_Principals))])
                ;;...and the register is inside the documented 2..7 band, so "never interacts with
                ;;the 7-principal cap" is a statement about a register that is actually near it
                (expect "<<SWP-D4>> ...and the register sits inside the documented 2..7 band"
                    true (and (>= (length before) 2) (<= (length before) 7)))
            ]
        )
    )
    ""
)
(env-sigs [])
(commit-tx)

