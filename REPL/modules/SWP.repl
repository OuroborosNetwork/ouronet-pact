(begin-tx "SWP-G16 — asymmetric additions are refused while the global switch is off")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(namespace "ouronet-ns")
(print "--- [SWP-G16 · 01 · UEV_AddLiquidity asymmetric admission] ---")
;;The asymmetric switch is a PROTOCOL-WIDE kill switch, not a per-pool flag: an asymmetric deposit
;;moves a pool off its target weights, so the administrator can stop all of them at once. It is ON
;;throughout the suite, so the guard is only reachable with it off.
;;
;;Toggled off, asserted, and toggled back — with the restoration asserted, because everything after
;;this block in the file (and in any suite that loads it) runs under that switch.
;;==== SWP-G16 — asymmetric additions are refused while the global switch is off · 01 · env-sigs (caps) ==== 
(print "--- [SWP-G16 — asymmetric additions are refused while the global switch is off · 01 · env-sigs (caps)] ---")
(env-sigs [{ "key": "PK_AncientHodler", "caps": [] }])
(let*
    (
        (ref-SWP:module{SwapperV4} SWP)
        (ref-SWPL:module{SwapperLiquidityV2} SWPL)
        (ref-SWPLC:module{SwapperLiquidityClientV2} SWPLC)
        (ref-TS01-A:module{TalosStageOne_AdminV2} TS01-A)
        (pool:string "S|DLK-98c486052a51|OURO-98c486052a51|DWK-98c486052a51")
        (ld-asymmetric:object{SwapperLiquidityV2.LiquidityData}
            (ref-SWPL::UDC_LiquidityData
                (ref-SWPL::UDC_LiquiditySplit [1.0 1.0 1.0] [0.0 0.0 0.0])
                (ref-SWPL::UDC_LiquiditySplitType false true) 0.0 3.0 0.0))
    )
    (ref-TS01-A::SWP|A_ToggleAsymetricLiquidityAddition KST.ANHD false)
    (map print
        [
            (expect "<<SWP-G16>> the global asymmetric switch is now OFF"
                false (ref-SWP::UR_Asymetric))
            (expect-failure "<<SWP-G16>> ...so an asymmetric addition is refused protocol-wide"
                "Asymetric Liquidity Addition isn't enabled by an Ouronet Administrator"
                (ref-SWPLC::UEV_AddLiquidity pool ld-asymmetric))
        ]
    )
    (ref-TS01-A::SWP|A_ToggleAsymetricLiquidityAddition KST.ANHD true)
    (map print
        [
            (expect "<<SWP-G16>> ...and the switch is back ON, as the rest of the suite expects"
                true (ref-SWP::UR_Asymetric))
        ]
    )
    ""
)
(env-sigs [])
(commit-tx)
;;NOT PINNED — UEV_AddLiquidity's empty-pool rule ("Liquidity Addition on an empty Pool must have a
;;Balanced Part present!") fires only when URC_LpCapacity is exactly 0.0. This pool reads 10,000,000
;;(asserted indirectly by the block above succeeding at all), and every pool in this suite is
;;already seeded with liquidity. It needs a freshly issued pool that has never been funded — which
;;is an issuance, not an argument.

;;|| NEXT >
