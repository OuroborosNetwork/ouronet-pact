(begin-tx "SWP-I1 — INFO_SWP|ToggleFeeLock quotes the STOA the unlock actually charges")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(namespace "ouronet-ns")
(print "--- [SWP-I1 · 01 · DEFECT FIX: the unlock was previewed as STOA-free] ---")
;;FUNCTION COVERAGE (G6) — the `INFO_` family, per the owner's spec: an INFO_ must report the same
;;cost the op actually charges. Template and rationale: `modules/ATS.repl <<ATS-I1>>`.
;;
;;DEFECT (found by this spec, fixed in `15_SWP.pact` + `02_INFO-ONE+.pact`):
;;`INFO_SWP|ToggleFeeLock` returned `OI|UDC_NoStoaCosts` UNCONDITIONALLY — a literal zero, rendered
;;to the client as "Operation is free of native Stoa (STOA)". But `SWP::C_ToggleFeeLock` does:
;;
;;    (toggle-costs:[decimal] (XI_ToggleFeeLock swpair toggle))   ;; [0.0 0.0] on LOCK,
;;    (stoa-costs:decimal (at 1 toggle-costs))                    ;; UC_FeeUnlockPrice on UNLOCK
;;    (if (> stoa-costs 0.0) (do (XI_IncrementFeeUnlocks swpair)
;;                               (ref-IGNIS::XE_CollectStoa patron stoa-costs)) true)
;;
;;so UNLOCKING is billed and the preview said it was free. LOCKING really is free, which is why a
;;half-tested preview looks right: the zero is correct for one of the two directions.
;;
;;THE TELL — this module's own siblings disagreed. Three ops share this exact shape:
;;    DPTF::C_ToggleFeeLock        -> INFO_DPTF|ToggleFeeLock  used DPTF::URCi_ToggleFeeLockStoa  ✓
;;    SWP::C_ToggleFeeLock         -> INFO_SWP|ToggleFeeLock   hardcoded NoStoaCosts             ✗
;;    ATS::C_ToggleParameterLock   -> INFO_ATS|ToggleParameterLock  hardcoded NoStoaCosts        ✗
;;DPTF had already been given the read-only price twin. SWP and ATS never were. The fix ports
;;DPTF's `URCi_ToggleFeeLockStoa` shape to both (see `<<ATS-I2>>` for the ATS half).

;;A STOA charge is a REAL `coin.transfer` out of the patron's Stoa account, split 10/20/30/40 across
;;the four `OI|UR_StoaTargets` — so it needs a managed `coin.TRANSFER` per target, and the whole form
;;must sit at TRANSACTION TOP LEVEL. Two traps, both hit while writing this block:
;;  1] `env-sigs` called from INSIDE a `let` sets the signature set but never INSTALLS the managed
;;     caps — the transfer then dies with "Managed capability not installed" from inside coin.transfer,
;;     pointing at coin rather than at the test.
;;  2] building the cap list with `(map (lambda (t) (coin.TRANSFER ...)) targets)` does not install
;;     them either. Capability values have to be written out literally here.
;;The sender is the Stoa account of this pool's owner; the four receivers are the STOA fee targets.
;;==== SWP-I1 — INFO_SWP|ToggleFeeLock quotes the STOA the unlock actually charges · 01 · env-sigs (caps) ==== 
(print "--- [SWP-I1 — INFO_SWP|ToggleFeeLock quotes the STOA the unlock actually charges · 01 · env-sigs (caps)] ---")
(env-sigs
  [ { "key": "PK_AncientHodler", "caps": [] }
    { "key": "PK_Emma", "caps": [] }
    { "key": "ecaeae048b6e4b1d4cd9b5ba41041b39e05ac3a7b32f495a12823cb1c5ad0f48"
    , "caps":
      [ (coin.TRANSFER "k:ecaeae048b6e4b1d4cd9b5ba41041b39e05ac3a7b32f495a12823cb1c5ad0f48" "k:50d6c59b21e5e6e55baecaa75a1007de37576bde12d8230dc82459cc01b9484b" 1000000.0)
        (coin.TRANSFER "k:ecaeae048b6e4b1d4cd9b5ba41041b39e05ac3a7b32f495a12823cb1c5ad0f48" "k:0cb30c0121ff919266121a99ff9359871818932211df94dae4137c29bc0e8f7e" 1000000.0)
        (coin.TRANSFER "k:ecaeae048b6e4b1d4cd9b5ba41041b39e05ac3a7b32f495a12823cb1c5ad0f48" "c:XM-pkmuB5XUQlp87ZYSbfKt8qzmHY6O2EHAzMRVBt3k" 1000000.0)
        (coin.TRANSFER "k:ecaeae048b6e4b1d4cd9b5ba41041b39e05ac3a7b32f495a12823cb1c5ad0f48" "c:iQQFWj6gWtpGEzhM_O5ekW1QtnQQy55R8BRPGhj_0FU" 1000000.0) ] } ])
;;==== SWP-I1 — INFO_SWP|ToggleFeeLock quotes the STOA the unlock actually charges · 02 · let / invocation ==== 
(print "--- [SWP-I1 — INFO_SWP|ToggleFeeLock quotes the STOA the unlock actually charges · 02 · let / invocation] ---")
(let
    (
        (ref-TS01-C3:module{TalosStageOne_ClientThreeV4} TS01-C3)
        (ref-U|SWP:module{UtilitySwpV2} U|SWP)
        (ref-SWP:module{SwapperV4} SWP)
        (ref-DALOS:module{OuronetDalosV2} DALOS)
        (toks:[string] ["DLK-98c486052a51" "BUSD-98c486052a51" "TUSD-98c486052a51" "USDT-98c486052a51"])
    )
    (let
        (
            (sp:string (ref-U|SWP::UC_PoolID toks (make-list 4 1.0) -1.0))
        )
        (let
            (
                ;;the toggle is owner-gated, and the patron pays — so read the owner rather than
                ;;assuming it, since SWPX-03 above hands this pool between accounts
                (patron:string (ref-SWP::UR_OwnerKonto sp))
            )
            ;;PRECONDITION: to measure the CHARGED direction the pool must start LOCKED. Locking is
            ;;the free direction, so this setup step cannot itself contribute to the measurement.
            (if (not (ref-SWP::UR_FeeLock sp))
                (ref-TS01-C3::SWP|C_ToggleFeeLock patron (SWP.UR_OwnerKonto sp) sp true)
                "already locked"
            )
            (let
                (
                    (stoa-acct:string (ref-DALOS::UR_AccountStoa patron))
                )
                (let
                    (
                        ;;PREDICTED — read BEFORE the unlock executes, exactly as a client would
                        (predicted:object{OuronetInfoV2.ClientInfo}
                            (INFO-ONE.INFO_SWP|ToggleFeeLock patron sp false))
                        (stoa-before:decimal (coin.get-balance stoa-acct))
                        (ignis-before:decimal (ref-DALOS::UR_TF_AccountSupply patron false))
                    )
                    (let
                        (
                            (predicted-stoa:decimal (at "stoa-need" (at "stoa" predicted)))
                            (predicted-ignis:decimal (at "ignis-need" (at "ignis" predicted)))
                        )
                        (ref-TS01-C3::SWP|C_ToggleFeeLock patron (SWP.UR_OwnerKonto sp) sp false)
                        (let
                            (
                                (real-stoa:decimal (- stoa-before (coin.get-balance stoa-acct)))
                                (real-ignis:decimal (- ignis-before (ref-DALOS::UR_TF_AccountSupply patron false)))
                            )
                            (map print
                                [
                                    (format "<<SWP-I1>> IGNIS predicted={} real={} | STOA predicted={} real={}"
                                        [predicted-ignis real-ignis predicted-stoa real-stoa])
                                    (expect "<<SWP-I1>> the IGNIS quote equals the IGNIS charged"
                                        real-ignis predicted-ignis)
                                    ;;THE REGRESSION: this asserted 0.0 == <the real fee> before the fix.
                                    (expect "<<SWP-I1>> the STOA quote equals the STOA charged on UNLOCK"
                                        real-stoa predicted-stoa)
                                    ;;...and the unlock genuinely costs STOA, so the equality above is
                                    ;;not the old bug agreeing with itself at zero.
                                    (expect "<<SWP-I1>> ...and unlocking is NOT free"
                                        true (> real-stoa 0.0))
                                ]
                            )
                        )
                    )
                )
            )
        )
    )
    ""
)
(env-sigs [])
;;the toggle is discarded — the suite's pool keeps whatever lock state it had
(rollback-tx)

;;|| NEXT >
;;
(begin-tx "SWP-I2 — INFO_SWP|ModifyWeights quote vs measured charge")
(env-gasmodel "table")(env-gaslimit 100000000)(env-gas 0)
(namespace "ouronet-ns")
(print "--- [SWP-I2 · 01 · re-weight a weighted pool] ---")
;;FUNCTION COVERAGE (G6) — `INFO_SWP|ModifyWeights`, per the owner's spec: an INFO_ must report the same cost
;;the op actually charges. Template and rationale: `modules/ATS.repl <<ATS-I1>>`.
;;
;;PATRON CHOICE IS NOT COSMETIC HERE. Every SWP pool-config `URCi_` names the POOL OWNER as the
;;cumulator's interactor, and `UDC_PrimeIgnisCumulator` routes 25% of each leg to that interactor —
;;but only if it is a SMART account, otherwise the share collapses to BAR. So if the patron were also
;;a smart pool owner, a quarter of every leg would be a self-transfer and the measured debit would be
;;75% of the quote, looking exactly like a preview defect. `KST.ANHD` is a standard account, which is
;;what keeps this measurement clean. Check `(DALOS.UR_AccountType owner)` before reusing this shape.
(env-sigs [{ "key": "PK_AncientHodler", "caps": [] } { "key": "PK_Emma", "caps": [] }])
(let
    (
        (ref-TS01-C3:module{TalosStageOne_ClientThreeV4} TS01-C3)
        (ref-SWP:module{SwapperV4} SWP)
        (ref-DALOS:module{OuronetDalosV2} DALOS)
        (wp:string "W|DLK-98c486052a51|BUSD-98c486052a51|TUSD-98c486052a51|USDC-98c486052a51")
        (sd:string "S|DLK-98c486052a51|OURO-98c486052a51|DWK-98c486052a51")
        (patron:string KST.ANHD)
        (lumy:string KST.LUMY)
    )
    (let
        (
            (predicted:object{OuronetInfoV2.ClientInfo} (INFO-ONE.INFO_SWP|ModifyWeights patron wp [0.25 0.25 0.25 0.25]))
            (ignis-before:decimal (ref-DALOS::UR_TF_AccountSupply patron false))
            (m (ref-TS01-C3::SWP|C_ModifyWeights patron (SWP.UR_OwnerKonto wp) wp [0.25 0.25 0.25 0.25]))
        )
        (map print
            [
                (expect "<<SWP-I2>> INFO_SWP|ModifyWeights's quote equals what the op actually charged"
                    (- ignis-before (ref-DALOS::UR_TF_AccountSupply patron false))
                    (at "ignis-need" (at "ignis" predicted)))
                (expect "<<SWP-I2>> ...and it is a real, non-zero charge"
                    true (> (- ignis-before (ref-DALOS::UR_TF_AccountSupply patron false)) 0.0))
            ]
        )
    )
    ""
)
(env-sigs [])
(rollback-tx)

