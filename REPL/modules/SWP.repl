(begin-tx "SWP-G8 — UEV_FeeSplit and the STOA precision floor")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
;;==== SWP-G8 — UEV_FeeSplit and the STOA precision floor · 01 · namespace ==== ===================
(print "--- [SWP-G8 — UEV_FeeSplit and the STOA precision floor · 01 · namespace] ---")
(namespace "ouronet-ns")
(print "--- [SWP-G8 · 01 · fee-split range, STOA precision] ---")
;;UEV_FeeSplit validates a {target, value} pair: the target must be a real Ouronet account, and
;;the value is a share expressed in hundred-thousandths -- so 1 and 100000 are the two ends of
;;the legal range, and BOTH are asserted as accepted before either rejection is claimed. The
;;range is wide and the guard folds both ends into one message, so a test that only tried 0
;;would not distinguish this from a simple (> v 0).
;;
;;LIQUID's UEV_Amount is here for the same reason UTIL-12 keeps its pairs together: it is a
;;precision floor at STOA's 12 decimals, and the only input that says anything is the one that
;;sits exactly on the boundary.
;;==== SWP-G8 — UEV_FeeSplit and the STOA precision floor · 02 · let / invocation ==== ============
(print "--- [SWP-G8 — UEV_FeeSplit and the STOA precision floor · 02 · let / invocation] ---")
(let
    (
        (ref-SWP:module{SwapperV4} SWP)
    )
    (map print
        [
            ;;--- both ends of the legal fee-split range
            (expect "<<SWP-G8>> a split value of 1 — the minimum — is accepted"
                true (ref-SWP::UEV_FeeSplit {"target": KST.ANHD, "value": 1}))
            (expect "<<SWP-G8>> ...and 100000, the maximum, likewise"
                true (ref-SWP::UEV_FeeSplit {"target": KST.ANHD, "value": 100000}))
            (expect-failure "<<SWP-G8>> zero is below the range"
                "Invalid Splitting Value in Split Object"
                (ref-SWP::UEV_FeeSplit {"target": KST.ANHD, "value": 0}))
            (expect-failure "<<SWP-G8>> ...and 100001 is one past the top of it"
                "Invalid Splitting Value in Split Object"
                (ref-SWP::UEV_FeeSplit {"target": KST.ANHD, "value": 100001}))
            ;;--- STOA precision, at the boundary in both directions
            (expect "<<SWP-G8>> an amount at exactly STOA's 12 decimals is conform"
                true (LIQUID.UEV_Amount 0.000000000001))
            (expect-failure "<<SWP-G8>> ...and a 13th decimal is not"
                "is not conform with STOA prec"
                (LIQUID.UEV_Amount 0.0000000000001))
        ]
    )
    ""
)
(commit-tx)

