(begin-tx "SWP-G12 — the PRINCIPAL register: what may be removed, rotated, or named primordial")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(namespace "ouronet-ns")
(print "--- [SWP-G12 · 01 · principal and primordial-pool admin guards] ---")
;;A "principal" is a token that must appear in every weighted or product pool. The register has a
;;two-tier rule: MINOR principals may be removed or rotated, MAJOR ones — the members of the
;;primordial pool — may not, because retiring one would invalidate the pool that defines them.
;;These are @event caps, so they are driven through the Talos admin path rather than acquired.
;;
;;OURO is a major principal in this suite, and both refusals are driven against it with DIFFERENT
;;operations (remove, rotate) because they are separate guards with separate messages — a reader
;;could easily assume one covers the other.
;;==== SWP-G12 — the PRINCIPAL register: what may be removed, rotated, or named primordial · 01 · env-sigs (caps) ==== 
(print "--- [SWP-G12 — the PRINCIPAL register: what may be removed, rotated, or named primordial · 01 · env-sigs (caps)] ---")
(env-sigs [{ "key": "PK_AncientHodler", "caps": [] }])
;;==== SWP-G12 — the PRINCIPAL register: what may be removed, rotated, or named primordial · 02 · let / invocation ==== 
(print "--- [SWP-G12 — the PRINCIPAL register: what may be removed, rotated, or named primordial · 02 · let / invocation] ---")
(let
    (
        (ref-TS01-A:module{TalosStageOne_AdminV2} TS01-A)
        (ref-SWP:module{SwapperV4} SWP)
    )
    (map print
        [
            ;;precondition: OURO really is a registered principal, so these refusals are about the
            ;;MAJOR tier and not about the token being unknown.
            (expect "<<SWP-G12>> OURO is a registered principal"
                true (contains "OURO-98c486052a51" (ref-SWP::UR_Principals)))
            (expect-failure "<<SWP-G12>> a MAJOR principal cannot be removed"
                "is a major (primordial-pool) principal — cannot be removed"
                (ref-TS01-A::SWP|A_UpdatePrincipal KST.ANHD "OURO-98c486052a51" false))
            (expect-failure "<<SWP-G12>> ...nor rotated away"
                "is a major (primordial-pool) principal — cannot be rotated"
                (ref-TS01-A::SWP|A_RotatePrincipal KST.ANHD "OURO-98c486052a51" "DLK-98c486052a51"))
            ;;--- the primordial pool may only be (re)declared as itself: naming any other pool is
            ;;refused, which is what stops the major-principal set being redefined sideways.
            (expect-failure "<<SWP-G12>> a pool that is not the primordial pool cannot be declared as it"
                "Pool is not the primordial pool"
                (ref-TS01-A::SWP|A_DefinePrimordialPool
                    KST.ANHD "S|DLK-98c486052a51|OURO-98c486052a51|DWK-98c486052a51"))
        ]
    )
    ""
)
(commit-tx)

