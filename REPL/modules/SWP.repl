(print "--- [SWP-G11c — restore: swapping back ON, and the worth floor that gates the restart · 02 · let / invocation] ---")
(let
    (
        (ref-TS01-C3:module{TalosStageOne_ClientThreeV4} TS01-C3)
        (ref-SWP:module{SwapperV4} SWP)
        (ref-SWPI:module{SwapperIssueV4} SWPI)
        (pool:string "S|DLK-98c486052a51|OURO-98c486052a51|DWK-98c486052a51")
    )
    (map print
        [
            (expect "<<SWP-G11c>> the pool is worth more than the restart floor"
                true (> (at 0 (ref-SWPI::URC_PoolValue pool)) (ref-SWP::UR_InactiveLimit)))
        ]
    )
    (ref-TS01-C3::SWP|C_ToggleSwapCapability KST.ANHD pool true)
    (map print
        [
            (expect "<<SWP-G11c>> swapping is enabled again — no later block inherits a dead pool"
                true (ref-SWP::UR_CanSwap pool))
        ]
    )
    ""
)
(env-sigs [])
