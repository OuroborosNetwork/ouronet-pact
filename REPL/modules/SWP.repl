(begin-tx "SWP-G6 — SWPI pure-compute validators: the `v` band, where a bad ARGUMENT is the whole test")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
;;==== SWP-G6 — SWPI pure-compute validators: the `v` band, where a bad ARGUMENT is the whole test · 01 · namespace ==== 
(print "--- [SWP-G6 — SWPI pure-compute validators: the `v` band, where a bad ARGUMENT is the whole test · 01 · namespace] ---")
(namespace "ouronet-ns")
(print "--- [SWP-G6 · 01 · the UCv_/URCv_ band on SWPI] ---")
;;P3.3, first sweep of SWPI. Every guard here sits on a UCv_ or URCv_ function -- the `v` role
;;(CLAUDE.md § prefixes): an enforce INTRINSIC to the computation rather than a business rule.
;;That makes them the cheapest class left in the worklist: no capability, no fixture, no state
;;change. A direct modref call with a malformed argument is the entire test.
;;
;;Two of them come in COMPUTED / READ pairs that carry the identical message, and the pair is
;;the interesting part:
;;
;;  UCv_PoolTokenPositions   derives the pool's token list by PARSING the swpair string
;;  URCv_PoolTokenPositions  derives it by READING the pool row
;;
;;Same rejection, two different sources of truth. Testing only one would leave the other pinned
;;on wording alone, and a divergence between parse and table -- exactly the bug this pair exists
;;to make impossible -- would go unnoticed. Both are exercised, and both are asserted to agree
;;on the HAPPY path first, which is what actually proves parse == table here.
;;==== SWP-G6 — SWPI pure-compute validators: the `v` band, where a bad ARGUMENT is the whole test · 02 · let / invocation ==== 
(print "--- [SWP-G6 — SWPI pure-compute validators: the `v` band, where a bad ARGUMENT is the whole test · 02 · let / invocation] ---")
(let
    (
        (ref-SWPI:module{SwapperIssueV4} SWPI)
        (ref-U|SWP:module{UtilitySwpV2} U|SWP)
        (pool:string "S|DLK-98c486052a51|OURO-98c486052a51|DWK-98c486052a51")
        (t1:string "DLK-98c486052a51")
        (t2:string "OURO-98c486052a51")
        (t3:string "DWK-98c486052a51")
        (ghost:string "NOPE-000000000000")
    )
    (map print
        [
            ;;--- membership: the string-parsed reader and the table reader must agree
            (expect "<<SWP-G6>> UCv_ (parsed from the swpair) locates both tokens"
                [0 1] (ref-SWPI::UCv_PoolTokenPositions pool [t1 t2]))
            (expect "<<SWP-G6>> URCv_ (read from the pool row) returns the SAME positions"
                (ref-SWPI::UCv_PoolTokenPositions pool [t1 t2])
                (ref-SWPI::URCv_PoolTokenPositions pool [t1 t2]))
            (expect-failure "<<SWP-G6>> the PARSED reader refuses a token that isnt on the pool"
                "arent on pool"
                (ref-SWPI::UCv_PoolTokenPositions pool [ghost]))
            (expect-failure "<<SWP-G6>> and the TABLE reader refuses it too — same rule, other source"
                "arent on pool"
                (ref-SWPI::URCv_PoolTokenPositions pool [ghost]))
            ;;--- stable-pool arity. A stable swap solves for ONE unknown, so more than one input
            ;;is not a slippage question, it is an unanswerable one. The guard is a plain arity
            ;;check and it lives on BOTH the raw computer and the pool-reading swap entry.
            (expect-failure "<<SWP-G6>> a stable-pool swap with TWO inputs is refused (pool-read path)"
                "Only a single Input can be used in Stable Swap"
                (ref-SWPI::URCv_Swap pool
                    (ref-U|SWP::UDC_DirectSwapInputData [t1 t2] [1.0 1.0] t3) false))
            (expect-failure "<<SWP-G6>> ...and refused identically on the raw compute path"
                "Only a single Input can be used in Stable Swap"
                (ref-SWPI::UCv_BareboneSwap "S"
                    (ref-U|SWP::UDC_DirectRawSwapInput
                        85.0 [100.0 100.0 100.0] [1.0 1.0] [0 1] 2 12 [])))
            ;;the arity rule is SPECIFIC to stable pools -- a weighted pool must still accept the
            ;;very same two-input object, or the guard would be a blanket ban wearing an "S" label.
            (expect "<<SWP-G6>> the same two-input object is ACCEPTED by a weighted pool"
                true (!= "" (format "{}"
                    [(ref-SWPI::UCv_BareboneSwap "W"
                        (ref-U|SWP::UDC_DirectRawSwapInput
                            85.0 [100.0 100.0 100.0] [1.0 1.0] [0 1] 2 12 [0.34 0.33 0.33]))])))
            ;;--- asymmetric-liquidity deviation. The computation only means anything when at
            ;;least one side is being left out (a 0.0 in the liquidity vector); with every side
            ;;funded there is no asymmetry to measure and the function refuses to invent one.
            (expect "<<SWP-G6>> a genuinely asymmetric deposit yields a deviation"
                true (> (ref-SWPI::UCv_DeviationInValueShares
                            [100.0 100.0 100.0] [10.0 0.0 0.0] [0.34 0.33 0.33]) 0.0))
            (expect-failure "<<SWP-G6>> a fully-funded (symmetric) vector has no deviation to compute"
                "Invalid Values to Compute Deviation In Value Shares"
                (ref-SWPI::UCv_DeviationInValueShares
                    [100.0 100.0 100.0] [10.0 10.0 10.0] [0.34 0.33 0.33]))
        ]
    )
    ""
)
(commit-tx)

;;|| NEXT >
