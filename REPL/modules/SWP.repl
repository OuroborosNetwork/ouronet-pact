(begin-tx "SWP-I22 — INFO_SWP|AddStandardLiquidity quote vs measured charge")
(env-gasmodel "table")(env-gaslimit 100000000)(env-gas 0)
(namespace "ouronet-ns")
(print "--- [SWP-I22 · 01 · the plain standard-liquidity preview] ---")
;;FUNCTION COVERAGE (G6) — `INFO_SWP|AddStandardLiquidity`, per the owner's spec. Template: `modules/ATS.repl <<ATS-I1>>`;
;;the patron/interactor hazard is written out at <<SWP-I2>>.
;;`INFO_SWP|AddLiquidity` (<<SWP-I14>>) and this one share a BODY — both read
;;`SWPLC::URCi_AddStandardLiquidity` — but map to execs in DIFFERENT modules: `TS01-C3`'s single-tx
;;`C_AddLiquidity` versus `TS01-CP`'s three-step defpact `C_AddStandardLiquidity`. Only the single-tx
;;side is measurable in one `begin-tx`, so this block deliberately weighs the SAME preview against
;;the SAME exec as <<SWP-I14>>; what it adds is the record that the two previews are interchangeable.
(env-sigs [{ "key": "PK_AncientHodler", "caps": [] }])
(let
    (
        (ref-TS01-C3:module{TalosStageOne_ClientThreeV4} TS01-C3)
        (ref-SWPL:module{SwapperLiquidityV2} SWPL)
        (ref-DALOS:module{OuronetDalosV2} DALOS)
        (ref-U|CT|DIA:module{DiaStoaPidV2} U|CT)
        (pool:string "S|DLK-98c486052a51|OURO-98c486052a51|DWK-98c486052a51")
        (patron:string KST.ANHD)
        (amounts:[decimal] [10.0 10.0 10.0])
    )
    (let
        (
            (ignis-id:string (ref-DALOS::UR_IgnisID))
            (clad-op:object{SwapperLiquidityV2.CladOperation}
                (at "clad-op" (ref-SWPL::URC_STOA-PID|CLAD patron pool
                    (ref-SWPL::URC_LD pool amounts) true true (ref-U|CT|DIA::UR_STOA-PID|Price))))
        )
        (let
            (
                ;;the IGNIS leg of what the account SENDS IN — asymmetry tax, principal not gas.
                ;;Diagnosed and explained in full at <<SWP-I14>>.
                (tax:decimal
                    (fold (+) 0.0
                        (map (lambda (idx:integer)
                                (if (= (at idx (at "mt-ids" clad-op)) ignis-id)
                                    (at idx (at "mt-amt" clad-op))
                                    0.0))
                             (enumerate 0 (- (length (at "mt-ids" clad-op)) 1)))))
                (info:object{OuronetInfoV2.ClientInfo}
                    (INFO-ONE.INFO_SWP|AddStandardLiquidity patron patron pool amounts (ref-U|CT|DIA::UR_STOA-PID|Price)))
                (ignis-before:decimal (ref-DALOS::UR_TF_AccountSupply patron false))
            )
            (let
                (
                    (m (ref-TS01-C3::SWP|C_AddLiquidity patron patron pool amounts))
                )
                (let
                    (
                        (real:decimal (- ignis-before (ref-DALOS::UR_TF_AccountSupply patron false)))
                        (predicted:decimal (at "ignis-need" (at "ignis" info)))
                    )
                    (map print
                        [
                            (format "<<SWP-I22>> quoted={} total-ignis-out={} asymmetry-tax={} gas-only={}"
                                [predicted real tax (- real tax)])
                            (expect "<<SWP-I22>> INFO_SWP|AddStandardLiquidity's quote equals the GAS the op charged"
                                (- real tax) predicted)
                            (expect "<<SWP-I22>> ...and the gas is a real, non-zero charge"
                                true (> (- real tax) 0.0))
                            ;;the 2026-09-14 declaration fix reaches this preview too -- it shares the
                            ;;body with <<SWP-I14>>, so a repair that only landed on one of the two
                            ;;would mean the multistep client still previewed the tax as nothing.
                            (expect "<<SWP-I22>> ...and this preview DECLARES the asymmetry tax as well"
                                true
                                (contains (format "{} IGNIS of Asymmetric-Liquidity TAX" [tax])
                                          (concat (at "pre-text" info))))
                        ]
                    )
                )
            )
        )
    )
    ""
)
(env-sigs [])
(rollback-tx)

