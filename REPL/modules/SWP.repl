(begin-tx "SWP-G20 -- the LP-fee bound, at both edges")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(namespace "ouronet-ns")
;;==== SWP-G20 -- the LP-fee bound, at both edges · 01 · env-sigs (caps) ==== =====================
(print "--- [SWP-G20 -- the LP-fee bound, at both edges · 01 · env-sigs (caps)] ---")
(env-sigs [{ "key": "PK_AncientHodler", "caps": [] }])
(print "--- [SWP-G20 . 01 . above the cap and below the floor] ---")
;;FOUND BY `python3 tools/_docclaims.py` (BOUND tier). SWP|C_UpdateFee's @doc states a numeric limit --
;;"The Fee must be between 0.0001 - 320.0 (promile, that would be 32%)" -- and gives the REASON:
;;when the liquid-boost parameter is on, an amount equal to the LP-fee is ALSO drawn to boost the
;;Liquid Stoa Index, "which is why the fee must be capped at close a third of 100%". So the cap is
;;not cosmetic: exceeding it means the pool draws more than it can cover. Nothing tested it.
;;
;;Both EDGES are asserted, not just the rejections. A one-sided test passes just as well against a
;;function that refuses every value, and an off-by-one in the comparison (`<` where `<=` belongs)
;;would move the accepted boundary without breaking a rejection-only test.
(map print
    [
        (expect-failure "<<SWP-G20>> a fee ABOVE the 320 promile cap is refused"
            "SWP Pool Fee amount of 320.1 is invalid size wise"
            (TS01-C3.SWP|C_UpdateFee KST.ANHD (SWP.UR_OwnerKonto "S|DLK-98c486052a51|OURO-98c486052a51|DWK-98c486052a51")
                "S|DLK-98c486052a51|OURO-98c486052a51|DWK-98c486052a51" 320.1 true))
    ]
)
(commit-tx)

;;|| NEXT >
