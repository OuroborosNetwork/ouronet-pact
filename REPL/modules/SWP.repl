(begin-tx "SWP-G17 — explicit swap routes, and the pool-supply floor")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(namespace "ouronet-ns")
(print "--- [SWP-G17 · 01 · SMART-SWAP-EXPLICIT-ROUTE + S>UPDATE-SUPPLIES] ---")
;;P3.3. Plain (non-@event) defcaps, reached directly with test-capability.
;;
;;SMART-SWAP-EXPLICIT-ROUTE is the entrypoint where the CLIENT supplies the route instead of the
;;chain searching for one — so every structural property the search used to guarantee now has to be
;;re-checked here. The cap's own @doc names the danger: "a structurally-valid but wrong-pair route
;;must never be silently accepted." These two cases are that danger in its two cheapest forms: no
;;route at all, and a route that is a real path but runs the wrong way.
;;
;;The bundle is built as an object literal because SWPU publishes no UDC for it — unlike the SWPL
;;LiquidityData case. Its three sub-objects (SwapRoute / CachedPathOrMiss / TokenPathPair) are only
;;read for their nodes/edges here, so the boost and stoa paths are supplied empty.
;;==== SWP-G17 — explicit swap routes, and the pool-supply floor · 01 · env-sigs (caps) ==== ======
(print "--- [SWP-G17 — explicit swap routes, and the pool-supply floor · 01 · env-sigs (caps)] ---")
(env-sigs [{ "key": "PK_AncientHodler", "caps": [] }])
(let*
    (
        (ref-SWP:module{SwapperV4} SWP)
        (pool:string "S|DLK-98c486052a51|OURO-98c486052a51|DWK-98c486052a51")
        (pt:[string] (ref-SWP::UR_PoolTokens pool))
        (a:string (at 0 pt))
        (b:string (at 1 pt))
        (miss:object{SwapperUsageV3.CachedPathOrMiss} {"nodes":[],"edges":[],"is-new":false})
        (empty-route:object{SwapperUsageV3.SmartSwapPathBundle}
            {"swap-route":{"nodes":[],"edges":[]},"boost-path":miss,"stoa-paths":[]})
        ;;a REVERSED route: nodes [b a] is a genuine one-hop path through this very pool, so it is
        ;;structurally valid and active — it simply starts at the wrong end. That is what makes this
        ;;case test the endpoint check rather than the path validator three lines below it.
        (reversed-route:object{SwapperUsageV3.SmartSwapPathBundle}
            {"swap-route":{"nodes":[b a],"edges":[pool]},"boost-path":miss,"stoa-paths":[]})
    )
    (map print
        [
            ;;--- an empty route. The input/output tokens DIFFER, so the guard above this one
            ;;    provably cannot be what answers.
            (expect-failure "<<SWP-G17>> a bundle carrying no route at all is refused"
                "No path supplied between"
                (test-capability (SWPU.SWPU|X>SMART-SWAP-EXPLICIT-ROUTE KST.ANHD a 1.0 b empty-route)))
            ;;--- a real path, wrong direction.
            (expect-failure "<<SWP-G17>> ...and a valid route that starts at the wrong token is refused"
                "swap-route in bundle does not start at input-id"
                (test-capability (SWPU.SWPU|X>SMART-SWAP-EXPLICIT-ROUTE KST.ANHD a 1.0 b reversed-route)))
            ;;--- S>UPDATE-SUPPLIES: audit fix H12. The supply vector is sized from the pool itself,
            ;;    so the uniform-length check above cannot be what answers; every entry is negative.
            ;;    A negative reserve would invert the swap maths and let the pool be drained.
            (expect-failure "<<SWP-G17>> a negative pool-token supply is refused"
                "cannot be negative"
                (test-capability (SWP.SWP|S>UPDATE-SUPPLIES pool (make-list (length pt) -1.0))))
        ]
    )
    ""
)
(env-sigs [])
(commit-tx)

;;|| NEXT >
;;
(begin-tx "SWP-G18 — the asymmetric-deviation ceiling")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
;;==== SWP-G18 — the asymmetric-deviation ceiling · 01 · namespace ==== ===========================
(print "--- [SWP-G18 — the asymmetric-deviation ceiling · 01 · namespace] ---")
(namespace "ouronet-ns")
(print "--- [SWP-G18 · 01 · UEV_Liquidity deviation bound] ---")
;;P3.3. A plain callable UEV_ taking a LiquidityData object — built with SWPL's own constructors, as
;;in SWP-G15.
;;
;;This is the bound that makes asymmetric liquidity safe at all. An asymmetric deposit pushes the
;;pool away from its target weights; unbounded, a single lopsided deposit could move the price to
;;anything the depositor chose and then be swapped back out. The ceiling is derived from the pool's
;;own shape — 0.4 * (n-1)/n on n tokens — so it tightens automatically as pools get smaller.
;;
;;UEV_Liquidity RETURNS [dev max-dev] rather than just passing, which gives a free positive control:
;;the small deposit below is asserted to sit strictly under the ceiling it reports, using the SAME
;;function and the SAME pool as the rejection. Without that, the rejection would be satisfied by a
;;bound of zero, which would forbid every asymmetric deposit rather than only the extreme ones.
(let*
    (
        (ref-SWP:module{SwapperV4} SWP)
        (ref-SWPL:module{SwapperLiquidityV2} SWPL)
        (pool:string "S|DLK-98c486052a51|OURO-98c486052a51|DWK-98c486052a51")
        (n:integer (length (ref-SWP::UR_PoolTokens pool)))
        (zero:[decimal] (make-list n 0.0))
        ;;an asymmetric vector is "everything into token 0, nothing into the rest". A dust amount is
        ;;within tolerance; a million is not. Both are the same SHAPE, so the only thing that differs
        ;;between the two cases is magnitude — which is what the guard measures.
        (dust:object{SwapperLiquidityV2.LiquidityData}
            (ref-SWPL::UDC_LiquidityData
                (ref-SWPL::UDC_LiquiditySplit zero (+ [0.000001] (make-list (- n 1) 0.0)))
                (ref-SWPL::UDC_LiquiditySplitType false true) 0.0 0.000001 0.0))
        (skewed:object{SwapperLiquidityV2.LiquidityData}
            (ref-SWPL::UDC_LiquidityData
                (ref-SWPL::UDC_LiquiditySplit zero (+ [1000000.0] (make-list (- n 1) 0.0)))
                (ref-SWPL::UDC_LiquiditySplitType false true) 0.0 1000000.0 0.0))
    )
    (let
        (
            (reported:[decimal] (ref-SWPL::UEV_Liquidity pool dust))
        )
        (map print
            [
                ;;positive control, read out of the function's own return value: a dust-sized
                ;;asymmetric deposit deviates far less than the ceiling the function computes.
                (expect "<<SWP-G18>> a dust asymmetric deposit is strictly inside the reported ceiling"
                    true (< (at 0 reported) (at 1 reported)))
                (expect "<<SWP-G18>> ...and that ceiling is positive, so it is not forbidding everything"
                    true (> (at 1 reported) 0.0))
                ;;--- and a million into one leg of the same pool exceeds it.
                (expect-failure "<<SWP-G18>> a massively lopsided asymmetric deposit is refused"
                    "greater than the maximum allowed deviation"
                    (ref-SWPL::UEV_Liquidity pool skewed))
            ]
        )
        ""
    )
)
(commit-tx)

;;|| NEXT >
;;
(begin-tx "SWP-G19 — a pair cannot be re-created in either token order")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
;;==== SWP-G19 — a pair cannot be re-created in either token order · 01 · namespace ==== ==========
(print "--- [SWP-G19 — a pair cannot be re-created in either token order · 01 · namespace] ---")
(namespace "ouronet-ns")
(print "--- [SWP-G19 · 01 · UEV_CheckTwo, both orderings] ---")
;;P3.3. UEV_CheckTwo exists because the pool id is ORDER-SENSITIVE: UC_PoolID [A B] and [B A] are
;;two different strings. So a "pair already exists" check that looked only at the order it was handed
;;would happily let the same pair be issued a second time with the tokens swapped — two pools for one
;;market, splitting liquidity and giving the router two different prices for the same trade.
;;
;;It therefore computes BOTH orderings and has a separate enforce for each. Both are driven, because
;;they are separate enforces and the second is the one covering the attack the first misses:
;;
;;    [OURO BUSD] -> swp1 = P|OURO|BUSD  EXISTS  -> first enforce fires
;;    [BUSD OURO] -> swp1 = P|BUSD|OURO  absent  -> first enforce PASSES
;;                   swp2 = P|OURO|BUSD  EXISTS  -> second enforce fires
;;
;;The weights and amp are the ones that actually reproduce the live id ([1.0 1.0], -1.0 — asserted
;;below), because a wrong pair of those would hash to an id that does not exist and BOTH enforces
;;would pass for the wrong reason.
(let*
    (
        (ref-SWP:module{SwapperV4} SWP)
        (ref-U|SWP:module{UtilitySwpV2} U|SWP)
        (o:string "OURO-98c486052a51")
        (b:string "BUSD-98c486052a51")
        (w:[decimal] [1.0 1.0])
        (amp:decimal -1.0)
        (live:string (ref-U|SWP::UC_PoolID [o b] w amp))
    )
    (map print
        [
            ;;precondition: these weights/amp really do name a LIVE pool, and the reversed ordering
            ;;really does NOT — which is what separates the two enforces.
            (expect "<<SWP-G19>> [OURO BUSD] with these weights names a live pool"
                true (ref-SWP::URC_CheckID live))
            (expect "<<SWP-G19>> ...while the reversed ordering names no pool of its own"
                false (ref-SWP::URC_CheckID (ref-U|SWP::UC_PoolID [b o] w amp)))
            ;;--- first enforce: the pair as given already exists.
            (expect-failure "<<SWP-G19>> re-issuing the pair in its own order is refused"
                "must not exist" (ref-SWP::UEV_CheckTwo [o b] w amp))
            ;;--- second enforce: the pair REVERSED. This is the duplicate-pool case.
            (expect-failure "<<SWP-G19>> ...and re-issuing it with the tokens SWAPPED is refused too"
                "must not exist" (ref-SWP::UEV_CheckTwo [b o] w amp))
        ]
    )
    ""
)
(commit-tx)

;;|| NEXT >
;;
(begin-tx "SWP-G14 — SWPI UEV_Issue: the pool-shape rules, each reached past the one before it")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(namespace "ouronet-ns")
(print "--- [SWP-G14 · 01 · pool issuance shape] ---")
;;UEV_Issue validates the shape of a pool BEFORE any of it is written: amplifier domain, token
;;count, weight-vector arity, and the weight values themselves. It is an ordinary UEV_, so it is
;;called directly with no capability and no Talos shell — the whole cost here was constructing a
;;valid [object{PoolTokens}] list.
;;
;;The guards run in sequence, so every case below satisfies its predecessors and breaks exactly
;;one thing. Note in particular the last two: a two-token pool with a ONE-entry weight vector
;;trips ARITY, while a two-token pool with weights summing to 0.6 gets past arity and trips the
;;VALUE rule. Those are separate guards with separate messages and one input cannot prove both.
;;==== SWP-G14 — SWPI UEV_Issue: the pool-shape rules, each reached past the one before it · 01 · env-sigs (caps) ==== 
(print "--- [SWP-G14 — SWPI UEV_Issue: the pool-shape rules, each reached past the one before it · 01 · env-sigs (caps)] ---")
(env-sigs [{ "key": "PK_AncientHodler", "caps": [] }])
(let*
    (
        (ref-SWPI:module{SwapperIssueV4} SWPI)
        (t1:object{SwapperV4.PoolTokens} {"token-id":"OURO-98c486052a51","token-supply":100.0})
        (t2:object{SwapperV4.PoolTokens} {"token-id":"DLK-98c486052a51","token-supply":100.0})
    )
    (map print
        [
            ;;--- amplifier: -1.0 means "not a stable pool"; anything else must be >= 1.0
            (expect-failure "<<SWP-G14>> an amplifier between 0 and 1 is refused"
                "Invalid amp value"
                (ref-SWPI::UEV_Issue KST.ANHD [t1 t2] 1.0 [0.5 0.5] 0.5 false))
            ;;--- token count: a pool needs at least two sides
            (expect-failure "<<SWP-G14>> a ONE-token pool is refused"
                "2 - 7 Tokens can be used to create a Swap Pair"
                (ref-SWPI::UEV_Issue KST.ANHD [t1] 1.0 [1.0] -1.0 false))
            ;;--- weight arity: two tokens, one weight
            (expect-failure "<<SWP-G14>> a weight vector shorter than the token list is refused"
                "Number of weigths does not concide with the pool-tokens Number"
                (ref-SWPI::UEV_Issue KST.ANHD [t1 t2] 1.0 [0.5] -1.0 false))
            ;;--- weight values: right arity, wrong sum. A weighted pool's weights must total 1.0
            ;;(or all be 1.0 for the unweighted form); 0.3 + 0.3 is neither.
            (expect-failure "<<SWP-G14>> ...and a correctly-sized vector whose weights do not total 1.0"
                "Invalid Weight Values"
                (ref-SWPI::UEV_Issue KST.ANHD [t1 t2] 1.0 [0.3 0.3] -1.0 false))
        ]
    )
    ""
)
(env-sigs [])
(commit-tx)

