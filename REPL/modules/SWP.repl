(begin-tx "SWP-G21 -- FIXED: an enforce message that could never be shown")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(namespace "ouronet-ns")
;;==== SWP-G21 -- FIXED: an enforce message that could never be shown · 01 · env-sigs (caps) ==== =
(print "--- [SWP-G21 -- FIXED: an enforce message that could never be shown · 01 · env-sigs (caps)] ---")
(env-sigs [{ "key": "PK_AncientHodler", "caps": [] }])
(print "--- [SWP-G21 . 01 . the repaired enforce message] ---")
;;FOUND while pinning UEV_CanChangeOwnerON, then FIXED (owner-authorised 2026-09-12:
;;"if an enforce is missing its string (format outputs a string), you should just add it").
;;SWP|S>RT_OWN (15_SWP.pact:466) used to read:
;;
;;    (enforce (>= max-new-owner current-special-targets)
;;        ("Insufficient Major Elite Tier for NewOwner to support ... SpecialFeeTargets of {}"
;;         [current-special-targets]))
;;
;;`format` was MISSING, so Pact tried to APPLY the string literal to the argument list and raised
;;"Cannot apply value to non-closure" -- an internal evaluation error in place of the explanation
;;somebody wrote. It now reads `(format "..." [current-special-targets])` and the sentence arrives.
;;Detector: `python3 tools/_conformance.py --rule enforce-msg-not-format`, now clean codebase-wide.
;;
;;WHY IT SURVIVED SO LONG. `enforce` is LAZY in its message -- verified directly:
;;`(enforce (= 1 1) ("m {}" [1]))` returns true. The defect was invisible on every call where the
;;tier check PASSED, and appeared only when the check failed, which is the one moment the message
;;matters. A malformed message is therefore unreachable by any test that does not deliberately
;;drive its own enforce to failure -- which is exactly what this test does. The first assertion
;;establishes the rejection comes from the tier comparison genuinely failing, not an earlier guard.
;;==== SWP-G21 -- FIXED: an enforce message that could never be shown · 02 · let / invocation ==== 
(print "--- [SWP-G21 -- FIXED: an enforce message that could never be shown · 02 · let / invocation] ---")
(let ((sp:string "S|DLK-98c486052a51|OURO-98c486052a51|DWK-98c486052a51"))
    (map print
        [
            ;;EMMA's major tier 4 caps her at 4 supportable targets; the pair carries 7. So
            ;;(>= 4 7) is false and the enforce fires -- reaching the repaired message.
            (expect "<<SWP-G21>> the pair carries more special-fee-targets than EMMA's tier supports"
                true (> (length (SWP.UR_FeeSPT sp)) (DALOS.UR_Elite-Tier-Major KST.EMMA)))
            ;;...and the caller now gets the sentence written for this case. This assertion is the
            ;;regression guard on the fix: drop the `format` again and it reverts to
            ;;"Cannot apply value to non-closure" and fails here.
            (expect-failure "<<SWP-G21>> the tier rejection now surfaces its written explanation"
                "Insufficient Major Elite Tier for NewOwner"
                (TS01-C3.SWP|C_ChangeOwnership KST.ANHD (SWP.UR_OwnerKonto sp) KST.EMMA sp))
        ]
    )
)
(commit-tx)

;;|| NEXT >
;;
(begin-tx "SWP-G21b -- the can-change-owner flag: toggled, guarded, restored")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(namespace "ouronet-ns")
;;==== SWP-G21b -- the can-change-owner flag: toggled, guarded, restored · 01 · env-sigs (caps) ==== 
(print "--- [SWP-G21b -- the can-change-owner flag: toggled, guarded, restored · 01 · env-sigs (caps)] ---")
(env-sigs [{ "key": "PK_AncientHodler", "caps": [] }])
(print "--- [SWP-G21b . 01 . the flag and its same-value guard] ---")
;;The flag is a REVERSIBLE toggle, not a one-way lock -- worth pinning because the two shapes look
;;identical from a reader's seat and only one of them is recoverable. Toggled off, the guard
;;against a no-op write is exercised, then the original value is RESTORED and the restore asserted:
;;this pair is shared fixture state and leaving it off would silently change every later test that
;;touches pair ownership.
(let* ((sp:string "S|DLK-98c486052a51|OURO-98c486052a51|DWK-98c486052a51")
       (original:bool (SWP.UR_CanChangeOwner sp)))
    ;;the flag starts ON, which is what makes the flip below land on the REFUSING value. Asserted
    ;;rather than assumed: if the starting value ever changes, the three assertions that depend on
    ;;the flip direction would quietly invert instead of failing.
    (map print
        [
            (expect "<<SWP-G21b>> the flag starts ON, so flipping it lands on the refusing value"
                true original)
            ;;...and while it is ON, the guard that reads it passes. The pair of this and the
            ;;expect-failure below is what makes the guard a switch rather than a constant.
            (expect "<<SWP-G21b>> ...and the ownership guard passes while the flag is ON"
                true (SWP.UEV_CanChangeOwnerON sp))
        ]
    )
    (TS01-C3.SWP|C_ModifyCanChangeOwner KST.ANHD (SWP.UR_OwnerKonto sp) sp (not original))
    (let ((flipped:bool (SWP.UR_CanChangeOwner sp)))
        (map print
            [
                (expect "<<SWP-G21b>> the can-change-owner flag really flipped"
                    (not original) flipped)
                ;;setting it to the value it already holds is refused -- a no-op write would
                ;;otherwise cost IGNIS and emit an event for nothing
                (expect-failure "<<SWP-G21b>> re-setting it to the SAME value is refused"
                    "Similar boolean unallowed for <can-change-owner>"
                    (TS01-C3.SWP|C_ModifyCanChangeOwner KST.ANHD (SWP.UR_OwnerKonto sp) sp flipped))
                ;;THE GUARD ITSELF, which this test was already creating the state for and never
                ;;asserted. UEV_CanChangeOwnerON was on the unpinned worklist purely because nobody
                ;;called it inside this window -- no new fixture, no table surgery, just the
                ;;assertion that belonged here. Worth remembering when triaging the worklist: check
                ;;whether an existing test already BUILDS the state before budgeting to build it.
                (expect-failure "<<SWP-G21b>> with the flag OFF, the ownership guard names the pair"
                    "SWP Pair S|DLK-98c486052a51|OURO-98c486052a51|DWK-98c486052a51 ownership cannot be changed"
                    (SWP.UEV_CanChangeOwnerON sp))
                ;;The real client path does NOT reach this guard with EMMA as the target -- the
                ;;tier check in SWP|S>RT_OWN is earlier in the defcap and answers first. That is
                ;;pinned in SWP-G21c, which clears the tier check to get here.
            ]
        )
    )
    (TS01-C3.SWP|C_ModifyCanChangeOwner KST.ANHD (SWP.UR_OwnerKonto sp) sp original)
    (map print
        [
            (expect "<<SWP-G21b>> ...and the flag is restored, so later tests see the original state"
                original (SWP.UR_CanChangeOwner sp))
            (expect "<<SWP-G21b>> ...so the guard passes again, which proves the toggle is reversible"
                true (SWP.UEV_CanChangeOwnerON sp))
        ]
    )
)
(commit-tx)

;;|| NEXT >
;;
(begin-tx "SWP-G21c -- the flag guard through the REAL client path, with the tier check cleared")
(env-gasmodel "table")(env-gaslimit 100000000)(env-gas 0)
(namespace "ouronet-ns")
;;==== SWP-G21c -- the flag guard through the REAL client path, with the tier check cleared · 01 · env-sigs (caps) ==== 
(print "--- [SWP-G21c -- the flag guard through the REAL client path, with the tier check cleared · 01 · env-sigs (caps)] ---")
(env-sigs [{ "key": "PK_AncientHodler", "caps": [] }])
(print "--- [SWP-G21c . 01 . guard ordering inside SWP|S>RT_OWN] ---")
;;SWP-G21b pins UEV_CanChangeOwnerON by calling it directly. That is a real pin, but on its own it
;;leaves a question open: does any PRODUCTION path reach it? Measured answer: with EMMA as the new
;;owner, no -- SWP|S>RT_OWN checks the Major Elite Tier FIRST, and EMMA is tier 0 against a pair
;;carrying 7 special-fee-targets, so the caller sees
;;    "Insufficient Major Elite Tier for NewOwner to support CurrentOwner existing
;;     SpecialFeeTargets of 7"
;;(which is also a second live witness for the `format` repaired at 15_SWP.pact:466 -- see SWP-G21).
;;
;;On THIS chain only ANHD holds a tier high enough, and ANHD already owns the pair, so no legitimate
;;argument gets past the tier check. Rather than conclude "unreachable from the client", raise
;;EMMA's tier to what the guard needs and see what answers next. Tier is a STRING field -- hers is
;;"4.6", ANHD's is "7.5" -- and major = (str-to-int (take 1 tier)), so one field write is enough.
;;
;;Pattern and its boundary: 2026-09-12-state-driven-guard-coverage.md. The whole transaction ends in
;;rollback-tx, and SWP-G21d checks it.
(let*
    (
        (sp:string "S|DLK-98c486052a51|OURO-98c486052a51|DWK-98c486052a51")
        (original:bool (SWP.UR_CanChangeOwner sp))
    )
    (map print
        [
            ;;the ordering itself, pinned before anything is changed: the tier check is what a
            ;;low-tier target hits, NOT the ownership flag.
            (expect-failure "<<SWP-G21c>> a low-tier new owner is stopped by the TIER check first"
                "Insufficient Major Elite Tier for NewOwner"
                (TS01-C3.SWP|C_ChangeOwnership KST.ANHD (SWP.UR_OwnerKonto sp) KST.EMMA sp))
            ;;EMMA is major tier 4, which the cond in SWP|S>RT_OWN maps to 4 supportable targets;
            ;;the pair carries 7. Both numbers asserted, because the guard is the comparison of the
            ;;two and either one drifting would make the refusal above pass for a different reason.
            (expect "<<SWP-G21c>> ...because EMMA's tier 4 supports 4 targets and the pair has 7"
                [4 7] [(DALOS.UR_Elite-Tier-Major KST.EMMA) (length (SWP.UR_FeeSPT sp))])
        ]
    )
    ;;raise EMMA to a tier that supports 7 targets, so the tier check stops answering. Note the
    ;;MINOR part of the tier is preserved by the object merge -- only "tier" is overwritten, and
    ;;only its major digit matters to this guard.
    (env-module-admin DALOS)
    (update DALOS.DALOS|AccountTable KST.EMMA
        { "elite" : (+ { "tier" : "7.5" } (DALOS.UR_Elite KST.EMMA)) })
    (map print
        [
            (expect "<<SWP-G21c>> EMMA now reads as major tier 7, which supports 7 targets"
                7 (DALOS.UR_Elite-Tier-Major KST.EMMA))
        ]
    )
    ;;turn the ownership flag off, then call the client path. The tier check no longer answers, so
    ;;whatever comes back is what is NEXT in the defcap -- and it is the flag guard.
    (TS01-C3.SWP|C_ModifyCanChangeOwner KST.ANHD (SWP.UR_OwnerKonto sp) sp (not original))
    (map print
        [
            (expect "<<SWP-G21c>> the flag is OFF"
                false (SWP.UR_CanChangeOwner sp))
            ;;THE POINT OF THIS TEST: the guard is load-bearing in production, not merely a
            ;;callable predicate. A client attempting a legitimate ownership change on a locked
            ;;pair is refused by THIS guard, naming the pair.
            (expect-failure "<<SWP-G21c>> ...so an otherwise-valid ownership change is refused by it"
                "SWP Pair S|DLK-98c486052a51|OURO-98c486052a51|DWK-98c486052a51 ownership cannot be changed"
                (TS01-C3.SWP|C_ChangeOwnership KST.ANHD (SWP.UR_OwnerKonto sp) KST.EMMA sp))
        ]
    )
    ""
)
;;rollback discards BOTH the tier edit and the flag flip.
(rollback-tx)

;;|| NEXT >
;;
(begin-tx "SWP-G21d -- SWP-G21c left no trace")
(namespace "ouronet-ns")
(print "--- [SWP-G21d . 01 . no leakage] ---")
;;SWP-G21c promoted a NOVICE account to Elite Demiurg tier and locked a pair's ownership. Either one
;;leaking would change what later assertions mean -- an account's elite tier feeds fee maths, DEB and
;;dispo across the whole suite, so a stray "7.5" would show up as arithmetic drift somewhere far from
;;here.
;;==== SWP-G21c -- the flag guard through the REAL client path, with the tier check cleared · 02 · let / invocation ==== 
(print "--- [SWP-G21c -- the flag guard through the REAL client path, with the tier check cleared · 02 · let / invocation] ---")
(let ((sp:string "S|DLK-98c486052a51|OURO-98c486052a51|DWK-98c486052a51"))
    (map print
        [
            (expect "<<SWP-G21d>> EMMA is back to her original tier, string and all"
                [4 "4.6"] [(DALOS.UR_Elite-Tier-Major KST.EMMA) (DALOS.UR_Elite-Tier KST.EMMA)])
            (expect "<<SWP-G21d>> ...and the pair's ownership flag is back ON"
                true (SWP.UR_CanChangeOwner sp))
        ]
    )
    ""
)
(commit-tx)

