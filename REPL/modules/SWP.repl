(begin-tx "SWP-G14 — liquidity input shape, LP compatibility, and the issue token count")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
;;==== SWP-G14 — liquidity input shape, LP compatibility, and the issue token count · 01 · namespace ==== 
(print "--- [SWP-G14 — liquidity input shape, LP compatibility, and the issue token count · 01 · namespace] ---")
(namespace "ouronet-ns")
(print "--- [SWP-G14 · 01 · SWPLC / SWPL / SWPI validators, called directly] ---")
;;P3.3. Plain callable UEV_ functions across three SWP-family modules, driven against this
;;suite's own stable pool. No capability, no Talos shell.
;;
;;UEV_InputsForLP carries THREE enforces and all three are driven, each with the other two
;;satisfied. The third needs the mixed-sign construction: a negative element alone would trip
;;the SUM guard one line above it, so the case pairs one negative amount with large positive
;;ones to keep the total non-negative while leaving a single element out of range.
(let*
    (
        (ref-SWP:module{SwapperV4} SWP)
        (ref-SWPI:module{SwapperIssueV4} SWPI)
        (ref-SWPL:module{SwapperLiquidityV2} SWPL)
        (ref-SWPLC:module{SwapperLiquidityClientV2} SWPLC)
        (pool:string "S|DLK-98c486052a51|OURO-98c486052a51|DWK-98c486052a51")
        (pt:[string] (ref-SWP::UR_PoolTokens pool))
        (n:integer (length pt))
    )
    (map print
        [
            ;;precondition: the arity the length guard is measured against, read from the pool
            ;;rather than assumed, so the cases below stay correct if the fixture pool changes.
            (expect "<<SWP-G14>> the pool has more than one token, so a 1-element vector is short"
                true (> n 1))
            ;;--- 1] one amount per pool token. A short vector would otherwise index past the end
            ;;    of pool-tokens inside the per-element map.
            (expect-failure "<<SWP-G14>> an input vector shorter than the pool is refused"
                "Invalid input amounts"
                (ref-SWPLC::UEV_InputsForLP pool [1.0]))
            ;;--- 2] the sum. Correct arity, so the length guard cannot be what answers.
            (expect-failure "<<SWP-G14>> a correctly-sized vector summing NEGATIVE is refused"
                "Input amounts Sum must be greater than zero"
                (ref-SWPLC::UEV_InputsForLP pool (+ [-9.0] (make-list (- n 1) 1.0))))
            ;;--- 3] per element. Mixed signs with a POSITIVE total, so guard 2 provably passes
            ;;    and only the single negative element is left to object to.
            (expect-failure "<<SWP-G14>> ...and a single negative element is refused even when the total is positive"
                "Amounts must be greater or equal to zero"
                (ref-SWPLC::UEV_InputsForLP pool (+ [-1.0] (make-list (- n 1) 100.0))))
            ;;    ...and an all-valid vector is accepted, so none of the three above could be
            ;;    satisfied by a validator that simply refuses everything.
            (expect "<<SWP-G14>> an all-positive, correctly-sized vector is accepted"
                true (!= "" (format "{}" [(ref-SWPLC::UEV_InputsForLP pool (make-list n 1.0))])))
            ;;--- 4] frozen-LP compatibility. A real DPTF is used deliberately: UR_Frozen hard-reads
            ;;    the properties table, so a ghost id aborts in the read instead of reaching the
            ;;    guard. DLK is not frozen, so its frozen-parent resolves to BAR, which is not a
            ;;    pool token — which is exactly the incompatibility the guard names.
            (expect-failure "<<SWP-G14>> a non-frozen DPTF is not valid frozen liquidity for this pool"
                "isnt't compatible with Swpair"
                (ref-SWPLC::UEV_AddFrozenLiquidity pool (at 0 pt)))
            ;;--- 5] balanced liquidity must name a token the pool actually holds.
            (expect-failure "<<SWP-G14>> a token outside the pool cannot supply balanced liquidity"
                "is not part of SWPair"
                (ref-SWPL::UEV_BalancedLiquidity pool "not-a-pool-token" 1.0))
            ;;--- 6] pool size at issuance. amp -1.0 is used on purpose: on that path UEV_Issue
            ;;    drops the FIRST pool token before its CAP_Owner map, so a single-token list
            ;;    leaves that map empty and the token-count guard is reached without owning
            ;;    anything. See the note below for why the sibling guards need more.
            (expect-failure "<<SWP-G14>> a one-token swap pair is refused"
                "2 - 7 Tokens can be used to create a Swap Pair"
                (ref-SWPI::UEV_Issue KST.ANHD
                    [{"token-id":(at 0 pt),"token-supply":100.0}] 0.003 [1.0] -1.0 false))
        ]
    )
    ""
)
(commit-tx)
;;NOT PINNED — UEV_Issue's amp guard ("Invalid amp value") and weights-count guard ("Number of
;;weigths does not concide...") sit BELOW a (map CAP_Owner ptte) that runs over every pool token
;;(all but the first when amp = -1.0). Both of my first attempts therefore returned an ownership
;;failure on a smart-contract account rather than the guard. Reaching them needs a pool-token list
;;the SIGNER owns, and every DPTF in this suite (DLK, DWK, AUSD…USDT) belongs to a smart contract
;;— a user-owned token like MOCKA lives in the DPTF suite, not here. The single-token case above
;;slips past only because the drop-first rule empties the ownership map entirely.

;;|| NEXT >
;;
(begin-tx "SWP-G15 — the liquidity-KIND gates, driven with a constructed LiquidityData")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(namespace "ouronet-ns")
(print "--- [SWP-G15 · 01 · chilled / dormant / asymmetric admission] ---")
;;P3.3. These guards take an OBJECT rather than a scalar, which is why they sat unpinned — but SWPL
;;publishes constructors for every part of it (UDC_LiquiditySplit, UDC_LiquiditySplitType,
;;UDC_LiquidityData), so the fixture is three calls, not a real liquidity addition. Using the
;;module's own constructors rather than an object literal also means a schema change breaks this
;;block loudly instead of silently mis-typing a field.
;;
;;The two split TYPES are the whole lever: LiquiditySplitType is {iz-balanced, iz-asymmetric}, so
;;one object asserts "this deposit is proportional" and the other "this deposit is lopsided", and
;;the guards below branch on exactly that.
;;==== SWP-G15 — the liquidity-KIND gates, driven with a constructed LiquidityData · 01 · env-sigs (caps) ==== 
(print "--- [SWP-G15 — the liquidity-KIND gates, driven with a constructed LiquidityData · 01 · env-sigs (caps)] ---")
(env-sigs [{ "key": "PK_AncientHodler", "caps": [] }])
(let*
    (
        (ref-SWP:module{SwapperV4} SWP)
        (ref-SWPL:module{SwapperLiquidityV2} SWPL)
        (ref-SWPLC:module{SwapperLiquidityClientV2} SWPLC)
        (ref-TS01-A:module{TalosStageOne_AdminV2} TS01-A)
        (pool:string "S|DLK-98c486052a51|OURO-98c486052a51|DWK-98c486052a51")
        (split:object{SwapperLiquidityV2.LiquiditySplit}
            (ref-SWPL::UDC_LiquiditySplit [1.0 1.0 1.0] [0.0 0.0 0.0]))
        (ld-balanced:object{SwapperLiquidityV2.LiquidityData}
            (ref-SWPL::UDC_LiquidityData split (ref-SWPL::UDC_LiquiditySplitType true false) 3.0 0.0 0.0))
        (ld-asymmetric:object{SwapperLiquidityV2.LiquidityData}
            (ref-SWPL::UDC_LiquidityData split (ref-SWPL::UDC_LiquiditySplitType false true) 0.0 3.0 0.0))
    )
    (map print
        [
            ;;preconditions: neither special LP mode is enabled on this pool, which is what makes
            ;;the two "not enabled" refusals below attributable to the pool flag rather than to the
            ;;LiquidityData shape.
            (expect "<<SWP-G15>> neither frozen-LP nor sleeping-LP is enabled on this pool"
                [false false] [(ref-SWP::UR_IzFrozenLP pool) (ref-SWP::UR_IzSleepingLP pool)])
            ;;--- CHILLED liquidity has two preconditions and they fire in order. With a BALANCED
            ;;    deposit the first answers: chilled liquidity exists to absorb the lopsided part of
            ;;    an addition, so there is nothing for it to do when the deposit is proportional.
            (expect-failure "<<SWP-G15>> chilled liquidity is refused on a BALANCED deposit"
                "Chilled Liquidity can only be added when asymtric liquidity exists"
                (ref-SWPLC::UEV_AddChilledLiquidity pool ld-balanced))
            ;;    ...and with an ASYMMETRIC deposit the first guard passes, so the SECOND one — the
            ;;    pool's frozen-LP capability — is what answers. Same function, same pool, one field
            ;;    of the object changed: that is what makes each refusal attributable.
            (expect-failure "<<SWP-G15>> ...and on an asymmetric one, by the pool's frozen-LP flag"
                "Frozen LP Functionality is not enabled on Swpair"
                (ref-SWPLC::UEV_AddChilledLiquidity pool ld-asymmetric))
            ;;--- DORMANT liquidity is the sleeping-LP twin, and takes no LiquidityData at all.
            (expect-failure "<<SWP-G15>> dormant liquidity is refused when sleeping-LP is off"
                "Sleeping LP Functionality is not enabled on Swpair"
                (ref-SWPLC::UEV_AddDormantLiquidity pool))
        ]
    )
    ""
)
(env-sigs [])
(commit-tx)

