(begin-tx "SWP-I33 — INFO_SWP|AddFrozenLiquidity quote vs measured charge")
(env-gasmodel "table")(env-gaslimit 100000000)(env-gas 0)
(namespace "ouronet-ns")
(print "--- [SWP-I33 · 01 · add FROZEN liquidity] ---")
;;FUNCTION COVERAGE (G6) — `INFO_SWP|AddFrozenLiquidity`, per the owner's spec. Template:
;;`modules/ATS.repl <<ATS-I1>>`; the patron/interactor hazard is at <<SWP-I2>>.
;;NAMED BY A COMMENTED LINE IN `[6.3]_SWP.repl`, NEVER WEIGHED — see `REPL/tools/_info_measured.py`.
;;
;;THE `frozen-dptf` ARGUMENT IS THE FROZEN TWIN, NOT THE PARENT, and the direction is easy to get
;;backwards: `UEV_AddFrozenLiquidity` resolves `DPTF::UR_Frozen <arg>` and requires the RESULT to be a
;;pool token. `<<SWP-G14>>` pins the negative — passing DLK (not frozen) resolves to BAR, which is not
;;a pool token, and the message says "isnt't compatible with Swpair" without naming the direction.
;;
;;ARITY DIVERGENCE — the preview takes SIX arguments, the exec five; the trailing `stoa-pid` is derived
;;internally by the exec, so it must be fed the same reader or the two price different oracle readings.
;;
;;SETUP, outside the window: `P|OURO|BUSD` has the frozen-LP lane open from `[6.3]:3272`, but nothing
;;holds a frozen BUSD position. The link is created if absent (it is one-shot and irreversible, so the
;;branch matters) and then a real position is frozen into it. Both ops are billed and measured
;;elsewhere — `modules/VST.repl <<VST-I1>>` and `<<VST-I3>>`.
(env-sigs
    [
        { "key": "PK_AncientHodler", "caps": [] }
        { "key": "6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263" ,
          "caps":
            [
                (coin.TRANSFER "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263" "k:50d6c59b21e5e6e55baecaa75a1007de37576bde12d8230dc82459cc01b9484b" 1000000.0)
                (coin.TRANSFER "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263" "k:0cb30c0121ff919266121a99ff9359871818932211df94dae4137c29bc0e8f7e" 1000000.0)
                (coin.TRANSFER "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263" "c:XM-pkmuB5XUQlp87ZYSbfKt8qzmHY6O2EHAzMRVBt3k" 1000000.0)
                (coin.TRANSFER "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263" "c:iQQFWj6gWtpGEzhM_O5ekW1QtnQQy55R8BRPGhj_0FU" 1000000.0)
            ]
        }
    ]
)
(let
    (
        (ref-TS01-C2:module{TalosStageOne_ClientTwoV2} TS01-C2)
        (ref-TS01-C3:module{TalosStageOne_ClientThreeV4} TS01-C3)
        (ref-DPTF:module{DemiourgosPactTrueFungibleV2} DPTF)
        (ref-DALOS:module{OuronetDalosV2} DALOS)
        (ref-U|CT|DIA:module{DiaStoaPidV2} U|CT)
        (ref-U|CT2:module{OuronetConstantsV2} U|CT)
        (pool:string "P|OURO-98c486052a51|BUSD-98c486052a51")
        (busd:string "BUSD-98c486052a51")
        (patron:string KST.ANHD)
    )
    (if (= (ref-DPTF::UR_Frozen busd) (ref-U|CT2::CT_BAR))
        (ref-TS01-C2::VST|C_CreateFrozenLink patron (ouronet-ns.DPTF.UR_Konto busd) busd)
        "frozen link already exists")
    (ref-TS01-C2::VST|C_Freeze patron patron patron busd 100.0)
    (let
        (
            (fbusd:string (ref-DPTF::UR_Frozen busd))
        )
        (let
            (
                (predicted:decimal
                    (at "ignis-need" (at "ignis"
                        (INFO-ONE.INFO_SWP|AddFrozenLiquidity patron patron pool fbusd 10.0
                            (ref-U|CT|DIA::UR_STOA-PID|Price)))))
                (ignis-before:decimal (ref-DALOS::UR_TF_AccountSupply patron false))
            )
            (let
                (
                    (m (ref-TS01-C3::SWP|C_AddFrozenLiquidity patron patron pool fbusd 10.0))
                )
                (map print
                    [
                        (format "<<SWP-I33>> frozen={} predicted={} real={}"
                            [fbusd predicted (- ignis-before (ref-DALOS::UR_TF_AccountSupply patron false))])
                        (expect "<<SWP-I33>> the setup really produced a frozen twin of a POOL token"
                            true (!= fbusd (ref-U|CT2::CT_BAR)))
                        (expect "<<SWP-I33>> INFO_SWP|AddFrozenLiquidity's quote equals what the op charged"
                            (- ignis-before (ref-DALOS::UR_TF_AccountSupply patron false)) predicted)
                        (expect "<<SWP-I33>> ...and it is a real, non-zero charge"
                            true (> (- ignis-before (ref-DALOS::UR_TF_AccountSupply patron false)) 0.0))
                    ]
                )
            )
        )
    )
    ""
)
(env-sigs [])
(rollback-tx)
(begin-tx "SWP-I34 — INFO_SWP|AddSleepingLiquidity quote vs measured charge")
(env-gasmodel "table")(env-gaslimit 100000000)(env-gas 0)
(namespace "ouronet-ns")
(print "--- [SWP-I34 · 01 · add SLEEPING liquidity] ---")
;;FUNCTION COVERAGE (G6) — `INFO_SWP|AddSleepingLiquidity`, per the owner's spec. Template:
;;`modules/ATS.repl <<ATS-I1>>`; the patron/interactor hazard is at <<SWP-I2>>.
;;NAMED BY A COMMENTED LINE IN `[6.3]_SWP.repl`, NEVER WEIGHED — see `REPL/tools/_info_measured.py`.
;;
;;THE SLEEPING SIBLING OF <<SWP-I33>>, and it takes a NONCE where the frozen one takes an amount: a
;;sleeping position is an ORTO-fungible nonce with a release date, not a divisible balance. Three
;;guards front it — the sleeping DPOF's PARENT must be a pool token, the nonce must be held by the
;;account, and `VST::UEV_StillHasSleeping` requires it to be genuinely DORMANT.
;;
;;ARITY DIVERGENCE — the preview takes SIX arguments, the exec five; the trailing `stoa-pid` is
;;derived internally by the exec and must be fed the same reader.
;;
;;SETUP, outside the window: `P|OURO|VST` has the sleeping-LP lane open from `[6.3]:3138`, but
;;nothing holds a dormant position on either pool token. The link is created if absent (one-shot and
;;irreversible, so the branch matters) and a fresh sleep mints a nonce whose 3600-second lock has
;;not elapsed. Both ops are billed and measured at `modules/VST.repl <<VST-I1>>` and <<VST-I5>>.
(env-sigs
    [
        { "key": "PK_AncientHodler", "caps": [] }
        { "key": "6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263" ,
          "caps":
            [
                (coin.TRANSFER "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263" "k:50d6c59b21e5e6e55baecaa75a1007de37576bde12d8230dc82459cc01b9484b" 1000000.0)
                (coin.TRANSFER "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263" "k:0cb30c0121ff919266121a99ff9359871818932211df94dae4137c29bc0e8f7e" 1000000.0)
                (coin.TRANSFER "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263" "c:XM-pkmuB5XUQlp87ZYSbfKt8qzmHY6O2EHAzMRVBt3k" 1000000.0)
                (coin.TRANSFER "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263" "c:iQQFWj6gWtpGEzhM_O5ekW1QtnQQy55R8BRPGhj_0FU" 1000000.0)
            ]
        }
    ]
)
(let
    (
        (ref-TS01-C2:module{TalosStageOne_ClientTwoV2} TS01-C2)
        (ref-TS01-C3:module{TalosStageOne_ClientThreeV4} TS01-C3)
        (ref-DPTF:module{DemiourgosPactTrueFungibleV2} DPTF)
        (ref-DALOS:module{OuronetDalosV2} DALOS)
        (ref-U|CT|DIA:module{DiaStoaPidV2} U|CT)
        (ref-U|CT2:module{OuronetConstantsV2} U|CT)
        (ref-SWPL:module{SwapperLiquidityV2} SWPL)
        (ref-SWP:module{SwapperV4} SWP)
        (ref-U|SWP:module{UtilitySwpV2} U|SWP)
        (ref-DPOF:module{DemiourgosPactOrtoFungibleV2} DPOF)
        (pool:string "P|OURO-98c486052a51|VST-98c486052a51")
        (vst:string "VST-98c486052a51")
        (patron:string KST.ANHD)
    )
    (if (= (ref-DPTF::UR_Sleeping vst) (ref-U|CT2::CT_BAR))
        (ref-TS01-C2::VST|C_CreateSleepingLink patron (ouronet-ns.DPTF.UR_Konto vst) vst)
        "sleeping link already exists")
    (ref-TS01-C2::VST|C_Sleep patron patron patron vst 100.0 3600)
    (let
        (
            (zvst:string (ref-DPTF::UR_Sleeping vst))
        )
        (let
            (
                (info:object{OuronetInfoV2.ClientInfo}
                    (INFO-ONE.INFO_SWP|AddSleepingLiquidity patron patron pool zvst
                        (ref-DPOF::UR_NoncesUsed zvst) (ref-U|CT|DIA::UR_STOA-PID|Price)))
                ;;THE ASYMMETRY TAX AGAIN — the same principal-vs-gas confusion written out in full at
                ;;<<SWP-I14>>: the account sends IGNIS IN as part of `mt-amt`, it leaves the balance the
                ;;meter reads, and it counterfeits a 200-IGNIS under-quote.
                ;;Observing it at the VST smart account does NOT work here and the near-miss is worth
                ;;recording: VST's IGNIS delta is 18.285, which is gas flow, not the tax. The tax lands
                ;;in the POOL via `XI_AddLiqSendAndMint`, and the pool is also a gas interactor — so no
                ;;single account's delta isolates it. Only the CLAD's own `mt-ids`/`mt-amt` does.
                ;;the IGNIS leg of what the account SENDS IN, derived the way the exec derives it:
                ;;the sleeping path builds its liquidity vector from the NONCE's supply
                ;;(`18_SWPLC.pact:1239-1242`), not from a client-supplied amounts list, so the CLAD has
                ;;to be reconstructed through `UC_MakeLiquidityList` rather than `URC_LD` on zeros.
                (tax:decimal
                    (let ((clad-op:object{SwapperLiquidityV2.CladOperation}
                              (at "clad-op"
                                  (ref-SWPL::URC_STOA-PID|CLAD patron pool
                                      (ref-SWPL::URC_LD pool
                                          (ref-U|SWP::UC_MakeLiquidityList pool
                                              (ref-SWP::URv_PoolTokenPosition pool vst)
                                              (ref-DPOF::UR_NonceSupply zvst (ref-DPOF::UR_NoncesUsed zvst))))
                                      true true (ref-U|CT|DIA::UR_STOA-PID|Price)))))
                        (fold (+) 0.0
                            (map (lambda (idx:integer)
                                    (if (= (at idx (at "mt-ids" clad-op)) (ref-DALOS::UR_IgnisID))
                                        (at idx (at "mt-amt" clad-op))
                                        0.0))
                                 (enumerate 0 (- (length (at "mt-ids" clad-op)) 1))))))
                (ignis-before:decimal (ref-DALOS::UR_TF_AccountSupply patron false))
            )
            (let
                (
                    (predicted:decimal (at "ignis-need" (at "ignis" info)))
                    (m (ref-TS01-C3::SWP|C_AddSleepingLiquidity patron patron pool zvst
                            (ref-DPOF::UR_NoncesUsed zvst)))
                )
                (map print
                    [
                        (format "<<SWP-I34>> sleeping={} nonce={} predicted={} real={}"
                            [zvst (ref-DPOF::UR_NoncesUsed zvst) predicted (- ignis-before (ref-DALOS::UR_TF_AccountSupply patron false))])
                        (expect "<<SWP-I34>> the setup really produced a sleeping twin of a POOL token"
                            true (!= zvst (ref-U|CT2::CT_BAR)))
                        (format "<<SWP-I34>> tax={} gas-only={}"
                            [tax (- (- ignis-before (ref-DALOS::UR_TF_AccountSupply patron false)) tax)])
                        (expect "<<SWP-I34>> INFO_SWP|AddSleepingLiquidity's quote equals the GAS the op charged"
                            (- (- ignis-before (ref-DALOS::UR_TF_AccountSupply patron false)) tax) predicted)
                        (expect "<<SWP-I34>> ...and it is a real, non-zero charge"
                            true (> (- ignis-before (ref-DALOS::UR_TF_AccountSupply patron false)) 0.0))
                        ;;FIXED 2026-09-14 — the sleeping shape is the OTHER one that passes
                        ;;(asymmetric-collection ON, gaseous-collection ON), so it carries the same
                        ;;undeclared principal the standard add did. Its preview now declares it, and
                        ;;the figure is checked against the tax this block independently reconstructs.
                        (expect "<<SWP-I34>> ...and the preview DECLARES the asymmetry tax it takes as principal"
                            true
                            (contains (format "{} IGNIS of Asymmetric-Liquidity TAX" [tax])
                                      (concat (at "pre-text" info))))
                    ]
                )
            )
        )
    )
    ""
)
(env-sigs [])
(rollback-tx)
;;||>>>>>>>>>>>>>>>>>>>>>>>>>
;;|| NEXT                   >
;;||>>>>>>>>>>>>>>>>>>>>>>>>>
;;|| SWPX-14 — the FIRESTARTER positive path: the one op the price sheet publishes as FREE.
;;
;;GS-15 (2026-09-15). SWP|C_Firestarter let-binds three cumulators -- C_WrapStoa, C_Swap,
;;C_SublimateV2 -- reads `gained-ouro` out of one, and contains NO XE_CollectIgnis at all. Its own
;;message is "Used 10 native STOA to generate {} IGNIS with no IGNIS Costs!", and
;;INFO_SWP|Firestarter quotes OI|UDC_NoIgnisCosts. The price sheet nevertheless published >= 93,
;;because the generator's free-by-design rule fired only when the static walk had ALSO failed to
;;find legs. Firestarting is the BOOTSTRAP op, gated on holding under 100 IGNIS -- so the sheet
;;told someone whose defining characteristic is having no IGNIS that they needed 93 of it first.
;;
;;WHY NO PIN EXISTED. `_info_measured.py` listed INFO_SWP|Firestarter as the ONE client-facing
;;preview never named in any .repl. SWPX-11 drives the REFUSAL path only, so there has never been
;;a successful firestart to measure. Finding an eligible account took a survey of all ten in the
;;harness: every one carries >= 1 OURO. Two blockers were mapped on the way and are worth keeping:
;;IGNIS has min-move 1000.0, so an account holding ~200 can never transfer it out -- it can only
;;SPEND it -- and a DPTF transfer burns exactly 1.0 IGNIS for this patron, so draining COCA's
;;205.6 below the bound would have taken ~102 operations. BYTA is the cheap fixture: 88.1 IGNIS
;;(already under), 18,789 native STOA (already funded), and 21.9 OURO -- one transfer away.
;;
;;WHAT IS ASSERTED, and why a balance delta will not do it alone. The op CREDITS IGNIS, so
;;`before - after` is not a charge and a skim would hide inside the payout. The exact economic
;;claim is the native STOA leg: EXACTLY 10.0 leaves, and the IGNIS balance moves UP, not down.
(begin-tx "SWPX-14a - bring BYTA under both firestarter bounds")
(env-gasmodel "table")(env-gaslimit 100000000)(env-gas 0)
(namespace "ouronet-ns")
(env-sigs [{ "key": "PK_Byta", "caps": [] }])
(print "--- [SWPX-14a · 01 · one transfer to eligibility] ---")
(let
    (
        (ref-DALOS:module{OuronetDalosV2} DALOS)
        (ref-DPTF:module{DemiourgosPactTrueFungibleV2} DPTF)
        (ref-TS01-C1:module{TalosStageOne_ClientOneV2} TS01-C1)
    )
    (let
        (
            (ouro:string (ref-DALOS::UR_OuroborosID))
            (ignis:string (ref-DALOS::UR_IgnisID))
        )
        (ref-TS01-C1::DPTF|C_Transfer KST.BYTA KST.BYTA KST.ANHD ouro 21.0 false)
        (map print
            [
                (format "<<SWPX-14a>> BYTA ouro={} ignis={}"
                    [(ref-DPTF::UR_AccountSupply ouro KST.BYTA)
                     (ref-DPTF::UR_AccountSupply ignis KST.BYTA)])
                (expect "<<SWPX-14a>> BYTA is under BOTH firestarter bounds (<1 OURO, <100 IGNIS)"
                    [true true]
                    [(< (ref-DPTF::UR_AccountSupply ouro KST.BYTA) 1.0)
                     (< (ref-DPTF::UR_AccountSupply ignis KST.BYTA) 100.0)])
            ])
    )
    ""
)
(print "===^^^===")
(env-sigs [])
(commit-tx)
;;||>>>>>>>>>>>>>>>>>>>>>>>>>
;;|| NEXT                   >
;;||>>>>>>>>>>>>>>>>>>>>>>>>>
(begin-tx "SWPX-14b - firestart, and measure what it actually costs")
(env-gasmodel "table")(env-gaslimit 100000000)(env-gas 0)
(namespace "ouronet-ns")
(print "--- [SWPX-14b · 01 · 10 native STOA in, IGNIS out, nothing skimmed] ---")
;;==== SWPX-14b - firestart, and measure what it actually costs · 01 · let / invocation ==== ======
(print "--- [SWPX-14b - firestart, and measure what it actually costs · 01 · let / invocation] ---")
(let
    (
        (ref-DALOS:module{OuronetDalosV2} DALOS)
        (ref-DPTF:module{DemiourgosPactTrueFungibleV2} DPTF)
        (ref-TS01-C3:module{TalosStageOne_ClientThreeV4} TS01-C3)
    )
    (let
        (
            (ignis:string (ref-DALOS::UR_IgnisID))
            (byta-stoa:string (ref-DALOS::UR_AccountStoa KST.BYTA))
            (lq-stoa:string (LIQUID.GOV|LIQUID|SC_STOA-NAME))
        )
        ;;TWO signer entries, and both are needed for different reasons.
        ;;  * PK_Byta UNSCOPED (empty caps): DALOS::UEV_StandardAccOwn does a bare
        ;;    (enforce-guard account-guard). A signature carrying a cap list is SCOPED and does not
        ;;    satisfy an unscoped enforce-guard -- the first draft passed only the scoped entry and
        ;;    died on "Keyset failure (keys-all)".
        ;;  * the STOA ADDRESS's own key, scoped to the coin.TRANSFER: C_WrapStoa ends in
        ;;    IGNIS::C_TransferDalosFuel, a bare coin::transfer out of the firestarter's linked
        ;;    k: account. That principal's key is the k: address minus its prefix.
        (env-sigs
            [
                { "key": "PK_Byta", "caps": [] }
                { "key": (drop 2 byta-stoa)
                , "caps": [(coin.TRANSFER byta-stoa lq-stoa 10.0)] }
            ]
        )
        (let
            (
                (quoted:decimal
                    (at "ignis-need" (at "ignis" (INFO-ONE.INFO_SWP|Firestarter KST.BYTA))))
                (c0:decimal (coin.get-balance byta-stoa))
                (i0:decimal (ref-DPTF::UR_AccountSupply ignis KST.BYTA))
            )
            (ref-TS01-C3::SWP|C_Firestarter KST.BYTA)
            (let
                (
                    (stoa-spent:decimal (- c0 (coin.get-balance byta-stoa)))
                    (ignis-delta:decimal (- (ref-DPTF::UR_AccountSupply ignis KST.BYTA) i0))
                )
                (map print
                    [
                        (format "<<SWPX-14b>> quoted-ignis={} stoa-spent={} ignis-gained={}"
                            [quoted stoa-spent ignis-delta])
                        ;;the sheet's claim, now measured rather than read off a legend
                        (expect "<<SWPX-14b>> firestarting takes EXACTLY 10.0 native STOA and nothing else"
                            10.0 stoa-spent)
                        ;;GS-15: the preview says free, and the balance says the preview is right --
                        ;;IGNIS moves UP. A charge would have to be netted out of the payout to hide,
                        ;;which the STOA assertion above already excludes as the only outflow.
                        (expect "<<SWPX-14b>> ...and the firestarter's IGNIS goes UP, it is not charged"
                            true (> ignis-delta 0.0))
                        (expect "<<SWPX-14b>> INFO_SWP|Firestarter quotes ZERO ignis-need, matching the charge"
                            0.0 quoted)
                    ])
            )
        )
    )
    ""
)
(print "===^^^===")
(env-sigs [])
(commit-tx)

;;|| NEXT >
