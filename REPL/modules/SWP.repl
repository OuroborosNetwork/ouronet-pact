(begin-tx "SWP-G13 — the idempotent-flag family, and an operation offered to the wrong pool TYPE")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(namespace "ouronet-ns")
(print "--- [SWP-G13 · 01 · no-op flag writes, and pool-type gating] ---")
;;Three flags refuse a write that would not change anything: the global liquid boost, a pool's
;;can-change-owner, and its can-add. Each emits an event and bills IGNIS, so a silent no-op would
;;leave an audit record of a change that never happened.
;;
;;Every case reads the CURRENT value and feeds it straight back, so the tests stay correct whatever
;;state earlier blocks leave behind — including SWP-G11, which toggles the swap flag twice.
;;
;;The last assertion is a different idea: ModifyWeights is meaningful only for a WEIGHTED pool, and
;;this suite's standard pool is stable. Offering it weights is refused on pool TYPE, not on the
;;weights themselves — the vector passed sums to exactly 1.0 so the weight-sum guard cannot be what
;;answers.
;;==== SWP-G13 — the idempotent-flag family, and an operation offered to the wrong pool TYPE · 01 · env-sigs (caps) ==== 
(print "--- [SWP-G13 — the idempotent-flag family, and an operation offered to the wrong pool TYPE · 01 · env-sigs (caps)] ---")
(env-sigs [{ "key": "PK_AncientHodler", "caps": [] }])
;;==== SWP-G13 — the idempotent-flag family, and an operation offered to the wrong pool TYPE · 02 · let / invocation ==== 
(print "--- [SWP-G13 — the idempotent-flag family, and an operation offered to the wrong pool TYPE · 02 · let / invocation] ---")
(let
    (
        (ref-TS01-A:module{TalosStageOne_AdminV2} TS01-A)
        (ref-TS01-C3:module{TalosStageOne_ClientThreeV4} TS01-C3)
        (ref-SWP:module{SwapperV4} SWP)
        (pool:string "S|DLK-98c486052a51|OURO-98c486052a51|DWK-98c486052a51")
    )
    (map print
        [
            (expect-failure "<<SWP-G13>> setting the liquid boost to the value it already holds is refused"
                "Liquid Boost already set to"
                (ref-TS01-A::SWP|A_UpdateLiquidBoost KST.ANHD (ref-SWP::UR_LiquidBoost)))
            (expect-failure "<<SWP-G13>> ...and can-change-owner likewise"
                "Similar boolean unallowed for <can-change-owner>"
                (ref-TS01-C3::SWP|C_ModifyCanChangeOwner KST.ANHD (SWP.UR_OwnerKonto pool) pool
                    (ref-SWP::UR_CanChangeOwner pool)))
            (expect-failure "<<SWP-G13>> ...and can-add likewise"
                "Similar boolean unallowed for <can-add> or <can-swap>"
                (ref-TS01-C3::SWP|C_ToggleAddLiquidity KST.ANHD pool (ref-SWP::UR_CanAdd pool)))
            ;;weights summing to exactly 1.0, so only the pool TYPE is wrong
            (expect-failure "<<SWP-G13>> changing weights on a STABLE pool is refused on pool type"
                "Changing weights available only for weighted Pools"
                (ref-TS01-C3::SWP|C_ModifyWeights KST.ANHD (SWP.UR_OwnerKonto pool) pool [0.5 0.3 0.2]))
        ]
    )
    ""
)
(env-sigs [])
(commit-tx)

