(begin-tx "SWP-I8 — INFO_SWP|EnableFrozenLP: a conditional STOA leg charged two modules down")
(env-gasmodel "table")(env-gaslimit 100000000)(env-gas 0)
(namespace "ouronet-ns")
(print "--- [SWP-I8 · 01 · open the frozen-LP lane] ---")
;;FUNCTION COVERAGE (G6) — `INFO_SWP|EnableFrozenLP`, per the owner's spec.
;;
;;THE STRUCTURE THAT MAKES THIS WORTH MEASURING. The preview decides its STOA leg LOCALLY, from the
;;pool's own link state and the native-gas switch. The charge happens two modules away, inside
;;`VST::XI_CreateSpecialTrueFungibleLink`, where the same condition is recomputed independently.
;;Two separately-derived conditionals that must agree — and the STOA collector is buried in an `XI_`,
;;which is exactly where five VST preview defects hid from a sweep earlier tonight.
;;
;;ONE SHOT, AND IRREVERSIBLE IN PRINCIPLE: `EnableFrozenLP` enforces the flag is currently false and nothing
;;ever writes it back. Only two pools in this suite are still eligible. The `rollback-tx` is what
;;makes the measurement repeatable — without it, the first run would consume the fixture.
(let
    (
        (ref-DALOS:module{OuronetDalosV2} DALOS)
    )
    ;;The STOA leg is `UR_UsagePrice "dptf"`, split 10/20/30/40 across the four fee targets, so it
    ;;needs one managed `coin.TRANSFER` per leg, sized from the same split the collector uses.
    (let ((split-stoa:[decimal]
              (ref-DALOS::URC_SplitSTOAPrices KST.ANHD (ref-DALOS::UR_UsagePrice "dptf"))))
        (env-sigs
            [ { "key": "PK_AncientHodler", "caps": [] }
              { "key": "6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263"
              , "caps":
                [ (coin.TRANSFER "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263"
                      "k:50d6c59b21e5e6e55baecaa75a1007de37576bde12d8230dc82459cc01b9484b" (at 2 split-stoa))
                  (coin.TRANSFER "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263"
                      "k:0cb30c0121ff919266121a99ff9359871818932211df94dae4137c29bc0e8f7e" (at 0 split-stoa))
                  (coin.TRANSFER "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263"
                      "c:XM-pkmuB5XUQlp87ZYSbfKt8qzmHY6O2EHAzMRVBt3k" (at 3 split-stoa))
                  (coin.TRANSFER "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263"
                      "c:iQQFWj6gWtpGEzhM_O5ekW1QtnQQy55R8BRPGhj_0FU" (at 1 split-stoa)) ] } ]
        )
    )
)
(let
    (
        (ref-TS01-C3:module{TalosStageOne_ClientThreeV4} TS01-C3)
        (ref-DALOS:module{OuronetDalosV2} DALOS)
        (wp:string "W|DLK-98c486052a51|BUSD-98c486052a51|TUSD-98c486052a51|USDC-98c486052a51")
        (patron:string KST.ANHD)
    )
    (let
        (
            (predicted:object{OuronetInfoV2.ClientInfo} (INFO-ONE.INFO_SWP|EnableFrozenLP patron wp))
            (stoa-acct:string (ref-DALOS::UR_AccountStoa patron))
        )
        (let
            (
                (stoa-before:decimal (coin.get-balance stoa-acct))
                (ignis-before:decimal (ref-DALOS::UR_TF_AccountSupply patron false))
                (m (ref-TS01-C3::SWP|C_EnableFrozenLP patron (SWP.UR_OwnerKonto wp) wp))
            )
            (map print
                [
                    (format "<<SWP-I8>> IGNIS predicted={} real={} | STOA predicted={} real={}"
                        [(at "ignis-need" (at "ignis" predicted))
                         (- ignis-before (ref-DALOS::UR_TF_AccountSupply patron false))
                         (at "stoa-need" (at "stoa" predicted))
                         (- stoa-before (coin.get-balance stoa-acct))])
                    (expect "<<SWP-I8>> the STOA quote equals the STOA charged, two modules down"
                        (- stoa-before (coin.get-balance stoa-acct))
                        (at "stoa-need" (at "stoa" predicted)))
                    (expect "<<SWP-I8>> ...and enabling the lane is NOT free in STOA"
                        true (> (- stoa-before (coin.get-balance stoa-acct)) 0.0))
                    ;;WAS A FINDING — the IGNIS halves did NOT agree, same root cause as
                    ;;`modules/VST.repl <<VST-I1>>`: both of these previews route through
                    ;;`VST::URCi_CreateSpecial*FungibleLink`, and it USED to over-quote by ~119: the
                    ;;reader added a `vst-link` deterrence the exec never charged, while under-modelling
                    ;;the transfer-role toggle as a hand-made 4.0 against a real 59.0. Wrong in opposite
                    ;;directions, so it was pinned as a FINDING rather than guessed at.
                    ;;
                    ;;RESOLVED 2026-09-14 by the owner's design call: a special link costs a small
                    ;;DETERRENCE plus payment IN FULL for the token it issues. The exec was
                    ;;under-collecting the deterrence (a revenue bug) and the preview was under-modelling
                    ;;the toggle; both are corrected in `11_VST.pact`, with the deterrence now read from
                    ;;ONE source both sides call. Full write-up at `modules/VST.repl <<VST-I1>>`.
                    ;;This block is one of the SEVEN previews that share the reader pair, so it is the
                    ;;independent check that the repair holds through SWP's own call path and not just
                    ;;through VST's.
                    (expect "<<SWP-I8>> the IGNIS quote equals the IGNIS charged"
                        (- ignis-before (ref-DALOS::UR_TF_AccountSupply patron false))
                        (at "ignis-need" (at "ignis" predicted)))
                ]
            )
        )
    )
    ""
)
(env-sigs [])
(rollback-tx)

