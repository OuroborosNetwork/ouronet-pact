(begin-tx "SWP-G4 — the slippage constructor's two input rules")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
;;==== SWP-G4 — the slippage constructor's two input rules · 01 · namespace ==== ==================
(print "--- [SWP-G4 — the slippage constructor's two input rules · 01 · namespace] ---")
(namespace "ouronet-ns")
(print "--- [SWP-G4 · 01 · slippage precision and bounds] ---")
;;P3.3. UDC_SlippageObject validates the slippage argument twice, and the two rules are
;;independent: a PRECISION rule (at most 2 decimals) and a BOUNDS rule (-1.0 for none, otherwise
;;0.0 < s <= 50.0). Each needs its own input -- 1.005 breaks precision while sitting inside the
;;bounds, and 60.0 / 0.0 break the bounds while being precision-clean -- so neither trip can be
;;explained by the other rule.
;;
;;The constructor is not pure: its let prices the swap (URCv_Swap) and reads the output token's
;;decimals before either enforce, so a real pool and a well-formed swap object are required. Both
;;come from the same pool2 fixture SWP-G1 uses.
;;
;;ATTRIBUTION CAVEAT: UDC_SpawnSmartSwapSlippageBounds (same module, ~60 lines above) carries
;;these two messages BYTE-IDENTICALLY. Same module, so neither the text nor the module reference
;;can separate them and _enforce_coverage.py will credit both sites for these assertions. Only
;;UDC_SlippageObject is actually proven here; the Smart-Swap constructor needs a live multi-hop
;;route (URC_HopperActive) and remains unpinned in fact if not in the count.
;;==== SWP-G4 — the slippage constructor's two input rules · 02 · let / invocation ==== ===========
(print "--- [SWP-G4 — the slippage constructor's two input rules · 02 · let / invocation] ---")
(let
    (
        (ref-SWPU:module{SwapperUsageV3} SWPU)
        (ref-SWP:module{SwapperV4} SWP)
        (ref-U|SWP:module{UtilitySwpV2} U|SWP)
        (pool:string "S|DLK-98c486052a51|OURO-98c486052a51|DWK-98c486052a51")
    )
    (let
        (
            (toks:[string] (ref-SWP::UR_PoolTokens pool))
        )
        (let
            (
                (dsid:object{UtilitySwpV2.DirectSwapInputData}
                    (ref-U|SWP::UDC_DirectSwapInputData [(at 0 toks)] [1.0] (at 1 toks)))
            )
            (map print
                [
                    ;;the object really is well-formed, so the trips below are about SLIPPAGE only
                    (expect "<<SWP-G4>> a valid slippage builds an object"
                        true (!= "" (format "{}" [(ref-SWPU::UDC_SlippageObject pool dsid 1.0)])))
                    (expect "<<SWP-G4>> -1.0 (no slippage) is accepted"
                        true (!= "" (format "{}" [(ref-SWPU::UDC_SlippageObject pool dsid -1.0)])))
                    (expect "<<SWP-G4>> the 50.0 ceiling is INCLUSIVE"
                        true (!= "" (format "{}" [(ref-SWPU::UDC_SlippageObject pool dsid 50.0)])))
                    ;;PRECISION rule, on a value that is inside the bounds
                    (expect-failure "<<SWP-G4>> three decimals of slippage are refused"
                        "is not slippage conform decimal wise"
                        (ref-SWPU::UDC_SlippageObject pool dsid 1.005))
                    ;;BOUNDS rule, on precision-clean values at each end
                    (expect-failure "<<SWP-G4>> slippage above the 50.0 ceiling is refused"
                        "maximum 50.0, or -1.0 for no slippage"
                        (ref-SWPU::UDC_SlippageObject pool dsid 60.0))
                    (expect-failure "<<SWP-G4>> zero slippage is refused (the floor is exclusive)"
                        "maximum 50.0, or -1.0 for no slippage"
                        (ref-SWPU::UDC_SlippageObject pool dsid 0.0))
                ]
            )
            ""
        )
    )
)
(commit-tx)

