;;
;; REPL/modules/LIQUID.repl — canonical integration layout (OuronetInformational/ARCHITECTURE/REPL_AND_TESTS.md)
;;   Inter-tx:   ;;|| NEXT >  (same three lines as REPL/Stage_01/[2.2]_Core.repl)
;;   Intra-tx:   ;;==== <TX label> · mm · <slug> ====  + next-line (print "--- [<label> · mm · …] ---"); mm = 01.. within each (begin-tx …) (see OuronetInformational/ARCHITECTURE/REPL_AND_TESTS.md).
;;   format "{}": Talos / module echoes and (env-gas) — document additional prefixes in this file's (print …) lines as needed.
;;
(print "")
(print "================================================================")
(print "FILE  REPL/modules/LIQUID.repl")
(print "================================================================")
(print "Legend (terminal observability): see ;; preface; echoes use <(…)> where helpful.")
(print "Source: ;;|| NEXT > between txs; ;;==== … · mm · … ==== + banner before each begin-tx.")
(print "")
;; REPL/modules/LIQUID.repl — STANDALONE LIQUID / LQD tester (STOA wrapping + admin migration).
;;
;; New in P2. Two entrypoints here appeared in NO live invocation anywhere in the suite:
;;   LQD|C_UnwrapStoa        -- commented out at [6.7]_VST.repl:356 ("INSUFICCINET when standalone")
;;   LIQUID|A_MigrateLiquidFunds
;; The second is the twin of DALOS|A_MigrateLiquidFunds. The DALOS one is covered; this one was
;; counted as covered only because the ledger matched raw source text (Rule 10).
;;
;; Run: cd REPL && pact modules/LIQUID.repl
(load "../deploy-stage00.repl")
(load "../deploy-stage01.repl")

;;|| NEXT >
;;
(begin-tx "LQD-01 — C_WrapStoa mints wrapped STOA against native STOA")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(namespace "ouronet-ns")
(print "--- [LQD-01 · 01 · wrap] ---")
;; The LIQUID smart account "c:ZNfuj3iZI83n7MUSKGuoXoSxFg1cyMxCzB3szUHVvrI" is where native STOA
;; is escrowed while its wrapped twin circulates. The wrapper signs a coin.TRANSFER into it.
;;==== LQD-01 — C_WrapStoa mints wrapped STOA against native STOA · 01 · env-sigs (caps) ==== =====
(print "--- [LQD-01 — C_WrapStoa mints wrapped STOA against native STOA · 01 · env-sigs (caps)] ---")
(env-sigs
    [
        { "key": "PK_AncientHodler", "caps": [] }
        { "key": "6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263",
          "caps": [ (coin.TRANSFER
                        "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263"
                        "c:ZNfuj3iZI83n7MUSKGuoXoSxFg1cyMxCzB3szUHVvrI" 5000.0) ]
        }
    ]
)
;;==== LQD-01 — C_WrapStoa mints wrapped STOA against native STOA · 02 · let / invocation ==== ====
(print "--- [LQD-01 — C_WrapStoa mints wrapped STOA against native STOA · 02 · let / invocation] ---")
(let
    (
        (ref-DALOS:module{OuronetDalosV2} DALOS)
        (ref-DPTF:module{DemiourgosPactTrueFungibleV2} DPTF)
        (ref-TS01-C2:module{TalosStageOne_ClientTwoV2} TS01-C2)
        (patron:string KST.ANHD)
        (lq-stoa:string "c:ZNfuj3iZI83n7MUSKGuoXoSxFg1cyMxCzB3szUHVvrI")
    )
    (let
        (
            (w:string (ref-DALOS::UR_WrappedStoaID))
            (native0:decimal (coin.get-balance lq-stoa))
            (held0:decimal (try 0.0 (ref-DPTF::UR_AccountSupply (ref-DALOS::UR_WrappedStoaID) patron)))
            (supply0:decimal (ref-DPTF::UR_Supply (ref-DALOS::UR_WrappedStoaID)))
            ;;FUNCTION COVERAGE (G6) — `INFO_LIQUID|WrapStoa`, per the owner's spec: an INFO_ must
            ;;report the same cost the op actually charges. Template: `modules/ATS.repl <<ATS-I1>>`.
            ;;NOTE the name skew — the preview is `INFO_LIQUID|*` while the Talos op is `LQD|C_*`, so
            ;;the usual `INFO_<MOD>|<Op>` -> `<MOD>|C_<Op>` pairing does NOT hold here. Anything that
            ;;matches previews to ops by name alone will report this family as having no counterpart.
            (predicted:object{OuronetInfoV2.ClientInfo}
                (INFO-ONE.INFO_LIQUID|WrapStoa patron patron 5000.0))
            (ignis-before:decimal (ref-DALOS::UR_TF_AccountSupply patron false))
        )
        (ref-TS01-C2::LQD|C_WrapStoa patron patron 5000.0)
        (map print
            [
                (expect "<<LQD-01>> the wrapper receives exactly the wrapped amount"
                    (+ held0 5000.0) (ref-DPTF::UR_AccountSupply w patron))
                ;; Wrapping MINTS -- the wrapped supply grows, it is not moved from a float.
                (expect "<<LQD-01>> wrapped supply grew by the same amount"
                    (+ supply0 5000.0) (ref-DPTF::UR_Supply w))
                ;; INVARIANT: every wrapped token is backed 1:1 by native STOA escrowed in the
                ;; LIQUID account. This is the property the whole module exists to maintain.
                (expect "<<LQD-01>> INVARIANT: native STOA escrowed matches the wrapping"
                    (+ native0 5000.0) (coin.get-balance lq-stoa))
                ;;...and the quote the client was shown for this wrap is the price they paid. The
                ;;5000.0 native STOA above is the ESCROW, not a fee — it comes back on unwrap — so the
                ;;only thing the preview has to price is the IGNIS, and that is what is checked.
                (expect "<<LQD-01>> the preview's IGNIS quote equals what the wrap actually charged"
                    (- ignis-before (ref-DALOS::UR_TF_AccountSupply patron false))
                    (at "ignis-need" (at "ignis" predicted)))
                (expect "<<LQD-01>> ...and wrapping is NOT free"
                    true (> (- ignis-before (ref-DALOS::UR_TF_AccountSupply patron false)) 0.0))
            ]
        )
    )
    ""
)
(print "===^^^===")
(commit-tx)

;;|| NEXT >
;;
(begin-tx "LQD-02 — C_UnwrapStoa is the exact inverse (never exercised before)")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(namespace "ouronet-ns")
(print "--- [LQD-02 · 01 · unwrap] ---")
;; The unwrap direction moves native STOA OUT of the LIQUID escrow, so the transaction must carry
;; a coin.TRANSFER managed capability whose SENDER is the escrow account -- an account the caller
;; does not own and has no key for. LIQUID.pact:516 has the in-code install commented out with
;; the note "Capability is added instead in the JavaCode", so this requirement lives entirely
;; off-chain and is invisible in the entrypoint signature. The guard itself is satisfied inside
;; the module (LIQUID|C>UNWRAP composes LIQUID|NATIVE-AUTOMATIC, which is what the escrow's
;; capability guard wants); it is only the MANAGED-cap install that must come from outside.
;;==== LQD-02 — C_UnwrapStoa is the exact inverse (never exercised before) · 01 · env-sigs (caps) ==== 
(print "--- [LQD-02 — C_UnwrapStoa is the exact inverse (never exercised before) · 01 · env-sigs (caps)] ---")
(env-sigs
    [
        { "key": "PK_AncientHodler", "caps": [] }
        { "key": "6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263",
          "caps": [ (coin.TRANSFER "c:ZNfuj3iZI83n7MUSKGuoXoSxFg1cyMxCzB3szUHVvrI"
                        "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263" 2000.0) ]
        }
    ]
)
;;==== LQD-02 — C_UnwrapStoa is the exact inverse (never exercised before) · 02 · let / invocation ==== 
(print "--- [LQD-02 — C_UnwrapStoa is the exact inverse (never exercised before) · 02 · let / invocation] ---")
(let
    (
        (ref-DALOS:module{OuronetDalosV2} DALOS)
        (ref-DPTF:module{DemiourgosPactTrueFungibleV2} DPTF)
        (ref-TS01-C2:module{TalosStageOne_ClientTwoV2} TS01-C2)
        (patron:string KST.ANHD)
        (lq-stoa:string "c:ZNfuj3iZI83n7MUSKGuoXoSxFg1cyMxCzB3szUHVvrI")
    )
    (let
        (
            (w:string (ref-DALOS::UR_WrappedStoaID))
            (native0:decimal (coin.get-balance lq-stoa))
            (held0:decimal (ref-DPTF::UR_AccountSupply (ref-DALOS::UR_WrappedStoaID) patron))
            (supply0:decimal (ref-DPTF::UR_Supply (ref-DALOS::UR_WrappedStoaID)))
        )
        ;; METAMORPHIC: unwrap part of what LQD-01 wrapped. Wrap-then-unwrap must be the identity
        ;; on every balance it touched -- which is a stronger statement than "unwrap ran".
        (ref-TS01-C2::LQD|C_UnwrapStoa patron patron 2000.0)
        (map print
            [
                (expect "<<LQD-02>> the unwrapper is debited the wrapped amount"
                    (- held0 2000.0) (ref-DPTF::UR_AccountSupply w patron))
                ;; Unwrapping BURNS -- the mirror of the mint in LQD-01.
                (expect "<<LQD-02>> wrapped supply shrank by the same amount"
                    (- supply0 2000.0) (ref-DPTF::UR_Supply w))
                (expect "<<LQD-02>> INVARIANT: the escrow released exactly as much native STOA"
                    (- native0 2000.0) (coin.get-balance lq-stoa))
            ]
        )
    )
    ""
)
(print "--- [LQD-02 · 02 · the signed escrow cap is a hard ceiling] ---")
;; The cap signed above was for exactly 2000.0 and LQD-02 * 01 consumed all of it. A further
;; unwrap of even 1.0 in the same transaction is refused by the MANAGED capability, not by any
;; Ouronet guard. So the amount a client signs for is the real per-transaction unwrap limit --
;; sign too little and the call fails with a coin-level message that names no Ouronet concept.
;; (In a transaction that signs nothing at all, the same call dies on "Managed capability not
;; installed" instead -- that is what LIQUID.pact:516's commented-out install would have avoided.)
(let
    (
        (ref-TS01-C2:module{TalosStageOne_ClientTwoV2} TS01-C2)
        (patron:string KST.ANHD)
    )
    (map print
        [
            (expect-failure "<<LQD-02>> FINDING: unwrapping past the signed cap is refused by coin, not by Ouronet"
                "STOA TRANSFER exceeded for balance"
                (ref-TS01-C2::LQD|C_UnwrapStoa patron patron 1.0))
        ]
    )
    ""
)
(print "--- [LQD-02 · 03 · you cannot unwrap what you do not hold] ---")
(let
    (
        (ref-DALOS:module{OuronetDalosV2} DALOS)
        (ref-DPTF:module{DemiourgosPactTrueFungibleV2} DPTF)
        (ref-TS01-C2:module{TalosStageOne_ClientTwoV2} TS01-C2)
        (patron:string KST.ANHD)
    )
    (let ((held:decimal (ref-DPTF::UR_AccountSupply (ref-DALOS::UR_WrappedStoaID) patron)))
        (map print
            [
                (expect-failure "<<LQD-02>> unwrapping more than held is refused"
                    "into the negatives"
                    (ref-TS01-C2::LQD|C_UnwrapStoa patron patron (+ held 1.0)))
                (expect "<<LQD-02>> and the holding is untouched by the refusal"
                    held (ref-DPTF::UR_AccountSupply (ref-DALOS::UR_WrappedStoaID) patron))
            ]
        )
    )
    ""
)
(print "===^^^===")
(commit-tx)

;;|| NEXT >
