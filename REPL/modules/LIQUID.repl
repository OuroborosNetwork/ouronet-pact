(begin-tx "LQD-G1 — UEV_IzLiquidStakingLive: its three deep guards, all four states")
(env-gasmodel "table")(env-gaslimit 100000000)(env-gas 0)
;;==== LQD-G1 — UEV_IzLiquidStakingLive: its three deep guards, all four states · 01 · namespace ==== 
(print "--- [LQD-G1 — UEV_IzLiquidStakingLive: its three deep guards, all four states · 01 · namespace] ---")
(namespace "ouronet-ns")
(print "--- [LQD-G1 · 01 · the liveness guard on a CONFIGURED chain] ---")
;;CORRECTION TO AN EARLIER FINDING, and the reason this test exists.
;;
;;I previously filed `UEV_IzLiquidStakingLive` as "reports LIVE when liquid staking is not live",
;;pinned at `[4.0] <<TX4.0-CONFIG>>`, and told the owner its three deep guards were UNPINNABLE.
;;Owner ruling: "liquid staking is live on mainnet, i dont know what you mean by saying it without
;;an ATS pair?" -- correct on both counts, and the second half is the useful half.
;;
;;What I had measured was one transaction inside the BOOT SEQUENCE of `[4.0]`, at the moment both
;;STOA ids are set and the Autostake pair does not exist yet. That window is real but it is a boot
;;artifact: by the end of the same file the pair exists. On THIS chain -- a fully deployed one, the
;;same shape as mainnet -- the pair is `StoaLiquindex-98c486052a51`, and the guard returns true
;;because it is genuinely live. So the function is NOT wrong on a configured chain, and calling it a
;;defect was an overstatement of a narrow robustness gap.
;;
;;And the "unpinnable" claim was simply a failure of imagination on my part. `env-module-admin`
;;grants DPTF admin in a REPL, so the two role fields can be driven to any state directly, and
;;`rollback-tx` discards the whole thing -- so all three deep guards are reachable after all, and
;;the tests below pin them. That is the actual value here: three guards that the coverage ledger
;;had written off as unreachable are now covered, state-driven rather than argument-driven.
;;
;;Everything below runs in ONE transaction that ends in `rollback-tx`, never `commit-tx`. LQD-G2
;;is the proof that nothing leaked.
(env-module-admin DPTF)
;;==== LQD-G1 — UEV_IzLiquidStakingLive: its three deep guards, all four states · 02 · let / invocation ==== 
(print "--- [LQD-G1 — UEV_IzLiquidStakingLive: its three deep guards, all four states · 02 · let / invocation] ---")
(let
    (
        (w:string (DALOS.UR_WrappedStoaID))
        (l:string (DALOS.UR_SilverStoaID))
        (pair:string "StoaLiquindex-98c486052a51")
    )
    (map print
        [
            ;;STATE 1 -- as deployed. The pair exists, so the guard is true for the RIGHT reason:
            ;;wrapped STOA is the reward token of exactly one pair, liquid STOA is the
            ;;reward-bearing token of exactly one pair, and it is the SAME pair.
            (expect "<<LQD-G1>> on a configured chain the pair exists and liveness is genuine"
                [[pair] [pair]] [(DPTF.UR_RewardToken w) (DPTF.UR_RewardBearingToken l)])
            (expect "<<LQD-G1>> ...so the guard passes, and passes because it is actually live"
                true (LIQUID.UEV_IzLiquidStakingLive))
        ]
    )
    ;;STATE 2 -- both tokens in a pair, but NOT the same pair. This is the third guard's case, and
    ;;the one I had called unreachable. Pointing liquid STOA at a different pair id reaches it.
    (update DPTF.DPTF|PropertiesTable l { "reward-bearing-token" : ["StoaLiquindex-OTHER"] })
    (print
        (expect-failure "<<LQD-G1>> wrapped and liquid in DIFFERENT pairs is refused (3rd guard)"
            "Wrapped and Liquid Stoa are not part of the same ASTS Pair"
            (LIQUID.UEV_IzLiquidStakingLive)))
    ;;STATE 3 -- wrapped STOA in TWO pairs. First guard. A length-1 test CAN catch this; what it
    ;;cannot catch is length 1 that happens to be the sentinel, which is STATE 4.
    (update DPTF.DPTF|PropertiesTable l { "reward-bearing-token" : [pair] })
    (update DPTF.DPTF|PropertiesTable w { "reward-token" : [pair "StoaLiquindex-SECOND"] })
    (print
        (expect-failure "<<LQD-G1>> wrapped STOA in two pairs is refused (1st guard)"
            "Wrapped-Stoa cannot ever be part of another ATS-Pair"
            (LIQUID.UEV_IzLiquidStakingLive)))
    ;;STATE 4 -- liquid STOA in TWO pairs. Second guard, the twin of the first. Both are asserted
    ;;because the two reads are different functions on different fields: a copy-paste slip that
    ;;read `w` twice would pass STATE 3 and fail only here.
    (update DPTF.DPTF|PropertiesTable w { "reward-token" : [pair] })
    (update DPTF.DPTF|PropertiesTable l { "reward-bearing-token" : [pair "StoaLiquindex-SECOND"] })
    (print
        (expect-failure "<<LQD-G1>> liquid STOA in two pairs is refused (2nd guard)"
            "Liquid-Stoa cannot ever be part of another ATS-Pair"
            (LIQUID.UEV_IzLiquidStakingLive)))
    ;;STATE 5 -- the robustness gap, stated at its true size. Drive both fields back to the [BAR]
    ;;sentinel, i.e. "not part of any pair": the ids are set but no pair exists. The guard returns
    ;;TRUE. `UR_RewardToken` returns a ONE-element `[BAR]` for "none", so `(= (length …) 1)` cannot
    ;;tell "exactly one pair" from "no pair", and the third guard then compares BAR to BAR and
    ;;agrees. All three pass vacuously.
    ;;
    ;;SCOPE, honestly: this is reachable only between the transaction that sets the two STOA ids and
    ;;the transaction that creates the pair. Mainnet is past that window and cannot re-enter it --
    ;;pairs are not deleted. It is a misconfiguration/boot-robustness gap, NOT a live defect, and
    ;;the worst outcome in that window is a downstream abort with a less clear message instead of
    ;;this guard's own. Recorded, not escalated.
    ;;
    ;;The in-repo fix, if it is ever wanted, is one expression: DPOF::UEV_MoveRoleCheck meets the
    ;;identical sentinel on UR_Verum5 and normalises it before testing length --
    ;;`(if (and (= lvf 1) (= verum-five [BAR])) 0 lvf)`.
    (update DPTF.DPTF|PropertiesTable w { "reward-token" : [(U|CT.CT_BAR)] })
    (update DPTF.DPTF|PropertiesTable l { "reward-bearing-token" : [(U|CT.CT_BAR)] })
    (map print
        [
            (expect "<<LQD-G1>> with both fields at the BAR sentinel, the guard still says LIVE"
                true (LIQUID.UEV_IzLiquidStakingLive))
            (expect "<<LQD-G1>> ...because the sentinel is a ONE-element list, so length-1 passes"
                [1 1]
                [(length (DPTF.UR_RewardToken w)) (length (DPTF.UR_RewardBearingToken l))])
        ]
    )
)
;;ROLLBACK, not commit. Every write above is discarded.
(rollback-tx)

;;|| NEXT >
;;
(begin-tx "LQD-G2 — the rollback really discarded the role surgery")
(namespace "ouronet-ns")
(print "--- [LQD-G2 · 01 · no leakage] ---")
;;LQD-G1 rewrote two fields of a sovereign table five times. This asserts that none of it survived,
;;so a later suite cannot inherit a fabricated pair. Worth its own transaction: a `commit-tx` typo
;;in LQD-G1 would leave the chain claiming liquid STOA belongs to a pair that does not exist, and
;;every downstream liveness check would silently agree.
(map print
    [
        (expect "<<LQD-G2>> the real pair is back in both role fields"
            [["StoaLiquindex-98c486052a51"] ["StoaLiquindex-98c486052a51"]]
            [(DPTF.UR_RewardToken (DALOS.UR_WrappedStoaID))
             (DPTF.UR_RewardBearingToken (DALOS.UR_SilverStoaID))])
        (expect "<<LQD-G2>> ...and liveness is genuine again, not sentinel-vacuous"
            true (LIQUID.UEV_IzLiquidStakingLive))
    ]
)
(commit-tx)
(print "")
(print "=== END modules/LIQUID.repl ===")

;;|| NEXT >
;;
(begin-tx "LQD-I2 — INFO_LIQUID|UnwrapStoa quote vs measured charge")
(env-gasmodel "table")(env-gaslimit 100000000)(env-gas 0)
(namespace "ouronet-ns")
(print "--- [LQD-I2 · 01 · release native STOA from the escrow] ---")
;;FUNCTION COVERAGE (G6) — `INFO_LIQUID|UnwrapStoa`, per the owner's spec: an INFO_ must report the same cost
;;the op actually charges. Template and rationale: `modules/ATS.repl <<ATS-I1>>`.
;;NAME SKEW, worth restating at every member of this family: the preview is `INFO_LIQUID|*` while the
;;Talos op is `LQD|C_*`, so the usual `INFO_<MOD>|<Op>` -> `<MOD>|C_<Op>` pairing does NOT hold and any
;;tool that matches previews to ops by name alone reports these as having no counterpart.
;;The unwrap direction moves native STOA OUT of an escrow the caller has no key for, so the managed
;;cap's SENDER is the escrow account. LIQUID.pact:516 has the in-code install commented out with the
;;note that it is added \"in the JavaCode\" — i.e. the requirement lives off-chain and is invisible in
;;the entrypoint signature. LQD-02 established this shape.
(env-sigs
    [
        { "key": "PK_AncientHodler", "caps": [] }
        { "key": "6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263",
          "caps":
          [ ;;the wrap leg in setup: patron -> escrow
            (coin.TRANSFER "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263"
                "c:ZNfuj3iZI83n7MUSKGuoXoSxFg1cyMxCzB3szUHVvrI" 100.0)
            ;;the unwrap leg being measured: escrow -> patron
            (coin.TRANSFER "c:ZNfuj3iZI83n7MUSKGuoXoSxFg1cyMxCzB3szUHVvrI"
                "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263" 100.0) ] }
    ]
)
(let
    (
        (ref-TS01-C2:module{TalosStageOne_ClientTwoV2} TS01-C2)
        (ref-TS01-A:module{TalosStageOne_AdminV2} TS01-A)
        (ref-DALOS:module{OuronetDalosV2} DALOS)
        (patron:string KST.ANHD)
    )
    ;;SETUP — LQD-03 leaves the Global Administrative Pause ON and COMMITTED (the migration it tests
    ;;requires it), so every Talos client op after that point is refused by `P|TS` before any cost is
    ;;reached. GAP is lifted here and the whole block rolls back, leaving the file as LQD-03 left it.
    (ref-TS01-A::DALOS|A_ToggleGAP KST.ANHD false)
    ;;...and re-fund the escrow. LQD-03 MIGRATED every native STOA out of it, so an unwrap at this
    ;;point in the file has nothing to release ("The amount of 100.0 is to great to debit"). The wrap
    ;;is a billed op and closes before `ignis-before` is read.
    (ref-TS01-C2::LQD|C_WrapStoa patron patron 100.0)
    (let
        (
            (predicted:object{OuronetInfoV2.ClientInfo} (INFO-ONE.INFO_LIQUID|UnwrapStoa patron patron 100.0))
            (ignis-before:decimal (ref-DALOS::UR_TF_AccountSupply patron false))
            (m (ref-TS01-C2::LQD|C_UnwrapStoa patron patron 100.0))
        )
        (map print
            [
                (expect "<<LQD-I2>> INFO_LIQUID|UnwrapStoa's quote equals what the op actually charged"
                    (- ignis-before (ref-DALOS::UR_TF_AccountSupply patron false))
                    (at "ignis-need" (at "ignis" predicted)))
                (expect "<<LQD-I2>> ...and it is a real, non-zero charge"
                    true (> (- ignis-before (ref-DALOS::UR_TF_AccountSupply patron false)) 0.0))
            ]
        )
    )
    ""
)
(env-sigs [])
(rollback-tx)

