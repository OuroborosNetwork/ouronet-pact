(begin-tx "RDUI-11 -- O-UI-EIGHT: the True Fungibles page, and a list that survives a bad member")
(env-gasmodel "table")(env-gaslimit 100000000)(env-gas 0)
;;==== RDUI-11 · 01 · namespace ==== ==============================================================
(print "--- [RDUI-11 · 01 · namespace] ---")
(namespace "ouronet-ns")
;;==== RDUI-11 · 02 · wallet composer, degradation, buttons ==== ==================================
(print "--- [RDUI-11 · 02 · wallet composer, degradation, buttons] ---")
;;The degradation assertion is the one worth having. DPL-UR's three mappers fold with no guard,
;;so ONE unreadable token emptied the WHOLE list -- a thirty-token wallet blanked by a single
;;broken pool. Here the bad member degrades and its neighbours still render.
(let*
    ( (w:object (O-UI-EIGHT.URC_08|Wallet KST.ANHD))
      (held:[string] (at "held-tf" w))
      (mixed:[object] (O-UI-EIGHT.URC_03|TokenList KST.ANHD
                          [(at 0 held) "NO-SUCH-TOKEN-AT-ALL"])) )
    (map print
        [
            (expect "<<RDUI-11>> the wallet composer answers, and the fixture holds tokens"
                true (and (at "list-ok" w) (> (at "held-tf-number" w) 0)))
            (expect "<<RDUI-11>> it returns one row per held token"
                (at "held-tf-number" w) (length (at "entries" w)))
            (expect "<<RDUI-11>> every row in the fixture prices cleanly"
                true (fold (and) true
                        (map (lambda (e:object) (at "entry-ok" e)) (at "entries" w))))
            (expect "<<RDUI-11>> a BAD token id degrades to one dead row..."
                [true false]
                [(at "entry-ok" (at 0 mixed)) (at "entry-ok" (at 1 mixed))])
            (expect "<<RDUI-11>> ...and the list still has BOTH members -- the original mapper \
                \ returned nothing at all when any single token failed"
                2 (length mixed))
            ;;UDC_ZeroEntry must carry every key a live row carries, or a consumer indexing the
            ;;object hits key-not-found on precisely the rows that already went wrong.
            (expect "<<RDUI-11>> the dead row carries EVERY key a live one does -- a consumer \
                \ indexing the object must not hit key-not-found on the rows that already \
                \ went wrong"
                true
                (fold (and) true
                    (map (lambda (k:string) (contains k (at 1 mixed)))
                         ["t1" "t2" "wallet-supply" "dptf-supply" "wallet-worth-in-stoa"
                          "wallet-worth-in-dollarz" "token-worth-in-stoa"
                          "token-worth-in-dollarz" "entry-ok"])))
            ;;THE PRICE-FREE PATH. On 2026-09-25 both token pages went blank, and no balance was
            ;;ever wrong -- UR_AccountSupply answered for the very tokens rendering empty. The
            ;;price failed, and because supply and price shared one `let` the price took the
            ;;balance with it. `try` cannot help: a missing table raises an error that passes
            ;;straight through it. So the defence is a read that never asks for a price.
            (expect "<<RDUI-11>> URC_09|SuppliesOnly returns a row per token, with real supplies"
                [(length held) true]
                (let ((r:[object] (O-UI-EIGHT.URC_09|SuppliesOnly KST.ANHD held)))
                    [(length r)
                     (= (at "wallet-supply" (at 0 r))
                        (at "wallet-supply" (at 0 (at "entries" w))))]))
            (expect "<<RDUI-11>> ...and says so: priced false, worth fields blank"
                [false 0.0 "--"]
                (let ((e:object (at 0 (O-UI-EIGHT.URC_09|SuppliesOnly KST.ANHD held))))
                    [(at "priced" e) (at "wallet-worth-in-stoa" e)
                     (at "wallet-worth-in-dollarz" e)]))
            ;;It must carry every key the priced read does, or a consumer indexing the object
            ;;breaks on exactly the rows the degraded path exists to rescue.
            (expect "<<RDUI-11>> ...and carries every key the priced row carries"
                true
                (fold (and) true
                    (map (lambda (k:string)
                            (contains k (at 0 (O-UI-EIGHT.URC_09|SuppliesOnly KST.ANHD held))))
                         ["t1" "t2" "wallet-supply" "dptf-supply" "wallet-worth-in-stoa"
                          "wallet-worth-in-dollarz" "token-worth-in-stoa"
                          "token-worth-in-dollarz" "entry-ok"])))
            (expect "<<RDUI-11>> the button map answers for a held token"
                true (contains "transfer" (O-UI-EIGHT.URC_07|Buttons KST.ANHD (at 0 held))))
        ]
    )
)
(commit-tx)

