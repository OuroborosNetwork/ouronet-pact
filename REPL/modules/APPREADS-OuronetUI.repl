(begin-tx "RDUI-16 -- the wire contract: every key a consumer indexes, pinned")
(env-gasmodel "table")(env-gaslimit 200000000)(env-gas 0)
;;==== RDUI-16 · 01 · namespace ==== ==============================================================
(print "--- [RDUI-16 · 01 · namespace] ---")
(namespace "ouronet-ns")
(env-module-admin ouronet-ns.DPTF)
(env-module-admin ouronet-ns.DPOF)
(env-module-admin ouronet-ns.DPDC)
;;==== RDUI-16 · 02 · contracted key sets ==== ====================================================
(print "--- [RDUI-16 · 02 · contracted key sets] ---")
;;WHAT THIS REPLACES, AND WHY IT IS DIFFERENT IN KIND.
;;
;;While DPL-UR was still live, the strongest assertion available was PARITY -- call the old
;;function and the new one and require the objects to be equal. That is what found four
;;flattened glyphs (¢ × ≥ Ξ₳), the unreachable Wipe button and the ICO div-by-zero, and none of
;;them was findable by reading the code or by any test written FROM the port, because such a
;;test agrees with the port by construction.
;;
;;Parity dies with the stub: once DPL-UR no longer carries these reads there is nothing to
;;compare against. What survives it is the half that was always the real contract -- THE KEY
;;SET. A consumer indexes an object by string, so a renamed or dropped key is a broken page,
;;while an ADDED key is harmless by design (which is why every degradation flag here is
;;additive). So these assert PRESENCE, not exact equality: every key below must exist, extras
;;are allowed.
;;
;;THE LISTS ARE NOT COPIED FROM THE SOURCE. They were read off MAINNET, from the deployed
;;modules, on 2026-09-25 -- the only reading that cannot silently agree with a mistake in the
;;module it is meant to be checking.
(map print
    [
            (expect "<<RDUI-16>> O-UI-ONE.URC_01|Header returns its 45 contracted keys"
                true
                (fold (and) true (map (lambda (k:string) (contains k (O-UI-ONE.URC_01|Header KST.ANHD)))
                    ["resident-ignis" "z1-ok" "z1-t1" "z1-t2" "z1-t3" "z1-t4" "z1-t5" "z1-v1" "z1-v2"
                     "z1-v3" "z1-v4" "z1-v5" "z2-ok" "z2-t1" "z2-t2" "z2-t3" "z2-t4" "z2-t5" "z2-v1"
                     "z2-v2" "z2-v3" "z2-v4" "z2-v5" "z3-ok" "z3-t1" "z3-t2" "z3-t3" "z3-t4" "z3-t5"
                     "z3-v1" "z3-v2" "z3-v3" "z3-v4" "z3-v5" "z4-ok" "z4-t1" "z4-t2" "z4-t3" "z4-t4"
                     "z4-t5" "z4-v1" "z4-v2" "z4-v3" "z4-v4" "z4-v5"])))
            (expect "<<RDUI-16>> O-UI-THREE.URC_01|EliteAccount returns its 70 contracted keys"
                true
                (fold (and) true (map (lambda (k:string) (contains k (O-UI-THREE.URC_01|EliteAccount KST.ANHD)))
                    ["account" "auryndex-id" "auryndex-name" "auryndex-value" "auryndex-value-hover"
                     "deb-bonus-text" "dex-fee-cost-multiplier" "dex-fee-discount-percent"
                     "dex-fee-discount-text" "discounts-ok" "dispo-ok" "dispo-overspend-percent"
                     "dispo-overspend-text" "ea-id" "ea-supply" "ea-supply-hover"
                     "elite-ats-cold-recovery-duration-index" "elite-ats-cold-recovery-positions"
                     "elite-auryn-dispo-locked" "elite-auryn-dispo-locked-text" "elite-auryndex-id"
                     "elite-auryndex-name" "elite-auryndex-value" "elite-auryndex-value-hover"
                     "elite-aurynz-for-next-tier" "elite-aurynz-for-next-tier-hover" "elite-class"
                     "elite-deb" "elite-name" "elite-tier" "elite-tier-major" "elite-tier-minor" "fea-id"
                     "fea-supply" "fea-supply-hover" "hea-id" "hea-supply" "hea-supply-hover"
                     "ignis-cost-multiplier" "ignis-discount-percent" "ignis-discount-text" "indices-ok"
                     "max-branding-blue-months" "max-swp-special-fee-targets" "ouro-balance"
                     "ouro-balance-hover" "ouro-dispo-capacity" "ouro-dispo-capacity-hover" "ouro-id"
                     "ouro-minimum" "ouro-minimum-hover" "ouro-virtual" "ouro-virtual-hover" "rea-id"
                     "rea-supply" "rea-supply-hover" "sea-id" "sea-supply" "sea-supply-hover" "standing-ok"
                     "stoa-cost-multiplier" "stoa-discount-percent" "stoa-discount-text"
                     "total-elite-aurynz" "total-elite-aurynz-hover" "unlocks-ok" "variants-ok" "vea-id"
                     "vea-supply" "vea-supply-hover"])))
            (expect "<<RDUI-16>> O-UI-SEVEN.URC_02|Account returns its 18 contracted keys"
                true
                (fold (and) true (map (lambda (k:string) (contains k (O-UI-SEVEN.URC_02|Account KST.ANHD)))
                    ["governor" "ignis-balance" "ignis-discount" "iz-activated" "iz-smart" "ouro-balance"
                     "ouronet-account" "ouronet-account-guard" "payment-key" "payment-key-balance"
                     "payment-key-existance" "payment-key-guard" "public-key" "sovereign" "stoa-discount"
                     "stoic-tag" "stoic-tag-has" "stoic-tag-registered-at"])))
            (expect "<<RDUI-16>> O-UI-SEVEN.URC_04|StoicTag returns its 7 contracted keys"
                true
                (fold (and) true (map (lambda (k:string) (contains k (O-UI-SEVEN.URC_04|StoicTag "nope")))
                    ["iz-active" "iz-never-registered" "iz-released" "iz-row-exists" "ouronet-account"
                     "registered-at" "stoic-tag"])))
            (expect "<<RDUI-16>> O-UI-SEVEN.URC_06|StoaAccount returns its 4 contracted keys"
                true
