        (expect "<<RDUI-04>> UrStoa card"      true (at "card-ok" (O-UI-TWO.URC_UrStoa KST.ANHD)))
        (expect "<<RDUI-04>> STOA card"        true (at "card-ok" (O-UI-TWO.URC_Stoa KST.ANHD)))
