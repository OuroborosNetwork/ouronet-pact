                (fold (and) true (map (lambda (k:string) (contains k (O-UI-TEN.URH_01|Header KST.ANHD)))
                    ["held-nf" "held-nf-number" "held-sf" "held-sf-number" "mngd-nf" "mngd-nf-no" "mngd-sf"
                     "mngd-sf-no" "total-non-fungible-nonces" "total-non-fungible-number"
