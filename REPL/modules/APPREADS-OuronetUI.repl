(begin-tx "RDUI-07 -- O-UI-TWELVE: every panel answers, and the list survives a bad member")
(env-gasmodel "table")(env-gaslimit 100000000)(env-gas 0)
;;==== RDUI-07 · 01 · namespace ==== ==============================================================
(print "--- [RDUI-07 · 01 · namespace] ---")
(namespace "ouronet-ns")
;;==== RDUI-07 · 02 · panels, composer, and a deliberately bad pool id ==== =======================
(print "--- [RDUI-07 · 02 · panels, composer, and a deliberately bad pool id] ---")
;;The last two assertions are the ones worth having. The original URC_0005 mapper had no guard,
;;so ONE unreadable pool emptied the entire pool list -- a page showing dozens taken out by a
;;single bad row. URC_02|PoolList wraps each member in `try`, so a bad id degrades to
;;UDC_ZeroPanel and its neighbours still render.
(let*
    ( (g:object (O-UI-TWELVE.URC_01|Global))
      (pools:[string] (at "pools" g))
      (sw:string (at 0 pools))
      (p:object (O-UI-TWELVE.URC_03|Pool sw))
      (mixed:[object] (O-UI-TWELVE.URC_02|PoolList [sw "P|NO-SUCH-POOL|AT-ALL"])) )
    (map print
        [
            (expect "<<RDUI-07>> the global panel answers" true (at "panel-ok" g))
            (expect "<<RDUI-07>> ...and reports every pool the fixture built"
                true (> (at "number-of-pools" g) 0))
            (expect "<<RDUI-07>> all five per-pool panels answer"
                [true true true true true]
                [(at "panel-ok" (at "core" p)) (at "panel-ok" (at "dashboard" p))
                 (at "panel-ok" (at "internal" p)) (at "panel-ok" (at "settings" p))
                 (at "panel-ok" (at "fees" p))])
            (expect "<<RDUI-07>> the account panel answers on its own"
                true (at "panel-ok" (O-UI-TWELVE.URC_04|AccountSupplies KST.ANHD sw)))
            (expect "<<RDUI-07>> a BAD pool id in the list degrades to one dead entry..."
                [true false]
                [(at "panel-ok" (at 0 mixed)) (at "panel-ok" (at 1 mixed))])
            (expect "<<RDUI-07>> ...and the list still has both members -- the original mapper \
                \ returned nothing at all when any single pool failed"
                2 (length mixed))
        ]
    )
)
(commit-tx)

