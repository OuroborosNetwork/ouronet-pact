        (expect "<<RDUI-04>> GoldenStoa card"  true (at "card-ok" (O-UI-TWO.URC_GoldenStoa KST.ANHD)))
        (expect "<<RDUI-04>> totals"           true (at "card-ok" (O-UI-TWO.URC_Totals KST.ANHD)))
