(begin-tx "RDUI-13 -- O-UI-SEVEN: object-for-object parity with DPL-UR, existent and not")
(env-gasmodel "table")(env-gaslimit 100000000)(env-gas 0)
;;==== RDUI-13 · 01 · namespace ==== ==============================================================
(print "--- [RDUI-13 · 01 · namespace] ---")
(namespace "ouronet-ns")
;;==== RDUI-13 · 02 · parity against the live source ==== =========================================
(print "--- [RDUI-13 · 02 · parity against the live source] ---")
;;URC_02|Account collapses three coin reads into one `details` sample. That is exactly the kind
;;of change that looks equivalent and is not, so it is asserted against DPL-UR rather than
;;against a literal -- and asserted on a NON-EXISTENT account too, because a selector's whole
;;job is answering for something that is not there, and the sentinels are load-bearing.
(map print
    [
        ;;A mapper must equal `map` of its single. This is the invariant parity used to prove
        ;;against DPL-UR, restated so it survives DPL-UR -- it still catches a mapper that
        ;;drops, reorders or re-derives its elements.
        (expect "<<RDUI-13>> the account mapper equals map of its single"
            [(O-UI-SEVEN.URC_02|Account KST.ANHD)]
            (O-UI-SEVEN.URC_01|Accounts [KST.ANHD]))
        (expect "<<RDUI-13>> ...and the StoicTag mapper likewise"
            [(O-UI-SEVEN.URC_04|StoicTag "nope")]
            (O-UI-SEVEN.URC_03|StoicTags ["nope"]))
        (expect "<<RDUI-13>> ...and the Stoa account mapper likewise"
            [(O-UI-SEVEN.URC_06|StoaAccount "nope")]
            (O-UI-SEVEN.URC_05|StoaAccounts ["nope"]))
        (expect "<<RDUI-13>> every mapper answers [] for [] rather than throwing"
            [[] [] []]
            [(O-UI-SEVEN.URC_01|Accounts []) (O-UI-SEVEN.URC_03|StoicTags [])
             (O-UI-SEVEN.URC_05|StoaAccounts [])])
        ;;THE SENTINELS ARE LOAD-BEARING. A selector exists to say whether what a user typed is
        ;;real, so "absent" must be distinguishable from "empty" -- -1 is not `false`, and
        ;;-1.0 is not a zero balance. Tidying these into falsey values would merge the two.
        (expect "<<RDUI-13>> the absent-account sentinels are DISCRIMINATORS, not zeroes"
            [-1 -1.0 false "" false]
            (let ((a:object (O-UI-SEVEN.URC_02|Account "Σ.NO-SUCH-ACCOUNT")))
                [(at "iz-smart" a) (at "payment-key-balance" a) (at "iz-activated" a)
                 (if (= (at "payment-key" a) (U|CT.CT_BAR)) "" "payment-key should be BAR")
                 (at "payment-key-existance" a)]))
        (expect "<<RDUI-13>> a live account reads back as activated, with a real type"
            [true true]
            (let ((a:object (O-UI-SEVEN.URC_02|Account KST.ANHD)))
                [(at "iz-activated" a) (!= (at "iz-smart" a) -1)]))
        ;;Three tag states, not two: a RELEASED tag has a row and no account, and collapsing it
        ;;into `iz-active false` would make a released tag look free to claim.
        (expect "<<RDUI-13>> an unregistered tag reports never-registered, not merely inactive"
            [false false true]
            (let ((t:object (O-UI-SEVEN.URC_04|StoicTag "definitely-not-a-tag")))
                [(at "iz-row-exists" t) (at "iz-released" t) (at "iz-never-registered" t)]))
    ]
)
(commit-tx)

