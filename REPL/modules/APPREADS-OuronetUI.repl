(begin-tx "RDUI-14 -- O-UI-FOUR: the ICO read answers where the original divides by zero")
(env-gasmodel "table")(env-gaslimit 100000000)(env-gas 0)
;;==== RDUI-14 · 01 · namespace ==== ==============================================================
(print "--- [RDUI-14 · 01 · namespace] ---")
(namespace "ouronet-ns")
;;==== RDUI-14 · 02 · the divisor guard, and the clamped date ==== ================================
(print "--- [RDUI-14 · 02 · the divisor guard, and the clamped date] ---")
;;This fixture does not initialise the ICO, so BOTH reads fail here -- on the missing row, not on
;;the division. What is pinned instead is the arithmetic itself, which is where the defect lives:
;;`try` does NOT catch a div-by-zero, so no composer at any level could have defended the page.
(map print
    [
        (expect-failure "<<RDUI-14>> `try` does NOT catch an arithmetic exception -- which is why \
            \ the guard had to move INTO the read rather than around it"
            (try 0.0 (floor (* 10000000.0 (/ 0.0 0.0)) 12)))
        ;;The end date. DPL-UR says (time "2026-15-05T20:00:00Z"); there is no fifteenth month and
        ;;Pact CLAMPS rather than rejecting, so the advertised deadline is seven months late.
        ;;Pinned as it stands, awaiting an owner ruling -- a public deadline is not a porting call.
        (expect "<<RDUI-14>> month 15 CLAMPS to December -- the defect is silent, not loud"
            (time "2026-12-05T20:00:00Z") (time "2026-15-05T20:00:00Z"))
        (expect "<<RDUI-14>> ...and CT_IcoEnd states that same instant, in a form that reads true"
            (time "2026-15-05T20:00:00Z") O-UI-FOUR.CT_IcoEnd)
        (expect "<<RDUI-14>> the price formatter emits the CENT SIGN, not an ASCII c"
            "50.000¢" (O-UI-FOUR.UC_Price 0.5))
    ]
)
(commit-tx)

