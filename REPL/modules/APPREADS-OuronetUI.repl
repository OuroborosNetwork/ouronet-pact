(print "")
(print "================================================================")
(print "FILE  REPL/modules/APPREADS-OuronetUI.repl")
(print "================================================================")
(print "Legend (terminal observability): see ;; preface; echoes use <(…)> where helpful.")
(print "Source: ;;|| NEXT > between txs; ;;==== … · mm · … ==== + banner before each begin-tx.")
(print "")
;; AppReads/OuronetUI — the split read layer. O-UI-ONE is the reference module; mirror it.
;;
;; WHAT THIS SUITE IS FOR, beyond "does it run". The two functions that took the dashboard down
;; on 2026-09-24 had NEVER executed in a test, because their hardcoded mainnet ids do not exist
;; in a sandbox. Every assertion below therefore CALLS the read rather than inspecting it.
(load "../deploy-stage00.repl")
(load "../deploy-stage01.repl")
(load "../Stage_01/[6.2+3]_DPTF-SWP_Issuance-Only.repl")
(load "../deploy-stage02.repl")

;;|| NEXT >
;;
(begin-tx "RDUI-00 -- deploy the ids registry and the reference read module")
(env-gasmodel "table")(env-gaslimit 150000000)(env-gas 0)
;;==== RDUI-00 · 01 · env-sigs (caps) ==== ========================================================
(print "--- [RDUI-00 · 01 · env-sigs (caps)] ---")
(env-sigs
  [{"key": "1a4e15d3c51e0b73e92644600487ba8eaae312e1a178b91801d54e13c1b350a5", "caps": []}])
;;==== RDUI-00 · 02 · load modules ==== ===========================================================
(print "--- [RDUI-00 · 02 · load modules] ---")
(namespace "ouronet-ns")
(load "../../2_CITIZEN/Stage_Z/AppReads/00_Ids.pact")
(load "../../2_CITIZEN/Stage_Z/AppReads/OuronetUI/01_O-UI-ONE.pact")
(load "../../2_CITIZEN/Stage_Z/AppReads/OuronetUI/02_O-UI-TWO.pact")
(load "../../2_CITIZEN/Stage_Z/AppReads/OuronetUI/03_O-UI-THREE.pact")
(load "../../2_CITIZEN/Stage_Z/AppReads/OuronetUI/04_O-UI-FOUR.pact")
(load "../../2_CITIZEN/Stage_Z/AppReads/OuronetUI/07_O-UI-SEVEN.pact")
(load "../../2_CITIZEN/Stage_Z/AppReads/OuronetUI/08_O-UI-EIGHT.pact")
(load "../../2_CITIZEN/Stage_Z/AppReads/OuronetUI/09_O-UI-NINE.pact")
(load "../../2_CITIZEN/Stage_Z/AppReads/OuronetUI/10_O-UI-TEN.pact")
(load "../../2_CITIZEN/Stage_Z/AppReads/OuronetUI/12_O-UI-TWELVE.pact")
(load "../../2_CITIZEN/Stage_Z/AppReads/OuronetUI/13_O-UI-THIRTEEN.pact")
(load "../../2_CITIZEN/Stage_Z/AppReads/OuronetUI/14_O-UI-FOURTEEN.pact")
(load "../../2_CITIZEN/Stage_Z/AppReads/Pythia/01_P-UI-ONE.pact")
;;DPL-UR IS NO LONGER LOADED, AND THAT COST THIS SUITE SOMETHING WORTH NAMING.
;;
;;While it was live the strongest assertion available was PARITY -- call the old function and
;;the new one and require the objects to be equal. That is what found the four flattened glyphs
;;(¢ × ≥ Ξ₳), the unreachable Wipe button, the ICO division by zero and a dead call to a member
;;DPL-UR never had. None of those was reachable by reading the code, and none by a test written
;;FROM the port, which agrees with the port by construction.
;;
;;Archive mode (§7.21, 2026-09-25) deleted the 57 reads that moved here, so there is nothing
;;left to compare against. What replaces parity is RDUI-16: 177 keys across 10 client reads,
;;READ OFF MAINNET rather than copied from these sources -- the one reading that cannot
;;silently agree with a mistake in the module it checks.
(print (format "<<<<<<<READS_UI (ids + RD-HEADER) Costs {} GAS>>>>>>>" [(env-gas)]))
(env-sigs [])
(commit-tx)

;;|| NEXT >
