(begin-tx "RDUI-05 -- O-UI-TWO arithmetic, and the scan that must stay out of the composer")
(env-gasmodel "table")(env-gaslimit 100000000)(env-gas 0)
;;==== RDUI-05 · 01 · namespace ==== ==============================================================
(print "--- [RDUI-05 · 01 · namespace] ---")
(namespace "ouronet-ns")
;;==== RDUI-05 · 02 · URC_Value is linear and floors to token precision ==== ======================
(print "--- [RDUI-05 · 02 · URC_Value is linear and floors to token precision] ---")
;;Per AppReads/RULES.md's testing posture, display reads need no audit -- but a read that feeds a
;;DECISION needs its ARITHMETIC pinned. URC_Value is the multiplier under every "-vid" field on
;;the dashboard, so these pin the relationship rather than smoke-testing that a call returned.
(let ((ouro:string (ouronet-ns.DALOS.UR_OuroborosID)))
    (map print
        [
            (expect "<<RDUI-05>> unit amount at unit price is the unit value"
                1.0 (O-UI-TWO.URC_Value ouro 1.0 1.0))
            (expect "<<RDUI-05>> ...linear in the AMOUNT"
                2.0 (O-UI-TWO.URC_Value ouro 2.0 1.0))
            (expect "<<RDUI-05>> ...linear in the PRICE"
                2.0 (O-UI-TWO.URC_Value ouro 1.0 2.0))
            (expect "<<RDUI-05>> ...and zero amount is worth zero"
                0.0 (O-UI-TWO.URC_Value ouro 0.0 1.0))
            (expect "<<RDUI-05>> seven prices, in the documented order"
                7 (length (O-UI-TWO.URC_Prices)))
            (expect "<<RDUI-05>> IGNIS is a fixed 0.01 by definition, not a pool price"
                0.01 (at 1 (O-UI-TWO.URC_Prices)))
        ]
    )
)
;;==== RDUI-05 · 03 · the composer survives, BECAUSE the scan is not in it ==== ===================
(print "--- [RDUI-05 · 03 · the composer survives, BECAUSE the scan is not in it] ---")
;;THE REASON THIS BLOCK EXISTS. Pact evaluates a `try` body in READ-ONLY mode, where `select` and
;;`keys` are disallowed. With DPOF::URH_AccountNonces inline in the GoldenStoa card, URC_01|Dashboard
;;died on "Operation disallowed in read-only or sys-only mode" (06_DPOF.pact:1857) while every
;;card still passed INDIVIDUALLY -- only the composed call broke, which is the hardest shape to
;;diagnose. The scan now lives in URH_GoldenStoaNonces and is deliberately outside the composer.
;;
;;The first assertion is the regression guard: it fails the moment a scan is folded back into a
;;composed card. The second proves the scan itself still works where it now lives.
(let*
    ( (r:[object] (O-UI-TWO.URC_01|Dashboard KST.ANHD []))
      (w:object (at 0 r))
      (cx:object (at 1 r)) )
    (map print
        [
            ;;THE LIST SHAPE IS THE CONTRACT, not a style choice. ouronet-core's parseResponse
            ;;reads data[0] for the account object and data[1] for the Codex balance. An object
            ;;with two members would be tidier and would break every caller -- which is exactly
            ;;why this asserts the shape before it asserts any value.
            (expect "<<RDUI-05>> the composer returns a TWO-element list -- data[0] account, \
                \ data[1] codex, which is what ouronet-core's parser indexes"
                2 (length r))
            (expect "<<RDUI-05>> all nine cards report ok, and a scan folded into any of them \
                \ would abort this call entirely"
                [true true true true true true true true true]
                [(at "ouro-ok" w) (at "gas-ok" w) (at "auryn-ok" w) (at "eauryn-ok" w)
                 (at "urstoa-ok" w) (at "wstoa-ok" w) (at "sstoa-ok" w) (at "gstoa-ok" w)
                 (at "totals-ok" w)])
            (expect "<<RDUI-05>> ...and the codex element answers too" true (at "codex-ok" cx))
            ;;KEY-NAME REGRESSION GUARD. Every one of these is read by name in ouronet-core's
            ;;parseResponse, so a typo here is invisible to Pact and fatal to the dashboard.
            ;;`urstoa-vault-earning-hover` is SINGULAR while its sibling is plural -- an
            ;;inconsistency in the original contract that must be preserved exactly.
            (expect "<<RDUI-05>> the flat keys match what the consumer indexes, verbatim"
                [true true true true]
                [(!= (at "ouro-id" w) "--")
                 (!= (at "gas-discount-text" w) "--")
                 (contains "urstoa-vault-earning-hover" w)
                 (contains "hgstoa-balance-nonces" w)])
            (expect "<<RDUI-05>> ...and the scan works where it now lives, outside the composer"
                0 (at "nonces" (O-UI-TWO.URH_GoldenStoaNonces KST.ANHD)))
            (expect "<<RDUI-05>> the composed card's id equals the card called directly"
                (at "id" (O-UI-TWO.URC_Ignis KST.ANHD)) (at "gas-id" w))
        ]
    )
)
(commit-tx)

