(begin-tx "RDUI-10 -- O-UI-THREE: the rich list, and why it is not in the composer")
(env-gasmodel "table")(env-gaslimit 100000000)(env-gas 0)
;;==== RDUI-10 · 01 · namespace ==== ==============================================================
(print "--- [RDUI-10 · 01 · namespace] ---")
(namespace "ouronet-ns")
;;==== RDUI-10 · 02 · ranked, and admin-gated ==== ================================================
(print "--- [RDUI-10 · 02 · ranked, and admin-gated] ---")
;;URH_02|RichList runs (keys DALOS.DALOS|AccountTable) -- a CROSS-MODULE scan. Two consequences
;;pinned here, both of which decide how a UI may call it:
;;
;;  1. IT NEEDS MODULE ADMIN in transactional mode, which a REPL always is. On chain the
;;     equivalent is a node started with --allowReadsInLocal. The expect-failure BELOW the grant
;;     is what proves the dependency is real rather than assumed.
;;  2. IT THEREFORE CANNOT SIT INSIDE A `try`, which is why it is a separate client read and not
;;     a seventh card in URC_01|EliteAccount.
(map print
    [
        (expect-failure "<<RDUI-10>> the scan is admin-gated -- which is WHY it cannot be a \
            \ try-wrapped card in the panel"
            "Module admin necessary for operation but has not been acquired:ouronet-ns.DALOS"
            (O-UI-THREE.URH_02|RichList))
    ]
)
(env-module-admin ouronet-ns.DALOS)
(let ((r:[object] (O-UI-THREE.URH_02|RichList)))
    (map print
        [
            (expect "<<RDUI-10>> every Standard account appears -- Smart accounts are filtered"
                (length (filter (lambda (a:string) (not (ouronet-ns.DALOS.UR_AccountType a)))
                                (keys ouronet-ns.DALOS.DALOS|AccountTable)))
                (length r))
            ;;Sortedness is the whole contract of a rich LIST -- asserting the top row alone
            ;;would pass on an unsorted result whose first element happened to be largest.
            (expect "<<RDUI-10>> ranked high to low, checked across EVERY adjacent pair"
                true
                (fold (and) true
                    (map (lambda (i:integer)
                            (>= (at "total-elite-aurynz" (at i r))
                                (at "total-elite-aurynz" (at (+ i 1) r))))
                         (enumerate 0 (- (length r) 2)))))
            (expect "<<RDUI-10>> ea-movable is zero exactly when the row is dispo-locked"
                true
                (fold (and) true
                    (map (lambda (row:object)
                            (if (at "elite-auryn-dispo-locked" row)
                                (= (at "ea-movable" row) 0.0)
                                (= (at "ea-movable" row) (at "ea-supply" row))))
                         r)))
        ]
    )
)
(commit-tx)

