(begin-tx "RDUI-04 -- O-UI-TWO: every card answers, and the composer stays whole")
(env-gasmodel "table")(env-gaslimit 100000000)(env-gas 0)
;;==== RDUI-04 · 01 · namespace ==== ==============================================================
(print "--- [RDUI-04 · 01 · namespace] ---")
(namespace "ouronet-ns")
;;==== RDUI-04 · 02 · the ten cards, each on its own ==== =========================================
(print "--- [RDUI-04 · 02 · the ten cards, each on its own] ---")
;;DPL-UR::URC_0002_PrimordialsSingle bound ~60 values in one eager `let` and returned ~70 flat
;;keys, so any one missing token row blanked the whole wallet view. These ten assertions are the
;;property that replaces it: each card answers alone, so a failure has an address.
(map print
    [
        (expect "<<RDUI-04>> OURO card"        true (at "card-ok" (O-UI-TWO.URC_Ouro KST.ANHD)))
        (expect "<<RDUI-04>> IGNIS card"       true (at "card-ok" (O-UI-TWO.URC_Ignis KST.ANHD)))
        (expect "<<RDUI-04>> AURYN card"       true (at "card-ok" (O-UI-TWO.URC_Auryn KST.ANHD)))
        (expect "<<RDUI-04>> ELITEAURYN card"  true (at "card-ok" (O-UI-TWO.URC_EliteAuryn KST.ANHD)))
        (expect "<<RDUI-04>> UrStoa card"      true (at "card-ok" (O-UI-TWO.URC_UrStoa KST.ANHD)))
        (expect "<<RDUI-04>> STOA card"        true (at "card-ok" (O-UI-TWO.URC_Stoa KST.ANHD)))
        (expect "<<RDUI-04>> SilverStoa card"  true (at "card-ok" (O-UI-TWO.URC_SilverStoa KST.ANHD)))
        (expect "<<RDUI-04>> GoldenStoa card"  true (at "card-ok" (O-UI-TWO.URC_GoldenStoa KST.ANHD)))
        (expect "<<RDUI-04>> totals"           true (at "card-ok" (O-UI-TWO.URC_Totals KST.ANHD)))
        (expect "<<RDUI-04>> codex"            true (at "card-ok" (O-UI-TWO.URC_Codex [])))
    ]
)
(commit-tx)

