                    ["held-tf" "held-tf-number" "mngd-tf" "mngd-tf-number" "total-true-fungible-number"])))
            (expect "<<RDUI-16>> O-UI-NINE.URH_01|Header returns its 6 contracted keys"
                true
                (fold (and) true (map (lambda (k:string) (contains k (O-UI-NINE.URH_01|Header KST.ANHD)))
                    ["held-of" "held-of-number" "mngd-of" "mngd-of-number" "total-orto-fungible-nonces"
                     "total-orto-fungible-number"])))
            (expect "<<RDUI-16>> O-UI-TEN.URH_01|Header returns its 12 contracted keys"
