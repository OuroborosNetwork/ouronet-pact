(begin-tx "RDUI-09 -- O-UI-THREE: the panel, and the duplicated rule that must not drift")
(env-gasmodel "table")(env-gaslimit 100000000)(env-gas 0)
;;==== RDUI-09 · 01 · namespace ==== ==============================================================
(print "--- [RDUI-09 · 01 · namespace] ---")
(namespace "ouronet-ns")
;;==== RDUI-09 · 02 · the two copies of the tier rule agree ==== ==================================
(print "--- [RDUI-09 · 02 · the two copies of the tier rule agree] ---")
;;THIS IS THE ASSERTION THAT LICENSES THE DUPLICATION. UC_MaxSpecialFeeTargets exists in BOTH
;;O-UI-THREE and O-UI-TWELVE, because calling across would make one read module a deploy
;;dependency of another and destroy the one property the split buys.
;;
;;Two copies of a rule is also exactly how the original defect happened: DPL-UR carried this
;;logic twice, one copy seeded its or-fold with `true` (identity for `or` is FALSE), the tier-5
;;branch always fired, and every pool owner below tier 2 was told 7 targets instead of 1.
;;
;;What makes copying SAFE is this test, not discipline. A divergence fails the gate here rather
;;than waiting to be noticed by a user walking into a refused transaction.
(map print
    [
        (expect "<<RDUI-09>> the two copies of the tier rule agree across every tier 0..7"
            (map (lambda (m:integer) (O-UI-TWELVE.UC_MaxSpecialFeeTargets m)) [0 1 2 3 4 5 6 7])
            (map (lambda (m:integer) (O-UI-THREE.UC_MaxSpecialFeeTargets m)) [0 1 2 3 4 5 6 7]))
        (expect "<<RDUI-09>> ...and still return ONE below tier 2, which is the value DPL-UR \
            \ gets wrong"
            [1 1] [(O-UI-THREE.UC_MaxSpecialFeeTargets 0) (O-UI-THREE.UC_MaxSpecialFeeTargets 1)])
    ]
)
;;==== RDUI-09 · 03 · the panel, six cards, flat output ==== ======================================
(print "--- [RDUI-09 · 03 · the panel, six cards, flat output] ---")
(let ((p:object (O-UI-THREE.URC_01|EliteAccount KST.ANHD)))
    (map print
        [
            (expect "<<RDUI-09>> all six cards answer"
                [true true true true true true]
                [(at "standing-ok" p) (at "variants-ok" p) (at "indices-ok" p)
                 (at "dispo-ok" p) (at "discounts-ok" p) (at "unlocks-ok" p)])
            (expect "<<RDUI-09>> the panel is FLAT -- keys sit at the top level, as \
                \ DPL-UR::URC_0032_EliteAccount returned them, so a consumer needs no remapping"
                [true true true true]
                [(contains "elite-name" p) (contains "ea-supply-hover" p)
                 (contains "dispo-overspend-percent" p) (contains "dex-fee-discount-text" p)])
            (expect "<<RDUI-09>> the unlocks card sources its target count from the shared rule"
                (O-UI-THREE.UC_MaxSpecialFeeTargets
                    (ouronet-ns.DALOS.UR_Elite-Tier-Major KST.ANHD))
                (at "max-swp-special-fee-targets" p))
            ;;dispo-locked is TRUE when OURO is NEGATIVE -- the account has spent into its
            ;;credit. Pinning the RELATIONSHIP rather than today's value, which moves every block.
            (expect "<<RDUI-09>> dispo-locked tracks a negative OURO balance, not a fixed value"
                (< (ouronet-ns.DPTF.UR_AccountSupply (ouronet-ns.DALOS.UR_OuroborosID) KST.ANHD) 0.0)
                (at "elite-auryn-dispo-locked" p))
        ]
    )
)
(commit-tx)

