(begin-tx "RDUI-15 -- O-UI-TEN: the Wipe button that has never been reachable")
(env-gasmodel "table")(env-gaslimit 100000000)(env-gas 0)
;;==== RDUI-15 · 01 · namespace ==== ==============================================================
(print "--- [RDUI-15 · 01 · namespace] ---")
(namespace "ouronet-ns")
;;==== RDUI-15 · 02 · empty selection: DPL-UR raises, the port answers ==== =======================
(print "--- [RDUI-15 · 02 · empty selection: DPL-UR raises, the port answers] ---")
;;URC_0026 opens its let with (fn:integer (at 0 selected-nonces)) and Pact binds EAGERLY, so an
;;empty selection throws before any flag is computed. `wipe` is the one flag that REQUIRES an
;;empty selection. The only input that could make it true is the input that crashes the function,
;;so the button has never once been rendered -- and the whole action bar blanks in the page's
;;initial state. Both halves are asserted: the original raises, and the port agrees with it
;;everywhere the original can still answer.
(env-module-admin ouronet-ns.DPDC)
(let*
    ( (sf:string (at 0 (keys DPDC.DPSF|T|Properties))) )
    (map print
        [
            ;;THE FIX. DPL-UR's URC_0026 bound (at 0 selected-nonces) EAGERLY, so an empty
            ;;selection threw before any flag was computed -- and `wipe` is the one flag that
            ;;REQUIRES an empty selection, so the button could never be true and the whole
            ;;action bar was blank on page load. Proven against the live module before archive
            ;;mode removed it: DPL-UR raised where this answers, and the two were identical on
            ;;every non-empty selection.
            (expect "<<RDUI-15>> an EMPTY selection answers, and wipe is reachable at last"
                true (at "wipe" (O-UI-TEN.URC_09|Buttons KST.ANHD sf true [])))
            (expect "<<RDUI-15>> ...while the single-nonce flags stay off on an empty selection"
                [false false false false]
                (let ((b:object (O-UI-TEN.URC_09|Buttons KST.ANHD sf true [])))
                    [(at "add-quantity" b) (at "burn" b) (at "transfer" b) (at "break-set" b)]))
            (expect "<<RDUI-15>> a single selection turns transfer on and wipe off"
                [true false]
                (let ((b:object (O-UI-TEN.URC_09|Buttons KST.ANHD sf true [1])))
                    [(at "transfer" b) (at "wipe" b)]))
            (expect "<<RDUI-15>> the plural class filter equals the singular, class by class"
                [(O-UI-TEN.URC_07|FilterByClass sf true [1 2 3] 0)
                 (O-UI-TEN.URC_07|FilterByClass sf true [1 2 3] 1)]
                (O-UI-TEN.URC_08|FilterByClasses sf true [1 2 3] [0 1]))
            ;;One row per DECLARED set class, and each row really is a set object rather than
            ;;whatever `UR_Set` happens to return for an out-of-range class.
            (expect "<<RDUI-15>> one row per declared set class"
                (DPDC.UR_SetClassesUsed sf true) (length (O-UI-TEN.URC_06|Sets sf true)))
            (expect "<<RDUI-15>> ...and every row carries a set's own fields"
                true
                (fold (and) true
                    (map (lambda (r:object) (and (contains "iz-active" r)
                                                 (contains "composite" r)))
                         (O-UI-TEN.URC_06|Sets sf true))))
            (expect "<<RDUI-15>> the page composer answers for both fungibility classes"
                true (at "list-ok" (O-UI-TEN.URC_10|Wallet KST.ANHD)))
        ]
    )
)
(commit-tx)

