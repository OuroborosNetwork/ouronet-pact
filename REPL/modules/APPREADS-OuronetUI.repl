                (fold (and) true (map (lambda (k:string) (contains k (O-UI-TWELVE.URC_01|Global)))
                    ["asymmetric" "asymmetric-word" "global-liquid-staking-boost"
                     "global-liquid-staking-boost-word" "number-of-pools" "panel-ok" "pools"])))
