(begin-tx "RDUI-12 -- O-UI-NINE: a select that cannot be wrapped, guarded where the failure is")
(env-gasmodel "table")(env-gaslimit 100000000)(env-gas 0)
;;==== RDUI-12 · 01 · namespace ==== ==============================================================
(print "--- [RDUI-12 · 01 · namespace] ---")
(namespace "ouronet-ns")
;;==== RDUI-12 · 02 · per-row degradation without a whole-row try ==== ============================
(print "--- [RDUI-12 · 02 · per-row degradation without a whole-row try] ---")
;;An orto-fungible row carries wallet-nonces, which is a `select`, and `try` runs its body in
;;READ-ONLY mode where select is disallowed. So the whole-row guard O-UI-EIGHT uses is NOT
;;available here, and the split -- valuation wrapped, nonce read outside -- is the only way to
;;keep per-row degradation at all. These two assertions are what prove the split works.
(env-module-admin ouronet-ns.DPOF)
(let*
    ( (ids:[string] (keys DPOF.DPOF|T|Properties))
      (rows:[object] (O-UI-NINE.URC_03|TokenList KST.ANHD (+ ids ["NO-SUCH-OF-AT-ALL"]))) )
    (map print
        [
            (expect "<<RDUI-12>> every id answers -- including the fictional one"
                (+ (length ids) 1) (length rows))
            ;;5 of the 11 fixture orto-fungibles are unpriceable collectable-family tokens. Under
            ;;DPL-UR's fold the first one would have taken all eleven down with it.
            (expect "<<RDUI-12>> unpriceable rows degrade INDIVIDUALLY, priceable ones survive"
                true (and (> (length (filter (lambda (e:object) (at "entry-ok" e)) rows)) 0)
                          (> (length (filter (lambda (e:object) (not (at "entry-ok" e))) rows)) 0)))
            (expect "<<RDUI-12>> a degraded row still carries its nonce list, read OUTSIDE the try"
                true (fold (and) true
                        (map (lambda (e:object) (contains "wallet-nonces" e)) rows)))
            (expect "<<RDUI-12>> URC_09|SuppliesOnly keeps the nonce list and drops the prices"
                [false 0.0 true]
                (let ((e:object (at 0 (O-UI-NINE.URC_09|SuppliesOnly KST.ANHD ids))))
                    [(at "priced" e) (at "wallet-worth-in-stoa" e)
                     (contains "wallet-nonces" e)]))
            (expect "<<RDUI-12>> the fictional id is the one that degraded"
                false (at "entry-ok" (at (length ids) rows)))
        ]
    )
)
;;==== RDUI-12 · 03 · the sleeping-LP list checks instead of catching ==== ========================
(print "--- [RDUI-12 · 03 · the sleeping-LP list checks instead of catching] ---")
;;URCv_04|LpEntry REFUSES for a pool with no sleeping counterpart, and that refusal cannot be
;;caught (it sits above a select). DPL-UR's mapper called it anyway and lost the whole list.
;;This one reads UR_Sleeping first and emits a dead row.
(let*
    ( (ref-SWP:module{SwapperV4} SWP)
      (lp:string (ref-SWP::UR_TokenLP (at 0 (ref-SWP::URC_Swpairs))))
      (rows:[object] (O-UI-NINE.URC_05|SleepingLpList KST.ANHD [lp])) )
    (map print
        [
            (expect "<<RDUI-12>> an LP with no sleeping twin yields a dead ROW, not an aborted list"
                [1 false] [(length rows) (at "entry-ok" (at 0 rows))])
            (expect "<<RDUI-12>> ...and the direct entry still REFUSES, which is why the list checks"
                true (!= "" (expect-failure "direct call refuses"
                        (O-UI-NINE.URCv_04|LpEntry KST.ANHD (ref-SWP::UR_GetLpSwpair lp)))))
        ]
    )
)
(commit-tx)

