(begin-tx "RDUI-08 -- O-UI-TWELVE: the previews a user signs against")
(env-gasmodel "table")(env-gaslimit 100000000)(env-gas 0)
;;==== RDUI-08 · 01 · namespace ==== ==============================================================
(print "--- [RDUI-08 · 01 · namespace] ---")
(namespace "ouronet-ns")
;;==== RDUI-08 · 02 · round trip, curvature, and refusal ==== =====================================
(print "--- [RDUI-08 · 02 · round trip, curvature, and refusal] ---")
;;O-UI-TWELVE is the carve-out in AppReads/RULES.md's testing posture. Every other module here is
;;display: a wrong number is a cosmetic bug. These three functions produce the figure a user reads
;;IMMEDIATELY BEFORE SIGNING A TRADE, so a wrong one is a user consenting to something other than
;;what they were shown. The money moves either way; only the consent was wrong.
;;
;;So these pin RELATIONSHIPS, not shapes. Each is chosen because a plausible-but-wrong
;;implementation fails it while passing "did it return a decimal?":
;;
;;  ROUND TRIP  -- forward then inverse must return the original input. Catches a fee applied on
;;                 the wrong side, a precision floor in the wrong direction, or the two functions
;;                 drifting apart. The residue is rounding only: measured 3e-24 on a 1.0 trade.
;;  CURVATURE   -- doubling the input must yield LESS than double the output. An AMM that priced
;;                 linearly would satisfy every monotonicity check and still be wrong; this is
;;                 the assertion that says "there is a curve here at all".
;;  REFUSAL     -- a token absent from the pool must REFUSE, not quote zero. This is why nothing
;;                 in O-UI-TWELVE is try-wrapped: a swallowed refusal reads to a user as a valid
;;                 quote of nothing.
(let*
    ( (sw:string (at 0 (ouronet-ns.SWP.URC_Swpairs)))
      (tk:[string] (ouronet-ns.SWP.UR_PoolTokens sw))
      (a:string (at 0 tk))
      (b:string (at 1 tk))
      (out1:decimal (O-UI-TWELVE.URCv_05|DirectSwap KST.ANHD sw [a] [1.0] b))
      (out2:decimal (O-UI-TWELVE.URCv_05|DirectSwap KST.ANHD sw [a] [2.0] b))
      (back:decimal (O-UI-TWELVE.URCv_06|InverseSwap KST.ANHD sw b out1 a)) )
    (map print
        [
            (expect "<<RDUI-08>> a forward preview returns a positive output"
                true (> out1 0.0))
            (expect "<<RDUI-08>> ROUND TRIP: inverse of the forward output recovers the input \
                \ to within rounding -- a fee on the wrong side breaks this and nothing else"
                true (< (abs (- back 1.0)) 0.000001))
            (expect "<<RDUI-08>> monotonic: twice the input yields more output"
                true (> out2 out1))
            (expect "<<RDUI-08>> CURVATURE: ...but LESS than twice -- a linear pricer would pass \
                \ every other assertion here and still be wrong"
                true (< out2 (* 2.0 out1)))
            (expect-failure "<<RDUI-08>> REFUSAL: a token absent from the pool refuses rather \
                \ than quoting zero -- which is why O-UI-TWELVE has no try-wrapped composer"
                (O-UI-TWELVE.URCv_05|DirectSwap KST.ANHD sw ["NOPE-000000000000"] [1.0] b))
            (expect "<<RDUI-08>> the max-output cap is a per-mille slice of pool supply"
                (floor (* 0.01 (ouronet-ns.SWP.UR_PoolTokenSupply sw b))
                       (ouronet-ns.DPTF.UR_Decimals b))
                (O-UI-TWELVE.URC_07|MaxOutputAmount sw b 10.0))
        ]
    )
)
(commit-tx)

;;|| NEXT >
;;
(begin-tx "RDUI-09 -- O-UI-THREE: the panel, and the duplicated rule that must not drift")
(env-gasmodel "table")(env-gaslimit 100000000)(env-gas 0)
;;==== RDUI-09 · 01 · namespace ==== ==============================================================
(print "--- [RDUI-09 · 01 · namespace] ---")
(namespace "ouronet-ns")
;;==== RDUI-09 · 02 · the two copies of the tier rule agree ==== ==================================
(print "--- [RDUI-09 · 02 · the two copies of the tier rule agree] ---")
;;THIS IS THE ASSERTION THAT LICENSES THE DUPLICATION. UC_MaxSpecialFeeTargets exists in BOTH
;;O-UI-THREE and O-UI-TWELVE, because calling across would make one read module a deploy
;;dependency of another and destroy the one property the split buys.
;;
;;Two copies of a rule is also exactly how the original defect happened: DPL-UR carried this
;;logic twice, one copy seeded its or-fold with `true` (identity for `or` is FALSE), the tier-5
;;branch always fired, and every pool owner below tier 2 was told 7 targets instead of 1.
;;
;;What makes copying SAFE is this test, not discipline. A divergence fails the gate here rather
;;than waiting to be noticed by a user walking into a refused transaction.
(map print
    [
        (expect "<<RDUI-09>> the two copies of the tier rule agree across every tier 0..7"
            (map (lambda (m:integer) (O-UI-TWELVE.UC_MaxSpecialFeeTargets m)) [0 1 2 3 4 5 6 7])
            (map (lambda (m:integer) (O-UI-THREE.UC_MaxSpecialFeeTargets m)) [0 1 2 3 4 5 6 7]))
        (expect "<<RDUI-09>> ...and still return ONE below tier 2, which is the value DPL-UR \
            \ gets wrong"
            [1 1] [(O-UI-THREE.UC_MaxSpecialFeeTargets 0) (O-UI-THREE.UC_MaxSpecialFeeTargets 1)])
    ]
)
;;==== RDUI-09 · 03 · the panel, six cards, flat output ==== ======================================
(print "--- [RDUI-09 · 03 · the panel, six cards, flat output] ---")
(let ((p:object (O-UI-THREE.URC_01|EliteAccount KST.ANHD)))
    (map print
        [
            (expect "<<RDUI-09>> all six cards answer"
                [true true true true true true]
                [(at "standing-ok" p) (at "variants-ok" p) (at "indices-ok" p)
                 (at "dispo-ok" p) (at "discounts-ok" p) (at "unlocks-ok" p)])
            (expect "<<RDUI-09>> the panel is FLAT -- keys sit at the top level, as \
                \ DPL-UR::URC_0032_EliteAccount returned them, so a consumer needs no remapping"
                [true true true true]
                [(contains "elite-name" p) (contains "ea-supply-hover" p)
                 (contains "dispo-overspend-percent" p) (contains "dex-fee-discount-text" p)])
            (expect "<<RDUI-09>> the unlocks card sources its target count from the shared rule"
                (O-UI-THREE.UC_MaxSpecialFeeTargets
                    (ouronet-ns.DALOS.UR_Elite-Tier-Major KST.ANHD))
                (at "max-swp-special-fee-targets" p))
            ;;dispo-locked is TRUE when OURO is NEGATIVE -- the account has spent into its
            ;;credit. Pinning the RELATIONSHIP rather than today's value, which moves every block.
            (expect "<<RDUI-09>> dispo-locked tracks a negative OURO balance, not a fixed value"
                (< (ouronet-ns.DPTF.UR_AccountSupply (ouronet-ns.DALOS.UR_OuroborosID) KST.ANHD) 0.0)
                (at "elite-auryn-dispo-locked" p))
        ]
    )
)
(commit-tx)

;;|| NEXT >
;;
(begin-tx "RDUI-10 -- O-UI-THREE: the rich list, and why it is not in the composer")
(env-gasmodel "table")(env-gaslimit 100000000)(env-gas 0)
;;==== RDUI-10 · 01 · namespace ==== ==============================================================
(print "--- [RDUI-10 · 01 · namespace] ---")
(namespace "ouronet-ns")
;;==== RDUI-10 · 02 · ranked, and admin-gated ==== ================================================
(print "--- [RDUI-10 · 02 · ranked, and admin-gated] ---")
;;URH_02|RichList runs (keys DALOS.DALOS|AccountTable) -- a CROSS-MODULE scan. Two consequences
;;pinned here, both of which decide how a UI may call it:
;;
;;  1. IT NEEDS MODULE ADMIN in transactional mode, which a REPL always is. On chain the
;;     equivalent is a node started with --allowReadsInLocal. The expect-failure BELOW the grant
;;     is what proves the dependency is real rather than assumed.
;;  2. IT THEREFORE CANNOT SIT INSIDE A `try`, which is why it is a separate client read and not
;;     a seventh card in URC_01|EliteAccount.
(map print
    [
        (expect-failure "<<RDUI-10>> the scan is admin-gated -- which is WHY it cannot be a \
            \ try-wrapped card in the panel"
            "Module admin necessary for operation but has not been acquired:ouronet-ns.DALOS"
            (O-UI-THREE.URH_02|RichList))
    ]
)
(env-module-admin ouronet-ns.DALOS)
(let ((r:[object] (O-UI-THREE.URH_02|RichList)))
    (map print
        [
            (expect "<<RDUI-10>> every Standard account appears -- Smart accounts are filtered"
                (length (filter (lambda (a:string) (not (ouronet-ns.DALOS.UR_AccountType a)))
                                (keys ouronet-ns.DALOS.DALOS|AccountTable)))
                (length r))
            ;;Sortedness is the whole contract of a rich LIST -- asserting the top row alone
            ;;would pass on an unsorted result whose first element happened to be largest.
            (expect "<<RDUI-10>> ranked high to low, checked across EVERY adjacent pair"
                true
                (fold (and) true
                    (map (lambda (i:integer)
                            (>= (at "total-elite-aurynz" (at i r))
                                (at "total-elite-aurynz" (at (+ i 1) r))))
                         (enumerate 0 (- (length r) 2)))))
            (expect "<<RDUI-10>> ea-movable is zero exactly when the row is dispo-locked"
                true
                (fold (and) true
                    (map (lambda (row:object)
                            (if (at "elite-auryn-dispo-locked" row)
                                (= (at "ea-movable" row) 0.0)
                                (= (at "ea-movable" row) (at "ea-supply" row))))
                         r)))
        ]
    )
)
(commit-tx)
