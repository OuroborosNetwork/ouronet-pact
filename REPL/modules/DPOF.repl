(begin-tx "DPOF-I8 — INFO_DPOF|AddQuantity quote vs measured charge")
(env-gasmodel "table")(env-gaslimit 100000000)(env-gas 0)
(namespace "ouronet-ns")
(print "--- [DPOF-I8 · 01 · top up an existing nonce] ---")
;;FUNCTION COVERAGE (G6) — `INFO_DPOF|AddQuantity`, per the owner's spec: an INFO_ must report the same cost
;;the op actually charges. Template and rationale: `modules/ATS.repl <<ATS-I1>>`.
;;TRAP, worth the annotation: the preview and the exec SWAP two arguments.
;;    INFO_DPOF|AddQuantity  (patron id NONCE ACCOUNT amount)
;;    DPOF|C_AddQuantity     (patron id ACCOUNT NONCE amount)
;;Here that is caught by the type checker (integer vs string), so it costs a run rather than a wrong
;;answer — but any future pair that swaps two arguments of the SAME type would silently price the
;;wrong thing. Do not assume a preview takes its exec's argument list, even when the names match.
;;
;;EMMA must sign as well: she holds nonce 1, and the cap enforces ownership of the target account.
(env-sigs [{ "key": "PK_AncientHodler", "caps": [] } { "key": "PK_Emma", "caps": [] }])
(let
    (
        (ref-TS01-C1:module{TalosStageOne_ClientOneV2} TS01-C1)
        (ref-DPOF:module{DemiourgosPactOrtoFungibleV2} DPOF)
        (ref-DALOS:module{OuronetDalosV2} DALOS)
        (o:string "MOCKO-98c486052a51")
        (patron:string KST.ANHD)
        (lumy:string KST.LUMY)
        (emma:string KST.EMMA)
        (coca:string KST.COCA)
    )
    ;;PRECONDITION — `DPOF|C>ADD-QTY` demands the add-quantity role on the TARGET account, and EMMA
    ;;has never held it (ANHD took it at DPOF-02 and nothing ever granted it onward). Granting it here
    ;;is setup, not the thing being measured: the grant is a separate op with its own price, and the
    ;;measurement below opens strictly after it.
    (ref-TS01-C1::DPOF|C_ToggleAddQuantityRole patron o emma true)
    (let
        (
            (predicted:object{OuronetInfoV2.ClientInfo} (INFO-ONE.INFO_DPOF|AddQuantity patron o 1 emma 10.0))
            (ignis-before:decimal (ref-DALOS::UR_TF_AccountSupply patron false))
            (m (ref-TS01-C1::DPOF|C_AddQuantity patron o emma 1 10.0))
        )
        (map print
            [
                (expect "<<DPOF-I8>> INFO_DPOF|AddQuantity's quote equals what the op actually charged"
                    (- ignis-before (ref-DALOS::UR_TF_AccountSupply patron false))
                    (at "ignis-need" (at "ignis" predicted)))
                (expect "<<DPOF-I8>> ...and it is a real, non-zero charge"
                    true (> (- ignis-before (ref-DALOS::UR_TF_AccountSupply patron false)) 0.0))
                (expect "<<DPOF-I8>> ...and the nonce really grew" 1260.0 (ref-DPOF::UR_NonceSupply o 1))
            ]
        )
    )
    ""
)
(env-sigs [])
(rollback-tx)

