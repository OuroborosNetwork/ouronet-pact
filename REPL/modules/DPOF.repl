;;|| NEXT >
;;
(begin-tx "DPOF-I21 — INFO_DPOF|WipeFull: a CAMPAIGN total, measured across every slice")
(env-gasmodel "table")(env-gaslimit 100000000)(env-gas 0)
(namespace "ouronet-ns")
(print "--- [DPOF-I21 · 01 · the whole Hydra wipe campaign, weighed] ---")
;;FUNCTION COVERAGE (G6) — `INFO_DPOF|WipeFull`, per the owner's spec. Template:
;;`modules/ATS.repl <<ATS-I1>>`.
;;
;;THIS PREVIEW HAS NO SINGLE EXEC, which is why it sat unmeasured. `WipeFull` quotes the GRAND TOTAL
;;of a Hydra campaign: `URHC_BuildWipeSlicePlan` partitions the wipeable set into N slices and the
;;client fires one `Cp_WipeSlice` transaction per slice, in parallel. There is no `C_WipeFull` to
;;point a meter at. The measurement is therefore a SUM: open the window once, run every slice, close
;;it once, and compare the accumulated charge to the single quoted total.
;;
;;THE PLAN IS DELIBERATELY MULTI-SLICE. With one nonce the campaign degenerates to a single slice and
;;the test would prove only that `WipeFull` equals `WipeSlice` — leaving the SUMMING, which is the one
;;thing `WipeFull` adds over `WipeSlice`, entirely unexercised. So two extra nonces are minted first
;;and the plan is built with a slice count matching the holding.
;;
;;SETUP, all outside the measurement window: MOCKO is left with can-freeze and can-wipe OFF by
;;DPOF-05, and every wipe path additionally requires the target FROZEN.
(env-sigs [{ "key": "PK_AncientHodler", "caps": [] } { "key": "PK_Emma", "caps": [] }])
(let
    (
        (ref-TS01-C1:module{TalosStageOne_ClientOneV2} TS01-C1)
        (ref-DPOF:module{DemiourgosPactOrtoFungibleV2} DPOF)
        (ref-DALOS:module{OuronetDalosV2} DALOS)
        (o:string "MOCKO-98c486052a51")
        (patron:string KST.ANHD)
        (emma:string KST.EMMA)
    )
    (ref-TS01-C1::DPOF|C_Control patron o true true true true true true true false)
    ;;...and the mint target needs the ADD-QUANTITY role: `DPOF|C>MINT` enforces it on the ACCOUNT
    ;;being credited, not on the caller (`06_DPOF.pact:851`). ANHD holds it from DPOF-02; EMMA does not.
    (ref-TS01-C1::DPOF|C_ToggleAddQuantityRole patron o emma true)
    ;;...and the CREATE role too, which unlike add-quantity is single-holder: `C_MoveCreateRole`
    ;;hands it over rather than granting a copy. That is destructive to LUMY's holding, which is
    ;;why the whole block rolls back — DPOF-G5 onward assumes LUMY keeps it.
    (ref-TS01-C1::DPOF|C_MoveCreateRole patron o emma)
    (ref-TS01-C1::DPOF|C_Mint patron o emma 10.0 [])
    (ref-TS01-C1::DPOF|C_Mint patron o emma 20.0 [])
    (ref-TS01-C1::DPOF|C_ToggleFreezeAccount patron o emma true)
    (let
        (
            (held:[integer] (ref-DPOF::URH_AccountNonces emma o))
        )
        (let
            (
                (plan:object{DpofUdcV2.DPOF|WipeSlicePlan}
                    (ref-DPOF::URHC_BuildWipeSlicePlan emma o (length held)))
            )
            (let
                (
                    (predicted:decimal
                        (at "ignis-need" (at "ignis" (INFO-ONE.INFO_DPOF|WipeFull patron o emma plan))))
                    (ignis-before:decimal (ref-DALOS::UR_TF_AccountSupply patron false))
                )
                ;;THE CAMPAIGN — one Cp_WipeSlice per slice, accumulated inside a single window.
                (map
                    (lambda (slice:object{DpofUdcV2.RemovableNonces})
                        (ref-TS01-C1::DPOF|Cp_WipeSlice patron o emma slice))
                    (at "slices" plan))
                (let
                    (
                        (real:decimal (- ignis-before (ref-DALOS::UR_TF_AccountSupply patron false)))
                    )
                    (map print
                        [
                            (format "<<DPOF-I21>> held={} slices={} predicted={} real={} delta={}"
                                [(length held) (at "slice-count" plan) predicted real (- real predicted)])
                            ;;the fixture really is multi-slice, so the SUM is under test and not just one leg
                            (expect "<<DPOF-I21>> the campaign really spans more than one slice"
                                true (> (at "slice-count" plan) 1))
                            (expect "<<DPOF-I21>> the grand-total quote equals the whole campaign's charge"
                                real predicted)
                            (expect "<<DPOF-I21>> ...and it is a real, non-zero charge" true (> real 0.0))
                            ;;witness — the campaign really emptied the holder
                            (expect "<<DPOF-I21>> ...witness: nothing wipeable remains"
                                0 (length (at "r-nonces" (ref-DPOF::URHC_WipePure emma o))))
                        ]
                    )
                )
            )
        )
    )
    ""
)
(env-sigs [])
(rollback-tx)

