(begin-tx "DPOF-G6 — a nonce taken out of circulation, which is a state production really writes")
(env-gasmodel "table")(env-gaslimit 100000000)(env-gas 0)
(namespace "ouronet-ns")
(print "--- [DPOF-G6 · 01 · the -1.0 out-of-circulation sentinel] ---")
;;UEV_NoncesCirculating enforces, per nonce, `(!= nonce-supply -1.0)`. Nothing in the suite had ever
;;produced a -1.0 supply, so the guard sat unpinned.
;;
;;WHERE -1.0 COMES FROM. This is not an invented state. 06_DPOF.pact:2497 does exactly this: when a
;;debit's amount EQUALS the nonce's whole supply, the nonce is "taken out of circulation" --
;;    (XI_UpdateNonceSupply id nonce -1.0)
;;    (XI_UpdateNonceHolder id nonce BAR)
;;-- so a fully-debited nonce carries supply -1.0 and holder BAR forever. The fixture below writes
;;BOTH fields, not just the one the guard reads, so it is the production state rather than a
;;convenient half of it. (Reaching it through a real debit would need a holder with the exact full
;;balance and the transfer path set up; writing the row is the same state for a fraction of the
;;setup. See 2026-09-12-state-driven-guard-coverage.md.)
;;
;;The nonce row used here exists because of the earlier transactions in this file -- MOCKO nonce 1
;;with supply 1250.0. That is also why this block is at the END: at load time the nonce table is
;;empty and the guard's `read` would fail for a missing row instead of the reason being tested.
(let ((t:string "MOCKO-98c486052a51"))
    (map print
        [
            (expect "<<DPOF-G6>> the nonce starts in circulation, with a real supply"
                [true 1250.0] [(!= -1.0 (DPOF.UR_NonceSupply t 1)) (DPOF.UR_NonceSupply t 1)])
            (expect "<<DPOF-G6>> ...so the circulation guard passes, per nonce"
                [true] (DPOF.UEV_NoncesCirculating t [1]))
        ]
    )
    (env-module-admin DPOF)
    ;;both fields, exactly as 06_DPOF.pact:2497-2499 writes them
    (update DPOF.DPOF|T|Nonces (DPOF.UC_IdNonce t 1)
        { "supply" : -1.0, "holder" : (U|CT.CT_BAR) })
    (map print
        [
            (expect-failure "<<DPOF-G6>> a nonce out of circulation is refused, and named"
                "Orto-Fungible MOCKO-98c486052a51 Nonce 1 must be in Circulation for exec"
                (DPOF.UEV_NoncesCirculating t [1]))
            ;;the guard maps over the list, so a GOOD nonce alongside a bad one must still fail --
            ;;otherwise a batch operation could slip a dead nonce through on the strength of its
            ;;neighbours. The list is [1 1] because nonce 1 is the only row on this chain; the point
            ;;is that every element is checked, not that the two differ.
            (expect-failure "<<DPOF-G6>> ...and it is checked per element, not just on the first"
                "must be in Circulation for exec" (DPOF.UEV_NoncesCirculating t [1 1]))
            ;;an EMPTY nonce list passes vacuously -- `map` over [] does nothing. Pinned because a
            ;;caller that computes its nonce list and gets [] gets no protection from this guard,
            ;;which is worth knowing at the call sites rather than rediscovering.
            (expect "<<DPOF-G6>> an empty nonce list passes vacuously -- the guard never runs"
                [] (DPOF.UEV_NoncesCirculating t []))
        ]
    )
    ""
)
(rollback-tx)

;;|| NEXT >
;;
(begin-tx "DPOF-G7 — an RBT tied to an ATS pair is immutable")
(env-gasmodel "table")(env-gaslimit 100000000)(env-gas 0)
(namespace "ouronet-ns")
(print "--- [DPOF-G7 · 01 · the reward-bearing-token link] ---")
;;UEV_UpdateRewardBearingToken enforces `(= rbt BAR)` -- the reward-bearing-token link may be set
;;once and never changed, because an ATS pair on the other side depends on it. Unpinned because no
;;DPOF on this chain is half of an ATS pair.
;;
;;Note what the message does NOT contain: the id. It formats only `OF`, the module's own "Orto-
;;Fungible" literal, so the rejection cannot tell you WHICH token was already tied. Pinned as it
;;reads -- if the id is ever added the expected string here needs updating, which is the point.
(let ((t:string "MOCKO-98c486052a51"))
    (map print
        [
            (expect "<<DPOF-G7>> the token starts untied, carrying the BAR sentinel"
                (U|CT.CT_BAR) (DPOF.UR_RewardBearingToken t))
            (expect "<<DPOF-G7>> ...so the immutability guard passes while it is free"
                true (DPOF.UEV_UpdateRewardBearingToken t))
        ]
    )
    (env-module-admin DPOF)
    (update DPOF.DPOF|T|Properties t { "reward-bearing-token" : "AURYN-98c486052a51" })
    (map print
        [
            (expect-failure "<<DPOF-G7>> once tied to a pair, the RBT link cannot be updated"
                "Orto-Fungible as an RBT is immutable tied to an ATS-Pair"
                (DPOF.UEV_UpdateRewardBearingToken t))
            ;;...and the guard is a BAR test, not an existence test: any non-BAR value trips it,
            ;;including a token id that does not exist. That matters because it means a corrupted
            ;;row locks the link permanently rather than failing somewhere more diagnosable.
            (expect-failure "<<DPOF-G7>> ...and any non-BAR value trips it, even a nonexistent id"
                "immutable tied to an ATS-Pair"
                (let ((ignore (update DPOF.DPOF|T|Properties t
                                  { "reward-bearing-token" : "NOSUCHTOKEN-000000000000" })))
                    (DPOF.UEV_UpdateRewardBearingToken t)))
        ]
    )
    ""
)
(rollback-tx)

