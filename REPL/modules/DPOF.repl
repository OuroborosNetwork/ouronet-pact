(begin-tx "DPOF-G12 — three client guards: bulk-transfer shape, the ATS-owner mint rule, the debit floor")
(env-gasmodel "table")(env-gaslimit 150000000)(env-gas 0)
(namespace "ouronet-ns")
;;PK_Emma is here for the SUCCEEDING debit in section 03 only: nonce 1 ended up in her account earlier
;;in this file, and a transfer is signed by the holder. Every REFUSAL below needs only the admin key,
;;because each of those guards sits in front of the ownership check.
(env-sigs [{ "key": "PK_AncientHodler", "caps": [] }, { "key": "PK_Emma", "caps": [] }])
(print "--- [DPOF-G12 · 01 · the bulk-transfer shape check, two ways to fail it] ---")
;;DPOF|C>BULK-TRANSFER folds several shape conditions into ONE message, so the same sentence answers
;;for different mistakes. Two of them are driven here because a single case would leave the `fold`
;;half-tested: an EMPTY receiver list (`(> l 0)`) and receivers that outnumber the nonce legs
;;(`(= l (length nonces-array))`). Pure argument-domain -- no fixture at all.
(let
    (
        (ref-DPOF:module{DemiourgosPactOrtoFungibleV2} DPOF)
        (ref-TS01-C1:module{TalosStageOne_ClientOneV2} TS01-C1)
        (t:string "MOCKO-98c486052a51")
    )
    (map print
        [
            (expect-failure "<<DPOF-G12>> a bulk transfer with NO receivers is refused"
                "Invalid DPOF bulk transfer: receiver/nonces legs or nonce list"
                (ref-TS01-C1::DPOF|C_BulkTransfer KST.ANHD t [] KST.ANHD [] false))
            (expect-failure "<<DPOF-G12>> ...and so is one nonce leg against two receivers"
                "Invalid DPOF bulk transfer: receiver/nonces legs or nonce list"
                (ref-TS01-C1::DPOF|C_BulkTransfer KST.ANHD t [[1]] KST.ANHD [KST.EMMA KST.LUMY] false))
        ]
    )
    (print "--- [DPOF-G12 · 02 · when the ATS contract owns a token, only it may mint] ---")
    ;;DPOF|C>MINT's rule: if the token's owner IS the ATS smart account, no other client may mint --
    ;;ATS mints its own RBT nonces against staked value, and a third-party mint would create RBT
    ;;supply with nothing behind it. Written as `(if (and (= owner ATS|SC_NAME) (!= client owner))
    ;;(enforce false "…") …)`, i.e. an `enforce false` reached only by that exact combination.
    ;;
    ;;No ATS-owned DPOF exists on this chain, so the owner field is written to the ATS smart-account
    ;;name -- which is precisely the production state being modelled, since ATS becomes the owner when
    ;;it registers a Hot-RBT. Rolled back; DPOF-G12b is the leakage check.
    (env-module-admin DPOF)
    (let ((ats-sc:string (DALOS.GOV|ATS|SC_NAME)))
        (map print
            [
                (expect "<<DPOF-G12>> the token starts owned by ANHD, not by the ATS contract"
                    [true false]
                    [(= KST.ANHD (ref-DPOF::UR_Konto t)) (= ats-sc (ref-DPOF::UR_Konto t))])
                (expect "<<DPOF-G12>> ...and ANHD can mint it while that is true"
                    true (!= "" (ref-TS01-C1::DPOF|C_Mint KST.ANHD t KST.ANHD 5.0 [])))
            ]
        )
        (update DPOF.DPOF|T|Properties t { "owner-konto" : ats-sc })
        (map print
            [
                (expect "<<DPOF-G12>> the ATS contract now owns the token"
                    true (= ats-sc (ref-DPOF::UR_Konto t)))
                (expect-failure "<<DPOF-G12>> ...so ANHD may no longer mint it"
                    "Only the ATS owner can mint when the owner is ATS"
                    (ref-TS01-C1::DPOF|C_Mint KST.ANHD t KST.ANHD 5.0 []))
            ]
        )
        (update DPOF.DPOF|T|Properties t { "owner-konto" : KST.ANHD })
    )
    (print "--- [DPOF-G12 · 03 · the per-nonce debit floor] ---")
    ;;DPOF|C>DEBIT enforces, PER NONCE, `(<= amount nonce-supply)` -- a nonce cannot be debited below
    ;;zero. Its message names the token, the nonce AND the account, which is what makes it useful in a
    ;;multi-nonce batch: the caller learns which leg was wrong.
    ;;
    ;;The amount-taking debit path (C_Transmit) sits behind the token's SEGMENTATION flag, and this
    ;;token is issued with it off -- that refusal answers first. Segmentation is set at issuance
    ;;(06_DPOF.pact:2417) with no client to toggle it, so the flag is written directly: a segmented
    ;;token is an ordinary production configuration, not a contrived state.
    (update DPOF.DPOF|T|Properties t { "segmentation" : true })
    (map print
        [
            (expect "<<DPOF-G12>> segmentation is on, so the amount-taking debit path is open"
                true (ref-DPOF::UR_Segmentation t))
            (expect "<<DPOF-G12>> ...and nonce 1 holds far less than the amount about to be asked for"
                true (< (ref-DPOF::UR_NonceSupply t 1) 999999.0))
            (expect-failure "<<DPOF-G12>> debiting more than a nonce holds is refused, naming the nonce"
                "Cannot Debit into the Negatives for Orto-Fungible MOCKO-98c486052a51 Nonce 1 on Account"
                (ref-TS01-C1::DPOF|C_Transmit KST.ANHD t [1] [999999.0] KST.ANHD KST.EMMA false))
            ;;THE CONTRAST, and it is NOT a successful transfer. Driving one here would mean clearing
            ;;the holder check and then DPOF's transfer-role matrix (pinned separately by DPOF-G5..G5c)
            ;;-- three fixtures deep for one assertion. What actually needs proving is narrower: that
            ;;the amount guard is a THRESHOLD rather than a blanket refusal of the segmented path.
            ;;
            ;;So the same call is made with an amount WITHIN the supply, and the assertion is that the
            ;;debit-floor message STOPS ANSWERING -- a different guard further down replies instead.
            ;;That is the whole claim, and it costs nothing.
            ;;
            ;;Two ordering facts fell out of getting here, both worth keeping: the over-debit above
            ;;used ANHD as sender and still reached the amount guard, so the amount check runs BEFORE
            ;;the holder check; and with a legal amount the next refusal is about ROLES, not ownership,
            ;;so the role matrix sits in front of the holder test too.
            ;;(Written with expect-failure, not `try`: `(try default expr)` returns the DEFAULT when
            ;;expr fails, so it hands back the fallback and never the message. expect-failure is the
            ;;only thing in this suite that can assert WHICH error came out.)
            (expect-failure "<<DPOF-G12>> ...while a legal amount gets past it, and a LATER guard answers"
                "Incompatible Transfer Roles"
                (ref-TS01-C1::DPOF|C_Transmit KST.ANHD t [1] [1.0]
                    (ref-DPOF::UR_NonceHolder t 1) KST.ANHD false))
        ]
    )
    ""
)
(env-sigs [])
;;this tx minted, reassigned ownership, turned segmentation on and moved a nonce balance
(rollback-tx)

;;|| NEXT >
;;
(begin-tx "DPOF-G12b — the ownership and segmentation writes were rolled back")
(namespace "ouronet-ns")
(print "--- [DPOF-G12b · 01 · no leakage] ---")
;;DPOF-G12 handed the token to the ATS contract, switched segmentation on and minted twice. An owner
;;that leaked would make every later owner-gated assertion in this file fail with a message about ATS;
;;a segmentation flag that leaked would open a transfer path the rest of the file assumes is shut.
(let ((t:string "MOCKO-98c486052a51"))
    (map print
        [
            (expect "<<DPOF-G12b>> the token is owned by ANHD again, not by the ATS contract"
                true (= KST.ANHD (DPOF.UR_Konto t)))
            (expect "<<DPOF-G12b>> ...segmentation is off again"
                false (DPOF.UR_Segmentation t))
            (expect "<<DPOF-G12b>> ...and nonce 1's supply is untouched by the mints and the transfer"
                1250.0 (DPOF.UR_NonceSupply t 1))
        ]
    )
    ""
)
(commit-tx)

