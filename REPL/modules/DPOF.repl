;; REPL/modules/DPOF.repl — STANDALONE DPOF (ortofungible) tester.
;;
;; P2 rebuild. The previous version asserted NOTHING about DPOF -- it printed exactly the deploy
;; core's 11 expect / 7 expect-failure baseline and passed because booting a chain passes.
;;
;; DPOF is nonce-bearing: a mint creates a NEW NONCE rather than adding to a flat supply, which
;; is the property most of these assertions are really about.
;;
;; Run: cd REPL && pact modules/DPOF.repl
(load "../deploy-stage00.repl")
(load "../deploy-stage01.repl")
(load "../fixtures/mock-of.repl")

;;|| NEXT >
;;
(begin-tx "DPOF-01 — issuance properties (C_Issue, via fixture)")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(namespace "ouronet-ns")
(print "--- [DPOF-01 · 01 · issuance properties] ---")
(let
    (
        (ref-DPOF:module{DemiourgosPactOrtoFungibleV2} DPOF)
        (o:string "MOCKO-98c486052a51")
    )
    (map print
        [
            (expect "<<DPOF-01>> C_Issue set the owner konto"          KST.ANHD (ref-DPOF::UR_Konto o))
            (expect "<<DPOF-01>> C_Issue set decimals to 24"           24     (ref-DPOF::UR_Decimals o))
            (expect "<<DPOF-01>> C_Issue set the ticker"               "MOCKO" (ref-DPOF::UR_Ticker o))
            (expect "<<DPOF-01>> C_Issue set can-upgrade ON"           true   (ref-DPOF::UR_CanUpgrade o))
            (expect "<<DPOF-01>> C_Issue set can-change-owner ON"      true   (ref-DPOF::UR_CanChangeOwner o))
            (expect "<<DPOF-01>> C_Issue set can-transfer-create-role ON"
                true (ref-DPOF::UR_CanTransferOftCreateRole o))
            (expect "<<DPOF-01>> C_Issue set can-freeze OFF"           false  (ref-DPOF::UR_CanFreeze o))
            (expect "<<DPOF-01>> C_Issue set can-wipe OFF"             false  (ref-DPOF::UR_CanWipe o))
            (expect "<<DPOF-01>> C_Issue registered the id"            true   (ref-DPOF::UR_IzId o))
            (expect "<<DPOF-01>> a fresh ortofungible has no nonces yet" 0    (ref-DPOF::UR_NoncesUsed o))
            (expect "<<DPOF-01>> a fresh ortofungible has zero supply" 0.0    (ref-DPOF::UR_Supply o))
        ]
    )
    ""
)
(commit-tx)

;;|| NEXT >
;;
(begin-tx "DPOF-02 — C_Mint creates a NEW NONCE (not a flat supply bump)")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(namespace "ouronet-ns")
(print "--- [DPOF-02 · 01 · mint creates a nonce] ---")
(env-sigs [{ "key": "PK_AncientHodler", "caps": [] }])
(let
    (
        (ref-DPOF:module{DemiourgosPactOrtoFungibleV2} DPOF)
        (ref-TS01-C1:module{TalosStageOne_ClientOneV2} TS01-C1)
        (o:string "MOCKO-98c486052a51")
        (patron:string KST.ANHD)
    )
    (let
        (
            (n0:integer (ref-DPOF::UR_NoncesUsed o))
            (s0:decimal (ref-DPOF::UR_Supply o))
        )
        (map print
            [
                ;;GATE: for an ortofungible, minting a new nonce is itself ADD-QUANTITY gated --
                ;;the role is required even of the token OWNER, and even though no nonce exists
                ;;yet to add to.
                (expect-failure
                    "<<DPOF-02>> C_Mint is rejected while the add-quantity role is unset"
                    "must be set to true for exec"
                    (ref-TS01-C1::DPOF|C_Mint patron o patron 1000.0 [{}]))
            ]
        )
        (ref-TS01-C1::DPOF|C_ToggleAddQuantityRole patron o patron true)
        (ref-TS01-C1::DPOF|C_Mint patron o patron 1000.0 [{}])
        (map print
            [
                (expect "<<DPOF-02>> C_Mint used exactly one new nonce"
                    (+ n0 1) (ref-DPOF::UR_NoncesUsed o))
                (expect "<<DPOF-02>> C_Mint raised total supply by the minted amount"
                    (+ s0 1000.0) (ref-DPOF::UR_Supply o))
                (expect "<<DPOF-02>> the new nonce holds the whole minted amount"
                    1000.0 (ref-DPOF::UR_NonceSupply o 1))
                (expect "<<DPOF-02>> the minter holds the new nonce"
                    patron (ref-DPOF::UR_NonceHolder o 1))
                (expect "<<DPOF-02>> nonce 1 is registered"
                    true (ref-DPOF::UR_IzNonce o 1))
            ]
        )
    )
    ""
)
(commit-tx)

;;|| NEXT >
;;
(begin-tx "DPOF-03 — C_AddQuantity grows an EXISTING nonce in place")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(namespace "ouronet-ns")
(print "--- [DPOF-03 · 01 · add-quantity grows in place] ---")
(env-sigs [{ "key": "PK_AncientHodler", "caps": [] }])
(let
    (
        (ref-DPOF:module{DemiourgosPactOrtoFungibleV2} DPOF)
        (ref-TS01-C1:module{TalosStageOne_ClientOneV2} TS01-C1)
        (o:string "MOCKO-98c486052a51")
        (patron:string KST.ANHD)
    )
    (let
        (
            (n0:integer (ref-DPOF::UR_NoncesUsed o))
            (v0:decimal (ref-DPOF::UR_NonceSupply o 1))
        )
        (ref-TS01-C1::DPOF|C_AddQuantity patron o patron 1 250.0)
        (map print
            [
                (expect "<<DPOF-03>> C_AddQuantity grew the EXISTING nonce, creating none"
                    n0 (ref-DPOF::UR_NoncesUsed o))
                (expect "<<DPOF-03>> C_AddQuantity added exactly the amount to that nonce"
                    (+ v0 250.0) (ref-DPOF::UR_NonceSupply o 1))
            ]
        )
    )
    ""
)
(commit-tx)

;;|| NEXT >
;;
(begin-tx "DPOF-04 — C_Transfer moves a whole nonce; supply is conserved")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(namespace "ouronet-ns")
(print "--- [DPOF-04 · 01 · nonce transfer] ---")
(env-sigs [{ "key": "PK_AncientHodler", "caps": [] }])
(let
    (
        (ref-DPOF:module{DemiourgosPactOrtoFungibleV2} DPOF)
        (ref-TS01-C1:module{TalosStageOne_ClientOneV2} TS01-C1)
        (o:string "MOCKO-98c486052a51")
        (patron:string KST.ANHD)
        (emma:string KST.EMMA)
    )
    (let
        (
            (s0:decimal (ref-DPOF::UR_Supply o))
            (v1:decimal (ref-DPOF::UR_NonceSupply o 1))
        )
        (ref-TS01-C1::DPOF|C_Transfer patron o [1] patron emma false)
        (map print
            [
                (expect "<<DPOF-04>> C_Transfer moved the nonce to the receiver"
                    emma (ref-DPOF::UR_NonceHolder o 1))
                (expect "<<DPOF-04>> the nonce kept its full value across the move"
                    v1 (ref-DPOF::UR_NonceSupply o 1))
                (expect "<<DPOF-04>> INVARIANT: a nonce transfer conserves total supply"
                    s0 (ref-DPOF::UR_Supply o))
            ]
        )
    )
    ""
)
(commit-tx)

;;|| NEXT >
;;
(begin-tx "DPOF-05 — pause + control properties")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(namespace "ouronet-ns")
(print "--- [DPOF-05 · 01 · pause + control] ---")
(env-sigs [{ "key": "PK_AncientHodler", "caps": [] }])
(let
    (
        (ref-DPOF:module{DemiourgosPactOrtoFungibleV2} DPOF)
        (ref-TS01-C1:module{TalosStageOne_ClientOneV2} TS01-C1)
        (o:string "MOCKO-98c486052a51")
        (patron:string KST.ANHD)
    )
    (map print [(expect "<<DPOF-05>> token starts unpaused" false (ref-DPOF::UR_IsPaused o))])
    (ref-TS01-C1::DPOF|C_TogglePause patron o true)
    (map print
        [
            (expect "<<DPOF-05>> C_TogglePause paused the token" true (ref-DPOF::UR_IsPaused o))
            ;;The token is PAUSED for exactly these two lines -- the only window in this suite
            ;;where UEV_PauseState's <state>=false arm is live. Read-only, so the unpause below
            ;;still sees the state it expects.
            (expect-failure "<<DPOF-05>> UEV_PauseState rejects <state> false while the token IS paused"
                "is already paused" (ref-DPOF::UEV_PauseState o false))
        ]
    )
    (ref-TS01-C1::DPOF|C_TogglePause patron o false)
    (map print [(expect "<<DPOF-05>> C_TogglePause unpaused the token" false (ref-DPOF::UR_IsPaused o))])
    ;;C_Control (cu cco casr ctocr cf cw cp sg) — turn can-pause OFF, keep the rest
    (ref-TS01-C1::DPOF|C_Control patron o true true true true false false false false)
    (map print
        [
            (expect "<<DPOF-05>> C_Control turned can-pause OFF"  false (ref-DPOF::UR_CanPause o))
            (expect "<<DPOF-05>> C_Control left can-upgrade ON"   true  (ref-DPOF::UR_CanUpgrade o))
        ]
    )
    ;;--- reversible window. DPOF|S>CONTROL gates on can-upgrade, which stays ON above, so these
    ;;flips can be undone. can-add-special-role and can-transfer-oft-create-role are ON for every
    ;;fixture token in the suite, so their REJECTING side has no other live input anywhere --
    ;;DPOF-G1 can only assert the passing side. Restored below so DPOF-MCR and DPOF-G1 are
    ;;unaffected, and the restore is asserted rather than assumed.
    ;;can-change-owner joins the flip: like casr/ctocr it is REVERSIBLE, because DPOF|S>CONTROL
    ;;gates on can-upgrade -- which stays ON -- not on can-change-owner itself. (DPTF's
    ;;can-upgrade is the one-way case, and needed a dedicated token in modules/ADVERSARIAL.repl.)
    (ref-TS01-C1::DPOF|C_Control patron o true false false false false false false false)
    (map print
        [
            (expect "<<DPOF-05>> can-add-special-role is now OFF" false (ref-DPOF::UR_CanAddSpecialRole o))
            (expect "<<DPOF-05>> can-change-owner is now OFF" false (ref-DPOF::UR_CanChangeOwner o))
            (expect-failure "<<DPOF-05>> UEV_CanChangeOwnerON rejects a token whose ownership is fixed"
                "ownership cannot be changed" (ref-DPOF::UEV_CanChangeOwnerON o))
            (expect-failure "<<DPOF-05>> UEV_CanAddSpecialRoleON rejects a token that forbids them"
                "no special roles can be added" (ref-DPOF::UEV_CanAddSpecialRoleON o))
            ;;This message carried a stray brace until 2026-09-10: the format string read
            ;;"{}} Token {} ..." so it rendered as "DPOF} Token ...". DPMF words the same rule
            ;;correctly, which is what flagged it. Pinned here on the CORRECTED text.
            (expect-failure "<<DPOF-05>> UEV_CanTransferOftCreateRoleON rejects a token that forbids it"
                "cannot have its create role transfered" (ref-DPOF::UEV_CanTransferOftCreateRoleON o))
        ]
    )
    (ref-TS01-C1::DPOF|C_Control patron o true true true true false false false false)
    (map print
        [
            (expect "<<DPOF-05>> can-add-special-role restored" true (ref-DPOF::UR_CanAddSpecialRole o))
            (expect "<<DPOF-05>> can-transfer-oft-create-role restored" true (ref-DPOF::UR_CanTransferOftCreateRole o))
            (expect "<<DPOF-05>> can-change-owner restored" true (ref-DPOF::UR_CanChangeOwner o))
        ]
    )
    ""
)
(commit-tx)

;;|| NEXT >
;;
(begin-tx "DPOF-MCR — C_MoveCreateRole MOVES, it does not merely grant (audit #2C)")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(namespace "ouronet-ns")
(print "--- [DPOF-MCR · 01 · two consecutive moves] ---")
;;DPOF|C_MoveCreateRole existed ONLY in _scratch_dpof_c2_moverole.repl -- an audit-finding proof
;;the gate does not run, and which no longer executes at all. The finding it proves (#2C) is
;;precisely the kind that regresses silently, so it belongs in a gated tester.
;;
;;THE BUG IT GUARDS: XI_SwitchCreateRole re-derived "who is the previous holder" via UR_Verum4
;;AFTER XI_UpdateVerum4 had already overwritten that value with the NEW holder. So the revoke
;;targeted the new holder and cancelled itself, and "move" only ever GRANTED.
;;
;;A single move cannot detect this -- after one move the previous holder IS the owner, who keeps
;;the role for other reasons. It takes TWO consecutive moves, so that the second one's previous
;;holder is a third party with nothing else granting them the role.
(env-sigs [{ "key": "PK_AncientHodler", "caps": [] }])
(let
    (
        (ref-DPOF:module{DemiourgosPactOrtoFungibleV2} DPOF)
        (ref-TS01-C1:module{TalosStageOne_ClientOneV2} TS01-C1)
        (id:string "MOCKO-98c486052a51")
        (patron:string KST.ANHD)
        (emma:string KST.EMMA)
        (lumy:string KST.LUMY)
    )
    (map print
        [
            (expect "<<DPOF-MCR>> precondition: the collection permits moving the create role"
                true (ref-DPOF::UR_CanTransferOftCreateRole id))
        ]
    )
    ;;MOVE 1 — owner to EMMA. Granting is the half that always worked.
    (ref-TS01-C1::DPOF|C_MoveCreateRole patron id emma)
    (map print
        [
            (expect "<<DPOF-MCR>> move 1 recorded EMMA as the create-role holder"
                emma (ref-DPOF::UR_Verum4 id))
            (expect "<<DPOF-MCR>> move 1 granted EMMA the role"
                true (ref-DPOF::UR_R-Create id emma))
        ]
    )
    ;;MOVE 2 — EMMA to LUMY. THE TEST: EMMA is the real previous holder and is NOT the owner,
    ;;so nothing else keeps the role on her. If the revoke targets the wrong account she keeps it.
    (ref-TS01-C1::DPOF|C_MoveCreateRole patron id lumy)
    (map print
        [
            (expect "<<DPOF-MCR>> move 2 recorded LUMY as the holder"
                lumy (ref-DPOF::UR_Verum4 id))
            (expect "<<DPOF-MCR>> move 2 granted LUMY the role"
                true (ref-DPOF::UR_R-Create id lumy))
            ;;#2C REGRESSION GUARD — this is the assertion the finding exists for.
            (expect "<<DPOF-MCR>> #2C: the PREVIOUS holder lost it -- a move, not a grant"
                false (ref-DPOF::UR_R-Create id emma))
        ]
    )
    ""
)
(print "===^^^===")
(commit-tx)

;;|| NEXT >
;;
(begin-tx "DPOF-G1 — the UEV_ guard family, probed DIRECTLY")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(namespace "ouronet-ns")
(print "--- [DPOF-G1 · 01 · property guards] ---")
;;Same shape as DPTF-G1 (see that block for the reasoning). `UEV_*` is unprotected, so the whole
;;family fits in one transaction at one line per guard, and every trip is derived from the LIVE
;;state rather than a guessed constant -- an expect-failure that does not fail proves nothing and
;;nothing flags it.
;;
;;MOCKO is issued with can-freeze and can-wipe OFF and everything else ON, so one fixture gives
;;both sides of the property family without needing a second token.
(env-sigs [{ "key": "PK_AncientHodler", "caps": [] }])
(let
    (
        (ref-DPOF:module{DemiourgosPactOrtoFungibleV2} DPOF)
        (o:string "MOCKO-98c486052a51")
    )
    (map print
        [
            ;;preconditions -- the pairs below mean nothing if the flags are not what we think
            (expect "<<DPOF-G1>> MOCKO cannot be frozen" false (ref-DPOF::UR_CanFreeze o))
            (expect "<<DPOF-G1>> MOCKO cannot be wiped"  false (ref-DPOF::UR_CanWipe o))
            (expect "<<DPOF-G1>> MOCKO can add special roles" true (ref-DPOF::UR_CanAddSpecialRole o))
            ;;--- the OFF flags reject
            (expect-failure "<<DPOF-G1>> UEV_CanFreezeON rejects when the flag is off"
                "cannot be freezed" (ref-DPOF::UEV_CanFreezeON o))
            (expect-failure "<<DPOF-G1>> UEV_CanWipeON rejects when the flag is off"
                "cannot be wiped" (ref-DPOF::UEV_CanWipeON o))
            ;;--- the ON flags pass. Asserting the PASSING side matters: a guard that always
            ;;    fires would satisfy every rejection test above and still be broken.
            (expect "<<DPOF-G1>> the ON flags all pass their guards"
                true (!= "" (format "{}{}{}{}"
                    [(ref-DPOF::UEV_CanUpgradeON o) (ref-DPOF::UEV_CanChangeOwnerON o)
                     (ref-DPOF::UEV_CanAddSpecialRoleON o)
                     (ref-DPOF::UEV_CanTransferOftCreateRoleON o)])))
            ;;--- can-pause was turned OFF for good in DPOF-05 (DPOF|S>CONTROL needs only
            ;;    can-upgrade, which is still ON, but nothing in this suite turns pause back on),
            ;;    so this guard's rejecting side is live from here to the end of the file.
            (expect "<<DPOF-G1>> MOCKO can no longer be paused (set in DPOF-05)"
                false (ref-DPOF::UR_CanPause o))
            (expect-failure "<<DPOF-G1>> UEV_CanPauseON rejects when the flag is off"
                "cannot be paused" (ref-DPOF::UEV_CanPauseON o))
            ;;--- UEV_PauseState's OTHER arm. It takes the expected answer as an argument, so the
            ;;    state=true branch (require paused) is reachable on any UNPAUSED token with no
            ;;    state setup at all. The state=false branch is pinned in DPOF-05's pause window,
            ;;    which is the only place the token is actually paused.
            (expect "<<DPOF-G1>> MOCKO is not paused here" false (ref-DPOF::UR_IsPaused o))
            (expect-failure "<<DPOF-G1>> UEV_PauseState rejects <state> true while the token is UNPAUSED"
                "is already unpaused" (ref-DPOF::UEV_PauseState o true))
            ;;--- identity
            (expect-failure "<<DPOF-G1>> UEV_id rejects an id that was never issued"
                "does not exist" (ref-DPOF::UEV_id "NOPE-98c486052a51"))
        ]
    )
    ""
)
(print "--- [DPOF-G1 · 02 · link guards: existence asserted BOTH ways] ---")
;;UEV_Vesting/Sleeping/Hibernation each enforce (= has-link existance), so the live value passes
;;and its negation rejects. MOCKO has none of the three links, which is what makes both
;;directions assertable from one fixture.
(let
    (
        (ref-DPOF:module{DemiourgosPactOrtoFungibleV2} DPOF)
        (o:string "MOCKO-98c486052a51")
    )
    (let
        (
            (v:bool (ref-DPOF::URC_HasVesting o))
            (s:bool (ref-DPOF::URC_HasSleeping o))
            (h:bool (ref-DPOF::URC_HasHibernation o))
        )
        (map print
            [
                (expect "<<DPOF-G1>> MOCKO carries none of the three special links"
                    [false false false] [v s h])
                (expect "<<DPOF-G1>> each link guard PASSES on the live value"
                    true (!= "" (format "{}{}{}" [(ref-DPOF::UEV_Vesting o v)
                                                  (ref-DPOF::UEV_Sleeping o s)
                                                  (ref-DPOF::UEV_Hibernation o h)])))
                (expect-failure "<<DPOF-G1>> UEV_Vesting rejects the negation"
                    "is not satisfied with existance" (ref-DPOF::UEV_Vesting o (not v)))
                (expect-failure "<<DPOF-G1>> UEV_Sleeping rejects the negation"
                    "is not satisfied with existance" (ref-DPOF::UEV_Sleeping o (not s)))
                (expect-failure "<<DPOF-G1>> UEV_Hibernation rejects the negation"
                    "is not satisfied with existance" (ref-DPOF::UEV_Hibernation o (not h)))
            ]
        )
    )
    ""
)
(print "--- [DPOF-G1 · 03 · account-role and state guards, tripped from live values] ---")
(let
    (
        (ref-DPOF:module{DemiourgosPactOrtoFungibleV2} DPOF)
        (o:string "MOCKO-98c486052a51")
        (emma:string KST.EMMA)
    )
    (let
        (
            (frz:bool (ref-DPOF::UR_R-Frozen o emma))
            (adq:bool (ref-DPOF::UR_R-AddQuantity o emma))
            (brn:bool (ref-DPOF::UR_R-Burn o emma))
            (crt:bool (ref-DPOF::UR_R-Create o emma))
            (xfr:bool (ref-DPOF::UR_R-Transfer o emma))
            (seg:bool (ref-DPOF::UR_Segmentation o))
        )
        (map print
            [
                (expect "<<DPOF-G1>> each account-role guard PASSES on its live value"
                    true (!= "" (format "{}{}{}{}{}"
                        [(ref-DPOF::UEV_AccountFreezeState o emma frz)
                         (ref-DPOF::UEV_AccountAddQuantityState o emma adq)
                         (ref-DPOF::UEV_AccountBurnState o emma brn)
                         (ref-DPOF::UEV_AccountCreateState o emma crt)
                         (ref-DPOF::UEV_AccountTransferState o emma xfr)])))
                (expect-failure "<<DPOF-G1>> UEV_AccountFreezeState rejects the negation"
                    "must be set to" (ref-DPOF::UEV_AccountFreezeState o emma (not frz)))
                (expect-failure "<<DPOF-G1>> UEV_AccountAddQuantityState rejects the negation"
                    "must be set to" (ref-DPOF::UEV_AccountAddQuantityState o emma (not adq)))
                (expect-failure "<<DPOF-G1>> UEV_AccountBurnState rejects the negation"
                    "must be set to" (ref-DPOF::UEV_AccountBurnState o emma (not brn)))
                (expect-failure "<<DPOF-G1>> UEV_AccountCreateState rejects the negation"
                    "must be set to" (ref-DPOF::UEV_AccountCreateState o emma (not crt)))
                (expect-failure "<<DPOF-G1>> UEV_AccountTransferState rejects the negation"
                    "must be set to" (ref-DPOF::UEV_AccountTransferState o emma (not xfr)))
                (expect-failure "<<DPOF-G1>> UEV_SegmentationState rejects the negation"
                    "Segmentation" (ref-DPOF::UEV_SegmentationState o (not seg)))
            ]
        )
    )
    ""
)
(print "===^^^===")
(commit-tx)

;;|| NEXT >
;;
(begin-tx "DPOF-G2 — UCv_TakePureWipe: the slice bound is STRICT, and that is load-bearing")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(namespace "ouronet-ns")
(print "--- [DPOF-G2 · 01 · wipe-slice arity] ---")
;;UCv_TakePureWipe cuts the first <size> entries off a RemovableNonces object — it is the knife
;;the wipe planner uses to break one oversized wipe into slices that each fit in a transaction.
;;
;;Its guard is (< size l), STRICTLY less, and the strictness is the whole point rather than an
;;off-by-one: taking the ENTIRE set is not a slice, it is the un-sliced original, and a planner
;;that accepted it would loop forever handing itself back the same work. So the bound is pinned
;;on BOTH sides — one below the length succeeds, exactly the length is refused — because a test
;;that only tried an obviously-too-large size would pass just as happily against (<= size l).
(let
    (
        (ref-DPOF:module{DemiourgosPactOrtoFungibleV2} DPOF)
        (three:object{DpofUdcV2.RemovableNonces}
            (ref-DPOF::UDC_RemovableNonces [1 2 3] [10.0 20.0 30.0]))
    )
    (map print
        [
            ;;happy path, and it must take from the FRONT and keep nonces aligned with amounts —
            ;;a slicer that returned the right COUNT from the wrong end would wipe the wrong
            ;;nonces, and a length-only assertion would never notice.
            (expect "<<DPOF-G2>> a 2-of-3 slice keeps the first two nonces"
                [1 2] (at "r-nonces" (ref-DPOF::UCv_TakePureWipe three 2)))
            (expect "<<DPOF-G2>> ...with their amounts still aligned to them"
                [10.0 20.0] (at "r-amounts" (ref-DPOF::UCv_TakePureWipe three 2)))
            ;;an empty slice is legal — the planner may ask for zero on a boundary step
            (expect "<<DPOF-G2>> a zero-size slice is legal and empty"
                [] (at "r-nonces" (ref-DPOF::UCv_TakePureWipe three 0)))
            ;;--- the bound. Exactly the length is refused, which is what makes it STRICT.
            (expect-failure "<<DPOF-G2>> taking the WHOLE set is refused — a full take is not a slice"
                "is larger than the Data set of the Removable Nonces Object"
                (ref-DPOF::UCv_TakePureWipe three 3))
            (expect-failure "<<DPOF-G2>> ...and past the end likewise"
                "is larger than the Data set of the Removable Nonces Object"
                (ref-DPOF::UCv_TakePureWipe three 9))
        ]
    )
    ""
)
(commit-tx)

