(begin-tx "DPOF-G5c -- and the semantics are sender-OR-receiver, not sender-only")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(namespace "ouronet-ns")
(print "--- [DPOF-G5c . 01 . the OR, asserted from both sides] ---")
;;This is the half that the DPDC twin got wrong (#16H) and that nothing here checked. EITHER party
;;holding the role is enough. Asserting only the sender side would pass just as well against a
;;sender-only implementation -- which is precisely the bug that shipped next door.
(let ((mo:string "MOCKO-98c486052a51"))
    (map print
        [
            ;;NOTE ON THE RETURN TYPE, because it is a trap. With roles ACTIVE this function
            ;;returns the value of its `enforce-one` -- a BOOL. Only the roles-INACTIVE branch
            ;;returns the "... is allowed" string. A first version of these two assertions used
            ;;`(!= "" (…))`, which is VACUOUSLY TRUE here: a bool is never equal to a string, so it
            ;;would have passed for any return whatsoever. Caught by a type error when tightening
            ;;it. Asserting the bool directly is the honest form.
            ;;SENDER holds it
            (expect "<<DPOF-G5>> a move FROM the role holder is allowed"
                true (DPOF.UEV_MoveRoleCheck mo KST.LUMY KST.EMMA))
            ;;RECEIVER holds it -- the direction the sibling module silently lost
            (expect "<<DPOF-G5>> a move TO the role holder is allowed too -- the check is an OR"
                true (DPOF.UEV_MoveRoleCheck mo KST.ANHD KST.LUMY))
        ]
    )
)
(commit-tx)

