(namespace "ouronet-ns")
(print "--- [DPOF-G8 · 01 · no leakage] ---")
;;DPOF-G6 marked a nonce dead; DPOF-G7 tied a token to a pair that does not exist. Both rolled back.
;;If either had committed, MOCKO would be permanently unusable for every later assertion in any file
;;that loads this fixture, and the failures would point anywhere but here.
(let ((t:string "MOCKO-98c486052a51"))
    (map print
        [
            (expect "<<DPOF-G8>> the nonce is back in circulation with its original supply"
                1250.0 (DPOF.UR_NonceSupply t 1))
            (expect "<<DPOF-G8>> ...and its holder is not the BAR sentinel"
                true (!= (U|CT.CT_BAR) (DPOF.UR_NonceHolder t 1)))
            (expect "<<DPOF-G8>> the reward-bearing-token link is untied again"
                (U|CT.CT_BAR) (DPOF.UR_RewardBearingToken t))
        ]
    )
