(begin-tx "DPOF-G5 -- transfer roles: inactive until somebody holds one")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(namespace "ouronet-ns")
(env-sigs [{ "key": "PK_AncientHodler", "caps": [] }])
(print "--- [DPOF-G5 . 01 . activating the role set] ---")
;;DPOF::UEV_MoveRoleCheck's "Incompatible Transfer Roles from {} to {}" was UNPINNED
;;(`python3 REPL/tools/_cheapseam.py`). The check only runs when transfer roles are ACTIVE, and they are
;;active only once at least one account holds one -- an empty holder list reads as [BAR] and the
;;whole check is skipped. So the fixture is: grant the role to a THIRD party, then move between two
;;accounts that lack it.
;;
;;Worth pinning beyond the guard itself: archive/_verify_finding_DPDC-T_16H_transfer_role_receiver.repl
;;records that this function is the CORRECT sibling of DPDC-T's UEV_TransferRoles, which had a
;;copy-paste bug -- it computed the RECEIVER's membership from <sender> a second time, silently
;;degrading sender-OR-receiver to sender-only. Nothing asserted that DPOF's version really is an OR.
;;DPOF-G5c below does.
(let ((mo:string "MOCKO-98c486052a51"))
    (map print
        [
            ;;before: no holders, so the list is the BAR sentinel and the check is inert
            (expect "<<DPOF-G5>> with no role holders the list is the BAR sentinel"
                [(U|CT.CT_BAR)] (DPOF.UR_Verum5 mo))
        ]
    )
    (TS01-C1.DPOF|C_ToggleTransferRole KST.ANHD mo KST.LUMY true)
    (map print
        [
            (expect "<<DPOF-G5>> granting the role to one account activates the role set"
                1 (length (DPOF.UR_Verum5 mo)))
            (expect "<<DPOF-G5>> ...and it is the granted account that holds it"
                true (DPOF.UR_R-Transfer mo KST.LUMY))
            ;;the two parties used below hold nothing -- asserted so the rejection cannot be
            ;;coming from somewhere else
            (expect "<<DPOF-G5>> ...while neither party of the blocked move holds it"
                [false false] [(DPOF.UR_R-Transfer mo KST.ANHD) (DPOF.UR_R-Transfer mo KST.EMMA)])
        ]
    )
)
(commit-tx)

;;|| NEXT >
;;
(begin-tx "DPOF-G5b -- neither party holds the role: refused")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(namespace "ouronet-ns")
(print "--- [DPOF-G5b . 01 . the rejection] ---")
;;Matched on the stable prefix: the full message interpolates two 162-glyph account strings.
(map print
    [
        (expect-failure "<<DPOF-G5>> a move between two role-less accounts is refused"
            "Incompatible Transfer Roles from"
            (DPOF.UEV_MoveRoleCheck "MOCKO-98c486052a51" KST.ANHD KST.EMMA))
    ]
)
(commit-tx)

;;|| NEXT >
