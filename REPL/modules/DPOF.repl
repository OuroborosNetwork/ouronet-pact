(begin-tx "DPOF-G4 — the ortofungible amount-precision rule")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(namespace "ouronet-ns")
(print "--- [DPOF-G4 · 01 · UEV_Amount precision] ---")
;;P3.3. A plain callable UEV_. The amount must be representable at the token's OWN decimals --
;;anything finer would be silently truncated somewhere downstream, so the token's balance
;;arithmetic and the caller's intent would disagree by the lost digits.
;;
;;The bound is read from the token rather than written as a literal: MOCKO carries 24 decimals
;;today, and hardcoding 25 zeros would make this test vacuous the moment a fixture changes
;;precision. One digit past UR_Decimals is the smallest violation that exists.
(let*
    (
        (ref-DPOF:module{DemiourgosPactOrtoFungibleV2} DPOF)
        (o:string "MOCKO-98c486052a51")
        (d:integer (ref-DPOF::UR_Decimals o))
        (ok:decimal (floor 1.5 d))
        (too-fine:decimal (/ 1.0 (dec (^ 10 (+ d 1)))))
    )
    (map print
        [
            ;;precondition: an amount AT the token's precision is accepted, so the rejection below
            ;;is about the extra digit and not about UEV_Amount refusing everything.
            (expect "<<DPOF-G4>> an amount at the token's own precision is accepted"
                true (!= "" (format "{}" [(ref-DPOF::UEV_Amount o ok)])))
            (expect-failure "<<DPOF-G4>> ...and one digit finer than the token's precision is refused"
                "is not conform with the"
                (ref-DPOF::UEV_Amount o too-fine))
        ]
    )
    ""
)
(commit-tx)
;;NOT PINNED — UEV_UpdateRewardBearingToken ("{} as an RBT is immutable tied to an ATS-Pair")
;;fires only for an id that IS an RBT. MOCKO's reward-bearing-token field is BAR, so the guard
;;PASSES here; my first attempt asserted a failure and the suite correctly reported the call
;;succeeding. Every ortofungible RBT belongs to an ATS pair and lives in the ATS suites, not
;;this one, so driving it needs a cross-suite RBT rather than a new argument.

