;;
;; REPL/modules/PYTHIA.repl — canonical integration layout (OuronetInformational/ARCHITECTURE/REPL_AND_TESTS.md)
;;   Inter-tx:   ;;|| NEXT >  (same three lines as REPL/Stage_01/[2.2]_Core.repl)
;;   Intra-tx:   ;;==== <TX label> · mm · <slug> ====  + next-line (print "--- [<label> · mm · …] ---"); mm = 01.. within each (begin-tx …) (see OuronetInformational/ARCHITECTURE/REPL_AND_TESTS.md).
;;   format "{}": Talos / module echoes and (env-gas) — document additional prefixes in this file's (print …) lines as needed.
;;
(print "")
(print "================================================================")
(print "FILE  REPL/modules/PYTHIA.repl")
(print "================================================================")
(print "Legend (terminal observability): see ;; preface; echoes use <(…)> where helpful.")
(print "Source: ;;|| NEXT > between txs; ;;==== … · mm · … ==== + banner before each begin-tx.")
(print "")
;; REPL/modules/PYTHIA.repl — STANDALONE PYTHIA tester (blockchain-env-in-a-repl).
;; Fresh boot: Stage 00 sandbox + deploy core(s) + the PYTHIA suite only.
;; Run: cd REPL && pact modules/PYTHIA.repl   (see ARCHITECTURE/REPL_TEST_ARCHITECTURE.md)
(load "../deploy-stage00.repl")
(load "../deploy-stage01.repl")
(load "../Stage_01/[6.10]_PYTHIA.repl")

;;|| NEXT >
;;
(begin-tx "PYTHIA-PRICE — the two admin price setters (previously only in an UNGATED probe)")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(namespace "ouronet-ns")
(print "--- [PYTHIA-PRICE · 01 · deploy and rename prices] ---")
;;PYTHIA|A_UpdateDeployPrice and PYTHIA|A_UpdateRenamePrice existed ONLY in
;;_scratch_pythia_h12_price_wiring.repl -- a file the gate does not run. The ledger counted them
;;as exercised; nothing re-executed them. That is RULE 11 applied to G1, and it is why the ledger
;;now reports "exercised by a file the GATE RUNS" as a separate number.
;;
;;These two ARE the finding's fix: the core setters existed and were properly gated, but no Talos
;;client path reached them, so the admin could not actually change either price. The test that
;;matters is therefore that the Talos wrapper MOVES THE VALUE the readers return -- not that it
;;returns a string.
;;==== PYTHIA-PRICE — the two admin price setters (previously only in an UNGATED probe) · 01 · env-sigs (caps) ==== 
(print "--- [PYTHIA-PRICE — the two admin price setters (previously only in an UNGATED probe) · 01 · env-sigs (caps)] ---")
(env-sigs [{ "key": "PK_AncientHodler", "caps": [] }])
;;==== PYTHIA-PRICE — the two admin price setters (previously only in an UNGATED probe) · 02 · let / invocation ==== 
(print "--- [PYTHIA-PRICE — the two admin price setters (previously only in an UNGATED probe) · 02 · let / invocation] ---")
(let
    (
        (ref-PYTHIA:module{PythiaV5} PYTHIA)
        (ref-TS01-C4:module{TalosStageOne_ClientFourV8} TS01-C4)
    )
    (let
        (
            (d0:decimal (ref-PYTHIA::UR_DeployPrice))
            (r0:decimal (ref-PYTHIA::UR_RenamePrice))
        )
        (ref-TS01-C4::PYTHIA|A_UpdateDeployPrice 999.0)
        (ref-TS01-C4::PYTHIA|A_UpdateRenamePrice 888.0)
        (map print
            [
                (expect "<<PYTHIA-PRICE>> the deploy price is what the admin set" 999.0
                    (ref-PYTHIA::UR_DeployPrice))
                (expect "<<PYTHIA-PRICE>> the rename price is what the admin set" 888.0
                    (ref-PYTHIA::UR_RenamePrice))
                ;;The two are independent settings sharing one shape -- exactly where a
                ;;copy-paste slip would put both writes on the same row.
                (expect "<<PYTHIA-PRICE>> they are stored separately, not aliased"
                    false (= (ref-PYTHIA::UR_DeployPrice) (ref-PYTHIA::UR_RenamePrice)))
                (expect "<<PYTHIA-PRICE>> and both actually moved off their previous values"
                    true (and (!= d0 999.0) (!= r0 888.0)))
            ]
        )
        ;;restore, so this block leaves the chain as it found it
        (ref-TS01-C4::PYTHIA|A_UpdateDeployPrice d0)
        (ref-TS01-C4::PYTHIA|A_UpdateRenamePrice r0)
        (map print
            [
                (expect "<<PYTHIA-PRICE>> the setter is reversible -- deploy price restored"
                    d0 (ref-PYTHIA::UR_DeployPrice))
                (expect "<<PYTHIA-PRICE>> ...and rename price restored"
                    r0 (ref-PYTHIA::UR_RenamePrice))
            ]
        )
    )
    ""
)
(print "===^^^===")
(commit-tx)

;;|| NEXT >
;;
(begin-tx "PYTHIA-G1 — an API key needs key material")
(env-gasmodel "table")(env-gaslimit 150000000)(env-gas 0)
(namespace "ouronet-ns")
;;==== PYTHIA-G1 — an API key needs key material · 01 · env-sigs (caps) ==== ======================
(print "--- [PYTHIA-G1 — an API key needs key material · 01 · env-sigs (caps)] ---")
(env-sigs [{ "key": "PK_AncientHodler", "caps": [] }])
(print "--- [PYTHIA-G1 · 01 · the empty-pubkey guard] ---")
;;`PYTHIA|C>DEPLOY-API-KEY`'s first statement is `(enforce (!= public "") …)`, ahead of the Apollo-account
;;check and the owner capability -- so it answers for any caller and any account, and needed no fixture.
;;Deploying a key with no key material would register an oracle identity nothing could ever authenticate.
(map print
    [
        (expect-failure "<<PYTHIA-G1>> an API key with empty public material is refused"
            "Public key material must be non-empty"
            (TS01-C4.PYTHIA|C_DeployApiKey KST.ANHD KST.ANHD KST.ANHD ""))
        ;;...and a non-empty key gets PAST this guard -- shown by the NEXT guard answering instead, which
        ;;is the cheap way to prove the first one stopped without building an Apollo account fixture.
        (expect-failure "<<PYTHIA-G1>> ...while non-empty material gets past it and the Apollo check answers"
            "Apollo"
            (TS01-C4.PYTHIA|C_DeployApiKey KST.ANHD KST.ANHD KST.ANHD "some-public-key-material"))
    ]
)
(env-sigs [])
(commit-tx)

;;|| NEXT >
;;
(begin-tx "PYTHIA-LINK-ECON — why the FREE link is not a free-work vector")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(namespace "ouronet-ns")
(print "--- [PYTHIA-LINK-ECON · 01 · the one-shot bound on the unbilled operation] ---")
;;CONFORMANCE OBSERVATION `C-without-cumulator`, settled by execution.
;;
;;`TS01-C4::PYTHIA|C_Link` is the ONLY `C_` wrapper in that Talos file with no `patron` parameter
;;and no collect of any kind -- no `IGNIS::XE_CollectIgnis`, no `XE_CollectStoa*`, no `URCi_`. Its three
;;siblings all charge: `C_DeployApiKey` takes 500 native STOA, `C_UpdateDualConsumerLane` a rename
;;fee, `C_RevokeLink` an IGNIS fee. So it is an operation that performs two writes
;;(`XI_ApplyDualCounterparts` + `WI_DualLink`) and bills nothing, reachable through the gas station.
;;
;;THAT IS DELIBERATE -- both @docs say "(no fee)" -- but "deliberate" is not the same as "safe", and
;;what makes it safe is an economic bound that lives in a DIFFERENT function and was untested. This
;;block tests it, because the justification collapses if the bound ever weakens:
;;
;;  1] Linking requires TWO already-deployed Apollo halves. Each cost 500 native STOA.
;;  2] `UEV_DualPairForLink` refuses a half whose counterpart is already set.
;;  3] Counterparts are NEVER cleared -- revoke only flips the row inactive.
;;
;;Together those make the free call ONE-SHOT PER PAIR, FOREVER: ~1000 STOA buys exactly one free
;;link, and no amount of revoking buys another. [6.10] TX005 pins (3) directly ("counterparts
;;immutable"). What was missing is its CONSEQUENCE -- the part the economics actually rest on.
;;
;;THE FIXTURE MAKES THIS STRONGER THAN PLANNED. [6.10] does not merely revoke the pair: TX005
;;revokes it and TX006 RE-ACTIVATES it through the Cronoton `A_Link` path and renames the lane. So
;;by the time this block runs the pair has been round the full revoke/re-activate cycle -- the
;;richest state an attacker could try to recycle -- and the free entry point is still closed.
;;==== PYTHIA-LINK-ECON — why the FREE link is not a free-work vector · 01 · let / invocation ==== 
(print "--- [PYTHIA-LINK-ECON — why the FREE link is not a free-work vector · 01 · let / invocation] ---")
(let
    (
        (ref-PYTHIA:module{PythiaV5} PYTHIA)
        (ref-TS01-C4:module{TalosStageOne_ClientFourV8} TS01-C4)
        (apollo-std:string (read-string "PYTHIA|APOLLO-STANDARD"))
        (apollo-smt:string (read-string "PYTHIA|APOLLO-SMART"))
    )
    (env-sigs [{ "key": "PK_AncientHodler", "caps": [] }])
    (map print
        [
            ;;the state [6.10] actually leaves: linked, revoked, then re-activated again
            (expect "<<PYTHIA-LINK-ECON>> the pair has been revoked AND re-activated, and is live"
                true (ref-PYTHIA::UR_DualLinkIzActive
                          (ref-PYTHIA::UC_DualLinkKey apollo-std apollo-smt)))
            ;;...and the counterparts held through the whole cycle, both ways round
            (expect "<<PYTHIA-LINK-ECON>> ...with BOTH counterparts intact through it"
                [apollo-smt apollo-std]
                [(ref-PYTHIA::UR_Counterpart apollo-std)
                 (ref-PYTHIA::UR_Counterpart apollo-smt)])
            ;;THE CONSEQUENCE, and the assertion that makes "(no fee)" defensible: the free
            ;;operation cannot be repeated on this pair, in any state the pair can be put into.
            ;;(The lane must be DALOS|CHARSET glyphs -- `UEV_StoicTagName` runs FIRST in the cap, so
            ;;a hyphenated test name is rejected by the lane rule and never reaches the link rule.
            ;;Learned the hard way; "relinkattempt" is a valid tag.)
            (expect-failure "<<PYTHIA-LINK-ECON>> so the FREE link cannot be run again on the same pair"
                "Standard half is already linked"
                (ref-TS01-C4::PYTHIA|C_Link apollo-std apollo-smt "relinkattempt"))
            ;;and the bound is per-HALF, not per-pair-key: a linked standard half cannot be paired
            ;;with some third smart half either. Without this, one paid deployment could fund an
            ;;unbounded number of free links against fresh partners.
            (expect-failure "<<PYTHIA-LINK-ECON>> ...nor can a linked half be re-used against a DIFFERENT partner"
                "already linked"
                (ref-TS01-C4::PYTHIA|C_Link apollo-std
                    (read-string "PYTHIA|APOLLO-SMART-2") "crossattempt"))
        ]
    )
    (env-sigs [])
    ""
)
(commit-tx)
