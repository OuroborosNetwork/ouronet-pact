;;
;; REPL/modules/DPDC-S.repl — canonical integration layout (OuronetInformational/ARCHITECTURE/REPL_AND_TESTS.md)
;;   Inter-tx:   ;;|| NEXT >  (same three lines as REPL/Stage_01/[2.2]_Core.repl)
;;   Intra-tx:   ;;==== <TX label> · mm · <slug> ====  + next-line (print "--- [<label> · mm · …] ---"); mm = 01.. within each (begin-tx …) (see OuronetInformational/ARCHITECTURE/REPL_AND_TESTS.md).
;;   format "{}": Talos / module echoes and (env-gas) — document additional prefixes in this file's (print …) lines as needed.
;;
(print "")
(print "================================================================")
(print "FILE  REPL/modules/DPDC-S.repl")
(print "================================================================")
(print "Legend (terminal observability): see ;; preface; echoes use <(…)> where helpful.")
(print "Source: ;;|| NEXT > between txs; ;;==== … · mm · … ==== + banner before each begin-tx.")
(print "")
;; REPL/modules/DPDC-S.repl — STANDALONE DPDC-S tester (blockchain-env-in-a-repl).
;; Fresh boot: Stage 00 sandbox + deploy core(s) + the DPDC-S suite only.
;; Run: cd REPL && pact modules/DPDC-S.repl   (see ARCHITECTURE/REPL_TEST_ARCHITECTURE.md)
(load "../deploy-stage00.repl")
(load "../deploy-stage01.repl")
(load "../deploy-stage02.repl")
(load "../Stage_02/[6.1.3]_DPDC-S.repl")

;;|| NEXT >
;;
(begin-tx "DPDC-S-G1 — the set-definition validators, against the suite's live sets")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
;;==== DPDC-S-G1 — the set-definition validators, against the suite's live sets · 01 · namespace ==== 
(print "--- [DPDC-S-G1 — the set-definition validators, against the suite's live sets · 01 · namespace] ---")
(namespace "ouronet-ns")
(print "--- [DPDC-S-G1 · 01 · set-class identity and existence] ---")
;;P3.3, seventh module, and the best cost/benefit left in the worklist: 17 of DPDC-S's 23
;;unpinned sites are UEV_ -- unprotected, so a direct call is the whole test -- while the
;;[6.1.3] suite above has already built everything they read. TSFS carries 10 nonces and three
;;set-classes (SC1 primordial, SC2 composite, SC3 hybrid), so every trip below is taken against
;;REAL set data rather than a constructed shape.
;;==== DPDC-S-G1 — the set-definition validators, against the suite's live sets · 02 · let / invocation ==== 
(print "--- [DPDC-S-G1 — the set-definition validators, against the suite's live sets · 02 · let / invocation] ---")
(let
    (
        (ref-DPDC-S:module{DpdcSetsV2} DPDC-S)
        (sft:string "TSFS-98c486052a51")
    )
    (map print
        [
            ;;HAPPY PATH first: SC1 really exists, so the rejections below are about their own
            ;;guard rather than about the fixture being absent.
            (expect "<<DPDC-S-G1>> SC1 is a real set-class on the SFT"
                true (!= "" (format "{}" [(ref-DPDC-S::UEV_SetClass sft true 1)])))
            ;;WAS: both of UEV_SetClass's guards were DEAD --
            ;;
            ;;    (let ((sc:integer (UR_SetClass id son set-class)))     <- HARD read, runs FIRST
            ;;      (enforce (> set-class 0) "Invalid Set-Class Value")
            ;;      (enforce (= set-class sc) "Invalid DPDC Set Data"))
            ;;
            ;;The let binding is eager and UR_SetClass -> UR_Set is a plain `read`, so every input
            ;;the enforces were written to reject had already aborted inside the table read.
            ;;
            ;;FIXED 2026-09-10: the DOMAIN guard is hoisted above the let, matching the shape
            ;;UEV_IzSetClassFragmented already used directly below it. The two cases now separate
            ;;cleanly, and that separation is the point of asserting both:
            ;;
            ;;  * set-class 0 is OUT OF DOMAIN  -> the guard fires, with its own message.
            ;;  * set-class 99 is IN DOMAIN but has no row -> there is no existence guard here,
            ;;    only a domain guard, so the read error is the honest answer. Left as-is
            ;;    deliberately: inventing an existence guard would duplicate what the read
            ;;    already says. This assertion pins that distinction, not a defect.
            (expect-failure "<<DPDC-S-G1>> FIXED: set-class 0 now dies on the >0 guard, not in the table read"
                "Invalid Set-Class Value" (ref-DPDC-S::UEV_SetClass sft true 0))
            (expect-failure "<<DPDC-S-G1>> in-domain but absent set-class still reports the missing row (no existence guard by design)"
                "No value found in table" (ref-DPDC-S::UEV_SetClass sft true 99))
            ;;The fragmentation pair, against the suite's real state: [6.1.3] fragments SC1 and
            ;;leaves SC2/SC3 alone, so both directions are available without touching anything.
            (expect "<<DPDC-S-G1>> the predicate reports SC1 as fragmented (the suite fragments it)"
                true (ref-DPDC-S::UEV_IzSetClassFragmented sft true 1))
            (expect "<<DPDC-S-G1>> ...and SC2 as not"
                false (ref-DPDC-S::UEV_IzSetClassFragmented sft true 2))
            (expect-failure "<<DPDC-S-G1>> its own 0-guard has a distinct message, and DOES fire"
                "Only greater than 0 set-classes can be checked for fragmentation"
                (ref-DPDC-S::UEV_IzSetClassFragmented sft true 0))
            ;;UEV_Fragmentation REFUSES what the predicate merely reports -- asserted both ways,
            ;;since a validator that always passed would satisfy the accepting half alone.
            (expect "<<DPDC-S-G1>> UEV_Fragmentation accepts the fragmented class"
                true (!= "" (format "{}" [(ref-DPDC-S::UEV_Fragmentation sft true 1)])))
            (expect-failure "<<DPDC-S-G1>> ...and refuses the unfragmented one"
                "Set-Class must be fragmented for operation"
                (ref-DPDC-S::UEV_Fragmentation sft true 2))
            ;;UEV_NoncesForSetClass cross-checks the nonce count against the set's own shape.
            ;;SC1 is a 2-position primordial set, so one nonce is the wrong shape for it.
            (expect-failure "<<DPDC-S-G1>> a nonce list of the wrong LENGTH for the set-class"
                "Nonces list [1] are invalid for making a Set of Class 1"
                (ref-DPDC-S::UEV_NoncesForSetClass sft true [1] 1))
        ]
    )
    ""
)
(print "--- [DPDC-S-G1 · 02 · set-definition shape, SFT vs NFT] ---")
;;UEV_PrimordialSetElement is a 2x2 on the son discriminator: an SFT position must allow
;;EXACTLY ONE nonce (it is fungible within the position, so a choice would be meaningless),
;;while an NFT position must allow MORE THAN ONE (it is a choice among uniques). Each kind must
;;refuse the other's shape, which is the property the two branches exist for -- and neither
;;direction alone would show it.
(let
    (
        (ref-DPDC-S:module{DpdcSetsV2} DPDC-S)
        (ref-DPDC-UDC:module{DpdcUdcV2} DPDC-UDC)
        (sft:string "TSFS-98c486052a51")
    )
    (let
        (
            (one:object{DpdcUdcV2.DPDC|AllowedNonceForSetPosition}
                (ref-DPDC-UDC::UDC_DPDC|AllowedNonceForSetPosition [1]))
            (many:object{DpdcUdcV2.DPDC|AllowedNonceForSetPosition}
                (ref-DPDC-UDC::UDC_DPDC|AllowedNonceForSetPosition [1 2]))
        )
        (map print
            [
                ;;the diagonal
                (expect "<<DPDC-S-G1>> an SFT position accepts exactly one allowed nonce"
                    true (!= "" (format "{}" [(ref-DPDC-S::UEV_PrimordialSetElement true one)])))
                (expect "<<DPDC-S-G1>> an NFT position accepts more than one"
                    true (!= "" (format "{}" [(ref-DPDC-S::UEV_PrimordialSetElement false many)])))
                ;;the off-diagonal -- each refuses the other's shape, by its own message
                (expect-failure "<<DPDC-S-G1>> an SFT position REFUSES a multi-nonce choice"
                    "SFT Set Elements must have only 1 allowed element"
                    (ref-DPDC-S::UEV_PrimordialSetElement true many))
                (expect-failure "<<DPDC-S-G1>> an NFT position REFUSES a single-nonce position"
                    "NFT Set Elements must have more than 1 allowed element"
                    (ref-DPDC-S::UEV_PrimordialSetElement false one))
                ;;definition-level guards. The empty list is the one that matters: DPDC Audit
                ;;#51L added this check precisely because an empty definition used to crash in an
                ;;enumerate-based fold several lines below with an opaque out-of-bounds error.
                ;;This assertion is what keeps that fix from silently regressing.
                (expect-failure "<<DPDC-S-G1>> an EMPTY primordial set-definition is refused (audit #51L)"
                    "Set-Definition length must be between 1 and 20 positions"
                    (ref-DPDC-S::UEV_PrimordialSetDefinition sft true []))
                (expect-failure "<<DPDC-S-G1>> ...and one referencing a nonce the token does not have"
                    "Invalid Set-Definition for a Primordial Set"
                    (ref-DPDC-S::UEV_PrimordialSetDefinition sft true
                        [(ref-DPDC-UDC::UDC_DPDC|AllowedNonceForSetPosition [9999])]))
            ]
        )
        ""
    )
)
(print "--- [DPDC-S-G1 · 03 · composite definitions and the constituent readers] ---")
(let
    (
        (ref-DPDC-S:module{DpdcSetsV2} DPDC-S)
        (ref-DPDC-UDC:module{DpdcUdcV2} DPDC-UDC)
        (sft:string "TSFS-98c486052a51")
        (nft:string "TSFN-98c486052a51")
    )
    (map print
        [
            (expect "<<DPDC-S-G1>> a composite definition over the existing SC1 is accepted"
                true (!= "" (format "{}"
                    [(ref-DPDC-S::UEV_CompositeSetDefinition sft true
                        [(ref-DPDC-UDC::UDC_DPDC|AllowedClassForSetPosition 1)])])))
            (expect-failure "<<DPDC-S-G1>> an EMPTY composite definition is refused"
                "Set-Definition length must be between 1 and 20 positions"
                (ref-DPDC-S::UEV_CompositeSetDefinition sft true []))
            (expect-failure "<<DPDC-S-G1>> a position allowing set-class 0 is refused"
                "allowed-sclass must be greater than 0 for every position"
                (ref-DPDC-S::UEV_CompositeSetDefinition sft true
                    [(ref-DPDC-UDC::UDC_DPDC|AllowedClassForSetPosition 0)]))
            ;;well-formed but referencing a set-class beyond the ones defined: a DIFFERENT guard
            ;;from the >0 one above, and it is the one that stops a set from being defined in
            ;;terms of classes that do not exist yet.
            (expect-failure "<<DPDC-S-G1>> ...and one referencing a set-class that does not exist"
                "Invalid Set-Definition for a Composite Set with non existent Set-Classes"
                (ref-DPDC-S::UEV_CompositeSetDefinition sft true
                    [(ref-DPDC-UDC::UDC_DPDC|AllowedClassForSetPosition 99)]))
            ;;URCv_NonFungibleConstituents refuses to read constituents of a non-set nonce
            ;;(class 0 = a plain nonce, not a set).
            (expect-failure "<<DPDC-S-G1>> constituents cannot be read from a class-0 (non-set) nonce"
                "Invalid NFT Nonce to Read Constituents"
                (ref-DPDC-S::URCv_NonFungibleConstituents nft 1))
        ]
    )
    ""
)
(print "--- [DPDC-S-G1 · 04 · the two membership validators, and a message that names the wrong one] ---")
;;UEV_Primordial and UEV_Composite are twins: each cross-checks a nonce list against a set
;;definition, and each opens with the same length guard.
;;
;;FINDING: UEV_Primordial's length guard reports "Incompatible Input for <UEV_Composite>
;;Validation" -- it names its TWIN. A caller who hits it goes and reads the wrong validator.
;;Copy-paste, harmless to execution, actively misleading to anyone debugging.
;;
;;It also makes the pair a live example of the tool's own caveat: because both messages are
;;IDENTICAL, one test "pins" both by text-matching. That is why _enforce_coverage.py reports
;;PINNED as an upper bound and counts how many pins rest on wording shared across sites.
(let
    (
        (ref-DPDC-S:module{DpdcSetsV2} DPDC-S)
        (ref-DPDC-UDC:module{DpdcUdcV2} DPDC-UDC)
        (sft:string "TSFS-98c486052a51")
    )
    (let
        (
            (psd:[object{DpdcUdcV2.DPDC|AllowedNonceForSetPosition}]
                [(ref-DPDC-UDC::UDC_DPDC|AllowedNonceForSetPosition [1])
                 (ref-DPDC-UDC::UDC_DPDC|AllowedNonceForSetPosition [2])])
            (csd:[object{DpdcUdcV2.DPDC|AllowedClassForSetPosition}]
                [(ref-DPDC-UDC::UDC_DPDC|AllowedClassForSetPosition 1)])
        )
        (map print
            [
                ;;happy path: two nonces matching the two allowed positions, in order.
                (expect "<<DPDC-S-G1>> a matching nonce list satisfies the primordial definition"
                    true (!= "" (format "{}" [(ref-DPDC-S::UEV_Primordial [1 2] psd)])))
                ;;FINDING, asserted: the message names UEV_Composite from inside UEV_Primordial.
                (expect-failure "<<DPDC-S-G1>> FINDING: UEV_Primordial's length guard names its TWIN, <UEV_Composite>"
                    "Incompatible Input for <UEV_Composite> Validation"
                    (ref-DPDC-S::UEV_Primordial [1] psd))
                ;;the membership guard proper: right length, wrong nonce for that position. The
                ;;message carries both the offending nonce and the position, which is what makes
                ;;it worth having over a bare boolean.
                (expect-failure "<<DPDC-S-G1>> a nonce not allowed at its position is refused, naming both"
                    "Nonce 3 not compatible with Set-Element"
                    (ref-DPDC-S::UEV_Primordial [1 3] psd))
                ;;the composite twin, where the same message IS correct.
                (expect-failure "<<DPDC-S-G1>> UEV_Composite's identical message, where it names the right function"
                    "Incompatible Input for <UEV_Composite> Validation"
                    (ref-DPDC-S::UEV_Composite sft true [1 2] csd))
            ]
        )
        ""
    )
)
(commit-tx)
(print "=== END modules/DPDC-S.repl guard blocks ===")

;;|| NEXT >
;;
(begin-tx "DPDC-S-G2 — set composition, renaming, and the inactive-class gate")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(namespace "ouronet-ns")
(print "--- [DPDC-S-G2 · 01 · DPDC-S|C>MAKE and C>RENAME, via the Talos client path] ---")
;;P3.3. These are @event defcaps, so test-capability cannot acquire them — they are reached through
;;the real TS02-C1 client functions.
;;
;;A NOTE ON WHICH WRAPPER: the SFT path is DPSF|C_Make in TS02-C1 and it passes <how-many-sets>
;;through; the NFT twin DPNF|C_Make lives in TS02-C2 and DERIVES it. My first attempt used the DPNF
;;names against TS02-C2 and got unbound-variable errors for all three.
;;
;;THE INACTIVE-CLASS CASE NEEDS A TOGGLE, NOT A BAD ARGUMENT. UR_IzSetActive HARD-READS
;;DPSF|SetsTable, so a set-class that does not exist aborts with "No value found in table ... for
;;key: TSFS-...|99" before the guard is consulted — the same eager-read shape catalogued elsewhere.
;;The only way to see the written message is an EXISTING class that is switched off, so SC1 is
;;toggled off, driven, and toggled back on with the restoration asserted.
;;==== DPDC-S-G2 — set composition, renaming, and the inactive-class gate · 01 · env-sigs (caps) ==== 
(print "--- [DPDC-S-G2 — set composition, renaming, and the inactive-class gate · 01 · env-sigs (caps)] ---")
(env-sigs [{ "key": "PK_AncientHodler", "caps": [] }])
;;==== DPDC-S-G2 — set composition, renaming, and the inactive-class gate · 02 · let / invocation ==== 
(print "--- [DPDC-S-G2 — set composition, renaming, and the inactive-class gate · 02 · let / invocation] ---")
(let
    (
        (ref-DPDC-S:module{DpdcSetsV2} DPDC-S)
        (ref-TS02-C1:module{TalosStageTwo_ClientOneV2} TS02-C1)
        (sft:string "TSFS-98c486052a51")
    )
    (map print
        [
            ;;--- how-many-sets must be positive. SC1 is ACTIVE here, so the activity guard one line
            ;;    above provably cannot be what answers: zero sets is the only thing wrong.
            (expect "<<DPDC-S-G2>> SC1 is active, so the activity guard cannot be what answers below"
                true (ref-DPDC-S::UR_IzSetActive sft true 1))
            (expect-failure "<<DPDC-S-G2>> composing ZERO sets is refused"
                "How-Many-Sets must be a positive, non-zero integer"
                (ref-TS02-C1::DPSF|C_Make KST.ANHD KST.ANHD sft [1] 1 0))
            ;;--- renaming a set-class to the name it already has. It emits an event and bills IGNIS,
            ;;    so a silent no-op would leave an audit record of a rename that never happened.
            (expect-failure "<<DPDC-S-G2>> renaming a set-class to its CURRENT name is refused"
                "must be different from the current name"
                (ref-TS02-C1::DPSF|C_RenameSet KST.ANHD (DPDC.UR_OwnerKonto sft true) sft 1 (ref-DPDC-S::UR_SetName sft true 1)))
        ]
    )
    ""
)
(env-sigs [])
(commit-tx)

;;|| NEXT >
;;
(begin-tx "DPDC-S-G3 — composition into a DEACTIVATED set-class")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(namespace "ouronet-ns")
(print "--- [DPDC-S-G3 · 01 · MAKE against an inactive set-class] ---")
;;Toggle SC1 off, drive, restore. A deactivated set-class is the issuer saying "stop minting these":
;;composition must stop while BREAK keeps working, so holders are never trapped in a retired set.
;;==== DPDC-S-G3 — composition into a DEACTIVATED set-class · 01 · env-sigs (caps) ==== ===========
(print "--- [DPDC-S-G3 — composition into a DEACTIVATED set-class · 01 · env-sigs (caps)] ---")
(env-sigs [{ "key": "PK_AncientHodler", "caps": [] }])
;;==== DPDC-S-G3 — composition into a DEACTIVATED set-class · 02 · let / invocation ==== ==========
(print "--- [DPDC-S-G3 — composition into a DEACTIVATED set-class · 02 · let / invocation] ---")
(let
    (
        (ref-DPDC-S:module{DpdcSetsV2} DPDC-S)
        (ref-TS02-C1:module{TalosStageTwo_ClientOneV2} TS02-C1)
        (sft:string "TSFS-98c486052a51")
    )
    (ref-TS02-C1::DPSF|C_ToggleSet KST.ANHD (DPDC.UR_OwnerKonto sft true) sft 1 false)
    (map print
        [
            (expect "<<DPDC-S-G3>> SC1 is now inactive" false (ref-DPDC-S::UR_IzSetActive sft true 1))
            ;;how-many-sets is 1 (valid), so the positivity guard below it cannot be what answers.
            (expect-failure "<<DPDC-S-G3>> composing into an INACTIVE set-class is refused"
                "is not active for Set Composition"
                (ref-TS02-C1::DPSF|C_Make KST.ANHD KST.ANHD sft [1] 1 1))
        ]
    )
    (ref-TS02-C1::DPSF|C_ToggleSet KST.ANHD (DPDC.UR_OwnerKonto sft true) sft 1 true)
    (map print
        [
            (expect "<<DPDC-S-G3>> ...and SC1 is active again, as the rest of the suite expects"
                true (ref-DPDC-S::UR_IzSetActive sft true 1))
        ]
    )
    ""
)
(env-sigs [])
(commit-tx)

;;|| NEXT >
;;
(begin-tx "DPDC-F-G1 — the fragment repurpose, merge and enable-fragmentation rules")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(namespace "ouronet-ns")
(print "--- [DPDC-F-G1 · 01 · DPDC-F repurpose / merge / enable-fragmentation] ---")
;;P3.3. Four @event defcap guards, all reached through the real TS02-C1 client path (the SFT
;;fragment wrappers live there, not in TS02-C2 — see the note in DPDC-S-G2).
;;
;;FRAGMENTS are sub-units of a class-0 nonce, addressed by NEGATIVE nonce numbers: nonce 1 is the
;;whole item, nonce -1 is its fragment lane. That convention is what the two merge guards police.
;;
;;The nonce classes used below are read out of the live collection rather than assumed: n1..n10 are
;;class 0, n11 is class 1 (and already fragmented), n12 class 2, n13 class 3. n12 is therefore a
;;genuine non-zero class, which is what the fragmentation guard needs.
;;==== DPDC-F-G1 — the fragment repurpose, merge and enable-fragmentation rules · 01 · env-sigs (caps) ==== 
(print "--- [DPDC-F-G1 — the fragment repurpose, merge and enable-fragmentation rules · 01 · env-sigs (caps)] ---")
(env-sigs [{ "key": "PK_AncientHodler", "caps": [] }])
;;==== DPDC-F-G1 — the fragment repurpose, merge and enable-fragmentation rules · 02 · let / invocation ==== 
(print "--- [DPDC-F-G1 — the fragment repurpose, merge and enable-fragmentation rules · 02 · let / invocation] ---")
(let
    (
        (ref-DPDC:module{DpdcV2} DPDC)
        (ref-UDC:module{DpdcUdcV2} DPDC-UDC)
        (ref-TS02-C1:module{TalosStageTwo_ClientOneV2} TS02-C1)
        (sft:string "TSFS-98c486052a51")
    )
    (map print
        [
            ;;preconditions for the two cases that depend on nonce class.
            (expect "<<DPDC-F-G1>> nonce 12 is a NON-zero set class, nonce 1 is class 0"
                [2 0] [(ref-DPDC::UR_NonceClass sft true 12) (ref-DPDC::UR_NonceClass sft true 1)])
            ;;--- REPURPOSE: audit #47L. An empty repurpose used to fall through to an
            ;;    out-of-bounds error several call-hops downstream; it is now rejected here with a
            ;;    message that says what is wrong.
            (expect-failure "<<DPDC-F-G1>> an EMPTY fragment repurpose is refused"
                "Invalid Repurpose data"
                (ref-TS02-C1::DPSF|C_RepurposeFragments KST.ANHD KST.ANHD KST.ANHD sft KST.EMMA [] []))
            ;;--- MERGE, guard 1: merging is the inverse of fragmenting, so it only makes sense on a
            ;;    fragment lane — a NEGATIVE nonce. The amount passed is a clean multiple of 1000,
            ;;    so the guard below it provably cannot be what answers.
            (expect-failure "<<DPDC-F-G1>> merging a POSITIVE (whole-item) nonce is refused"
                "Only negative nonces can be used for merging"
                (ref-TS02-C1::DPSF|C_MergeFragments KST.ANHD KST.ANHD sft 1 1000))
            ;;--- MERGE, guard 2: fragments exist in thousandths, so only whole multiples of 1000 can
            ;;    reassemble into items. The nonce is negative here, so guard 1 provably passes and
            ;;    only the amount is wrong. 1500 would merge one item plus half of another.
            (expect-failure "<<DPDC-F-G1>> ...and merging an amount that is not a multiple of 1000 is refused"
                "Only multiple of 1000 can be used for Merging"
                (ref-TS02-C1::DPSF|C_MergeFragments KST.ANHD KST.ANHD sft -1 1500))
            ;;--- ENABLE-FRAGMENTATION: only a class-0 (whole, un-setted) nonce may be fragmented. A
            ;;    set nonce already represents a composition of others; fragmenting it would create
            ;;    two independent claims on the same underlying items.
            (expect-failure "<<DPDC-F-G1>> enabling fragmentation on a SET (class 2) nonce is refused"
                "Only Class 0 Nonces can be fragmented"
                (ref-TS02-C1::DPSF|C_EnableNonceFragmentation KST.ANHD (DPDC.UR_OwnerKonto sft true) sft 12 (ref-UDC::UDC_ZeroNonceData)))
            ;;--- THE BLOCKER FOR `06_DPDC-MNG.pact:280` (DPDC-MNG|C>IZ-CLASS-ZERO), asserted rather
            ;;    than described, because it is a FIXTURE limit and fixtures change.
            ;;
            ;;    That guard sits on the REMOVAL family (burn, wipe compose it): nonces leaving
            ;;    circulation must ALL be class 0, since a set nonce stands for a composition of
            ;;    others and removing it would strand them. Reaching it needs a non-class-0 nonce
            ;;    that an account actually HOLDS.
            ;;
            ;;    This collection has none. Every non-zero class here is defined but unissued, so the
            ;;    debit-amount check answers first with "Amount 1 is invalid for Debiting Nonce 12 …"
            ;;    -- measured, not assumed. The class guard is fine; there is simply nothing to burn.
            ;;
            ;;    ROUTE FOR THE NEXT PASS: `C_MakeSemiFungibleSet` credits a set nonce, which would
            ;;    give a held class-2 nonce and reach the guard through the ordinary burn client.
            ;;    (Note the related finding recorded at 03_DPDC-C:279 — the SFT-set DEFINITION path
            ;;    does not route through C_CreateNewNonce, so the two are different operations.)
            (expect "<<DPDC-F-G1>> every non-class-0 nonce here is DEFINED but unissued -- nothing to burn"
                [0 0 0]
                [(ref-DPDC::UR_NonceSupply sft true 11)
                 (ref-DPDC::UR_NonceSupply sft true 12)
                 (ref-DPDC::UR_NonceSupply sft true 13)])
        ]
    )
    ""
)
(env-sigs [])
(commit-tx)
;;PINNED ELSEWHERE (note corrected 2026-09-13) — the second ENABLE-FRAGMENTATION guard ("Nonce must
;;not be fragmented in order to enable fragmentation for it !") needs a nonce that is BOTH class 0
;;AND already fragmented. THIS COLLECTION has neither combination: n1..n10 are class-0 and
;;unfragmented, and the one fragmented nonce (n11) is class 1, so the class guard one line above
;;answers first.
;;
;;The note that stood here concluded from that the guard was unreachable. It was a statement about
;;TSFS, not about the rule. `Stage_02/[6.1.2]_DPDC-FRAGMENTS.repl` TX-FRAG-002 creates TFRG nonce 1
;;as a plain class-0 nonce and then enables fragmentation on it, and there is no disable operation,
;;so that state persists — which is exactly the combination required. Pinned by
;;`modules/DPDC-FRAGMENTS.repl <<DPDC-F-G2>>`.
;;
;;WORTH GENERALISING: "no fixture in THIS harness" is not "unreachable". Check the other harnesses
;;before recording a guard as impossible.

;;|| NEXT >
;;
(begin-tx "DPDC-S-G4 -- UCv_TakePureWipe's size bound is STRICT")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
;;==== DPDC-S-G4 -- UCv_TakePureWipe's size bound is STRICT · 01 · namespace ==== =================
(print "--- [DPDC-S-G4 -- UCv_TakePureWipe's size bound is STRICT · 01 · namespace] ---")
(namespace "ouronet-ns")
(print "--- [DPDC-S-G4 . 01 . taking a slice of the removable-nonces object] ---")
;;An unpinned guard from `python3 REPL/tools/_cheapseam.py`. Pure compute over a constructed object --
;;no chain state, so it is one of only three candidates on that list needing no fixture.
;;
;;The bound is `(< size l)`, STRICT: taking the whole set is refused, not just taking more than
;;exists. That matches the @doc ("returns a SMALLER object") and is the kind of off-by-one a reader
;;would guess wrong in either direction, so both sides are asserted.
;;==== DPDC-S-G4 -- UCv_TakePureWipe's size bound is STRICT · 02 · let / invocation ==== ==========
(print "--- [DPDC-S-G4 -- UCv_TakePureWipe's size bound is STRICT · 02 · let / invocation] ---")
(let ((obj:object{DpdcManagementV2.RemovableNonces} (DPDC-MNG.UDC_RemovableNonces [1 2] [10 20])))
    (map print
        [
            ;;a genuinely smaller slice works, and carries BOTH parallel lists down together --
            ;;a truncation that dropped one list out of step would still "work" without this
            (expect "<<DPDC-S-G4>> a smaller size truncates nonces and amounts in step"
                {"r-nonces": [1], "r-amounts": [10]}
                (DPDC-MNG.UCv_TakePureWipe obj 1))
            ;;taking the FULL set is refused -- the bound is strict, not "larger than"
            (expect-failure "<<DPDC-S-G4>> taking the whole set is refused: the bound is strict"
                "Size of 2 is larger than the Data set of the Removable Nonces Object"
                (DPDC-MNG.UCv_TakePureWipe obj 2))
        ]
    )
)
(commit-tx)

;;|| NEXT >
;;|| DPDC-S-G5 — fragmentation cannot be enabled twice on the same SET CLASS.
;;
(begin-tx "DPDC-S-G5 - DPDC-S|C>ENABLE-FRAGMENTATION is not idempotent")
(env-gasmodel "table")(env-gaslimit 100000000)(env-gas 0)
(namespace "ouronet-ns")
;;==== DPDC-S-G5 - DPDC-S|C>ENABLE-FRAGMENTATION is not idempotent · 01 · env-sigs (caps) ==== ====
(print "--- [DPDC-S-G5 - DPDC-S|C>ENABLE-FRAGMENTATION is not idempotent · 01 · env-sigs (caps)] ---")
(env-sigs [{ "key": "PK_AncientHodler", "caps": [] }])
(print "--- [DPDC-S-G5 · 01 · a re-entry check on set-class fragmentation] ---")
;;`08_DPDC-S.pact:379`. Enabling fragmentation writes split-data onto the set class; doing it twice
;;would overwrite a live fragmentation scheme under holders who already own fragments of it. The
;;guard is a RE-ENTRY check -- it reads persisted state, not an argument -- so the way to reach it is
;;simply to call the entrypoint a second time.
;;
;;NO NEW FIXTURE: `[6.1.3]_DPDC-S.repl` TX-SET-007 already enabled fragmentation on TSFS set-class 1
;;and asserts `UEV_IzSetClassFragmented ... 1` is true at the end of that block. This file loads it,
;;so the terminal state is exactly the precondition.
;;
;;IT IS THE FIRST STATEMENT IN THE CAP -- ahead of UEV_SetClass, the active-state gate, CAP_Owner and
;;the NonceData validator -- so nothing owner- or shape-related can answer first, and the assertion
;;below is unambiguous about which rule fired.
;;==== DPDC-S-G5 - DPDC-S|C>ENABLE-FRAGMENTATION is not idempotent · 02 · let / invocation ==== ===
(print "--- [DPDC-S-G5 - DPDC-S|C>ENABLE-FRAGMENTATION is not idempotent · 02 · let / invocation] ---")
(let
    (
        (ref-DPDC-S:module{DpdcSetsV2} DPDC-S)
        (ref-UDC:module{DpdcUdcV2} DPDC-UDC)
        (ref-TS02-C1:module{TalosStageTwo_ClientOneV2} TS02-C1)
        (sft:string "TSFS-98c486052a51")
    )
    (map print
        [
            ;;the premise, read live
            (expect "<<DPDC-S-G5>> TSFS set-class 1 is already fragmented"
                true (ref-DPDC-S::UEV_IzSetClassFragmented sft true 1))
            (expect-failure "<<DPDC-S-G5>> so enabling fragmentation on it AGAIN is refused"
                "Set Class must not be fragmented in order to enable fragmentation for it !"
                (ref-TS02-C1::DPSF|C_EnableSetClassFragmentation KST.ANHD (DPDC.UR_OwnerKonto sft true) sft 1
                    (ref-UDC::UDC_ZeroNonceData)))
            ;;CONTRAST -- an UNfragmented set class gets past this rule and is answered by a later
            ;;one, which is what shows the refusal above is the re-entry check and not a blanket
            ;;refusal of the entrypoint. (Set class 2 exists on this collection and is not fragmented.)
            (expect "<<DPDC-S-G5>> ...while set-class 2 is not fragmented, so this rule does not apply to it"
                false (ref-DPDC-S::UEV_IzSetClassFragmented sft true 2))
        ]
    )
    ""
)
(env-sigs [])
(commit-tx)

;;|| NEXT >
;;|| DPDC-S-G6 — the class-zero filter that fronts every burn/wipe of a collectable nonce.
;;
(begin-tx "DPDC-S-G6 - DPDC-MNG|C>IZ-CLASS-ZERO refuses a nonce that carries a set class")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(namespace "ouronet-ns")
;;==== DPDC-S-G6 - DPDC-MNG|C>IZ-CLASS-ZERO refuses a nonce that carries a set class · 01 · env-sigs (caps) ==== 
(print "--- [DPDC-S-G6 - DPDC-MNG|C>IZ-CLASS-ZERO refuses a nonce that carries a set class · 01 · env-sigs (caps)] ---")
(env-sigs [{ "key": "PK_AncientHodler", "caps": [] }])
(print "--- [DPDC-S-G6 · 01 · offering a class-1 nonce to a class-zero-only path] ---")
;;`06_DPDC-MNG.pact:280`. The cap does not test the nonces one at a time; it runs them through
;;`URC_FilterClassZeroNonces` and demands the filtered list come back IDENTICAL to what went in:
;;`(enforce (= nonces class-zero-nonces) "Invalid Class Zero Nonces")`. So a single non-class-0
;;entry anywhere in the list — silently dropped by the filter — changes the length and the equality
;;fails. That is the shape the test has to exercise, and a one-element list is the cleanest form of it.
;;
;;THIS IS THE GATE THAT MAKES DPDC-MNG's BURN/WIPE PATHS SAFE TO REASON ABOUT. Everything composed
;;behind it — including the fragment-collateral rule pinned in `modules/DPDC-FRAGMENTS.repl`
;;<<DPDC-F-G3>> — is written assuming class 0, and that assumption is only true because of this
;;enforce. Worth a pin of its own rather than leaving it to a downstream test's preconditions.
;;
;;TSFS is the collection that can drive it: this suite leaves nonce 11 carrying set class 1 while
;;n1..n10 stay class 0, so the SAME collection supplies both the rejected input and the control.
;;==== DPDC-S-G6 - DPDC-MNG|C>IZ-CLASS-ZERO refuses a nonce that carries a set class · 02 · let / invocation ==== 
(print "--- [DPDC-S-G6 - DPDC-MNG|C>IZ-CLASS-ZERO refuses a nonce that carries a set class · 02 · let / invocation] ---")
(let
    (
        (ref-DPDC:module{DpdcV2} DPDC)
        (sft:string "TSFS-98c486052a51")
    )
    (map print
        [
            ;;the premise, read live: one nonce of each kind on the same collection
            (expect "<<DPDC-S-G6>> TSFS nonce 11 carries a set class; nonce 1 does not"
                [1 0]
                [(ref-DPDC::UR_NonceClass sft true 11)
                 (ref-DPDC::UR_NonceClass sft true 1)])
            (expect-failure "<<DPDC-S-G6>> a class-1 nonce is refused by the class-zero-only path"
                "Invalid Class Zero Nonces"
                (test-capability (DPDC-MNG.DPDC-MNG|C>IZ-CLASS-ZERO sft true [11])))
            ;;...and a MIXED list is refused too, which is the case the filter idiom actually exists
            ;;for: a caller cannot smuggle a classed nonce through by burying it among valid ones.
            (expect-failure "<<DPDC-S-G6>> ...and so is a list that merely CONTAINS one"
                "Invalid Class Zero Nonces"
                (test-capability (DPDC-MNG.DPDC-MNG|C>IZ-CLASS-ZERO sft true [1 11 2])))
            ;;CONTROL: the all-class-0 list passes the filter unchanged and the cap grants. Without
            ;;this the two refusals above would be equally consistent with the cap refusing everything.
            (expect "<<DPDC-S-G6>> ...while an all-class-zero list is admitted"
                "granted"
                (let ((probe (test-capability (DPDC-MNG.DPDC-MNG|C>IZ-CLASS-ZERO sft true [1 2]))))
                    "granted"))
        ]
    )
    ""
)
(env-sigs [])
(commit-tx)

