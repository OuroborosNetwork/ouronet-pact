(begin-tx "CONF-06g — IGNIS|C>TRANSFER: the zero-amount floor")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(namespace "ouronet-ns")
(print "--- [CONF-06g · 01 · gas transfer floor] ---")
;;Not governance, but the same technique and the same module band. A zero or negative GAS
;;transfer is refused before any account is read -- so it is reachable with dummy accounts, and
;;the guard is what stops a caller from emitting a transfer event that moves nothing.
(env-sigs [{ "key": "PK_Emma", "caps": [] }])
(map print
    [
        (expect-failure "<<CONF-06g>> a ZERO-amount GAS transfer is refused"
            "Cannot debit|credit 0.0 or negative GAS amounts"
            (test-capability (IGNIS.IGNIS|C>TRANSFER "a" "b" 0.0)))
    ]
)
(commit-tx)

;;|| NEXT >
;;
(begin-tx "CONF-06h — ...and the negative case, which is the one that would mint gas")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(namespace "ouronet-ns")
(print "--- [CONF-06h · 01 · gas transfer floor, negative] ---")
(env-sigs [{ "key": "PK_Emma", "caps": [] }])
(map print
    [
        (expect-failure "<<CONF-06h>> a NEGATIVE GAS transfer is refused — it would reverse the direction"
            "Cannot debit|credit 0.0 or negative GAS amounts"
            (test-capability (IGNIS.IGNIS|C>TRANSFER "a" "b" -1.0)))
    ]
)
(commit-tx)
(print "")

;;|| NEXT >
