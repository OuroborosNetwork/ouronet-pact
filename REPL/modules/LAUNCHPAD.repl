(print "")
(begin-tx "LPAD-N1 - restock the holder so the CUSTOM redemption entrypoints have something to redeem")
(env-gasmodel "table")(env-gaslimit 100000000)(env-gas 0)
(namespace "ouronet-ns")
;;==== LPAD-N1 · 01 · buy 20 Sparks for the holder ====
(print "--- [LPAD-N1 · 01 · buy] ---")
;;SETUP, not the coverage. `[5.3]` ends on TX-SPK-03, which redeems ANHD's ENTIRE liquid Spark
;;balance -- so at this point the holder owns zero liquid Sparks and every redemption entrypoint
;;is refused by `SPARK|C>X_REEDEM`'s `(> redemption-quantity 0.0)` bound before it reaches any
;;code worth testing. This block re-stocks the holder.
;;
;;The env-sigs shape is TX-SPK-01's, and it is not decoration: DEMIPAD|C_Deposit splits the
;;buyer's native STOA four ways plus an environment leg, and every leg needs its own
;;coin.TRANSFER cap at the exact amount URC_Prices computes.
(let
    (
        (ref-DPAD:module{DemiourgosLaunchpadV2} DEMIPAD)
        (ref-SPARK:module{SparksV2} DEMIPAD-SPARK)
        (spark-id:string "SPARK-98c486052a51")
        (amount:integer 20)
    )
    (let
        (
            (prices-obj:object{DemiourgosLaunchpadV2.DEMIPAD|Prices}
                (ref-DPAD::URC_Prices spark-id (at "pid" (ref-SPARK::URC_SparkAmountCosts amount)) 0))
        )
        (let
            (
                (a1:decimal (at "amount-one" prices-obj))
                (a2:decimal (at "amount-two" prices-obj))
                (a3:decimal (at "amount-three" prices-obj))
                (a4:decimal (at "amount-four" prices-obj))
                (env-amount:decimal (at "enviroment-amount" prices-obj))
                (non-enviroment:decimal
                    (+ (at "coding-amount" prices-obj) (at "remainder-amount" prices-obj)))
            )
            (env-sigs
                [ { "key": "PK_AncientHodler", "caps": [] }
                  { "key": "6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263",
                    "caps":
                      [ (coin.TRANSFER "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263"
                            "c:ZNfuj3iZI83n7MUSKGuoXoSxFg1cyMxCzB3szUHVvrI" non-enviroment)
                        (coin.TRANSFER "c:ZNfuj3iZI83n7MUSKGuoXoSxFg1cyMxCzB3szUHVvrI"
                            "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263" env-amount)
                        (coin.TRANSFER "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263"
                            "c:iQQFWj6gWtpGEzhM_O5ekW1QtnQQy55R8BRPGhj_0FU" a1)
                        (coin.TRANSFER "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263"
                            "k:0cb30c0121ff919266121a99ff9359871818932211df94dae4137c29bc0e8f7e" a2)
                        (coin.TRANSFER "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263"
                            "k:50d6c59b21e5e6e55baecaa75a1007de37576bde12d8230dc82459cc01b9484b" a3)
                        (coin.TRANSFER "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263"
                            "c:XM-pkmuB5XUQlp87ZYSbfKt8qzmHY6O2EHAzMRVBt3k" a4) ] } ])
            (let
                (
                    (ref-DPTF:module{DemiourgosPactTrueFungibleV2} DPTF)
                    (ref-CPAD:module{CitizenLaunchpadTalosV2} TS02-CPAD)
                )
                (let
                    (
                        (buyer0:decimal (ref-DPTF::UR_AccountSupply spark-id KST.ANHD))
                    )
                    (ref-CPAD::SPARK|C_BuySparks KST.ANHD KST.ANHD amount true -1.0)
                    (map print
                        [
                            ;;the precondition the next two blocks rest on: a NON-zero liquid balance
                            (expect "<<LPAD-N1>> the holder's liquid Spark balance was restocked to 20"
                                (+ buyer0 (dec amount)) (ref-DPTF::UR_AccountSupply spark-id KST.ANHD))
                            (expect "<<LPAD-N1>> ...and [5.3] really had left it empty"
                                0.0 buyer0)
                        ]
                    )
                )
            )
        )
    )
    ""
)
(print "")
(print "===^^^===")
(env-sigs [])
(commit-tx)

