(print "")
(begin-tx "LPAD-N2 - SPARK C_CustomRedemFewSparks: the CALLER's STOA price is what pays, not the oracle's")
(env-gasmodel "table")(env-gaslimit 100000000)(env-gas 0)
(namespace "ouronet-ns")
;;==== LPAD-N2 · 01 · redeem a few at a caller-supplied STOA price ====
(print "--- [LPAD-N2 · 01 · custom redeem few] ---")
;;FUNCTION COVERAGE -- `DEMIPAD-SPARK::C_CustomRedemFewSparks` was reached by NO test anywhere.
;;It has no TS02-CPAD wrapper either (the Talos exposes only SPARK|C_RedemAll/FewSparks), so the
;;citizen entrypoint is called directly here, which is the only way it can be called at all.
;;
;;WHAT MAKES IT "CUSTOM", AND THE ONLY THING WORTH ASSERTING. The plain path prices a redemption
;;through `URC_SparkRedemptionCost`, which divides the 1.4 boosted dollar value by the STOA/USD
;;oracle (`U|CT::UR_STOA-PID|Price`, stubbed at 0.1 -> 14.0 wSTOA per Spark). The custom path
;;calls `URC_CustomSparkRedemptionCost` with a pid the CALLER hands in, and divides by that
;;instead. So the one observable difference is the size of the wSTOA leg, and the test has to be
;;a value test against the custom pid -- "it ran" would pass just as well against the oracle.
;;
;;The custom pid is deliberately 0.2, DOUBLE the stub, so the custom rate is 7.0 and the oracle
;;rate is 14.0. Assertion 1 pins that the two really do differ in this fixture: if the stub ever
;;moves to 0.2 the discriminating assertion below would silently become a tautology, and this
;;guard turns that into a red test instead.
;;
;;BOTH parties sign. The cap is scoped to the account being redeemed, but step 1 of
;;XI_CustomRedeemSparks is a wSTOA transfer FROM the payer, and DPTF enforces the sender's
;;ownership -- the payer's signature is not implied by the capability the entrypoint names.
(env-sigs [{ "key": "PK_AncientHodler", "caps": [] } { "key": "PK_Emma", "caps": [] }])
(let
    (
        (ref-DALOS:module{OuronetDalosV2} DALOS)
        (ref-DPTF:module{DemiourgosPactTrueFungibleV2} DPTF)
        (ref-SPARK:module{SparksV2} DEMIPAD-SPARK)
        (spark-id:string "SPARK-98c486052a51")
        (frozen:string "F|SPARK-98c486052a51")
        (pad:string DEMIPAD-SPARK.DEMIPAD|SC_NAME)
        (qty:decimal 5.0)
        (custom-pid:decimal 0.2)
    )
    (let
        (
            (w:string (ref-DALOS::UR_WrappedStoaID))
            (oracle-cost:decimal (ref-SPARK::URC_SparkRedemptionCost))
            (custom-cost:decimal (DEMIPAD-SPARK.URC_CustomSparkRedemptionCost custom-pid))
        )
        (let
            (
                (holder0:decimal (ref-DPTF::UR_AccountSupply spark-id KST.ANHD))
                (frozen0:decimal (ref-DPTF::UR_AccountSupply frozen KST.ANHD))
                (holder-w0:decimal (ref-DPTF::UR_AccountSupply w KST.ANHD))
                (payer-w0:decimal (ref-DPTF::UR_AccountSupply w KST.EMMA))
                (pad0:decimal (ref-DPTF::UR_AccountSupply spark-id pad))
                (supply0:decimal (ref-DPTF::UR_Supply spark-id))
                (ignis0:decimal (ref-DALOS::UR_TF_AccountSupply KST.ANHD false))
            )
            (ref-SPARK::C_CustomRedemFewSparks KST.ANHD KST.EMMA KST.ANHD qty custom-pid)
            (map print
                [
                    (format "<<LPAD-N2>> oracle-rate={} custom-rate={}" [oracle-cost custom-cost])
                    ;;the guard that keeps assertion 2 from degenerating into a tautology
                    (expect "<<LPAD-N2>> the custom rate and the oracle rate really are different here"
                        false (= custom-cost oracle-cost))
                    ;;THE discriminator: the payout follows the pid the caller passed
                    (expect "<<LPAD-N2>> the holder was paid at the CALLER's pid, not the oracle's"
                        (+ holder-w0 (* qty custom-cost)) (ref-DPTF::UR_AccountSupply w KST.ANHD))
                    (expect "<<LPAD-N2>> the PAYER funded exactly that, at the same custom rate"
                        (- payer-w0 (* qty custom-cost)) (ref-DPTF::UR_AccountSupply w KST.EMMA))
                    ;;the Spark leg of the trade is identical to the plain path: liquid out, frozen in
                    (expect "<<LPAD-N2>> the redeemed Sparks left the holder's liquid balance"
                        (- holder0 qty) (ref-DPTF::UR_AccountSupply spark-id KST.ANHD))
                    (expect "<<LPAD-N2>> ...and the same count returned FROZEN"
                        (+ frozen0 qty) (ref-DPTF::UR_AccountSupply frozen KST.ANHD))
                    ;;the pad is a way station -- step 5 re-mints onto it, step 6 freeze-links out
                    (expect "<<LPAD-N2>> the pad's liquid balance nets to NO change"
                        pad0 (ref-DPTF::UR_AccountSupply spark-id pad))
                    (expect "<<LPAD-N2>> INVARIANT: wipe-then-remint conserves Spark supply"
                        supply0 (ref-DPTF::UR_Supply spark-id))
                    ;;Sigma billing: six sovereign Talos ops, each self-collecting IGNIS on the
                    ;;patron. A citizen cannot fold cumulators, so the patron pays six times -- and
                    ;;the measurement that proves it happened is the patron's IGNIS balance falling.
                    (expect "<<LPAD-N2>> the patron was Sigma-billed IGNIS for the six Talos ops"
                        true (> (- ignis0 (ref-DALOS::UR_TF_AccountSupply KST.ANHD false)) 0.0))
                ]
            )
        )
    )
    ""
)
(print "")
(print "===^^^===")
(env-sigs [])
(commit-tx)

;;||>>>>>>>>>>>>>>>>>>>>>>>>>
;;|| NEXT                   >
;;||>>>>>>>>>>>>>>>>>>>>>>>>>
(print "")
(begin-tx "LPAD-N3 - SPARK C_CustomRedemAllSparks: ALL means the whole current balance")
(env-gasmodel "table")(env-gaslimit 100000000)(env-gas 0)
(namespace "ouronet-ns")
;;==== LPAD-N3 · 01 · redeem the remainder at the oracle's own pid ====
(print "--- [LPAD-N3 · 01 · custom redeem all] ---")
;;FUNCTION COVERAGE -- `DEMIPAD-SPARK::C_CustomRedemAllSparks`, also reached by nothing.
;;
;;ALL vs FEW is one line of difference: `C_CustomRedemFewSparks` forwards the caller's quantity,
;;`C_CustomRedemAllSparks` reads `DPTF::UR_AccountSupply` for the account and forwards THAT. So
;;the assertion that distinguishes them is "the liquid balance ends at exactly zero, whatever it
;;was, and the payout scales with that whole balance" -- not "it ran". LPAD-N2 left 15 Sparks, an
;;amount no constant in this block mentions.
;;
;;THE CUSTOM PID IS 0.1 HERE ON PURPOSE, i.e. exactly the oracle stub. That makes this call
;;numerically identical to the plain `C_RedemAllSparks`, which is what licenses the billing
;;assertion at the end: `INFO_RedeemSparks` is written against the ORACLE rate, so it is an exact
;;quote for this call and a wrong one for LPAD-N2's doubled pid. Quoting the charge and then
;;measuring the patron's IGNIS balance across the live call is the same shape as <<LPAD-I1>>.
(env-sigs [{ "key": "PK_AncientHodler", "caps": [] } { "key": "PK_Emma", "caps": [] }])
(let
    (
        (ref-DALOS:module{OuronetDalosV2} DALOS)
        (ref-DPTF:module{DemiourgosPactTrueFungibleV2} DPTF)
        (ref-SPARK:module{SparksV2} DEMIPAD-SPARK)
        (spark-id:string "SPARK-98c486052a51")
        (frozen:string "F|SPARK-98c486052a51")
        (custom-pid:decimal 0.1)
    )
    (let
        (
            (w:string (ref-DALOS::UR_WrappedStoaID))
            (cost:decimal (DEMIPAD-SPARK.URC_CustomSparkRedemptionCost custom-pid))
        )
        (let
            (
                (holder0:decimal (ref-DPTF::UR_AccountSupply spark-id KST.ANHD))
                (frozen0:decimal (ref-DPTF::UR_AccountSupply frozen KST.ANHD))
                (holder-w0:decimal (ref-DPTF::UR_AccountSupply w KST.ANHD))
                (supply0:decimal (ref-DPTF::UR_Supply spark-id))
            )
            (let
                (
                    (predicted:decimal
                        (at "ignis-need" (at "ignis"
                            (ref-SPARK::INFO_RedeemSparks KST.ANHD KST.EMMA KST.ANHD holder0))))
                    (ignis0:decimal (ref-DALOS::UR_TF_AccountSupply KST.ANHD false))
                )
                (map print
                    [
                        (expect "<<LPAD-N3>> precondition: the holder still holds liquid Sparks"
                            true (> holder0 0.0))
                    ]
                )
                (ref-SPARK::C_CustomRedemAllSparks KST.ANHD KST.EMMA KST.ANHD custom-pid)
                (map print
                    [
                        (format "<<LPAD-N3>> redeemed={} predicted-ignis={} real-ignis={}"
                            [holder0 predicted
                             (- ignis0 (ref-DALOS::UR_TF_AccountSupply KST.ANHD false))])
                        ;;ALL, not a fixed quantity
                        (expect "<<LPAD-N3>> RedemAll empties the liquid balance to exactly zero"
                            0.0 (ref-DPTF::UR_AccountSupply spark-id KST.ANHD))
                        (expect "<<LPAD-N3>> every one of them came back frozen"
                            (+ frozen0 holder0) (ref-DPTF::UR_AccountSupply frozen KST.ANHD))
                        (expect "<<LPAD-N3>> paid for the WHOLE remaining balance, not a fixed amount"
                            (+ holder-w0 (* holder0 cost)) (ref-DPTF::UR_AccountSupply w KST.ANHD))
                        (expect "<<LPAD-N3>> INVARIANT: Spark supply is still conserved"
                            supply0 (ref-DPTF::UR_Supply spark-id))
                        ;;billing, measured rather than assumed
                        (expect "<<LPAD-N3>> INFO_RedeemSparks' quote equals what the redeem charged"
                            (- ignis0 (ref-DALOS::UR_TF_AccountSupply KST.ANHD false)) predicted)
                        (expect "<<LPAD-N3>> ...and it is a real, non-zero charge"
                            true (> predicted 0.0))
                    ]
                )
            )
        )
    )
    ""
)
(print "")
(print "===^^^===")
(env-sigs [])
(commit-tx)

