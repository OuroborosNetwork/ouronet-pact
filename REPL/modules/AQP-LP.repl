;;
;; REPL/modules/AQP-LP.repl — canonical integration layout (OuronetInformational/ARCHITECTURE/REPL_AND_TESTS.md)
;;   Inter-tx:   ;;|| NEXT >  (same three lines as REPL/Stage_01/[2.2]_Core.repl)
;;   Intra-tx:   ;;==== <TX label> · mm · <slug> ====  + next-line (print "--- [<label> · mm · …] ---"); mm = 01.. within each (begin-tx …) (see OuronetInformational/ARCHITECTURE/REPL_AND_TESTS.md).
;;   format "{}": Talos / module echoes and (env-gas) — document additional prefixes in this file's (print …) lines as needed.
;;
(print "")
(print "================================================================")
(print "FILE  REPL/modules/AQP-LP.repl")
(print "================================================================")
(print "Legend (terminal observability): see ;; preface; echoes use <(…)> where helpful.")
(print "Source: ;;|| NEXT > between txs; ;;==== … · mm · … ==== + banner before each begin-tx.")
(print "")
;; REPL/modules/AQP-LP.repl — AQP on a chain that ALSO has SWP liquidity pools.
;;
;; WHY THIS FILE EXISTS. Several AQP-SCORE / AQP guards read an SWP LP pair AND an AQP score in the same
;; expression, and no harness carried both: `modules/SWP.repl` builds the pools but stops at Stage 01,
;; `modules/AQP.repl` builds the scores but has no pools. `UEV_LpStakeScoreContext` was recorded as
;; not-pinnable for exactly that reason — its `let` hard-reads `SWP|LP` before any of its conjuncts, so on
;; a pool-less chain every argument dies in the read rather than reaching the guard.
;;
;; The load order is the one `modules/STAGE-Z.repl` already proves: Stage 00 -> Stage 01 -> the CHEAP
;; DPTF/SWP issuance-only path -> Stage 02, with the AQP umbrella last. The issuance-only variant is
;; deliberate: it is measured at ~8s against the full `[6.3]_SWP` suite, and all that is needed here is
;; that the LP rows EXIST.
;;
;; Run: cd REPL && pact modules/AQP-LP.repl
(load "../deploy-stage00.repl")
(load "../deploy-stage01.repl")
(load "../Stage_01/[6.2+3]_DPTF-SWP_Issuance-Only.repl")
(load "../deploy-stage02.repl")
(load "../Stage_02/[6.2]_AQP.repl")

;;|| NEXT >
;;
(begin-tx "AQPLP-G1 — the LP-stake score context, on a chain that has both halves")
(env-gasmodel "table")(env-gaslimit 150000000)(env-gas 0)
(namespace "ouronet-ns")
;;==== AQPLP-G1 — the LP-stake score context, on a chain that has both halves · 01 · env-sigs (caps) ==== 
(print "--- [AQPLP-G1 — the LP-stake score context, on a chain that has both halves · 01 · env-sigs (caps)] ---")
(env-sigs [{ "key": "PK_AncientHodler", "caps": [] }])
;;The LP id is DISCOVERED from the chain, not hardcoded. The issuance-only path builds its own pairs
;;(S|AG-…|AL-…, S|AL-…|AU-… and so on), NOT the S|DLK-…|OURO-…|DWK-… that the full [6.3]_SWP suite makes --
;;which the first version of this file assumed and died on. Reading the first LP row is both shorter and
;;immune to the pair set changing; the assertion below proves a row was actually found.
(env-module-admin SWP)
(print "--- [AQPLP-G1 · 01 · both fixtures are present] ---")
;;The whole point of this file, asserted before anything depends on it: an SWP LP pair and an AQP score on
;;one chain. If either half ever stops loading, this says so directly instead of the guard below failing
;;for an unrelated reason.
;;==== AQPLP-G1 — the LP-stake score context, on a chain that has both halves · 02 · let / invocation ==== 
(print "--- [AQPLP-G1 — the LP-stake score context, on a chain that has both halves · 02 · let / invocation] ---")
(let
    (
        (ref-SWP:module{SwapperV4} SWP)
        (ref-SCR:module{AcquisitionScoresV2} AQP-SCORE)
        (lp:string (at 0 (keys SWP.SWP|LP)))
        (sc:string "DhbVacateScore-98c486052a51")
        (pool:string "DhbVacatePool-98c486052a51")
    )
    (map print
        [
            (expect "<<AQPLP-G1>> an LP row exists and resolves to a real swap pair"
                true (and (!= "" lp) (!= "" (ref-SWP::UR_GetLpSwpair lp))))
            (expect "<<AQPLP-G1>> ...and the AQP score exists, linked to its pool"
                pool (ref-SCR::UR_SCR|ScoreAqpoolLink sc))
        ]
    )
    (print "--- [AQPLP-G1 · 02 · the three conjuncts, named individually] ---")
    ;;`UEV_LpStakeScoreContext` folds THREE conditions under one message, so the message alone cannot say
    ;;which failed. Each is therefore asserted on its own first, and the refusal afterwards. Two of the
    ;;three are false for this score, which is exactly why the individual assertions matter: without them
    ;;the refusal would be evidence that *something* was wrong, not that this guard checks what it says.
    (let
        (
            (native-lp:string (ref-SCR::URC_StakeLpTokenToNativeLpDptf lp))
        )
        (let
            (
                (swpair:string (ref-SWP::UR_GetLpSwpair native-lp))
            )
            (map print
                [
                    (expect "<<AQPLP-G1>> conjunct 1 HOLDS: the score's pool link matches the pool-id"
                        true (= (ref-SCR::UR_SCR|ScoreAqpoolLink sc) pool))
                    (expect "<<AQPLP-G1>> conjunct 2 FAILS: the score is not class 0"
                        false (= (ref-SCR::UR_SCR|ScoreClass sc) 0))
                    (expect "<<AQPLP-G1>> conjunct 3 FAILS: its lp-denominator is the BAR sentinel"
                        false (contains (ref-SCR::UR_SCR|ScoreLpDenominator sc)
                                        (ref-SWP::UR_PoolTokens swpair)))
                    ;;...and the guard refuses, having actually reached its own enforce -- which is the
                    ;;thing this file was built to make possible.
                    (expect-failure "<<AQPLP-G1>> so the LP-stake context is refused"
                        "LP stake score context: pool-id, score-class, or LP pair vs lp-denominator mismatch"
                        (ref-SCR::UEV_LpStakeScoreContext KST.ANHD pool sc lp))
                    ;;...and with a pool-id that does NOT match the score's link, conjunct 1 fails too --
                    ;;same message, different cause. Driven so the fold is known to read the pool-id at all.
                    (expect-failure "<<AQPLP-G1>> ...and also when the pool-id does not match the score's link"
                        "LP stake score context"
                        (ref-SCR::UEV_LpStakeScoreContext KST.ANHD "DhnVacatePool-98c486052a51" sc lp))
                ]
            )
        )
    )
    ""
)
(env-sigs [])
(commit-tx)

;;|| NEXT >
;;
(begin-tx "AQPLP-G2 — a CLASS-0 liquidity score, and the guards that needed one")
(env-gasmodel "table")(env-gaslimit 150000000)(env-gas 0)
(namespace "ouronet-ns")
;;Issuing a score is STOA-priced and settles as coin transfers, so the managed caps must be in scope --
;;otherwise the call dies in `coin.TRANSFER` before the score exists. The fee is split across receivers,
;;so all four legs are granted with headroom rather than exact amounts (pinning the split here would make
;;this fixture fail on every price change).
;;==== AQPLP-G2 — a CLASS-0 liquidity score, and the guards that needed one · 01 · env-sigs (caps) ==== 
(print "--- [AQPLP-G2 — a CLASS-0 liquidity score, and the guards that needed one · 01 · env-sigs (caps)] ---")
(env-sigs
    [ { "key": "PK_AncientHodler", "caps": [] }
      { "key": "6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263"
      , "caps":
        [ (coin.TRANSFER "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263"
                         "k:0cb30c0121ff919266121a99ff9359871818932211df94dae4137c29bc0e8f7e" 1000.0)
          (coin.TRANSFER "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263"
                         "k:50d6c59b21e5e6e55baecaa75a1007de37576bde12d8230dc82459cc01b9484b" 1000.0)
          (coin.TRANSFER "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263"
                         "c:XM-pkmuB5XUQlp87ZYSbfKt8qzmHY6O2EHAzMRVBt3k" 1000.0)
          (coin.TRANSFER "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263"
                         "c:iQQFWj6gWtpGEzhM_O5ekW1QtnQQy55R8BRPGhj_0FU" 1000.0) ] } ])
(print "--- [AQPLP-G2 · 01 · issuing the score the suite never had] ---")
;;`modules/AQP.repl` carries 37 scores and **none of them is class 0** (measured). Class 0 is the LP/farm
;;class, and several guards only have anything to say about it -- so they sat on the worklist reading as
;;"needs a fixture" with nobody naming the fixture.
;;
;;It is one client call: `AQP-SCR|C_IssueLiquidityScore` creates a class-0 score with a chosen
;;lp-denominator. Done here rather than in `modules/AQP.repl` because the interesting guards compare that
;;denominator against an SWP PAIR, and this is the only chain carrying both.
;;==== AQPLP-G2 — a CLASS-0 liquidity score, and the guards that needed one · 02 · let / invocation ==== 
(print "--- [AQPLP-G2 — a CLASS-0 liquidity score, and the guards that needed one · 02 · let / invocation] ---")
(let
    (
        (ref-SCR:module{AcquisitionScoresV2} AQP-SCORE)
        (ref-SWP:module{SwapperV4} SWP)
        (ref-TS02-C3:module{TalosStageTwo_ClientThreeV2} TS02-C3)
        (ref-U|DALOS:module{UtilityDalosV2} U|DALOS)
    )
    (env-module-admin SWP)
    (let*
        (
            (lp:string (at 0 (keys SWP.SWP|LP)))
            (swpair:string (ref-SWP::UR_GetLpSwpair lp))
            (pool-tokens:[string] (ref-SWP::UR_PoolTokens swpair))
            ;;a denominator that is NOT one of the pair's tokens -- OURO is not in the issuance-only
            ;;pairs, which are built from AG/AL/AU/BI/CO. That mismatch is what the target guards test.
            (outsider:string (DALOS.UR_OuroborosID))
        )
        (map print
            [
                (expect "<<AQPLP-G2>> the pair has tokens, and OURO is not one of them"
                    [true false]
                    [(> (length pool-tokens) 0) (contains outsider pool-tokens)])
            ]
        )
        ;;precision 6, mx-frozen/mx-sleeping 2.0 -- the values AQP-BOOT's Step 6 uses. The issuer bounds
        ;;precision to [3,24] and requires BOTH multipliers to be strictly positive; 0.0 was rejected on
        ;;the first attempt with "Invalid precision, score-class, nft-score-model, or a multiplier below 1.0
        ;;or nft-score-model" -- one message over eight conjuncts, so the only way to know which was
        ;;wrong was to read them.
        (ref-TS02-C3::AQP-SCR|C_IssueLiquidityScore
            KST.ANHD KST.ANHD "LpProbeScore" 6 outsider 2.998 1.999)
        (let
            (
                (sc:string (ref-U|DALOS::UDC_Makeid "LpProbeScore"))
            )
            (map print
                [
                    ;;the fixture, asserted: a genuine class-0 score with an unlinked pool and the
                    ;;denominator just chosen
                    (expect "<<AQPLP-G2>> the new score is CLASS 0 -- the first on any chain in this suite"
                        0 (ref-SCR::UR_SCR|ScoreClass sc))
                    (expect "<<AQPLP-G2>> ...with no pool link yet, and OURO as its lp-denominator"
                        [(U|CT.CT_BAR) outsider]
                        [(ref-SCR::UR_SCR|ScoreAqpoolLink sc)
                         (ref-SCR::UR_SCR|ScoreLpDenominator sc)])
                    ;;NOW the class-0 branch of UEV_LpStakeScoreContext is reachable with conjunct 2
                    ;;HOLDING, which AQPLP-G1 could not do -- there, class 0 was false. Here only the
                    ;;denominator-vs-pair conjunct fails, so the refusal isolates conjunct 3.
                    (expect "<<AQPLP-G2>> conjunct 2 now HOLDS: the score really is class 0"
                        true (= (ref-SCR::UR_SCR|ScoreClass sc) 0))
                    (expect "<<AQPLP-G2>> ...while conjunct 3 fails: OURO is not in the LP pair"
                        false (contains (ref-SCR::UR_SCR|ScoreLpDenominator sc) pool-tokens))
                    ;;conjunct 1 needs the pool link to match, and this score has none -- so passing BAR
                    ;;as the pool-id satisfies it and leaves conjunct 3 as the only failure.
                    (expect-failure "<<AQPLP-G2>> so the context is refused on the denominator alone"
                        "LP stake score context: pool-id, score-class, or LP pair vs lp-denominator mismatch"
                        (ref-SCR::UEV_LpStakeScoreContext KST.ANHD (U|CT.CT_BAR) sc lp))
                ]
            )
        )
    )
    ""
)
(env-sigs [])
;;the issued score is a real row; this transaction keeps it, because AQPLP-G3 builds on it
(commit-tx)

;;|| NEXT >
;;
(begin-tx "AQPLP-G3 — the class-0 pool rule, reached by building the pool the suite never had")
(env-gasmodel "table")(env-gaslimit 150000000)(env-gas 0)
(namespace "ouronet-ns")
;;same STOA caps as AQPLP-G2 -- issuing a pool is priced the same way as issuing a score
;;==== AQPLP-G3 — the class-0 pool rule, reached by building the pool the suite never had · 01 · env-sigs (caps) ==== 
(print "--- [AQPLP-G3 — the class-0 pool rule, reached by building the pool the suite never had · 01 · env-sigs (caps)] ---")
(env-sigs
    [ { "key": "PK_AncientHodler", "caps": [] }
      { "key": "6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263"
      , "caps":
        [ (coin.TRANSFER "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263"
                         "k:0cb30c0121ff919266121a99ff9359871818932211df94dae4137c29bc0e8f7e" 1000.0)
          (coin.TRANSFER "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263"
                         "k:50d6c59b21e5e6e55baecaa75a1007de37576bde12d8230dc82459cc01b9484b" 1000.0)
          (coin.TRANSFER "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263"
                         "c:XM-pkmuB5XUQlp87ZYSbfKt8qzmHY6O2EHAzMRVBt3k" 1000.0)
          (coin.TRANSFER "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263"
                         "c:iQQFWj6gWtpGEzhM_O5ekW1QtnQQy55R8BRPGhj_0FU" 1000.0) ] } ])
(print "--- [AQPLP-G3 · 01 · a class-0 pool anchored on a real LP token] ---")
;;`UEV_AddScorePoolAndScore` has THREE enforces in sequence, and only the third says anything about
;;class 0:
;;    1] slot-index in 0..6, that slot free, prior slots occupied
;;    2] score exists, its aqpool-link is BAR, its class equals the POOL's aqp-class, not already slotted
;;    3] if aqp-class is 0: the score's lp-denominator must be a token of the pool asset's swap pair
;;
;;Reaching 3 therefore needs a class-0 POOL as well as the class-0 SCORE from AQPLP-G2 -- and the AQP
;;suite builds neither. The pool is one client call, `AQP-POOL|C_Issue … 0`, anchored on the same LP token
;;the score was NOT given as its denominator. That mismatch is the whole subject of enforce 3.
;;==== AQPLP-G3 — the class-0 pool rule, reached by building the pool the suite never had · 02 · let / invocation ==== 
(print "--- [AQPLP-G3 — the class-0 pool rule, reached by building the pool the suite never had · 02 · let / invocation] ---")
(let
    (
        (ref-SCR:module{AcquisitionScoresV2} AQP-SCORE)
        (ref-SWP:module{SwapperV4} SWP)
        (ref-TS02-C3:module{TalosStageTwo_ClientThreeV2} TS02-C3)
        (ref-U|DALOS:module{UtilityDalosV2} U|DALOS)
    )
    (env-module-admin SWP)
    (let*
        (
            (lp:string (at 0 (keys SWP.SWP|LP)))
            (sc:string (ref-U|DALOS::UDC_Makeid "LpProbeScore"))
        )
        (ref-TS02-C3::AQP-POOL|C_Issue KST.ANHD (AQP-POOL.URC_AqpOwnerKontoFromClassAndAsset 0 lp) "LpProbePool" lp 0)
        (let*
            (
                (pool:string (ref-U|DALOS::UDC_Makeid "LpProbePool"))
                (swpair:string (ref-SWP::UR_GetLpSwpair lp))
                (pool-tokens:[string] (ref-SWP::UR_PoolTokens swpair))
            )
            (map print
                [
                    (expect "<<AQPLP-G3>> the new pool is class 0 and anchored on the LP token"
                        [0 lp]
                        [(AQP-POOL.UR_AQP|PoolAqpClass pool) (AQP-POOL.UR_AQP|PoolAssetId pool)])
                    ;;enforce 2's conditions all HOLD, which is what leaves enforce 3 as the only failure
                    (expect "<<AQPLP-G3>> the score is unlinked, class 0, and matches the pool's class"
                        [(U|CT.CT_BAR) 0 0]
                        [(ref-SCR::UR_SCR|ScoreAqpoolLink sc)
                         (ref-SCR::UR_SCR|ScoreClass sc)
                         (AQP-POOL.UR_AQP|PoolAqpClass pool)])
                    ;;enforce 3's condition is the one that fails: the score's denominator is OURO, and
                    ;;the issuance-only pairs are built from AG/AL/AU/BI/CO.
                    (expect "<<AQPLP-G3>> ...but its lp-denominator is not a token of the pool's pair"
                        false (contains (ref-SCR::UR_SCR|ScoreLpDenominator sc) pool-tokens))
                    (expect-failure "<<AQPLP-G3>> so assigning it to the class-0 pool is refused"
                        "Class 0 score lp-denominator must appear in the swap pair for the pool native LP asset-id"
                        (AQP-POOL.UEV_AddScorePoolAndScore pool sc 0))
                    ;;...and the FIRST enforce fronts it, which locates the three in order: an
                    ;;out-of-range slot never reaches the class-0 rule at all.
                    (expect-failure "<<AQPLP-G3>> ...while a slot index past 6 is stopped by the FIRST enforce"
                        "Invalid or unavailable score slot index for pool"
                        (AQP-POOL.UEV_AddScorePoolAndScore pool sc 7))
                ]
            )
        )
    )
    ""
)
(env-sigs [])
;;the pool is kept, like the score: both are fixtures the next pass builds on
(commit-tx)

;;|| NEXT >
;;
(begin-tx "AQPLP-G4 — a REAL frozen LP leg stakes: the match is a real link, not a prefix strip")
(env-gasmodel "table")(env-gaslimit 150000000)(env-gas 0)
(namespace "ouronet-ns")
;;ON A **DIFFERENT** LP PAIR THAN AQPLP-G2/G3's, DELIBERATELY. `LpProbePool`'s own asset is what
;;[6.2.17]_AQP-RERATE.repl rides on next, and its header states the fixture's invariant in so
;;many words: "LpProbePool, asset ..., which has NEITHER a frozen nor a sleeping twin". Freezing
;;IT here would falsify that invariant for every assertion downstream. `(at 1 (keys SWP.SWP|LP))`
;;is a second, untouched pair from the same AG-AL-AU-BI-CO issuance-only chain, with its own
;;pool, so this fixture cannot collide with RERATE's.
;;==== AQPLP-G4 — a REAL frozen LP leg stakes: the match is a real link, not a prefix strip · 01 · env-sigs (caps) ====
(print "--- [AQPLP-G4 — a REAL frozen LP leg stakes: the match is a real link, not a prefix strip · 01 · env-sigs (caps)] ---")
(env-sigs
    [ { "key": "PK_AncientHodler", "caps": [] }
      { "key": "6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263"
      , "caps":
        [ (coin.TRANSFER "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263"
                         "k:0cb30c0121ff919266121a99ff9359871818932211df94dae4137c29bc0e8f7e" 1000.0)
          (coin.TRANSFER "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263"
                         "k:50d6c59b21e5e6e55baecaa75a1007de37576bde12d8230dc82459cc01b9484b" 1000.0)
          (coin.TRANSFER "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263"
                         "c:XM-pkmuB5XUQlp87ZYSbfKt8qzmHY6O2EHAzMRVBt3k" 1000.0)
          (coin.TRANSFER "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263"
                         "c:iQQFWj6gWtpGEzhM_O5ekW1QtnQQy55R8BRPGhj_0FU" 1000.0) ] } ])
(print "--- [AQPLP-G4 · 01 · freeze a real native LP, then stake-match it against a pool on that LP] ---")
;;THE BUG, REPRODUCED AND PINNED. Reported live, 2026-10-11, against a real frozen LP stake:
;;"Invalid dptf-id: leg does not match pool canonical asset". `URC_StakeTrueFungibleDptfMatchesPool`
;;used to recover the "native id" by stripping the F| prefix off the frozen leg and comparing the
;;remainder to the pool's asset-id -- which only works if the frozen id IS "F|" + the native id.
;;It never is: `VST::XI_CreateSpecialTrueFungibleLink` mints the frozen counterpart as its OWN
;;token via `XIv_Issue` -> `UDC_Makeid`, which appends a fresh block-hash suffix, not the native
;;token's. This freezes a REAL native LP for real and proves both fixed call sites against the
;;REAL frozen id DPTF::UR_Frozen returns -- not a hand-built "F|" + lp string, which is exactly
;;the shape of id that never existed on chain and so proves nothing about the real bug.
;;==== AQPLP-G4 — a REAL frozen LP leg stakes: the match is a real link, not a prefix strip · 02 · let / invocation ====
(print "--- [AQPLP-G4 — a REAL frozen LP leg stakes: the match is a real link, not a prefix strip · 02 · let / invocation] ---")
(let
    (
        (ref-SWP:module{SwapperV4} SWP)
        (ref-DPTF:module{DemiourgosPactTrueFungibleV2} DPTF)
        (ref-DPOF:module{DemiourgosPactOrtoFungibleV2} DPOF)
        (ref-SCR:module{AcquisitionScoresV2} AQP-SCORE)
        (ref-AQP:module{AcquisitionPoolsV1} AQP-POOL)
        (ref-TS01-C2:module{TalosStageOne_ClientTwoV2} TS01-C2)
        (ref-TS02-C3:module{TalosStageTwo_ClientThreeV2} TS02-C3)
        (ref-U|DALOS:module{UtilityDalosV2} U|DALOS)
    )
    (env-module-admin SWP)
    (let*
        (
            (lp2:string (at 1 (keys SWP.SWP|LP)))
            (lp2-balance:decimal (ref-DPTF::UR_AccountSupply lp2 KST.ANHD))
            ;;THE WHOLE SUITE SHARES ONE prev-block-hash. `UDC_Makeid` derives a token's id
            ;;suffix from `(at "prev-block-hash" (chain-data))` (U_DALOS.pact's own doc:
            ;;"block-level, identical for every tx in the same block") -- and this entire REPL
            ;;pipeline sets it ONCE, to the literal "98c486052a51..." every Stage file opens
            ;;with, and never varies it. So WITHOUT forcing a different value here, freezing
            ;;lp2 in THIS sandbox would mint a frozen id sharing lp2's own suffix -- making the
            ;;OLD buggy "F| + native id" string-surgery accidentally correct in-sandbox even
            ;;though it is provably wrong on live chain (real blocks really do differ: the
            ;;live defect this closes showed native `...LP-6D_MJJXmhuz3` vs frozen
            ;;`F|...LP-_MYr9VcKUkBx`). Changing it here for the freeze call, then restoring it,
            ;;is what makes this test a faithful reproduction instead of one that would have
            ;;passed on the OLD buggy code too.
            (original-cd:object (chain-data))
        )
        (map print
            [
                (expect (format "<<AQPLP-G4>> a second, DIFFERENT LP pair exists and KST.ANHD holds some ({})"
                                 [lp2])
                    true (and (!= lp2 (at 0 (keys SWP.SWP|LP))) (> lp2-balance 0.0)))
            ]
        )
        (ref-TS02-C3::AQP-POOL|C_Issue
            KST.ANHD (AQP-POOL.URC_AqpOwnerKontoFromClassAndAsset 0 lp2) "FrozenLpProbePool" lp2 0)
        (env-chain-data
            {"prev-block-hash": (hash "AQPLP-G4-frozen-leg-real-block"),
             "block-time": (at "block-time" original-cd)})
        (if (= (ref-DPTF::UR_Frozen lp2) (U|CT.CT_BAR))
            (ref-TS01-C2::VST|C_CreateFrozenLink KST.ANHD (ref-DPTF::UR_Konto lp2) lp2)
            "frozen link already exists")
        (ref-TS01-C2::VST|C_Freeze KST.ANHD KST.ANHD KST.ANHD lp2 (floor (* lp2-balance 0.01) 6))
        ;;SAME TRICK, A DIFFERENT BLOCK, FOR THE SLEEPING LEG. Reported live immediately after
        ;;the frozen leg was fixed: staking a real SLEEPING LP batch of this SAME pool aborted
        ;;one call later, with a DIFFERENT message -- "No value found in table ... SWP|LP for
        ;;key: Z|...". Same defect, same function (`URC_StakeLpTokenToNativeLpDptf`'s Z| branch
        ;;was still `drop 2`), and it needed its own differently-hashed block to prove: minting
        ;;the sleeping counterpart in the SAME block as the frozen one would give it the SAME
        ;;suffix as the frozen leg (not lp2's), which proves nothing about either real defect.
        (env-chain-data
            {"prev-block-hash": (hash "AQPLP-G4-sleeping-leg-real-block"),
             "block-time": (at "block-time" original-cd)})
        (if (= (ref-DPTF::UR_Sleeping lp2) (U|CT.CT_BAR))
            (ref-TS01-C2::VST|C_CreateSleepingLink KST.ANHD (ref-DPTF::UR_Konto lp2) lp2)
            "sleeping link already exists")
        (ref-TS01-C2::VST|C_Sleep KST.ANHD KST.ANHD KST.ANHD lp2 (floor (* lp2-balance 0.01) 6) 432000)
        ;;RESTORED IMMEDIATELY, before anything else reads chain-data -- [6.2.17]_AQP-RERATE.repl
        ;;loads right after this transaction commits and must see the suite's one shared hash,
        ;;not a value this test happened to leave behind.
        (env-chain-data
            {"prev-block-hash": (at "prev-block-hash" original-cd),
             "block-time": (at "block-time" original-cd)})
        (let*
            (
                (pool2:string (ref-U|DALOS::UDC_Makeid "FrozenLpProbePool"))
                (frozen-id:string (ref-DPTF::UR_Frozen lp2))
                (sleeping-id:string (ref-DPTF::UR_Sleeping lp2))
                ;;THE EXACT OLD DEFECT, COMPUTED HERE SO IT CAN BE DISPROVEN RATHER THAN DESCRIBED.
                (old-buggy-frozen-core:string (drop 2 frozen-id))
                (old-buggy-sleeping-core:string (drop 2 sleeping-id))
            )
            (map print
                [
                    (expect "<<AQPLP-G4>> freezing across a DIFFERENT block really did mint a SEPARATE id, not \"F|\" + lp2"
                        true (!= frozen-id (+ "F|" lp2)))
                    (expect "<<AQPLP-G4>> ...and sleeping it, across ANOTHER different block, minted a THIRD id"
                        true (and (!= sleeping-id (+ "Z|" lp2)) (!= sleeping-id frozen-id)))
                    (expect (format "<<AQPLP-G4>> so the OLD prefix-strip logic would NOT have matched either: \"{}\" / \"{}\" != lp2"
                                     [old-buggy-frozen-core old-buggy-sleeping-core])
                        [false false] [(= old-buggy-frozen-core lp2) (= old-buggy-sleeping-core lp2)])
                    ;;URC_StakeTrueFungibleDptfMatchesPool is AQP-POOL's own function (defined in
                    ;;03_AQP.pact), not AQP-SCORE's -- read through the right module.
                    (expect "<<AQPLP-G4>> FIXED: URC_StakeTrueFungibleDptfMatchesPool now accepts the REAL frozen leg"
                        true (ref-AQP::URC_StakeTrueFungibleDptfMatchesPool pool2 frozen-id))
                    (expect "<<AQPLP-G4>> the native leg still matches too -- the fix did not narrow this"
                        true (ref-AQP::URC_StakeTrueFungibleDptfMatchesPool pool2 lp2))
                    (expect "<<AQPLP-G4>> an UNRELATED native leg (G2/G3's own pool's asset) is correctly REFUSED"
                        false (ref-AQP::URC_StakeTrueFungibleDptfMatchesPool pool2 (at 0 (keys SWP.SWP|LP))))
                    (expect "<<AQPLP-G4>> FIXED: URC_StakeLpTokenToNativeLpDptf resolves the frozen leg back to lp2"
                        lp2 (ref-SCR::URC_StakeLpTokenToNativeLpDptf frozen-id))
                    ;;THE SLEEPING SIBLING, FIXED THE SAME WAY: not via a new resolver, but via
                    ;;`DPOF::UR_Sleeping` -- a DIFFERENT function of the same name on a DIFFERENT
                    ;;module than `DPTF::UR_Sleeping`, already written bidirectionally
                    ;;(`DPOF::XI_UpdateSleeping` sets the DPOF's own row's reverse pointer in the
                    ;;SAME transaction `DPTF::XE_UpdateSleeping` sets the forward one) and already
                    ;;proven in exactly this role by `URC_StakeOrtoFungibleDpofMatchesPool`.
                    (expect "<<AQPLP-G4>> FIXED: URC_StakeLpTokenToNativeLpDptf resolves the SLEEPING leg back to lp2 too"
                        lp2 (ref-SCR::URC_StakeLpTokenToNativeLpDptf sleeping-id))
                    (expect "<<AQPLP-G4>> ...and the reverse link it rides on is DPOF::UR_Sleeping, not DPTF::UR_Sleeping"
                        lp2 (ref-DPOF::UR_Sleeping sleeping-id))
                    (expect "<<AQPLP-G4>> URC_StakeOrtoFungibleDpofMatchesPool accepts the REAL sleeping leg (class 0)"
                        true (ref-AQP::URC_StakeOrtoFungibleDpofMatchesPool pool2 sleeping-id))
                ]
            )
        )
    )
    ""
)
(env-sigs [])
(commit-tx)
(print "")
;;THE RE-RATE SUITE RIDES HERE, and it has to ride somewhere specific: it needs a CLASS-0 score
;;and a CLASS-0 pool, and this is the only chain in the tree that builds either. Loaded at the
;;end so the fixtures above are committed; `modules/*.repl` is a gate entrypoint glob, so adding
;;the load is what puts those assertions inside the gate rather than beside it.
(load "../Stage_02/[6.2.17]_AQP-RERATE.repl")

(print "=== END modules/AQP-LP.repl ===")
