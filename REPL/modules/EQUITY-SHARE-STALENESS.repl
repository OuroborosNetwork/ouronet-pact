(begin-tx "TX-EQSS-02 - both share doors REFUSE while the collection is staked")
(print "")
(print "=== TX-EQSS-02 — UEV_AQP|NoLiveStakeOfAsset closes the window ================")
(namespace "ouronet-ns")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
;;==== TX-EQSS-02 - both share doors refuse · 01 · env-sigs (caps) ==== ===========
(print "--- [TX-EQSS-02 · 01 · env-sigs (caps)] ---")
(env-sigs [{ "key": "PK_AncientHodler", "caps": [] }])
;;==== TX-EQSS-02 - both share doors refuse · 02 · refusals ==== ==================
(print "--- [TX-EQSS-02 · 02 · refusals] ---")
;;THE REFUSAL IS ASSERTED BY ITS MESSAGE, not merely by failing. A share door can fail for many
;;unrelated reasons -- wrong executor, non-equity id, bad millions -- and a test that accepts any
;;failure would still pass with the gate DELETED. Matching "is staked in" is what makes this
;;test about the gate. Same reason [RT-C]_AdminImpersonation pins the treasury case by message.
(let
    (
        (anhd:string KST.ANHD)
        (edh-id:string "E|DH-98c486052a51")
        (ref-TS02-C1:module{TalosStageTwo_ClientOneV5} TS02-C1)
    )
    (map print
        [
            (expect-failure
                "<<TX-EQSS-02>> CC_IssueShares refuses, naming the blocking pool"
                "is staked in"
                (ref-TS02-C1::DPSF|CC_IssueShares anhd anhd edh-id 1))
            ;;RETIREMENT IS NOT THE SAFE DIRECTION EITHER. It re-values packages DOWNWARD, so an
            ;;unstake afterwards subtracts LESS than its stake added and the row keeps a positive
            ;;residue -- a holder credited for weight they no longer carry. Opposite sign, same
            ;;corruption, so the same gate guards it.
            (expect-failure
                "<<TX-EQSS-02>> CC_RetireShares refuses too -- the other direction corrupts as well"
                "is staked in"
                (ref-TS02-C1::DPSF|CC_RetireShares anhd anhd edh-id 1))
        ]
    )
)
(env-sigs [])
(commit-tx)
