(begin-tx "TX-EQSS-01 - the re-rate engine answers for class 3, and agrees with the stake path")
(print "")
(print "=== TX-EQSS-01 — class-3 support + engine/stake-path agreement ===============")
(namespace "ouronet-ns")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
;;==== TX-EQSS-01 - engine answers for class 3 · 01 · let / invocation ==== =======
(print "--- [TX-EQSS-01 · 01 · let / invocation] ---")
;;THE AGREEMENT ASSERTION IS THE LOAD-BEARING ONE. `URHC_AQP|ScoreBackfillOutstanding` is
;;empty exactly when every candidate's stored base already equals the engine's target, so on a
;;freshly staked pool it is [] ONLY IF the target reproduces what the stake path wrote. Had the
;;class-3 target been a reimplementation of the weighting rule rather than a CALL to
;;`URC_SignedBaseDeltaForDpsfStake`, this is where the two copies would disagree -- and every
;;backfill slice would then "repair" a correct row into a wrong one.
(let
    (
        (anhd:string KST.ANHD)
        (edh-id:string "E|DH-98c486052a51")
        (ref-U|DALOS:module{UtilityDalosV2} U|DALOS)
        (ref-AQP:module{AcquisitionPoolsV3} AQP-POOL)
        (ref-SCR:module{AcquisitionScoresV7} AQP-SCORE)
    )
    (let
        (
            (pool-id:string (ref-U|DALOS::UDC_Makeid "DHCompany"))
            (score-id:string (ref-U|DALOS::UDC_Makeid "DemiourgosShareholder"))
        )
        (let
            (
                (supported:bool (ref-AQP::URC_AQP|ScoreBackfillSupported pool-id score-id))
                (outstanding:[object] (ref-AQP::URHC_AQP|ScoreBackfillOutstanding pool-id score-id))
                (leg-rows:object (ref-AQP::URH_AQP|ScoreBackfillLegRows pool-id))
                (base:decimal (ref-SCR::UR_U-SCR|UserScoreBaseScore anhd pool-id score-id))
            )
            (map print
                [
                    (format "<(pool class)> => {}   <(score class)> => {}"
                        [(ref-AQP::UR_AQP|PoolAqpClass pool-id)
                         (ref-SCR::UR_SCR|ScoreClass score-id)])
                    (format "<(AQP-POOL|URC_…ScoreBackfillSupported)> => {}" [supported])
                    (format "<(AQP-POOL|URHC_…ScoreBackfillOutstanding)> => {}" [outstanding])
                    (format "<(nat-rows)> => {}" [(at "nat-rows" leg-rows)])
                    (format "<(stored base)> => {}" [base])
                    ;;1] the fence now admits class 3 -- it returned false before 2026-11-08
                    (expect (format "<<TX-EQSS-01>> class-3 score is re-ratable got={}" [supported])
                        true supported)
                    ;;2] the DPSF rows arrive on the nat-rows leg, carrying a nonce
                    (expect (format "<<TX-EQSS-01>> leg-rows carry the DPSF position got={}"
                            [(length (at "nat-rows" leg-rows))])
                        true (> (length (at "nat-rows" leg-rows)) 0))
                    (expect "<<TX-EQSS-01>> class-3 leg-rows have no frozen leg"
                        0 (length (at "frz-rows" leg-rows)))
                    (expect "<<TX-EQSS-01>> class-3 leg-rows have no sleeping leg"
                        0 (length (at "slp-rows" leg-rows)))
                    ;;3] a live stake carries a positive base
                    (expect (format "<<TX-EQSS-01>> stored base positive got={}" [base])
                        true (> base 0.0))
                    ;;4] THE AGREEMENT: engine target == stake-path base, for every candidate
                    (expect (format "<<TX-EQSS-01>> engine agrees with the stake path got={}" [outstanding])
                        0 (length outstanding))
                ]
            )
        )
    )
)
(commit-tx)
;;||>>>>>>>>>>>>>>>>>>>>>>>>>
;;|| NEXT                   >
;;||>>>>>>>>>>>>>>>>>>>>>>>>>
(print "")
(print "")
