(begin-tx "TX-EQSS-03 - the sanctioned path: unstake nets to ZERO, then issue, then re-rate")
(print "")
(print "=== TX-EQSS-03 — vacate-free round trip at the new share value ===============")
(namespace "ouronet-ns")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
;;==== TX-EQSS-03 - sanctioned path · 01 · unstake at the SAME weight ==== ========
(print "--- [TX-EQSS-03 · 01 · unstake at the SAME weight] ---")
(env-sigs [{ "key": "PK_AncientHodler", "caps": [] }])
;;THE FIRST ASSERTION HERE IS THE WHOLE INVARIANT. `URC_SignedBaseDeltaForDpsfStake`'s contract
;;is "a full unstake reverses exactly and nets to 0" -- and that holds ONLY while the share count
;;has not moved between the two legs. This is the control: unstake with m unchanged, land on
;;exactly 0.0. The pre-fix run of this same sequence, with an issuance in the middle, landed on
;;-10,000 instead.
(let
    (
        (anhd:string KST.ANHD)
        (edh-id:string "E|DH-98c486052a51")
        (ref-U|DALOS:module{UtilityDalosV2} U|DALOS)
        (ref-AQP:module{AcquisitionPoolsV3} AQP-POOL)
        (ref-SCR:module{AcquisitionScoresV7} AQP-SCORE)
        (ref-EQUITY:module{EquityV5} EQUITY)
        (ref-TS02-C1:module{TalosStageTwo_ClientOneV5} TS02-C1)
        (ref-TS02-C3:module{TalosStageTwo_ClientThreeV8} TS02-C3)
    )
    (let
        (
            (pool-id:string (ref-U|DALOS::UDC_Makeid "DHCompany"))
            (score-id:string (ref-U|DALOS::UDC_Makeid "DemiourgosShareholder"))
        )
        (let
            (
                (staked:integer (round (ref-AQP::UR_AQP|DPSFTrackerBalance pool-id edh-id anhd anhd 6)))
                (unit-pre:integer (ref-EQUITY::URC_SingleSharePerMillions edh-id 5))
                (base-pre:decimal (ref-SCR::UR_U-SCR|UserScoreBaseScore anhd pool-id score-id))
            )
            (print (format "<(staked units)> => {}   <(tier-6 unit worth)> => {} shares   <(base)> => {}"
                [staked unit-pre base-pre]))
            (print (format "<(AQP-POOL|CC_UnstakeSemiFungibleCollectable)> => \"{}\""
                [(ref-TS02-C3::AQP-POOL|CC_UnstakeSemiFungibleCollectable
                    anhd anhd anhd pool-id edh-id [6] [staked])]))
            (let
                (
                    (base-mid:decimal (ref-SCR::UR_U-SCR|UserScoreBaseScore anhd pool-id score-id))
                )
                (map print
                    [
                        (format "<(base after full unstake)> => {}" [base-mid])
                        (expect (format "<<TX-EQSS-03>> full unstake nets to EXACTLY zero got={}" [base-mid])
                            0.0 base-mid)
                        (expect (format "<<TX-EQSS-03>> score total not negative got={}"
                                [(ref-SCR::UR_SCR|ScoreTotalBaseScore score-id)])
                            false (< (ref-SCR::UR_SCR|ScoreTotalBaseScore score-id) 0.0))
                    ]
                )
            )
            ;;==== TX-EQSS-03 - sanctioned path · 02 · the door OPENS once nothing is staked ====
            (print "--- [TX-EQSS-03 · 02 · the door OPENS once nothing is staked] ---")
            (print (format "<(DPSF|CC_IssueShares 1 million)> => \"{}\""
                [(ref-TS02-C1::DPSF|CC_IssueShares anhd anhd edh-id 1)]))
            ;;==== TX-EQSS-03 - sanctioned path · 03 · re-stake prices at the NEW value ====
            (print "--- [TX-EQSS-03 · 03 · re-stake prices at the NEW value] ---")
            (print (format "<(AQP-POOL|CC_StakeSemiFungibleCollectable)> => \"{}\""
                [(ref-TS02-C3::AQP-POOL|CC_StakeSemiFungibleCollectable anhd anhd anhd pool-id edh-id [6])]))
            (let
                (
                    (unit-post:integer (ref-EQUITY::URC_SingleSharePerMillions edh-id 5))
                    (base-post:decimal (ref-SCR::UR_U-SCR|UserScoreBaseScore anhd pool-id score-id))
                    (outstanding:[object] (ref-AQP::URHC_AQP|ScoreBackfillOutstanding pool-id score-id))
                )
                (map print
                    [
                        (format "<(m)> => {}   <(tier-6 unit worth)> => {} -> {} shares"
                            [(ref-EQUITY::URC_ShareMillions edh-id) unit-pre unit-post])
                        (format "<(base re-staked)> => {}" [base-post])
                        ;;the issuance really did re-value the tier
                        (expect (format "<<TX-EQSS-03>> tier-6 unit re-valued {} -> {}" [unit-pre unit-post])
                            true (> unit-post unit-pre))
                        ;;and the re-stake is priced at the NEW value, exactly
                        (expect (format "<<TX-EQSS-03>> re-stake priced at the new value got={}" [base-post])
                            (* base-pre 2.0) base-post)
                        ;;and the engine still agrees -- no phantom work after a legitimate re-rate
                        (expect (format "<<TX-EQSS-03>> engine reports no outstanding work got={}" [outstanding])
                            0 (length outstanding))
                    ]
                )
            )
        )
    )
)
(env-sigs [])
(commit-tx)
