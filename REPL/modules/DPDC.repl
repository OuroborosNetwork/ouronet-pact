;;The DPOF twin of this block is `modules/DPOF.repl <<DPOF-I21>>`.
;;EMMA holds MOCKN nonce 1 (moved to her at DPDC-03) — on the NFT side she is a real holder, unlike
;;on the SFT side where she was frozen at zero.
;;
;;THE PLAN IS MADE MULTI-SLICE ON PURPOSE. With a single nonce the campaign degenerates to one
;;slice and the test proves only that `WipeFull` equals `WipeSlice` — leaving the SUMMING, which
;;is the one thing `WipeFull` adds, entirely unexercised. Extra nonces are therefore moved to the
;;holder first, and the slice count is asserted below to be greater than one.
;;
;;SETUP, outside the window: the wipe paths require the target FROZEN.
(env-sigs [{ "key": "PK_AncientHodler", "caps": [] }])
(let
    (
        (ref-TS02-C2:module{TalosStageTwo_ClientTwoV2} TS02-C2)
        (ref-DPDC-MNG:module{DpdcManagementV2} DPDC-MNG)
        (ref-DALOS:module{OuronetDalosV2} DALOS)
        (id:string "MOCKN-98c486052a51")
        (patron:string KST.ANHD)
        (holder:string KST.EMMA)
    )
    ;;...and the holder is given MORE nonces, so the plan really splits.
    (ref-TS02-C2::DPNF|C_TransferNonces patron patron holder id [2 3] [1 1] false)
    (ref-TS02-C2::DPNF|C_ToggleFreezeAccount patron (DPDC.UR_OwnerKonto id false) holder id true)
    (let
        (
            (full:object{DpdcManagementV2.RemovableNonces} (ref-DPDC-MNG::URHC_WipePure holder id false))
        )
        (let
            (
                (plan:object{DpdcManagementV2.DPDC-MNG|WipeSlicePlan}
                    (ref-DPDC-MNG::URHC_BuildWipeSlicePlan holder id false (length (at "r-nonces" full))))
            )
            (let
                (
                    (predicted:decimal
                        (at "ignis-need" (at "ignis" (INFO-TWO.INFO_DPNF|WipeFull patron holder id plan))))
                    (ignis-before:decimal (ref-DALOS::UR_TF_AccountSupply patron false))
                )
                ;;THE CAMPAIGN — one Cp_WipeSlice per slice, accumulated inside a single window.
                (map
                    (lambda (slice:object{DpdcManagementV2.RemovableNonces})
                        (ref-TS02-C2::DPNF|Cp_WipeSlice patron holder id slice))
                    (at "slices" plan))
                (let
                    (
                        (real:decimal (- ignis-before (ref-DALOS::UR_TF_AccountSupply patron false)))
                    )
                    (map print
                        [
                            (format "<<DPNF-I41>> nonces={} slices={} predicted={} real={} delta={}"
                                [(length (at "r-nonces" full)) (at "slice-count" plan) predicted real (- real predicted)])
                            (expect "<<DPNF-I41>> the campaign really spans more than one slice"
                                true (> (at "slice-count" plan) 1))
                            (expect "<<DPNF-I41>> the grand-total quote equals the whole campaign's charge"
                                real predicted)
                            (expect "<<DPNF-I41>> ...and it is a real, non-zero charge" true (> real 0.0))
                            (expect "<<DPNF-I41>> ...witness: nothing wipeable remains"
                                0 (length (at "r-nonces" (ref-DPDC-MNG::URHC_WipePure holder id false))))
                        ]
                    )
                )
            )
        )
    )
    ""
)
(env-sigs [])
(rollback-tx)
