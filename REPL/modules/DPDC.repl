(begin-tx "DPDC-G9 — the multi-nonce cap's own length guard, in front of the parity guard")
(env-gasmodel "table")(env-gaslimit 150000000)(env-gas 0)
(namespace "ouronet-ns")
;;==== DPDC-G9 — the multi-nonce cap's own length guard, in front of the parity guard · 01 · env-sigs (caps) ==== 
(print "--- [DPDC-G9 — the multi-nonce cap's own length guard, in front of the parity guard · 01 · env-sigs (caps)] ---")
(env-sigs [{ "key": "PK_AncientHodler", "caps": [] }])
(print "--- [DPDC-G9 · 01 · one amount, two nonce-datas] ---")
;;DPDC-G8 pinned two of DPDC-C|C>REGISTER-NONCES's guards. This is the one in the cap ABOVE it:
;;DPDC-C|C>REGISTER-MULTIPLE-NONCES enforces `(> (length amounts) 1)` before composing
;;REGISTER-NONCES. So there are two different "your lists are wrong" rejections, and which one answers
;;depends on HOW the lists are wrong:
;;
;;  * `DPSF|C_Create` picks its path from `(length input-nonce-data)`: 1 -> single, more -> multiple.
;;  * So ONE amount against TWO nonce-datas routes to the MULTIPLE path and then fails its own
;;    length guard -- it never reaches the parity check that DPDC-G8 pins.
;;  * THREE amounts against TWO nonce-datas (DPDC-G8) passes this guard and fails parity instead.
;;
;;Both are pinned because the two messages are what tell an integrator which mistake they made, and
;;the boundary between them is not obvious from either one.
;;==== DPDC-G9 — the multi-nonce cap's own length guard, in front of the parity guard · 02 · let / invocation ==== 
(print "--- [DPDC-G9 — the multi-nonce cap's own length guard, in front of the parity guard · 02 · let / invocation] ---")
(let ((sf:string "MOCKS-98c486052a51")
      (nd:object{DpdcUdcV2.DPDC|NonceData} (DPDC-UDC.UDC_NonceData 0.0 0.0 "n" "d"
          (DPDC-UDC.UDC_NoMetaData)
          (DPDC-UDC.UDC_URI|Type true false false false false false false)
          (DPDC-UDC.UDC_URI|Data "ipfs://a" "" "" "" "" "" "")
          (DPDC-UDC.UDC_ZeroURI|Data) (DPDC-UDC.UDC_ZeroURI|Data))))
    (map print
        [
            (expect-failure "<<DPDC-G9>> one amount against two nonce-datas hits the MULTI length guard"
                "Invalid Input variable length for a Multi Nonce Creation Capability"
                (TS02-C1.DPSF|C_Create KST.ANHD (DPDC.UR_Verum5 sf true) sf [1] [nd nd]))
            ;;...and the contrast that locates the boundary: the same shape of mistake in the other
            ;;direction gets the OTHER message, because it clears this guard first.
            (expect-failure "<<DPDC-G9>> ...while three amounts against two reaches the PARITY guard instead"
                "Incompatible Input Data for Registering multiple Nonces"
                (TS02-C1.DPSF|C_Create KST.ANHD (DPDC.UR_Verum5 sf true) sf [1 1 1] [nd nd]))
        ]
    )
    ""
)
(commit-tx)

