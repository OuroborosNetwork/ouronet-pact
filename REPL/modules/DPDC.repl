(begin-tx "DPDC-G5a — DPNF crediting: an NFT is quantity ONE, and the caps say so twice")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(namespace "ouronet-ns")
(print "--- [DPDC-G5a · 01 · NFT credit amount, singular] ---")
;;The defining property of a non-fungible is that exactly one of it exists. DPDC enforces that at
;;CREDIT time in two separate caps -- one for a single nonce, one for a batch -- because the two
;;take different argument shapes and neither can borrow the other's check.
;;
;;These are defcaps, reached with `test-capability`: it acquires the capability directly and runs
;;its body, and each of these enforces sits above any table read, so dummy ids reach them. Each
;;case takes its own transaction, since a granted capability is cached for the rest of the tx.
;;==== DPDC-G5a — DPNF crediting: an NFT is quantity ONE, and the caps say so twice · 01 · env-sigs (caps) ==== 
(print "--- [DPDC-G5a — DPNF crediting: an NFT is quantity ONE, and the caps say so twice · 01 · env-sigs (caps)] ---")
(env-sigs [{ "key": "PK_Emma", "caps": [] }])
(map print
    [
        (expect-failure "<<DPDC-G5a>> crediting an NFT nonce with amount 2 is refused"
            "Credit amount is must be 1 for NFTs"
            (test-capability (DPDC-C.DPNF|C>CREDIT-NONCE "a" 1 2)))
    ]
)
(commit-tx)

