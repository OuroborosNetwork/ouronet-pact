;; REPL/modules/DPDC.repl — STANDALONE DPDC (collectable core) tester.
;;
;; P2 rebuild. The previous version loaded Stage_02/[6.1]_DPDC.repl, which carries no
;; assertions, so this tester asserted NOTHING about DPDC and passed because booting a chain
;; passes.
;;
;; DPDC is the shared core behind BOTH collectable kinds, discriminated by <son>: son=true is
;; semi-fungible (DPSF), son=false is non-fungible (DPNF). Its own Talos surface is just the two
;; multi/bulk transfers; per-kind ops live under DPSF|/DPNF|. These assertions therefore pin the
;; SHARED behaviour and the son discriminator itself.
;;
;; Run: cd REPL && pact modules/DPDC.repl
(load "../deploy-stage00.repl")
(load "../deploy-stage01.repl")
(load "../deploy-stage02.repl")
(load "../fixtures/mock-collections.repl")

;;|| NEXT >
;;
(begin-tx "DPDC-01 — the son discriminator separates two collections that share the core")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(namespace "ouronet-ns")
(print "--- [DPDC-01 · 01 · son discrimination] ---")
(let
    (
        (ref-DPDC:module{DpdcV2} DPDC)
        (nf:string "MOCKN-98c486052a51")
        (sf:string "MOCKS-98c486052a51")
    )
    (map print
        [
            (expect "<<DPDC-01>> NFT owner konto reads through son=false" KST.ANHD (ref-DPDC::UR_OwnerKonto nf false))
            (expect "<<DPDC-01>> SFT owner konto reads through son=true"  KST.ANHD (ref-DPDC::UR_OwnerKonto sf true))
            (expect "<<DPDC-01>> NFT creator konto"        KST.ANHD (ref-DPDC::UR_CreatorKonto nf false))
            (expect "<<DPDC-01>> SFT creator konto"        KST.ANHD (ref-DPDC::UR_CreatorKonto sf true))
            (expect "<<DPDC-01>> NFT ticker"               "MOCKN"  (ref-DPDC::UR_Ticker nf false))
            (expect "<<DPDC-01>> SFT ticker"               "MOCKS"  (ref-DPDC::UR_Ticker sf true))
            (expect "<<DPDC-01>> NFT has 3 nonces"         3        (ref-DPDC::UR_NoncesUsed nf false))
            (expect "<<DPDC-01>> SFT has 3 nonces"         3        (ref-DPDC::UR_NoncesUsed sf true))
            (expect "<<DPDC-01>> neither collection is paused (NFT)" false (ref-DPDC::UR_IsPaused nf false))
            (expect "<<DPDC-01>> neither collection is paused (SFT)" false (ref-DPDC::UR_IsPaused sf true))
        ]
    )
    ""
)
(commit-tx)

;;|| NEXT >
;;
(begin-tx "DPDC-02 — supply semantics differ by kind: NFT nonce = 1, SFT nonce = quantity")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(namespace "ouronet-ns")
(print "--- [DPDC-02 · 01 · per-kind supply] ---")
(let
    (
        (ref-DPDC:module{DpdcV2} DPDC)
        (ref-I|OURONET:module{OuronetInfoV2} IGNIS)
        (nf:string "MOCKN-98c486052a51")
        (sf:string "MOCKS-98c486052a51")
        (patron:string KST.ANHD)
    )
    (map print
        [
            ;;mock-collections created NFT nonces with no quantity and SFT nonces with 10 each.
            (expect "<<DPDC-02>> an NFT nonce is unique (supply 1)"
                1 (ref-DPDC::UR_NonceSupply nf false 1))
            (expect "<<DPDC-02>> an SFT nonce carries its minted quantity (10)"
                10 (ref-DPDC::UR_NonceSupply sf true 1))
            ;;UR_NonceHolder returns the SHORT display form of the account, not the full id.
            (expect "<<DPDC-02>> the NFT nonce is held by its creator"
                (ref-I|OURONET::OI|UC_ShortAccount patron) (ref-DPDC::UR_NonceHolder nf false 1))
            (expect "<<DPDC-02>> the account holds all 3 SFT nonces"
                30 (fold (+) 0 [(ref-DPDC::UR_AccountNonceSupply patron sf true 1)
                                (ref-DPDC::UR_AccountNonceSupply patron sf true 2)
                                (ref-DPDC::UR_AccountNonceSupply patron sf true 3)]))
        ]
    )
    ""
)
(commit-tx)

;;|| NEXT >
;;
(begin-tx "DPDC-03 — DPDC|C_MultiTransfer moves nonces across BOTH kinds in one call")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(namespace "ouronet-ns")
(print "--- [DPDC-03 · 01 · cross-kind multi transfer] ---")
(env-sigs [{ "key": "PK_AncientHodler", "caps": [] }])
(let
    (
        (ref-DPDC:module{DpdcV2} DPDC)
        (ref-TS02-C1:module{TalosStageTwo_ClientOneV2} TS02-C1)
        (ref-I|OURONET:module{OuronetInfoV2} IGNIS)
        (nf:string "MOCKN-98c486052a51")
        (sf:string "MOCKS-98c486052a51")
        (patron:string KST.ANHD)
        (emma:string KST.EMMA)
    )
    (let
        (
            (sf-tot0:integer (ref-DPDC::UR_NonceSupply sf true 1))
            (nf-hold0:string (ref-DPDC::UR_NonceHolder nf false 1))
        )
        ;;one call, both kinds: NFT nonce 1 (amount 1) and SFT nonce 1 (amount 4)
        (ref-TS02-C1::DPDC|C_MultiTransfer patron [nf sf] [false true] patron emma
            [[1] [1]] [[1] [4]] false)
        (map print
            [
                (expect "<<DPDC-03>> the NFT nonce moved to the receiver"
                    (ref-I|OURONET::OI|UC_ShortAccount emma) (ref-DPDC::UR_NonceHolder nf false 1))
                (expect "<<DPDC-03>> the NFT nonce was held by the sender before the move"
                    (ref-I|OURONET::OI|UC_ShortAccount patron) nf-hold0)
                (expect "<<DPDC-03>> the receiver got exactly 4 of the SFT nonce"
                    4 (ref-DPDC::UR_AccountNonceSupply emma sf true 1))
                (expect "<<DPDC-03>> the sender kept the remainder of the SFT nonce"
                    (- sf-tot0 4) (ref-DPDC::UR_AccountNonceSupply patron sf true 1))
                (expect "<<DPDC-03>> INVARIANT: the SFT nonce total is conserved by the transfer"
                    sf-tot0 (ref-DPDC::UR_NonceSupply sf true 1))
            ]
        )
    )
    ""
)
(commit-tx)

;;|| NEXT >
;;
(begin-tx "DPDC-04 — C_BulkTransfer: one sender, many receivers, in one call")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(namespace "ouronet-ns")
(print "--- [DPDC-04 · 01 · bulk transfer] ---")
(env-sigs [{ "key": "PK_AncientHodler", "caps": [] }])
;;Previously invoked by NOTHING in any asserting test (ledger G1 gap).
(let
    (
        (ref-DPDC:module{DpdcV2} DPDC)
        (ref-TS02-C1:module{TalosStageTwo_ClientOneV2} TS02-C1)
        (sf:string "MOCKS-98c486052a51")
        (patron:string KST.ANHD)
        (emma:string KST.EMMA)
        (lumy:string KST.LUMY)
    )
    (let
        (
            (tot0:integer (ref-DPDC::UR_NonceSupply sf true 2))
            (e0:integer (ref-DPDC::UR_AccountNonceSupply emma sf true 2))
            (l0:integer (ref-DPDC::UR_AccountNonceSupply lumy sf true 2))
        )
        ;;nonce 2, 3 to EMMA and 2 to LUMY, in a single bulk call
        (ref-TS02-C1::DPDC|C_BulkTransfer patron sf true [[2] [2]] [[3] [2]] patron [emma lumy] false)
        (map print
            [
                ;;NOTE: UR_AccountNonceSupply returns -1 as the "holds none" SENTINEL, not 0.
                ;;Baseline arithmetic that assumes 0 is wrong; assert the absolute holding.
                (expect "<<DPDC-04>> neither receiver held this nonce beforehand (-1 sentinel)"
                    [-1 -1] [e0 l0])
                (expect "<<DPDC-04>> first receiver credited exactly its leg"
                    3 (ref-DPDC::UR_AccountNonceSupply emma sf true 2))
                (expect "<<DPDC-04>> second receiver credited exactly its leg"
                    2 (ref-DPDC::UR_AccountNonceSupply lumy sf true 2))
                (expect "<<DPDC-04>> INVARIANT: a bulk transfer conserves the nonce total"
                    tot0 (ref-DPDC::UR_NonceSupply sf true 2))
            ]
        )
    )
    ""
)
(commit-tx)

;;|| NEXT >
;;
(begin-tx "DPDC-05 — C_UpdatePendingBranding writes PENDING, leaving live branding alone")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(namespace "ouronet-ns")
(print "--- [DPDC-05 · 01 · pending branding] ---")
(env-sigs [{ "key": "PK_AncientHodler", "caps": [] }])
;;Both DPNF| and DPSF| C_UpdatePendingBranding were invoked by NOTHING (ledger G1 gap).
;;The point of the op is the PENDING/LIVE split, so that is what gets asserted.
(let
    (
        (ref-BRD:module{BrandingV2} BRD)
        (ref-TS02-C1:module{TalosStageTwo_ClientOneV2} TS02-C1)
        (ref-TS02-C2:module{TalosStageTwo_ClientTwoV2} TS02-C2)
        (nf:string "MOCKN-98c486052a51")
        (sf:string "MOCKS-98c486052a51")
        (patron:string KST.ANHD)
    )
    (let ((live0:string (ref-BRD::UR_Logo nf false)))
        (ref-TS02-C2::DPNF|C_UpdatePendingBranding patron nf "nf-logo" "nf-desc" "https://nf" [])
        (ref-TS02-C1::DPSF|C_UpdatePendingBranding patron sf "sf-logo" "sf-desc" "https://sf" [])
        (map print
            [
                (expect "<<DPDC-05>> NFT pending logo was written"
                    "nf-logo" (ref-BRD::UR_Logo nf true))
                (expect "<<DPDC-05>> NFT pending description was written"
                    "nf-desc" (ref-BRD::UR_Description nf true))
                (expect "<<DPDC-05>> SFT pending website was written"
                    "https://sf" (ref-BRD::UR_Website sf true))
                (expect "<<DPDC-05>> the LIVE branding is untouched by a PENDING write"
                    live0 (ref-BRD::UR_Logo nf false))
                (expect "<<DPDC-05>> the two collections did not cross-contaminate"
                    "sf-logo" (ref-BRD::UR_Logo sf true))
            ]
        )
    )
    ""
)
(commit-tx)

;;|| NEXT >
;;
(begin-tx "DPDC-06 — DPSF|C_UpdateNonce: the SFT whole-object writer")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(namespace "ouronet-ns")
(print "--- [DPDC-06 · 01 · SFT whole-object nonce write] ---")
(env-sigs [{ "key": "PK_AncientHodler", "caps": [] }])
;;Previously invoked by NOTHING (ledger G1 gap). Tested here rather than in a separate SFT
;;tester because it operates on the SAME shared collectable core and the SAME mock fixture --
;;the DPNF counterpart is asserted in modules/DPNF.repl (DPNF-04).
(let
    (
        (ref-DPDC:module{DpdcV2} DPDC)
        (ref-DPDC-UDC:module{DpdcUdcV2} DPDC-UDC)
        (ref-TS02-C1:module{TalosStageTwo_ClientOneV2} TS02-C1)
        (sf:string "MOCKS-98c486052a51")
        (patron:string KST.ANHD)
    )
    (let
        (
            (type:object{DpdcUdcV2.URI|Type}
                (ref-DPDC-UDC::UDC_URI|Type true false false false false false false))
        )
        (let
            (
                (nd:object{DpdcUdcV2.DPDC|NonceData}
                    (ref-DPDC-UDC::UDC_NonceData 9.0 8.0 "SftWholeWrite" "sft object write"
                        (ref-DPDC-UDC::UDC_MetaData { "sft": "yes" }) type
                        (ref-DPDC-UDC::UDC_ZeroURI|Data) (ref-DPDC-UDC::UDC_ZeroURI|Data)
                        (ref-DPDC-UDC::UDC_ZeroURI|Data)))
            )
            (ref-TS02-C1::DPSF|C_UpdateNonce patron sf patron 3 true nd)
            (let ((got:object{DpdcUdcV2.DPDC|NonceData} (ref-DPDC::UR_NonceData sf true 3)))
                (map print
                    [
                        (expect "<<DPDC-06>> DPSF|C_UpdateNonce wrote the name"
                            "SftWholeWrite" (at "name" got))
                        (expect "<<DPDC-06>> DPSF|C_UpdateNonce wrote the royalty"
                            9.0 (at "royalty" got))
                        (expect "<<DPDC-06>> DPSF|C_UpdateNonce wrote the ignis royalty"
                            8.0 (at "ignis" got))
                        ;;The NFT collection must be untouched -- its nonce 2 is still at the
                        ;;fixture default "M". (Each tester is its OWN process with its own DB, so
                        ;;this cannot borrow state from modules/DPNF.repl, which writes that nonce.)
                        (expect "<<DPDC-06>> the SFT write did not touch the NFT collection"
                            "M" (at "name" (ref-DPDC::UR_NonceData "MOCKN-98c486052a51" false 2)))
                        (expect "<<DPDC-06>> the SFT nonce still carries its supply after a metadata write"
                            10 (ref-DPDC::UR_NonceSupply sf true 3))
                    ]
                )
            )
        )
    )
    ""
)
(commit-tx)
