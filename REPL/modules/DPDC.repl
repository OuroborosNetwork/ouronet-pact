(begin-tx "DPDC-I45 — INFO_DPSF|WipeFull: a CAMPAIGN total, measured across every slice")
(env-gasmodel "table")(env-gaslimit 100000000)(env-gas 0)
(namespace "ouronet-ns")
(print "--- [DPDC-I45 · 01 · the whole Hydra wipe campaign, weighed] ---")
;;FUNCTION COVERAGE (G6) — `INFO_DPSF|WipeFull`, per the owner's spec. Template: `modules/ATS.repl <<ATS-I1>>`.
;;
;;NO SINGLE EXEC EXISTS, which is why this one sat unmeasured. `WipeFull` quotes the GRAND TOTAL of a
;;Hydra campaign: `URHC_BuildWipeSlicePlan` partitions the wipeable set into N slices and the client
;;fires one `Cp_WipeSlice` transaction per slice, in parallel. There is no `C_WipeFull` to point a
;;meter at, so the measurement is a SUM — open the window once, run every slice, close it once.
;;The DPOF twin of this block is `modules/DPOF.repl <<DPOF-I21>>`.
;;LUMY holds MOCKS nonce 2 (DPDC-04); EMMA is unusable because DPDC-08 froze her at zero, which
;;would make the campaign a wipe of nothing and the equality vacuous.
;;
;;THE PLAN IS MADE MULTI-SLICE ON PURPOSE. With a single nonce the campaign degenerates to one
;;slice and the test proves only that `WipeFull` equals `WipeSlice` — leaving the SUMMING, which
;;is the one thing `WipeFull` adds, entirely unexercised. Extra nonces are therefore moved to the
;;holder first, and the slice count is asserted below to be greater than one.
;;
;;SETUP, outside the window: the wipe paths require the target FROZEN.
(env-sigs [{ "key": "PK_AncientHodler", "caps": [] }])
(let
    (
        (ref-TS02-C1:module{TalosStageTwo_ClientOneV2} TS02-C1)
        (ref-DPDC-MNG:module{DpdcManagementV2} DPDC-MNG)
        (ref-DALOS:module{OuronetDalosV2} DALOS)
        (id:string "MOCKS-98c486052a51")
        (patron:string KST.ANHD)
        (holder:string KST.LUMY)
    )
    ;;...and the holder is given MORE nonces, so the plan really splits.
    (ref-TS02-C1::DPSF|C_TransferNonces patron patron holder id [1 4] [1 1] false)
    (ref-TS02-C1::DPSF|C_ToggleFreezeAccount patron (DPDC.UR_OwnerKonto id true) holder id true)
    (let
        (
            (full:object{DpdcManagementV2.RemovableNonces} (ref-DPDC-MNG::URHC_WipePure holder id true))
        )
        (let
            (
                (plan:object{DpdcManagementV2.DPDC-MNG|WipeSlicePlan}
                    (ref-DPDC-MNG::URHC_BuildWipeSlicePlan holder id true (length (at "r-nonces" full))))
            )
            (let
                (
                    (predicted:decimal
                        (at "ignis-need" (at "ignis" (INFO-TWO.INFO_DPSF|WipeFull patron holder id plan))))
                    (ignis-before:decimal (ref-DALOS::UR_TF_AccountSupply patron false))
                )
                ;;THE CAMPAIGN — one Cp_WipeSlice per slice, accumulated inside a single window.
                (map
                    (lambda (slice:object{DpdcManagementV2.RemovableNonces})
                        (ref-TS02-C1::DPSF|Cp_WipeSlice patron holder id slice))
                    (at "slices" plan))
                (let
                    (
                        (real:decimal (- ignis-before (ref-DALOS::UR_TF_AccountSupply patron false)))
                    )
                    (map print
                        [
                            (format "<<DPDC-I45>> nonces={} slices={} predicted={} real={} delta={}"
                                [(length (at "r-nonces" full)) (at "slice-count" plan) predicted real (- real predicted)])
                            (expect "<<DPDC-I45>> the campaign really spans more than one slice"
                                true (> (at "slice-count" plan) 1))
                            (expect "<<DPDC-I45>> the grand-total quote equals the whole campaign's charge"
                                real predicted)
                            (expect "<<DPDC-I45>> ...and it is a real, non-zero charge" true (> real 0.0))
                            (expect "<<DPDC-I45>> ...witness: nothing wipeable remains"
                                0 (length (at "r-nonces" (ref-DPDC-MNG::URHC_WipePure holder id true))))
                        ]
                    )
                )
            )
        )
    )
    ""
)
(env-sigs [])
(rollback-tx)

