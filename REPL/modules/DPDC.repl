(begin-tx "DPDC-G13 — four argument-domain guards across the DPDC family")
(env-gasmodel "table")(env-gaslimit 150000000)(env-gas 0)
(namespace "ouronet-ns")
;;==== DPDC-G13 — four argument-domain guards across the DPDC family · 01 · env-sigs (caps) ==== ==
(print "--- [DPDC-G13 — four argument-domain guards across the DPDC family · 01 · env-sigs (caps)] ---")
(env-sigs [{ "key": "PK_AncientHodler", "caps": [] }])
(print "--- [DPDC-G13 · 01 · four refusals, no fixture between them] ---")
;;Four unpinned guards in four different DPDC modules, all of them argument-domain, none needing any
;;state this file does not already have. They had simply never been called with a rejecting input.
;;==== DPDC-G13 — four argument-domain guards across the DPDC family · 02 · let / invocation ==== =
(print "--- [DPDC-G13 — four argument-domain guards across the DPDC family · 02 · let / invocation] ---")
(let
    (
        (ref-DPDC:module{DpdcV2} DPDC)
        (ref-TS02-C1:module{TalosStageTwo_ClientOneV2} TS02-C1)
        (sf:string "MOCKS-98c486052a51")
        (nd:object{DpdcUdcV2.DPDC|NonceData} (DPDC-UDC.UDC_NonceData 0.0 0.0 "n" "d"
            (DPDC-UDC.UDC_NoMetaData)
            (DPDC-UDC.UDC_URI|Type true false false false false false false)
            (DPDC-UDC.UDC_URI|Data "ipfs://a" "" "" "" "" "" "")
            (DPDC-UDC.UDC_ZeroURI|Data) (DPDC-UDC.UDC_ZeroURI|Data)))
    )
    (map print
        [
            ;;1] URv_GetVerumChain dispatches a VERUM ROLE by position, and only eight positions exist:
            ;;   [1 2 3 4 7 8 9 11]. Note the GAPS -- 5, 6 and 10 are not roles, so a caller walking
            ;;   1..11 would hit them. A `URv_` is unprotected and directly callable, which makes this
            ;;   the cheapest guard in the whole worklist: one call, no signer, no state.
            (expect "<<DPDC-G13>> position 1 resolves to a real verum role"
                true (> (length (ref-DPDC::URv_GetVerumChain sf true 1)) 0))
            (expect-failure "<<DPDC-G13>> ...while position 5 is one of the gaps and is refused"
                "Invalid Position for Multi Verum"
                (ref-DPDC::URv_GetVerumChain sf true 5))
            ;;2] the royalty-exemption role is for SMART accounts only -- a standard account has no
            ;;   mechanism to disburse what it would accumulate. ANHD is standard, asserted.
            (expect "<<DPDC-G13>> ANHD is a STANDARD account"
                false (DALOS.UR_AccountType KST.ANHD))
            (expect-failure "<<DPDC-G13>> ...so it cannot be given the exemption role"
                "Only Smart Ouronet Accounts can get this role"
                (ref-TS02-C1::DPSF|C_ToggleExemptionRole KST.ANHD (DPDC.UR_OwnerKonto sf true) KST.ANHD sf true))
            ;;3] breaking down a SET requires a non-zero nonce class -- class 0 is the plain,
            ;;   unaggregated nonce and there is nothing inside it to break. Every nonce on this
            ;;   collection is class 0 (asserted by DPDC-G11), so the input is already here.
            (expect "<<DPDC-G13>> nonce 1 is class zero, so there is no set to break"
                0 (ref-DPDC::UR_NonceClass sf true 1))
            (expect-failure "<<DPDC-G13>> ...and breaking it is refused"
                "Only Class Non-0 Nonces can be broken Down"
                (ref-TS02-C1::DPSF|CC_Break KST.ANHD KST.ANHD sf 1 1))
            ;;4] updating nonces takes two parallel lists and requires them to agree in length --
            ;;   otherwise nonces would be rewritten with data the caller never supplied for them.
            (expect-failure "<<DPDC-G13>> two nonces against one data object is refused"
                "Invalid Inputs for Updating Nonces"
                (ref-TS02-C1::DPSF|C_UpdateNonces KST.ANHD sf KST.ANHD [1 2] true [nd]))
        ]
    )
    ""
)
(env-sigs [])
(commit-tx)

