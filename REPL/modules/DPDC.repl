(begin-tx "DPDC-I39 — INFO_DPSF|Issue: both currencies measured")
(env-gasmodel "table")(env-gaslimit 100000000)(env-gas 0)
(namespace "ouronet-ns")
(print "--- [DPDC-I39 · 01 · issue a fresh SFT collection] ---")
;;FUNCTION COVERAGE (G6) — `INFO_DPSF|Issue`, per the owner's spec: an INFO_ must report the same cost
;;the op actually charges. Template and rationale: `modules/ATS.repl <<ATS-I1>>`.
;;Collection issuance is the DPDC family's two-currency op: IGNIS for the work, STOA for the
;;collection registration (`04_DPDC-I.pact:502`). A FRESH ticker is mandatory — ids derive from the
;;ticker, so reusing MOCKS collides on insert rather than on price.
;;
;;BOTH CURRENCIES ARE ASSERTED. An IGNIS-only test passes just as happily on a preview that has lost
;;its STOA leg entirely — which is precisely the defect found in `INFO_EQUITY|IssueCompany`,
;;`INFO_SWP|ToggleFeeLock` and `INFO_ATS|ToggleParameterLock`, all three of which quoted a literal
;;zero for a currency their op really charged.
;;The managed caps sit at TRANSACTION TOP LEVEL and are written out literally — `env-sigs` from inside
;;a `let` sets signatures without INSTALLING managed caps, and a `map`-built list does not install them
;;either. Both traps are documented at `modules/ATS.repl <<ATS-I2>>`. They are sized generously rather
;;than exactly, because the point of the block is to MEASURE the charge, not to presume it.
(env-sigs
    [
        { "key": "PK_AncientHodler", "caps": [] }
        { "key": "6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263" ,
          "caps":
            [
                (coin.TRANSFER "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263" "k:50d6c59b21e5e6e55baecaa75a1007de37576bde12d8230dc82459cc01b9484b" 1000000.0)
                (coin.TRANSFER "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263" "k:0cb30c0121ff919266121a99ff9359871818932211df94dae4137c29bc0e8f7e" 1000000.0)
                (coin.TRANSFER "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263" "c:XM-pkmuB5XUQlp87ZYSbfKt8qzmHY6O2EHAzMRVBt3k" 1000000.0)
                (coin.TRANSFER "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263" "c:iQQFWj6gWtpGEzhM_O5ekW1QtnQQy55R8BRPGhj_0FU" 1000000.0)
            ]
        }
    ]
)
(let
    (
        (ref-TS02-C1:module{TalosStageTwo_ClientOneV2} TS02-C1)
        (ref-TS02-C2:module{TalosStageTwo_ClientTwoV2} TS02-C2)
        (ref-DALOS:module{OuronetDalosV2} DALOS)
        (sf:string "MOCKS-98c486052a51")
        (nf:string "MOCKN-98c486052a51")
        (patron:string KST.ANHD)
    )
    (let
        (
            (predicted:object{OuronetInfoV2.ClientInfo} (INFO-TWO.INFO_DPSF|Issue patron patron patron "CostProbeS" "CPS" true true true true true true true true))
            (ignis-before:decimal (ref-DALOS::UR_TF_AccountSupply patron false))
            (stoa-before:decimal (coin.get-balance (ref-DALOS::UR_AccountStoa patron)))
            (m (ref-TS02-C1::DPSF|C_Issue patron patron patron "CostProbeS" "CPS" true true true true true true true true))
        )
        (map print
            [
                (format "<<DPDC-I39>> IGNIS predicted={} real={} | STOA predicted={} real={}"
                    [(at "ignis-need" (at "ignis" predicted))
                     (- ignis-before (ref-DALOS::UR_TF_AccountSupply patron false))
                     (at "stoa-need" (at "stoa" predicted))
                     (- stoa-before (coin.get-balance (ref-DALOS::UR_AccountStoa patron)))])
                (expect "<<DPDC-I39>> the IGNIS quote equals the IGNIS charged"
                    (- ignis-before (ref-DALOS::UR_TF_AccountSupply patron false))
                    (at "ignis-need" (at "ignis" predicted)))
                (expect "<<DPDC-I39>> the STOA quote equals the STOA charged"
                    (- stoa-before (coin.get-balance (ref-DALOS::UR_AccountStoa patron)))
                    (at "stoa-need" (at "stoa" predicted)))
                (expect "<<DPDC-I39>> ...and the operation is NOT free"
                    true (> (+ (- ignis-before (ref-DALOS::UR_TF_AccountSupply patron false))
                               (- stoa-before (coin.get-balance (ref-DALOS::UR_AccountStoa patron)))) 0.0))
            ]
        )
    )
    ""
)
(env-sigs [])
(rollback-tx)

