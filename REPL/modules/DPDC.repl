(begin-tx "DPDC-G6 — collection existence, SFT holdings, fragmentation, and the four NFT roles")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
;;==== DPDC-G6 — collection existence, SFT holdings, fragmentation, and the four NFT roles · 01 · namespace ==== 
(print "--- [DPDC-G6 — collection existence, SFT holdings, fragmentation, and the four NFT roles · 01 · namespace] ---")
(namespace "ouronet-ns")
(print "--- [DPDC-G6 · 01 · nine directly-callable DPDC-family validators] ---")
;;P3.3. All nine are plain UEV_ functions -- no capability, no Talos shell -- driven straight
;;against the MOCKN / MOCKS fixtures this suite already mints.
;;
;;TWO PAIRS HERE SHARE WORDING INSIDE ONE MODULE, which is the case my coverage tool can credit
;;but cannot disambiguate: UEV_RoleNftRecreateON and UEV_RoleNftUpdateON emit the SAME format
;;string. Driving only one would have the tool report both as covered while one was untested.
;;Each of the four is driven separately for that reason -- and because they really are four
;;independent role fields (recreate / update / royalties / uri) read by four different
;;UR_CA|R-* readers, so a reader who assumed one test covered the family would be wrong.
;;==== DPDC-G6 — collection existence, SFT holdings, fragmentation, and the four NFT roles · 02 · let / invocation ==== 
(print "--- [DPDC-G6 — collection existence, SFT holdings, fragmentation, and the four NFT roles · 02 · let / invocation] ---")
(let
    (
        (ref-DPDC:module{DpdcV2} DPDC)
        (ref-DPDC-F:module{DpdcFragmentsV2} DPDC-F)
        (ref-DPDC-N:module{DpdcNonceV2} DPDC-N)
        (sf:string "MOCKS-98c486052a51")
        (nf:string "MOCKN-98c486052a51")
    )
    (map print
        [
            ;;--- 1] existence, both collection kinds. UEV_id dispatches on <son>, so the SFT and
            ;;    NFT answers come from two different with-default-read blocks with two different
            ;;    messages; one ghost id cannot drive both.
            (expect-failure "<<DPDC-G6>> a ghost SFT id does not exist"
                "DPSF ID" (ref-DPDC::UEV_id "ghost-sf" true))
            (expect-failure "<<DPDC-G6>> a ghost NFT id does not exist"
                "DPNF ID" (ref-DPDC::UEV_id "ghost-nf" false))
            ;;    ...and the real ones DO, so the rejections are about existence and not about the
            ;;    reader being broken for every input.
            (expect "<<DPDC-G6>> ...while both live collections pass"
                true (and (!= "" (format "{}" [(ref-DPDC::UEV_id sf true)]))
                          (!= "" (format "{}" [(ref-DPDC::UEV_id nf false)]))))
            ;;--- 2] holdings, SFT branch. DPDC-G2 already drives the NFT side of this function;
            ;;    this is the OTHER branch of its `if` -- (or son (< nonce 0)) -- which compares a
            ;;    QUANTITY rather than a holder identity, and carries its own enforce.
            (expect-failure "<<DPDC-G6>> an SFT quantity beyond the account's holding is refused"
                ;;The expected text must be a COMPLETE fixed run of the guard's format string.
                ;;"doesnt hold SFT" straddles a {} hole ("...doesnt hold {} {} Nonce..."), so it
                ;;matches the RENDERED message -- the test passes -- but the coverage tool, which
                ;;matches against the TEMPLATE, could not attribute it and reported the guard as
                ;;untested. Naming a whole run fixes attribution and drops the brittle "SFT".
                "in sufficient quantity for Operation"
                (ref-DPDC::UEV_NonceQuantityInclusion KST.ANHD sf true 1 999999999))
            ;;--- 3] fragmentation. The bound check is the FIRST thing the function does, above
            ;;    every table read, so nonce 0 reaches it with no fixture at all.
            (expect-failure "<<DPDC-G6>> nonce 0 cannot be asked whether it is fragmented"
                "Only greater than 0 nonces can be checked"
                (ref-DPDC-F::UEV_IzNonceFragmented sf true 0))
            ;;    precondition for the next case: nonce 1 is genuinely NOT fragmented, so the
            ;;    refusal below is the fragmentation rule rather than a missing row.
            (expect "<<DPDC-G6>> MOCKS nonce 1 is not fragmented"
                false (ref-DPDC-F::UEV_IzNonceFragmented sf true 1))
            (expect-failure "<<DPDC-G6>> ...so an operation requiring a fragment refuses it"
                "Nonce must be fragmented for operation"
                (ref-DPDC-F::UEV_Fragmentation sf true 1))
            ;;--- 4] the four NFT element-data roles, each against an account that lacks it.
            (expect-failure "<<DPDC-G6>> RECREATE is refused for an account without the role"
                "Element Data cannot be Updated while using the"
                (ref-DPDC-N::UEV_RoleNftRecreateON nf false KST.EMMA))
            (expect-failure "<<DPDC-G6>> UPDATE likewise (same wording, different role field)"
                "Element Data cannot be Updated while using the"
                (ref-DPDC-N::UEV_RoleNftUpdateON nf false KST.EMMA))
            (expect-failure "<<DPDC-G6>> ROYALTIES likewise"
                "Element Data Royalties cannot be Updated"
                (ref-DPDC-N::UEV_RoleModifyRoyaltiesON nf false KST.EMMA))
            (expect-failure "<<DPDC-G6>> URIs likewise"
                "Element Data URIs cannot be Updated"
                (ref-DPDC-N::UEV_RoleSetNewUriON nf false KST.EMMA))
        ]
    )
    ""
)
(commit-tx)

;;|| NEXT >
;;
(begin-tx "DPDC-G7 — the collectable-transfer amount rules")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
;;==== DPDC-G7 — the collectable-transfer amount rules · 01 · namespace ==== ======================
(print "--- [DPDC-G7 — the collectable-transfer amount rules · 01 · namespace] ---")
(namespace "ouronet-ns")
(print "--- [DPDC-G7 · 01 · UEV_AmountsForTransfer, both guards] ---")
;;P3.3. Both enforces in one plain callable UEV_, driven against the MOCKN / MOCKS fixtures.
;;
;;The second guard is the interesting one: a NATIVE NFT nonce is by definition a single indivisible
;;item, so transferring "2" of one is not a quantity error — it is a request that cannot be
;;satisfied at all, and honouring it would either double-spend the nonce or silently move one.
;;The rule is deliberately scoped to (and (not son) (> nonce 0)): semi-fungibles DO carry real
;;quantities, and fragments (negative nonces) are excluded too.
;;
;;That scoping is what the two POSITIVE cases are for. Driving only the rejection would be
;;satisfied equally well by a guard that demanded amount = 1 everywhere — which would break every
;;semi-fungible transfer in the system. The SFT case passes amount 2 through the same function and
;;asserts it is accepted.
;;==== DPDC-G7 — the collectable-transfer amount rules · 02 · let / invocation ==== ===============
(print "--- [DPDC-G7 — the collectable-transfer amount rules · 02 · let / invocation] ---")
(let
    (
        (ref-DPDC-T:module{DpdcTransferV2} DPDC-T)
        (sf:string "MOCKS-98c486052a51")
        (nf:string "MOCKN-98c486052a51")
    )
    (map print
        [
            ;;--- 1] one amount per nonce. A short amounts list would otherwise index past its end
            ;;    inside the per-element map below.
            (expect-failure "<<DPDC-G7>> two nonces against one amount is refused"
                "Invalid Nonces|Amounts Pair for Collectable Transfer"
                (ref-DPDC-T::UEV_AmountsForTransfer nf false [1 2] [1]))
            ;;--- 2] a native NFT nonce moves as exactly one item. Lists are aligned here, so the
            ;;    pairing guard above provably cannot be what answers.
            (expect-failure "<<DPDC-G7>> transferring TWO of a native NFT nonce is refused"
                "When transfering Native NFT Nonces, their amount must be 1"
                (ref-DPDC-T::UEV_AmountsForTransfer nf false [1] [2]))
            ;;--- and the two cases the scoping exists for.
            (expect "<<DPDC-G7>> ...while amount 1 on the same NFT nonce is accepted"
                true (!= "" (format "{}" [(ref-DPDC-T::UEV_AmountsForTransfer nf false [1] [1])])))
            (expect "<<DPDC-G7>> ...and a SEMI-fungible may move a quantity of 2"
                true (!= "" (format "{}" [(ref-DPDC-T::UEV_AmountsForTransfer sf true [1] [2])])))
        ]
    )
    ""
)
(commit-tx)

;;|| NEXT >
;;
(begin-tx "DPDC-G8 -- the SFT creation argument guards")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(namespace "ouronet-ns")
;;==== DPDC-G8 -- the SFT creation argument guards · 01 · env-sigs (caps) ==== ====================
(print "--- [DPDC-G8 -- the SFT creation argument guards · 01 · env-sigs (caps)] ---")
(env-sigs [{ "key": "PK_AncientHodler", "caps": [] }])
(print "--- [DPDC-G8 . 01 . amount domain and list parity] ---")
;;Two UNPINNED guards in DPDC-C|C>REGISTER-NONCES, both reached through DPSF|C_Create.
;;
;;WHICH OF THAT CAP'S FOUR GUARDS ARE REACHABLE AT ALL is the interesting part, and it depends on
;;the CLIENT, not on the cap:
;;  * via DPNF|C_Create (the NFT path) neither the amount guard nor the parity guard can fire --
;;    that client hardcodes `amount` to 1 and derives both list lengths from the SAME list
;;    (`(make-list l 1)`), so "amount must equal 1" and "l1 = l2" are satisfied by construction.
;;    Defensive there, not testable.
;;  * via DPSF|C_Create (the SFT path) the caller supplies `amount` directly and the two lists
;;    independently -- so both guards become reachable. That is what is pinned here.
;;A guard's reachability is a property of the call sites, not of the guard.
;;==== DPDC-G8 -- the SFT creation argument guards · 02 · let / invocation ==== ===================
(print "--- [DPDC-G8 -- the SFT creation argument guards · 02 · let / invocation] ---")
(let ((sf:string "MOCKS-98c486052a51")
      (nd:object{DpdcUdcV2.DPDC|NonceData} (DPDC-UDC.UDC_NonceData 0.0 0.0 "n" "d"
          (DPDC-UDC.UDC_NoMetaData)
          (DPDC-UDC.UDC_URI|Type true false false false false false false)
          (DPDC-UDC.UDC_URI|Data "ipfs://a" "" "" "" "" "" "")
          (DPDC-UDC.UDC_ZeroURI|Data) (DPDC-UDC.UDC_ZeroURI|Data))))
    (map print
        [
            ;;a negative supply is refused. The bound is >= 0 rather than > 0 because an SFT nonce
            ;;may legitimately be created empty and minted into later.
            (expect-failure "<<DPDC-G8>> an SFT nonce cannot be created with a NEGATIVE amount"
                "For an SFT Collectable the -1 must be greater or equal to 0"
                (TS02-C1.DPSF|C_Create KST.ANHD (DPDC.UR_Verum5 sf true) sf [-1] [nd]))
            ;;and the two caller-supplied lists must agree in length: three amounts against two
            ;;nonce-datas would otherwise register nonces the caller never described
            (expect-failure "<<DPDC-G8>> amounts and nonce-datas must be the same length"
                "Incompatible Input Data for Registering multiple Nonces"
                (TS02-C1.DPSF|C_Create KST.ANHD (DPDC.UR_Verum5 sf true) sf [10 10 10] [nd nd]))
        ]
    )
)
(commit-tx)

;;|| NEXT >
