(begin-tx "DPDC-G8b -- ...and a well-formed create still works")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(namespace "ouronet-ns")
;;==== DPDC-G8b -- ...and a well-formed create still works · 01 · env-sigs (caps) ==== ============
(print "--- [DPDC-G8b -- ...and a well-formed create still works · 01 · env-sigs (caps)] ---")
(env-sigs [{ "key": "PK_AncientHodler", "caps": [] }])
(print "--- [DPDC-G8b . 01 . the contrast] ---")
;;Without this, the two rejections above would pass just as well against a create path that was
;;broken outright. Matching lengths and a non-negative amount go through.
(let* ((sf:string "MOCKS-98c486052a51")
       (before:integer (DPDC.UR_NoncesUsed sf true))
       (nd:object{DpdcUdcV2.DPDC|NonceData} (DPDC-UDC.UDC_NonceData 0.0 0.0 "n" "d"
          (DPDC-UDC.UDC_NoMetaData)
          (DPDC-UDC.UDC_URI|Type true false false false false false false)
          (DPDC-UDC.UDC_URI|Data "ipfs://a" "" "" "" "" "" "")
          (DPDC-UDC.UDC_ZeroURI|Data) (DPDC-UDC.UDC_ZeroURI|Data))))
    (TS02-C1.DPSF|C_Create KST.ANHD (DPDC.UR_Verum5 sf true) sf [7] [nd])
    (map print
        [
            (expect "<<DPDC-G8>> a well-formed SFT create adds exactly one nonce"
                (+ before 1) (DPDC.UR_NoncesUsed sf true))
        ]
    )
)
(commit-tx)

