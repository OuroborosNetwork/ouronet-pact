(begin-tx "DPDC-06 — DPSF|C_UpdateNonce: the SFT whole-object writer")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(namespace "ouronet-ns")
(print "--- [DPDC-06 · 01 · SFT whole-object nonce write] ---")
(env-sigs [{ "key": "PK_AncientHodler", "caps": [] }])
;;Previously invoked by NOTHING (ledger G1 gap). Tested here rather than in a separate SFT
;;tester because it operates on the SAME shared collectable core and the SAME mock fixture --
;;the DPNF counterpart is asserted in modules/DPNF.repl (DPNF-04).
(let
    (
        (ref-DPDC:module{DpdcV2} DPDC)
        (ref-DPDC-UDC:module{DpdcUdcV2} DPDC-UDC)
        (ref-TS02-C1:module{TalosStageTwo_ClientOneV2} TS02-C1)
        (sf:string "MOCKS-98c486052a51")
        (patron:string KST.ANHD)
    )
    (let
        (
            (type:object{DpdcUdcV2.URI|Type}
                (ref-DPDC-UDC::UDC_URI|Type true false false false false false false))
        )
        (let
            (
                (nd:object{DpdcUdcV2.DPDC|NonceData}
                    (ref-DPDC-UDC::UDC_NonceData 9.0 8.0 "SftWholeWrite" "sft object write"
                        (ref-DPDC-UDC::UDC_MetaData { "sft": "yes" }) type
                        (ref-DPDC-UDC::UDC_ZeroURI|Data) (ref-DPDC-UDC::UDC_ZeroURI|Data)
                        (ref-DPDC-UDC::UDC_ZeroURI|Data)))
            )
            (ref-TS02-C1::DPSF|C_UpdateNonce patron sf patron 3 true nd)
            (let ((got:object{DpdcUdcV2.DPDC|NonceData} (ref-DPDC::UR_NonceData sf true 3)))
                (map print
                    [
                        (expect "<<DPDC-06>> DPSF|C_UpdateNonce wrote the name"
                            "SftWholeWrite" (at "name" got))
                        (expect "<<DPDC-06>> DPSF|C_UpdateNonce wrote the royalty"
                            9.0 (at "royalty" got))
                        (expect "<<DPDC-06>> DPSF|C_UpdateNonce wrote the ignis royalty"
                            8.0 (at "ignis" got))
                        ;;The NFT collection must be untouched -- its nonce 2 is still at the
                        ;;fixture default "M". (Each tester is its OWN process with its own DB, so
                        ;;this cannot borrow state from modules/DPNF.repl, which writes that nonce.)
                        (expect "<<DPDC-06>> the SFT write did not touch the NFT collection"
                            "M" (at "name" (ref-DPDC::UR_NonceData "MOCKN-98c486052a51" false 2)))
                        (expect "<<DPDC-06>> the SFT nonce still carries its supply after a metadata write"
                            10 (ref-DPDC::UR_NonceSupply sf true 3))
                    ]
                )
            )
        )
    )
    ""
)
(commit-tx)

;;|| NEXT >
;;
(begin-tx "DPDC-07 — the four bulk wipes: Clean is strict, Dirty filters")
(env-gasmodel "table")(env-gaslimit 100000000)(env-gas 0)
(namespace "ouronet-ns")
(print "--- [DPDC-07 · 01 · stage a holder with three nonces, then freeze] ---")
;;The four bulk wipes (C_WipeClean / C_WipeDirty / C_WipePure / C_WipeHeavy) were invoked by
;;NOTHING. They are the most destructive ops on the collectable surface -- they delete a
;;holder's entire position -- and the ONLY prior wipe coverage was DPSF|C_WipeNonce in
;;[6.1]_DPDC, inside a transaction block that asserts nothing at all (pure `format` echoes).
;;
;;The four differ only in HOW the nonce set is chosen, which is exactly what makes them easy to
;;confuse and worth a differential test rather than four separate happy paths:
;;
;;   C_WipeHeavy  discovers the set itself with select/keys  (expensive; small sets only)
;;   C_WipePure   takes a pre-read RemovableNonces object    (URHC_WipePure, dirty read)
;;   C_WipeClean  takes a nonce LIST -- STRICT: "Fails if a single nonce is not viable"
;;   C_WipeDirty  takes a nonce LIST -- LENIENT: filters to the viable ones first
;;
;;Clean and Dirty have IDENTICAL signatures and differ only in that strictness. Handed the same
;;list containing one non-viable nonce they must diverge, and that divergence is the test.
(env-sigs [{ "key": "PK_AncientHodler", "caps": [] }])
(let
    (
        (ref-DPDC:module{DpdcV2} DPDC)
        (ref-TS02-C1:module{TalosStageTwo_ClientOneV2} TS02-C1)
        (sf:string "MOCKS-98c486052a51")
        (patron:string KST.ANHD)
        (emma:string KST.EMMA)
    )
    ;;EMMA already holds nonce 1 (from DPDC-03) and nonce 2 (from DPDC-04) and NOT nonce 3.
    ;;That is deliberate: nonce 3 EXISTS on the collection but is not viable FOR HER, which is
    ;;precisely the case Clean and Dirty are supposed to treat differently.
    ;;Wiping REQUIRES the holder to be frozen on that collection (DPDC-MNG|C>WIPE-SFT ->
    ;;UEV_AccountFreezeState ... true). That is the design: a wipe is an enforcement action
    ;;against an already-restrained account, never a surprise on a live one.
    (ref-TS02-C1::DPSF|C_ToggleFreezeAccount patron sf emma true)
    (map print
        [
            (expect "<<DPDC-07>> the holder has nonce 1" 4 (ref-DPDC::UR_AccountNonceSupply emma sf true 1))
            (expect "<<DPDC-07>> the holder has nonce 2" 3 (ref-DPDC::UR_AccountNonceSupply emma sf true 2))
            ;;-1 is DPDC's "holds none" sentinel. Nonce 3 exists on the collection (the owner
            ;;holds it) but this holder has none -- the non-viable-for-her case.
            (expect "<<DPDC-07>> the holder does NOT have nonce 3, though it exists"
                -1 (ref-DPDC::UR_AccountNonceSupply emma sf true 3))
            (expect "<<DPDC-07>> ...and nonce 3 really does exist on the collection"
                true (> (ref-DPDC::UR_NonceSupply sf true 3) 0))
            (expect "<<DPDC-07>> and the holder is frozen, which the wipe cap requires"
                true (ref-DPDC::UR_CA|R-Frozen sf true emma))
        ]
    )
    ""
)
(commit-tx)

;;|| NEXT >
;;
(begin-tx "DPDC-07b — WipeClean rejects a list containing a nonce the holder does not have")
(env-gasmodel "table")(env-gaslimit 100000000)(env-gas 0)
(namespace "ouronet-ns")
(print "--- [DPDC-07b · 01 · Clean is strict] ---")
(env-sigs [{ "key": "PK_AncientHodler", "caps": [] }])
;;Nonce 3 exists but this holder has none of it, so it is NOT VIABLE for her. Clean must refuse
;;the WHOLE call rather than wipe the one good nonce -- all-or-nothing.
;;
;;The message is worth reading: strictness is not implemented as a "not viable" guard. Clean
;;builds its amounts from UR_AccountNoncesSupplies, which returns the -1 "holds none" sentinel
;;for nonce 3, and the refusal happens downstream when the debit rejects an amount of -1. So the
;;strictness is REAL but emergent, and the message names the amount rather than the concept.
(let
    (
        (ref-TS02-C1:module{TalosStageTwo_ClientOneV2} TS02-C1)
        (sf:string "MOCKS-98c486052a51")
    )
    (map print
        [
            (expect-failure "<<DPDC-07b>> WipeClean refuses a list with one non-viable nonce"
                "is invalid for Debiting Nonce 3"
                (ref-TS02-C1::DPSF|C_WipeClean KST.ANHD KST.EMMA sf [1 3]))
        ]
    )
    ""
)
(env-sigs [])
;;RULE 9: the rejection is inside the cap chain, before any write. Proven, not assumed --
;;this is a DESTRUCTIVE op, so "it aborted" is not enough; the position must be intact.
(rollback-tx)

;;|| NEXT >
;;
(begin-tx "DPDC-07c — the strict refusal wiped NOTHING, and Dirty then filters the same list")
(env-gasmodel "table")(env-gaslimit 100000000)(env-gas 0)
(namespace "ouronet-ns")
(print "--- [DPDC-07c · 01 · nothing was lost, then Dirty proceeds] ---")
(env-sigs [{ "key": "PK_AncientHodler", "caps": [] }])
(let
    (
        (ref-DPDC:module{DpdcV2} DPDC)
        (ref-TS02-C1:module{TalosStageTwo_ClientOneV2} TS02-C1)
        (sf:string "MOCKS-98c486052a51")
        (emma:string KST.EMMA)
    )
    (let
        (
            (tot1-before:integer (ref-DPDC::UR_NonceSupply sf true 1))
        )
        (map print
            [
                ;;All three legs survive the refused Clean -- all-or-nothing really is all-or-nothing.
                (expect "<<DPDC-07c>> the refused WipeClean left nonce 1 intact"
                    4 (ref-DPDC::UR_AccountNonceSupply emma sf true 1))
                (expect "<<DPDC-07c>> ...nonce 2 intact" 3 (ref-DPDC::UR_AccountNonceSupply emma sf true 2))
                (expect "<<DPDC-07c>> ...and she still holds none of nonce 3"
                    -1 (ref-DPDC::UR_AccountNonceSupply emma sf true 3))
            ]
        )
        ;;THE DIVERGENCE. Identical signature, identical arguments, opposite outcome: Dirty
        ;;filters [1 3] down to [1] and proceeds.
        (ref-TS02-C1::DPSF|C_WipeDirty KST.ANHD emma sf [1 3])
        (map print
            [
                ;;NOTE THE VALUE: a wiped holding reads 0, NOT the -1 "never held" sentinel
                ;;asserted in DPDC-04 and DPDC-07. The two are different states and DPDC keeps
                ;;them apart: -1 means no row was ever written for this (account, nonce), 0 means
                ;;a row exists and is empty. A wipe therefore leaves a RESIDUE ROW behind rather
                ;;than deleting the holding outright -- worth knowing for anyone auditing whether
                ;;a wiped account is distinguishable from one that never held the asset. It is.
                (expect "<<DPDC-07c>> WipeDirty accepted the SAME list Clean refused, emptying the viable nonce"
                    0 (ref-DPDC::UR_AccountNonceSupply emma sf true 1))
                (expect "<<DPDC-07c>> a WIPED holding (0) is distinguishable from a never-held one (-1)"
                    false (= (ref-DPDC::UR_AccountNonceSupply emma sf true 1)
                             (ref-DPDC::UR_AccountNonceSupply emma sf true 3)))
                ;;A wipe DESTROYS supply -- it is not a transfer. The collection total must drop
                ;;by exactly what the holder had, or the wipe is silently minting somewhere.
                (expect "<<DPDC-07c>> the wipe DESTROYED the supply (total dropped by the holding)"
                    (- tot1-before 4) (ref-DPDC::UR_NonceSupply sf true 1))
                ;;...and touched nothing it was not asked to.
                (expect "<<DPDC-07c>> the non-listed nonce 2 is untouched"
                    3 (ref-DPDC::UR_AccountNonceSupply emma sf true 2))
                ;;And the filtered-out nonce 3 was neither wiped from her (she had none) nor
                ;;from the collection -- Dirty dropped it, it did not act on it.
                (expect "<<DPDC-07c>> the filtered-out nonce 3 is untouched on the collection"
                    10 (ref-DPDC::UR_NonceSupply sf true 3))
            ]
        )
    )
    ""
)
(commit-tx)

;;|| NEXT >
;;
(begin-tx "DPDC-08 — WipePure takes a dirty read; WipeHeavy finds the same set itself")
(env-gasmodel "table")(env-gaslimit 100000000)(env-gas 0)
(namespace "ouronet-ns")
(print "--- [DPDC-08 · 01 · Pure and Heavy agree on the set] ---")
(env-sigs [{ "key": "PK_AncientHodler", "caps": [] }])
;;Pure and Heavy are the same wipe reached two ways: Heavy runs the expensive select/keys scan
;;on-chain, Pure takes the SAME set pre-read off-chain via URHC_WipePure. That equivalence is
;;the contract -- a client that dirty-reads and submits Pure must get exactly what Heavy would
;;have done -- so it is asserted directly rather than testing each in isolation.
(let
    (
        (ref-DPDC:module{DpdcV2} DPDC)
        (ref-DPDC-MNG:module{DpdcManagementV2} DPDC-MNG)
        (ref-TS02-C1:module{TalosStageTwo_ClientOneV2} TS02-C1)
        (sf:string "MOCKS-98c486052a51")
        (emma:string KST.EMMA)
    )
    (let
        (
            (plan:object{DpdcManagementV2.RemovableNonces} (ref-DPDC-MNG::URHC_WipePure emma sf true))
        )
        (map print
            [
                ;;The dirty read sees exactly the two nonces left after DPDC-07c, and their
                ;;amounts -- so the object a client would sign is provably the real position.
                (expect "<<DPDC-08>> the dirty read finds the one remaining nonce"
                    [2] (at "r-nonces" plan))
                (expect "<<DPDC-08>> ...with its true amount"
                    [3] (at "r-amounts" plan))
            ]
        )
        ;;Stage a SECOND nonce so Pure and Heavy each get one. The holder is frozen, and a
        ;;frozen account cannot receive -- so unfreeze, transfer, refreeze. That round trip is
        ;;itself worth doing here: it proves the freeze is a real gate on the RECEIVE path and
        ;;not just on the wipe path.
        (ref-TS02-C1::DPSF|C_ToggleFreezeAccount KST.ANHD sf emma false)
        (ref-TS02-C1::DPSF|C_TransferNonce KST.ANHD sf KST.ANHD emma 3 5 false)
        (ref-TS02-C1::DPSF|C_ToggleFreezeAccount KST.ANHD sf emma true)
        (map print
            [
                (expect "<<DPDC-08>> the holder received the second nonce while unfrozen"
                    5 (ref-DPDC::UR_AccountNonceSupply emma sf true 3))
                (expect "<<DPDC-08>> ...and is frozen again, so the wipes can proceed"
                    true (ref-DPDC::UR_CA|R-Frozen sf true emma))
                (expect "<<DPDC-08>> the dirty read now sees BOTH nonces"
                    [2 3] (at "r-nonces" (ref-DPDC-MNG::URHC_WipePure emma sf true)))
            ]
        )
        ;;PURE: wipe exactly what the supplied object names, and nothing else. The object is
        ;;hand-narrowed to ONE of the two nonces, so if Pure re-derived the full set itself
        ;;(i.e. behaved like Heavy) this would wipe both and the next assertion would fail.
        (let ((tot3:integer (ref-DPDC::UR_NonceSupply sf true 3)))
            (ref-TS02-C1::DPSF|C_WipePure KST.ANHD emma sf
                (ref-DPDC-MNG::UDC_RemovableNonces [3] [5]))
            (map print
                [
                    (expect "<<DPDC-08>> Pure wiped exactly the nonce named in the object"
                        0 (ref-DPDC::UR_AccountNonceSupply emma sf true 3))
                    (expect "<<DPDC-08>> Pure did NOT touch the nonce it was not given"
                        3 (ref-DPDC::UR_AccountNonceSupply emma sf true 2))
                    (expect "<<DPDC-08>> Pure destroyed the supply it wiped"
                        (- tot3 5) (ref-DPDC::UR_NonceSupply sf true 3))
                ]
            )
        )
        ;;Heavy, with no set supplied at all: it must find the remainder on its own and reach
        ;;the same conclusion the dirty read did.
        (let ((tot2:integer (ref-DPDC::UR_NonceSupply sf true 2)))
            (ref-TS02-C1::DPSF|C_WipeHeavy KST.ANHD emma sf)
            (map print
                [
                    (expect "<<DPDC-08>> Heavy discovered and wiped the remaining nonce unaided"
                        0 (ref-DPDC::UR_AccountNonceSupply emma sf true 2))
                    (expect "<<DPDC-08>> Heavy DESTROYED the supply it wiped"
                        (- tot2 3) (ref-DPDC::UR_NonceSupply sf true 2))
                    ;;The position is now empty, and the dirty read agrees -- the two views of
                    ;;"what does this holder still have" cannot disagree after a full wipe.
                    (expect "<<DPDC-08>> the holder's position is empty"
                        [] (at "r-nonces" (ref-DPDC-MNG::URHC_WipePure emma sf true)))
                ]
            )
        )
    )
    ""
)
(commit-tx)
