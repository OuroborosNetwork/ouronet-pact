(begin-tx "DPDC-I43 — INFO_DPSF|ToggleExemptionRole: the SMART-account-only role, finally executed")
(env-gasmodel "table")(env-gaslimit 100000000)(env-gas 0)
(namespace "ouronet-ns")
(print "--- [DPDC-I43 · 01 · grant the royalty-exemption role] ---")
;;FUNCTION COVERAGE (G6) — `INFO_DPSF|ToggleExemptionRole`, per the owner's spec. Template: `modules/ATS.repl <<ATS-I1>>`.
;;
;;THIS OP HAD NEVER SUCCEEDED IN THIS HARNESS. `<<DPDC-G13>>` pins the refusal — "Only Smart Ouronet
;;Accounts can get this role" — using ANHD, and asserts ANHD is standard. Nothing then supplied a
;;smart one, so the accept arm and its price stayed unreached. It is the same shape as
;;`DPTF|C_ToggleFeeExemptionRole`, whose accept arm was likewise unbuilt until `modules/DPTF.repl`
;;found the fixture: the role is for SMART accounts because a standard account has no mechanism to
;;disburse what it would accumulate.
;;
;;`KC.BJ` is the ONE user-deployed smart DALOS account in the boot chain (`[2.1]_Dalos.repl:192`).
;;The eight protocol smart-contract accounts would fail a different guard, so it is not
;;interchangeable with, say, the SWP or ATS system accounts.
;;
;;BJ SIGNS ONLY BECAUSE OF `XB_DeployAccountWNE`. The role cap itself checks the target's TYPE and the
;;collection owner's signature, not the target's authority; the account-deploy leg that runs on the
;;first-ever touch of a (collection, account) pair is what enforces ownership of the target.
(env-sigs [{ "key": "PK_AncientHodler", "caps": [] } { "key": "PK_BJ", "caps": [] }])
(let
    (
        (ref-TS02-C1:module{TalosStageTwo_ClientOneV2} TS02-C1)
        (ref-DALOS:module{OuronetDalosV2} DALOS)
        (ref-DPDC:module{DpdcV2} DPDC)
        (id:string "MOCKS-98c486052a51")
        (patron:string KST.ANHD)
        (bj:string KC.BJ)
    )
    (let
        (
            (predicted:object{OuronetInfoV2.ClientInfo} (INFO-TWO.INFO_DPSF|ToggleExemptionRole patron id bj true))
            (ignis-before:decimal (ref-DALOS::UR_TF_AccountSupply patron false))
            (m (ref-TS02-C1::DPSF|C_ToggleExemptionRole patron (DPDC.UR_OwnerKonto id true) bj id true))
        )
        (map print
            [
                ;;the precondition <<DPDC-G13>> could not satisfy, asserted rather than assumed
                (expect "<<DPDC-I43>> the target really IS a smart account, unlike <<DPDC-G13>>'s ANHD"
                    true (ref-DALOS::UR_AccountType bj))
                (format "<<DPDC-I43>> predicted={} real={}"
                    [(at "ignis-need" (at "ignis" predicted))
                     (- ignis-before (ref-DALOS::UR_TF_AccountSupply patron false))])
                (expect "<<DPDC-I43>> INFO_DPSF|ToggleExemptionRole's quote equals what the op actually charged"
                    (- ignis-before (ref-DALOS::UR_TF_AccountSupply patron false))
                    (at "ignis-need" (at "ignis" predicted)))
                (expect "<<DPDC-I43>> ...and it is a real, non-zero charge"
                    true (> (- ignis-before (ref-DALOS::UR_TF_AccountSupply patron false)) 0.0))
            ]
        )
    )
    ""
)
(env-sigs [])
(rollback-tx)

