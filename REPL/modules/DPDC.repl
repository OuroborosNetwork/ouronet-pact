(begin-tx "DPDC-09 — UEV_Nonce: guard was shadowed by its own reader — NOW FIXED")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
;;==== DPDC-09 — UEV_Nonce: guard was shadowed by its own reader — NOW FIXED · 01 · namespace ==== 
(print "--- [DPDC-09 — UEV_Nonce: guard was shadowed by its own reader — NOW FIXED · 01 · namespace] ---")
(namespace "ouronet-ns")
(print "--- [DPDC-09 · 01 · the nonce validator] ---")
;;Flagged by REPL/tools/_shadowed.py, which looks for a guard whose VALIDATED ARGUMENT is also part of
;;the KEY of a hard read running before it. UEV_Nonce is the shape exactly:
;;
;;    (let ((an (abs nonce))
;;          (nv (UR_NonceValue id son an))          ;; HARD: UR_NonceElement -> (read ...)
;;          (nu (UR_NoncesUsed id son)))
;;      (enforce (fold (and) true [(!= an 0) (<= an nu) (= an nv)]) "Invalid Nonce Value"))
;;
;;All three predicates existed to reject a nonce that is out of range or zero -- and for exactly
;;those inputs UR_NonceValue had already aborted on the missing row, so "Invalid Nonce Value" was
;;unreachable text for EVERY input.
;;
;;FIXED 2026-09-10, exactly as the last assertion in this block predicted: <nu> comes from
;;UR_NoncesUsed, which is a plain count needing no nonce row, so the two INPUT predicates now run
;;BEFORE the keyed read. The third (= an nv) stays after it as a data-integrity assertion. The
;;message is unchanged on every path -- only its REACHABILITY changed.
;;
;;These assertions are therefore now the regression pin for the FIX, not for the finding: if the
;;guard is ever pushed back below the read, both flip back to "No value found in table".
;;==== DPDC-09 — UEV_Nonce: guard was shadowed by its own reader — NOW FIXED · 02 · let / invocation ==== 
(print "--- [DPDC-09 — UEV_Nonce: guard was shadowed by its own reader — NOW FIXED · 02 · let / invocation] ---")
(let
    (
        (ref-DPDC:module{DpdcV2} DPDC)
        (sf:string "MOCKS-98c486052a51")
    )
    (map print
        [
            ;;the guard IS satisfied by a real nonce -- so the rejections below are about
            ;;reachability, not about the fixture being wrong.
            (expect "<<DPDC-09>> a real nonce passes UEV_Nonce"
                true (!= "" (format "{}" [(ref-DPDC::UEV_Nonce sf true 1)])))
            (expect-failure "<<DPDC-09>> FIXED: nonce 0 is now rejected BY THE GUARD (!= an 0), not by the table read"
                "Invalid Nonce Value" (ref-DPDC::UEV_Nonce sf true 0))
            (expect-failure "<<DPDC-09>> FIXED: an out-of-range nonce is now rejected by (<= an nu)"
                "Invalid Nonce Value" (ref-DPDC::UEV_Nonce sf true 9999))
            ;;The reader that WOULD have made the guard reachable already exists next door:
            ;;UR_NoncesUsed is a plain count and answers for any id without touching the nonce
            ;;row. Reading the bound first and the row second is the one-line fix.
            (expect "<<DPDC-09>> the reader that would fix it needs no nonce row at all"
                3 (ref-DPDC::UR_NoncesUsed sf true))
        ]
    )
    ""
)
(commit-tx)

;;|| NEXT >
