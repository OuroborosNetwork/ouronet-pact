(env-sigs [{ "key": "PK_Emma", "caps": [] }])
(map print
    [
        (expect-failure "<<DPDC-G5b>> a batch NFT credit carrying an amount of 2 is refused"
            "Invalid Amounts for NFT Crediting"
            (test-capability (DPDC-C.DPNF|C>CREDIT-NONCES "a" [1] [2])))
    ]
)
