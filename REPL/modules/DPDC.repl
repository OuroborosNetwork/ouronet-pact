(begin-tx "DPDC-G3 — property guards that DPDC can only reach with a purpose-issued collection")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
;;==== DPDC-G3 — property guards that DPDC can only reach with a purpose-issued collection · 01 · namespace ==== 
(print "--- [DPDC-G3 — property guards that DPDC can only reach with a purpose-issued collection · 01 · namespace] ---")
(namespace "ouronet-ns")
(print "--- [DPDC-G3 · 01 · can-pause / can-add-special-role / can-wipe] ---")
;;P3.3. Three guards of the shape (let ((x:bool (UR_CanX id son))) (enforce x "...")) -- no
;;boolean argument to vary, so the only route to the rejection is a collection whose flag is off.
;;
;;DPDC differs from DPTF and DPOF here and it decides the technique: there is NO Control
;;operation on a collection. Its property flags are fixed AT ISSUANCE and never change, so a
;;reversible window on MOCKS is impossible -- there is nothing to flip. ADVC is issued with these
;;three flags off for exactly this, and MOCKS supplies the accepting side.
;;==== DPDC-G3 — property guards that DPDC can only reach with a purpose-issued collection · 02 · let / invocation ==== 
(print "--- [DPDC-G3 — property guards that DPDC can only reach with a purpose-issued collection · 02 · let / invocation] ---")
(let
    (
        (ref-DPDC:module{DpdcV2} DPDC)
        (locked:string "ADVC-98c486052a51")
        (open:string "MOCKS-98c486052a51")
    )
    (map print
        [
            ;;preconditions -- the two collections must really be on opposite sides
            (expect "<<DPDC-G3>> MOCKS has all three flags ON"
                true (and (ref-DPDC::UR_CanPause open true)
                          (and (ref-DPDC::UR_CanAddSpecialRole open true)
                               (ref-DPDC::UR_CanWipe open true))))
            ;;accepting side
            (expect "<<DPDC-G3>> all three guards accept a permissive collection"
                true (!= "" (format "{}{}{}"
                    [(ref-DPDC::UEV_CanPauseON open true)
                     (ref-DPDC::UEV_CanAddSpecialRoleON open true)
                     (ref-DPDC::UEV_CanWipeON open true)])))
            ;;rejecting side -- unreachable without a collection issued with the flags off
            (expect-failure "<<DPDC-G3>> UEV_CanPauseON rejects a collection that cannot be paused"
                "cannot be paused" (ref-DPDC::UEV_CanPauseON locked true))
            (expect-failure "<<DPDC-G3>> UEV_CanAddSpecialRoleON rejects one that forbids special roles"
                "no special roles can be added" (ref-DPDC::UEV_CanAddSpecialRoleON locked true))
            (expect-failure "<<DPDC-G3>> UEV_CanWipeON rejects one that cannot be wiped"
                "cannot be wiped" (ref-DPDC::UEV_CanWipeON locked true))
        ]
    )
    ""
)
(commit-tx)

;;|| NEXT >
;;
(begin-tx "DPDC-G4 — the DPDC-C input-shape family: nonce SIGN carries meaning here")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
;;==== DPDC-G4 — the DPDC-C input-shape family: nonce SIGN carries meaning here · 01 · namespace ==== 
(print "--- [DPDC-G4 — the DPDC-C input-shape family: nonce SIGN carries meaning here · 01 · namespace] ---")
(namespace "ouronet-ns")
(print "--- [DPDC-G4 · 01 · nonce sign, hybrid split, amount floor] ---")
;;DPDC encodes a nonce's KIND in its sign: positive nonces are native collectables, negative
;;nonces are fragments of one. That convention is load-bearing and invisible -- nothing in the
;;type system distinguishes -5 from 5 -- so a family of validators exists purely to keep callers
;;from crossing the two, and every one of them is pure argument checking.
;;
;;UEV_NonceType is the 2x2 shape: it takes the expected KIND as its second argument
;;(fragments-or-native), so a single-cell test would pass against a validator that ignored that
;;argument entirely and always demanded one sign. All four cells are asserted -- each sign
;;accepted under its own flag and refused under the other.
;;==== DPDC-G4 — the DPDC-C input-shape family: nonce SIGN carries meaning here · 02 · let / invocation ==== 
(print "--- [DPDC-G4 — the DPDC-C input-shape family: nonce SIGN carries meaning here · 02 · let / invocation] ---")
(let
    (
        (ref-DPDC-C:module{DpdcCreateV2} DPDC-C)
        (ref-UDC:module{DpdcUdcV2} DPDC-UDC)
    )
    (map print
        [
            ;;--- the 2x2. Cells 1 and 3 are the acceptances; without them the two rejections
            ;;below are equally satisfied by a validator that refuses every input.
            (expect "<<DPDC-G4>> a NEGATIVE nonce is accepted as a fragment"
                true (ref-DPDC-C::UEV_NonceType -5 true))
            (expect "<<DPDC-G4>> a POSITIVE nonce is accepted as a native collectable"
                true (ref-DPDC-C::UEV_NonceType 5 false))
            (expect-failure "<<DPDC-G4>> ...but a positive nonce is refused where a fragment is required"
                "Only Negative Nonces Allowed for Operation"
                (ref-DPDC-C::UEV_NonceType 5 true))
            (expect-failure "<<DPDC-G4>> ...and a negative nonce refused where a native one is required"
                "Only Positive Nonces Allowed for Operation"
                (ref-DPDC-C::UEV_NonceType -5 false))
            ;;--- UEV_HybridNonces demands BOTH kinds present, which is the opposite demand from
            ;;the pair above and is easy to get backwards. It also RETURNS the split, so the
            ;;happy case asserts the partition itself rather than merely "it did not throw" -- a
            ;;validator that returned the two buckets swapped would pass a length-only check.
            (expect "<<DPDC-G4>> a mixed list is split into its negative and positive halves"
                {"negative": [-1], "positive": [2]}
                (ref-DPDC-C::UEV_HybridNonces [-1 2]))
            (expect-failure "<<DPDC-G4>> an all-POSITIVE list is not hybrid"
                "are invalid Hybrid Nonces"
                (ref-DPDC-C::UEV_HybridNonces [1 2]))
            (expect-failure "<<DPDC-G4>> ...and neither is an all-NEGATIVE one"
                "are invalid Hybrid Nonces"
                (ref-DPDC-C::UEV_HybridNonces [-1 -2]))
            ;;--- the amount floor. Its @doc is explicit that ZERO is legal (a nonce created with
            ;;zero genesis supply, as EQUITY's tier nonces are) and that negative is never legal
            ;;because it would invert the credit/debit direction downstream. Both halves of that
            ;;statement are pinned, since a naive (> amount 0) would look equally correct here
            ;;and would break every zero-supply nonce creation.
            (expect "<<DPDC-G4>> ZERO is a legal amount — zero-supply nonces are a real case"
                true (DPDC-C.UEV_Amount 0))
            (expect-failure "<<DPDC-G4>> ...while a negative amount, which would invert a debit, is not"
                "Amount cannot be negative"
                (DPDC-C.UEV_Amount -1))
            ;;--- and the empty-object guard: nonce creation refuses the zero-value NonceData
            ;;constructor, which is the shape a caller gets by forgetting to fill anything in.
            (expect-failure "<<DPDC-G4>> the all-zero NonceData object is refused for creation"
                "Incorrect Fragmentation Data"
                (ref-DPDC-C::UEV_NonceDataForCreation (ref-UDC::UDC_ZeroNonceData)))
        ]
    )
    ""
)
(commit-tx)

