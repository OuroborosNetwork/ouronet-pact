(begin-tx "DPNF-I39 — INFO_DPNF|MergeFragments quote vs measured charge")
(env-gasmodel "table")(env-gaslimit 100000000)(env-gas 0)
(namespace "ouronet-ns")
(print "--- [DPNF-I39 · 01 · reassemble a fragmented NFT nonce] ---")
;;FUNCTION COVERAGE (G6) — `INFO_DPNF|MergeFragments`, per the owner's spec. Template: `modules/ATS.repl <<ATS-I1>>`.
;;THE FRAGMENT NONCE IS THE NEGATION OF THE NATIVE ONE. Fragmenting MOCKN nonce 2 produces holdings
;;on nonce -2, not -1; `[6.1.4]_DPDC-NF.repl` uses -1 only because it fragments nonce 1. Copying
;;that -1 across gives "doesnt hold NFT ... Nonce -1 in sufficient quantity", which reads like a
;;funding problem rather than a wrong index — and on MOCKN nonce -1 is a DECOMMISSIONED row whose
;;supply reads -1, so the arithmetic even looks plausible.
;;The 1000 is a HARDCODED protocol constant, not a per-collection property: `09_DPDC-F.pact:263`
;;enforces "Only multiple of 1000 can be used for Merging". It is asserted below rather than
;;trusted, so a change to that constant fails here instead of somewhere downstream.
(env-sigs [{ "key": "PK_AncientHodler", "caps": [] }])
(let
    (
        (ref-TS02-C1:module{TalosStageTwo_ClientOneV2} TS02-C1)
        (ref-TS02-C2:module{TalosStageTwo_ClientTwoV2} TS02-C2)
        (ref-DPDC-UDC:module{DpdcUdcV2} DPDC-UDC)
        (ref-DPDC:module{DpdcV2} DPDC)
        (ref-DALOS:module{OuronetDalosV2} DALOS)
        (sf:string "MOCKS-98c486052a51")
        (nf:string "MOCKN-98c486052a51")
        (patron:string KST.ANHD)
        (lumy:string KST.LUMY)
        (type:object{DpdcUdcV2.URI|Type}
            (ref-DPDC-UDC::UDC_URI|Type true false false false false false false))
        (nd:object{DpdcUdcV2.DPDC|NonceData}
            (ref-DPDC-UDC::UDC_NonceData
                0.0 5.0 "CostProbe" "cost probe nonce" (ref-DPDC-UDC::UDC_NoMetaData) type
                (ref-DPDC-UDC::UDC_ZeroURI|Data) (ref-DPDC-UDC::UDC_ZeroURI|Data) (ref-DPDC-UDC::UDC_ZeroURI|Data)))
    )
    (ref-TS02-C2::DPNF|C_EnableNonceFragmentation patron (DPDC.UR_OwnerKonto nf false) nf 2 nd)
    (ref-TS02-C2::DPNF|C_MakeFragments patron patron nf 2 1)
    (let
        (
            (predicted:object{OuronetInfoV2.ClientInfo} (INFO-TWO.INFO_DPNF|MergeFragments patron patron nf -2 (ref-DPDC::UR_AccountNonceSupply patron nf false -2)))
            (frag-before:integer (ref-DPDC::UR_AccountNonceSupply patron nf false -2))
            (ignis-before:decimal (ref-DALOS::UR_TF_AccountSupply patron false))
            (m (ref-TS02-C2::DPNF|C_MergeFragments patron patron nf -2 (ref-DPDC::UR_AccountNonceSupply patron nf false -2)))
        )
        (map print
            [
                (format "<<DPNF-I39 DIAG>> held(-1)={} held(-2)={} nonces-used={}"
                    [(ref-DPDC::UR_AccountNonceSupply patron nf false -2)
                     (ref-DPDC::UR_AccountNonceSupply patron nf false -2)
                     (ref-DPDC::UR_NoncesUsed nf false)])
                (expect "<<DPNF-I39>> INFO_DPNF|MergeFragments's quote equals what the op actually charged"
                    (- ignis-before (ref-DALOS::UR_TF_AccountSupply patron false))
                    (at "ignis-need" (at "ignis" predicted)))
                (expect "<<DPNF-I39>> ...and it is a real, non-zero charge"
                    true (> (- ignis-before (ref-DALOS::UR_TF_AccountSupply patron false)) 0.0))
                ;;the two facts the fixture rests on, captured BEFORE the merge consumed them
                (expect "<<DPNF-I39>> ...fragments really landed on the NEGATION of the native nonce"
                    true (> frag-before 0))
                (expect "<<DPNF-I39>> ...and the merged amount really was a multiple of the protocol's 1000"
                    0 (mod frag-before 1000))
                ;;witness — the merge really reassembled them, so the quote is not for a no-op
                (expect "<<DPNF-I39>> ...witness: the fragment position is gone afterwards"
                    0 (ref-DPDC::UR_AccountNonceSupply patron nf false -2))
            ]
        )
    )
    ""
)
(env-sigs [])
(rollback-tx)

