(begin-tx "CODEX-I1 — INFO_ cost previews vs what the ops actually charge")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(namespace "ouronet-ns")
(print "--- [CODEX-I1 · 01 · predicted IGNIS vs measured, on a live upload] ---")
;;FUNCTION COVERAGE (G6) — the `INFO_` family, per the owner's spec: an INFO_ must report the same
;;cost the op actually charges. Template and rationale: `modules/ATS.repl <<ATS-I1>>`.
;;
;;`INFO_CODEX|RecordArweaveUpload` previews `TS01-C4.CODEX|C_RecordArweaveUpload`, and the two take
;;IDENTICAL arguments — so the preview can be read with exactly what the exec is then handed, which
;;is the strongest form of this test: no translation between the two call sites where a mistake
;;could hide.
;;CODEX-G3 above replaced env-data wholesale, so the fixture composite-id is no longer in
;;scope -- restore it. Same 325-char literal as `Stage_01/[6.9]_CODEX.repl` INIT TX000.
(env-data { "CODEX|COMPOSITE-ID": "₱.ŹΘHYSç7þУJΛpøЩфμбÄИЫŒП9ó7æйȘΣßлΔσ3äЬyrfжπйôleBĄиĄLtźș∇îИyKβńĎDûuÁCȘñЯÒźâŒíßRζäĞΩěѺtşlęHБMŸíWlãąŹÔИЖÊzHțćœŽζýżχδšωχUΨNńúńñУnИкjубâ£ßMKηжлý9κιЦвSαцууěÖщьΩùцn₳Бεůφ:Π.ЙÛœ5ŒOóцιbÌȘŚÚůVÀΠьδЬÃςиbIñжÄoTЬŮşÄrhûεżęF5h₳ΞžGËWXÇûKÖLÙNÂ₱ůθŚяZ₳tœ¥ÅÂΓŹË4uĂбoÚAвOUζÂwΩэí₳ÜŻŁqΣкΣΨΨþѺBkĞõeѺńξTŠB0èΦeπδóýwÑeщIäΣMNøθΔîý₿ŹďρŁȘρτYEúNвÓûĐØúkŹýşθÞΓ" })
(env-sigs [{ "key": "PK_AncientHodler", "caps": [] } { "key": "PK_Florean", "caps": [] }])
(let
    (
        (ref-TS01-C4:module{TalosStageOne_ClientFourV8} TS01-C4)
        (ref-DALOS:module{OuronetDalosV2} DALOS)
        (composite-id:string (read-string "CODEX|COMPOSITE-ID"))
        (patron:string KST.ANHD)
        ;;a SECOND arweave tx-id: the fixture's own was already consumed by [6.9] TX003, and the
        ;;upload path refuses a duplicate. 43 chars, base64url, as the id validator requires.
        (tx2:string "Bc7dEf9GhIjKlMnOpQrStUvWxYz012345678-_abcd9")
        (bytes:integer 2048)
    )
    (let
        (
            (predicted:object{OuronetInfoV2.ClientInfo}
                (CODEX.INFO_CODEX|RecordArweaveUpload patron composite-id tx2 bytes))
            (ignis-before:decimal (ref-DALOS::UR_TF_AccountSupply patron false))
        )
        (let
            (
                (predicted-ignis:decimal (at "ignis-need" (at "ignis" predicted)))
            )
            (ref-TS01-C4::CODEX|C_RecordArweaveUpload patron composite-id tx2 bytes)
            (let
                (
                    (real-ignis:decimal (- ignis-before (ref-DALOS::UR_TF_AccountSupply patron false)))
                )
                (map print
                    [
                        (format "<<CODEX-I1>> predicted={} real={}" [predicted-ignis real-ignis])
                        (expect "<<CODEX-I1>> INFO_CODEX|RecordArweaveUpload's quote equals the real charge"
                            real-ignis predicted-ignis)
                        ;;non-zero, so the equality is not 0 == 0 under a zero-gas boot
                        (expect "<<CODEX-I1>> ...and it is a real, non-zero charge"
                            true (> real-ignis 0.0))
                    ]
                )
            )
        )
    )
    ""
)
(env-sigs [])
;;the upload is discarded — the fixture keeps exactly the one [6.9] recorded
(rollback-tx)
