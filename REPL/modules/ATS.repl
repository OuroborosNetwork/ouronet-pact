(begin-tx "ATS-G26 — the pair's own owner gate, isolated from the token's")
(print "")
(print "--- [ATS-G26 · 01 · adding a reward token to somebody else's pair] ---")
(namespace "ouronet-ns")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
;;KORIndex is the target because it is the only ANHD pair with cold recovery already off. That does
;;not matter for the attack -- both recovery guards sit BEHIND ownership, which these very assertions
;;demonstrate by reaching the ownership message on a pair whose direct recovery is ON -- but it makes
;;the non-vacuity half in G26b reachable with a single owner toggle instead of two.
(env-sigs [{ "key": "PK_Emma", "caps": [] }])
(let
    (
        (ref-ATS:module{AutostakeV3} ATS)
        (ref-DPTF:module{DemiourgosPactTrueFungibleV2} DPTF)
        (ref-TS01-C2:module{TalosStageOne_ClientTwoV2} TS01-C2)
        (kor:string "KORIndex-98c486052a51")
        (attacker:string KST.EMMA)
        (victim:string KST.ANHD)
    )
    (map print
        [
            ;;THE FIXTURE IS THE WHOLE POINT, so it is asserted rather than assumed.
            (expect "<<ATS-G26>> the attacker owns a DPTF of her own, so gate 1 will PASS"
                true (contains "EMCO-98c486052a51" (ref-DPTF::URH_OwnedTrueFungibles attacker)))
            (expect "<<ATS-G26>> ...and she does NOT own the target pair, so gate 2 must refuse"
                false (contains kor (ref-ATS::URH_OwnedAutostakePairs attacker)))
            (expect "<<ATS-G26>> ...which the victim does"
                true (contains kor (ref-ATS::URH_OwnedAutostakePairs victim)))
            (expect "<<ATS-G26>> ...and the pair is under the 7-RT ceiling, so the business rule passes"
                true (<= (length (ref-ATS::UR_RewardTokens kor)) 6))
            ;;AMBIGUOUS BY CONSTRUCTION -- kept deliberately. Offering a token the attacker does NOT
            ;;own is refused, but ANHD owns both PSTOA and KORIndex, so this message cannot say which
            ;;gate spoke. It is asserted to document that the obvious test is the unattributable one.
            (expect-failure "<<ATS-G26>> a token she does not own is refused -- but by WHICH gate is unknowable here"
                "Keyset failure (keys-all): [PK_Ancie...]"
                (ref-TS01-C2::ATS|C_AddSecondary attacker kor "PSTOA-98c486052a51" false))
            ;;ATTRIBUTABLE. Same attacker, same pair, same message -- but now the token is hers, so
            ;;`DPTF::CAP_Owner reward-token` cannot be the refuser. Only `CAP_Owner atspair` remains.
            (expect-failure "<<ATS-G26>> owning the token does NOT let you attach it to someone else's pair"
                "Keyset failure (keys-all): [PK_Ancie...]"
                (ref-TS01-C2::ATS|C_AddSecondary attacker kor "EMCO-98c486052a51" false))
            ;;...and the refusal was TOTAL.
            (expect "<<ATS-G26>> ...and no reward token was attached"
                1 (length (ref-ATS::UR_RewardTokens kor)))
        ]
    )
    ""
)
(env-sigs [])
(rollback-tx)

