(let
    (
        (ref-TS01-C2:module{TalosStageOne_ClientTwoV2} TS01-C2)
        (ref-DALOS:module{OuronetDalosV2} DALOS)
        (ref-DPOF:module{DemiourgosPactOrtoFungibleV2} DPOF)
        (ref-ATS:module{AutostakeV3} ATS)
        (ps:string "PlebeicStrength-98c486052a51")
        (kor:string "KORIndex-98c486052a51")
        (ddk:string "DDKOSON-98c486052a51")
        (aozt:string KST.AOZT)
        (emma:string KST.EMMA)
    )
    ;;SETUP, outside the measurement window — a FRESH hot-RBT nonce to operate on. `[6.6]` mints two
    ;;(DDKOSON nonces 1 and 2) and consumes both in its own redeem tests, so nothing is left standing
    ;;at this point in the chain. `C_HotRecovery` is the mint path and is measured on its own at
    ;;<<ATS-I23>>; here it is setup and closes before `ignis-before` is read.
    ;;The nonce number is READ BACK rather than written: which index a fresh mint lands on depends on
    ;;everything that ran before, and a hardcoded 1 or 2 would price a consumed row.
    (ref-TS01-C2::ATS|C_HotRecovery aozt aozt ps 50.0)
    (let
        (
            (n:integer (ref-DPOF::UR_NoncesUsed ddk))
        )
        (let
            (
                (predicted:object{OuronetInfoV2.ClientInfo} (INFO-ONE.INFO_ATS|Redeem aozt aozt ddk n))
                (ignis-before:decimal (ref-DALOS::UR_TF_AccountSupply aozt false))
                (m (ref-TS01-C2::ATS|C_Redeem aozt aozt ddk n))
            )
            (map print
                [
                    (format "<<ATS-I28>> nonce={} predicted={} real={}"
                        [n (at "ignis-need" (at "ignis" predicted))
                         (- ignis-before (ref-DALOS::UR_TF_AccountSupply aozt false))])
                    (expect "<<ATS-I28>> INFO_ATS|Redeem's quote equals what the op actually charged"
                        (- ignis-before (ref-DALOS::UR_TF_AccountSupply aozt false))
                        (at "ignis-need" (at "ignis" predicted)))
                    (expect "<<ATS-I28>> ...and it is a real, non-zero charge"
                        true (> (- ignis-before (ref-DALOS::UR_TF_AccountSupply aozt false)) 0.0))
                ]
            )
        )
    )
    ""
)
(env-sigs [])
(rollback-tx)

