(begin-tx "ATS-G8 — issue-data sanity, the Cold-RBT precision rule, and the syphon floor")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(namespace "ouronet-ns")
(print "--- [ATS-G8 · 01 · issue data, RBT precision, syphon floor] ---")
;;Three guards on three different bands. UEV_IssueData and URC_RBT are ordinary functions and are
;;called directly; the syphon floor is an @event cap and goes through the Talos client path.
;;
;;BOTH signatures are present throughout: PlebeicStrength and its reward tokens are AOZ-owned, so
;;the patron's key alone gets rejected by an ownership gate before any of these guards. My first
;;attempt did exactly that and returned a keyset failure rather than the guard's message.
;;==== ATS-G8 — issue-data sanity, the Cold-RBT precision rule, and the syphon floor · 01 · env-sigs (caps) ==== 
(print "--- [ATS-G8 — issue-data sanity, the Cold-RBT precision rule, and the syphon floor · 01 · env-sigs (caps)] ---")
(env-sigs [{ "key": "PK_AOZ", "caps": [] } { "key": "PK_AncientHodler", "caps": [] }])
(let*
    (
        (ref-ATS:module{AutostakeV3} ATS)
        (ref-TS01-C2:module{TalosStageOne_ClientTwoV2} TS01-C2)
        (ps:string "PlebeicStrength-98c486052a51")
        (rt:string (at 0 (ref-ATS::UR_RewardTokenList ps)))
    )
    (map print
        [
            ;;--- an autostake pool converts RT into RBT. If they were the same token the index
            ;;would be a conversion from a thing into itself, and every stake would compound
            ;;against its own supply.
            (expect-failure "<<ATS-G8>> a pool whose RT and RBT are the SAME token is refused"
                "RT must be different from RBT"
                (ref-ATS::UEV_IssueData "NewPair" 12 rt rt))
            ;;--- the Cold-RBT sets the precision of everything denominated in it. An amount with
            ;;more decimals than the token can represent would be silently truncated somewhere in
            ;;the conversion, so it is refused at the door instead.
            (expect "<<ATS-G8>> an amount at the Cold-RBT's own precision is accepted"
                true (>= (ref-ATS::URC_RBT ps rt 0.000000000000000000000001) 0.0))
            (expect-failure "<<ATS-G8>> ...and one decimal beyond it is refused"
                "must have at most a precision equal to that of the Cold-RBT"
                (ref-ATS::URC_RBT ps rt 0.0000000000000000000000001))
            ;;--- the syphon index has a hard floor of 0.1
            (expect-failure "<<ATS-G8>> a syphon index below 0.1 is refused"
                "Syphon cannot be set lower than 0.1"
                (ref-TS01-C2::ATS|C_UpdateSyphon KST.ANHD ps 0.05))
        ]
    )
    ""
)
;;PINNED ELSEWHERE: "An Autostake Pool cannot be issued when either the RT or RBT are Special or LP
;;Tokens" needs a special (F|/R|) or LP (S|/W|/P|) DPTF that EXISTS in the chain. None does here, and
;;the guard is reached with a token whose properties row is missing, so it aborts in the read instead.
;;Rather than cross-load an SWP or VST fixture into this chain, the assertion went to the chain that
;;already pays for the state: **modules/VST.repl <<VST-G8>>**, where VST-03 has just minted F|MOCKA.
;;Both conjuncts of the rule are driven there, with two ordinary tokens as the accepting contrast.
;;(The obstacle that made it look unreachable was not the token but its OWNER: a frozen link belongs
;;to the DPTF smart-contract account, so CAP_Owner blocks the path before the rule is consulted.)
(env-sigs [])
(commit-tx)

