(begin-tx "ATS-F1 — the reward-token SENTINEL invariant, swept across every RT on the chain")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
;;==== ATS-F1 — the reward-token SENTINEL invariant, swept across every RT on the chain · 01 · namespace ==== 
(print "--- [ATS-F1 — the reward-token SENTINEL invariant, swept across every RT on the chain · 01 · namespace] ---")
(namespace "ouronet-ns")
(print "--- [ATS-F1 · 01 · no DPTF may hold an EMPTY reward-token list] ---")
;;REGRESSION SWEEP for a real defect found 2026-09-13 and fixed in `05_DPTF.pact`
;;`XE_UpdateRewardToken`.
;;
;;THE INVARIANT. A DPTF's `reward-token` column is a list of the ATS pairs it is a reward token of.
;;"None" is spelled with the ONE-ELEMENT SENTINEL `[BAR]`, never with the empty list -- that is the
;;value the column is initialised to, and the ADD branch is careful to replace rather than append to
;;it. The REMOVE branch was not: it called `UC_RemoveItem`, which is `(filter (!= item) in)`, and on
;;the last remaining pair that returns `[]`.
;;
;;WHY THAT BRICKS A TOKEN. `URC_IzRT` answers "is this a reward token anywhere?" with
;;`(if (= (UR_RewardToken id) [BAR]) false true)`. `[]` is not `[BAR]`, so an emptied token answers
;;TRUE while holding no pairs at all, and every transfer of it routes into `TFT::URCx_CPF_RT` ->
;;`(enumerate 0 (- (length ats-pairs) 1))` -> `(enumerate 0 -1)` -> the descending pair `[0, -1]` ->
;;`(at 0 [])` -> native fault. Permanently, and un-repairably: the ADD branch opens with `(at 0 rt)`,
;;which faults on `[]` as well, so the token could never be re-registered to escape the state.
;;
;;WHY NO EXISTING GUARD CAUGHT IT. `ATSU|C>X_REMOVE-SECONDARY` enforces `(> rt-position 0)`
;;("Primal RT cannot be removed") -- but that is a position in the ATS PAIR's reward-token list, a
;;different list from the DPTF's list of pairs. A token that is the sole SECONDARY RT of exactly one
;;pair clears that guard, and that state is reachable through the ordinary `ATS|C_AddSecondary`
;;client path (constructed live while investigating: PDKOSON went from `[BAR]` to `[TestKickPair]`).
;;
;;THIS SWEEP IS THE REGRESSION TRIP-WIRE and is deliberately written as an INVARIANT over every
;;token the chain actually has, not as a replay of the one path -- the same emptying could arrive
;;from any future writer of that column, and an invariant catches all of them.
;;==== ATS-F1 — the reward-token SENTINEL invariant, swept across every RT on the chain · 02 · let / invocation ==== 
(print "--- [ATS-F1 — the reward-token SENTINEL invariant, swept across every RT on the chain · 02 · let / invocation] ---")
(let
    (
        (ref-ATS:module{AutostakeV3} ATS)
        (ref-DPTF:module{DemiourgosPactTrueFungibleV2} DPTF)
        (ref-U|CT:module{OuronetConstantsV2} U|CT)
        (pairs:[string]
            ["Auryndex-98c486052a51" "EliteAuryndex-98c486052a51" "KORIndex-98c486052a51"
             "StoaLiquindex-98c486052a51" "TestKickPair-98c486052a51" "PlebeicStrength-98c486052a51"])
    )
    (let
        (
            ;;every token that is a reward token of any pair in this suite, de-duplicated
            (rts:[string] (distinct (fold (+) [] (map (lambda (p:string) (ref-ATS::UR_RewardTokenList p)) pairs))))
        )
        (map print
            [
                ;;non-vacuity: the sweep has something to sweep
                (expect "<<ATS-F1>> the chain really does carry reward tokens to check"
                    true (> (length rts) 0))
                ;;THE INVARIANT: never the empty list. This is the assertion that fails the moment
                ;;any writer re-introduces the bug.
                (expect "<<ATS-F1>> NO reward token holds an empty pair-list -- the sentinel is never dropped"
                    true
                    (fold (and) true
                        (map (lambda (t:string) (> (length (ref-DPTF::UR_RewardToken t)) 0)) rts)))
                ;;...and the sentinel's own shape: a token with no pairs reads as exactly [BAR],
                ;;which is what URC_IzRT compares against. PDKOSON is such a token here.
                (expect "<<ATS-F1>> a token that is NOT a reward token reads as the one-element [BAR] sentinel"
                    [(ref-U|CT::CT_BAR)] (ref-DPTF::UR_RewardToken "PDKOSON-98c486052a51"))
                ;;...so URC_IzRT answers it correctly. This is the reader the transfer path branches
                ;;on, and the whole defect was it answering TRUE for a token holding nothing.
                (expect "<<ATS-F1>> ...and URC_IzRT correctly answers FALSE for it"
                    false (ref-DPTF::URC_IzRT "PDKOSON-98c486052a51"))
                ;;the other direction, so the reader is not simply always-false: a real reward token
                ;;answers TRUE
                (expect "<<ATS-F1>> ...while a REAL reward token answers TRUE"
                    true (ref-DPTF::URC_IzRT (at 0 rts)))
                ;;CONSISTENCY: URC_IzRT must agree with the list it reads, for every token, both
                ;;ways. A token with pairs is an RT; a token with only the sentinel is not.
                (expect "<<ATS-F1>> URC_IzRT agrees with the stored list for every reward token"
                    true
                    (fold (and) true
                        (map (lambda (t:string)
                                (= (ref-DPTF::URC_IzRT t)
                                   (!= (ref-DPTF::UR_RewardToken t) [(ref-U|CT::CT_BAR)])))
                            rts)))
            ]
        )
    )
    ""
)
(commit-tx)

