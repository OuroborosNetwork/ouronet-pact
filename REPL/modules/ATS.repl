;;||===========================================================================================||
(begin-tx "ATS-I2 — INFO_ATS|ToggleParameterLock quotes the STOA the unlock actually charges")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(namespace "ouronet-ns")
(print "--- [ATS-I2 · 01 · DEFECT FIX: the parameter unlock was previewed as STOA-free] ---")
;;FUNCTION COVERAGE (G6) — the `INFO_` family, per the owner's spec. Template: `<<ATS-I1>>` above.
;;
;;DEFECT (found by this spec, fixed in `08_ATS.pact` + `02_INFO-ONE+.pact`):
;;`INFO_ATS|ToggleParameterLock` returned `OI|UDC_NoStoaCosts` UNCONDITIONALLY, but
;;`ATS::C_ToggleParameterLock` hands `XI_ToggleParameterLock`'s STOA leg to `STOA|C_Collect` — zero on
;;LOCK, `UC_FeeUnlockPrice` on UNLOCK. So unlocking was quoted as free. Identical to the SWP defect
;;in `modules/SWP.repl <<SWP-I1>>`; the fix ports DPTF's read-only `URCi_*Stoa` twin to both.
;;
;;Reaching the charged direction here is harder than in SWP, because the gate is a two-sided one:
;;    LOCK   (toggle=true)  requires AT LEAST ONE recovery to be ON
;;    UNLOCK (toggle=false) requires ALL recoveries to be OFF
;;which reads like a trap — you cannot satisfy both at once. It is not: recoveries stay switchable
;;while the pair is locked, so the reachable sequence is  recovery on -> lock -> recoveries off ->
;;unlock. The setup below walks exactly that, from whatever state the harness left behind.
;;A STOA charge is a REAL `coin.transfer` out of the patron's Stoa account, split 10/20/30/40 across
;;the four `OI|UR_StoaTargets`, so it needs a managed `coin.TRANSFER` per target. Two traps, both hit
;;while writing the SWP twin of this block:
;;  1] `env-sigs` called from INSIDE a `let` sets the signature set but never INSTALLS the managed
;;     caps -- the transfer then dies with "Managed capability not installed" pointing at coin.pact
;;     rather than at the test. It has to sit at TRANSACTION TOP LEVEL, as here.
;;  2] building the list with `(map (lambda (t) (coin.TRANSFER ...)) targets)` does not install them
;;     either. Capability values must be written out literally.
;;Sender is the Stoa account of PlebeicStrength's owner; receivers are the four STOA fee targets.
(env-sigs
  [ { "key": "PK_AOZ", "caps": [] }
    { "key": "PK_AncientHodler", "caps": [] }
    { "key": "95a59029029524ebb250b2fafe6826ff88bb59c527d661cba3279d09a51d3bdf"
    , "caps":
      [
        (coin.TRANSFER "k:95a59029029524ebb250b2fafe6826ff88bb59c527d661cba3279d09a51d3bdf" "k:50d6c59b21e5e6e55baecaa75a1007de37576bde12d8230dc82459cc01b9484b" 1000000.0)
        (coin.TRANSFER "k:95a59029029524ebb250b2fafe6826ff88bb59c527d661cba3279d09a51d3bdf" "k:0cb30c0121ff919266121a99ff9359871818932211df94dae4137c29bc0e8f7e" 1000000.0)
        (coin.TRANSFER "k:95a59029029524ebb250b2fafe6826ff88bb59c527d661cba3279d09a51d3bdf" "c:XM-pkmuB5XUQlp87ZYSbfKt8qzmHY6O2EHAzMRVBt3k" 1000000.0)
        (coin.TRANSFER "k:95a59029029524ebb250b2fafe6826ff88bb59c527d661cba3279d09a51d3bdf" "c:iQQFWj6gWtpGEzhM_O5ekW1QtnQQy55R8BRPGhj_0FU" 1000000.0) ] } ])
(let
    (
        (ref-TS01-C2:module{TalosStageOne_ClientTwoV2} TS01-C2)
        (ref-DALOS:module{OuronetDalosV2} DALOS)
        (ref-ATS:module{AutostakeV3} ATS)
        (ps:string "PlebeicStrength-98c486052a51")
    )
    (let
        (
            ;;the toggle is owner-gated and the patron pays, so read the owner rather than assume it
            (patron:string (ref-ATS::UR_OwnerKonto ps))
        )
        ;;SETUP 1 — the pair must be LOCKED before an unlock can be measured. Locking is the FREE
        ;;direction, so nothing in this step can contribute to the figure measured below.
        (if (not (ref-ATS::UR_Lock ps))
            (do
                (if (not (or (ref-ATS::UR_ToggleColdRecovery ps)
                             (or (ref-ATS::UR_ToggleHotRecovery ps)
                                 (ref-ATS::UR_ToggleDirectRecovery ps))))
                    (ref-TS01-C2::ATS|C_SwitchColdRecovery patron ps true)
                    "a recovery is already on"
                )
                (ref-TS01-C2::ATS|C_ToggleParameterLock patron ps true)
            )
            "already locked"
        )
        ;;SETUP 2 — the unlock gate demands every recovery OFF. None of these three charge STOA
        ;;(verified: no STOA|C_Collect anywhere in C_Switch*Recovery), so they cannot pollute the
        ;;measurement either.
        (if (ref-ATS::UR_ToggleColdRecovery ps)
            (ref-TS01-C2::ATS|C_SwitchColdRecovery patron ps false) "cold already off")
        (if (ref-ATS::UR_ToggleHotRecovery ps)
            (ref-TS01-C2::ATS|C_SwitchHotRecovery patron ps false) "hot already off")
        (if (ref-ATS::UR_ToggleDirectRecovery ps)
            (ref-TS01-C2::ATS|C_SwitchDirectRecovery patron ps false) "direct already off")
        (let
            (
                (stoa-acct:string (ref-DALOS::UR_AccountStoa patron))
            )
            (let
                (
                    ;;PREDICTED — read BEFORE the unlock executes, exactly as a client would
                    (predicted:object{OuronetInfoV2.ClientInfo}
                        (INFO-ONE.INFO_ATS|ToggleParameterLock patron ps false))
                    (stoa-before:decimal (coin.get-balance stoa-acct))
                    (ignis-before:decimal (ref-DALOS::UR_TF_AccountSupply patron false))
                )
                (let
                    (
                        (predicted-stoa:decimal (at "stoa-need" (at "stoa" predicted)))
                        (predicted-ignis:decimal (at "ignis-need" (at "ignis" predicted)))
                    )
                    (ref-TS01-C2::ATS|C_ToggleParameterLock patron ps false)
                    (let
                        (
                            (real-stoa:decimal (- stoa-before (coin.get-balance stoa-acct)))
                            (real-ignis:decimal (- ignis-before (ref-DALOS::UR_TF_AccountSupply patron false)))
                        )
                        (map print
                            [
                                (format "<<ATS-I2>> IGNIS predicted={} real={} | STOA predicted={} real={}"
                                    [predicted-ignis real-ignis predicted-stoa real-stoa])
                                (expect "<<ATS-I2>> the IGNIS quote equals the IGNIS charged"
                                    real-ignis predicted-ignis)
                                ;;THE REGRESSION: this asserted 0.0 == <the real fee> before the fix.
                                (expect "<<ATS-I2>> the STOA quote equals the STOA charged on UNLOCK"
                                    real-stoa predicted-stoa)
                                ;;...and the unlock genuinely costs STOA, so the equality above is not
                                ;;the old bug agreeing with itself at zero.
                                (expect "<<ATS-I2>> ...and unlocking is NOT free"
                                    true (> real-stoa 0.0))
                            ]
                        )
                    )
                )
            )
        )
    )
    ""
)
(env-sigs [])
;;every toggle above is discarded — the pair keeps the state the harness left it in
(rollback-tx)

