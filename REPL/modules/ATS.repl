(begin-tx "ATS-G7a — turn SYPHONING on (the fixture the syphon-amount guards need)")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(namespace "ouronet-ns")
(print "--- [ATS-G7a · 01 · enable syphoning] ---")
;;ATS-G2 pins the FIRST syphon guard — "Syphoning must be turned ON for exec" — on a pair where it
;;is off. Everything behind that guard is therefore unreachable until some pair has it on, and none
;;does. ATS|C_Control is the supported way to set it, so this is the toggle-first shape again:
;;enable, drive the amount guards, restore.
;;
;;The other two control flags are read and written back UNCHANGED, so this call alters exactly one
;;thing. Writing literals there would silently reconfigure the pair.
;;==== ATS-G7a — turn SYPHONING on (the fixture the syphon-amount guards need) · 01 · env-sigs (caps) ==== 
(print "--- [ATS-G7a — turn SYPHONING on (the fixture the syphon-amount guards need) · 01 · env-sigs (caps)] ---")
(env-sigs [{ "key": "PK_AOZ", "caps": [] } { "key": "PK_AncientHodler", "caps": [] }])
;;==== ATS-G7a — turn SYPHONING on (the fixture the syphon-amount guards need) · 02 · let / invocation ==== 
(print "--- [ATS-G7a — turn SYPHONING on (the fixture the syphon-amount guards need) · 02 · let / invocation] ---")
(let
    (
        (ref-TS01-C2:module{TalosStageOne_ClientTwoV2} TS01-C2)
        (ref-ATS:module{AutostakeV3} ATS)
        (ps:string "PlebeicStrength-98c486052a51")
    )
    (ref-TS01-C2::ATS|C_Control KST.ANHD ps
        (ref-ATS::UR_CanChangeOwner ps) true (ref-ATS::UR_Hibernate ps))
    (map print
        [
            (expect "<<ATS-G7a>> syphoning is now ON" true (ref-ATS::UR_Syphoning ps))
        ]
    )
    ""
)
(commit-tx)

