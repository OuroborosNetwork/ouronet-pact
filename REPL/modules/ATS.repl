(begin-tx "ATS-G16 — the parameter lock's two-sided rule, and the seven-RT ceiling")
(env-gasmodel "table")(env-gaslimit 150000000)(env-gas 0)
(namespace "ouronet-ns")
;;PK_AOZ is needed because `CAP_Owner atspair` runs BEFORE the enforces being tested, and TestKickPair
;;is owned by an AOZ account. Without it the refusal is a bare "Keyset failure (keys-all): [PK_AOZ…]",
;;which looks like the guard firing and is not -- the first run of this test made exactly that mistake.
;;==== ATS-G16 — the parameter lock's two-sided rule, and the seven-RT ceiling · 01 · env-sigs (caps) ==== 
(print "--- [ATS-G16 — the parameter lock's two-sided rule, and the seven-RT ceiling · 01 · env-sigs (caps)] ---")
(env-sigs [{ "key": "PK_AncientHodler", "caps": [] }, { "key": "PK_AOZ", "caps": [] }])
(print "--- [ATS-G16 · 01 · locking and unlocking are guarded in OPPOSITE directions] ---")
;;ATS|C>TOGGLE-PARAMETER-LOCK carries two enforces that are mirror images, and a test that only drove
;;one of them would look complete while covering half the rule:
;;
;;  locking ON  -> `enforce-one`: at least ONE recovery must be on. Locking a pair that offers no
;;                 recovery at all would freeze depositors out of every exit.
;;  locking OFF -> all three recoveries must be OFF. Unlocking while a recovery is live would let
;;                 parameters move under an in-flight recovery.
;;
;;NEITHER NEEDED A FIXTURE. This suite already builds two pairs that sit on opposite sides:
;;`TestKickPair` has all three recoveries off, `Auryndex` has cold recovery on. Nothing had called the
;;guards with either one. That is three of today's ATS pins found the same way -- the chain already
;;had the state.
;;==== ATS-G16 — the parameter lock's two-sided rule, and the seven-RT ceiling · 02 · let / invocation ==== 
(print "--- [ATS-G16 — the parameter lock's two-sided rule, and the seven-RT ceiling · 02 · let / invocation] ---")
(let
    (
        (ref-ATS:module{AutostakeV3} ATS)
        (ref-TS01-C2:module{TalosStageOne_ClientTwoV2} TS01-C2)
        (a:string "Auryndex-98c486052a51")
        (t:string "TestKickPair-98c486052a51")
    )
    (map print
        [
            ;;the two fixtures, asserted so each refusal below is attributable to the recovery flags
            (expect "<<ATS-G16>> TestKickPair is unlocked with NO recovery of any kind"
                [false false false false]
                [(ref-ATS::UR_Lock t) (ref-ATS::UR_ToggleColdRecovery t)
                 (ref-ATS::UR_ToggleHotRecovery t) (ref-ATS::UR_ToggleDirectRecovery t)])
            (expect "<<ATS-G16>> ...while Auryndex is unlocked WITH cold recovery on"
                [false true] [(ref-ATS::UR_Lock a) (ref-ATS::UR_ToggleColdRecovery a)])
            ;;GUARD 1 -- locking a pair with no recovery at all. This is an `enforce-one` over the
            ;;three recovery flags, so reaching its own message means all three branches failed.
            (expect-failure "<<ATS-G16>> a pair with no recovery at all cannot be locked"
                "When Parameter Lock is set to true, at least One Recovery must be on"
                (ref-TS01-C2::ATS|C_ToggleParameterLock KST.ANHD t true))
            ;;...and Auryndex, which HAS a recovery, locks fine -- so guard 1 is about the recovery
            ;;flags and not about locking being refused generally.
            (expect "<<ATS-G16>> ...while a pair WITH a recovery locks successfully"
                true (!= "" (ref-TS01-C2::ATS|C_ToggleParameterLock KST.ANHD a true)))
            (expect "<<ATS-G16>> ...and the lock really took"
                true (ref-ATS::UR_Lock a))
            ;;GUARD 2 -- the mirror. Now that Auryndex is locked, unlocking it is refused because its
            ;;cold recovery is still on. Same pair, same flags, opposite direction.
            (expect-failure "<<ATS-G16>> ...but it cannot be UNLOCKED while that recovery is live"
                "ATSPair Auryndex-98c486052a51 Recoveries must be stopped for exec"
                (ref-TS01-C2::ATS|C_ToggleParameterLock KST.ANHD a false))
        ]
    )
    (print "--- [ATS-G16 · 02 · the seven-reward-token ceiling] ---")
    ;;ATS|C>ADD-REWARD-TOKEN's first check is `(enforce (<= n 6) "An ATS Pair can have a maximum of 7
    ;;RTs")` -- i.e. a seventh may be added, an eighth may not. Every pair here carries ONE reward
    ;;token, and adding six more through the client would be six IGNIS-billed transactions against
    ;;tokens this account does not own, so the list is written directly instead.
    ;;
    ;;The written value is the pair's OWN reward-token entry repeated seven times, not a fabricated
    ;;object: the guard reads only the LENGTH, and copying the real row keeps the rest of the schema
    ;;honest for anything else that reads it in the same transaction.
    ;;Pattern and boundary: 2026-09-12-state-driven-guard-coverage.md; ATS-G16b is the leakage check.
    (env-module-admin ATS)
    (update ATS.ATS|Pairs a
        { "reward-tokens" :
            (make-list 7 (at 0 (at "reward-tokens" (read ATS.ATS|Pairs a ["reward-tokens"])))) })
    (map print
        [
            (expect "<<ATS-G16>> the pair now carries seven reward tokens"
                7 (length (ref-ATS::UR_RewardTokens a)))
            (expect-failure "<<ATS-G16>> ...so an eighth is refused"
                "An ATS Pair can have a maximum of 7 RTs"
                (ref-TS01-C2::ATS|C_AddSecondary KST.ANHD a "AKOSON-98c486052a51" false))
        ]
    )
    ""
)
(env-sigs [])
;;this tx locked a pair and rewrote its reward-token list
(rollback-tx)

;;|| NEXT >
;;
(begin-tx "ATS-G16b — the lock and the reward-token list were rolled back")
(namespace "ouronet-ns")
(print "--- [ATS-G16b · 01 · no leakage] ---")
;;ATS-G16 locked Auryndex's parameters and gave it seven reward tokens. A lock that leaked would
;;refuse every later parameter write in this file with a message about the lock rather than about the
;;parameter, and a seven-entry reward list would skew every syphon and index computation that reads it.
(let ((a:string "Auryndex-98c486052a51"))
    (map print
        [
            (expect "<<ATS-G16b>> Auryndex is unlocked again"
                false (ATS.UR_Lock a))
            (expect "<<ATS-G16b>> ...and back to its single reward token"
                1 (length (ATS.UR_RewardTokens a)))
        ]
    )
    ""
)
(commit-tx)

;;|| NEXT >
;;
(begin-tx "ATS-G17 — the two ATSU index/position guards, and a message that is only half right")
(env-gasmodel "table")(env-gaslimit 150000000)(env-gas 0)
(namespace "ouronet-ns")
;;==== ATS-G17 — the two ATSU index/position guards, and a message that is only half right · 01 · env-sigs (caps) ==== 
(print "--- [ATS-G17 — the two ATSU index/position guards, and a message that is only half right · 01 · env-sigs (caps)] ---")
(env-sigs [{ "key": "PK_AncientHodler", "caps": [] }, { "key": "PK_AOZ", "caps": [] }])
(print "--- [ATS-G17 · 01 · no cold-recovery positions left] ---")
;;C_ColdRecovery (10_ATSU.pact:1714) enforces `(!= usable-cold-recovery-position 0)`, and 0 is what
;;URCx_NonElitePosition returns when no slot is free. The cheapest way to that is `c-positions = 0`:
;;the reader does `(take positions pstate)`, so an empty window finds no free slot and answers 0.
;;That is also the honest fixture -- a pair whose seven slots are all taken reaches the same branch.
;;
;;NOTE the -1 case is DIFFERENT and must not be confused with it: `c-positions = -1` means "cold
;;recovery not configured" and the reader short-circuits to -1, which passes `!= 0`. So the guard
;;distinguishes "all used up" from "never set up", and only the first is an error.
;;Pattern and boundary: 2026-09-12-state-driven-guard-coverage.md; ATS-G17b is the leakage check.
(env-module-admin ATS)
(env-module-admin DPTF)
;;==== ATS-G17 — the two ATSU index/position guards, and a message that is only half right · 02 · let / invocation ==== 
(print "--- [ATS-G17 — the two ATSU index/position guards, and a message that is only half right · 02 · let / invocation] ---")
(let
    (
        (ref-ATS:module{AutostakeV3} ATS)
        (ref-TS01-C2:module{TalosStageOne_ClientTwoV2} TS01-C2)
        (a:string "Auryndex-98c486052a51")
    )
    (map print
        [
            (expect "<<ATS-G17>> Auryndex starts with seven cold-recovery positions"
                7 (ref-ATS::UR_ColdRecoveryPositions a))
            (expect "<<ATS-G17>> ...and a free slot is available, so recovery is possible"
                true (!= 0 (ref-ATS::URC_WhichPosition a 1.0 KST.ANHD)))
        ]
    )
    (update ATS.ATS|Pairs a { "c-positions" : 0 })
    (map print
        [
            (expect "<<ATS-G17>> with zero positions the reader answers 0, not -1"
                0 (ref-ATS::URC_WhichPosition a 1.0 KST.ANHD))
            (expect-failure "<<ATS-G17>> ...so a cold recovery is refused as fully used"
                "Cold Recovery Unavailable! All existing Positions are used!"
                (ref-TS01-C2::ATS|C_ColdRecovery KST.ANHD KST.ANHD a 1.0))
        ]
    )
    (update ATS.ATS|Pairs a { "c-positions" : 7 })
    (print "--- [ATS-G17 · 02 · fuelling needs an index at or above the 0.1 floor] ---")
    ;;ATSU|C>FUEL (10_ATSU.pact) enforces `(>= index 0.1)`. The message used to read "Fueling cannot
    ;;take place on a negative Index", which described only part of its own condition -- and this
    ;;block is what found that, by driving the two states separately and noticing that one of them
    ;;was being told something untrue. THE MESSAGE HAS SINCE BEEN CORRECTED (owner-authorised
    ;;2026-09-13) to "Fueling requires an ATS-Pair Index of at least 0.1". The bound was always
    ;;right: 0.1 is a deliberate system floor, the same one ATSU|C>KICKSTART applies to
    ;;<would-be-index>, where it was already worded honestly.
    ;;
    ;;BOTH STATES ARE STILL DRIVEN, and that is the point of keeping the block in this shape: one
    ;;message now has to be correct for two quite different failures, so testing only one of them
    ;;would let a future re-narrowing of the wording back in.
    ;;
    ;;  index = -1.0   URC_Index's sentinel for "this pair has NO RBT supply at all".
    ;;  index = 0.05   a live pair whose resident sum is small next to its RBT supply -- POSITIVE,
    ;;                 under the floor, and the case the old wording got wrong.
    (let
        (
            (c-rbt:string (ref-ATS::UR_ColdRewardBearingToken a))
            (rt:string (at 0 (ref-ATS::UR_RewardTokenList a)))
            (rt-row:object{AutostakeV3.ATS|RewardTokenSchemaV2}
                (at 0 (at "reward-tokens" (read ATS.ATS|Pairs a ["reward-tokens"]))))
            (rbt-supply:decimal (ref-ATS::URC_PairRBTSupply a))
        )
        ;;--- the SENTINEL case. Zero the cold-RBT's supply: URC_Index divides by it, so it returns
        ;;    -1.0 rather than dividing by zero.
        (update DPTF.DPTF|PropertiesTable c-rbt { "supply" : 0.0 })
        (map print
            [
                (expect "<<ATS-G17>> with no RBT supply the index is the -1.0 sentinel"
                    [-1.0 0.0] [(ref-ATS::URC_Index a) (ref-ATS::URC_PairRBTSupply a)])
                (expect-failure "<<ATS-G17>> ...and fuelling is refused against the floor"
                    "Fueling requires an ATS-Pair Index of at least 0.1"
                    (ref-TS01-C2::ATS|C_Fuel KST.ANHD KST.ANHD a rt 1.0))
            ]
        )
        ;;--- the UNDER-0.1 case, which is the one the source note is about. Restore the supply and
        ;;    shrink the resident sum instead, to 5% of it: index = 0.05, positive and still refused.
        (update DPTF.DPTF|PropertiesTable c-rbt { "supply" : rbt-supply })
        (update ATS.ATS|Pairs a
            { "reward-tokens" :
                [(+ { "resident" : (* rbt-supply 0.05) } (remove "resident" rt-row))] })
        (map print
            [
                (expect "<<ATS-G17>> ...whereas a small resident sum gives a POSITIVE index under 0.1"
                    true (and (> (ref-ATS::URC_Index a) 0.0)
                              (< (ref-ATS::URC_Index a) 0.1)))
                ;;THE CASE THAT FORCED THE WORDING FIX. This index is positive and the call is
                ;;still refused -- correctly, because it is under the 0.1 floor. The old message
                ;;called it negative, which it demonstrably is not (asserted on the line above).
                ;;Now that the message names the floor instead, the same rejection reads truthfully
                ;;in both states, and this assertion is what holds it to that.
                (expect-failure "<<ATS-G17>> ...a POSITIVE index under the floor is refused, and told so accurately"
                    "Fueling requires an ATS-Pair Index of at least 0.1"
                    (ref-TS01-C2::ATS|C_Fuel KST.ANHD KST.ANHD a rt 1.0))
            ]
        )
    )
    ""
)
(env-sigs [])
;;this tx zeroed a position count, a token supply and a resident sum
(rollback-tx)

;;|| NEXT >
;;
(begin-tx "ATS-G17b — the index fixture left no trace")
(namespace "ouronet-ns")
(print "--- [ATS-G17b · 01 · no leakage] ---")
;;ATS-G17 drove AURYN's supply to zero and cut Auryndex's resident sum to a twentieth. Either leaking
;;would move the pair index, and the index is the denominator of nearly every ATS computation in this
;;file -- so the failures would surface as arithmetic drift with nothing pointing back here.
(let ((a:string "Auryndex-98c486052a51"))
    (map print
        [
            (expect "<<ATS-G17b>> the cold-recovery positions are back to seven"
                7 (ATS.UR_ColdRecoveryPositions a))
            (expect "<<ATS-G17b>> ...the RBT supply is restored, so the index is live again"
                true (> (ATS.URC_PairRBTSupply a) 0.0))
            (expect "<<ATS-G17b>> ...and the index is back above 1, not the 0.05 probe value"
                true (> (ATS.URC_Index a) 1.0))
        ]
    )
    ""
)
(commit-tx)

;;|| NEXT >
;;
(begin-tx "ATS-G18 — Constrict and Brumate read hibernation in OPPOSITE directions")
(env-gasmodel "table")(env-gaslimit 150000000)(env-gas 0)
(namespace "ouronet-ns")
;;==== ATS-G18 — Constrict and Brumate read hibernation in OPPOSITE directions · 01 · env-sigs (caps) ==== 
(print "--- [ATS-G18 — Constrict and Brumate read hibernation in OPPOSITE directions · 01 · env-sigs (caps)] ---")
(env-sigs [{ "key": "PK_AncientHodler", "caps": [] }])
(print "--- [ATS-G18 · 01 · the hibernation polarity of each operation] ---")
;;`ATSU|C>CONSTRICT` and `ATSU|C>BRUMATE` live in 11_VST.pact and are the hibernating counterparts of
;;Coil and Curl (pinned by ATS-G13, which refuses them while hibernation is ON). These two want the
;;opposite, and Brumate wants it on only ONE side:
;;
;;    Constrict   requires hibernation ON  for its pair
;;    Brumate     requires it OFF on ats1 and ON on ats2  -- `(and (not h1) h2)`
;;
;;Neither needed a fixture. This suite leaves Auryndex and KORIndex hibernating and StoaLiquindex awake,
;;which is every combination these two guards distinguish.
;;
;;The reward token is read from each pair at runtime, because `UEV_RewardTokenExistance` runs BEFORE
;;both enforces -- a wrong token id gets the existence error and the hibernation guard is never reached.
;;(ATS-G13 learned that the hard way.)
;;==== ATS-G18 — Constrict and Brumate read hibernation in OPPOSITE directions · 02 · let / invocation ==== 
(print "--- [ATS-G18 — Constrict and Brumate read hibernation in OPPOSITE directions · 02 · let / invocation] ---")
(let
    (
        (ref-ATS:module{AutostakeV3} ATS)
        (ref-TS01-C2:module{TalosStageOne_ClientTwoV2} TS01-C2)
        (a:string "Auryndex-98c486052a51")
        (k:string "KORIndex-98c486052a51")
        (sl:string "StoaLiquindex-98c486052a51")
    )
    (map print
        [
            (expect "<<ATS-G18>> Auryndex and KORIndex hibernate; StoaLiquindex does not"
                [true true false]
                [(ref-ATS::UR_Hibernate a) (ref-ATS::UR_Hibernate k) (ref-ATS::UR_Hibernate sl)])
            ;;CONSTRICT on an AWAKE pair -- the mirror of ATS-G13's coil refusal, and the message now
            ;;reads "turned off" rather than "turned of" (spelling corrected 2026-09-12).
            (expect-failure "<<ATS-G18>> an awake pair cannot be constricted"
                "Cannot Constrict when StoaLiquindex-98c486052a51 has Hibernation turned off"
                (ref-TS01-C2::ATS|C_Constrict KST.ANHD KST.ANHD sl
                    (at 0 (ref-ATS::UR_RewardTokenList sl)) 1.0 30))
            ;;BRUMATE with BOTH pairs hibernating -- `(not h1)` fails. This is the assertion that also
            ;;pins the REPAIRED message: it used to be a bare string carrying two literal `{}`, with no
            ;;`format` call, so the two pair ids never appeared. Only instance of that shape in the
            ;;codebase; `_conformance.py --rule enforce-msg-bare-template` now keeps it at 0.
            (expect-failure "<<ATS-G18>> brumating FROM a hibernating pair is refused, and names both"
                "Brumate requires hibernation for Auryndex-98c486052a51 set to off and for KORIndex-98c486052a51 set to ON"
                (ref-TS01-C2::ATS|C_Brumate KST.ANHD KST.ANHD a k
                    (at 0 (ref-ATS::UR_RewardTokenList a)) 1.0 30))
            ;;...and the OTHER half of Brumate's conjunction: ats1 awake is necessary but not
            ;;sufficient, because ats2 must be hibernating too. StoaLiquindex -> StoaLiquindex gives
            ;;h1 = false (good) and h2 = false (bad), so the same message answers for the opposite
            ;;reason. Without this, a guard written as `(not h1)` alone would pass the case above.
            (expect-failure "<<ATS-G18>> ...and so is brumating INTO an awake pair, for the other reason"
                "set to ON"
                (ref-TS01-C2::ATS|C_Brumate KST.ANHD KST.ANHD sl sl
                    (at 0 (ref-ATS::UR_RewardTokenList sl)) 1.0 30))
        ]
    )
    ""
)
(env-sigs [])
(commit-tx)

;;|| NEXT >
;;|| ATS-G19 — the cold-recovery position backstop, and the one configuration that reaches it.
;;
(begin-tx "ATS-G19 - ATSU|C>COLD_RECOVERY: a derived position the pair does not have")
(env-gasmodel "table")(env-gaslimit 100000000)(env-gas 0)
(namespace "ouronet-ns")
(print "--- [ATS-G19 · 01 · elite tier and pair positions can disagree] ---")
;;`10_ATSU.pact:432`. It compares a DERIVED value against a stored one:
;;    (enforce (<= usable-cold-recovery-position (UR_ColdRecoveryPositions ats)) "Unavailable …")
;;and `usable-cold-recovery-position` is not a client argument -- `ATSU|C_ColdRecovery` computes it
;;with `ATS::URC_WhichPosition`. So it looks like a backstop that can never disagree with itself.
;;
;;IT CAN, AND WHICH BRANCH DECIDES IT IS THE WHOLE POINT. `URC_WhichPosition` forks on the pair's
;;`c-elite-mode`:
;;  * NON-ELITE (`URCx_NonElitePosition`) takes `(take positions pstate)` -- bounded BY `c-positions`
;;    itself, so the result can never exceed it and the guard is genuinely unreachable. Measured:
;;    driving `c-positions` to 0 moved BOTH sides and produced the EARLIER message instead.
;;  * ELITE (`URCx_ElitePosition`) takes `(take met pstate)` -- bounded by the ACCOUNT'S MAJOR ELITE
;;    TIER, which has nothing to do with `c-positions`. The two are then free to disagree.
;;
;;So the guard is a real protection against a mis-set elite pair, and the input that reaches it is an
;;elite-mode pair whose positions are configured BELOW a recoverer's tier. Two field writes, both of
;;values an operator sets through ordinary client calls (`ATS|C_SwitchColdRecovery`,
;;`ATS|C_SetColdRecoveryFees`); this reproduces their combination without the surrounding cost.
;;
;;THE RECOVERER HAS TO BE ANHD. EMMA's major elite tier is 0, so `(take 0 pstate)` is empty and she
;;gets the earlier "All existing Positions are used!" instead -- which is asserted below, because the
;;contrast between the two accounts IS the mechanism.
;;==== ATS-G19 - ATSU|C>COLD_RECOVERY: a derived position the pair does not have · 01 · let / invocation ==== 
(print "--- [ATS-G19 - ATSU|C>COLD_RECOVERY: a derived position the pair does not have · 01 · let / invocation] ---")
(let
    (
        (ref-ATS:module{AutostakeV3} ATS)
        (ref-DALOS:module{OuronetDalosV2} DALOS)
        (ref-TS01-C2:module{TalosStageOne_ClientTwoV2} TS01-C2)
        (ats:string "Auryndex-98c486052a51")
    )
    (map print
        [
            ;;the premise: the pair is NON-elite today, and the two accounts sit either side of the
            ;;tier boundary that decides this
            (expect "<<ATS-G19>> the pair is non-elite with 7 positions"
                [false 7] [(ref-ATS::UR_EliteMode ats) (ref-ATS::UR_ColdRecoveryPositions ats)])
            (expect "<<ATS-G19>> ANHD is major-elite tier 7 and EMMA is tier 0"
                [7 0] [(ref-DALOS::UR_Elite-Tier-Major KST.ANHD)
                       (ref-DALOS::UR_Elite-Tier-Major KST.EMMA)])
        ]
    )
    ;;the mis-set pair: elite pricing on, but no positions configured
    (env-module-admin ATS)
    (update ATS.ATS|Pairs ats { "c-elite-mode" : true, "c-positions" : 0 })
    ;;ANHD must SIGN: ATSU|C>DEPLOY sits above the guard under test and runs
    ;;ATSU|C>NORMALIZE_LEDGER, an enforce-one over five permissions. Without a signature the call
    ;;dies there with "Invalid permission for normalizing ATS|Ledger Account Operations" -- which is
    ;;a real guard, just not this one. (It is pinned by ATS-G14, which is how the message was
    ;;recognised rather than chased.)
    (env-sigs [{ "key": "PK_AncientHodler", "caps": [] }])
    (map print
        [
            ;;the divergence, read directly -- this is the fact the guard exists to catch
            (expect "<<ATS-G19>> the elite path derives position 1 for ANHD on a 0-position pair"
                [1 0] [(ref-ATS::URC_WhichPosition ats 1.0 KST.ANHD)
                       (ref-ATS::UR_ColdRecoveryPositions ats)])
            ;;THE ITEM
            (expect-failure "<<ATS-G19>> ...so the recovery is refused for a position the pair lacks"
                "Unavailable Positions for Cold Recovery!"
                (ref-TS01-C2::ATS|C_ColdRecovery KST.ANHD KST.ANHD ats 1.0))
        ]
    )
    ;;CONTRAST -- a tier-0 account derives 0 and is stopped ONE ENFORCE EARLIER, by a different
    ;;message. Same pair, same call, different account: the two guards are ordered and distinct, and
    ;;neither is standing in for the other.
    (env-sigs [{ "key": "PK_Emma", "caps": [] }])
    (print
        (expect-failure "<<ATS-G19>> ...while a tier-0 account is stopped one enforce earlier"
            "Cold Recovery Unavailable! All existing Positions are used!"
            (ref-TS01-C2::ATS|C_ColdRecovery KST.EMMA KST.EMMA ats 1.0)))
    ""
)
(env-sigs [])
;;the mis-set pair is discarded -- ATS-G20 checks it
(rollback-tx)

;;|| NEXT >
;;|| ATS-G20 — the mis-set pair left no trace.
;;
(begin-tx "ATS-G20 - no leakage")
(namespace "ouronet-ns")
(print "--- [ATS-G20 · 01 · no leakage] ---")
;;`c-elite-mode` changes how every cold recovery on this pair is PRICED, and `c-positions` caps how
;;many any account may hold. A leak would not fail loudly -- it would silently reprice the pair.
(print
    (expect "<<ATS-G20>> Auryndex is non-elite with 7 positions again"
        [false 7] [(ATS.UR_EliteMode "Auryndex-98c486052a51")
                   (ATS.UR_ColdRecoveryPositions "Auryndex-98c486052a51")]))
(commit-tx)

;;|| NEXT >
;;|| ATS-G21 — the syphon resident bound: you cannot syphon more than is there.
;;
(begin-tx "ATS-G21 - ATSU|C>SYPHON: per-token resident amounts bound the syphon")
(env-gasmodel "table")(env-gaslimit 100000000)(env-gas 0)
(namespace "ouronet-ns")
;;==== ATS-G21 - ATSU|C>SYPHON: per-token resident amounts bound the syphon · 01 · env-sigs (caps) ==== 
(print "--- [ATS-G21 - ATSU|C>SYPHON: per-token resident amounts bound the syphon · 01 · env-sigs (caps)] ---")
(env-sigs [{ "key": "PK_AncientHodler", "caps": [] } { "key": "PK_AOZ", "caps": [] }])
(print "--- [ATS-G21 · 01 · syphoning more than a token's resident amount] ---")
;;`10_ATSU.pact:568`. Syphoning withdraws accrued reward tokens from a pair. The guard is written in
;;an indirect way that is worth reading carefully before driving it:
;;    (supply-check (zip (lambda (x y) (<= x y)) syphon-amounts resident-amounts))
;;    (tr-nr        (length (UC_Search supply-check true)))
;;    (enforce (= l0 tr-nr) "Invalid syphon amounts surpassing present resident Amounts")
;;i.e. it counts how many legs are within their resident amount and demands that be ALL of them. So
;;it fires when ANY single leg asks for more than is actually there -- the message means exactly what
;;it says, but the code says it by counting rather than by testing.
;;
;;THREE GUARDS ABOVE IT HAD TO BE CLEARED, and each shaped the input:
;;  * syphoning must be ON -- it ships OFF, so ATS|C_Control turns it on (a real client, not a write);
;;  * the amount list must be the same length as the reward-token list -- so all three legs are sent;
;;  * the SUM must stay under the syphon index -- measured at ~502 here, so one oversized leg at 300
;;    with zeros beside it clears the sum rule while still breaking the per-leg one. A flat
;;    "everything huge" list would have been stopped by the sum instead and pinned the wrong guard.
;;==== ATS-G21 - ATSU|C>SYPHON: per-token resident amounts bound the syphon · 02 · let / invocation ==== 
(print "--- [ATS-G21 - ATSU|C>SYPHON: per-token resident amounts bound the syphon · 02 · let / invocation] ---")
(let
    (
        (ref-ATS:module{AutostakeV3} ATS)
        (ref-TS01-C2:module{TalosStageOne_ClientTwoV2} TS01-C2)
        (ps:string "PlebeicStrength-98c486052a51")
    )
    ;;turn syphoning on through the ordinary control client (AOZ owns this pair)
    (ref-TS01-C2::ATS|C_Control KST.AOZT ps false true false)
    (let
        (
            (residents:[decimal] (ref-ATS::UR_RewardTokenRUR ps 1))
            (rt-count:integer (length (ref-ATS::UR_RewardTokenList ps)))
        )
        (map print
            [
                (expect "<<ATS-G21>> syphoning is now ON and the pair has three reward tokens"
                    [true 3] [(ref-ATS::UR_Syphoning ps) rt-count])
                ;;the premise the oversized leg is built from -- read live, so the number below
                ;;cannot go stale if the pair accrues more
                (expect "<<ATS-G21>> the first reward token's resident amount is under 300"
                    true (< (at 0 residents) 300.0))
                ;;THE ITEM -- leg 0 asks for more than exists, legs 1 and 2 ask for nothing
                (expect-failure "<<ATS-G21>> syphoning more than a leg's resident amount is refused"
                    "Invalid syphon amounts surpassing present resident Amounts"
                    (ref-TS01-C2::ATS|C_Syphon KST.ANHD KST.AOZT ps [300.0 0.0 0.0]))
                ;;...and a leg WITHIN its resident amount clears this rule. It does not necessarily
                ;;succeed outright -- what matters is that the resident bound stops answering, which
                ;;is what makes the refusal above about the amount and not about syphoning at all.
                (expect "<<ATS-G21>> ...while a leg within its resident amount is admitted"
                    true (!= "" (format "{}"
                        [(ref-TS01-C2::ATS|C_Syphon KST.ANHD KST.AOZT ps [1.0 0.0 0.0])])))
            ]
        )
        ""
    )
)
(env-sigs [])
;;syphoning-on and the admitted syphon are discarded -- ATS-G22 checks it
(rollback-tx)

;;|| NEXT >
;;|| ATS-G22 — the syphon probe left no trace.
;;
(begin-tx "ATS-G22 - no leakage")
(namespace "ouronet-ns")
(print "--- [ATS-G22 · 01 · no leakage] ---")
;;Syphoning ON changes what the pair permits, and the admitted syphon moved real reward tokens out
;;of residency. Later ATS assertions read those residents.
(print
    (expect "<<ATS-G22>> PlebeicStrength has syphoning switched off again"
        false (ATS.UR_Syphoning "PlebeicStrength-98c486052a51")))
(commit-tx)

;;|| NEXT >
;;
