(begin-tx "ATS-I35 — INFO_ATS|SetColdRecoveryFees quote vs measured charge")
(env-gasmodel "table")(env-gaslimit 100000000)(env-gas 0)
(namespace "ouronet-ns")
(print "--- [ATS-I35 · 01 · rewrite the cold-recovery fee ladder] ---")
;;FUNCTION COVERAGE (G6) — `INFO_ATS|SetColdRecoveryFees`, per the owner's spec. Template: <<ATS-I1>>.
;;
;;NAMED BY A SHAPE-CHECK, NEVER WEIGHED. `Stage_01/[6.11]_INFO.repl` calls this preview only to assert
;;the returned object `contains "ignis"` — which satisfies `_scale_report.py --untested`, a tool that
;;asks "was it reached", not "does the quote equal the charge". `REPL/tools/_info_measured.py` tells them apart.
;;
;;THE LADDER IS THE PRICE'S ONLY INTERESTING INPUT, and it does NOT move the cost: the fee ladder is a
;;single table write regardless of how many positions it carries. That is the claim this block settles —
;;the same shape as <<ATS-I12>>'s syphon, where the per-lane count DOES scale, so the two together say
;;which arguments reach a price and which are payload.
;;Auryndex is the pair with 7 cold-recovery positions (ATS-G19), so the ladder below is well-formed for
;;it; the whole block rolls back, leaving the live ladder untouched.
(env-sigs [{ "key": "PK_AncientHodler", "caps": [] }])
(let
    (
        (ref-TS01-C2:module{TalosStageOne_ClientTwoV2} TS01-C2)
        (ref-DALOS:module{OuronetDalosV2} DALOS)
        (aur:string "Auryndex-98c486052a51")
        (patron:string KST.ANHD)
        (thresholds:[decimal] [50.0 100.0 200.0 350.0 550.0 800.0])
        (ladder:[[decimal]]
            [ [8.0 7.0 6.0 5.0 4.0 3.0 2.0]
              [9.0 8.0 7.0 6.0 5.0 4.0 3.0]
              [10.0 9.0 8.0 7.0 6.0 5.0 4.0]
              [11.0 10.0 9.0 8.0 7.0 6.0 5.0]
              [12.0 11.0 10.0 9.0 8.0 7.0 6.0]
              [13.0 12.0 11.0 10.0 9.0 8.0 7.0]
              [14.0 13.0 12.0 11.0 10.0 9.0 8.0] ])
    )
    ;;SETUP — the ladder may only be rewritten while cold recovery is OFF (`08_ATS.pact:2360`), and
    ;;Auryndex runs it. The switch is itself a billed op, measured at <<ATS-I6>>, and closes here.
    (ref-TS01-C2::ATS|C_SwitchColdRecovery patron aur false)
    (let
        (
            (predicted:object{OuronetInfoV2.ClientInfo}
                (INFO-ONE.INFO_ATS|SetColdRecoveryFees patron aur 7 thresholds ladder))
            (ignis-before:decimal (ref-DALOS::UR_TF_AccountSupply patron false))
            (m (ref-TS01-C2::ATS|C_SetColdRecoveryFees patron aur 7 thresholds ladder))
        )
        (map print
            [
                (format "<<ATS-I35>> predicted={} real={}"
                    [(at "ignis-need" (at "ignis" predicted))
                     (- ignis-before (ref-DALOS::UR_TF_AccountSupply patron false))])
                (expect "<<ATS-I35>> INFO_ATS|SetColdRecoveryFees's quote equals what the op actually charged"
                    (- ignis-before (ref-DALOS::UR_TF_AccountSupply patron false))
                    (at "ignis-need" (at "ignis" predicted)))
                (expect "<<ATS-I35>> ...and it is a real, non-zero charge"
                    true (> (- ignis-before (ref-DALOS::UR_TF_AccountSupply patron false)) 0.0))
            ]
        )
    )
    ""
)
(env-sigs [])
(rollback-tx)

