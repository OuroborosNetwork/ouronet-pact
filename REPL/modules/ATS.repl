(begin-tx "ATS-G9 — the primal reward token, and the KickStart inflation ceiling")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(namespace "ouronet-ns")
(print "--- [ATS-G9 · 01 · primal RT removal + owner-path KickStart ceiling] ---")
;;P3.3. Two ATSU guards, both argument-driven against the pair this suite already owns.
;;
;;BOTH signatures again: PlebeicStrength is AOZ-owned, so CAP_Owner inside each cap rejects the
;;patron's key alone long before either guard is consulted.
;;==== ATS-G9 — the primal reward token, and the KickStart inflation ceiling · 01 · env-sigs (caps) ==== 
(print "--- [ATS-G9 — the primal reward token, and the KickStart inflation ceiling · 01 · env-sigs (caps)] ---")
(env-sigs [{ "key": "PK_AOZ", "caps": [] } { "key": "PK_AncientHodler", "caps": [] }])
(let*
    (
        (ref-ATS:module{AutostakeV3} ATS)
        (ref-U|ATS:module{UtilityAtsV3} U|ATS)
        (ref-TS01-C2:module{TalosStageOne_ClientTwoV2} TS01-C2)
        (ps:string "PlebeicStrength-98c486052a51")
        (rts:[string] (ref-ATS::UR_RewardTokenList ps))
        (primal:string (at 0 rts))
        (amts:[decimal] (make-list (length rts) 1000.0))
    )
    (map print
        [
            ;;precondition, and it doubles as the contrast the rejection needs: the guard keys on
            ;;POSITION, not on the token. Position 0 is the primal and is protected; positions 1
            ;;and 2 are secondaries and are removable. Asserting all three shows the guard
            ;;DISCRIMINATES rather than refusing every removal -- the positive half cannot be
            ;;driven here, because actually removing a secondary would mutate the shared pair.
            (expect "<<ATS-G9>> the RT list is primal-first, with two removable secondaries"
                [0 1 2]
                [(ref-ATS::URCv_RewardTokenPosition ps primal)
                 (ref-ATS::URCv_RewardTokenPosition ps (at 1 rts))
                 (ref-ATS::URCv_RewardTokenPosition ps (at 2 rts))])
            ;;--- the primal RT defines the pair; removing it would leave a pair whose stake
            ;;accounting has no base token to convert into the RBT.
            (expect-failure "<<ATS-G9>> the PRIMAL reward token cannot be removed"
                "Primal RT cannot be removed"
                (ref-TS01-C2::ATS|CC_RemoveSecondary KST.ANHD KST.ANHD ps primal))
            ;;--- audit fix #11M / M2. The opening index prices every later stake, so an owner who
            ;;could kickstart at an arbitrary ratio could mint themselves an unbounded claim
            ;;against everyone who coils in afterwards. 100.0 is the owner-path ceiling; a higher
            ;;ratio has to go through A_KickStart under module governance instead.
            ;;
            ;;The amounts list is built at the pair's OWN arity -- (make-list (length rts) …) --
            ;;precisely so the arity guard pinned by ATS-G5 cannot be what answers here. With
            ;;three 1000.0 amounts against a 1.0 request the resulting index is 3000.0.
            (expect "<<ATS-G9>> ...and the amounts are correctly sized, with an index far over 100"
                true (and (= (length amts) (length rts))
                          (> (ref-U|ATS::UC_KickStartIndex amts 1.0) 100.0)))
            (expect-failure "<<ATS-G9>> an owner-path KickStart above index 100.0 is refused"
                "KickStart index cannot exceed 100.0"
                (ref-TS01-C2::ATS|C_KickStart KST.ANHD KST.ANHD ps amts 1.0))
        ]
    )
    ""
)
(env-sigs [])
(commit-tx)

