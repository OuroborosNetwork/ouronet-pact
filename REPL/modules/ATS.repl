;;|| NEXT >
;;
(begin-tx "ATS-I12 — INFO_ATS|Syphon: a per-lane composer with a zero-guard on every lane")
(env-gasmodel "table")(env-gaslimit 100000000)(env-gas 0)
(namespace "ouronet-ns")
(print "--- [ATS-I12 · 01 · syphon two of three lanes] ---")
;;FUNCTION COVERAGE (G6) — `INFO_ATS|Syphon`, per the owner's spec: the preview must quote what the
;;op really charges.
;;
;;THE LAST UNTESTED ATS COMPOSER, and structurally the most interesting of them. `URCi_Syphon`
;;(10_ATSU.pact:1150) MAPS over the pair's reward-token list and emits a `TFT::URCi_Transfer` leg
;;ONLY where the syphon amount is > 0, EOC otherwise. The exec `C_Syphon` (:2110) FOLDS over the
;;same list with the same > 0 test, but each live lane additionally runs `ATS::XE_UpdateRUR` before
;;its `TFT::C_Transfer`. So: a map against a fold, four args against five, and a per-lane branch on
;;both sides that must agree lane-for-lane.
;;
;;THE AMOUNTS ARE CHOSEN TO EXERCISE BOTH BRANCHES IN ONE CALL — lanes 0 and 2 are live, lane 1 is
;;zero. A single-lane test would pass even if the zero-guard were dropped (an EOC leg costs nothing
;;to ADD, but a wrongly-priced one costs something to omit); with a zero lane sandwiched between two
;;live ones, a preview that priced all three, or that lost the index alignment between
;;`syphon-amounts` and `rt-lst`, produces a different number.
;;
;;PlebeicStrength is AOZ-owned, so both keys sign: the patron's for gas, the owner's for CAP_Owner
;;(the ATS-G6 lesson).
;;
;;SYPHONING IS OFF AT THIS POINT IN THE FILE — ATS-G7c deliberately restored it so ATS-G2's
;;precondition keeps holding downstream. So this block re-enables it exactly the way ATS-G7a does,
;;reading the other two control flags back UNCHANGED, and then takes `ignis-before` AFTER that
;;control call. That ordering is the whole point: `C_Control` bills IGNIS of its own, and folding it
;;into the window would silently inflate the measured syphon charge.
(env-sigs [{ "key": "PK_AOZ", "caps": [] } { "key": "PK_AncientHodler", "caps": [] }])
(let*
    (
        (ref-TS01-C2:module{TalosStageOne_ClientTwoV2} TS01-C2)
        (ref-DALOS:module{OuronetDalosV2} DALOS)
        (ref-ATS:module{AutostakeV3} ATS)
        (ps:string "PlebeicStrength-98c486052a51")
        (patron:string KST.ANHD)
        (target:string KST.ANHD)
        ;;lane 0 and lane 2 live, lane 1 deliberately zero
        (amounts:[decimal] [10.0 0.0 5.0])
    )
    ;;setup, OUTSIDE the measurement window
    (ref-TS01-C2::ATS|C_Control patron ps
        (ref-ATS::UR_CanChangeOwner ps) true (ref-ATS::UR_Hibernate ps))
    (let
        (
            (predicted:object{OuronetInfoV2.ClientInfo}
                (INFO-ONE.INFO_ATS|Syphon patron target ps amounts))
            (ignis-before:decimal (ref-DALOS::UR_TF_AccountSupply patron false))
            (m (ref-TS01-C2::ATS|C_Syphon patron target ps amounts))
        )
        (map print
            [
                (expect "<<ATS-I12>> the fixture really has a live lane, a zero lane and a live lane"
                    3 (length (ref-ATS::UR_RewardTokenList ps)))
                (format "<<ATS-I12>> predicted={} real={}"
                    [(at "ignis-need" (at "ignis" predicted))
                     (- ignis-before (ref-DALOS::UR_TF_AccountSupply patron false))])
                (expect "<<ATS-I12>> the per-lane quote equals what the syphon actually charged"
                    (- ignis-before (ref-DALOS::UR_TF_AccountSupply patron false))
                    (at "ignis-need" (at "ignis" predicted)))
                (expect "<<ATS-I12>> ...and it is a real, non-zero charge"
                    true (> (- ignis-before (ref-DALOS::UR_TF_AccountSupply patron false)) 0.0))
                (expect "<<ATS-I12>> the syphoned lanes really moved, and the zero lane did not"
                    true
                    (and (> 264.583106375739947690098299 (at 0 (ref-ATS::UR_RewardTokenRUR ps 1)))
                         (= 157.808111503548072043096151 (at 1 (ref-ATS::UR_RewardTokenRUR ps 1)))))
            ]
        )
    )
    ""
)
(env-sigs [])
(rollback-tx)

