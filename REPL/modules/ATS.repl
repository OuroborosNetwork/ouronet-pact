(begin-tx "ATS-G13 — hibernation fronts both Coil and Curl, and Curl checks BOTH pairs")
(env-gasmodel "table")(env-gaslimit 150000000)(env-gas 0)
(namespace "ouronet-ns")
;;==== ATS-G13 — hibernation fronts both Coil and Curl, and Curl checks BOTH pairs · 01 · env-sigs (caps) ==== 
(print "--- [ATS-G13 — hibernation fronts both Coil and Curl, and Curl checks BOTH pairs · 01 · env-sigs (caps)] ---")
(env-sigs [{ "key": "PK_AncientHodler", "caps": [] }])
(print "--- [ATS-G13 · 01 · the hibernation gate] ---")
;;Two unpinned guards, and neither needed a fixture: Auryndex and KORIndex are ALREADY hibernating by
;;the time this file's earlier transactions are done. They had simply never been coiled or curled in
;;that state. Check the chain before building anything -- that is three guards today closed this way.
;;
;;Coil converts an RT into an RBT; Curl moves an RT between two pairs. Hibernation freezes a pair's
;;index, so both operations are refused while it is on -- otherwise the conversion would price against
;;a frozen index.
;;
;;The reward token is read from the pair rather than hardcoded: ATSU|C>COIL runs
;;UEV_RewardTokenExistance BEFORE the hibernation enforce, so a wrong token id gets the existence
;;error instead and the hibernation guard is never reached. (That is exactly what happened on the
;;first attempt -- "true Existance isnt verified for Token AURYN…", because AURYN is not Auryndex's
;;RT. Its RT is OURO.)
;;==== ATS-G13 — hibernation fronts both Coil and Curl, and Curl checks BOTH pairs · 02 · let / invocation ==== 
(print "--- [ATS-G13 — hibernation fronts both Coil and Curl, and Curl checks BOTH pairs · 02 · let / invocation] ---")
(let
    (
        (ref-ATS:module{AutostakeV3} ATS)
        (ref-TS01-C2:module{TalosStageOne_ClientTwoV2} TS01-C2)
        (a:string "Auryndex-98c486052a51")
        (k:string "KORIndex-98c486052a51")
        (sl:string "StoaLiquindex-98c486052a51")
    )
    (map print
        [
            ;;the precondition, asserted so both refusals are attributable to hibernation and not to
            ;;some other property of these two pairs
            (expect "<<ATS-G13>> both Auryndex and KORIndex are hibernating here"
                [true true] [(ref-ATS::UR_Hibernate a) (ref-ATS::UR_Hibernate k)])
            (expect "<<ATS-G13>> ...while StoaLiquindex is not -- the contrast pair"
                false (ref-ATS::UR_Hibernate sl))
            ;;GUARD 1: Coil, refused and naming the pair
            (expect-failure "<<ATS-G13>> a hibernating pair cannot be coiled"
                "Cannot Coil when Auryndex-98c486052a51 has Hibernation turned on"
                (ref-TS01-C2::ATS|C_Coil KST.ANHD KST.ANHD a
                    (at 0 (ref-ATS::UR_RewardTokenList a)) 1.0))
            ;;GUARD 2: Curl, with BOTH pairs hibernating. The message names both.
            (expect-failure "<<ATS-G13>> ...and a curl between two hibernating pairs is refused"
                "Curl requires both Auryndex-98c486052a51 and KORIndex-98c486052a51 to have Hibernation set to off"
                (ref-TS01-C2::ATS|C_Curl KST.ANHD KST.ANHD a k
                    (at 0 (ref-ATS::UR_RewardTokenList a)) 1.0))
            ;;...and the SECOND pair alone is enough to refuse. The guard is
            ;;(and (not h1) (not h2)), so a reader could easily take it for a check on ats1 only --
            ;;this drives the case where ats1 is awake and ats2 is not, which is the half that a
            ;;single-pair test would miss entirely.
            (expect-failure "<<ATS-G13>> ...and an AWAKE source still cannot curl into a SLEEPING target"
                "to have Hibernation set to off"
                (ref-TS01-C2::ATS|C_Curl KST.ANHD KST.ANHD sl a
                    (at 0 (ref-ATS::UR_RewardTokenList sl)) 1.0))
        ]
    )
    ""
)
(env-sigs [])
(commit-tx)

