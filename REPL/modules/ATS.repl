(begin-tx "ATS-I37 — INFO_ATS|Brumate quote vs measured charge")
(env-gasmodel "table")(env-gaslimit 100000000)(env-gas 0)
(namespace "ouronet-ns")
(print "--- [ATS-I37 · 01 · curl into a HIBERNATING second pair] ---")
;;FUNCTION COVERAGE (G6) — `INFO_ATS|Brumate`, per the owner's spec. Template: <<ATS-I1>>.
;;THE GAS METER READS AOZT, the op's own patron — see <<ATS-I25>>.
;;
;;NAMED BY A COMMENTED-OUT LINE IN `[6.6]_ATS.repl`, NEVER WEIGHED — see `REPL/tools/_info_measured.py`.
;;BRUMATE IS CURL WITH INVERTED POLARITY on the destination: `ats1` must be awake and `ats2`
;;HIBERNATING, where Curl wants both awake. So the same chain is reused and pair 2 is put to sleep
;;first — one `C_Control` call, which is a billed op measured at <<ATS-I13>> and closes before the
;;window. Measuring both against ONE fixture is what makes the delta attributable to the op.
(env-sigs
  [ { "key": "PK_AOZ", "caps": [] }
    { "key": "PK_AncientHodler", "caps": [] }
    { "key": "95a59029029524ebb250b2fafe6826ff88bb59c527d661cba3279d09a51d3bdf"
    , "caps":
      [
        (coin.TRANSFER "k:95a59029029524ebb250b2fafe6826ff88bb59c527d661cba3279d09a51d3bdf" "k:50d6c59b21e5e6e55baecaa75a1007de37576bde12d8230dc82459cc01b9484b" 1000000.0)
        (coin.TRANSFER "k:95a59029029524ebb250b2fafe6826ff88bb59c527d661cba3279d09a51d3bdf" "k:0cb30c0121ff919266121a99ff9359871818932211df94dae4137c29bc0e8f7e" 1000000.0)
        (coin.TRANSFER "k:95a59029029524ebb250b2fafe6826ff88bb59c527d661cba3279d09a51d3bdf" "c:XM-pkmuB5XUQlp87ZYSbfKt8qzmHY6O2EHAzMRVBt3k" 1000000.0)
        (coin.TRANSFER "k:95a59029029524ebb250b2fafe6826ff88bb59c527d661cba3279d09a51d3bdf" "c:iQQFWj6gWtpGEzhM_O5ekW1QtnQQy55R8BRPGhj_0FU" 1000000.0)
      ] } ])
(let
    (
        (ref-TS01-C1:module{TalosStageOne_ClientOneV2} TS01-C1)
        (ref-TS01-C2:module{TalosStageOne_ClientTwoV2} TS01-C2)
        (ref-DALOS:module{OuronetDalosV2} DALOS)
        (ref-DPTF:module{DemiourgosPactTrueFungibleV2} DPTF)
        (ref-ATS:module{AutostakeV3} ATS)
        (ps:string "PlebeicStrength-98c486052a51")
        (aozt:string KST.AOZT)
        (emma:string KST.EMMA)
        (p1:string "GtChainPair1-98c486052a51")
        (p2:string "GtChainPair2-98c486052a51")
        (tok:string "PKOSON-98c486052a51")
    )
    ;;SETUP — TWO PAIRS SHARING ONE REWARD TOKEN, built from scratch.
    ;;WHAT "CHAINED" MEANS HERE — TWO conditions, and each one alone looks like the whole rule:
    ;;  1] `ATSU|C>CURL` (`10_ATSU.pact:422`) enforces `UEV_RewardTokenExistance ats1 curl-token true`
    ;;     — the `rt` ARGUMENT must be a reward token of ats1. Here that is PKOSON.
    ;;  2] the exec body then resolves that position INTO ats2 via `URCv_RewardTokenPosition ats2
    ;;     <ats1's cold-RBT>` (`08_ATS.pact:1649`) — so ats2's reward token must BE ats1's cold-RBT.
    ;;Satisfying only (1) gives "RT GTX1 isnt not an RT in the ATS-Pair GtChainPair2"; satisfying only
    ;;(2) gives "Existance isnt verified for Token ... as RT with ATS Pair ...". Both messages name a
    ;;token and neither names the relationship, so each failure reads like the other rule.
    ;;No standing pair forms this shape awake — Auryndex -> EliteAuryndex exists but Auryndex
    ;;hibernates, and Curl requires hibernation OFF at both ends. So both are issued virgin; they are
    ;;born awake, which is what Curl wants and what Brumate inverts.
    (ref-TS01-C1::DPTF|C_Issue aozt aozt ["GtChainRbt1"] ["GTX1"] [24] [true] [true] [true] [true] [true] [true])
    (ref-TS01-C1::DPTF|C_Issue aozt aozt ["GtChainRbt2"] ["GTX2"] [24] [true] [true] [true] [true] [true] [true])
    (ref-TS01-C2::ATS|C_Issue aozt aozt ["GtChainPair1"] [24]
        [(at 0 (ref-ATS::UR_RewardTokenList ps))] [false] ["GTX1-98c486052a51"] [true])
    (ref-TS01-C2::ATS|C_Issue aozt aozt ["GtChainPair2"] [24]
        ["GTX1-98c486052a51"] [false] ["GTX2-98c486052a51"] [true])
    ;;...and a real position in pair 1 to curl OUT of: coil PKOSON in, which mints pair-1's cold-RBT.
    (ref-TS01-C2::ATS|C_Coil aozt aozt "GtChainPair1-98c486052a51" (at 0 (ref-ATS::UR_RewardTokenList ps)) 5.0)
    ;;...and pair-2's cold-RBT needs a HIBERNATING counterpart before it can be brumated into:
    ;;`08_ATS.pact:593` runs `DPTF::UEV_Hibernation <ats2 cold-rbt> true`, and a freshly issued DPTF
    ;;has no `H|` twin. `VST|C_CreateHibernatingLink` mints one; it is a STOA-charging op measured on
    ;;its own at `modules/VST.repl <<VST-I1>>`, and closes before the window opens.
    (ref-TS01-C2::VST|C_CreateHibernatingLink aozt "GTX2-98c486052a51")
    (ref-TS01-C2::ATS|C_Control aozt p2 (ref-ATS::UR_CanChangeOwner p2) (ref-ATS::UR_Syphoning p2) true)
    (let
        (
            ;;the coil above put 5.0 PKOSON into pair 1; curl a fraction of it so the position survives
            (amount:decimal 1.0)
        )
        (let
            (
                (predicted:object{OuronetInfoV2.ClientInfo} (INFO-ONE.INFO_ATS|Brumate aozt aozt p1 p2 tok amount 30))
                (ignis-before:decimal (ref-DALOS::UR_TF_AccountSupply aozt false))
            )
            (let
                (
                    (m (ref-TS01-C2::ATS|C_Brumate aozt aozt p1 p2 tok amount 30))
                )
                (map print
                    [
                        (format "<<ATS-I37>> amount={} predicted={} real={}"
                            [amount (at "ignis-need" (at "ignis" predicted))
                             (- ignis-before (ref-DALOS::UR_TF_AccountSupply aozt false))])
                        ;;the chain really funded something, so the op is not of nothing
                        (expect "<<ATS-I37>> the setup coil really minted a curlable position"
                            true (> (ref-DPTF::UR_AccountSupply "GTX1-98c486052a51" aozt) 0.0))
                        (expect "<<ATS-I37>> INFO_ATS|Brumate's quote equals what the op actually charged"
                            (- ignis-before (ref-DALOS::UR_TF_AccountSupply aozt false))
                            (at "ignis-need" (at "ignis" predicted)))
                        (expect "<<ATS-I37>> ...and it is a real, non-zero charge"
                            true (> (- ignis-before (ref-DALOS::UR_TF_AccountSupply aozt false)) 0.0))
                    ]
                )
            )
        )
    )
    ""
)
(env-sigs [])
(rollback-tx)

