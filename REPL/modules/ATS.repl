(begin-tx "ATS-BRD — ATS|C_UpgradeBranding, and an INFO reader that cannot run")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(namespace "ouronet-ns")
(print "--- [ATS-BRD · 01 · branding upgrade on an ATS pair] ---")
;;ATS|C_UpgradeBranding appeared in no live invocation anywhere in the suite.
;;==== ATS-BRD — ATS|C_UpgradeBranding, and an INFO reader that cannot run · 01 · env-sigs (caps) ==== 
(print "--- [ATS-BRD — ATS|C_UpgradeBranding, and an INFO reader that cannot run · 01 · env-sigs (caps)] ---")
(env-sigs
    [
        { "key": "PK_AncientHodler", "caps": [] }
        { "key": "6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263",
          "caps":
            [
                (coin.TRANSFER "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263"
                    "k:50d6c59b21e5e6e55baecaa75a1007de37576bde12d8230dc82459cc01b9484b" 100000.0)
                (coin.TRANSFER "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263"
                    "k:0cb30c0121ff919266121a99ff9359871818932211df94dae4137c29bc0e8f7e" 100000.0)
                (coin.TRANSFER "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263"
                    "c:XM-pkmuB5XUQlp87ZYSbfKt8qzmHY6O2EHAzMRVBt3k" 100000.0)
                (coin.TRANSFER "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263"
                    "c:iQQFWj6gWtpGEzhM_O5ekW1QtnQQy55R8BRPGhj_0FU" 100000.0)
            ]
        }
    ]
)
;;==== ATS-BRD — ATS|C_UpgradeBranding, and an INFO reader that cannot run · 02 · let / invocation ==== 
(print "--- [ATS-BRD — ATS|C_UpgradeBranding, and an INFO reader that cannot run · 02 · let / invocation] ---")
(let
    (
        (ref-BRD:module{BrandingV2} BRD)
        (ref-TS01-C2:module{TalosStageOne_ClientTwoV2} TS01-C2)
        (patron:string KST.ANHD)
        (auryndex:string "Auryndex-98c486052a51")
    )
    (let ((f0:integer (at "flag" (ref-BRD::UR_Branding auryndex false))))
        (ref-TS01-C2::ATS|C_UpgradeBranding patron auryndex 3)
        (let ((b:object{BrandingV2.Schema} (ref-BRD::UR_Branding auryndex false)))
            (map print
                [
                    ;;Branding flag is a TIER that counts DOWN as branding improves; an upgraded
                    ;;entity lands on 1. Reading it as "higher is better" is backwards.
                    (expect "<<ATS-BRD>> the upgrade moved the tier to 1"
                        1 (at "flag" b))
                    (expect "<<ATS-BRD>> ...which is at least as good as where it started"
                        true (<= (at "flag" b) f0))
                    ;;<months> buys months measured from NOW, because this entity's premium had
                    ;;lapsed. Three months = 90 days on the clock.
                    ;;
                    ;;THIS ASSERTION USED TO READ `(add-time (at "genesis" b) (days 90))`, with the
                    ;;comment "<months> buys months measured from branding genesis, not from now."
                    ;;That was the BUG written down as the rule -- and it is a large part of why the
                    ;;bug survived. Before the 2026-09-12 fixes, BRD|DEFAULT was a `defconst` whose
                    ;;<genesis> and <premium-until> were the same frozen module-load timestamp, and
                    ;;XE_UpgradeBranding extended from the STORED premium -- so "genesis + 90 days"
                    ;;was exactly what came out, and it looked like a deliberate design.
                    ;;
                    ;;It was not: the buyer was paying for months measured from a date already gone.
                    ;;See 2026-09-12-branding-premium-paid-for-elapsed-time.md and SWP-G24.
                    ;;
                    ;;LESSON: an assertion that merely restates what the code does, with a comment
                    ;;that rationalises it, converts a defect into a requirement. A test earns the
                    ;;right to state a rule only when somebody checked the rule is the intended one.
                    (expect "<<ATS-BRD>> three months of premium were bought, measured from NOW"
                        (add-time (at "block-time" (chain-data)) (days 90))
                        (at "premium-until" b))
                    ;;...and explicitly NOT from genesis, which is what it used to be. Named so a
                    ;;revert of either fix fails here instead of silently passing again.
                    (expect "<<ATS-BRD>> ...and NOT from branding genesis, which is the old defect"
                        true (!= (add-time (at "genesis" b) (days 90)) (at "premium-until" b)))
                ]
            )
        )
    )
    ""
)
(print "--- [ATS-BRD · 02 · FIXED: INFO_ATS|Cull can execute] ---")
;;INFO-ONE+.pact:2465 used to build this preview's description with
;;      (format "Operation: Culls the Cold Recovery Positions, recovering RTs")
;;-- a ONE-ARGUMENT (format …). Pact's format takes a template AND an argument list, so the call was
;;an arity error that resolved to a closure and died with "Expected Pact Value, got closure or table
;;reference". It sat on the SUCCESS path, not a rejection path, so INFO_ATS|Cull was broken for EVERY
;;input: no client could price a cull.
;;
;;FIXED 2026-09-12, owner-authorised -- the same class as the missing `format` at 15_SWP.pact:466.
;;All FIVE sites that shared this shape are repaired, and each one sat on a branch no test reached:
;;      ATS.pact:883          Hot-RBT enforce message   (rejection path -- pinned by ATS-G15)
;;      LIQUID.pact:125       migration guard message   (rejection path)
;;      INFO-ONE+.pact:2465   THIS one                  (success path -- always)
;;      DSP+.pact:360         "nothing to distribute"   (normal empty case)
;;      DPL-UR.pact:2430      "KPay Sale has concluded" (normal end state)
;;
;;The earlier note here proposed `[]` as the second argument, matching DALOS.pact:489. The repair
;;taken instead was to DROP `format`: none of the five templates contains a `{}`, so a plain string
;;literal is what every one of them wanted, and it removes the call rather than patching it.
;;
;;A REGRESSION DETECTOR now covers the shape codebase-wide:
;;`python3 tools/_conformance.py --rule format-no-arglist`, which must stay at 0. It found two MORE sites
;;than the obvious grep -- in 00_DPMF -- because their templates wrap across lines with
;;`\`-continuation. Those two are a worse shape (a `{}` with no args at all) and are deliberately
;;left: DPMF is dead, and guessing the forgotten argument there is churn.
(let
    (
        (ref-INFO-ONE:module{InfoOneV2} INFO-ONE)
        (patron:string KST.ANHD)
    )
    (map print
        [
            ;;the preview now returns its description instead of dying. Asserted on the SENTENCE, not
            ;;on "it returned something": the whole defect was that this exact string never arrived.
            (expect "<<ATS-BRD>> INFO_ATS|Cull now returns its description"
                true (contains "Culls the Cold Recovery Positions"
                    (format "{}" [(ref-INFO-ONE::INFO_ATS|Cull patron patron "Auryndex-98c486052a51")])))
        ]
    )
    ""
)
(print "===^^^===")
(commit-tx)

