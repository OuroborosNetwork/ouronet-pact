    (ref-TS01-C1::DPTF|C_Issue aozt aozt ["GtHotRbtColdProbe"] ["GTHC"] [24] [true] [true] [true] [true] [true] [true])
    (ref-TS01-C2::ATS|C_Issue aozt aozt ["GtHotPairProbe"] [24]
        [(at 0 (ref-ATS::UR_RewardTokenList ps))] [false] ["GTHC-98c486052a51"] [true])
    (ref-TS01-C1::DPOF|C_Issue aozt aozt ["GtHotRbtProbe"] ["GTHR"] [24] [true] [true] [true] [true] [true] [true] [true])
    (let
