(begin-tx "ATS-G3 — the URCv_ band: two derivations that refuse to answer a nonsense question")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
;;==== ATS-G3 — the URCv_ band: two derivations that refuse to answer a nonsense question · 01 · namespace ==== 
(print "--- [ATS-G3 — the URCv_ band: two derivations that refuse to answer a nonsense question · 01 · namespace] ---")
(namespace "ouronet-ns")
(print "--- [ATS-G3 · 01 · RT position and RBT split bound] ---")
;;Both guards here sit on URCv_ functions -- the enforce is INTRINSIC to the derivation rather
;;than a business rule layered on it (CLAUDE.md § prefixes, the `v` role). Neither needs a
;;capability or a state change; the rejecting input is an argument, which makes them among the
;;cheapest guards remaining in the P3.3 worklist.
;;
;;  URCv_RewardTokenPosition  returns WHERE a reward token sits in the pair's definition. For a
;;                            token that isn't in the pair there is no such position, and the
;;                            fallback would be index 0 -- silently the FIRST reward token. That
;;                            is the failure mode the enforce exists to prevent, so the test
;;                            asserts the real token's position as well as the ghost's refusal.
;;
;;  URCv_RTSplitAmounts       converts an RBT amount into the RT amounts it represents. Above
;;                            the pair's own RBT supply the conversion is meaningless, and the
;;                            bound is derived from the LIVE supply rather than a constant so it
;;                            stays exact whatever the pair currently holds.
;;==== ATS-G3 — the URCv_ band: two derivations that refuse to answer a nonsense question · 02 · let / invocation ==== 
(print "--- [ATS-G3 — the URCv_ band: two derivations that refuse to answer a nonsense question · 02 · let / invocation] ---")
(let
    (
        (ref-ATS:module{AutostakeV3} ATS)
        (ps:string "PlebeicStrength-98c486052a51")
    )
    (let
        (
            (rts:[string] (ref-ATS::UR_RewardTokenList ps))
            (rbt-supply:decimal (ref-ATS::URC_PairRBTSupply ps))
        )
        (map print
            [
                ;;--- position. The happy case must pin an ACTUAL index, not merely "it didn't
                ;;throw": index 0 is what a broken lookup would also return.
                (expect "<<ATS-G3>> the pairs first reward token reports position 0"
                    0 (ref-ATS::URCv_RewardTokenPosition ps (at 0 rts)))
                (expect-failure "<<ATS-G3>> a token that isnt an RT of this pair has NO position"
                    "isnt not an RT in the ATS-Pair"
                    (ref-ATS::URCv_RewardTokenPosition ps "OURO-98c486052a51"))
                ;;--- split bound, at and past the live RBT supply
                (expect "<<ATS-G3>> the pair carries an RBT supply to split against"
                    true (> rbt-supply 0.0))
                (expect "<<ATS-G3>> splitting EXACTLY the whole RBT supply is allowed (inclusive bound)"
                    true (> (length (ref-ATS::URCv_RTSplitAmounts ps rbt-supply)) 0))
                (expect-failure "<<ATS-G3>> ...and one unit beyond it is refused"
                    "Cannot compute for amounts greater than the pairs rbt supply"
                    (ref-ATS::URCv_RTSplitAmounts ps (+ rbt-supply 1.0)))
            ]
        )
        ""
    )
)
(commit-tx)

