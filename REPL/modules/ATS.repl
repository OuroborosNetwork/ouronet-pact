(begin-tx "ATS-G26a — give the attacker a token of her own, so the FIRST owner gate can pass")
(print "")
(print "=== ATS-G26 — ATS|C>ADD-REWARD-TOKEN: two owner gates, one behind the other ===")
(namespace "ouronet-ns")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
;;`ATS|C>ADD-REWARD-TOKEN` carries TWO ownership checks in sequence:
;;
;;    (enforce (<= n 6) "An ATS Pair can have a maximum of 7 RTs")   <- business
;;    (ref-DPTF::CAP_Owner reward-token)                             <- gate 1: the TOKEN
;;    (CAP_Owner atspair)                                            <- gate 2: the PAIR
;;
;;and until this block neither had ever refused anybody. The trap is that the obvious attack cannot
;;tell them apart: every DPTF and every ATS pair in this suite is owned by ANHD, so BOTH gates fail
;;with the identical `Keyset failure (keys-all): [PK_Ancie...]`. An assertion on that message would
;;be green, unattributable, and would survive the deletion of gate 2 entirely.
;;
;;So the attacker is given a token she genuinely owns. With `CAP_Owner reward-token` passing by
;;construction, the same message can only be coming from `CAP_Owner atspair` -- ownership-behind-
;;ownership, separated by a fixture rather than by reading. This issuance is a legitimate client op,
;;not a table poke: EMMA pays her own STOA fee for it.
(env-sigs
    [
        { "key": "PK_Emma", "caps": [] }
        { "key": "ecaeae048b6e4b1d4cd9b5ba41041b39e05ac3a7b32f495a12823cb1c5ad0f48"
        , "caps":
            [
                (coin.TRANSFER "k:ecaeae048b6e4b1d4cd9b5ba41041b39e05ac3a7b32f495a12823cb1c5ad0f48"
                    "k:0cb30c0121ff919266121a99ff9359871818932211df94dae4137c29bc0e8f7e" 1000.0)
                (coin.TRANSFER "k:ecaeae048b6e4b1d4cd9b5ba41041b39e05ac3a7b32f495a12823cb1c5ad0f48"
                    "k:50d6c59b21e5e6e55baecaa75a1007de37576bde12d8230dc82459cc01b9484b" 1000.0)
                (coin.TRANSFER "k:ecaeae048b6e4b1d4cd9b5ba41041b39e05ac3a7b32f495a12823cb1c5ad0f48"
                    "c:XM-pkmuB5XUQlp87ZYSbfKt8qzmHY6O2EHAzMRVBt3k" 1000.0)
                (coin.TRANSFER "k:ecaeae048b6e4b1d4cd9b5ba41041b39e05ac3a7b32f495a12823cb1c5ad0f48"
                    "c:iQQFWj6gWtpGEzhM_O5ekW1QtnQQy55R8BRPGhj_0FU" 1000.0)
            ]
        }
    ]
)
(let
    (
        (ref-TS01-C1:module{TalosStageOne_ClientOneV2} TS01-C1)
    )
    (ref-TS01-C1::DPTF|C_Issue KST.EMMA KST.EMMA
        ["EmmaCoin"] ["EMCO"] [24] [true] [true] [true] [false] [false] [true])
    ""
)
(env-sigs [])
(commit-tx)

