(begin-tx "ATS-G2 — ATSU|C>SYPHON: the gate that fronts a six-guard family")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(namespace "ouronet-ns")
(print "--- [ATS-G2 · 01 · syphon admission] ---")
;;P3.3. ATSU|C>SYPHON carries SIX enforces in sequence: syphoning-on, list-length match, positive
;;sum, per-element non-negative, sum within the pair's Syphon-Index, and per-token resident
;;supply. The FIRST one gates every other -- with syphoning off, no input can reach guards 2..6,
;;so this is the only one live against a pair that has never had syphoning enabled.
;;
;;Pinned through Talos (ATS|C_Syphon) because that is the only supported client path; the
;;expected text is unique to ATSU, so nothing else can be credited for it.
;;==== ATS-G2 — ATSU|C>SYPHON: the gate that fronts a six-guard family · 01 · let / invocation ==== 
(print "--- [ATS-G2 — ATSU|C>SYPHON: the gate that fronts a six-guard family · 01 · let / invocation] ---")
(let
    (
        (ref-ATS:module{AutostakeV3} ATS)
        (ref-TS01-C2:module{TalosStageOne_ClientTwoV2} TS01-C2)
        (patron:string KST.ANHD)
        (ps:string "Auryndex-98c486052a51")
    )
    ;;OWNERSHIP FIRST. ATSU|C>SYPHON runs (ref-ATS::CAP_Owner ats) BEFORE the syphoning enforce,
    ;;so the pair must be one this patron owns or the keyset failure masks the guard entirely --
    ;;the first draft aimed at PlebeicStrength (owned by PK_AOZ) and got
    ;;"Keyset failure (keys-all): [PK_AOZ...]" instead of the message under test. Auryndex is the
    ;;pair the admin ops at the top of this file already drive as ANHD.
    (env-sigs [{ "key": "PK_AncientHodler", "caps": [] }])
    (map print
        [
            ;;precondition -- the rejection below means nothing unless syphoning really is off
            (expect "<<ATS-G2>> syphoning is OFF on Auryndex" false (ref-ATS::UR_Syphoning ps))
            (expect-failure "<<ATS-G2>> C_Syphon is refused while syphoning is off"
                "Syphoning must be turned ON for exec"
                (ref-TS01-C2::ATS|C_Syphon patron patron ps [1.0]))
            ;;...and the rejected call wrote nothing.
            (expect "<<ATS-G2>> syphoning is still OFF after the rejection"
                false (ref-ATS::UR_Syphoning ps))
        ]
    )
    ;;--- ADVERSARIAL WINDOW: syphoning ON.
    ;;Guard 1 above fronts five more, and with syphoning off none of them has a live input
    ;;anywhere in the corpus -- every suite leaves this flag false. ATS|C_Control writes it (via
    ;;XI_Control) and is reversible, so the pair is moved into the rejecting state, the guards
    ;;behind it are pinned, and the flag is put back. The other two control flags are read and
    ;;written back unchanged so nothing else about the pair moves.
    (let
        (
            (cco:bool (ref-ATS::UR_CanChangeOwner ps))
            (hib:bool (ref-ATS::UR_Hibernate ps))
            (rts:integer (length (ref-ATS::UR_RewardTokenList ps)))
        )
        (ref-TS01-C2::ATS|C_Control patron ps cco true hib)
        (map print
            [
                (expect "<<ATS-G2>> syphoning is now ON" true (ref-ATS::UR_Syphoning ps))
                ;;GUARD 2: the amounts list must match the reward-token list length. Derived from
                ;;the live pair, never hardcoded -- a constant here would silently stop testing
                ;;the rule the day a reward token is added.
                (expect-failure "<<ATS-G2>> a syphon-amounts list of the wrong length is refused"
                    "Invalid Amounts of Syphon Values"
                    (ref-TS01-C2::ATS|C_Syphon patron patron ps (make-list (+ rts 1) 1.0)))
                ;;GUARD 3: correct length, but nothing actually syphoned. Isolates the sum rule --
                ;;guard 2 cannot fire on this input.
                (expect-failure "<<ATS-G2>> an all-zero syphon is refused as a no-op"
                    "Invalid Syphon Amounts"
                    (ref-TS01-C2::ATS|C_Syphon patron patron ps (make-list rts 0.0)))
                ;;GUARD 4 (per-element non-negativity) IS NOT REACHABLE ON THIS PAIR, and the
                ;;reason is structural rather than a fixture gap. It sits below guard 3
                ;;(<sum> > 0.0), so the input must carry a negative element AND still total
                ;;positive -- which takes at least TWO elements. Auryndex carries exactly one
                ;;reward token (asserted below), so any negative list is also a negative sum and
                ;;guard 3 fires first. Pinning guard 4 needs a pair with >= 2 reward tokens.
                ;;
                ;;Asserted rather than assumed: if a reward token is ever added to this pair the
                ;;assertion below fails and this note stops being true.
                (expect "<<ATS-G2>> Auryndex carries ONE reward token, so guard 4 stays behind guard 3"
                    1 rts)
            ]
        )
        ;;RESTORE
        (ref-TS01-C2::ATS|C_Control patron ps cco false hib)
        (map print
            [
                (expect "<<ATS-G2>> syphoning restored to OFF" false (ref-ATS::UR_Syphoning ps))
                (expect "<<ATS-G2>> can-change-owner untouched" cco (ref-ATS::UR_CanChangeOwner ps))
                (expect "<<ATS-G2>> hibernate untouched" hib (ref-ATS::UR_Hibernate ps))
            ]
        )
    )
    ""
)
(env-sigs [])
(commit-tx)

