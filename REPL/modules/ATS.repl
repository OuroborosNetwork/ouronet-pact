(begin-tx "ATS-G4 — three constructors that refuse to build a nonsense object")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
;;==== ATS-G4 — three constructors that refuse to build a nonsense object · 01 · namespace ==== ===
(print "--- [ATS-G4 — three constructors that refuse to build a nonsense object · 01 · namespace] ---")
(namespace "ouronet-ns")
(print "--- [ATS-G4 · 01 · UDC_RT, UDC_BrandingFlag, UEV_TwentyFourPrecision] ---")
;;Three guards from three different modules, grouped because they are the same KIND of guard: a
;;constructor or a precision rule that validates its own arguments and touches no state. They
;;are tested together against the ATS fixture only because the branding one needs a real branded
;;asset to build FROM, and this suite already has one.
;;
;;UDC_RT is the interesting one. It builds a reward-token object with three decimal fields
;;(resident, unbonding, royalty) and folds all three into ONE enforce. A single negative input
;;would prove the fold fires, but not that it inspects every field -- a fold that dropped the
;;last two conjuncts would pass exactly the same test. So each field is driven negative on its
;;own, and the happy path pins the object it actually builds.
;;==== ATS-G4 — three constructors that refuse to build a nonsense object · 02 · let / invocation ==== 
(print "--- [ATS-G4 — three constructors that refuse to build a nonsense object · 02 · let / invocation] ---")
(let
    (
        (ref-ATS:module{AutostakeV3} ATS)
        (ref-BRD:module{BrandingV2} BRD)
        (ref-IGNIS:module{IgnisCollectorV3} IGNIS)
        (ps:string "PlebeicStrength-98c486052a51")
    )
    (map print
        [
            ;;--- UDC_RT: the object it builds, then each of the three fields refused in turn
            (expect "<<ATS-G4>> a zero-valued reward token object is built as specified"
                {"nfr": false, "resident": 0.0, "royalty": 0.0, "token": "X", "unbonding": 0.0}
                (ref-ATS::UDC_RT "X" false 0.0 0.0 0.0))
            (expect-failure "<<ATS-G4>> a negative RESIDENT amount is refused"
                "Negative Decimals unallowed for Reward Token Object"
                (ref-ATS::UDC_RT "X" false -1.0 0.0 0.0))
            (expect-failure "<<ATS-G4>> ...and a negative UNBONDING amount, which the same fold must also see"
                "Negative Decimals unallowed for Reward Token Object"
                (ref-ATS::UDC_RT "X" false 0.0 -1.0 0.0))
            (expect-failure "<<ATS-G4>> ...and a negative ROYALTY, the last conjunct in the fold"
                "Negative Decimals unallowed for Reward Token Object"
                (ref-ATS::UDC_RT "X" false 0.0 0.0 -1.0))
            ;;--- UDC_BrandingFlag: a small enum, so both ends of it are pinned. The input object
            ;;is the pair's LIVE branding row rather than a literal, which means the constructor
            ;;is exercised against the shape it really receives.
            (expect "<<ATS-G4>> flag 4 — the top of the range — is accepted"
                4 (at "flag" (ref-BRD::UDC_BrandingFlag (ref-BRD::UR_Branding ps false) 4)))
            (expect "<<ATS-G4>> flag 0 — the bottom — likewise"
                0 (at "flag" (ref-BRD::UDC_BrandingFlag (ref-BRD::UR_Branding ps false) 0)))
            (expect-failure "<<ATS-G4>> ...and 5, one past the top, is refused"
                "Invalid Flag Integer"
                (ref-BRD::UDC_BrandingFlag (ref-BRD::UR_Branding ps false) 5))
            (expect-failure "<<ATS-G4>> ...as is -1, one below the bottom"
                "Invalid Flag Integer"
                (ref-BRD::UDC_BrandingFlag (ref-BRD::UR_Branding ps false) -1))
            ;;--- IGNIS precision. 24 decimals is the token's own precision, so the boundary is
            ;;an amount that uses exactly 24 and one that needs a 25th.
            (expect "<<ATS-G4>> an amount using exactly 24 decimals is a valid GAS amount"
                true (ref-IGNIS::UEV_TwentyFourPrecision 0.000000000000000000000001))
            (expect-failure "<<ATS-G4>> ...and a 25th decimal is not"
                "is not a valid GAS Amount decimal wise"
                (ref-IGNIS::UEV_TwentyFourPrecision 0.0000000000000000000000001))
        ]
    )
    ""
)
(commit-tx)

