(begin-tx "ATS-I11 — INFO_ATS|ColdRecovery, a hand-rebuilt multi-leg preview")
(env-gasmodel "table")(env-gaslimit 100000000)(env-gas 0)
(namespace "ouronet-ns")
(print "--- [ATS-I11 · 01 · a composer preview, measured] ---")
;;FUNCTION COVERAGE (G6) — `INFO_ATS|ColdRecovery`, per the owner's spec.
;;
;;WHY THIS SUBSET OF THE ATS FAMILY IS WORTH MEASURING FIRST. Most previews call the SAME `URCi_` the
;;exec bills, so they cannot drift. A handful — the "composer" previews — instead REBUILD the exec's
;;cumulator chain by hand out of sub-op readers. `URCi_Coil` re-derives three legs
;;(transfer / mint / transfer); `URCi_Curl` re-derives four where the exec composes five. Two
;;independent expressions that must evaluate equal is precisely the shape that produced six of the
;;defects found tonight (the inject family and both citizen sales), and it is the shape no static
;;check can settle — an aggregate naming different functions from the exec is CORRECT by design.
;;
;;`Coil` is already covered by <<ATS-I1>>. This adds the recovery composer.
(env-sigs [{ "key": "PK_AncientHodler", "caps": [] } { "key": "PK_Emma", "caps": [] }])
(let
    (
        (ref-TS01-C2:module{TalosStageOne_ClientTwoV2} TS01-C2)
        (ref-DALOS:module{OuronetDalosV2} DALOS)
        (sl:string "StoaLiquindex-98c486052a51")
        (patron:string KST.ANHD)
        (emma:string KST.EMMA)
    )
    (let
        (
            (predicted:object{OuronetInfoV2.ClientInfo}
                (INFO-ONE.INFO_ATS|ColdRecovery patron emma sl 0.1))
            (ignis-before:decimal (ref-DALOS::UR_TF_AccountSupply patron false))
            (m (ref-TS01-C2::ATS|C_ColdRecovery patron emma sl 0.1))
        )
        (map print
            [
                (format "<<ATS-I11>> predicted={} real={}"
