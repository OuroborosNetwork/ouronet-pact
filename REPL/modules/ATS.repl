(begin-tx "ATS-I31 — INFO_ATS|DirectRecovery quote vs measured charge")
(env-gasmodel "table")(env-gaslimit 100000000)(env-gas 0)
(namespace "ouronet-ns")
(print "--- [ATS-I31 · 01 · recover directly out of a coiled position] ---")
;;FUNCTION COVERAGE (G6) — `INFO_ATS|DirectRecovery`, per the owner's spec. Template: <<ATS-I1>>.
;;THE GAS METER READS AOZT, the op's own patron — see <<ATS-I25>> for why reading the file's ANHD
;;instead yields a flat 0.0 that passes silently whenever the quote is also zero.
;;
;;DIRECT RECOVERY IS THE THIRD RECOVERY PATH and prices differently from the other two: `URCi_Cold`
;;and `URCi_Hot` each open with a flat construct (2x and 3x biggest), while `URCi_DirectRecovery` has
;;NONE — it is cold-transfer + cold-burn + a multi-transfer of the fee-adjusted split. That missing
;;flat leg is the whole delta against <<ATS-I11>>'s cold recovery, which is why both are measured.
;;
;;SETUP, outside the window, and all of it forced by the file's own state:
;;  1] a coil, to mint the cold-RBT there is anything to recover FROM. PlebeicStrength is the pair the
;;     suite coils with AOZT (AOZT holds PKOSON; ANHD does not — <<ATS-I1>>), and its hibernation is
;;     OFF, which Coil requires and Constrict forbids.
;;  2] direct recovery switched ON, derived rather than asserted: <<ATS-I27>> flips all three
;;     recoveries off inside its own rollback, so the state here depends on what ran before.
;;Both setup ops are billed and measured separately (<<ATS-I1>>, <<ATS-I7>>), so they close first.
(env-sigs [{ "key": "PK_AOZ", "caps": [] } { "key": "PK_AncientHodler", "caps": [] }])
(let
    (
        (ref-TS01-C2:module{TalosStageOne_ClientTwoV2} TS01-C2)
        (ref-DALOS:module{OuronetDalosV2} DALOS)
        (ref-DPTF:module{DemiourgosPactTrueFungibleV2} DPTF)
        (ref-ATS:module{AutostakeV3} ATS)
        (ps:string "PlebeicStrength-98c486052a51")
        (aozt:string KST.AOZT)
    )
    (ref-TS01-C2::ATS|C_Coil aozt aozt ps (at 0 (ref-ATS::UR_RewardTokenList ps)) 5.0)
    (if (not (ref-ATS::UR_ToggleDirectRecovery ps))
        (ref-TS01-C2::ATS|C_SwitchDirectRecovery aozt ps true)
        "direct recovery already on")
    (let
        (
            ;;recover a FRACTION of what the coil just minted, so the position survives the op and the
            ;;charge is not entangled with a full-close branch
            (held:decimal (ref-DPTF::UR_AccountSupply (ref-ATS::UR_ColdRewardBearingToken ps) aozt))
        )
        (let
            (
                (ra:decimal (floor (/ held 2.0) 12))
            )
            (let
                (
                    (predicted:object{OuronetInfoV2.ClientInfo}
                        (INFO-ONE.INFO_ATS|DirectRecovery aozt aozt ps ra))
                    (ignis-before:decimal (ref-DALOS::UR_TF_AccountSupply aozt false))
                )
                (let
                    (
                        (m (ref-TS01-C2::ATS|C_DirectRecovery aozt aozt ps ra))
                    )
                    (map print
                        [
                            (format "<<ATS-I31>> held={} ra={} predicted={} real={}"
                                [held ra (at "ignis-need" (at "ignis" predicted))
                                 (- ignis-before (ref-DALOS::UR_TF_AccountSupply aozt false))])
                            ;;the coil really funded something, so the recovery is not of nothing
                            (expect "<<ATS-I31>> the setup coil really minted a recoverable position"
                                true (> ra 0.0))
                            (expect "<<ATS-I31>> INFO_ATS|DirectRecovery's quote equals what the op actually charged"
                                (- ignis-before (ref-DALOS::UR_TF_AccountSupply aozt false))
                                (at "ignis-need" (at "ignis" predicted)))
                            (expect "<<ATS-I31>> ...and it is a real, non-zero charge"
                                true (> (- ignis-before (ref-DALOS::UR_TF_AccountSupply aozt false)) 0.0))
                        ]
                    )
                )
            )
        )
    )
    ""
)
(env-sigs [])
(rollback-tx)

