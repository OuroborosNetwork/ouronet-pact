(begin-tx "ATS-I27 — INFO_ATS|RemoveSecondary quote vs measured charge")
(env-gasmodel "table")(env-gaslimit 100000000)(env-gas 0)
(namespace "ouronet-ns")
(print "--- [ATS-I27 · 01 · drop a secondary reward token] ---")
;;FUNCTION COVERAGE (G6) — `INFO_ATS|RemoveSecondary`, per the owner's spec: an INFO_ must report the same cost
;;the op actually charges. Template and rationale: `modules/ATS.repl <<ATS-I1>>`.
;;THE GAS METER MUST READ THE OP'S PATRON, NOT THE FILE'S. These hot-RBT / secondary ops are paid
;;by AOZT (the entity's owner), so differencing ANHD's IGNIS gives a flat 0.0 and the equality
;;passes only when the quote is ALSO zero — a false green on every IGNIS-charging op in the family.
;;EXEC PREFIX IS `CC_`, not `C_` (`03_TS01-C2.pact:81`) — the doubled letter marks a heavy scan in
;;the tree. The reward token is READ at position 1 rather than named: position 0 is the PRIMAL token
;;and cannot be removed, so a literal there would trip an unrelated guard.
(env-sigs
  [ { "key": "PK_AOZ", "caps": [] }
    { "key": "PK_AncientHodler", "caps": [] }
    { "key": "6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263"
    , "caps":
      [
        (coin.TRANSFER "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263" "k:50d6c59b21e5e6e55baecaa75a1007de37576bde12d8230dc82459cc01b9484b" 1000000.0)
        (coin.TRANSFER "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263" "k:0cb30c0121ff919266121a99ff9359871818932211df94dae4137c29bc0e8f7e" 1000000.0)
        (coin.TRANSFER "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263" "c:XM-pkmuB5XUQlp87ZYSbfKt8qzmHY6O2EHAzMRVBt3k" 1000000.0)
        (coin.TRANSFER "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263" "c:iQQFWj6gWtpGEzhM_O5ekW1QtnQQy55R8BRPGhj_0FU" 1000000.0) ] }
    { "key": "95a59029029524ebb250b2fafe6826ff88bb59c527d661cba3279d09a51d3bdf"
    , "caps":
      [
        (coin.TRANSFER "k:95a59029029524ebb250b2fafe6826ff88bb59c527d661cba3279d09a51d3bdf" "k:50d6c59b21e5e6e55baecaa75a1007de37576bde12d8230dc82459cc01b9484b" 1000000.0)
        (coin.TRANSFER "k:95a59029029524ebb250b2fafe6826ff88bb59c527d661cba3279d09a51d3bdf" "k:0cb30c0121ff919266121a99ff9359871818932211df94dae4137c29bc0e8f7e" 1000000.0)
        (coin.TRANSFER "k:95a59029029524ebb250b2fafe6826ff88bb59c527d661cba3279d09a51d3bdf" "c:XM-pkmuB5XUQlp87ZYSbfKt8qzmHY6O2EHAzMRVBt3k" 1000000.0)
        (coin.TRANSFER "k:95a59029029524ebb250b2fafe6826ff88bb59c527d661cba3279d09a51d3bdf" "c:iQQFWj6gWtpGEzhM_O5ekW1QtnQQy55R8BRPGhj_0FU" 1000000.0) ] } ])
(let
    (
        (ref-TS01-C2:module{TalosStageOne_ClientTwoV2} TS01-C2)
        (ref-DALOS:module{OuronetDalosV2} DALOS)
        (ref-ATS:module{AutostakeV3} ATS)
        (aur:string "Auryndex-98c486052a51")
        (kor:string "KORIndex-98c486052a51")
        (ps:string "PlebeicStrength-98c486052a51")
        (ddk:string "DDKOSON-98c486052a51")
        (patron:string KST.ANHD)
        (aozt:string KST.AOZT)
        (emma:string KST.EMMA)
    )
    ;;SETUP, outside the measurement window — `ATSU|C>X_REMOVE-SECONDARY` fronts itself with
    ;;ALL THREE recovery-state guards set to false, and PlebeicStrength has them on at this
    ;;point in the chain. They fail one at a time, so the first error names cold recovery and hides the
    ;;other two — all three are switched here. Each switch is itself a billed op (measured separately at
    ;;<<ATS-I6>> and <<ATS-I7>>), so they close before `ignis-before` is read.
    (ref-TS01-C2::ATS|C_SwitchColdRecovery aozt ps false)
    (ref-TS01-C2::ATS|C_SwitchHotRecovery aozt ps false)
    (ref-TS01-C2::ATS|C_SwitchDirectRecovery aozt ps false)
    (let
        (
            (predicted:object{OuronetInfoV2.ClientInfo} (INFO-ONE.INFO_ATS|RemoveSecondary aozt aozt ps (at 1 (ref-ATS::UR_RewardTokenList ps))))
            (ignis-before:decimal (ref-DALOS::UR_TF_AccountSupply aozt false))
            (stoa-before:decimal (coin.get-balance (ref-DALOS::UR_AccountStoa aozt)))
            (m (ref-TS01-C2::ATS|CC_RemoveSecondary aozt aozt ps (at 1 (ref-ATS::UR_RewardTokenList ps))))
        )
        (map print
            [
                (format "<<ATS-I27>> IGNIS predicted={} real={} | STOA predicted={} real={}"
                    [(at "ignis-need" (at "ignis" predicted))
                     (- ignis-before (ref-DALOS::UR_TF_AccountSupply aozt false))
                     (at "stoa-need" (at "stoa" predicted))
                     (- stoa-before (coin.get-balance (ref-DALOS::UR_AccountStoa aozt)))])
                (expect "<<ATS-I27>> the IGNIS quote equals the IGNIS charged"
                    (- ignis-before (ref-DALOS::UR_TF_AccountSupply aozt false))
                    (at "ignis-need" (at "ignis" predicted)))
                (expect "<<ATS-I27>> the STOA quote equals the STOA charged"
                    (- stoa-before (coin.get-balance (ref-DALOS::UR_AccountStoa aozt)))
                    (at "stoa-need" (at "stoa" predicted)))
                (expect "<<ATS-I27>> ...and the operation is NOT free"
                    true (> (+ (- ignis-before (ref-DALOS::UR_TF_AccountSupply aozt false))
                               (- stoa-before (coin.get-balance (ref-DALOS::UR_AccountStoa aozt)))) 0.0))
            ]
        )
    )
    ""
)
(env-sigs [])
(rollback-tx)

