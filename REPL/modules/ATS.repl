(begin-tx "ATS-I39 — INFO_ATS|WithdrawRoyalties quote vs measured charge")
(env-gasmodel "table")(env-gaslimit 100000000)(env-gas 0)
(namespace "ouronet-ns")
(print "--- [ATS-I39 · 01 · withdraw accrued royalties] ---")
;;FUNCTION COVERAGE (G6) — `INFO_ATS|WithdrawRoyalties`, per the owner's spec. Template: <<ATS-I1>>.
;;THE GAS METER READS AOZT, the op's own patron — see <<ATS-I25>>.
;;
;;NAMED BY A SHAPE-CHECK, NEVER WEIGHED, and previously filed as "no fixture" because
;;`<<ATS-G6>>` asserts every standing pair has collected ZERO royalties and pins the refusal
;;("No Royalties to withdraw for ATS-Pair"). That is a fact about the STANDING state, not about the op:
;;royalties accrue from coils once a pair HAS a royalty set, and no standing pair does.
;;So the fixture is built rather than found — the eighth time that move has settled one of these.
;;
;;SETUP, all outside the window:
;;  1] a virgin cold-RBT and a virgin pair, born awake and royalty-free;
;;  2] a royalty set on it (`C_UpdateRoyalty`, measured at <<ATS-I3>>);
;;  3] a coil through it, which is what actually ACCRUES the royalty into the pair's RUR ledger.
;;Without step 3 the withdrawal would hit exactly the guard ATS-G6 pins, and the block would be
;;measuring a refusal rather than a price.
(env-sigs
  [ { "key": "PK_AOZ", "caps": [] }
    { "key": "PK_AncientHodler", "caps": [] }
    { "key": "95a59029029524ebb250b2fafe6826ff88bb59c527d661cba3279d09a51d3bdf"
    , "caps":
      [
        (coin.TRANSFER "k:95a59029029524ebb250b2fafe6826ff88bb59c527d661cba3279d09a51d3bdf" "k:50d6c59b21e5e6e55baecaa75a1007de37576bde12d8230dc82459cc01b9484b" 1000000.0)
        (coin.TRANSFER "k:95a59029029524ebb250b2fafe6826ff88bb59c527d661cba3279d09a51d3bdf" "k:0cb30c0121ff919266121a99ff9359871818932211df94dae4137c29bc0e8f7e" 1000000.0)
        (coin.TRANSFER "k:95a59029029524ebb250b2fafe6826ff88bb59c527d661cba3279d09a51d3bdf" "c:XM-pkmuB5XUQlp87ZYSbfKt8qzmHY6O2EHAzMRVBt3k" 1000000.0)
        (coin.TRANSFER "k:95a59029029524ebb250b2fafe6826ff88bb59c527d661cba3279d09a51d3bdf" "c:iQQFWj6gWtpGEzhM_O5ekW1QtnQQy55R8BRPGhj_0FU" 1000000.0)
      ] } ])
(let
    (
        (ref-TS01-C1:module{TalosStageOne_ClientOneV2} TS01-C1)
        (ref-TS01-C2:module{TalosStageOne_ClientTwoV2} TS01-C2)
        (ref-DALOS:module{OuronetDalosV2} DALOS)
        (ref-ATS:module{AutostakeV3} ATS)
        (ps:string "PlebeicStrength-98c486052a51")
        (aozt:string KST.AOZT)
        (pair:string "GtRoyaltyPairProbe-98c486052a51")
    )
    (ref-TS01-C1::DPTF|C_Issue aozt aozt ["GtRoyaltyRbtProbe"] ["GTRY"] [24] [true] [true] [true] [true] [true] [true])
    (ref-TS01-C2::ATS|C_Issue aozt aozt ["GtRoyaltyPairProbe"] [24]
        [(at 0 (ref-ATS::UR_RewardTokenList ps))] [false] ["GTRY-98c486052a51"] [true])
    (ref-TS01-C2::ATS|C_UpdateRoyalty aozt pair 100.0)
    (ref-TS01-C2::ATS|C_Coil aozt aozt pair (at 0 (ref-ATS::UR_RewardTokenList ps)) 100.0)
    (let
        (
            (accrued:decimal (fold (+) 0.0 (ref-ATS::UR_RewardTokenRUR pair 3)))
        )
        (let
            (
                (predicted:object{OuronetInfoV2.ClientInfo}
                    (INFO-ONE.INFO_ATS|WithdrawRoyalties aozt pair aozt))
                (ignis-before:decimal (ref-DALOS::UR_TF_AccountSupply aozt false))
            )
            (let
                (
                    (m (ref-TS01-C2::ATS|C_WithdrawRoyalties aozt pair aozt))
                )
                (map print
                    [
                        ;;the precondition ATS-G6 could not satisfy, asserted rather than assumed
                        (expect "<<ATS-I39>> the coil really ACCRUED royalties, unlike every standing pair"
                            true (> accrued 0.0))
                        (format "<<ATS-I39>> accrued={} predicted={} real={}"
                            [accrued (at "ignis-need" (at "ignis" predicted))
                             (- ignis-before (ref-DALOS::UR_TF_AccountSupply aozt false))])
                        (expect "<<ATS-I39>> INFO_ATS|WithdrawRoyalties's quote equals what the op actually charged"
                            (- ignis-before (ref-DALOS::UR_TF_AccountSupply aozt false))
                            (at "ignis-need" (at "ignis" predicted)))
                        (expect "<<ATS-I39>> ...and it is a real, non-zero charge"
                            true (> (- ignis-before (ref-DALOS::UR_TF_AccountSupply aozt false)) 0.0))
                    ]
                )
            )
        )
    )
    ""
)
(env-sigs [])
(rollback-tx)

