(begin-tx "ATS-G15 — elite positions, index precision, and the Hot-RBT prefix exclusion")
(env-gasmodel "table")(env-gaslimit 150000000)(env-gas 0)
(namespace "ouronet-ns")
;;==== ATS-G15 — elite positions, index precision, and the Hot-RBT prefix exclusion · 01 · env-sigs (caps) ==== 
(print "--- [ATS-G15 — elite positions, index precision, and the Hot-RBT prefix exclusion · 01 · env-sigs (caps)] ---")
(env-sigs [{ "key": "PK_AncientHodler", "caps": [] }])
(print "--- [ATS-G15 · 01 · two guards the existing chain already satisfies] ---")
;;Neither of these needed a fixture. The pairs this suite builds already sit on the rejecting side,
;;and nothing had called the guards.
;;==== ATS-G15 — elite positions, index precision, and the Hot-RBT prefix exclusion · 02 · let / invocation ==== 
(print "--- [ATS-G15 — elite positions, index precision, and the Hot-RBT prefix exclusion · 02 · let / invocation] ---")
(let
    (
        (ref-ATS:module{AutostakeV3} ATS)
        (ref-TS01-C2:module{TalosStageOne_ClientTwoV2} TS01-C2)
        (a:string "Auryndex-98c486052a51")
        (k:string "KORIndex-98c486052a51")
    )
    (map print
        [
            ;;ELITE MODE requires SEVEN cold-recovery positions. -1 is the "unset" value, and KORIndex
            ;;carries it while Auryndex has the full seven -- so the two pairs are the two sides of
            ;;this guard and no state has to be written.
            (expect "<<ATS-G15>> KORIndex has no cold-recovery positions; Auryndex has seven"
                [-1 7] [(ref-ATS::UR_ColdRecoveryPositions k)
                        (ref-ATS::UR_ColdRecoveryPositions a)])
            (expect-failure "<<ATS-G15>> elite mode cannot be turned on without seven positions"
                "Turning Elite Mode requires 7 Cold Recovery Positions"
                (ref-TS01-C2::ATS|C_ToggleElite KST.ANHD k true))
            ;;INDEX PRECISION. The syphon value must be representable in the pair's own index decimals
            ;;-- 24 here -- so a 25-decimal value is refused. The guard is a `floor`-equality test,
            ;;which is how this codebase spells "no hidden rounding": accepting the value would
            ;;silently store something the caller did not ask for.
            (expect "<<ATS-G15>> the pair's index carries 24 decimals"
                24 (ref-ATS::UR_IndexDecimals a))
            (expect-failure "<<ATS-G15>> a syphon value with 25 decimals is refused, and quoted back"
                "The syphon value of 0.1234567890123456789012345 is not a valid Index Value for the Auryndex-98c486052a51 ATS Pair"
                (ref-TS01-C2::ATS|C_UpdateSyphon KST.ANHD a 0.1234567890123456789012345))
            ;;...and the same value truncated to 24 decimals is ACCEPTED, so the bound is the pair's
            ;;precision and not "long decimals are suspicious".
            (expect "<<ATS-G15>> ...while 24 decimals is accepted, so the bound IS the precision"
                true (!= "" (ref-TS01-C2::ATS|C_UpdateSyphon KST.ANHD a 0.123456789012345678901234)))
        ]
    )
    (print "--- [ATS-G15 · 02 · the Hot-RBT prefix exclusion, and the hole in it] ---")
    ;;ATS|C>ADD-HOT-RBT's comment states the rule: "Hot-RBT cannot be V|, Z| or H| -Tokens". The code is
    ;;    (enforce (not (contains hot-rbt-ftc ["V|" "Z|" "H"])) "Special Orto-Fungibles …")
    ;;where `hot-rbt-ftc` is `(take 2 hot-rbt)` -- ALWAYS two characters.
    ;;
    ;;THIS MESSAGE IS ALSO THE REGRESSION GUARD ON A FIX. It used to be wrapped in a one-argument
    ;;`(format "…")`, so the guard fired and then died on its own message with "Expected Pact Value,
    ;;got closure or table reference". Fixed 2026-09-12; see ATS-BRD · 02 for the full account of all
    ;;five sites that shared the shape.
    (map print
        [
            (expect-failure "<<ATS-G15>> a VESTING (V|) ortofungible is refused as a Hot-RBT"
                "Special Orto-Fungibles cannot be registered as Hot-RBTs"
                (ref-TS01-C2::ATS|C_AddHotRBT KST.ANHD a "V|AURYN-98c486052a51"))
            (expect-failure "<<ATS-G15>> ...and so is a SLEEPING (Z|) one"
                "Special Orto-Fungibles cannot be registered as Hot-RBTs"
                (ref-TS01-C2::ATS|C_AddHotRBT KST.ANHD a "Z|VST-98c486052a51"))
            ;;FIXED 2026-09-12, owner-ruled. The third entry in the exclusion list was "H" -- ONE
            ;;character -- while the value tested against it is `(take 2 hot-rbt)`, always TWO. So
            ;;`(contains "H|" ["V|" "Z|" "H"])` was FALSE and HIBERNATION tokens were not excluded at
            ;;all, contrary to the comment directly above the code. Every other prefix test in the
            ;;tree writes the pipe (02_SCORE.pact:2522/:2526); this was the only site missing it.
            ;;
            ;;The arithmetic of the bug, kept as pure computation because it needs no fixture and is
            ;;the clearest statement of what was wrong:
            (expect "<<ATS-G15>> the OLD list could not match a 2-char prefix; the NEW one can"
                [false true]
                [(contains "H|" ["V|" "Z|" "H"])
                 (contains "H|" ["V|" "Z|" "H|"])])
            ;;...and the consequence through the real client. BEFORE: an H| token was not stopped by
            ;;the prefix guard and reached the NEXT one, which caught this particular token only
            ;;because its supply happens to be non-zero -- a ZERO-supply hibernation token would have
            ;;been accepted as a Hot-RBT. AFTER: the prefix guard answers, whatever the supply.
            (expect "<<ATS-G15>> H|AURYN still carries a non-zero supply, so the old cover is still there"
                true (> (DPOF.UR_Supply "H|AURYN-98c486052a51") 0.0))
            (expect-failure "<<ATS-G15>> ...but the PREFIX guard now answers first, as its comment always said"
                "Special Orto-Fungibles cannot be registered as Hot-RBTs"
                (ref-TS01-C2::ATS|C_AddHotRBT KST.ANHD a "H|AURYN-98c486052a51"))
            ;;--- THE BLOCKERS FOR `06_DPOF.pact:2608` ("RBT-Data for DPOF {} is already set as
            ;;    ATS-Pair {}"), asserted rather than described, because they are FIXTURE facts and
            ;;    fixtures change.
            ;;
            ;;    That guard lives in DPOF::XE_UpdateRewardBearingToken and fires when a DPOF that is
            ;;    ALREADY some pair's hot-RBT is registered to a second one. Reaching it needs a
            ;;    hot-RBT that is (a) already registered, (b) ZERO supply -- ATS|C>ADD-HOT-RBT's own
            ;;    supply rule answers first otherwise -- and (c) a target pair with no hot-RBT and
            ;;    cold recovery OFF.
            ;;
            ;;    This chain has no such combination, measured: DDKOSON is registered to
            ;;    PlebeicStrength but carries stake, and the only pair without a hot-RBT (Auryndex)
            ;;    has cold recovery ON, which its own gate refuses before DPOF is ever called.
            ;;    Three independent blockers, in three different modules.
            ;;
            ;;    THAT ROUTE WAS WALKED AND IT DEAD-ENDS. The note here used to propose "issue a
            ;;    fresh zero-supply DPOF, register it as one pair's hot-RBT, then attempt the same
            ;;    registration on a second pair", and estimated the blocker as a missing third ATS
            ;;    pair. Both halves were wrong: the fixture already exists (THRBT is TestKickPair's
            ;;    hot-RBT at supply 0.0), and the real blocker is a can-upgrade latch that no fixture
            ;;    can get around. Driven to the wall and pinned below as <<ATS-G23>>.
            (expect "<<ATS-G15>> DDKOSON is already a pair's hot-RBT, but carries stake"
                [true true]
                [(!= (DPOF.UR_RewardBearingToken "DDKOSON-98c486052a51") (U|CT.CT_BAR))
                 (> (DPOF.UR_Supply "DDKOSON-98c486052a51") 0.0)])
            (expect "<<ATS-G15>> ...and the one pair with no hot-RBT has cold recovery ON"
                [(U|CT.CT_BAR) true]
                [(ref-ATS::UR_HotRewardBearingToken "Auryndex-98c486052a51")
                 (ref-ATS::UR_ToggleColdRecovery "Auryndex-98c486052a51")])
            ;;THE SUPPLY GUARD STILL NEEDS ITS OWN INPUT, and this is the part the fix nearly cost.
            ;;Before the prefix repair, `H|AURYN` was the only thing reaching the zero-supply rule --
            ;;so tightening the prefix guard silently UNPINNED it. The gate caught that (coverage
            ;;dropped by one), which is the case for measuring coverage after a source change and not
            ;;only for running the suite.
            ;;`DDKOSON` is the chain's only NON-special ortofungible with a positive supply, so it is
            ;;the one input that clears the prefix rule and is then refused on supply alone.
            (expect "<<ATS-G15>> DDKOSON is non-special and carries a supply"
                [true true]
                [(not (contains (take 2 "DDKOSON-98c486052a51") ["V|" "Z|" "H|"]))
                 (> (DPOF.UR_Supply "DDKOSON-98c486052a51") 0.0)])
            (expect-failure "<<ATS-G15>> ...so it clears the prefix rule and is refused on SUPPLY"
                "Cannot Add OrtoFungible with non Zero Supply as ATS-Pair Hot RBT"
                (ref-TS01-C2::ATS|C_AddHotRBT KST.ANHD a "DDKOSON-98c486052a51"))
        ]
    )
    ""
)
(env-sigs [])
;;the accepted syphon update above changed a pair parameter
(rollback-tx)

;;|| NEXT >
;;
(begin-tx "ATS-G15b — the syphon update was rolled back")
(namespace "ouronet-ns")
(print "--- [ATS-G15b · 01 · no leakage] ---")
;;ATS-G15 accepted one syphon update to prove the precision bound is a threshold rather than a
;;blanket refusal. That write is rolled back here, because the syphon index feeds URC_MaxSyphon and
;;therefore every syphon assertion in ATS-G2.
(print
    (expect "<<ATS-G15b>> Auryndex's syphon is not the 24-decimal probe value"
        true (!= 0.123456789012345678901234 (ATS.UR_Syphon "Auryndex-98c486052a51"))))
(commit-tx)

;;|| NEXT >
