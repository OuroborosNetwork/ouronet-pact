(begin-tx "ATS-G7b — the two syphon-amount guards, each reached past the one before it")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(namespace "ouronet-ns")
(print "--- [ATS-G7b · 01 · syphon amount bounds] ---")
;;The amount checks run in sequence: positive sum, then per-element non-negative, then the pair's
;;Syphon-Index ceiling. An all-negative list has a negative SUM and so trips the first check, not
;;the per-element one — so the negative case below is MIXED-SIGN, with a positive total. That is the
;;same construction the SWPL mixed-sign test needed, and for the same reason.
;;
;;The list length is derived from the pair's reward-token count, because a length mismatch would
;;trip its own guard earlier still.
;;==== ATS-G7b — the two syphon-amount guards, each reached past the one before it · 01 · env-sigs (caps) ==== 
(print "--- [ATS-G7b — the two syphon-amount guards, each reached past the one before it · 01 · env-sigs (caps)] ---")
(env-sigs [{ "key": "PK_AOZ", "caps": [] } { "key": "PK_AncientHodler", "caps": [] }])
(let*
    (
        (ref-TS01-C2:module{TalosStageOne_ClientTwoV2} TS01-C2)
        (ref-ATS:module{AutostakeV3} ATS)
        (ps:string "PlebeicStrength-98c486052a51")
        (n:integer (length (ref-ATS::UR_RewardTokenList ps)))
        (mixed:[decimal] (+ [-1.0 100.0] (make-list (- n 2) 1.0)))
    )
    (map print
        [
            (expect "<<ATS-G7b>> the mixed list has a POSITIVE sum, so the sum guard cannot answer"
                true (> (fold (+) 0.0 mixed) 0.0))
            (expect-failure "<<ATS-G7b>> a negative element inside a positive-sum list is refused"
                "Unallowed Negative Syphon Values Detected"
                (ref-TS01-C2::ATS|C_Syphon KST.ANHD KST.ANHD ps mixed))
            ;;all positive, correct length, but far beyond what the pair's Syphon-Index permits
            (expect-failure "<<ATS-G7b>> ...and an all-positive list beyond the Syphon-Index ceiling"
                "Syphon Amounts surpassing pairs Syphon-Index"
                (ref-TS01-C2::ATS|C_Syphon KST.ANHD KST.ANHD ps (make-list n 1000000.0)))
        ]
    )
    ""
)
(commit-tx)

