(begin-tx "ATS-I1 — THE INFO COST TEMPLATE: predicted cost vs what the op actually charges")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(namespace "ouronet-ns")
(print "--- [ATS-I1 · 01 · INFO_ATS|Coil predicted vs measured] ---")
;;FUNCTION COVERAGE (G6) — THE CANONICAL `INFO_` VERIFICATION, per the owner's spec:
;;
;;    "their test is that they output the same values that their execution counterparts cost"
;;
;;This block is the TEMPLATE the rest of the INFO_ family follows. Three specs were possible and
;;only this one is worth writing:
;;
;;  1] `INFO_X.ignis-need == <hardcoded>`  -- BRITTLE, and it has already failed silently once:
;;     `[6.5]_AQP-INFO.repl` pinned four anchor costs at 1000.0, task #76 replaced the inline gas
;;     constants with a computed price (574.0), and the suite was ORPHANED -- nothing caught it.
;;  2] `INFO_X.ignis-need == URCi_X`       -- TAUTOLOGICAL. `INFO_X` is literally built from
;;     `URCi_X` via `OI|UDC_DynamicIgnisCost`, so this compares an expression to itself.
;;  3] `INFO_X.ignis-need == what executing X actually charges` -- THE ONLY ONE WITH AN INDEPENDENT
;;     ORACLE, and the owner's spec. That is what this does.
;;
;;THE MEASUREMENT. `IGNIS::C_Collect` debits the patron, so the real cost is the patron's IGNIS
;;balance before minus after, around a live execution with the SAME arguments the preview was given.
;;`ClientInfo` carries both currencies -- `ignis.ignis-need` and `stoa.stoa-need` -- so both are
;;measured: IGNIS from `DALOS::UR_TF_AccountSupply <patron> false`, STOA from `coin.get-balance`.
;;
;;A dormant precedent for this existed at `_scratch_infoone_h6_coil_cost.repl` -- written for DALOS
;;audit #11H, quoting the same owner instruction -- but it is an UNGATED scratch written against the
;;since-removed V1 interfaces, so nothing has been enforcing it. This is the gated version.
;;==== ATS-I1 — THE INFO COST TEMPLATE: predicted cost vs what the op actually charges · 01 · env-sigs (caps) ==== 
(print "--- [ATS-I1 — THE INFO COST TEMPLATE: predicted cost vs what the op actually charges · 01 · env-sigs (caps)] ---")
(env-sigs [{ "key": "PK_AOZ", "caps": [] } { "key": "PK_AncientHodler", "caps": [] }])
;;==== ATS-I1 — THE INFO COST TEMPLATE: predicted cost vs what the op actually charges · 02 · let / invocation ==== 
(print "--- [ATS-I1 — THE INFO COST TEMPLATE: predicted cost vs what the op actually charges · 02 · let / invocation] ---")
(let
    (
        (ref-TS01-C2:module{TalosStageOne_ClientTwoV2} TS01-C2)
        (ref-DALOS:module{OuronetDalosV2} DALOS)
        (ref-ATS:module{AutostakeV3} ATS)
        ;;AOZT is the account the suite coils PlebeicStrength with -- it holds the PKOSON reward
        ;;token. ANHD does not, and a coil it cannot fund aborts on the debit rather than pricing.
        (patron:string KST.AOZT)
        (ats:string "PlebeicStrength-98c486052a51")
        (amount:decimal 5.0)
    )
    (let
        (
            (rt:string (at 0 (ref-ATS::UR_RewardTokenList ats)))
        )
        (let
            (
                ;;PREDICTED — read BEFORE anything executes, exactly as a client would
                (predicted:object{OuronetInfoV2.ClientInfo}
                    (INFO-ONE.INFO_ATS|Coil patron patron ats rt amount))
                (ignis-before:decimal (ref-DALOS::UR_TF_AccountSupply patron false))
            )
            (let
                (
                    (predicted-ignis:decimal (at "ignis-need" (at "ignis" predicted)))
                )
                ;;REAL — the same op, same patron, same arguments
                (ref-TS01-C2::ATS|C_Coil patron patron ats rt amount)
                (let
                    (
                        (real-ignis:decimal (- ignis-before (ref-DALOS::UR_TF_AccountSupply patron false)))
                    )
                    (map print
                        [
                            (format "<<ATS-I1>> predicted={} real={}" [predicted-ignis real-ignis])
                            ;;THE SPEC: the quote a client is shown must be the price they pay.
                            (expect "<<ATS-I1>> INFO_ATS|Coil's predicted IGNIS equals what C_Coil actually charged"
                                real-ignis predicted-ignis)
                            ;;...and the figure is non-zero, so the equality is not 0 == 0. This is the
                            ;;guard against a preview that reports nothing and an op that charges
                            ;;nothing agreeing vacuously.
                            (expect "<<ATS-I1>> ...and it is a real, non-zero charge"
                                true (> real-ignis 0.0))
                        ]
                    )
                )
            )
        )
    )
    ""
)
(env-sigs [])
;;the coil is discarded -- this proof leaves no stake behind
(rollback-tx)

