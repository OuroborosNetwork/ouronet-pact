(begin-tx "ATS-G29 — the #32N soft-failure fix, which had no witness")
(print "")
(print "=== ATS-G29 — URC_MultiCull's empty branch returns an OBJECT ================")
(namespace "ouronet-ns")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
;;#32N / N1: `URC_MultiCull` used to return a raw `[decimal]` on its "nothing cullable" branch and an
;;OBJECT on the other. `XI_MultiCull` binds the result as `:object`, so the empty branch was a hard
;;type crash -- reachable by ANY account with a position that is simply not ripe yet, which is the
;;ordinary state of most stakers most of the time. The fix makes the empty branch return the same
;;4-key shape, and Talos reports it distinctly instead of dying.
;;
;;The fix was present and UNWITNESSED: the string "Nothing to Cull" appeared only in
;;`archive/_audit_ats_baseline.repl`, which `_gate.py` excludes by name as a retired probe. Reverting
;;the fix would have turned nothing red.
;;
;;THE ACCOUNT MATTERS. It must have a ledger row in the pair but nothing ripe -- an account with NO
;;row dies earlier, at a bare `read` in `UR_P0` (measured), which is a different failure entirely and
;;would witness nothing about #32N.
(env-sigs [{ "key": "PK_AncientHodler", "caps": [] }])
(let
    (
        (ref-ATS:module{AutostakeV3} ATS)
        (ref-TS01-C2:module{TalosStageOne_ClientTwoV2} TS01-C2)
    )
    (let
        (
            (pair:string (at 0 (ref-ATS::URH_OwnedAutostakePairs KST.ANHD)))
        )
        (map print
            [
                ;;THE FIX: the op RETURNS, and says why. Before it, this call crashed on a type
                ;;mismatch -- so the assertion that matters is simply that a sentence comes back.
                (expect "<<ATS-G29>> a staker with nothing ripe gets a SENTENCE, not a type crash"
                    true (contains "Nothing to Cull"
                        (ref-TS01-C2::ATS|C_Cull KST.ANHD KST.ANHD pair)))
            ]
        )
    )
    ""
)
(env-sigs [])
(rollback-tx)

