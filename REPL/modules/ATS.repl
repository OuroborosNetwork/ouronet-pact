    ;;SETUP — a virgin DPTF as the pair's cold-RBT, then a virgin pair, born at index -1.
    (ref-TS01-C1::DPTF|C_Issue aozt aozt ["GtKickColdProbe"] ["GTKC"] [24] [true] [true] [true] [true] [true] [true])
    (ref-TS01-C2::ATS|C_Issue aozt aozt ["GtKickPairProbe"] [24]
        [(at 0 (ref-ATS::UR_RewardTokenList ps))] [false] ["GTKC-98c486052a51"] [true])
    (let
