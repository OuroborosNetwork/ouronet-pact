(begin-tx "ATS-G12 -- the cold-recovery-position guard, both directions")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
;;==== ATS-G12 -- the cold-recovery-position guard, both directions · 01 · namespace ==== =========
(print "--- [ATS-G12 -- the cold-recovery-position guard, both directions · 01 · namespace] ---")
(namespace "ouronet-ns")
(print "--- [ATS-G12 . 01 . position 0 vs a real position] ---")
;;An unpinned guard from `python3 REPL/tools/_cheapseam.py`, selected because its `enforce` is the FIRST
;;statement in the function -- before any table read -- so it needs no fixture at all. Most of that
;;list does: of 37 non-dead candidates only three are reachable without building state first.
;;
;;URCv_ColdRecoveryFee prices a cold recovery at a given position. Position 0 means "no positions
;;left", and computing a fee for a position that does not exist would return a number a caller
;;could act on, so the guard refuses rather than returning 0.
(map print
    [
        (expect-failure "<<ATS-G12>> position 0 means no positions remain, and is refused"
            "Cannot Compute Cold Recovery Fee as no more Cold Recovery Positions are available"
            (ATS.URCv_ColdRecoveryFee "Auryndex-98c486052a51" 1.0 0))
        ;;the other direction, so this is not satisfied by a function that refuses everything:
        ;;a real position prices normally
        (expect "<<ATS-G12>> ...while a real position returns an actual fee"
            8.0 (ATS.URCv_ColdRecoveryFee "Auryndex-98c486052a51" 1.0 1))
    ]
)
(commit-tx)

