            (m (ref-TS01-C2::ATS|HOT-RBT|C_UpdatePendingBranding aozt ddk "ipfs://probe-logo" "cost probe" "https://probe.example" []))
        )
        (map print
            [
                (format "<<ATS-I26>> IGNIS predicted={} real={} | STOA predicted={} real={}"
                    [(at "ignis-need" (at "ignis" predicted))
                     (- ignis-before (ref-DALOS::UR_TF_AccountSupply aozt false))
                     (at "stoa-need" (at "stoa" predicted))
                     (- stoa-before (coin.get-balance (ref-DALOS::UR_AccountStoa aozt)))])
                (expect "<<ATS-I26>> the IGNIS quote equals the IGNIS charged"
                    (- ignis-before (ref-DALOS::UR_TF_AccountSupply aozt false))
                    (at "ignis-need" (at "ignis" predicted)))
                (expect "<<ATS-I26>> the STOA quote equals the STOA charged"
                    (- stoa-before (coin.get-balance (ref-DALOS::UR_AccountStoa aozt)))
                    (at "stoa-need" (at "stoa" predicted)))
                (expect "<<ATS-I26>> ...and the operation is NOT free"
                    true (> (+ (- ignis-before (ref-DALOS::UR_TF_AccountSupply aozt false))
                               (- stoa-before (coin.get-balance (ref-DALOS::UR_AccountStoa aozt)))) 0.0))
            ]
        )
    )
    ""
)
(env-sigs [])
(rollback-tx)

