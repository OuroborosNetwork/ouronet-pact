(begin-tx "ATS-I18 — INFO_ATS|ToggleElite quote vs measured charge")
(env-gasmodel "table")(env-gaslimit 100000000)(env-gas 0)
(namespace "ouronet-ns")
(print "--- [ATS-I18 · 01 · flip elite mode] ---")
;;FUNCTION COVERAGE (G6) — `INFO_ATS|ToggleElite`, per the owner's spec: an INFO_ must report the same cost
;;the op actually charges. Template and rationale: `modules/ATS.repl <<ATS-I1>>`.
;;The value is derived by negation rather than written as a literal: these toggles refuse a no-op,
;;so a hardcoded `true` breaks the moment an earlier block leaves the pair in that state.
;;AURYNDEX, because `ATS|C>TOGGLE-ELITE` additionally demands exactly 7 cold-recovery positions and
;;Auryndex is the only pair that has them (ATS-G19). It is also still non-elite, so the flip is real.
(env-sigs [{ "key": "PK_AncientHodler", "caps": [] }])
(let*
    (
        (ref-TS01-C2:module{TalosStageOne_ClientTwoV2} TS01-C2)
        (ref-DALOS:module{OuronetDalosV2} DALOS)
        (ref-ATS:module{AutostakeV3} ATS)
        (aur:string "Auryndex-98c486052a51")
        (kor:string "KORIndex-98c486052a51")
        (sl:string "StoaLiquindex-98c486052a51")
        (ea:string "EliteAuryndex-98c486052a51")
        (ps:string "PlebeicStrength-98c486052a51")
        (tkp:string "TestKickPair-98c486052a51")
        (patron:string KST.ANHD)
        (aozt:string KST.AOZT)
        (emma:string KST.EMMA)
    )
    ;;SETUP, outside the measurement window — `ATS|C>TOGGLE-ELITE` wants BOTH 7 cold-recovery positions
    ;;AND cold recovery switched OFF, and no pair in the file satisfies both at once: Auryndex has the
    ;;positions but runs cold recovery. Switching it off is itself a billed op (measured separately at
    ;;<<ATS-I6>>), so it closes here before `ignis-before` is read.
    (ref-TS01-C2::ATS|C_SwitchColdRecovery patron aur false)
    (let
        (
            (predicted:object{OuronetInfoV2.ClientInfo} (INFO-ONE.INFO_ATS|ToggleElite patron aur (not (ref-ATS::UR_EliteMode aur))))
            (ignis-before:decimal (ref-DALOS::UR_TF_AccountSupply patron false))
            (m (ref-TS01-C2::ATS|C_ToggleElite patron aur (not (ref-ATS::UR_EliteMode aur))))
        )
        (map print
            [
                (expect "<<ATS-I18>> INFO_ATS|ToggleElite's quote equals what the op actually charged"
                    (- ignis-before (ref-DALOS::UR_TF_AccountSupply patron false))
                    (at "ignis-need" (at "ignis" predicted)))
                (expect "<<ATS-I18>> ...and it is a real, non-zero charge"
                    true (> (- ignis-before (ref-DALOS::UR_TF_AccountSupply patron false)) 0.0))
            ]
        )
    )
    ""
)
(env-sigs [])
(rollback-tx)

