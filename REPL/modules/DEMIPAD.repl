;; REPL/modules/DEMIPAD.repl — canonical integration layout (OuronetInformational/ARCHITECTURE/REPL_AND_TESTS.md)
;;   Inter-tx:   ;;|| NEXT >  (same three lines as REPL/Stage_01/[2.2]_Core.repl)
;;   Intra-tx:   ;;==== <TX label> · mm · <slug> ====  + next-line (print "--- [<label> · mm · …] ---"); mm = 01.. within each (begin-tx …) (see OuronetInformational/ARCHITECTURE/REPL_AND_TESTS.md).
;;   format "{}": Talos / module echoes and (env-gas) — document additional prefixes in this file's (print …) lines as needed.
;;
(print "")
(print "================================================================")
(print "FILE  REPL/modules/DEMIPAD.repl")
(print "================================================================")
(print "Legend (terminal observability): see ;; preface; echoes use <(…)> where helpful.")
(print "Source: ;;|| NEXT > between txs; ;;==== … · mm · … ==== + banner before each begin-tx.")
(print "")
;; REPL/modules/DEMIPAD.repl — STANDALONE DEMIPAD launchpad tester.
;; Reuses TSFS (SFT) from [6.1.3] + CNF (NFT) from [6.1.4] as launchpad assets.
(load "../deploy-stage00.repl")
(load "../deploy-stage01.repl")
(load "../deploy-stage02.repl")
(load "../Stage_02/[6.1.3]_DPDC-S.repl")
(load "../Stage_02/[6.1.4]_DPDC-NF.repl")
(load "../Stage_02/[6.1.5]_DEMIPAD.repl")

;;|| NEXT >
;;
(begin-tx "DEMIPAD-G1 — the pure launchpad guards")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
;;==== DEMIPAD-G1 — the pure launchpad guards · 01 · namespace ==== ===============================
(print "--- [DEMIPAD-G1 — the pure launchpad guards · 01 · namespace] ---")
(namespace "ouronet-ns")
(print "--- [DEMIPAD-G1 · 01 · slippage, royalty inputs, fungibility] ---")
;;P3.3. DEMIPAD's remaining cheap guards are pure -- no fixture, no capability.
;;
;;UEV_SlippageCost is worth pinning carefully because it is the launchpad's answer to the same
;;problem SWP solves, and it makes the OPPOSITE choice about a negative argument. In SWP,
;;UC_SlippageFactor accepts a negative slippage silently and SHRINKS the signed caps below cost
;;-- a trap, recorded at TX-ACQ-02. Here a negative <max-cost> is a DOCUMENTED SENTINEL meaning
;;"no bound", the Variant-2 slippage-off path. Same shape of argument, deliberate opposite
;;meanings, and only one of the two is safe to pass -1.0 to. Both directions asserted.
;;==== DEMIPAD-G1 — the pure launchpad guards · 02 · let / invocation ==== ========================
(print "--- [DEMIPAD-G1 — the pure launchpad guards · 02 · let / invocation] ---")
(let
    (
        (ref-DPAD:module{DemiourgosLaunchpadV2} DEMIPAD)
    )
    (map print
        [
            ;;--- UEV_SlippageCost: bounded path
            (expect "<<DEMIPAD-G1>> a cost UNDER the buyer's ceiling is accepted"
                true (!= "" (format "{}" [(ref-DPAD::UEV_SlippageCost 9.0 10.0)])))
            (expect "<<DEMIPAD-G1>> ...and a cost EXACTLY at the ceiling is accepted (the bound is inclusive)"
                true (!= "" (format "{}" [(ref-DPAD::UEV_SlippageCost 10.0 10.0)])))
            (expect-failure "<<DEMIPAD-G1>> ...while a cost over it is refused, naming both numbers"
                "Slippage: live cost 10.5 exceeds the accepted maximum 10.0"
                (ref-DPAD::UEV_SlippageCost 10.5 10.0))
            ;;the SENTINEL: a negative ceiling disables the bound entirely. The same live cost
            ;;that was refused above now passes -- which is the whole point of Variant 2, and is
            ;;why this must be asserted with the SAME cost rather than a different one.
            (expect "<<DEMIPAD-G1>> a NEGATIVE ceiling is the documented 'no bound' sentinel"
                true (!= "" (format "{}" [(ref-DPAD::UEV_SlippageCost 10.5 -1.0)])))
            (expect "<<DEMIPAD-G1>> ...and it admits ANY cost, however large"
                true (!= "" (format "{}" [(ref-DPAD::UEV_SlippageCost 999999.0 -1.0)])))
            ;;zero is NOT the sentinel -- only strictly-negative is. A ceiling of 0.0 is a real
            ;;bound of zero, so any positive cost must fail. This is the boundary a
            ;;(<= max-cost 0.0) sentinel test would get wrong.
            (expect-failure "<<DEMIPAD-G1>> a ceiling of 0.0 is a REAL bound, not the sentinel"
                "Slippage: live cost 0.01 exceeds the accepted maximum 0.0"
                (ref-DPAD::UEV_SlippageCost 0.01 0.0))
            ;;--- UCv_ComputeDepositRoyalty: two argument-domain guards with distinct messages
            (expect "<<DEMIPAD-G1>> the royalty computer accepts a legitimate deposit"
                true (> (ref-DPAD::UCv_ComputeDepositRoyalty 0.0 100.0) 0.0))
            (expect-failure "<<DEMIPAD-G1>> a negative running balance is refused"
                "Current balance must be non-negative"
                (ref-DPAD::UCv_ComputeDepositRoyalty -1.0 100.0))
            (expect-failure "<<DEMIPAD-G1>> ...and a negative deposit, by its own message"
                "Deposit amount must be non-negative"
                (ref-DPAD::UCv_ComputeDepositRoyalty 0.0 -1.0))
            ;;--- UEV_Fungibility: the pair is [fungible? son?], so length 2 exactly.
            (expect "<<DEMIPAD-G1>> a two-flag fungibility pair is accepted"
                true (!= "" (format "{}" [(ref-DPAD::UEV_Fungibility [false true])])))
            (expect-failure "<<DEMIPAD-G1>> a one-flag list is refused"
                "Invalid Fungibility variable" (ref-DPAD::UEV_Fungibility [false]))
            (expect-failure "<<DEMIPAD-G1>> ...and a three-flag list too"
                "Invalid Fungibility variable" (ref-DPAD::UEV_Fungibility [false true false]))
        ]
    )
    ""
)
(commit-tx)

;;|| NEXT >
;;
(begin-tx "DEMIPAD-G2 — the launchpad sale/retrieval toggles and the deposit admission chain")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(namespace "ouronet-ns")
(print "--- [DEMIPAD-G2 · 01 · TOGGLE-SALE / TOGGLE-RETRIEVAL / C>DEPOSIT] ---")
;;P3.3. @event defcaps, reached through the real TS02-DPAD path. The interfaces are
;;DemiourgosLaunchpadV2 and TalosStageTwo_DemiPadV1 — the module is DEMIPAD but its interface is not
;;"DemiPadV2", which cost a "Cannot find module" round trip.
;;
;;THE DEPOSIT CAP IS AN ORDERED CHAIN, and each case below is built so only its own link can answer:
;;  registered -> dollar amount -> slippage -> type -> SSTOA/OURO branch -> open-for-business
;;So the dollar-amount case passes a valid type, the type case passes a valid amount, and the
;;open-for-business case passes valid everything. TSFS is registered, retrieval ON and sale OFF in
;;this suite, which is what makes the last one reachable without touching any flag.
;;==== DEMIPAD-G2 — the launchpad sale/retrieval toggles and the deposit admission chain · 01 · env-sigs (caps) ==== 
(print "--- [DEMIPAD-G2 — the launchpad sale/retrieval toggles and the deposit admission chain · 01 · env-sigs (caps)] ---")
(env-sigs [{ "key": "PK_AncientHodler", "caps": [] }])
;;==== DEMIPAD-G2 — the launchpad sale/retrieval toggles and the deposit admission chain · 02 · let / invocation ==== 
(print "--- [DEMIPAD-G2 — the launchpad sale/retrieval toggles and the deposit admission chain · 02 · let / invocation] ---")
(let
    (
        (ref-DEMIPAD:module{DemiourgosLaunchpadV2} DEMIPAD)
        (ref-DPAD:module{TalosStageTwo_DemiPadV1} TS02-DPAD)
        (sft:string "TSFS-98c486052a51")
    )
    (map print
        [
            ;;preconditions, all four read live: the asset is registered, the sale is CLOSED, and
            ;;neither alternative deposit currency is enabled.
            (expect "<<DEMIPAD-G2>> TSFS is registered, sale CLOSED, SSTOA and OURO deposits OFF"
                [true false false false]
                [(ref-DEMIPAD::UR_CheckRegistration sft) (ref-DEMIPAD::UR_OpenForBusiness sft)
                 (ref-DEMIPAD::UR_IzSSTOA sft) (ref-DEMIPAD::UR_IzOURO sft)])
            ;;--- the two idempotent toggles. Each emits an event and bills IGNIS, so a silent no-op
            ;;    would leave an audit record of a sale being opened (or closed) that never changed.
            ;;    Both read the CURRENT value and feed it straight back, so they stay correct
            ;;    whatever state earlier blocks leave behind.
            (expect-failure "<<DEMIPAD-G2>> setting open-for-business to the value it already holds is refused"
                "Open for business is already"
                (ref-DPAD::A_ToggleOpenForBusiness sft (ref-DEMIPAD::UR_OpenForBusiness sft)))
            (expect-failure "<<DEMIPAD-G2>> ...and retrieval likewise"
                "Retrieval is already"
                (ref-DPAD::A_ToggleRetrieval sft (ref-DEMIPAD::UR_Retrieval sft)))
            ;;--- dollar amount: zero. Type 0 is valid, so the type guard cannot be what answers.
            (expect-failure "<<DEMIPAD-G2>> a deposit of zero dollars is refused"
                "Invalid Dollar Amount for Deposit"
                (ref-DPAD::DEMIPAD|C_Deposit KST.ANHD KST.ANHD sft 0.0 0 false -1.0))
            ;;--- deposit type out of range, with a valid amount.
            (expect-failure "<<DEMIPAD-G2>> a deposit type outside 0..3 is refused"
                "Invalid Deposit type"
                (ref-DPAD::DEMIPAD|C_Deposit KST.ANHD KST.ANHD sft 10.0 99 false -1.0))
            ;;--- the two alternative-currency branches. Type 2 = SSTOA, type 3 = OURO; both are
            ;;    switched off for this asset, so each branch refuses.
            ;;
            ;;    MESSAGE DEFECT FOUND HERE, FIXED 2026-09-14. Both branches used to carry the
            ;;    SAME text -- "SSTOA Deposits must be turned on" -- even though type 3 enforces
            ;;    <iz-ouro>. That is actively misleading rather than merely terse, and the
            ;;    distinction is what decides severity for this class: SSTOA deposits are a REAL,
            ;;    separately-togglable admin flag, so an operator could perform the suggested
            ;;    remedy, watch nothing change, and retry forever. The two assertions below now
            ;;    demand DIFFERENT text, which is also what stops the branches being merged back
            ;;    into one message: with identical wording, a test that swapped the two branches
            ;;    would still pass.
            (expect-failure "<<DEMIPAD-G2>> a type-2 (SSTOA) deposit is refused while SSTOA is off"
                "SSTOA Deposits must be turned on for exec"
                (ref-DPAD::DEMIPAD|C_Deposit KST.ANHD KST.ANHD sft 10.0 2 false -1.0))
            (expect-failure "<<DEMIPAD-G2>> ...and a type-3 (OURO) deposit names OURO, not SSTOA"
                "OURO Deposits must be turned on for exec"
                (ref-DPAD::DEMIPAD|C_Deposit KST.ANHD KST.ANHD sft 10.0 3 false -1.0))
            ;;--- and the gate the whole launchpad turns on: a perfectly well-formed deposit is
            ;;    refused because the sale is not open. Type 0, positive amount, slippage off — every
            ;;    earlier link provably passes.
            (expect-failure "<<DEMIPAD-G2>> a well-formed deposit is refused while the sale is CLOSED"
                "is not open for business"
                (ref-DPAD::DEMIPAD|C_Deposit KST.ANHD KST.ANHD sft 10.0 0 false -1.0))
            ;;--- FIXED 2026-09-12, owner-ruled. This assertion used to pin the defect AS IT BEHAVED:
            ;;    the "Asset is not registered" guard could never fire, because the eager `let` above
            ;;    it bound three BARE reads of DEMIPAD|T|Ledger and an unregistered asset -- the only
            ;;    case the guard exists for -- aborted in one of them first. A caller who fat-fingered
            ;;    an asset id got a raw table key instead of the written sentence.
            ;;    (The diagnosis above this line was half right and worth correcting for the record:
            ;;    it blamed UR_CheckRegistration, which is in fact the ONE reader that was already
            ;;    safe -- it wraps its with-read in `(try false ...)`. The culprits were its three
            ;;    neighbours, UR_OpenForBusiness / UR_IzSSTOA / UR_IzOURO.)
            ;;    Ruling: "make each one succeed to either false or true". All three are now
            ;;    with-default-read, so evaluation order is untouched and the guard is reached.
            (expect-failure "<<DEMIPAD-G2>> an unregistered asset now gets the WRITTEN message"
                "is not registered to the Demiourgos Lauchpad. Deposit unallowed"
                (ref-DPAD::DEMIPAD|C_Deposit KST.ANHD KST.ANHD "ghost-asset" 10.0 0 false -1.0))
        ]
    )
    ""
)
(env-sigs [])
(commit-tx)
;;FINDING (message only, no behaviour change) — the SSTOA and OURO branches of C>DEPOSIT carry the
;;IDENTICAL message:
;;    (if (= type 2) (enforce iz-sstoa "SSTOA Deposits must be turned on for exec")
;;                   (enforce iz-ouro  "SSTOA Deposits must be turned on for exec"))
;;The else-branch checks iz-OURO and says SSTOA. Both are driven above, so both sites are genuinely
;;exercised — but a type-3 depositor is told to enable the wrong switch, and the two sites share
;;wording inside one module, so the coverage tool can credit them only nominally. One word.

;;|| NEXT >
;;
(begin-tx "DEMIPAD-I1 — INFO_DEMIPAD|FuelTrueFungible and RetrieveTrueFungible quotes vs measured charges")
(env-gasmodel "table")(env-gaslimit 100000000)(env-gas 0)
(namespace "ouronet-ns")
(print "--- [DEMIPAD-I1 · 01 · fuel the pad, then retrieve it back] ---")
;;FUNCTION COVERAGE (G6) — `INFO_DEMIPAD|FuelTrueFungible` and `INFO_DEMIPAD|RetrieveTrueFungible`, per the owner's
;;spec: an INFO_ must report the same cost the op actually charges. Template: `modules/ATS.repl
;;<<ATS-I1>>`.
;;
;;The two are measured as a PAIR, in that order, because they are inverses: fuelling moves the asset
;;into the pad and retrieving moves it back, so running both leaves the ledger where it started and
;;the second measurement has a valid fixture without inventing one. Fuel/Retrieve are also the two
;;ops most likely to be given the same preview by accident — they are near-mirror images — so pricing
;;them in the same block puts any copied quote side by side with the charge that contradicts it.
;;
;;NOTE for the TrueFungible and OrtoFungible pairs specifically: the Talos wrapper does NOT call
;;`IGNIS::C_Collect` itself — the billing happens one layer down, inside `TS01-C1::DPTF|C_Transfer` /
;;`DPOF|C_Transfer`, against the same patron. So the collector is absent from the function this block
;;names, and the charge still lands. Do not read that absence as "this op is free".
(env-sigs [{ "key": "PK_AncientHodler", "caps": [] }])
(let
    (
        (ref-DPAD:module{TalosStageTwo_DemiPadV1} TS02-DPAD)
        (ref-DALOS:module{OuronetDalosV2} DALOS)
        (patron:string KST.ANHD)
        (asset:string "OURO-98c486052a51")
    )
    (let
        (
            (predicted-f:object{OuronetInfoV2.ClientInfo} (INFO-TWO.INFO_DEMIPAD|FuelTrueFungible patron patron asset 100.0))
            (ignis-before-f:decimal (ref-DALOS::UR_TF_AccountSupply patron false))
            (mf (ref-DPAD::DEMIPAD|C_FuelTrueFungible patron patron asset 100.0))
        )
        (map print
            [
                (expect "<<DEMIPAD-I1>> INFO_DEMIPAD|FuelTrueFungible's quote equals what fuelling charged"
                    (- ignis-before-f (ref-DALOS::UR_TF_AccountSupply patron false))
                    (at "ignis-need" (at "ignis" predicted-f)))
                (expect "<<DEMIPAD-I1>> ...and fuelling is NOT free"
                    true (> (- ignis-before-f (ref-DALOS::UR_TF_AccountSupply patron false)) 0.0))
            ]
        )
    )
    (let
        (
            (predicted-r:object{OuronetInfoV2.ClientInfo} (INFO-TWO.INFO_DEMIPAD|RetrieveTrueFungible patron patron asset 100.0))
            (ignis-before-r:decimal (ref-DALOS::UR_TF_AccountSupply patron false))
            (mr (ref-DPAD::DEMIPAD|C_RetrieveTrueFungible patron patron asset 100.0))
        )
        (map print
            [
                (expect "<<DEMIPAD-I1>> INFO_DEMIPAD|RetrieveTrueFungible's quote equals what retrieving charged"
                    (- ignis-before-r (ref-DALOS::UR_TF_AccountSupply patron false))
                    (at "ignis-need" (at "ignis" predicted-r)))
                (expect "<<DEMIPAD-I1>> ...and retrieving is NOT free"
                    true (> (- ignis-before-r (ref-DALOS::UR_TF_AccountSupply patron false)) 0.0))
            ]
        )
    )
    ""
)
(env-sigs [])
(rollback-tx)

;;|| NEXT >
;;
