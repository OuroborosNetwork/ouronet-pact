(begin-tx "DEMIPAD-I4 — INFO_DEMIPAD|FuelNonFungible and RetrieveNonFungible quotes vs measured charges")
(env-gasmodel "table")(env-gaslimit 100000000)(env-gas 0)
(namespace "ouronet-ns")
(print "--- [DEMIPAD-I4 · 01 · fuel the pad, then retrieve it back] ---")
;;FUNCTION COVERAGE (G6) — `INFO_DEMIPAD|FuelNonFungible` and `INFO_DEMIPAD|RetrieveNonFungible`, per the owner's
;;spec: an INFO_ must report the same cost the op actually charges. Template: `modules/ATS.repl
;;<<ATS-I1>>`.
;;
;;The two are measured as a PAIR, in that order, because they are inverses: fuelling moves the asset
;;into the pad and retrieving moves it back, so running both leaves the ledger where it started and
;;the second measurement has a valid fixture without inventing one. Fuel/Retrieve are also the two
;;ops most likely to be given the same preview by accident — they are near-mirror images — so pricing
;;them in the same block puts any copied quote side by side with the charge that contradicts it.
(env-sigs [{ "key": "PK_AncientHodler", "caps": [] }])
(let
    (
        (ref-DPAD:module{TalosStageTwo_DemiPadV1} TS02-DPAD)
        (ref-DALOS:module{OuronetDalosV2} DALOS)
        (patron:string KST.ANHD)
        (asset:string "CNF-98c486052a51")
    )
    (let
        (
            (predicted-f:object{OuronetInfoV2.ClientInfo} (INFO-TWO.INFO_DEMIPAD|FuelNonFungible patron patron asset [2] [1]))
            (ignis-before-f:decimal (ref-DALOS::UR_TF_AccountSupply patron false))
            (mf (ref-DPAD::DEMIPAD|C_FuelNonFungible patron patron asset [2] [1]))
        )
        (map print
            [
                (expect "<<DEMIPAD-I4>> INFO_DEMIPAD|FuelNonFungible's quote equals what fuelling charged"
                    (- ignis-before-f (ref-DALOS::UR_TF_AccountSupply patron false))
                    (at "ignis-need" (at "ignis" predicted-f)))
                (expect "<<DEMIPAD-I4>> ...and fuelling is NOT free"
                    true (> (- ignis-before-f (ref-DALOS::UR_TF_AccountSupply patron false)) 0.0))
            ]
        )
    )
    (let
        (
            (predicted-r:object{OuronetInfoV2.ClientInfo} (INFO-TWO.INFO_DEMIPAD|RetrieveNonFungible patron patron asset [2] [1]))
            (ignis-before-r:decimal (ref-DALOS::UR_TF_AccountSupply patron false))
            (mr (ref-DPAD::DEMIPAD|C_RetrieveNonFungible patron patron asset [2] [1]))
        )
        (map print
            [
                (expect "<<DEMIPAD-I4>> INFO_DEMIPAD|RetrieveNonFungible's quote equals what retrieving charged"
                    (- ignis-before-r (ref-DALOS::UR_TF_AccountSupply patron false))
                    (at "ignis-need" (at "ignis" predicted-r)))
                (expect "<<DEMIPAD-I4>> ...and retrieving is NOT free"
                    true (> (- ignis-before-r (ref-DALOS::UR_TF_AccountSupply patron false)) 0.0))
            ]
        )
    )
    ""
)
(env-sigs [])
(rollback-tx)
