;;
;; REPL/modules/DPNF.repl — canonical integration layout (OuronetInformational/ARCHITECTURE/REPL_AND_TESTS.md)
;;   Inter-tx:   ;;|| NEXT >  (same three lines as REPL/Stage_01/[2.2]_Core.repl)
;;   Intra-tx:   ;;==== <TX label> · mm · <slug> ====  + next-line (print "--- [<label> · mm · …] ---"); mm = 01.. within each (begin-tx …) (see OuronetInformational/ARCHITECTURE/REPL_AND_TESTS.md).
;;   format "{}": Talos / module echoes and (env-gas) — document additional prefixes in this file's (print …) lines as needed.
;;
(print "")
(print "================================================================")
(print "FILE  REPL/modules/DPNF.repl")
(print "================================================================")
(print "Legend (terminal observability): see ;; preface; echoes use <(…)> where helpful.")
(print "Source: ;;|| NEXT > between txs; ;;==== … · mm · … ==== + banner before each begin-tx.")
(print "")
;; REPL/modules/DPNF.repl — STANDALONE DPNF (non-fungible collection) tester.
;;
;; P2 rebuild. The previous version loaded Stage_02/[6.1.4]_DPDC-NF.repl and produced only 6 net
;; assertions against a 61-entrypoint surface. It also inherited that file's known G3 problem:
;; [6.1.4]:333 upgrades CNF branding and fails outside ZALL's exact ordering (see
;; regressions/MANIFEST.md).
;;
;; This version builds a minimal collection (fixtures/mock-collections) and asserts an OBSERVABLE
;; OUTCOME per entrypoint. The nonce-field family (Name/Description/Royalty/IgnisRoyalty/Score/
;; MetaData/URI) shares one uniform price and one shared reader, so each is pinned to the FIELD
;; it actually writes -- a family where a copy-paste slip is invisible without per-field assertions.
;;
;; Run: cd REPL && pact modules/DPNF.repl
(load "../deploy-stage00.repl")
(load "../deploy-stage01.repl")
(load "../deploy-stage02.repl")
(load "../fixtures/mock-collections.repl")

;;|| NEXT >
;;
(begin-tx "DPNF-01 — collection properties and nonce baseline")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
;;==== DPNF-01 — collection properties and nonce baseline · 01 · namespace ==== ===================
(print "--- [DPNF-01 — collection properties and nonce baseline · 01 · namespace] ---")
(namespace "ouronet-ns")
(print "--- [DPNF-01 · 01 · properties] ---")
;;==== DPNF-01 — collection properties and nonce baseline · 02 · let / invocation ==== ============
(print "--- [DPNF-01 — collection properties and nonce baseline · 02 · let / invocation] ---")
(let
    (
        (ref-DPDC:module{DpdcV2} DPDC)
        (nf:string "MOCKN-98c486052a51")
    )
    (map print
        [
            (expect "<<DPNF-01>> owner konto"          KST.ANHD (ref-DPDC::UR_OwnerKonto nf false))
            (expect "<<DPNF-01>> creator konto"        KST.ANHD (ref-DPDC::UR_CreatorKonto nf false))
            (expect "<<DPNF-01>> name"                 "MockNonFungible" (ref-DPDC::UR_Name nf false))
            (expect "<<DPNF-01>> can-upgrade ON"       true  (ref-DPDC::UR_CanUpgrade nf false))
            (expect "<<DPNF-01>> can-change-owner ON"  true  (ref-DPDC::UR_CanChangeOwner nf false))
            (expect "<<DPNF-01>> can-change-creator ON" true (ref-DPDC::UR_CanChangeCreator nf false))
            (expect "<<DPNF-01>> not paused"           false (ref-DPDC::UR_IsPaused nf false))
            (expect "<<DPNF-01>> 3 nonces from the fixture" 3 (ref-DPDC::UR_NoncesUsed nf false))
            (expect "<<DPNF-01>> no set classes defined yet" 0 (ref-DPDC::UR_SetClassesUsed nf false))
        ]
    )
    ""
)
(commit-tx)

;;|| NEXT >
;;
(begin-tx "DPNF-02 — the nonce-field family each writes ITS OWN field")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(namespace "ouronet-ns")
(print "--- [DPNF-02 · 01 · per-field updates] ---")
;;==== DPNF-02 — the nonce-field family each writes ITS OWN field · 01 · env-sigs (caps) ==== =====
(print "--- [DPNF-02 — the nonce-field family each writes ITS OWN field · 01 · env-sigs (caps)] ---")
(env-sigs [{ "key": "PK_AncientHodler", "caps": [] }])
;;==== DPNF-02 — the nonce-field family each writes ITS OWN field · 02 · let / invocation ==== ====
(print "--- [DPNF-02 — the nonce-field family each writes ITS OWN field · 02 · let / invocation] ---")
(let
    (
        (ref-DPDC:module{DpdcV2} DPDC)
        (ref-TS02-C2:module{TalosStageTwo_ClientTwoV2} TS02-C2)
        (nf:string "MOCKN-98c486052a51")
        (patron:string KST.ANHD)
    )
    (ref-TS02-C2::DPNF|C_UpdateNonceName        patron nf patron 1 true "RenamedNonce")
    (ref-TS02-C2::DPNF|C_UpdateNonceDescription patron nf patron 1 true "A described nonce")
    (ref-TS02-C2::DPNF|C_UpdateNonceRoyalty     patron nf patron 1 true 12.0)
    (ref-TS02-C2::DPNF|C_UpdateNonceScore       patron nf patron 1 true 44.0)
    (let ((nd:object{DpdcUdcV2.DPDC|NonceData} (ref-DPDC::UR_NonceData nf false 1)))
        (map print
            [
                (expect "<<DPNF-02>> C_UpdateNonceName wrote the NAME field"
                    "RenamedNonce" (at "name" nd))
                (expect "<<DPNF-02>> C_UpdateNonceDescription wrote the DESCRIPTION field"
                    "A described nonce" (at "description" nd))
                (expect "<<DPNF-02>> C_UpdateNonceRoyalty wrote the ROYALTY field"
                    12.0 (at "royalty" nd))
                (expect "<<DPNF-02>> C_UpdateNonceScore wrote score INSIDE meta-data"
                    44.0 (at "score" (at "meta-data" nd)))
                ;;CROSS-CHECK: the shared reader must not have let one update clobber another.
                (expect "<<DPNF-02>> updating the score left the name intact"
                    "RenamedNonce" (at "name" nd))
                (expect "<<DPNF-02>> updating the royalty left the description intact"
                    "A described nonce" (at "description" nd))
                (expect "<<DPNF-02>> a sibling nonce was NOT touched by nonce-1 updates"
                    "M" (at "name" (ref-DPDC::UR_NonceData nf false 2)))
            ]
        )
    )
    ""
)
(commit-tx)

;;|| NEXT >
;;
(begin-tx "DPNF-03 — C_TransferNonce moves a unique nonce; roles gate what they claim")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(namespace "ouronet-ns")
(print "--- [DPNF-03 · 01 · transfer + roles] ---")
;;==== DPNF-03 — C_TransferNonce moves a unique nonce; roles gate what they claim · 01 · env-sigs (caps) ==== 
(print "--- [DPNF-03 — C_TransferNonce moves a unique nonce; roles gate what they claim · 01 · env-sigs (caps)] ---")
(env-sigs [{ "key": "PK_AncientHodler", "caps": [] }])
;;==== DPNF-03 — C_TransferNonce moves a unique nonce; roles gate what they claim · 02 · let / invocation ==== 
(print "--- [DPNF-03 — C_TransferNonce moves a unique nonce; roles gate what they claim · 02 · let / invocation] ---")
(let
    (
        (ref-DPDC:module{DpdcV2} DPDC)
        (ref-I|OURONET:module{OuronetInfoV2} IGNIS)
        (ref-TS02-C2:module{TalosStageTwo_ClientTwoV2} TS02-C2)
        (nf:string "MOCKN-98c486052a51")
        (patron:string KST.ANHD)
        (emma:string KST.EMMA)
    )
    (let ((used0:integer (ref-DPDC::UR_NoncesUsed nf false)))
        (ref-TS02-C2::DPNF|C_TransferNonce patron nf patron emma 3 1 false)
        (map print
            [
                (expect "<<DPNF-03>> C_TransferNonce moved nonce 3 to the receiver"
                    (ref-I|OURONET::OI|UC_ShortAccount emma) (ref-DPDC::UR_NonceHolder nf false 3))
                (expect "<<DPNF-03>> a transfer creates no new nonce"
                    used0 (ref-DPDC::UR_NoncesUsed nf false))
                (expect "<<DPNF-03>> an untransferred nonce keeps its holder"
                    (ref-I|OURONET::OI|UC_ShortAccount patron) (ref-DPDC::UR_NonceHolder nf false 1))
            ]
        )
    )
    (ref-TS02-C2::DPNF|C_TogglePause patron (DPDC.UR_OwnerKonto nf false) nf true)
    (map print [(expect "<<DPNF-03>> C_TogglePause paused the collection"
                    true (ref-DPDC::UR_IsPaused nf false))])
    (ref-TS02-C2::DPNF|C_TogglePause patron (DPDC.UR_OwnerKonto nf false) nf false)
    (map print [(expect "<<DPNF-03>> C_TogglePause unpaused the collection"
                    false (ref-DPDC::UR_IsPaused nf false))])
    ""
)
(commit-tx)

;;|| NEXT >
;;
(begin-tx "DPNF-04 — ops that ONLY assertion-free probes had ever touched")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(namespace "ouronet-ns")
(print "--- [DPNF-04 · 01 · previously untested surface] ---")
;;==== DPNF-04 — ops that ONLY assertion-free probes had ever touched · 01 · env-sigs (caps) ==== =
(print "--- [DPNF-04 — ops that ONLY assertion-free probes had ever touched · 01 · env-sigs (caps)] ---")
(env-sigs [{ "key": "PK_AncientHodler", "caps": [] }])
;;These three appear NOWHERE in any asserting test -- only in archived probe files that call
;;them and check nothing. One such probe even advertises itself as "covering" its op. Calling an
;;op is not testing it (RULE 6), so they get real assertions here.
;;==== DPNF-04 — ops that ONLY assertion-free probes had ever touched · 02 · let / invocation ==== 
(print "--- [DPNF-04 — ops that ONLY assertion-free probes had ever touched · 02 · let / invocation] ---")
(let
    (
        (ref-DPDC:module{DpdcV2} DPDC)
        (ref-DPDC-UDC:module{DpdcUdcV2} DPDC-UDC)
        (ref-TS02-C2:module{TalosStageTwo_ClientTwoV2} TS02-C2)
        (nf:string "MOCKN-98c486052a51")
        (patron:string KST.ANHD)
        (emma:string KST.EMMA)
    )
    ;;C_ToggleTransferRole
    (ref-TS02-C2::DPNF|C_ToggleTransferRole patron (DPDC.UR_OwnerKonto nf false) emma nf true)
    (map print [(expect "<<DPNF-04>> C_ToggleTransferRole granted the transfer role"
                    true (contains emma (at "r-transfer" (ref-DPDC::UR_VerumRoles nf false))))])
    (ref-TS02-C2::DPNF|C_ToggleTransferRole patron (DPDC.UR_OwnerKonto nf false) emma nf false)
    (map print [(expect "<<DPNF-04>> C_ToggleTransferRole revoked the transfer role"
                    false (contains emma (at "r-transfer" (ref-DPDC::UR_VerumRoles nf false))))])
    ;;C_UpdateNonce — the WHOLE-object writer, versus the per-field writers in DPNF-02
    (let
        (
            (type:object{DpdcUdcV2.URI|Type}
                (ref-DPDC-UDC::UDC_URI|Type true false false false false false false))
        )
        (let
            (
                (nd:object{DpdcUdcV2.DPDC|NonceData}
                    (ref-DPDC-UDC::UDC_NonceData 3.0 4.0 "WholeWrite" "written as one object"
                        (ref-DPDC-UDC::UDC_MetaData { "k": "v" }) type
                        (ref-DPDC-UDC::UDC_ZeroURI|Data) (ref-DPDC-UDC::UDC_ZeroURI|Data)
                        (ref-DPDC-UDC::UDC_ZeroURI|Data)))
            )
            (ref-TS02-C2::DPNF|C_UpdateNonce patron nf patron 2 true nd)
            (let ((got:object{DpdcUdcV2.DPDC|NonceData} (ref-DPDC::UR_NonceData nf false 2)))
                (map print
                    [
                        (expect "<<DPNF-04>> C_UpdateNonce wrote the whole object: name"
                            "WholeWrite" (at "name" got))
                        (expect "<<DPNF-04>> C_UpdateNonce wrote the whole object: description"
                            "written as one object" (at "description" got))
                        (expect "<<DPNF-04>> C_UpdateNonce wrote the whole object: royalty"
                            3.0 (at "royalty" got))
                        (expect "<<DPNF-04>> C_UpdateNonce wrote the whole object: ignis royalty"
                            4.0 (at "ignis" got))
                        (expect "<<DPNF-04>> the whole-object write did NOT touch nonce 1"
                            "RenamedNonce" (at "name" (ref-DPDC::UR_NonceData nf false 1)))
                    ]
                )
            )
        )
    )
    ""
)
(commit-tx)

;;|| NEXT >
;;
(begin-tx "DPNF-05 — DPNF|C_Repurpose: the collection owner takes a nonce BACK")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(namespace "ouronet-ns")
(print "--- [DPNF-05 · 01 · forced reclaim] ---")
;; Never exercised by any test before. Repurpose is NOT a transfer: the collection owner moves a
;; nonce out of a third party's holding, and that party does not sign. EMMA received nonce 3 in
;; DPNF-03 and signs nothing here -- only ANHD does. That asymmetry IS the op.
;;==== DPNF-05 — DPNF|C_Repurpose: the collection owner takes a nonce BACK · 01 · env-sigs (caps) ==== 
(print "--- [DPNF-05 — DPNF|C_Repurpose: the collection owner takes a nonce BACK · 01 · env-sigs (caps)] ---")
(env-sigs [{ "key": "PK_AncientHodler", "caps": [] }])
;;==== DPNF-05 — DPNF|C_Repurpose: the collection owner takes a nonce BACK · 02 · let / invocation ==== 
(print "--- [DPNF-05 — DPNF|C_Repurpose: the collection owner takes a nonce BACK · 02 · let / invocation] ---")
(let
    (
        (ref-DPDC:module{DpdcV2} DPDC)
        (ref-I|OURONET:module{OuronetInfoV2} IGNIS)
        (ref-TS02-C2:module{TalosStageTwo_ClientTwoV2} TS02-C2)
        (nf:string "MOCKN-98c486052a51")
        (patron:string KST.ANHD)
        (emma:string KST.EMMA)
    )
    (map print
        [
            (expect "<<DPNF-05>> precondition: EMMA holds nonce 3"
                (ref-I|OURONET::OI|UC_ShortAccount emma) (ref-DPDC::UR_NonceHolder nf false 3))
        ]
    )
    (let ((used0:integer (ref-DPDC::UR_NoncesUsed nf false)))
        (ref-TS02-C2::DPNF|C_Repurpose patron nf emma patron [3] [1])
        (map print
            [
                (expect "<<DPNF-05>> the nonce is back with the collection owner"
                    (ref-I|OURONET::OI|UC_ShortAccount patron) (ref-DPDC::UR_NonceHolder nf false 3))
                ;; 0, NOT the -1 "never held" sentinel: being repurposed away leaves a residue
                ;; row, so a former holder stays distinguishable from an account that never held
                ;; the nonce. Same distinction the DPSF bulk wipes make.
                (expect "<<DPNF-05>> a FORMER holder reads 0, not the -1 never-held sentinel" 0
                    (ref-DPDC::UR_AccountNonceSupply emma nf false 3))
                (expect "<<DPNF-05>> the owner holds exactly one unit of it" 1
                    (ref-DPDC::UR_AccountNonceSupply patron nf false 3))
                ;; A repurpose moves an existing nonce; it must not mint.
                (expect "<<DPNF-05>> repurpose creates no new nonce" used0
                    (ref-DPDC::UR_NoncesUsed nf false))
                ;; and it is scoped to the nonce named
                (expect "<<DPNF-05>> an unrelated nonce keeps its holder"
                    (ref-I|OURONET::OI|UC_ShortAccount patron) (ref-DPDC::UR_NonceHolder nf false 1))
            ]
        )
    )
    ""
)
(commit-tx)
