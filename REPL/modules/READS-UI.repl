;; READS_UI — the split read layer. RD-HEADER is the reference module; mirror it.
;;
;; WHAT THIS SUITE IS FOR, beyond "does it run". The two functions that took the dashboard down
;; on 2026-09-24 had NEVER executed in a test, because their hardcoded mainnet ids do not exist
;; in a sandbox. Every assertion below therefore CALLS the read rather than inspecting it.
(load "../deploy-stage00.repl")
(load "../deploy-stage01.repl")
(load "../Stage_01/[6.2+3]_DPTF-SWP_Issuance-Only.repl")
(load "../deploy-stage02.repl")

