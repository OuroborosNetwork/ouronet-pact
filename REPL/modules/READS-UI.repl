(begin-tx "RDUI-04 -- RD-WALLET: every card answers, and the composer stays whole")
(env-gasmodel "table")(env-gaslimit 100000000)(env-gas 0)
;;==== RDUI-04 · 01 · namespace ==== ==============================================================
(print "--- [RDUI-04 · 01 · namespace] ---")
(namespace "ouronet-ns")
;;==== RDUI-04 · 02 · the ten cards, each on its own ==== =========================================
(print "--- [RDUI-04 · 02 · the ten cards, each on its own] ---")
;;DPL-UR::URC_0002_PrimordialsSingle bound ~60 values in one eager `let` and returned ~70 flat
;;keys, so any one missing token row blanked the whole wallet view. These ten assertions are the
;;property that replaces it: each card answers alone, so a failure has an address.
(map print
    [
        (expect "<<RDUI-04>> OURO card"        true (at "card-ok" (RD-WALLET.URC_Ouro KST.ANHD)))
        (expect "<<RDUI-04>> IGNIS card"       true (at "card-ok" (RD-WALLET.URC_Ignis KST.ANHD)))
        (expect "<<RDUI-04>> AURYN card"       true (at "card-ok" (RD-WALLET.URC_Auryn KST.ANHD)))
        (expect "<<RDUI-04>> ELITEAURYN card"  true (at "card-ok" (RD-WALLET.URC_EliteAuryn KST.ANHD)))
        (expect "<<RDUI-04>> UrStoa card"      true (at "card-ok" (RD-WALLET.URC_UrStoa KST.ANHD)))
        (expect "<<RDUI-04>> STOA card"        true (at "card-ok" (RD-WALLET.URC_Stoa KST.ANHD)))
        (expect "<<RDUI-04>> SilverStoa card"  true (at "card-ok" (RD-WALLET.URC_SilverStoa KST.ANHD)))
        (expect "<<RDUI-04>> GoldenStoa card"  true (at "card-ok" (RD-WALLET.URC_GoldenStoa KST.ANHD)))
        (expect "<<RDUI-04>> totals"           true (at "card-ok" (RD-WALLET.URC_Totals KST.ANHD)))
        (expect "<<RDUI-04>> codex"            true (at "card-ok" (RD-WALLET.URC_Codex [])))
    ]
)
(commit-tx)

;;|| NEXT >
;;
(begin-tx "RDUI-05 -- RD-WALLET arithmetic, and the scan that must stay out of the composer")
(env-gasmodel "table")(env-gaslimit 100000000)(env-gas 0)
;;==== RDUI-05 · 01 · namespace ==== ==============================================================
(print "--- [RDUI-05 · 01 · namespace] ---")
(namespace "ouronet-ns")
;;==== RDUI-05 · 02 · URC_Value is linear and floors to token precision ==== ======================
(print "--- [RDUI-05 · 02 · URC_Value is linear and floors to token precision] ---")
;;Per READS_UI/README.md's testing posture, display reads need no audit -- but a read that feeds a
;;DECISION needs its ARITHMETIC pinned. URC_Value is the multiplier under every "-vid" field on
;;the dashboard, so these pin the relationship rather than smoke-testing that a call returned.
(let ((ouro:string (ouronet-ns.DALOS.UR_OuroborosID)))
    (map print
        [
            (expect "<<RDUI-05>> unit amount at unit price is the unit value"
                1.0 (RD-WALLET.URC_Value ouro 1.0 1.0))
            (expect "<<RDUI-05>> ...linear in the AMOUNT"
                2.0 (RD-WALLET.URC_Value ouro 2.0 1.0))
            (expect "<<RDUI-05>> ...linear in the PRICE"
                2.0 (RD-WALLET.URC_Value ouro 1.0 2.0))
            (expect "<<RDUI-05>> ...and zero amount is worth zero"
                0.0 (RD-WALLET.URC_Value ouro 0.0 1.0))
            (expect "<<RDUI-05>> seven prices, in the documented order"
                7 (length (RD-WALLET.URC_Prices)))
            (expect "<<RDUI-05>> IGNIS is a fixed 0.01 by definition, not a pool price"
                0.01 (at 1 (RD-WALLET.URC_Prices)))
        ]
    )
)
;;==== RDUI-05 · 03 · the composer survives, BECAUSE the scan is not in it ==== ===================
(print "--- [RDUI-05 · 03 · the composer survives, BECAUSE the scan is not in it] ---")
;;THE REASON THIS BLOCK EXISTS. Pact evaluates a `try` body in READ-ONLY mode, where `select` and
;;`keys` are disallowed. With DPOF::URH_AccountNonces inline in the GoldenStoa card, URC_Wallet
;;died on "Operation disallowed in read-only or sys-only mode" (06_DPOF.pact:1857) while every
;;card still passed INDIVIDUALLY -- only the composed call broke, which is the hardest shape to
;;diagnose. The scan now lives in URH_GoldenStoaNonces and is deliberately outside the composer.
;;
;;The first assertion is the regression guard: it fails the moment a scan is folded back into a
;;composed card. The second proves the scan itself still works where it now lives.
(let ((w:object (RD-WALLET.URC_Wallet KST.ANHD [])))
    (map print
        [
            (expect "<<RDUI-05>> the composer returns all ten cards whole -- a scan folded into \
                \ any composed card would abort this call entirely"
                [true true true true true true true true true true]
                [(at "card-ok" (at "ouro" w)) (at "card-ok" (at "ignis" w))
                 (at "card-ok" (at "auryn" w)) (at "card-ok" (at "eliteauryn" w))
                 (at "card-ok" (at "urstoa" w)) (at "card-ok" (at "stoa" w))
                 (at "card-ok" (at "silverstoa" w)) (at "card-ok" (at "goldenstoa" w))
                 (at "card-ok" (at "totals" w)) (at "card-ok" (at "codex" w))])
            (expect "<<RDUI-05>> ...and the scan works where it now lives, outside the composer"
                0 (at "nonces" (RD-WALLET.URH_GoldenStoaNonces KST.ANHD)))
            (expect "<<RDUI-05>> the composed card equals the card called directly"
                (RD-WALLET.URC_Ignis KST.ANHD) (at "ignis" w))
        ]
    )
)
(commit-tx)
