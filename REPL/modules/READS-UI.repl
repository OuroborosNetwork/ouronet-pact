        (expect "<<RDUI-04>> IGNIS card"       true (at "card-ok" (RD-WALLET.URC_Ignis KST.ANHD)))
        (expect "<<RDUI-04>> AURYN card"       true (at "card-ok" (RD-WALLET.URC_Auryn KST.ANHD)))
        (expect "<<RDUI-04>> ELITEAURYN card"  true (at "card-ok" (RD-WALLET.URC_EliteAuryn KST.ANHD)))
        (expect "<<RDUI-04>> UrStoa card"      true (at "card-ok" (RD-WALLET.URC_UrStoa KST.ANHD)))
        (expect "<<RDUI-04>> STOA card"        true (at "card-ok" (RD-WALLET.URC_Stoa KST.ANHD)))
        (expect "<<RDUI-04>> SilverStoa card"  true (at "card-ok" (RD-WALLET.URC_SilverStoa KST.ANHD)))
        (expect "<<RDUI-04>> GoldenStoa card"  true (at "card-ok" (RD-WALLET.URC_GoldenStoa KST.ANHD)))
        (expect "<<RDUI-04>> totals"           true (at "card-ok" (RD-WALLET.URC_Totals KST.ANHD)))
