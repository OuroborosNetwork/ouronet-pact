(begin-tx "RDUI-06 -- RD-POOLS: the tier rule DPL-UR gets wrong")
(env-gasmodel "table")(env-gaslimit 100000000)(env-gas 0)
;;==== RDUI-06 · 01 · namespace ==== ==============================================================
(print "--- [RDUI-06 · 01 · namespace] ---")
(namespace "ouronet-ns")
;;==== RDUI-06 · 02 · UC_MaxSpecialFeeTargets across every tier ==== ==============================
(print "--- [RDUI-06 · 02 · UC_MaxSpecialFeeTargets across every tier] ---")
;;THIS IS THE ASSERTION THAT MATTERS IN THIS FILE. DPL-UR carries this rule twice and the copies
;;disagree: URC_0032_EliteAccount seeds its or-fold with `false`, URC_0015_SwpairManagementFee
;;with `true`. The identity for `or` is FALSE, so the seeded-true copy returns true regardless of
;;contents -- the tier-5 branch always fires and the trailing `1` is unreachable.
;;
;;Consequence on chain today: every pool owner below tier 2 is told they may set SEVEN
;;special-fee targets when the rule allows ONE. That is a decision-feeding number -- it bounds
;;what the UI lets a user add -- so it walks them into a transaction the contract refuses.
;;
;;Tiers 0 and 1 are the whole point of the block. Under the defect both return 7.
(map print
    [
        (expect "<<RDUI-06>> tier 0 permits ONE target -- DPL-UR's copy says 7" 1
            (RD-POOLS.UC_MaxSpecialFeeTargets 0))
        (expect "<<RDUI-06>> tier 1 permits ONE target -- DPL-UR's copy says 7" 1
            (RD-POOLS.UC_MaxSpecialFeeTargets 1))
        (expect "<<RDUI-06>> tier 2 permits two"   2 (RD-POOLS.UC_MaxSpecialFeeTargets 2))
        (expect "<<RDUI-06>> tier 3 permits three" 3 (RD-POOLS.UC_MaxSpecialFeeTargets 3))
        (expect "<<RDUI-06>> tier 4 permits four"  4 (RD-POOLS.UC_MaxSpecialFeeTargets 4))
        (expect "<<RDUI-06>> tier 5 permits seven" 7 (RD-POOLS.UC_MaxSpecialFeeTargets 5))
        (expect "<<RDUI-06>> tier 6 permits seven" 7 (RD-POOLS.UC_MaxSpecialFeeTargets 6))
        (expect "<<RDUI-06>> tier 7 permits seven" 7 (RD-POOLS.UC_MaxSpecialFeeTargets 7))
    ]
)
(commit-tx)

