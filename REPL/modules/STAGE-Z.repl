(begin-tx "STAGEZ-21 -- the dispenser's stoicism-minting parity check")
(env-gasmodel "table")(env-gaslimit 150000000)(env-gas 0)
(namespace "ouronet-ns")
;;==== STAGEZ-21 -- the dispenser's stoicism-minting parity check · 01 · env-sigs (caps) ==== =====
(print "--- [STAGEZ-21 -- the dispenser's stoicism-minting parity check · 01 · env-sigs (caps)] ---")
(env-sigs [{ "key": "PK_AncientHodler", "caps": [] }])
(print "--- [STAGEZ-21 . 01 . amounts and targets must agree in length] ---")
;;`DSP|STOICISM-MINTER` takes two parallel lists -- amounts and the accounts to mint them to -- and
;;refuses when they disagree. Argument-domain; the only reason it was unpinned is that nothing had called
;;the minter with a mismatched pair.
;;
;;DSP is a CITIZEN automaton with no harness of its own, and this file is the cheapest one that deploys
;;it. Both directions are driven, because the check is parity and a one-sided test would pass for a
;;guard written as a floor on either list.
(map print
    [
        (expect-failure "<<STAGEZ-21>> two amounts against one target is refused"
            "Length of stoicism-amounts and stoicism-targets must be the same"
            (DSP.A_StoicismMinter [1.0 2.0] [KST.EMMA]))
        (expect-failure "<<STAGEZ-21>> ...and so is one amount against two targets"
            "Length of stoicism-amounts and stoicism-targets must be the same"
            (DSP.A_StoicismMinter [1.0] [KST.EMMA KST.LUMY]))
    ]
)
(env-sigs [])
(commit-tx)
