;;
;; REPL/modules/STAGE-Z.repl — canonical integration layout (OuronetInformational/ARCHITECTURE/REPL_AND_TESTS.md)
;;   Inter-tx:   ;;|| NEXT >  (same three lines as REPL/Stage_01/[2.2]_Core.repl)
;;   Intra-tx:   ;;==== <TX label> · mm · <slug> ====  + next-line (print "--- [<label> · mm · …] ---"); mm = 01.. within each (begin-tx …) (see OuronetInformational/ARCHITECTURE/REPL_AND_TESTS.md).
;;   format "{}": Talos / module echoes and (env-gas) — document additional prefixes in this file's (print …) lines as needed.
;;
(print "")
(print "================================================================")
(print "FILE  REPL/modules/STAGE-Z.repl")
(print "================================================================")
(print "Legend (terminal observability): see ;; preface; echoes use <(…)> where helpful.")
(print "Source: ;;|| NEXT > between txs; ;;==== … · mm · … ==== + banner before each begin-tx.")
(print "")
;; REPL/modules/STAGE-Z.repl — STANDALONE tester for the Stage-Z read layer (DPL-UR + EXPLORER).
;;
;; These two modules had ZERO reached functions (7 of 7 and 71 of 72 never touched by any test),
;; surfaced by _scale_report.py. They ARE deployed in the gate — ZALL loads deploy-stagezz — but
;; deploying is not calling.
;;
;; WHY THEY WERE UNREACHED, established by probing rather than assumed: their aggregate readers
;; hardcode LIVE-CHAIN ids (Auryndex-O136CBn22ncY and friends, the mainnet deployment hash). A REPL
;; sandbox derives its own hash, so those rows cannot exist and the reader aborts. EXPLORER's
;; URC_0001_LandingPage fails exactly that way. Full write-up, with the two remedies and why this
;; file does not apply either: memories/2026-09-11-stage-z-reads-are-mainnet-only.md.
;;
;; WHAT THIS FILE DOES INSTEAD. The hardcoding affects the AGGREGATE readers, not the display
;; helpers underneath them — and those helpers are pure functions whose exact output a UI renders.
;; A silent format change there is a broken interface with no compile error and, until now, no test.
;; So this pins the FORMATS, character for character.
;;
;; Run: cd REPL && pact modules/STAGE-Z.repl
(load "../deploy-stage00.repl")
(load "../deploy-stage01.repl")
;;SWP POOLS. Added deliberately: 13 of DPL-UR's unreached readers take a <swpair>, and the
;;deploy-only chain has none -- which is why this file could only ever test formatters. The
;;ISSUANCE-ONLY variant is used rather than the full [6.3]_SWP suite because it is the cheap path
;;(measured: the whole load below runs in ~8s) and pools are all these readers need.
(load "../Stage_01/[6.2+3]_DPTF-SWP_Issuance-Only.repl")
(load "../deploy-stage02.repl")
(load "../deploy-stagezz.repl")
;;THE APPREADS MODULES, because DPL-UR no longer answers most of what this suite asks.
;;
;;It went into ARCHIVE MODE on 2026-09-25 (§7.21) and 57 of its definitions moved to
;;`AppReads/`. The assertions below were NOT deleted with them -- each was RETARGETED at the
;;function that replaced it, so the coverage this file represents survives the migration
;;instead of quietly shrinking with it. Where a formatter moved under a different name the
;;successor was confirmed BY OUTPUT, not by name: UC_ConvertPrice/UC_Price both give "1.50$",
;;UC_FormatIndex/UC_Index both give "1,[500.000.000.000]", UC_PoolTypeWord/URC_PoolTypeWord
;;both give ["S" "Stable"], and so on.
;;
;;What still points at DPL-UR below is what is still IN DPL-UR: the constants, the governance
;;echo, and the readers that were never ported because nothing consumes them.
(begin-tx "STAGEZ-00 -- the AppReads read layer")
(env-gasmodel "table")(env-gaslimit 150000000)(env-gas 0)
(env-sigs
  [{"key": "1a4e15d3c51e0b73e92644600487ba8eaae312e1a178b91801d54e13c1b350a5", "caps": []}])
(namespace "ouronet-ns")
(load "../../2_CITIZEN/Stage_Z/AppReads/00_Ids.pact")
(load "../../2_CITIZEN/Stage_Z/AppReads/OuronetUI/01_O-UI-ONE.pact")
(load "../../2_CITIZEN/Stage_Z/AppReads/OuronetUI/02_O-UI-TWO.pact")
(load "../../2_CITIZEN/Stage_Z/AppReads/OuronetUI/03_O-UI-THREE.pact")
(load "../../2_CITIZEN/Stage_Z/AppReads/OuronetUI/07_O-UI-SEVEN.pact")
(load "../../2_CITIZEN/Stage_Z/AppReads/OuronetUI/08_O-UI-EIGHT.pact")
(load "../../2_CITIZEN/Stage_Z/AppReads/OuronetUI/09_O-UI-NINE.pact")
(load "../../2_CITIZEN/Stage_Z/AppReads/OuronetUI/10_O-UI-TEN.pact")
(load "../../2_CITIZEN/Stage_Z/AppReads/OuronetUI/12_O-UI-TWELVE.pact")
(load "../../2_CITIZEN/Stage_Z/AppReads/OuronetUI/13_O-UI-THIRTEEN.pact")
(load "../../2_CITIZEN/Stage_Z/AppReads/OuronetUI/14_O-UI-FOURTEEN.pact")
(env-sigs [])
(commit-tx)

;;|| NEXT >
;;
(begin-tx "STAGEZ-01 — DPL-UR display formatters, pinned character for character")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
;;==== STAGEZ-01 — DPL-UR display formatters, pinned character for character · 01 · namespace ==== 
(print "--- [STAGEZ-01 — DPL-UR display formatters, pinned character for character · 01 · namespace] ---")
(namespace "ouronet-ns")
(print "--- [STAGEZ-01 · 01 · number and account formatting] ---")
;;Every assertion below is an EXACT string. That is deliberate: these values are rendered directly
;;in a deployer UI, so "returns a string" would pass while the display silently changed. The point
;;of the test is the exact shape.
(map print
    [
        ;;trailing zeros are trimmed, but a genuine decimal is kept
        ;;UC_TrimDecimalTrailingZeros was asserted here. It is gone: archive mode found it had
        ;;ZERO callers -- in DPL-UR, in the UI, anywhere -- and no AppReads successor, because
        ;;no page ever wanted a trimmed decimal. A test is not a reason to keep code alive.
        ;;prices render with two decimals and a currency mark
        (expect "<<STAGEZ-01>> a price renders with 2 decimals and a $ suffix"
            "1.50$" (O-UI-TWO.UC_Price 1.5))
        ;;the index format is unusual and entirely convention -- exactly why it needs pinning
        (expect "<<STAGEZ-01>> the ATS index renders in its grouped [] form"
            "1,[500.000.000.000]" (O-UI-ONE.UC_Index 1.5))
        ;;token amounts keep 4 decimals, zeros INCLUDED (the opposite rule to the trimmer above --
        ;;two helpers, two conventions, and nothing but this test says which is which)
        (expect "<<STAGEZ-01>> a token amount keeps 4 decimals including trailing zeros"
            "1234.5000" (O-UI-TWELVE.UC_Amount 1234.5))
        ;;THE SUB-THRESHOLD SENTINEL, WHICH NEVER ONCE FIRED BEFORE THIS. UC_FormatTokenAmount
        ;;compared its formatted STRING against the DECIMAL literal 0.0, so `<0.0001` was
        ;;unreachable; the AppReads copies compared against "0.0", which `(floor x 4)` never
        ;;produces either -- it always formats to four places. Both branches are pinned now,
        ;;because dust and nothing are different facts and a holder of dust was being shown a
        ;;flat zero.
        (expect "<<STAGEZ-01>> a non-zero amount below 4dp reads as the sentinel, not as zero"
            "<0.0001" (O-UI-TWELVE.UC_Amount 0.00001))
        (expect "<<STAGEZ-01>> ...while a genuine zero still reads as zero"
            "0.0000" (O-UI-TWELVE.UC_Amount 0.0))
        (expect "<<STAGEZ-01>> ...and the list form applies the same rule element-wise"
            ["1.1000" "2.2000"] (O-UI-TWELVE.UC_AmountList [1.10 2.20]))
        ;;account elision: a 162-glyph account is shortened for display. The ellipsis form is what
        ;;a user reads to recognise their own account, so its shape matters.
        (expect "<<STAGEZ-01>> a glyph account is elided to head...tail"
            ["Ѻ.éXø...Ìàî"] (O-UI-TWELVE.URC_ShortAccounts [KST.ANHD]))
    ]
)
(commit-tx)

;;|| NEXT >
