(begin-tx "STAGEZ-10 -- the duplicated binding block in URC_PrimordialPrices is EQUIVALENT")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
;;==== STAGEZ-10 -- the duplicated binding block in URC_PrimordialPrices is EQUIVALENT · 01 · namespace ==== 
(print "--- [STAGEZ-10 -- the duplicated binding block in URC_PrimordialPrices is EQUIVALENT · 01 · namespace] ---")
(namespace "ouronet-ns")
(print "--- [STAGEZ-10 . 01 . positional ids vs named ids] ---")
;;URC_PrimordialPrices binds ouro/auryn/elite-auryn/wstoa/sstoa TWICE in one `let`: first
;;POSITIONALLY out of URC_PrimordialIDs ((at 4 p-ids) -> wstoa), then by NAME from DALOS. The
;;second wins, so the first block is dead code. `_conformance.py --rule shadowed-let-binding`
;;reports it.
;;
;;It reads as though one of the two must be wrong, and the positional one looks like the suspect --
;;which is presumably why nobody has deleted either. It was checked by execution instead of by
;;eye, and they AGREE. This pins that, so the dead half can be removed safely rather than left
;;alone forever because no one could tell which was authoritative.
;;
;;It also pins the ORDER of URC_PrimordialIDs from the consumer side: reorder that list and this
;;fails, which is the early warning the positional binding itself would not give.
(map print
    [
        (expect "<<STAGEZ-10>> positional id 0 == DALOS's named OuroborosID"
            (DALOS.UR_OuroborosID)   (at 0 (DPL-UR.URC_PrimordialIDs)))
        (expect "<<STAGEZ-10>> positional id 2 == named AurynID"
            (DALOS.UR_AurynID)       (at 2 (DPL-UR.URC_PrimordialIDs)))
        (expect "<<STAGEZ-10>> positional id 3 == named EliteAurynID"
            (DALOS.UR_EliteAurynID)  (at 3 (DPL-UR.URC_PrimordialIDs)))
        ;;these two are the ones that look wrong and are not: the wrapped/silver STOA ids really
        ;;are the DWK/DLK entries at index 4 and 5
        (expect "<<STAGEZ-10>> positional id 4 == named WrappedStoaID (the DWK entry)"
            (DALOS.UR_WrappedStoaID) (at 4 (DPL-UR.URC_PrimordialIDs)))
        (expect "<<STAGEZ-10>> positional id 5 == named SilverStoaID (the DLK entry)"
            (DALOS.UR_SilverStoaID)  (at 5 (DPL-UR.URC_PrimordialIDs)))
    ]
)
(commit-tx)

