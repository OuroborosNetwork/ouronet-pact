(begin-tx "STAGEZ-08 -- the STOA collection split, pinned on CONSERVATION")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
;;==== STAGEZ-08 -- the STOA collection split, pinned on CONSERVATION · 01 · namespace ==== =======
(print "--- [STAGEZ-08 -- the STOA collection split, pinned on CONSERVATION · 01 · namespace] ---")
(namespace "ouronet-ns")
(print "--- [STAGEZ-08 . 01 . four receivers, and no dust] ---")
;;URC_SplitStoaPriceForReceivers divides a STOA payment 10/20/30/40 between four protocol accounts.
;;The failure that matters for a money-splitter is not "wrong shape", it is VALUE LEAKING: parts
;;that no longer sum to the input because each was rounded down independently. So that is what is
;;asserted, across a spread of prices chosen to break it -- a round number, a price that does not
;;divide evenly, and two BELOW the 12-dp STOA precision where naive truncation would round a share
;;to zero and silently keep the remainder.
(map print
    [
        (expect "<<STAGEZ-08>> the split conserves value exactly at every price, sub-precision included"
            [true true true true true true]
            (map (lambda (p:decimal)
                     (let ((s (DPL-UR.URC_SplitStoaPriceForReceivers p)))
                         (= p (fold (+) 0.0
                                  [(at "10%-p" s) (at "20%-p" s) (at "30%-p" s) (at "40%-p" s)]))))
                 [100.0 33.33 0.07 1.0 0.000000000001 0.123456789012345]))
        ;;and the proportions really are 10/20/30/40, not merely a partition that happens to sum
        (expect "<<STAGEZ-08>> ...in exactly 10/20/30/40 proportion"
            [10.0 20.0 30.0 40.0]
            (let ((s (DPL-UR.URC_SplitStoaPriceForReceivers 100.0)))
                [(at "10%-p" s) (at "20%-p" s) (at "30%-p" s) (at "40%-p" s)]))
        ;;the four receivers must be DISTINCT: a collision would silently pay one account twice
        ;;and another nothing, while every sum-based check above still passed.
        (expect "<<STAGEZ-08>> the four receivers are distinct -- a collision double-pays one account"
            4 (length (distinct (DPL-UR.URC_StoaCollectionReceivers))))
        ;;...and the split hands each share to the receiver in the SAME ORDER the receiver list
        ;;gives, which is the pairing the whole function exists to establish
        (expect "<<STAGEZ-08>> each share goes to its receiver, in receiver-list order"
            (DPL-UR.URC_StoaCollectionReceivers)
            (let ((s (DPL-UR.URC_SplitStoaPriceForReceivers 100.0)))
                [(at "10%-r" s) (at "20%-r" s) (at "30%-r" s) (at "40%-r" s)]))
    ]
)
(commit-tx)

