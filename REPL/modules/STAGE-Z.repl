(begin-tx "STAGEZ-19 -- swpair readers that were unreachable without pools")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
;;==== STAGEZ-19 -- swpair readers that were unreachable without pools · 01 · namespace ==== ======
(print "--- [STAGEZ-19 -- swpair readers that were unreachable without pools · 01 · namespace] ---")
(namespace "ouronet-ns")
(print "--- [STAGEZ-19 . 01 . the pool-dependent readers] ---")
;;These were in the "never reached" column purely because the chain had no pools. Asserted on
;;INTERNAL AGREEMENT rather than literals, so they keep holding as the pool set changes.
(let* ((sp:string (at 0 (SWP.URC_ActiveSwpairs)))
       (gi (O-UI-TWELVE.URC_01|Global))
       (core (O-UI-TWELVE.URC_PoolCore sp)))
    (map print
        [
            ;;ALL pools, not active ones. The first version of this assertion equated
            ;;number-of-pools with URC_ActiveSwpairs and failed 21 vs 10 -- usefully, because the
            ;;reader sources from URC_Swpairs (every pair ever issued) while the active list
            ;;excludes disabled ones. Both are correct answers to different questions, and a UI
            ;;rendering "number-of-pools" is showing the TOTAL, including pools nobody can trade.
            ;;Pinned as the real relationship so the distinction cannot quietly invert.
            (expect "<<STAGEZ-19>> the overview counts ALL pools, from URC_Swpairs"
                (length (SWP.URC_Swpairs)) (at "number-of-pools" gi))
            (expect "<<STAGEZ-19>> ...which is a superset of the ACTIVE pools, not the same list"
                true (>= (at "number-of-pools" gi) (length (SWP.URC_ActiveSwpairs))))
            (expect "<<STAGEZ-19>> ...and matches the list it carries itself"
                (at "number-of-pools" gi) (length (at "pools" gi)))
            ;;the core read reports the pool's own LP supply, not a stale or global figure
            (expect "<<STAGEZ-19>> the core read's LP supply agrees with SWP's capacity reader"
                (SWP.URC_LpCapacity sp) (at "lp-supply" core))
        ]
    )
)
(commit-tx)

