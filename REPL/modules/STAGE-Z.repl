(begin-tx "STAGEZ-15 -- the empty case across the whole selector/mapper family")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
;;==== STAGEZ-15 -- the empty case across the whole selector/mapper family · 01 · namespace ==== ==
(print "--- [STAGEZ-15 -- the empty case across the whole selector/mapper family · 01 · namespace] ---")
(namespace "ouronet-ns")
(print "--- [STAGEZ-15 . 01 . empty in, empty out] ---")
;;Five more list readers, all asserted on the EMPTY input. That is deliberate and not filler: the
;;empty case is where list code in this codebase actually breaks -- a fold seeded with a dummy row,
;;or an index range built as (enumerate 0 (- (length xs) 1)), which yields [0 -1] rather than []
;;and faults on (at 0 []). That exact fault is pinned in
;;Kursan/_verify_finding_EMPTY-LIST_01_index_iterating_cumulators.repl. These five are the control showing the
;;DPL-UR readers do NOT have it.
(map print
    [
        (expect "<<STAGEZ-15>> an empty stoic-tag list maps to an empty result"
            [] (O-UI-SEVEN.URC_03|StoicTags []))
        (expect "<<STAGEZ-15>> an empty stoa-account list maps to an empty result"
            [] (O-UI-SEVEN.URC_05|StoaAccounts []))
        (expect "<<STAGEZ-15>> filtering an empty nonce list by class yields nothing"
            [] (O-UI-TEN.URC_07|FilterByClass "DHCD-98c486052a51" true [] 1))
        (expect "<<STAGEZ-15>> reading nonce data for no nonces yields nothing"
            [] (O-UI-TEN.URC_05|NonceData "DHCD-98c486052a51" true []))
    ]
)
(commit-tx)

