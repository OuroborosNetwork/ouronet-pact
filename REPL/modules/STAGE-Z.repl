(begin-tx "STAGEZ-17 -- what a whole-table scan actually costs")
(env-gasmodel "table")(env-gaslimit 100000000)(env-gas 0)
;;==== STAGEZ-17 -- what a whole-table scan actually costs · 01 · namespace ==== ==================
(print "--- [STAGEZ-17 -- what a whole-table scan actually costs · 01 · namespace] ---")
(namespace "ouronet-ns")
(print "--- [STAGEZ-17 . 01 . point read] ---")
;;STAGEZ-04/05/06 pin that the cross-module scans are local-only. This pins the constraint that
;;applies to scans EVERYWHERE, gate or no gate: what one costs. It is the reason those readers are
;;local-only by design rather than by accident -- a reader doing several scans could not fit in a
;;transaction even if no admin were involved. Asserted here rather than left in a document.
;;
;;Measured separately at 10 / 100 / 400 / 1000 rows: a `keys` scan costs a FLAT ~40,000 gas,
;;independent of table size. (I had assumed it scaled with row count. It does not -- which matters,
;;because the linear story would have made this a future problem instead of a present one.)
;;
;;Thresholds, not exact figures: exact numbers are Pact-version-specific and would turn a real
;;signal into version churn. What must stay true is the ORDER OF MAGNITUDE -- a scan costs orders
;;more than a point read, so a reader doing several of them cannot fit in a transaction.
;;==== STAGEZ-17 -- what a whole-table scan actually costs · 02 · let / invocation ==== ===========
(print "--- [STAGEZ-17 -- what a whole-table scan actually costs · 02 · let / invocation] ---")
(let ((g0:integer (env-gas)))
    (DALOS.UR_AccountNonce KST.ANHD)
    (let ((point:integer (- (env-gas) g0)))
        (print (format "point read: {} gas" [point]))
        (map print
            [
                (expect "<<STAGEZ-17>> a point read is cheap (< 1,000 gas)"
                    true (< point 1000))
            ]
        )
    )
)
(commit-tx)

;;|| NEXT >
;;
(begin-tx "STAGEZ-17b -- and the scan, for comparison")
(env-gasmodel "table")(env-gaslimit 100000000)(env-gas 0)
;;==== STAGEZ-17b -- and the scan, for comparison · 01 · namespace ==== ===========================
(print "--- [STAGEZ-17b -- and the scan, for comparison · 01 · namespace] ---")
(namespace "ouronet-ns")
(print "--- [STAGEZ-17b . 01 . whole-table scan] ---")
;;==== STAGEZ-17b -- and the scan, for comparison · 02 · let / invocation ==== ====================
(print "--- [STAGEZ-17b -- and the scan, for comparison · 02 · let / invocation] ---")
(let ((g0:integer (env-gas)))
    (DALOS.URH_AccountCounter)
    (let ((scan:integer (- (env-gas) g0)))
        (print (format "whole-table scan: {} gas" [scan]))
        (map print
            [
                ;;the headline: one scan eats a large fraction of Kadena's 150,000 per-tx limit
                (expect "<<STAGEZ-17>> a whole-table scan costs over 10,000 gas"
                    true (> scan 10000))
                ;;...and therefore four of them -- which DPL-UR::URC_0021_CollectablesHeader does --
                ;;cannot fit in one transaction. This is the assertion the fix proposal rests on.
                (expect "<<STAGEZ-17>> ...so FOUR scans exceed the 150,000 per-tx gas limit"
                    true (> (* 4 scan) 150000))
            ]
        )
    )
)
(commit-tx)

