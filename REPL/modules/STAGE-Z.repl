(begin-tx "STAGEZ-06d -- elite rich list")
;;==== STAGEZ-06d -- elite rich list · 01 · namespace ==== ========================================
(print "--- [STAGEZ-06d -- elite rich list · 01 · namespace] ---")
(namespace "ouronet-ns")
(print "--- [STAGEZ-06d . 01 . elite rich list] ---")
;;NOTE: the file previously recorded this one as "a heavy account scan that aborts here", implying a
;;fixture problem. That was wrong: it aborts on the admin gate, before any scanning happens, and it
;;would do so on a fully populated chain too -- in a transaction. Over `/local` it runs.
(map print
    [
        (expect-failure "<<STAGEZ-06>> URC_0035_EliteAccountRichList scans DALOS's table"
            "Module admin necessary for operation but has not been acquired:ouronet-ns.DALOS"
            (O-UI-THREE.URH_02|RichList))
    ]
