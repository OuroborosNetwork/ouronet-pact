(begin-tx "STAGEZ-18 -- the LP-entry readers, now that pools exist")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
;;==== STAGEZ-18 -- the LP-entry readers, now that pools exist · 01 · namespace ==== ==============
(print "--- [STAGEZ-18 -- the LP-entry readers, now that pools exist · 01 · namespace] ---")
(namespace "ouronet-ns")
(print "--- [STAGEZ-18 . 01 . native vs frozen vs sleeping LP entries] ---")
;;Two UNPINNED guards (`python3 REPL/tools/_cheapseam.py`), both unreachable until this file had swpairs:
;;  URCv_0008b_TrueFungibleLPEntry -- "Frozen LP must be defined for this usage"
;;  URCv_0009b_OrtoFungibleLPEntry -- "Sleeping LP must be defined for this usage"
;;
;;A pool's LP token gets a frozen counterpart only via SWP|C_EnableFrozenLP, and a sleeping one
;;only via VST|C_CreateSleepingLink. A freshly issued pool has neither, so both guards fire -- and
;;the NATIVE path through the same function still works, which is what shows the guards are about
;;the missing counterpart rather than the reader being broken.
;;==== STAGEZ-18 -- the LP-entry readers, now that pools exist · 02 · let / invocation ==== =======
(print "--- [STAGEZ-18 -- the LP-entry readers, now that pools exist · 02 · let / invocation] ---")
(let ((sp:string (at 0 (SWP.URC_ActiveSwpairs))))
    (map print
        [
            ;;the native path works: same function, same pool, iz-native = true
            (expect "<<STAGEZ-18>> the NATIVE LP entry reads fine on a fresh pool"
                "P|OURO-PKOSON|LP-98c486052a51"
                (at "t2" (DPL-UR.URCv_0008b_TrueFungibleLPEntry KST.ANHD sp true)))
            ;;...while asking for the FROZEN counterpart of a pool that has none is refused
            (expect-failure "<<STAGEZ-18>> ...but the FROZEN LP entry needs a frozen counterpart to exist"
                "Frozen LP must be defined for this usage"
                (DPL-UR.URCv_0008b_TrueFungibleLPEntry KST.ANHD sp false))
            ;;and the sleeping twin, which has no native escape hatch -- it enforces unconditionally
            (expect-failure "<<STAGEZ-18>> ...and the SLEEPING LP entry likewise"
                "Sleeping LP must be defined for this usage"
                (DPL-UR.URCv_0009b_OrtoFungibleLPEntry KST.ANHD sp))
        ]
    )
)
(commit-tx)

;;|| NEXT >
