(begin-tx "STAGEZ-11 -- a mapper must equal map of its single, and empty must stay empty")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
;;==== STAGEZ-11 -- a mapper must equal map of its single, and empty must stay empty · 01 · namespace ==== 
(print "--- [STAGEZ-11 -- a mapper must equal map of its single, and empty must stay empty · 01 · namespace] ---")
(namespace "ouronet-ns")
(print "--- [STAGEZ-11 . 01 . mapper/single agreement] ---")
;;DPL-UR ships several <X>Mapper / <X>Single pairs. The mapper is meant to be the single applied
;;element-wise, but the two are written out separately, so they can drift with no compile error and
;;no visible symptom -- a UI list view quietly disagreeing with the detail view of the same row.
;;Asserting the RELATIONSHIP catches that, and keeps catching it as both sides change.
(map print
    [
        (expect "<<STAGEZ-11>> the account-selector mapper equals its single, element-wise"
            [(O-UI-SEVEN.URC_02|Account KST.ANHD)]
            (O-UI-SEVEN.URC_01|Accounts [KST.ANHD]))
        (expect "<<STAGEZ-11>> the true-fungible entry mapper equals its single, element-wise"
            [(O-UI-EIGHT.URC_02|TokenEntry KST.ANHD "OURO-98c486052a51")]
            (O-UI-EIGHT.URC_03|TokenList KST.ANHD ["OURO-98c486052a51"]))
        ;;the empty case is where mappers usually break (a fold seeded with a dummy row)
        (expect "<<STAGEZ-11>> an empty account list maps to an empty result"
            [] (O-UI-SEVEN.URC_01|Accounts []))
    ]
)
(commit-tx)

