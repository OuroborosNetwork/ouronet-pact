(begin-tx "STAGEZ-13 -- the button flags follow TWO different conventions")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
;;==== STAGEZ-13 -- the button flags follow TWO different conventions · 01 · namespace ==== =======
(print "--- [STAGEZ-13 -- the button flags follow TWO different conventions · 01 · namespace] ---")
(namespace "ouronet-ns")
(print "--- [STAGEZ-13 . 01 . can-X vs where-X, and where they disagree] ---")
;;URC_0017_TruefungibleButton returns four can-X booleans each paired with a where-X target list.
;;They look like one uniform family. They are not, and the split is invisible from the call site:
;;
;;  curl / brumate   -- ATS derives the flag FROM the list: can-curl = (< 0 (length chains)).
;;                      Flag true <=> list non-empty, always.
;;  coil / constrict -- ATS sets the flag from "is this a reward token", INDEPENDENTLY of the list.
;;                      So the flag can be TRUE while the target list is EMPTY.
;;
;;OURO on this chain demonstrates the divergence directly: constrict is true with no targets. A UI
;;that enables its button from the FLAG offers an action with nowhere to send it; one that uses the
;;LIST is correct for all four. Nothing else in the tree records this, and the @doc does not say it.
(map print
    [
        ;;the derived convention, asserted as an equivalence so it stays derived
        (expect "<<STAGEZ-13>> curl and brumate flags are equivalent to a non-empty target list"
            [true true]
            (let ((r (DPL-UR.URC_0017_TruefungibleButton KST.ANHD "OURO-98c486052a51")))
                [(= (at "curl" r)    (< 0 (length (at "where-curl" r))))
                 (= (at "brumate" r) (< 0 (length (at "where-brumate" r))))]))
        ;;...and the eligibility convention, pinned by the case that breaks the other reading
        (expect "<<STAGEZ-13>> constrict is TRUE while its target list is EMPTY -- flag != availability"
            true
            (let ((r (DPL-UR.URC_0017_TruefungibleButton KST.ANHD "OURO-98c486052a51")))
                (and (at "constrict" r) (= 0 (length (at "where-constrict" r))))))
        ;;coil shares constrict's convention; here it happens to have a target, which is exactly why
        ;;the divergence is easy to miss -- three of the four agree on any given chain state
        (expect "<<STAGEZ-13>> coil reports its one target pair on this chain"
            ["Auryndex-98c486052a51"]
            (at "where-coil" (DPL-UR.URC_0017_TruefungibleButton KST.ANHD "OURO-98c486052a51")))
    ]
)
(commit-tx)

