(begin-tx "STAGEZ-14 -- every Stage-Z module's governance resolves to the SOVEREIGN's")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
;;==== STAGEZ-14 -- every Stage-Z module's governance resolves to the SOVEREIGN's · 01 · namespace ==== 
(print "--- [STAGEZ-14 -- every Stage-Z module's governance resolves to the SOVEREIGN's · 01 · namespace] ---")
(namespace "ouronet-ns")
(print "--- [STAGEZ-14 . 01 . citizen governance delegates to DALOS] ---")
;;All three Stage-Z modules are CITIZEN modules that define their own GOV cap, each gated on a
;;GOV|Demiurgoi that delegates to DALOS. That delegation is the whole reason a citizen module cannot
;;award itself governance -- and it is one modref line per module, so a typo, a stale copy, or a
;;module that quietly answers with its own keyset would compile, deploy and never be noticed.
;;
;;Asserted against DALOS rather than against a literal keyset name, so it keeps holding when the
;;sovereign keyset is rotated -- what is being pinned is the DELEGATION, not today's answer.
(map print
    [
        (expect "<<STAGEZ-14>> DPL-UR's governance is DALOS's governance"
            (DALOS.GOV|Demiurgoi) (DPL-UR.GOV|Demiurgoi))
        (expect "<<STAGEZ-14>> EXPLORER's governance is DALOS's governance"
            (DALOS.GOV|Demiurgoi) (EXPLORER.GOV|Demiurgoi))
        (expect "<<STAGEZ-14>> the DSP+ dispenser's governance is DALOS's governance"
            (DALOS.GOV|Demiurgoi) (DSP.GOV|Demiurgoi))
        ;;and the generated testing variant inherits it too -- confirming the variant did not
        ;;acquire a governance difference along with its id substitution
        (expect "<<STAGEZ-14>> the testing variant did NOT drift in governance"
            (DALOS.GOV|Demiurgoi) (EXPLORER-TESTING.GOV|Demiurgoi))
    ]
)
(commit-tx)

