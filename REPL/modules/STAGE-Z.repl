(begin-tx "STAGEZ-07 -- the readers that DO work, pinned on their invariants")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
;;==== STAGEZ-07 -- the readers that DO work, pinned on their invariants · 01 · namespace ==== ====
(print "--- [STAGEZ-07 -- the readers that DO work, pinned on their invariants · 01 · namespace] ---")
(namespace "ouronet-ns")
(print "--- [STAGEZ-07 . 01 . constants and branch words] ---")
;;Most of DPL-UR's 63 unreached functions are not blocked by anything -- no ids, no admin gate, no
;;missing fixture. Nothing had simply ever called them. These are those, and they are asserted on
;;INVARIANTS rather than on "it returned something", because a UI reads the exact values.
(map print
    [
        ;;these two feed key construction across the whole module; a change breaks every derived key
        (expect "<<STAGEZ-07>> the namespace constant DPL-UR builds keys from"
            "ouronet-ns" (DPL-UR.CT_Namespace))
        (expect "<<STAGEZ-07>> ...and the field separator, likewise"
            "|" (DPL-UR.CT_Bar))
        ;;all three branches of the pool-type word, so the mapping cannot be silently re-lettered
        (expect "<<STAGEZ-07>> S pools read as Stable"    ["S" "Stable"]   (DPL-UR.UC_PoolTypeWord "S|A|B"))
        (expect "<<STAGEZ-07>> P pools read as Product"   ["P" "Product"]  (DPL-UR.UC_PoolTypeWord "P|A|B"))
        ;;NOTE the spelling. "Weigthed" is a TYPO in the source, and it is user-visible. It is pinned
        ;;as-is deliberately: this test records the current UI string, it does not bless it. Fixing
        ;;the typo SHOULD fail here, at which point update the expectation in the same commit.
        (expect "<<STAGEZ-07>> W pools read as Weigthed [sic -- typo pinned as-behaves]"
            ["W" "Weigthed"] (DPL-UR.UC_PoolTypeWord "W|A|B|C"))
    ]
)
(commit-tx)

;;|| NEXT >
