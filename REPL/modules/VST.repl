        (v:string "V|OURO-98c486052a51")
        (r:string "R|OURO-98c486052a51")
        (patron:string KST.ANHD)
        (emma:string KST.EMMA)
        (lumy:string KST.LUMY)
        (vn:integer (+ 1 (ref-DPOF::UR_NoncesUsed v)))
    )
    (ref-TS01-C2::VST|C_Vest patron patron patron o 100.0 0 2592000 1)
    ;;...and move past the 30-day vest so there is something to release. `env-chain-data` is the
    ;;fixture here, exactly as VST-G7 uses it; the clock is put back at the end of the block because
    ;;`rollback-tx` does NOT undo it and every later assertion in this file assumes 2035-01-01.
    (env-chain-data { "block-time": (time "2036-01-01T00:00:00Z") })
    (let
        (
            (predicted:object{OuronetInfoV2.ClientInfo} (INFO-ONE.INFO_VST|Unvest patron patron v vn))
            (ignis-before:decimal (ref-DALOS::UR_TF_AccountSupply patron false))
            (m (ref-TS01-C2::VST|C_Unvest patron patron v vn))
        )
        (map print
            [
                (expect "<<VST-I10>> INFO_VST|Unvest's quote equals what the op actually charged"
                    (- ignis-before (ref-DALOS::UR_TF_AccountSupply patron false))
                    (at "ignis-need" (at "ignis" predicted)))
