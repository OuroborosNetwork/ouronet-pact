(begin-tx "VST-G2 — DPTF|C>UPDATE-SPECIAL: the special-link rules, using VST's own linked tokens")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(namespace "ouronet-ns")
(print "--- [VST-G2 · 01 · special true-fungible link admission] ---")
;;These guards live in DPTF but are only reachable where SPECIAL tokens exist, and VST is what
;;creates them: this suite leaves MOCKA carrying a frozen link to F|MOCKA, with both owned by the
;;same account. That matters because the cap runs CAP_Owner on BOTH tokens before any of these
;;enforces, so a fixture where the two halves have different owners never reaches them at all.
;;
;;The assertions are module-qualified — (DPTF.DPTF|C>UPDATE-SPECIAL …) — so coverage credits DPTF
;;even though the block lives in the VST suite.
;;==== VST-G2 — DPTF|C>UPDATE-SPECIAL: the special-link rules, using VST's own linked tokens · 01 · env-sigs (caps) ==== 
(print "--- [VST-G2 — DPTF|C>UPDATE-SPECIAL: the special-link rules, using VST's own linked tokens · 01 · env-sigs (caps)] ---")
(env-sigs [{ "key": "PK_AncientHodler", "caps": [] }])
;;==== VST-G2 — DPTF|C>UPDATE-SPECIAL: the special-link rules, using VST's own linked tokens · 02 · let / invocation ==== 
(print "--- [VST-G2 — DPTF|C>UPDATE-SPECIAL: the special-link rules, using VST's own linked tokens · 02 · let / invocation] ---")
(let
    (
        (ref-DPTF:module{DemiourgosPactTrueFungibleV2} DPTF)
    )
    (map print
        [
            ;;precondition: MOCKA really is already linked, and MOCKB really is not. Both are
            ;;asserted, because the first guard is about exactly that difference.
            (expect "<<VST-G2>> MOCKA already carries a frozen link"
                "F|MOCKA-98c486052a51" (ref-DPTF::UR_Frozen "MOCKA-98c486052a51"))
            (expect "<<VST-G2>> ...and MOCKB carries none"
                "|" (ref-DPTF::UR_Frozen "MOCKB-98c486052a51"))
            ;;--- once set, a special link can never be re-pointed. This is the guard that makes
            ;;a frozen balance safe to hold: if the link could move, the frozen supply would
            ;;follow it to a token the holder never agreed to.
            (expect-failure "<<VST-G2>> re-linking a token that ALREADY has a frozen link is refused"
                "Special True Fungible Links (Frozen or Reserved) are immutable !"
                (test-capability (DPTF.DPTF|C>UPDATE-SPECIAL
                    "MOCKA-98c486052a51" "MOCKB-98c486052a51" 1)))
            ;;--- a special token cannot itself take a RESERVE link. Specials and LP tokens are
            ;;both excluded here, and the message names both, because either would create a
            ;;two-level special chain that the supply arithmetic does not model.
            (expect-failure "<<VST-G2>> a SPECIAL token (F|…) cannot be the main side of a reserve link"
                "cannot be a Special or LP Token"
                (test-capability (DPTF.DPTF|C>UPDATE-SPECIAL
                    "F|MOCKA-98c486052a51" "MOCKB-98c486052a51" 2)))
        ]
    )
    ""
)
;;NOT PINNED, with the reason rather than silence:
;;
;;  "When setting a Frozen Link, the main DPTF {} cannot be a Special Token" — needs a main that
;;      IS special yet has NO frozen link of its own. F|MOCKA does not qualify: the frozen link is
;;      stored symmetrically, so F|MOCKA points back at MOCKA and trips the IMMUTABLE guard three
;;      lines earlier instead. Reaching it needs an R|-prefixed token (whose frozen slot is empty)
;;      owned by the signer; this suite creates F|, Z| and H| specials but no R|.
;;
;;  "Special True Fungible cannot be RTs or Cold-RBTs" — needs the SECONDARY token to be a reward
;;      token owned by the signer. Every RT in the suite (OURO, DLK) belongs to a smart-contract
;;      account, so CAP_Owner rejects before the guard is consulted.
(commit-tx)

;;|| NEXT >
;;
;;FIXTURE, loaded HERE rather than in this file's header: the DPOF special-link guards below need
;;a plain ortofungible OWNED BY THE SIGNER, and this suite has none — VST's own Z|/H| specials
;;belong to the VST smart-contract account (Σ. prefix) by design, so CAP_Owner can never pass for
;;a user signer. mock-of.repl issues MOCKO to the patron. Loading it at the END means no existing
;;assertion in this file can be affected by the extra token.
(load "../fixtures/mock-of.repl")
;;
(begin-tx "VST-G3 — DPOF|C>UPDATE-SPECIAL: all three link kinds refuse a SPECIAL main token")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(namespace "ouronet-ns")
(print "--- [VST-G3 · 01 · special orto-fungible link admission] ---")
;;This cap is asymmetric in a way that decides where it can be tested at all: the MAIN side is a
;;DPTF and the SECONDARY side is a DPOF, and CAP_Owner runs on BOTH before any enforce. Special
;;DPTFs (F|…) stay with their issuer, but special DPOFs are transferred to the VST smart contract
;;— so the main can be special and user-owned, while the secondary must be an ORDINARY DPOF.
;;That is exactly the pairing assembled here: F|MOCKA as main, MOCKO as secondary.
;;
;;The tag then selects one of three cond branches, each with its own exclusion list:
;;
;;   1 vesting      main may not be R| F| S| W| P|   (specials AND LP tokens)
;;   2 sleeping     main may not be R| F|            (specials only — LP tokens ARE allowed)
;;   3 hibernation  main may not be R| F| S| W| P|
;;
;;All three are driven, because the SLEEPING list is deliberately shorter than the other two and
;;a single test would not show that. An edit that "tidied" the three lists into one shared
;;constant would silently forbid sleeping links on LP tokens, and only this block would notice.
;;==== VST-G3 — DPOF|C>UPDATE-SPECIAL: all three link kinds refuse a SPECIAL main token · 01 · env-sigs (caps) ==== 
(print "--- [VST-G3 — DPOF|C>UPDATE-SPECIAL: all three link kinds refuse a SPECIAL main token · 01 · env-sigs (caps)] ---")
(env-sigs [{ "key": "PK_AncientHodler", "caps": [] }])
;;==== VST-G3 — DPOF|C>UPDATE-SPECIAL: all three link kinds refuse a SPECIAL main token · 02 · let / invocation ==== 
(print "--- [VST-G3 — DPOF|C>UPDATE-SPECIAL: all three link kinds refuse a SPECIAL main token · 02 · let / invocation] ---")
(let
    (
        (ref-DPOF:module{DemiourgosPactOrtoFungibleV2} DPOF)
        (ref-DPTF:module{DemiourgosPactTrueFungibleV2} DPTF)
    )
    (map print
        [
            ;;preconditions: the fixture really is signer-owned, and the special main really has
            ;;empty special slots — otherwise the immutable guard would answer for every case.
            (expect "<<VST-G3>> MOCKO is owned by the signer"
                KST.ANHD (ref-DPOF::UR_Konto "MOCKO-98c486052a51"))
            (expect "<<VST-G3>> F|MOCKA carries no special links of its own"
                ["|" "|" "|"]
                [(ref-DPTF::UR_Vesting "F|MOCKA-98c486052a51")
                 (ref-DPTF::UR_Sleeping "F|MOCKA-98c486052a51")
                 (ref-DPTF::UR_Hibernation "F|MOCKA-98c486052a51")])
            ;;--- immutability, on the SLEEPING slot MOCKA already fills
            (expect "<<VST-G3>> MOCKA already has a sleeping link" 
                "Z|MOCKA-98c486052a51" (ref-DPTF::UR_Sleeping "MOCKA-98c486052a51"))
            (expect-failure "<<VST-G3>> ...so re-pointing it is refused"
                "Special Orto Fungible Links (Vesting, Sleeping or Hibernation) are immutable !"
                (test-capability (DPOF.DPOF|C>UPDATE-SPECIAL
                    "MOCKA-98c486052a51" "MOCKO-98c486052a51" 2)))
            ;;--- the three exclusion lists, one per tag, all with the SAME special main
            (expect-failure "<<VST-G3>> a special main is refused a VESTING link"
                "When setting a Vesting Link"
                (test-capability (DPOF.DPOF|C>UPDATE-SPECIAL
                    "F|MOCKA-98c486052a51" "MOCKO-98c486052a51" 1)))
            (expect-failure "<<VST-G3>> ...a SLEEPING link"
                "When setting a Sleeping Link"
                (test-capability (DPOF.DPOF|C>UPDATE-SPECIAL
                    "F|MOCKA-98c486052a51" "MOCKO-98c486052a51" 2)))
            (expect-failure "<<VST-G3>> ...and a HIBERNATION link"
                "When setting a Hibernation Link"
                (test-capability (DPOF.DPOF|C>UPDATE-SPECIAL
                    "F|MOCKA-98c486052a51" "MOCKO-98c486052a51" 3)))
        ]
    )
    ""
)
;;NOT PINNED: "Special Orto Fungible cannot be a Hot-RBT" needs the SECONDARY to be a
;;reward-bearing ortofungible owned by the signer. Every RBT in the suite belongs to an ATS
;;smart-contract account, so CAP_Owner rejects two lines before the guard is consulted.
(commit-tx)

