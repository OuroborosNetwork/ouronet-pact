(begin-tx "VST-G7 — the hibernation bound, two clock guards, and a nonce that cannot be unsleeped")
(env-gasmodel "table")(env-gaslimit 150000000)(env-gas 0)
(namespace "ouronet-ns")
;;==== VST-G7 — the hibernation bound, two clock guards, and a nonce that cannot be unsleeped · 01 · env-sigs (caps) ==== 
(print "--- [VST-G7 — the hibernation bound, two clock guards, and a nonce that cannot be unsleeped · 01 · env-sigs (caps)] ---")
(env-sigs [{ "key": "PK_AncientHodler", "caps": [] }, { "key": "PK_Emma", "caps": [] }])
(print "--- [VST-G7 · 01 · hibernation must last between a day and a century] ---")
;;`VST|C>HIBERNATE` bounds its duration: `(and (>= dayz 1) (<= dayz 36500))`. Pure argument-domain, and
;;both ends are driven, because a guard written `(>= dayz 1)` alone would pass a zero test and fail
;;nothing else -- one case cannot tell a range from a floor.
;;==== VST-G7 — the hibernation bound, two clock guards, and a nonce that cannot be unsleeped · 02 · let / invocation ==== 
(print "--- [VST-G7 — the hibernation bound, two clock guards, and a nonce that cannot be unsleeped · 02 · let / invocation] ---")
(let
    (
        (ref-DPOF:module{DemiourgosPactOrtoFungibleV2} DPOF)
        (ref-TS01-C2:module{TalosStageOne_ClientTwoV2} TS01-C2)
        (m:string "MOCKA-98c486052a51")
        (z:string "Z|MOCKA-98c486052a51")
        (v:string "V|OURO-98c486052a51")
    )
    (map print
        [
            (expect-failure "<<VST-G7>> a zero-day hibernation is refused"
                "Between 1 Day and 100 years is allowed for Hibernation"
                (ref-TS01-C2::VST|C_Hibernate KST.ANHD KST.ANHD KST.ANHD m 1.0 0))
            (expect-failure "<<VST-G7>> ...and so is one day over a century"
                "Between 1 Day and 100 years is allowed for Hibernation"
                (ref-TS01-C2::VST|C_Hibernate KST.ANHD KST.ANHD KST.ANHD m 1.0 36501))
            ;;...and 36500 -- the last legal value -- is NOT refused by this guard. Shown by the
            ;;duration guard STOPPING: a different guard (the amount check) answers instead. Cheaper
            ;;than the fixture a successful hibernation needs, and it is the whole claim.
            (expect-failure "<<VST-G7>> ...while 36500 days gets past it and the AMOUNT guard answers"
                "is not a Valid Transaction amount"
                (ref-TS01-C2::VST|C_Hibernate KST.ANHD KST.ANHD KST.ANHD m 0.0 36500))
        ]
    )
    (print "--- [VST-G7 · 02 · two guards whose real subject is the clock] ---")
    ;;Neither of these reads a flag -- both compare an amount that TIME releases. They were unpinned
    ;;because by the end of this file the suite's clock (2035) is long past every release date the
    ;;fixtures use (2026), so everything is fully released and both guards pass.
    ;;
    ;;The fixture is therefore the CLOCK, rewound to before the releases. Nothing is written and there
    ;;is nothing to restore but `env-chain-data` itself -- the cheapest fixture in the suite, same move
    ;;as VST-G6. When a guard compares against a release date, reach for this before touching tables.
    (let ((now:time (at "block-time" (chain-data))))
        (map print
            [
                ;;nonce 6 is the one driven below: in circulation, and carrying ordinary
                ;;`release-amount` metadata. Nonce 1 is NOT usable for this -- it is out of
                ;;circulation (supply -1.0, holder BAR, the state DPOF-G6 describes) and a guard pinned
                ;;with a dead nonce leaves a reader unsure which fact caused the refusal.
                (expect "<<VST-G7>> nonce 6 is in circulation and nonce 1 is not"
                    [true false]
                    [(> (ref-DPOF::UR_NonceSupply z 6) 0.0)
                     (> (ref-DPOF::UR_NonceSupply z 1) 0.0)])
                (expect "<<VST-G7>> ...and the vested nonce releases its 100 in 2026, long before now"
                    true (> (diff-time now
                                (at "release-date" (at 0 (ref-DPOF::UR_NonceMetaData v 1)))) 0.0))
            ]
        )
        (env-chain-data { "block-time" : (time "2026-01-01T00:00:00Z") })
        (map print
            [
                ;;UNSLEEP requires the WHOLE amount to have been released: `(= nonce-supply
                ;;culled-amount)`. Rewound before the schedule, culled is short of supply.
                (expect-failure "<<VST-G7>> a sleeping nonce cannot be unsleeped before its release"
                    "Z|MOCKA-98c486052a51 Nonce 6 cannot be unsleeped yet"
                    (ref-TS01-C2::VST|C_Unsleep KST.ANHD KST.ANHD z 6))
                ;;CULL (reached through C_Unvest) requires SOMETHING to have vested: `(> culled-amount
                ;;0.0)`. Rewound before the first release date, nothing has.
                (expect-failure "<<VST-G7>> ...and a vested nonce cannot be culled before anything vests"
                    "Nonce 1 cant be culled"
                    (ref-TS01-C2::VST|C_Unvest KST.ANHD KST.ANHD v 1))
            ]
        )
        (print "--- [VST-G7 · 03 · FIXED: the merged nonce is readable again] ---")
        ;;THIS SECTION USED TO PIN A DEFECT AS-BEHAVES, and it is worth keeping the history because
        ;;the first diagnosis was wrong in a way that would have produced a worse fix.
        ;;
        ;;WHAT WAS OBSERVED: unsleeping nonce 3 reached no guard at all --
        ;;    Runtime typecheck failure, argument is list , but expected type
        ;;    list (object{ouronet-ns.VestingV2.VST|MetaDataSchema})
        ;;Nonce 3 was minted by VST-07 merging nonces 1 and 2. It carried {mint-time, release-date}
        ;;while VST|MetaDataSchema is {release-amount, release-date}, so it failed Pact's runtime
        ;;typecheck on the way in and the holding was stuck: in circulation, held by a real account,
        ;;and un-unsleepable at any clock.
        ;;
        ;;THE FIRST DIAGNOSIS -- "C_Slumber writes the wrong metadata shape" -- was WRONG, and acting
        ;;on it would have broken the hibernation path. XIv_MergeNonces already branches correctly on
        ;;its vzh-tag (2 = sleeping metadata, 3 = hibernating). The real fault was one level up:
        ;;NEITHER VST|C>MERGE NOR VST|C>SLUMBER CHECKED WHAT KIND OF DPOF THEY WERE GIVEN, so the
        ;;metadata shape was decided by which CLIENT the caller picked rather than by what the TOKEN
        ;;is. VST-07 called C_Slumber (tag 3) on a SLEEPING token and stamped hibernation metadata
        ;;onto it.
        ;;
        ;;FIXED 2026-09-12, owner-ruled, in two parts:
        ;;  1. VST|C>MERGE now enforces a Z| token and VST|C>SLUMBER an H| one, so the misuse is
        ;;     refused outright instead of silently corrupting a row;
        ;;  2. VST-07 and vst-harness.repl now call C_Merge, the correct client for sleeping nonces.
        ;;The kind guard was deliberately NOT added to the REPURPOSE pair: RepurposeSlumber is the
        ;;only exit for a row that was already minted wrong, and guarding it would strand exactly the
        ;;holders the fix protects.
        ;;
        ;;WHAT THE ASSERTIONS SHOW NOW: the shape is right, and unsleep reaches the MATURITY guard --
        ;;a real rule with a real message -- instead of dying in the typechecker.
        (map print
            [
                (expect "<<VST-G7>> nonce 3 now carries release-amount, like its sleep-minted siblings"
                    [false true]
                    [(contains "mint-time"
                        (format "{}" [(ref-DPOF::UR_NonceMetaData z 3)]))
                     (contains "release-amount"
                        (format "{}" [(ref-DPOF::UR_NonceMetaData z 3)]))])
                (expect "<<VST-G7>> ...matching nonce 6, which C_Sleep minted directly"
                    true (contains "release-amount"
                        (format "{}" [(ref-DPOF::UR_NonceMetaData z 6)])))
                ;;THE PROOF THE STUCK HOLDING IS FREED, and it is stronger than a message check:
                ;;VST-11 above ALREADY released this nonce successfully, which is only possible
                ;;because the shape is right. A decommissioned (-1.0) supply here is the receipt.
                ;;Before the fix this read 200.0 -- value sitting in a nonce no path could reach.
                (expect "<<VST-G7>> ...and it was RELEASED by VST-11, not stranded at 200.0"
                    -1.0 (ref-DPOF::UR_NonceSupply z 3))
            ]
        )
        ;;restore the clock, and ASSERT the restore -- an earlier test this session asserted a restore
        ;;it had not performed, and the assertion is the only reason it was caught.
        (env-chain-data { "block-time" : now })
        (map print
            [
                (expect "<<VST-G7>> the clock is restored"
                    now (at "block-time" (chain-data)))
                ;;...and at the restored clock it is still the maturity rule answering, so the
                ;;behaviour is a schedule, not a clock artefact.
                (expect-failure "<<VST-G7>> ...and the maturity rule still answers at the suite's own clock"
                    "Nonce 3 cannot be unsleeped yet"
                    (ref-TS01-C2::VST|C_Unsleep KST.ANHD KST.ANHD z 3))
            ]
        )
    )
    ""
)
(env-sigs [])
(commit-tx)

;;|| NEXT >
;;|| VST-G10 — the two DPOF-kind guards added with the C_Slumber fix.
;;
(begin-tx "VST-G10 - the merge clients refuse the wrong DPOF kind")
(env-gasmodel "table")(env-gaslimit 100000000)(env-gas 0)
(namespace "ouronet-ns")
;;==== VST-G10 - the merge clients refuse the wrong DPOF kind · 01 · env-sigs (caps) ==== =========
(print "--- [VST-G10 - the merge clients refuse the wrong DPOF kind · 01 · env-sigs (caps)] ---")
(env-sigs [{ "key": "PK_AncientHodler", "caps": [] }])
(print "--- [VST-G10 · 01 · Merge wants Z|, Slumber wants H|] ---")
;;`11_VST.pact:471` and `:477`, both ADDED 2026-09-12 as the fix for the un-unsleepable nonce
;;(VST-G7 section 03). Pinning guards this session introduced is not ceremony: a guard nobody drives
;;is a guard nobody knows fires, and these two are the whole fix -- without them the metadata shape
;;is chosen by which client the caller picks rather than by what the token is.
;;
;;BOTH DIRECTIONS OF BOTH GUARDS, which for a pair of mirrored rules is the minimum that means
;;anything: each client must ACCEPT its own kind and REFUSE the other's. Two refusals alone would be
;;satisfied by a pair of clients that refuse everything.
;;==== VST-G10 - the merge clients refuse the wrong DPOF kind · 02 · let / invocation ==== ========
(print "--- [VST-G10 - the merge clients refuse the wrong DPOF kind · 02 · let / invocation] ---")
(let
    (
        (ref-TS01-C2:module{TalosStageOne_ClientTwoV2} TS01-C2)
        (ref-DPOF:module{DemiourgosPactOrtoFungibleV2} DPOF)
        (slp:string "Z|MOCKA-98c486052a51")
        (hib:string "H|MOCKA-98c486052a51")
    )
    (map print
        [
            ;;the premise: two live DPOFs of different kinds on the same underlying
            (expect "<<VST-G10>> both a SLEEPING and a HIBERNATING dpof exist for MOCKA"
                ["Z|" "H|"] [(take 2 slp) (take 2 hib)])
            ;;CROSS PAIR 1 -- Slumber (hibernation merge) refuses a sleeping token. THIS is the
            ;;combination that used to succeed and mint the un-unsleepable nonce.
            (expect-failure "<<VST-G10>> Slumber refuses a SLEEPING dpof"
                "Slumber requires a Hibernating DPOF"
                (ref-TS01-C2::VST|C_Slumber KST.ANHD KST.ANHD slp [1 2]))
            ;;CROSS PAIR 2 -- and Merge (sleeping merge) refuses a hibernating one, the mirror.
            (expect-failure "<<VST-G10>> ...and Merge refuses a HIBERNATING dpof"
                "Merge requires a Sleeping DPOF"
                (ref-TS01-C2::VST|C_Merge KST.ANHD KST.ANHD hib [1 2]))
            ;;...and each guard is checked BEFORE the nonce-shape rule, so a wrong-kind token is
            ;;refused on kind even when the nonce list is also invalid. That ordering is what makes
            ;;the message accurate rather than incidental.
            (expect-failure "<<VST-G10>> the kind check answers before the nonce-count rule"
                "Slumber requires a Hibernating DPOF"
                (ref-TS01-C2::VST|C_Slumber KST.ANHD KST.ANHD slp [1]))
        ]
    )
    ""
)
(env-sigs [])
;;nothing was written -- every call above was refused in its capability
(commit-tx)

;;|| NEXT >
