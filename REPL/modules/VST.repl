(begin-tx "VST-I3 — INFO_VST|Freeze quote vs measured charge")
(env-gasmodel "table")(env-gaslimit 100000000)(env-gas 0)
(namespace "ouronet-ns")
(print "--- [VST-I3 · 01 · freeze moves balance into the F| twin] ---")
;;FUNCTION COVERAGE (G6) — `INFO_VST|Freeze`, per the owner's spec: an INFO_ must report the same cost
;;the op actually charges. Template: `modules/ATS.repl <<ATS-I1>>`.
;;
;;WHY THIS FAMILY NEEDS MEASURING AND CANNOT BE STATICALLY CHECKED. `VST::URCi_Freeze` is an AGGREGATE
;;— a sigma over the component legs the operation really bills (mint/burn/transfer cumulators). So
;;the preview deliberately names a cost function the exec never calls, and any static "does the
;;preview quote what the exec quotes" check reports the whole family as drifting. The only question
;;that matters — does the aggregate equal the sum of the legs? — is numeric, and only the scales
;;answer it. That is what this block is.
(env-sigs [{ "key": "PK_AncientHodler", "caps": [] }])
(let
    (
        (ref-TS01-C2:module{TalosStageOne_ClientTwoV2} TS01-C2)
        (ref-DPOF:module{DemiourgosPactOrtoFungibleV2} DPOF)
        (ref-DALOS:module{OuronetDalosV2} DALOS)
        (a:string "MOCKA-98c486052a51")
        (patron:string KST.ANHD)
    )
    (let
        (
            (predicted:object{OuronetInfoV2.ClientInfo} (INFO-ONE.INFO_VST|Freeze patron patron patron a 10.0))
            (ignis-before:decimal (ref-DALOS::UR_TF_AccountSupply patron false))
            (msg-f:string (ref-TS01-C2::VST|C_Freeze patron patron patron a 10.0))
        )
        (map print
            [
                (expect "<<VST-I3>> the preview's IGNIS quote equals what the op charged"
                    (- ignis-before (ref-DALOS::UR_TF_AccountSupply patron false))
                    (at "ignis-need" (at "ignis" predicted)))
                (expect "<<VST-I3>> ...and it is a real, non-zero charge"
                    true (> (- ignis-before (ref-DALOS::UR_TF_AccountSupply patron false)) 0.0))
            ]
        )
    )
    ""
)
(env-sigs [])
;;discarded — the harness's balances and nonce ledger are left exactly as found
(rollback-tx)

