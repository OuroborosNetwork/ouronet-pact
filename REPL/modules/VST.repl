;;
;; REPL/modules/VST.repl — canonical integration layout (OuronetInformational/ARCHITECTURE/REPL_AND_TESTS.md)
;;   Inter-tx:   ;;|| NEXT >  (same three lines as REPL/Stage_01/[2.2]_Core.repl)
;;   Intra-tx:   ;;==== <TX label> · mm · <slug> ====  + next-line (print "--- [<label> · mm · …] ---"); mm = 01.. within each (begin-tx …) (see OuronetInformational/ARCHITECTURE/REPL_AND_TESTS.md).
;;   format "{}": Talos / module echoes and (env-gas) — document additional prefixes in this file's (print …) lines as needed.
;;
(print "")
(print "================================================================")
(print "FILE  REPL/modules/VST.repl")
(print "================================================================")
(print "Legend (terminal observability): see ;; preface; echoes use <(…)> where helpful.")
(print "Source: ;;|| NEXT > between txs; ;;==== … · mm · … ==== + banner before each begin-tx.")
(print "")
;; REPL/modules/VST.repl — STANDALONE VST (vesting/freezing/sleeping) tester.
;;
;; P2 rebuild. The previous version asserted NOTHING about VST -- it printed exactly the deploy
;; core's 11 expect / 7 expect-failure baseline and passed because booting a chain passes.
;;
;; VST keeps almost no state of its own (it has 2 readers): a VST operation converts a DPTF
;; balance into a nonce on a LINKED special ortofungible. So the assertions here are about the
;; DPTF side (URC_Has*, supply) and the DPOF side (nonce created, holder, value) -- which is the
;; honest shape of what VST does.
;;
;; Run: cd REPL && pact modules/VST.repl
(load "../deploy-stage00.repl")
(load "../deploy-stage01.repl")
(load "../fixtures/mock-tf.repl")
(load "../fixtures/mock-tf-supply.repl")

;;|| NEXT >
;;
(begin-tx "VST-01 — a plain DPTF has no special links yet")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
;;==== VST-01 — a plain DPTF has no special links yet · 01 · namespace ==== =======================
(print "--- [VST-01 — a plain DPTF has no special links yet · 01 · namespace] ---")
(namespace "ouronet-ns")
(print "--- [VST-01 · 01 · no links on a fresh token] ---")
;;==== VST-01 — a plain DPTF has no special links yet · 02 · let / invocation ==== ================
(print "--- [VST-01 — a plain DPTF has no special links yet · 02 · let / invocation] ---")
(let
    (
        (ref-DPTF:module{DemiourgosPactTrueFungibleV2} DPTF)
        (a:string "MOCKA-98c486052a51")
    )
    (map print
        [
            (expect "<<VST-01>> fresh DPTF has no frozen link"      false (ref-DPTF::URC_HasFrozen a))
            (expect "<<VST-01>> fresh DPTF has no reserved link"    false (ref-DPTF::URC_HasReserved a))
            (expect "<<VST-01>> fresh DPTF has no sleeping link"    false (ref-DPTF::URC_HasSleeping a))
            (expect "<<VST-01>> fresh DPTF has no hibernation link" false (ref-DPTF::URC_HasHibernation a))
            (expect "<<VST-01>> fresh DPTF has no vesting link"     false (ref-DPTF::URC_HasVesting a))
        ]
    )
    ""
)
(commit-tx)

;;|| NEXT >
;;
(begin-tx "VST-02 — C_CreateFrozenLink mints the linked special ortofungible")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(namespace "ouronet-ns")
(print "--- [VST-02 · 01 · create the frozen link] ---")
;;==== VST-02 — C_CreateFrozenLink mints the linked special ortofungible · 01 · let / invocation ==== 
(print "--- [VST-02 — C_CreateFrozenLink mints the linked special ortofungible · 01 · let / invocation] ---")
(let
    (
        (ref-DPTF:module{DemiourgosPactTrueFungibleV2} DPTF)
        (ref-DALOS:module{OuronetDalosV2} DALOS)
        (ref-TS01-C2:module{TalosStageOne_ClientTwoV2} TS01-C2)
        (a:string "MOCKA-98c486052a51")
        (patron:string KST.ANHD)
    )
    ;;A special LINK issues a real ortofungible, so it carries the DPOF issuance STOA cost
    ;;("dpmf" -- the historical DPMF->DPOF key). Derived, never hardcoded.
    (let ((split-stoa:[decimal]
              (ref-DALOS::URC_SplitSTOAPrices patron (ref-DALOS::UR_UsagePrice "dpmf"))))
    (env-sigs
        [
            { "key": "PK_AncientHodler", "caps": [] }
            { "key": "6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263" ,
              "caps":
                [
                    (coin.TRANSFER "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263"
                        "k:50d6c59b21e5e6e55baecaa75a1007de37576bde12d8230dc82459cc01b9484b" (at 2 split-stoa))
                    (coin.TRANSFER "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263"
                        "k:0cb30c0121ff919266121a99ff9359871818932211df94dae4137c29bc0e8f7e" (at 0 split-stoa))
                    (coin.TRANSFER "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263"
                        "c:XM-pkmuB5XUQlp87ZYSbfKt8qzmHY6O2EHAzMRVBt3k" (at 3 split-stoa))
                    (coin.TRANSFER "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263"
                        "c:iQQFWj6gWtpGEzhM_O5ekW1QtnQQy55R8BRPGhj_0FU" (at 1 split-stoa))
                ]
            }
        ]
    )
    ;;FUNCTION COVERAGE (G6) — `INFO_VST|CreateFrozenLink`, per the owner's spec: an INFO_ must report
    ;;the same cost the op actually charges. Template: `modules/ATS.repl <<ATS-I1>>`.
    ;;
    ;;<<VST-I1>> DEFECT FIX. All five `INFO_VST|Create*Link` previews returned `OI|UDC_NoStoaCosts`,
    ;;under a header comment claiming "IGNIS only; STOA auto-fuel is protocol, not a patron charge".
    ;;That conflated two different things: the protocol auto-fuel really is not a patron charge (and
    ;;is inert while <native-gas-pump> is false), but `XI_CreateSpecialTrueFungibleLink` runs
    ;;`(ref-IGNIS::XE_CollectStoa patron stoa-costs)` directly — a real, discounted charge to the
    ;;patron. So all five ops cost STOA and all five were previewed as free.
    ;;
    ;;THE EVIDENCE WAS ALREADY IN THIS FILE. The four managed `coin.TRANSFER` caps signed just above
    ;;are built from `URC_SplitSTOAPrices patron (UR_UsagePrice ...)` — this test could not run
    ;;without them, because the patron's own STOA account is debited. A test that has to sign for a
    ;;charge is standing proof the charge exists; nobody had asked the preview whether it agreed.
    ;;Same shape as EQUITY / SWP / ATS — fourth module, fifth through ninth instance.
    (let (
            (predicted:object{OuronetInfoV2.ClientInfo} (INFO-ONE.INFO_VST|CreateFrozenLink patron a))
            (stoa-before:decimal (coin.get-balance (ref-DALOS::UR_AccountStoa patron)))
            (ignis-before:decimal (ref-DALOS::UR_TF_AccountSupply patron false))
            (created:[string] (ref-TS01-C2::VST|C_CreateFrozenLink patron (ouronet-ns.DPTF.UR_Konto a) a))
         )
        (print (format "<(VST|C_CreateFrozenLink)> => {}" [created]))
        (map print
            [
                (format "<<VST-I1>> STOA predicted={} real={}"
                    [(at "stoa-need" (at "stoa" predicted))
                     (- stoa-before (coin.get-balance (ref-DALOS::UR_AccountStoa patron)))])
                ;;THE REGRESSION: this asserted 0.0 == <the real fee> before the fix.
                (expect "<<VST-I1>> the preview's STOA quote equals what creating the link charged"
                    (- stoa-before (coin.get-balance (ref-DALOS::UR_AccountStoa patron)))
                    (at "stoa-need" (at "stoa" predicted)))
                ;;...and creating a link genuinely costs STOA, so the equality above cannot be the
                ;;old bug agreeing with itself at zero.
                (expect "<<VST-I1>> ...and creating a special link is NOT free"
                    true (> (- stoa-before (coin.get-balance (ref-DALOS::UR_AccountStoa patron))) 0.0))
                                ;;...and the IGNIS half, which now agrees too.
                (format "<<VST-I1>> IGNIS predicted={} real={}"
                    [(at "ignis-need" (at "ignis" predicted))
                     (- ignis-before (ref-DALOS::UR_TF_AccountSupply patron false))])
                ;;DEFECT FIX (2026-09-14), and it was a REVENUE bug, not a quoting one. This block used
                ;;to pin a disagreement — 719.74 quoted against 601.02 charged — as a FINDING, because
                ;;the two sides were wrong in OPPOSITE directions and it was not clear which to trust:
                ;;
                ;;    preview leg 1 = vst-link deterrence 279.0 + issue 1070.0   (one folded leg)
                ;;    preview legs 2+3 = 5.0 + a hand-made 4.0 "leg cumulator"
                ;;    exec          = issue 1070.0 + update 5.0 + the REAL toggle 59.0, NO deterrence
                ;;
                ;;The owner settled the design: a special link costs a SMALL DETERRENCE plus payment IN
                ;;FULL for the token it issues. That makes both sides wrong in a decidable way —
                ;;    the EXEC was under-collecting the 279.0 deterrence it was designed to charge;
                ;;    the PREVIEW was under-modelling the transfer-role toggle as 4.0 against a real 59.0.
                ;;Both are corrected in `11_VST.pact`, and the deterrence now comes from ONE reader
                ;;(`URCi_CreateSpecial*LinkDeterrence`) that the preview and the exec both call, so the
                ;;pair cannot drift apart again.
                ;;
                ;;    intended = 279.0 + 1070.0 + 5.0 + 59.0 = 1413.0 raw -> 748.89 at this patron's discount
                ;;
                ;;The preview also SPLITS the deterrence and the issue into two legs rather than folding
                ;;them into one: `UDC_PrimeIgnisCumulator` discounts and quarter-splits PER LEG, so a
                ;;preview with a different leg count can round differently from its exec even when the
                ;;totals are algebraically equal.
                ;;
                ;;BLAST RADIUS — the reader pair is shared, so SEVEN previews were affected and are now
                ;;all correct: `INFO_VST|CreateFrozenLink` / `CreateReservationLink` (TrueFungible),
                ;;`CreateVestingLink` / `CreateSleepingLink` / `CreateHibernatingLink` (Orto), and
                ;;`INFO_SWP|EnableFrozenLP` / `EnableSleepingLP`, which preview the same link creation.
                ;;The SWP pair is asserted the same way at `modules/SWP.repl <<SWP-I8>>` / `<<SWP-I9>>`.
                (expect "<<VST-I1>> the IGNIS quote equals the IGNIS charged"
                    (- ignis-before (ref-DALOS::UR_TF_AccountSupply patron false))
                    (at "ignis-need" (at "ignis" predicted)))
                (expect "<<VST-I1>> ...and it is a real, non-zero charge"
                    true (> (- ignis-before (ref-DALOS::UR_TF_AccountSupply patron false)) 0.0))
                ;;the deterrence really is IN the charge now — without this the equality above would
                ;;pass just as well if both sides had dropped it together
                (expect "<<VST-I1>> ...and the charge really includes the vst-link deterrence"
                    true (> (- ignis-before (ref-DALOS::UR_TF_AccountSupply patron false))
                            (* (ref-DALOS::URC_IgnisGasDiscount patron)
                               (+ (ref-DPTF::URCi_IssueGas 1) 64.0))))
                (expect "<<VST-02>> C_CreateFrozenLink registered the frozen link on the DPTF"
                    true (ref-DPTF::URC_HasFrozen a))
                (expect "<<VST-02>> creating the FROZEN link did not create the others"
                    false (ref-DPTF::URC_HasSleeping a))
                (expect "<<VST-02>> C_CreateFrozenLink returned the new special id"
                    true (< 0 (length created)))
            ]
        )
    ))
    ""
)
(commit-tx)

;;|| NEXT >
;;
(begin-tx "VST-03 — C_Freeze moves balance into the linked FROZEN DPTF")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(namespace "ouronet-ns")
(print "--- [VST-03 · 01 · freeze] ---")
;;==== VST-03 — C_Freeze moves balance into the linked FROZEN DPTF · 01 · env-sigs (caps) ==== ====
(print "--- [VST-03 — C_Freeze moves balance into the linked FROZEN DPTF · 01 · env-sigs (caps)] ---")
(env-sigs [{ "key": "PK_AncientHodler", "caps": [] }])
;;==== VST-03 — C_Freeze moves balance into the linked FROZEN DPTF · 02 · let / invocation ==== ===
(print "--- [VST-03 — C_Freeze moves balance into the linked FROZEN DPTF · 02 · let / invocation] ---")
(let
    (
        (ref-DPTF:module{DemiourgosPactTrueFungibleV2} DPTF)
        (ref-TS01-C2:module{TalosStageOne_ClientTwoV2} TS01-C2)
        (a:string "MOCKA-98c486052a51")
        ;;NOTE: the FROZEN link is itself a DPTF ("F|<id>"), not an ortofungible. Sleeping and
        ;;Hibernating are the nonce-bearing (time-locked) forms; Frozen is not. An earlier draft
        ;;read it with DPOF readers and the suite rejected that.
        (frozen:string "F|MOCKA-98c486052a51")
        (patron:string KST.ANHD)
    )
    (let
        (
            (bal0:decimal (ref-DPTF::UR_AccountSupply a patron))
            (fs0:decimal (ref-DPTF::UR_Supply frozen))
        )
        ;;C_Freeze (patron freezer FREEZE-OUTPUT dptf amount): freeze-output is the ACCOUNT
        ;;that receives the frozen balance, NOT the frozen token id.
        (ref-TS01-C2::VST|C_Freeze patron patron patron a 300.0)
        (map print
            [
                (expect "<<VST-03>> C_Freeze debited the source DPTF by exactly the amount"
                    (- bal0 300.0) (ref-DPTF::UR_AccountSupply a patron))
                (expect "<<VST-03>> C_Freeze raised the FROZEN token supply by the same amount"
                    (+ fs0 300.0) (ref-DPTF::UR_Supply frozen))
                (expect "<<VST-03>> the freezer holds the frozen balance"
                    300.0 (ref-DPTF::UR_AccountSupply frozen patron))
                (expect "<<VST-03>> the frozen token is linked back to its parent"
                    a (ref-DPTF::URCv_Parent frozen))
            ]
        )
    )
    ""
)
(commit-tx)

;;|| NEXT >
;;|| VST-G8 — an ATS guard that only a VST fixture can reach.
;;
(begin-tx "VST-G8 - ATS refuses a Special or LP token as RT or RBT")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(namespace "ouronet-ns")
;;==== VST-G8 - ATS refuses a Special or LP token as RT or RBT · 01 · env-sigs (caps) ==== ========
(print "--- [VST-G8 - ATS refuses a Special or LP token as RT or RBT · 01 · env-sigs (caps)] ---")
(env-sigs [{ "key": "PK_AncientHodler", "caps": [] }])
(print "--- [VST-G8 · 01 · the Special/LP token rule, reached from the VST side] ---")
;;THIS GUARD LIVES IN 08_ATS.pact, NOT IN VST. It is pinned here because this is the only gated
;;chain that HAS a special token: `ATS-G8` in modules/ATS.repl reaches it and gives up, recording
;;"needs a special (F|/R|) or LP (S|/W|/P|) DPTF that EXISTS in this suite ... F|MOCKA lives in the
;;VST suite". VST-03 above has just minted exactly that. So rather than cross-load an ATS fixture
;;into VST or a VST fixture into ATS, the assertion moves to the chain that already pays for the
;;state. **Check which chain already has the state before building it anywhere** -- the same rule
;;that let the AQP-LP harness reuse the SWP pairs.
;;
;;ONE OBSTACLE, and it is why this needs `env-module-admin`: `UEV_IssueData` calls `CAP_Owner` on
;;BOTH tokens before it reaches the rule, and a frozen link is owned by the DPTF smart-contract
;;account (`Σ.…`), whose guard is a module guard -- no key satisfies it. Probed rather than
;;assumed: `(UR_Konto "F|MOCKA-…")` is NOT `KST.ANHD`. Reassigning `owner-konto` for the duration
;;reproduces the ownership a normal RT candidate would have, which is the precondition the rule is
;;written to be evaluated AFTER; it does not weaken the rule under test.
;;==== VST-G8 - ATS refuses a Special or LP token as RT or RBT · 02 · let / invocation ==== =======
(print "--- [VST-G8 - ATS refuses a Special or LP token as RT or RBT · 02 · let / invocation] ---")
(let
    (
        (ref-ATS:module{AutostakeV3} ATS)
        (a:string "MOCKA-98c486052a51")
        (b:string "MOCKB-98c486052a51")
        (frozen:string "F|MOCKA-98c486052a51")
    )
    (env-module-admin DPTF)
    (update DPTF.DPTF|PropertiesTable frozen { "owner-konto" : KST.ANHD })
    (map print
        [
            (expect "<<VST-G8>> the frozen link is temporarily owned by the patron, so CAP_Owner passes"
                KST.ANHD (DPTF.UR_Konto frozen))
            ;;THE CONTRAST FIRST: two ordinary tokens, same owner, same everything else. Without this
            ;;the two refusals below would be consistent with the guard refusing every input.
            (expect "<<VST-G8>> two ordinary tokens are accepted as RT and RBT"
                true (!= "" (format "{}" [(ref-ATS::UEV_IssueData "NewPair" 12 a b)])))
            ;;THE RULE, both conjuncts. An autostake pool converts RT into RBT; a Special (F|/R|) or
            ;;LP (S|/W|/P|) token is already a derived claim on something else, so staking it would
            ;;compound a wrapper against its own wrapped supply. The guard is ONE `and` of two
            ;;`not contains`, so both sides yield the same sentence -- driving both is what shows
            ;;neither conjunct is dead.
            (expect-failure "<<VST-G8>> a SPECIAL token is refused as the REWARD token"
                "An Autostake Pool cannot be issued when either the RT or RBT are Special or LP Tokens"
                (ref-ATS::UEV_IssueData "NewPair" 12 frozen b))
            (expect-failure "<<VST-G8>> ...and equally as the REWARD-BEARING token"
                "An Autostake Pool cannot be issued when either the RT or RBT are Special or LP Tokens"
                (ref-ATS::UEV_IssueData "NewPair" 12 a frozen))
        ]
    )
    ""
)
(env-sigs [])
;;the ownership reassignment is discarded -- VST-G8b checks it
(rollback-tx)

;;|| NEXT >
;;|| VST-G8b — the ownership reassignment left no trace.
;;
(begin-tx "VST-G8b - no leakage")
(namespace "ouronet-ns")
(print "--- [VST-G8b · 01 · no leakage] ---")
;;A leaked owner-konto on the frozen link would let a later unfreeze be authorised by the wrong
;;key, which is the kind of thing that passes quietly and fails in a different file.
(print
    (expect "<<VST-G8b>> the frozen link is owned by the smart-contract account again"
        false (= (DPTF.UR_Konto "F|MOCKA-98c486052a51") KST.ANHD)))
(commit-tx)

;;|| NEXT >
;;|| VST-G9 — a SPECIAL token cannot itself be given a frozen link.
;;
(begin-tx "VST-G9 - DPTF|C>UPDATE-SPECIAL: the main DPTF cannot be Special")
(env-gasmodel "table")(env-gaslimit 150000000)(env-gas 0)
(namespace "ouronet-ns")
(print "--- [VST-G9 · 01 · a frozen link on a RESERVED token] ---")
;;`05_DPTF.pact:1010`. The obvious attempt is to freeze an already-FROZEN token, and it does not
;;reach this guard: `F|MOCKA` already carries a frozen link, so the enforce two lines ABOVE -- the
;;immutability check -- answers first. Measured, not assumed; that attempt returned
;;"Special True Fungible Links (Frozen or Reserved) are immutable !".
;;
;;THE INPUT THAT DOES REACH IT IS A **RESERVED** TOKEN WITH THE **FROZEN** TAG. `R|MOCKA` is Special
;;by prefix, but its FROZEN slot is empty (asserted below), so the immutability check passes and the
;;prefix rule is the first thing that can refuse it. The two guards read different fields -- one the
;;link slot, one the id prefix -- and only a cross-kind input separates them.
;;==== VST-G9 - DPTF|C>UPDATE-SPECIAL: the main DPTF cannot be Special · 01 · let / invocation ==== 
(print "--- [VST-G9 - DPTF|C>UPDATE-SPECIAL: the main DPTF cannot be Special · 01 · let / invocation] ---")
(let
    (
        (ref-DALOS:module{OuronetDalosV2} DALOS)
        (ref-DPTF:module{DemiourgosPactTrueFungibleV2} DPTF)
        (ref-TS01-C2:module{TalosStageOne_ClientTwoV2} TS01-C2)
        (a:string "MOCKA-98c486052a51")
        (b:string "MOCKB-98c486052a51")
    )
    ;;SIX calls are priced in this transaction, and a managed `coin.TRANSFER` cap is a BUDGET, not a
    ;;permission -- it is consumed across the whole transaction, not re-granted per call. The first
    ;;draft signed one call's worth and the SECOND call died with "STOA TRANSFER exceeded for balance
    ;;0.0", which reads like a funding problem and is not one. Sign the whole transaction's traffic.
    (let ((sp:[decimal] (map (* 6.0)
              (ref-DALOS::URC_SplitSTOAPrices KST.ANHD (ref-DALOS::UR_UsagePrice "dptf")))))
    (env-sigs
        [ { "key": "PK_AncientHodler", "caps": [] }
          { "key": "6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263" ,
            "caps":
              [ (coin.TRANSFER "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263"
                    "k:50d6c59b21e5e6e55baecaa75a1007de37576bde12d8230dc82459cc01b9484b" (at 2 sp))
                (coin.TRANSFER "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263"
                    "k:0cb30c0121ff919266121a99ff9359871818932211df94dae4137c29bc0e8f7e" (at 0 sp))
                (coin.TRANSFER "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263"
                    "c:XM-pkmuB5XUQlp87ZYSbfKt8qzmHY6O2EHAzMRVBt3k" (at 3 sp))
                (coin.TRANSFER "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263"
                    "c:iQQFWj6gWtpGEzhM_O5ekW1QtnQQy55R8BRPGhj_0FU" (at 1 sp)) ] } ]))
    ;;build the reserved token through the ORDINARY client path -- nothing forced here
    (ref-TS01-C2::VST|C_CreateReservationLink KST.ANHD (ouronet-ns.DPTF.UR_Konto a) a)
    ;;ownership only: the wrapper belongs to the VST smart-contract account, whose module guard no
    ;;key can satisfy, and CAP_Owner runs before the rule. Same obstacle as VST-G8.
    (env-module-admin DPTF)
    (update DPTF.DPTF|PropertiesTable "R|MOCKA-98c486052a51" { "owner-konto" : KST.ANHD })
    (update DPTF.DPTF|PropertiesTable "F|MOCKA-98c486052a51" { "owner-konto" : KST.ANHD })
    (map print
        [
            (expect "<<VST-G9>> the reserved token exists and is owned by the patron"
                ["R|MOCKA-98c486052a51" KST.ANHD]
                [(ref-DPTF::UR_Reservation a) (ref-DPTF::UR_Konto "R|MOCKA-98c486052a51")])
            ;;the precondition that makes this input reach the rule rather than the immutability check
            (expect "<<VST-G9>> ...and its FROZEN slot is empty, so the immutability check passes"
                "|" (ref-DPTF::UR_Frozen "R|MOCKA-98c486052a51"))
            ;;THE ITEM
            (expect-failure "<<VST-G9>> a SPECIAL token cannot be given a frozen link"
                "When setting a Frozen Link, the main DPTF R|MOCKA-98c486052a51 cannot be a Special Token"
                (ref-TS01-C2::VST|C_CreateFrozenLink KST.ANHD (ouronet-ns.DPTF.UR_Konto "R|MOCKA-98c486052a51") "R|MOCKA-98c486052a51"))
            ;;CONTRAST 1 -- an ORDINARY token takes a frozen link, so the refusal is about the prefix
            ;;and not about the operation.
            (expect "<<VST-G9>> ...while an ordinary token takes one"
                true (!= "" (format "{}" [(ref-TS01-C2::VST|C_CreateFrozenLink KST.ANHD (ouronet-ns.DPTF.UR_Konto b) b)])))
            ;;CONTRAST 2 -- the ALREADY-FROZEN token gets the OTHER message, which is what shows the
            ;;two guards are distinct rather than one wording covering both cases. It has to be
            ;;`F|MOCKA` and not `MOCKA`: pointing the client at MOCKA makes it try to ISSUE a wrapper
            ;;named F|MOCKA, which already exists, so it dies on an insert collision inside
            ;;XI_CreateSpecialTrueFungibleLink long before any guard. That is a third failure mode,
            ;;and confusing it for this one is easy -- the first draft did exactly that.
            (expect-failure "<<VST-G9>> ...and an already-linked token gets the immutability message instead"
                "Special True Fungible Links (Frozen or Reserved) are immutable !"
                (ref-TS01-C2::VST|C_CreateFrozenLink KST.ANHD (ouronet-ns.DPTF.UR_Konto "F|MOCKA-98c486052a51") "F|MOCKA-98c486052a51"))
        ]
    )
    ""
)
(env-sigs [])
;;the reservation link, the frozen link on MOCKB and the ownership move are all discarded
(rollback-tx)

;;|| NEXT >
;;|| VST-G9b — none of VST-G9's three writes survived.
;;
(begin-tx "VST-G9b - no leakage")
(namespace "ouronet-ns")
(print "--- [VST-G9b · 01 · no leakage] ---")
;;Three separate writes to undo, and the reservation is the dangerous one: later tests in this file
;;assert MOCKA's link slots, and a leaked R| link would change what they read.
(map print
    [
        (expect "<<VST-G9b>> MOCKA has no reservation link"
            "|" (DPTF.UR_Reservation "MOCKA-98c486052a51"))
        (expect "<<VST-G9b>> MOCKB has no frozen link"
            "|" (DPTF.UR_Frozen "MOCKB-98c486052a51"))
    ]
)
(commit-tx)

