(begin-tx "VST-12 — the two SPECIAL-DPTF transfer-role toggles")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(namespace "ouronet-ns")
(print "--- [VST-12 · 01 · frozen and reserved transfer roles] ---")
;;VST|C_ToggleTransferRoleFrozenDPTF and VST|C_ToggleTransferRoleReservedDPTF were reachable only
;;through Stage_01/[6.7]_VST.repl, a mid-chain suite that nothing but ZALL loads -- so a VST
;;change could break them and only the 3-minute full run would say so. They belong in the focused
;;tester.
;;
;;These two exist because a FROZEN or RESERVED DPTF is deliberately non-transferable by default:
;;that is the point of freezing and reserving. The toggle is the narrow exception, and the
;;property worth asserting is that granting on one special link does NOT leak to the other.
;;==== VST-12 — the two SPECIAL-DPTF transfer-role toggles · 01 · env-sigs (caps) ==== ============
(print "--- [VST-12 — the two SPECIAL-DPTF transfer-role toggles · 01 · env-sigs (caps)] ---")
(env-sigs [{ "key": "PK_AncientHodler", "caps": [] }])
;;==== VST-12 — the two SPECIAL-DPTF transfer-role toggles · 02 · let / invocation ==== ===========
(print "--- [VST-12 — the two SPECIAL-DPTF transfer-role toggles · 02 · let / invocation] ---")
(let
    (
        (ref-DALOS:module{OuronetDalosV2} DALOS)
        (ref-DPTF:module{DemiourgosPactTrueFungibleV2} DPTF)
        (ref-TS01-C2:module{TalosStageOne_ClientTwoV2} TS01-C2)
        (patron:string KST.ANHD)
        (lumy:string KST.LUMY)
    )
    (let
        (
            (frozen:string "F|MOCKA-98c486052a51")
            (reserved:string (ref-DPTF::UR_Reservation (ref-DALOS::UR_OuroborosID)))
        )
        (map print
            [
                (expect "<<VST-12>> baseline: no transfer role on the frozen DPTF"
                    false (ref-DPTF::UR_AccountRoleTransfer frozen lumy))
                (expect "<<VST-12>> baseline: none on the reserved DPTF either"
                    false (ref-DPTF::UR_AccountRoleTransfer reserved lumy))
            ]
        )
        (ref-TS01-C2::VST|C_ToggleTransferRoleFrozenDPTF patron (ouronet-ns.VST.URC_SpecialTransferRoleKonto frozen) frozen lumy true)
        (map print
            [
                (expect "<<VST-12>> the frozen-DPTF toggle granted it"
                    true (ref-DPTF::UR_AccountRoleTransfer frozen lumy))
                ;;THE POINT: the two special links are separate tokens with separate role sets.
                (expect "<<VST-12>> ...and it did NOT leak to the reserved DPTF"
                    false (ref-DPTF::UR_AccountRoleTransfer reserved lumy))
            ]
        )
        (ref-TS01-C2::VST|C_ToggleTransferRoleReservedDPTF patron (ouronet-ns.VST.URC_SpecialTransferRoleKonto reserved) reserved lumy true)
        (map print
            [
                (expect "<<VST-12>> the reserved-DPTF toggle granted it"
                    true (ref-DPTF::UR_AccountRoleTransfer reserved lumy))
                (expect "<<VST-12>> the frozen grant is still standing"
                    true (ref-DPTF::UR_AccountRoleTransfer frozen lumy))
            ]
        )
        ;;Revoking one must leave the other alone -- the mirror of the leak check above.
        (ref-TS01-C2::VST|C_ToggleTransferRoleFrozenDPTF patron (ouronet-ns.VST.URC_SpecialTransferRoleKonto frozen) frozen lumy false)
        (map print
            [
                (expect "<<VST-12>> revoking the frozen role removed it"
                    false (ref-DPTF::UR_AccountRoleTransfer frozen lumy))
                (expect "<<VST-12>> ...and left the reserved role untouched"
                    true (ref-DPTF::UR_AccountRoleTransfer reserved lumy))
            ]
        )
    )
    ""
)
(print "===^^^===")
(commit-tx)

