(begin-tx "VST-G6 — UEV_StillHasSleeping: dormancy is read off the CLOCK, not off a flag")
(env-gasmodel "table")(env-gaslimit 100000000)(env-gas 0)
(namespace "ouronet-ns")
(print "--- [VST-G6 · 01 · the dormancy window] ---")
;;UEV_StillHasSleeping sat on the unpinned worklist, and the reason it sat there was wrong. It was
;;filed as needing "a sleeping DPOF nonce that is not dormant", i.e. a fixture. No fixture was
;;needed: by the time this file reaches its end, Z|MOCKA's nonces are ALREADY past their release
;;dates, because the suite's block-time is 2035-01-01 and the releases were written for 2026. The
;;guard had simply never been called from a transaction that ran late enough.
;;
;;    (dt:decimal (diff-time release-date present-time))
;;    (enforce (> dt 0.0) "Nonce {} of Sleeping DPOF {} must be dormant for operation")
;;
;;Read the sign carefully: dt is POSITIVE while the release date is still in the FUTURE, so this
;;enforces "still dormant" and fires once the nonce has matured. The name says the same thing but
;;it is easy to read backwards, which is why both directions are driven below.
;;
;;TIME IS THE FIXTURE. `env-chain-data` moves block-time, so both sides of the window are reachable
;;without touching a single table -- no module admin, nothing to roll back but the clock itself. When
;;a guard compares against `(at "block-time" (chain-data))`, reach for this before reaching for state
;;surgery; it is cheaper and it cannot leak.
;;==== VST-G6 — UEV_StillHasSleeping: dormancy is read off the CLOCK, not off a flag · 01 · let / invocation ==== 
(print "--- [VST-G6 — UEV_StillHasSleeping: dormancy is read off the CLOCK, not off a flag · 01 · let / invocation] ---")
(let
    (
        (z:string "Z|MOCKA-98c486052a51")
        (release:time (at "release-date" (at 0 (DPOF.UR_NonceMetaData "Z|MOCKA-98c486052a51" 1))))
        (now:time (at "block-time" (chain-data)))
    )
    (map print
        [
            ;;the premise, asserted rather than assumed: the suite's clock is already PAST the
            ;;release date. If the fixture dates are ever moved forward, this fails first and names
            ;;the reason, instead of the expect-failure below mysteriously inverting.
            (expect "<<VST-G6>> the suite clock is already past nonce 1's release date"
                true (> (diff-time now release) 0.0))
            ;;...so the guard fires, naming both the nonce and the token
            (expect-failure "<<VST-G6>> a matured nonce is no longer dormant, and is refused"
                "Nonce 1 of Sleeping DPOF Z|MOCKA-98c486052a51 must be dormant for operation"
                (VST.UEV_StillHasSleeping z 1))
        ]
    )
    ;;rewind the clock to before the release date: the SAME nonce now satisfies the same guard.
    ;;This is the half that proves the guard is a window and not a constant rejection.
    (env-chain-data { "block-time" : (time "2026-01-01T00:00:00Z") })
    (map print
        [
            (expect "<<VST-G6>> rewound before the release date, the same nonce IS dormant"
                true (VST.UEV_StillHasSleeping z 1))
            (expect "<<VST-G6>> ...and nothing about the nonce changed -- only the clock did"
                release (at "release-date" (at 0 (DPOF.UR_NonceMetaData z 1))))
        ]
    )
    ;;restore the clock. Every later file sets its own chain-data, but leaving a rewound clock here
    ;;would make this file's own tail behave differently depending on where it is loaded from.
    (env-chain-data { "block-time" : (time "2035-01-01T00:00:00Z") })
    (map print
        [
            (expect "<<VST-G6>> the clock is restored"
                true (> (diff-time (at "block-time" (chain-data)) release) 0.0))
            ;;A NONCE THAT DOES NOT EXIST gets no answer from this guard at all -- the meta-data
            ;;read fails first, with a raw table error naming the composite key. So the guard
            ;;protects against a MATURED nonce, never against a BOGUS one; callers that accept a
            ;;nonce from outside need their own existence check before this.
            (expect-failure "<<VST-G6>> a nonexistent nonce dies in the table read, not in the guard"
                "No value found in table ouronet-ns.DPOF_DPOF|T|Nonces for key: Z|MOCKA-98c486052a51|99"
                (VST.UEV_StillHasSleeping z 99))
        ]
    )
    ""
)
(commit-tx)

;;|| NEXT >
