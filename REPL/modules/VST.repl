(begin-tx "VST-I13 — INFO_VST|Unreserve quote vs measured charge")
(env-gasmodel "table")(env-gaslimit 100000000)(env-gas 0)
(namespace "ouronet-ns")
(print "--- [VST-I13 · 01 · release a reserved position] ---")
;;FUNCTION COVERAGE (G6) — `INFO_VST|Unreserve`, per the owner's spec. Rationale for MEASURING rather
;;than statically checking this family is written out at <<VST-I3>>.
;;
;;RESERVE AND UNRESERVE DISAGREE ABOUT WHO MAY CALL THEM, and it is worth writing down because it is
;;not symmetric and nothing else in this file says so:
;;    VST|C>RESERVE   (11_VST.pact:356) -> (UEV_EnforceAccountType reserver   FALSE)  ;; STANDARD only
;;    VST|C>UNRESERVE (11_VST.pact:370) -> (UEV_EnforceAccountType unreserver TRUE)   ;; SMART only
;;So the account that CAN reserve can never unreserve its own position, and vice versa. That is why
;;<<VST-I12>> above runs as ANHD and this block cannot: the reserved balance has to be handed to a
;;smart account first. `KC.BJ` is the one user-deployed smart account in the boot chain
;;(`[2.1]_Dalos.repl:192`); the eight protocol smart accounts would fail a different guard.
;;
;;UNRESERVE DOES NOT REQUIRE THE UNRESERVER'S SIGNATURE — the cap checks the account TYPE plus
;;`DPTF::CAP_Owner` on the parent token, not ownership of the unreserver. BJ signs here only because
;;`DPTF|C_DeployAccount` (setup) does enforce ownership of its target.
(env-sigs [{ "key": "PK_AncientHodler", "caps": [] } { "key": "PK_BJ", "caps": [] }])
(let
    (
        (ref-TS01-C1:module{TalosStageOne_ClientOneV2} TS01-C1)
        (ref-TS01-C2:module{TalosStageOne_ClientTwoV2} TS01-C2)
        (ref-DPTF:module{DemiourgosPactTrueFungibleV2} DPTF)
        (ref-DALOS:module{OuronetDalosV2} DALOS)
        (r:string "R|OURO-98c486052a51")
        (patron:string KST.ANHD)
        (bj:string KC.BJ)
    )
    ;;SETUP, outside the measurement window — give the smart account a reserved balance to release.
    ;;This is the same three-step hand-off `Stage_01/[6.3]_SWP.repl:2624-2629` performs.
    (ref-TS01-C1::DPTF|C_DeployAccount patron r bj)
    (ref-TS01-C1::DPTF|C_ToggleTransferRole patron (DPTF.UR_Konto r) bj r true)
    (ref-TS01-C1::DPTF|C_Transfer patron patron bj r 20.0 true)
    (let
        (
            (predicted:object{OuronetInfoV2.ClientInfo} (INFO-ONE.INFO_VST|Unreserve patron bj r 10.0))
            (ignis-before:decimal (ref-DALOS::UR_TF_AccountSupply patron false))
            (m (ref-TS01-C2::VST|C_Unreserve patron bj r 10.0))
        )
        (map print
            [
                (expect "<<VST-I13>> INFO_VST|Unreserve's quote equals what the op actually charged"
                    (- ignis-before (ref-DALOS::UR_TF_AccountSupply patron false))
                    (at "ignis-need" (at "ignis" predicted)))
                (expect "<<VST-I13>> ...and it is a real, non-zero charge"
                    true (> (- ignis-before (ref-DALOS::UR_TF_AccountSupply patron false)) 0.0))
                (expect "<<VST-I13>> ...and the smart account really gave up 10.0 of the reserved wrapper"
                    10.0 (ref-DPTF::UR_AccountSupply r bj))
            ]
        )
    )
    ""
)
(env-sigs [])
(rollback-tx)

