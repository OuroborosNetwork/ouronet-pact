    ;;and the whole tx rolled back. Nonce numbers are DERIVED below for the same reason as <<VST-I4>>.
    (ref-TS01-C2::VST|C_Sleep patron patron patron a 10.0 3600)
    (ref-TS01-C2::VST|C_Sleep patron patron patron a 20.0 3600)
    (let
        (
            (predicted:object{OuronetInfoV2.ClientInfo} (INFO-ONE.INFO_VST|Merge patron patron z [(- (ref-DPOF::UR_NoncesUsed z) 1) (ref-DPOF::UR_NoncesUsed z)]))
            (ignis-before:decimal (ref-DALOS::UR_TF_AccountSupply patron false))
