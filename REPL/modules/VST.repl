(begin-tx "VST-08 — SLUMBER is the HIBERNATION merge, not the sleeping one")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(namespace "ouronet-ns")
(print "--- [VST-08 · 01 · repurpose-slumber on the hibernating token] ---")
;;==== VST-08 — SLUMBER is the HIBERNATION merge, not the sleeping one · 01 · env-sigs (caps) ==== 
(print "--- [VST-08 — SLUMBER is the HIBERNATION merge, not the sleeping one · 01 · env-sigs (caps)] ---")
(env-sigs [{ "key": "PK_AncientHodler", "caps": [] }])
;;THE NAMES DO NOT SAY THIS, and getting it backwards costs a confusing crash rather than a
;;clean rejection:
;;   C_Merge   / C_RepurposeMerge   -> vzh-tag 2 = SLEEPING
;;   C_Slumber / C_RepurposeSlumber -> vzh-tag 3 = HIBERNATION
;;Applied to the wrong kind, VST|X>REPURPOSE-ORTO-FUNGIBLE resolves the parent through
;;UR_Hibernation on a sleeping token, gets the "|" sentinel back, and dies inside DPTF::UR_Konto
;;with "No value found in table ... for key: |" -- a table miss that names nothing useful.
;;==== VST-08 — SLUMBER is the HIBERNATION merge, not the sleeping one · 02 · let / invocation ==== 
(print "--- [VST-08 — SLUMBER is the HIBERNATION merge, not the sleeping one · 02 · let / invocation] ---")
(let
    (
        (ref-DPOF:module{DemiourgosPactOrtoFungibleV2} DPOF)
        (ref-TS01-C2:module{TalosStageOne_ClientTwoV2} TS01-C2)
        (a:string "MOCKA-98c486052a51")
        (hib:string "H|MOCKA-98c486052a51")
        (patron:string KST.ANHD)
        (emma:string KST.EMMA)
    )
    ;;two fresh hibernating positions to merge (VST-05 left nonce 1 decommissioned, 2 with emma)
    (ref-TS01-C2::VST|C_Hibernate patron patron patron a 60.0 30)
    (ref-TS01-C2::VST|C_Hibernate patron patron patron a 40.0 30)
    (let ((n:integer (ref-DPOF::UR_NoncesUsed hib)))
        (map print
            [
                (expect "<<VST-08>> two more hibernations exist to merge"
                    [60.0 40.0] [(ref-DPOF::UR_NonceSupply hib (- n 1)) (ref-DPOF::UR_NonceSupply hib n)])
            ]
        )
        (map print
            [
                ;;The role toggle is NOT idempotent: granting a role that is already granted is
                ;;rejected ("must be set to false for exec"). VST-05 already gave EMMA this role,
                ;;so re-granting fails -- which is worth pinning, because a caller that re-asserts
                ;;desired state (a common, reasonable pattern) breaks against this op.
                (expect-failure "<<VST-08>> re-granting an already-granted transfer role is rejected"
                    "must be set to false for exec"
                    (ref-TS01-C2::VST|C_ToggleTransferRoleHibernatingDPOF patron (ouronet-ns.VST.URC_SpecialTransferRoleKonto hib) hib emma true))
            ]
        )
        (ref-TS01-C2::VST|C_RepurposeSlumber patron hib [(- n 1) n] patron emma)
        (map print
            [
                (expect "<<VST-08>> C_RepurposeSlumber decommissioned both source nonces"
                    [-1.0 -1.0] [(ref-DPOF::UR_NonceSupply hib (- n 1)) (ref-DPOF::UR_NonceSupply hib n)])
                (expect "<<VST-08>> C_RepurposeSlumber re-issued ONE nonce to the target"
                    emma (ref-DPOF::UR_NonceHolder hib (+ n 1)))
                (expect "<<VST-08>> INVARIANT: repurpose-merge conserves the summed value"
                    100.0 (ref-DPOF::UR_NonceSupply hib (+ n 1)))
            ]
        )
    )
    ""
)
(commit-tx)

