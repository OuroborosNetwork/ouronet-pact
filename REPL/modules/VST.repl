(begin-tx "VST-I4 — INFO_VST|Hibernate quote vs measured charge")
(env-gasmodel "table")(env-gaslimit 100000000)(env-gas 0)
(namespace "ouronet-ns")
(print "--- [VST-I4 · 01 · hibernate, then awake the same nonce] ---")
;;FUNCTION COVERAGE (G6) — `INFO_VST|Hibernate`, per the owner's spec: an INFO_ must report the same cost
;;the op actually charges. Template: `modules/ATS.repl <<ATS-I1>>`.
;;
;;WHY THIS FAMILY NEEDS MEASURING AND CANNOT BE STATICALLY CHECKED. `VST::URCi_Hibernate` is an AGGREGATE
;;— a sigma over the component legs the operation really bills (mint/burn/transfer cumulators). So
;;the preview deliberately names a cost function the exec never calls, and any static "does the
;;preview quote what the exec quotes" check reports the whole family as drifting. The only question
;;that matters — does the aggregate equal the sum of the legs? — is numeric, and only the scales
;;answer it. That is what this block is.
(env-sigs [{ "key": "PK_AncientHodler", "caps": [] }])
(let
    (
        (ref-TS01-C2:module{TalosStageOne_ClientTwoV2} TS01-C2)
        (ref-DPOF:module{DemiourgosPactOrtoFungibleV2} DPOF)
        (ref-DALOS:module{OuronetDalosV2} DALOS)
        (a:string "MOCKA-98c486052a51")
        (patron:string KST.ANHD)
    )
    (let
        (
            (predicted:object{OuronetInfoV2.ClientInfo} (INFO-ONE.INFO_VST|Hibernate patron patron patron a 10.0 30))
            (ignis-before:decimal (ref-DALOS::UR_TF_AccountSupply patron false))
            (msg-h:string (ref-TS01-C2::VST|C_Hibernate patron patron patron a 10.0 30))
        )
        (map print
            [
                (expect "<<VST-I4>> the preview's IGNIS quote equals what the op charged"
                    (- ignis-before (ref-DALOS::UR_TF_AccountSupply patron false))
                    (at "ignis-need" (at "ignis" predicted)))
                (expect "<<VST-I4>> ...and it is a real, non-zero charge"
                    true (> (- ignis-before (ref-DALOS::UR_TF_AccountSupply patron false)) 0.0))
            ]
        )
    )
    ;;...and now AWAKE the very nonce that mint just produced. Deriving it from UR_NoncesUsed rather
    ;;than hardcoding is not pedantry here: this file mints H| nonces in five earlier blocks, so any
    ;;literal would silently drift onto a different nonce that happens to exist.
    (let
        (
            (h:string "H|MOCKA-98c486052a51")
        )
        (let
            (
                (n:integer (ref-DPOF::UR_NoncesUsed h))
            )
            (let
                (
                    (predicted-a:object{OuronetInfoV2.ClientInfo}
                        (INFO-ONE.INFO_VST|Awake patron patron h n))
                    (ignis-before-a:decimal (ref-DALOS::UR_TF_AccountSupply patron false))
                    (msg-a:string (ref-TS01-C2::VST|C_Awake patron patron h n))
                )
                (map print
                    [
                        (expect "<<VST-I4>> INFO_VST|Awake's quote equals what the awake charged"
                            (- ignis-before-a (ref-DALOS::UR_TF_AccountSupply patron false))
                            (at "ignis-need" (at "ignis" predicted-a)))
                        (expect "<<VST-I4>> ...and it is a real, non-zero charge"
                            true (> (- ignis-before-a (ref-DALOS::UR_TF_AccountSupply patron false)) 0.0))
                        ;;the awake really happened: the nonce is decommissioned (-1.0 sentinel)
                        (expect "<<VST-I4>> ...and the hibernating nonce is retired, so neither quote is for a no-op"
                            -1.0 (ref-DPOF::UR_NonceSupply h n))
                    ]
                )
            )
        )
    )
    ""
)
(env-sigs [])
;;discarded — the harness's balances and nonce ledger are left exactly as found
(rollback-tx)

