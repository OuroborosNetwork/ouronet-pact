(begin-tx "VST-I16 — INFO_VST|Unsleep quote vs measured charge")
(env-gasmodel "table")(env-gaslimit 100000000)(env-gas 0)
(namespace "ouronet-ns")
(print "--- [VST-I16 · 01 · wake a matured sleeping nonce] ---")
;;FUNCTION COVERAGE (G6) — `INFO_VST|Unsleep`, per the owner's spec. Rationale for MEASURING rather than
;;statically checking this family is written out at <<VST-I3>>: the `URCi_` a VST preview quotes is an
;;AGGREGATE over the legs the exec bills, so preview and exec name different functions BY DESIGN and
;;only the scales can say whether they agree.
;;SETUP sleeps first for the same reason <<VST-I10>> vests first — nonce indices at EOF are a
;;consequence of every earlier block, and a decommissioned nonce prices differently from a live one.
;;`3600` seconds against the file's 2035 clock means the new nonce is already matured.
(env-sigs [{ "key": "PK_AncientHodler", "caps": [] } { "key": "PK_Emma", "caps": [] }])
(let*
    (
        (ref-TS01-C2:module{TalosStageOne_ClientTwoV2} TS01-C2)
        (ref-DPOF:module{DemiourgosPactOrtoFungibleV2} DPOF)
        (ref-DPTF:module{DemiourgosPactTrueFungibleV2} DPTF)
        (ref-DALOS:module{OuronetDalosV2} DALOS)
        (a:string "MOCKA-98c486052a51")
        (f:string "F|MOCKA-98c486052a51")
        (z:string "Z|MOCKA-98c486052a51")
        (h:string "H|MOCKA-98c486052a51")
        (o:string "OURO-98c486052a51")
        (v:string "V|OURO-98c486052a51")
        (r:string "R|OURO-98c486052a51")
        (patron:string KST.ANHD)
        (emma:string KST.EMMA)
        (lumy:string KST.LUMY)
        (zn:integer (+ 1 (ref-DPOF::UR_NoncesUsed z)))
    )
    (ref-TS01-C2::VST|C_Sleep patron patron patron a 10.0 3600)
    ;;...and step past the one-hour lock, because C_Unsleep enforces that the WHOLE nonce has matured
    ;;("cannot be unsleeped yet" otherwise). The clock is restored below: `rollback-tx` does not undo
    ;;`env-chain-data`, and everything after this block assumes the file's 2035-01-01 fixture time.
    (env-chain-data { "block-time": (time "2035-01-02T00:00:00Z") })
    (let
        (
            (predicted:object{OuronetInfoV2.ClientInfo} (INFO-ONE.INFO_VST|Unsleep patron patron z zn))
            (ignis-before:decimal (ref-DALOS::UR_TF_AccountSupply patron false))
            (m (ref-TS01-C2::VST|C_Unsleep patron patron z zn))
        )
        (map print
            [
                (expect "<<VST-I16>> INFO_VST|Unsleep's quote equals what the op actually charged"
                    (- ignis-before (ref-DALOS::UR_TF_AccountSupply patron false))
                    (at "ignis-need" (at "ignis" predicted)))
                (expect "<<VST-I16>> ...and it is a real, non-zero charge"
                    true (> (- ignis-before (ref-DALOS::UR_TF_AccountSupply patron false)) 0.0))
            ]
        )
    )
    ""
)
(env-sigs [])
(env-chain-data { "block-time": (time "2035-01-01T00:00:00Z") })
(rollback-tx)

