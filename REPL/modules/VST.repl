(begin-tx "VST-I2 — C_Slumber's FIRST successful execution, and its INFO_ cost preview")
(env-gasmodel "table")(env-gaslimit 100000000)(env-gas 0)
(namespace "ouronet-ns")
(print "--- [VST-I2 · 01 · the op that had never once succeeded] ---")
;;OWNER RULING: "If an op exec counterpart is missing it has to be added, it means we missed it."
;;
;;`VST|C_Slumber` has NEVER executed successfully anywhere in this repo. Its only two live call sites
;;are the `expect-failure`s in <<VST-G10>> just above; every other mention is a comment. So its whole
;;success path — and `INFO_VST|Slumber`'s quote — were unverified until this block.
;;
;;WHY IT WAS NEVER BUILT, which is the interesting part. It is not that the op is hard to call; it is
;;that the ONE historical caller was calling it BY MISTAKE. Before 2026-09-12, VST-07 ran C_Slumber
;;on a SLEEPING token, and it succeeded — minting the un-unsleepable nonce that <<VST-G7>> still
;;pins. The names are the trap:
;;    C_Merge   / C_RepurposeMerge     -> vzh-tag 2 = SLEEPING
;;    C_Slumber / C_RepurposeSlumber   -> vzh-tag 3 = HIBERNATING
;;"Slumber" and "Sleep" are synonyms in English and opposites here. `VST|C>SLUMBER` was then given
;;`(enforce (= (take 2 dpof) "H|") ...)`, the mistaken call was corrected to `C_Merge`, and nobody
;;wrote a correctly-typed caller to replace it. The guard turned a silent misuse into a loud refusal,
;;the refusal got a regression test, and the SUCCESS path was left with none. A fix plus a negative
;;test can look complete while leaving the positive case permanently unexercised.
;;
;;The second reason it stayed unreachable: `XIv_MergeNonces` wipes every nonce in the list from the
;;merger, so the merger must HOLD at least two live H| nonces. Tracing this file, ANHD holds ZERO at
;;this point — every hibernating nonce it ever minted was awakened (VST-11 §03) or repurposed to
;;EMMA (VST-05, VST-08). There has never been a moment in this harness with two ANHD-held H| nonces,
;;so even someone who got the "H|" prefix right would have died inside C_WipeClean.
(env-sigs [{ "key": "PK_AncientHodler", "caps": [] }])
(let
    (
        (ref-TS01-C2:module{TalosStageOne_ClientTwoV2} TS01-C2)
        (ref-DPOF:module{DemiourgosPactOrtoFungibleV2} DPOF)
        (ref-DALOS:module{OuronetDalosV2} DALOS)
        (a:string "MOCKA-98c486052a51")
        (h:string "H|MOCKA-98c486052a51")
        (patron:string KST.ANHD)
    )
    ;;SETUP — mint the two hibernating nonces the merge needs. `dayz 30` against this suite's 2035
    ;;clock means neither matures, so XIv_MergeNonces takes its LOCKED branch: both sources are
    ;;wiped and one replacement nonce is minted carrying the summed value. That is the branch worth
    ;;exercising — the matured branch would also move free balance and need a funded transfer leg.
    (ref-TS01-C2::VST|C_Hibernate patron patron patron a 10.0 30)
    (ref-TS01-C2::VST|C_Hibernate patron patron patron a 20.0 30)
    (let
        (
            ;;DERIVED, never hardcoded: if anything is inserted above, literal nonce numbers rot
            ;;silently into a different nonce that happens to exist.
            (used:integer (ref-DPOF::UR_NoncesUsed h))
        )
        (let
            (
                (pair:[integer] [(- used 1) used])
            )
            (map print
                [
                    (expect "<<VST-I2>> precondition: the merger really holds both nonces"
                        true (and (> (ref-DPOF::UR_NonceSupply h (- used 1)) 0.0)
                                  (> (ref-DPOF::UR_NonceSupply h used) 0.0)))
                ]
            )
            (let
                (
                    ;;FUNCTION COVERAGE (G6) — `INFO_VST|Slumber`, per the owner's spec. The preview
                    ;;reads the very nonces the exec is about to wipe, so it MUST be taken first.
                    (predicted:object{OuronetInfoV2.ClientInfo}
                        (INFO-ONE.INFO_VST|Slumber patron patron h pair))
                    (ignis-before:decimal (ref-DALOS::UR_TF_AccountSupply patron false))
                    (slumber-msg:string (ref-TS01-C2::VST|C_Slumber patron patron h pair))
                )
                (map print
                    [
                        (format "<(VST|C_Slumber)> => \"{}\"" [slumber-msg])
                        ;;1] it actually ran — the two sources are gone and one replacement exists.
                        ;;The consumed nonces read -1.0, not 0.0: this codebase DECOMMISSIONS a spent
                        ;;nonce with a -1.0 sentinel rather than zeroing it, so the row survives and
                        ;;stays distinguishable from a live nonce that merely holds nothing. Asserting
                        ;;-1.0 is the stronger claim — 0.0 would also be true of an emptied-but-live
                        ;;nonce, and would not prove the merge retired them.
                        (expect "<<VST-I2>> C_Slumber DECOMMISSIONED both source nonces (-1.0 sentinel)"
                            [-1.0 -1.0] [(ref-DPOF::UR_NonceSupply h (- used 1))
                                         (ref-DPOF::UR_NonceSupply h used)])
                        (expect "<<VST-I2>> ...and minted exactly ONE replacement nonce"
                            (+ used 1) (ref-DPOF::UR_NoncesUsed h))
                        ;;2] value is conserved: 10.0 + 20.0 arrives whole on the replacement
                        (expect "<<VST-I2>> ...carrying the summed value of both sources"
                            30.0 (ref-DPOF::UR_NonceSupply h (+ used 1)))
                        ;;3] and the quote the client was shown is the price they paid
                        (expect "<<VST-I2>> INFO_VST|Slumber's quote equals what C_Slumber charged"
                            (- ignis-before (ref-DALOS::UR_TF_AccountSupply patron false))
                            (at "ignis-need" (at "ignis" predicted)))
                        (expect "<<VST-I2>> ...and it is a real, non-zero charge"
                            true (> (- ignis-before (ref-DALOS::UR_TF_AccountSupply patron false)) 0.0))
                    ]
                )
            )
        )
    )
    ""
)
(env-sigs [])
;;discarded — this proof leaves the harness's nonce ledger exactly as it found it
(rollback-tx)

