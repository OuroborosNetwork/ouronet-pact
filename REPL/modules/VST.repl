(begin-tx "VST-04 — hibernation: link, hibernate, and the nonce-bearing form")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(namespace "ouronet-ns")
(print "--- [VST-04 · 01 · hibernating link] ---")
;;The hibernating link issues an ORTOFUNGIBLE (unlike the Frozen link, which is a DPTF): a
;;hibernation is time-locked, so each one needs its own nonce carrying its unlock time.
;;==== VST-04 — hibernation: link, hibernate, and the nonce-bearing form · 01 · let / invocation ==== 
(print "--- [VST-04 — hibernation: link, hibernate, and the nonce-bearing form · 01 · let / invocation] ---")
(let
    (
        (ref-DPTF:module{DemiourgosPactTrueFungibleV2} DPTF)
        (ref-DALOS:module{OuronetDalosV2} DALOS)
        (ref-TS01-C2:module{TalosStageOne_ClientTwoV2} TS01-C2)
        (a:string "MOCKA-98c486052a51")
        (patron:string KST.ANHD)
    )
    (let ((split-stoa:[decimal]
              (ref-DALOS::URC_SplitSTOAPrices patron (ref-DALOS::UR_UsagePrice "dpmf"))))
    (env-sigs
        [
            { "key": "PK_AncientHodler", "caps": [] }
            { "key": "6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263" ,
              "caps":
                [
                    (coin.TRANSFER "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263"
                        "k:50d6c59b21e5e6e55baecaa75a1007de37576bde12d8230dc82459cc01b9484b" (at 2 split-stoa))
                    (coin.TRANSFER "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263"
                        "k:0cb30c0121ff919266121a99ff9359871818932211df94dae4137c29bc0e8f7e" (at 0 split-stoa))
                    (coin.TRANSFER "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263"
                        "c:XM-pkmuB5XUQlp87ZYSbfKt8qzmHY6O2EHAzMRVBt3k" (at 3 split-stoa))
                    (coin.TRANSFER "k:6fa1d9c3e5078a54038159c9a6bd7182301e16d6f280615eddb18b8bd2d6c263"
                        "c:iQQFWj6gWtpGEzhM_O5ekW1QtnQQy55R8BRPGhj_0FU" (at 1 split-stoa))
                ]
            }
        ]
    )
    ;;<<VST-I1c>> the THIRD branch of the shared link preview. `URCi_CreateSpecialOrtoFungibleLink`
    ;;takes a <vzh-tag>, and only tags 1 (Vesting) and 2 (Sleeping) pay the transfer-role toggle --
    ;;tag 3 (Hibernating) is transfer-free and resolves that leg to EOC. <<VST-I1>> measures the
    ;;TrueFungible twin and `modules/SWP.repl <<SWP-I9>>` measures tag 2, so without this block the
    ;;EOC branch of the 2026-09-14 fix would be the one shape nothing executes against its charge.
    (let (
            (predicted:object{OuronetInfoV2.ClientInfo} (INFO-ONE.INFO_VST|CreateHibernatingLink patron a))
            (stoa-before:decimal (coin.get-balance (ref-DALOS::UR_AccountStoa patron)))
            (ignis-before:decimal (ref-DALOS::UR_TF_AccountSupply patron false))
            (created:[string] (ref-TS01-C2::VST|C_CreateHibernatingLink patron (ouronet-ns.DPTF.UR_Konto a) a))
         )
        (print (format "<(VST|C_CreateHibernatingLink)> => {}" [created]))
        (print (format "<<VST-I1c>> IGNIS predicted={} real={} | STOA predicted={} real={}"
            [(at "ignis-need" (at "ignis" predicted))
             (- ignis-before (ref-DALOS::UR_TF_AccountSupply patron false))
             (at "stoa-need" (at "stoa" predicted))
             (- stoa-before (coin.get-balance (ref-DALOS::UR_AccountStoa patron)))]))
        (map print
            [
                (expect "<<VST-04>> C_CreateHibernatingLink registered the link"
                    true (ref-DPTF::URC_HasHibernation a))
                (expect "<<VST-04>> the FROZEN link is still present and separate"
                    true (ref-DPTF::URC_HasFrozen a))
                (expect "<<VST-I1c>> the IGNIS quote equals the IGNIS charged on the toggle-FREE branch"
                    (- ignis-before (ref-DALOS::UR_TF_AccountSupply patron false))
                    (at "ignis-need" (at "ignis" predicted)))
                (expect "<<VST-I1c>> the STOA quote equals the STOA charged"
                    (- stoa-before (coin.get-balance (ref-DALOS::UR_AccountStoa patron)))
                    (at "stoa-need" (at "stoa" predicted)))
                ;;non-vacuity, and it also PINS the branch: a hibernating link must cost strictly LESS
                ;;IGNIS than a sleeping one of the same token, because it skips the toggle leg. If the
                ;;`if` on <vzh-tag> ever collapses, this is the assertion that notices.
                (expect "<<VST-I1c>> ...and the toggle-free branch is cheaper than the toggling one"
                    true (< (- ignis-before (ref-DALOS::UR_TF_AccountSupply patron false))
                            (at "ignis-need" (at "ignis" (INFO-ONE.INFO_VST|CreateSleepingLink patron a)))))
            ]
        )
    ))
    ""
)
(commit-tx)

