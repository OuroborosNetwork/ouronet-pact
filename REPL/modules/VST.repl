(begin-tx "VST-G4 -- the ownership claim on every Create*Link, asserted rather than assumed")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(namespace "ouronet-ns")
(print "--- [VST-G4 . 01 . a non-owner is refused on all three link types] ---")
;;FOUND BY `python3 tools/_docclaims.py`, which audits @doc text for RULES no test pins. All three
;;VST|C_Create*Link docs make an AUTHORITY claim about who may create a link:
;;  frozen      -- "Only the <dptf> owner can create Frozen Tokens to Target Accounts"
;;  reservation -- "As opposed to frozen tokens, where only the <dptf> owner can generate them…"
;;  vesting     -- "The <dptf> owner has the ability to vest its <dptf> token…"
;;All three were TRUE and none was tested, so deleting the ownership gate would have broken
;;nothing visible. VST-02 above already covers the POSITIVE half for the frozen link (ANHD, the
;;owner of MOCKA, creates one successfully), which is what stops these three from being satisfied
;;by a function that refuses everybody.
;;
;;EMMA pays the STOA herself here rather than riding ANHD's signature. That is deliberate: the
;;charge is levied BEFORE the ownership check, so a caller with no STOA fails on payment and never
;;reaches the authority error -- which would make this test pass for entirely the wrong reason.
;;Funding her first means the rejection below really is the ownership gate. Note the message: it
;;demands the OWNER's keyset (PK_AncientHodler), not EMMA's -- that is the gate speaking.
;;==== VST-G4 -- the ownership claim on every Create*Link, asserted rather than assumed · 01 · let / invocation ==== 
(print "--- [VST-G4 -- the ownership claim on every Create*Link, asserted rather than assumed · 01 · let / invocation] ---")
(let ((split-stoa:[decimal] (DALOS.URC_SplitSTOAPrices KST.EMMA (DALOS.UR_UsagePrice "dpmf")))
      (ek:string "ecaeae048b6e4b1d4cd9b5ba41041b39e05ac3a7b32f495a12823cb1c5ad0f48"))
  (env-sigs
    [ { "key": "PK_Emma", "caps": [] }
      { "key": ek, "caps":
        [ (coin.TRANSFER (format "k:{}" [ek]) "k:50d6c59b21e5e6e55baecaa75a1007de37576bde12d8230dc82459cc01b9484b" (at 2 split-stoa))
          (coin.TRANSFER (format "k:{}" [ek]) "k:0cb30c0121ff919266121a99ff9359871818932211df94dae4137c29bc0e8f7e" (at 0 split-stoa))
          (coin.TRANSFER (format "k:{}" [ek]) "c:XM-pkmuB5XUQlp87ZYSbfKt8qzmHY6O2EHAzMRVBt3k" (at 3 split-stoa))
          (coin.TRANSFER (format "k:{}" [ek]) "c:iQQFWj6gWtpGEzhM_O5ekW1QtnQQy55R8BRPGhj_0FU" (at 1 split-stoa)) ] } ]))
(map print
    [
        (expect-failure "<<VST-G4>> a NON-owner cannot create a FROZEN link on someone else's DPTF"
            "Keyset failure (keys-all)"
            (TS01-C2.VST|C_CreateFrozenLink KST.EMMA (ouronet-ns.DPTF.UR_Konto "MOCKB-98c486052a51") "MOCKB-98c486052a51"))
    ]
)
(commit-tx)

