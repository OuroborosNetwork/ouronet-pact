(begin-tx "VST-10 — the four RECOVERY repurposes, and the two release ops")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(namespace "ouronet-ns")
(print "--- [VST-10 · 01 · vest and reserve on OURO] ---")
;;These five ops (C_Awake, C_Unsleep, C_RepurposeReserved, C_RepurposeSleeping,
;;C_RepurposeVested) were invoked ONLY by vst-harness.repl -- a file the gate does not run. The
;;ledger counted them as exercised, which is RULE 11 applied to G1: an invocation nothing
;;re-executes is not protection. They move here, into a gated tester, with real assertions.
;;
;;OURO carries vesting/reservation/sleeping/hibernation links from [4.0]_Sovereign-Executor, so
;;this block uses OURO rather than rebuilding four link types on MOCKA.
;;==== VST-10 — the four RECOVERY repurposes, and the two release ops · 01 · env-sigs (caps) ==== =
(print "--- [VST-10 — the four RECOVERY repurposes, and the two release ops · 01 · env-sigs (caps)] ---")
(env-sigs [{ "key": "PK_AncientHodler", "caps": [] }])
;;==== VST-10 — the four RECOVERY repurposes, and the two release ops · 02 · let / invocation ==== 
(print "--- [VST-10 — the four RECOVERY repurposes, and the two release ops · 02 · let / invocation] ---")
(let
    (
        (ref-DALOS:module{OuronetDalosV2} DALOS)
        (ref-DPTF:module{DemiourgosPactTrueFungibleV2} DPTF)
        (ref-DPOF:module{DemiourgosPactOrtoFungibleV2} DPOF)
        (ref-TS01-C1:module{TalosStageOne_ClientOneV2} TS01-C1)
        (ref-TS01-C2:module{TalosStageOne_ClientTwoV2} TS01-C2)
        (patron:string KST.ANHD)
        (emma:string KST.EMMA)
    )
    (let
        (
            (ouro:string (ref-DALOS::UR_OuroborosID))
        )
        (let
            (
                (vested:string (ref-DPTF::UR_Vesting ouro))
                (reserved:string (ref-DPTF::UR_Reservation ouro))
                (bal0:decimal (ref-DPTF::UR_AccountSupply ouro patron))
            )
            ;;VEST to EMMA: 100 OURO over 30 days, one milestone. Vesting mints a NONCE-bearing
            ;;position on the vested DPOF, held by the target -- not a balance on the DPTF.
            (ref-TS01-C2::VST|C_Vest patron patron emma ouro 100.0 0 2592000 1)
            (map print
                [
                    (expect "<<VST-10>> vesting debited the vester's liquid OURO"
                        (- bal0 100.0) (ref-DPTF::UR_AccountSupply ouro patron))
                    (expect "<<VST-10>> the target holds exactly one vested nonce"
                        1 (length (ref-DPOF::URH_AccountNonces emma vested)))
                ]
            )
            ;;RECOVER that vested nonce to the patron. C_RepurposeVested is the account-recovery
            ;;path: the asset owner pulls a vested position out of a third party WITHOUT that
            ;;party signing -- only PK_AncientHodler is in env-sigs.
            (let ((n:integer (at 0 (ref-DPOF::URH_AccountNonces emma vested))))
                (ref-TS01-C2::VST|C_RepurposeVested patron vested n emma patron)
                (map print
                    [
                        (expect "<<VST-10>> C_RepurposeVested emptied the holder's vested nonces"
                            0 (length (ref-DPOF::URH_AccountNonces emma vested)))
                        (expect "<<VST-10>> ...and the recoverer now holds a vested nonce"
                            true (< 0 (length (ref-DPOF::URH_AccountNonces patron vested))))
                    ]
                )
            )
            ;;RESERVE: the reservation must be OPENED on the DPTF first -- the RESERVE capability
            ;;gates on UR_IzReservationOpen, so the toggle is a precondition, not a convenience.
            (map print
                [
                    (expect-failure "<<VST-10>> reserving before the reservation is opened is refused"
                        "Reservation"
                        (ref-TS01-C2::VST|C_Reserve patron emma ouro 10.0))
                ]
            )
            (ref-TS01-C1::DPTF|C_ToggleReservation patron (DPTF.UR_Konto ouro) ouro true)
            (map print
                [
                    (expect "<<VST-10>> C_ToggleReservation opened it"
                        true (ref-DPTF::UR_IzReservationOpen ouro))
                ]
            )
            ;;Reserve on EMMA's behalf, then RECOVER the whole reserved balance to the patron.
            ;;Unlike the nonce forms, C_RepurposeReserved takes no nonce: reserved value is a
            ;;plain balance on the reserved DPTF, so recovery moves ALL of it.
            ;;
            ;;<dptf-to-repurpose> is the token whose balance actually moves, so it must be the
            ;;RESERVED id -- passing the parent OURO id silently repurposes the holder's plain
            ;;OURO instead, leaving the reserve untouched. vst-harness.repl passes the parent id
            ;;and asserts nothing, so it has been doing exactly that unnoticed.
            (ref-TS01-C1::DPTF|C_Transfer patron patron emma ouro 50.0 true)
            ;;The RESERVER is the account whose balance moves, so EMMA must sign this leg --
            ;;C_Reserve enforces her account ownership. The signature is dropped again before
            ;;the recovery below, which is the point of the pair.
            (env-sigs [{ "key": "PK_AncientHodler", "caps": [] } { "key": "PK_Emma", "caps": [] }])
            (ref-TS01-C2::VST|C_Reserve patron emma ouro 50.0)
            (env-sigs [{ "key": "PK_AncientHodler", "caps": [] }])
            (map print
                [
                    (expect "<<VST-10>> C_Reserve moved the balance onto the reserved DPTF"
                        50.0 (ref-DPTF::UR_AccountSupply reserved emma))
                ]
            )
            (let ((p0:decimal (try 0.0 (ref-DPTF::UR_AccountSupply reserved patron))))
                (ref-TS01-C2::VST|C_RepurposeReserved patron reserved emma patron)
                (map print
                    [
                        (expect "<<VST-10>> C_RepurposeReserved took the WHOLE reserved balance"
                            0.0 (ref-DPTF::UR_AccountSupply reserved emma))
                        (expect "<<VST-10>> ...and credited the recoverer with all of it"
                            (+ p0 50.0) (ref-DPTF::UR_AccountSupply reserved patron))
                    ]
                )
            )
        )
    )
    ""
)
(print "===^^^===")
(commit-tx)

;;|| NEXT >
