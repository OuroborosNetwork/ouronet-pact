(begin-tx "VST-G1 — VST|X>REPURPOSE-ORTO-FUNGIBLE: the vesting/sleeping/hibernation tag")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(namespace "ouronet-ns")
(print "--- [VST-G1 · 01 · vzh tag domain] ---")
;;VST's repurpose caps dispatch on a tag — 1 vesting, 2 sleeping, 3 hibernation — and a tag
;;outside that set would fall through the cond to BAR and repurpose the wrong special token.
;;
;;This is a defcap, so the route in looks like a full Talos repurpose. It is not: `test-capability`
;;acquires a capability directly and runs its body, and this enforce is the cap's FIRST line,
;;above every read. Dummy ids reach it.
;;
;;NOTE ON ATTRIBUTION: DPOF|C>UPDATE-SPECIAL carries the IDENTICAL message, so this test is
;;written as a module-qualified call — (VST.VST|X>REPURPOSE-ORTO-FUNGIBLE …) — which is what lets
;;the coverage tool credit VST rather than crediting both modules from one assertion.
;;==== VST-G1 — VST|X>REPURPOSE-ORTO-FUNGIBLE: the vesting/sleeping/hibernation tag · 01 · env-sigs (caps) ==== 
(print "--- [VST-G1 — VST|X>REPURPOSE-ORTO-FUNGIBLE: the vesting/sleeping/hibernation tag · 01 · env-sigs (caps)] ---")
(env-sigs [{ "key": "PK_Emma", "caps": [] }])
(map print
    [
        (expect-failure "<<VST-G1>> a tag above the 1..3 domain is refused"
            "Invalid Vesting|Sleeping|Hibernation Tag"
            (test-capability (VST.VST|X>REPURPOSE-ORTO-FUNGIBLE "a" "b" "c" 9)))
        (expect-failure "<<VST-G1>> ...and zero, one below it"
            "Invalid Vesting|Sleeping|Hibernation Tag"
            (test-capability (VST.VST|X>REPURPOSE-ORTO-FUNGIBLE "a" "b" "c" 0)))
    ]
)
(commit-tx)

