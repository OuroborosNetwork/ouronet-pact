(begin-tx "VST-11 — C_RepurposeSleeping, then the two MATURITY releases")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(namespace "ouronet-ns")
(print "--- [VST-11 · 01 · sleep to a third party, recover it] ---")
;;MOCKA, not OURO: OURO carries vesting and reservation links from [4.0]_Sovereign-Executor but
;;NOT a sleeping one, and C_Sleep's capability enforces the link exists. VST-06 created MOCKA's.
;;==== VST-11 — C_RepurposeSleeping, then the two MATURITY releases · 01 · env-sigs (caps) ==== ===
(print "--- [VST-11 — C_RepurposeSleeping, then the two MATURITY releases · 01 · env-sigs (caps)] ---")
(env-sigs [{ "key": "PK_AncientHodler", "caps": [] }])
;;==== VST-11 — C_RepurposeSleeping, then the two MATURITY releases · 02 · let / invocation ==== ==
(print "--- [VST-11 — C_RepurposeSleeping, then the two MATURITY releases · 02 · let / invocation] ---")
(let
    (
        (ref-DALOS:module{OuronetDalosV2} DALOS)
        (ref-DPTF:module{DemiourgosPactTrueFungibleV2} DPTF)
        (ref-DPOF:module{DemiourgosPactOrtoFungibleV2} DPOF)
        (ref-TS01-C2:module{TalosStageOne_ClientTwoV2} TS01-C2)
        (patron:string KST.ANHD)
        (emma:string KST.EMMA)
    )
    (let ((ouro:string "MOCKA-98c486052a51"))
        (let ((sleeping:string (ref-DPTF::UR_Sleeping ouro)))
            (ref-TS01-C2::VST|C_Sleep patron patron emma ouro 100.0 2592000)
            ;;Also open a HIBERNATING position for the patron here, BEFORE the time jump in
            ;;VST-11 * 02 -- C_Awake needs one that has MATURED, and VST-08 repurposed every
            ;;pre-existing hibernating nonce away to EMMA.
            (ref-TS01-C2::VST|C_Hibernate patron patron patron ouro 60.0 30)
            (map print
                [
                    (expect "<<VST-11>> the sleep created a nonce held by the target"
                        true (< 0 (length (ref-DPOF::URH_AccountNonces emma sleeping))))
                    (expect "<<VST-11>> the hibernate created one held by the patron"
                        true (< 0 (length (ref-DPOF::URH_AccountNonces patron
                                            (ref-DPTF::UR_Hibernation ouro)))))
                ]
            )
            (let
                (
                    (n:integer (at 0 (ref-DPOF::URH_AccountNonces emma sleeping)))
                    (p0:integer (length (ref-DPOF::URH_AccountNonces patron sleeping)))
                )
                (ref-TS01-C2::VST|C_RepurposeSleeping patron sleeping n emma patron)
                (map print
                    [
                        (expect "<<VST-11>> C_RepurposeSleeping emptied the holder"
                            0 (length (ref-DPOF::URH_AccountNonces emma sleeping)))
                        ;;Recovery is DECOMMISSION + RE-ISSUE, not a transfer -- the same shape
                        ;;VST-05 found for C_RepurposeHibernating. The source nonce is consumed
                        ;;and a NEW one is minted, so the recoverer does NOT receive nonce <n>.
                        (expect "<<VST-11>> the source nonce is decommissioned, not moved"
                            -1.0 (ref-DPOF::UR_NonceSupply sleeping n))
                        (expect "<<VST-11>> the recoverer gains a nonce -- a NEW one"
                            (+ p0 1) (length (ref-DPOF::URH_AccountNonces patron sleeping)))
                        (expect "<<VST-11>> ...and it is not the one that was taken"
                            false (contains n (ref-DPOF::URH_AccountNonces patron sleeping)))
                    ]
                )
            )
        )
    )
    ""
)
(print "--- [VST-11 · 02 · MATURITY: C_Unsleep and C_Awake] ---")
;;Both release ops require the lock to have EXPIRED, so this is the last transaction in the file:
;;advancing block-time is destructive to anything asserted before it. C_Unsleep releases a
;;SLEEPING nonce; C_Awake releases a HIBERNATING one -- the same naming split that makes
;;C_Merge/C_Slumber easy to swap (see VST-08/VST-09).
(env-chain-data { "block-time": (time "2035-01-01T00:00:00Z") })
(let
    (
        (ref-DALOS:module{OuronetDalosV2} DALOS)
        (ref-DPTF:module{DemiourgosPactTrueFungibleV2} DPTF)
        (ref-DPOF:module{DemiourgosPactOrtoFungibleV2} DPOF)
        (ref-TS01-C2:module{TalosStageOne_ClientTwoV2} TS01-C2)
        (patron:string KST.ANHD)
    )
    (let ((ouro:string "MOCKA-98c486052a51"))
        (let
            (
                (sleeping:string (ref-DPTF::UR_Sleeping ouro))
                (bal0:decimal (ref-DPTF::UR_AccountSupply ouro patron))
            )
            ;;Take the LAST nonce the patron holds: the recovery above minted it, and it is
            ;;well-formed. `at 0` would pick nonce 3 -- the malformed one VST-09 documented --
            ;;which cannot be unslept at all (proven immediately below).
            (let ((n:integer (at (- (length (ref-DPOF::URH_AccountNonces patron sleeping)) 1)
                                 (ref-DPOF::URH_AccountNonces patron sleeping))))
                (let ((amt:decimal (ref-DPOF::UR_NonceSupply sleeping n)))
                    (ref-TS01-C2::VST|C_Unsleep patron patron sleeping n)
                    (map print
                        [
                            ;;Release is not a transfer between accounts: the locked position is
                            ;;destroyed and the underlying DPTF comes back as liquid balance.
                            (expect "<<VST-11>> C_Unsleep returned the slept amount as liquid DPTF"
                                (+ bal0 amt) (ref-DPTF::UR_AccountSupply ouro patron))
                            (expect "<<VST-11>> the sleeping nonce is decommissioned"
                                -1.0 (ref-DPOF::UR_NonceSupply sleeping n))
                        ]
                    )
                )
            )
        )
    )
    ""
)
(print "--- [VST-11 · 03 · C_Awake releases the HIBERNATING twin] ---")
;;C_Unsleep and C_Awake are the two release ops and they are NOT interchangeable: C_Unsleep takes
;;a nonce on the SLEEPING link, C_Awake one on the HIBERNATING link. Same split that makes
;;C_Merge/C_Slumber easy to swap. Block-time is already past both locks.
(let
    (
        (ref-DPTF:module{DemiourgosPactTrueFungibleV2} DPTF)
        (ref-DPOF:module{DemiourgosPactOrtoFungibleV2} DPOF)
        (ref-TS01-C2:module{TalosStageOne_ClientTwoV2} TS01-C2)
        (patron:string KST.ANHD)
        (a:string "MOCKA-98c486052a51")
        (hib:string "H|MOCKA-98c486052a51")
    )
    (let
        (
            (held:[integer] (ref-DPOF::URH_AccountNonces patron hib))
            (bal0:decimal (ref-DPTF::UR_AccountSupply a patron))
        )
        (map print
            [
                (expect "<<VST-11>> precondition: the patron holds a hibernating nonce"
                    true (< 0 (length held)))
            ]
        )
        (let ((n:integer (at 0 held)))
            (let ((amt:decimal (ref-DPOF::UR_NonceSupply hib n)))
                (ref-TS01-C2::VST|C_Awake patron patron hib n)
                (map print
                    [
                        (expect "<<VST-11>> C_Awake returned the hibernated amount as liquid DPTF"
                            (+ bal0 amt) (ref-DPTF::UR_AccountSupply a patron))
                        (expect "<<VST-11>> the hibernating nonce is decommissioned"
                            -1.0 (ref-DPOF::UR_NonceSupply hib n))
                    ]
                )
            )
        )
    )
    ""
)
(print "--- [VST-11 · 04 · FINDING: the malformed nonce is PERMANENTLY LOCKED] ---")
;;VST-09 showed C_Slumber (the HIBERNATION merge) succeeds on a SLEEPING dpof and mints the wrong
;;METADATA SHAPE. This is what that costs. Nonce 3 carries {mint-time, release-date} where
;;VST|MetaDataSchema wants {release-amount, release-date}, so C_Unsleep USED TO die in
;;URC_CullMetaDataAmountWithObject on a RUNTIME TYPECHECK -- not a guard, not a named rejection.
;;
;;THE STAKES, recorded because they are what justified the fix: the nonce is fully matured
;;(block-time is 2035) and holds 200.0 of real value, and C_Unsleep is the ONLY release path for a
;;sleeping position. So the value was locked FOREVER, and the operation that locked it had reported
;;success. That escalated VST-09 from "writes a malformed record" to "silently and irreversibly
;;destroys access to the underlying tokens".
;;
;;FIXED 2026-09-12 (see VST-G7 section 03 for the full diagnosis, including the first WRONG one).
;;Root cause was not the metadata writer but the two merge capabilities, neither of which checked
;;what KIND of DPOF it was handed -- so the shape was chosen by which client the caller picked
;;rather than by what the token is. VST|C>MERGE now requires Z|, VST|C>SLUMBER requires H|, and the
;;callers use C_Merge for sleeping nonces. The assertion below is now the RELEASE succeeding.
(let
    (
        (ref-DPOF:module{DemiourgosPactOrtoFungibleV2} DPOF)
        (ref-TS01-C2:module{TalosStageOne_ClientTwoV2} TS01-C2)
        (patron:string KST.ANHD)
        (slp:string "Z|MOCKA-98c486052a51")
    )
    (map print
        [
            (expect "<<VST-11>> the malformed nonce still holds its full value"
                200.0 (ref-DPOF::UR_NonceSupply slp 3))
            ;;FIXED 2026-09-12: the merged nonce is well-formed and MATURE here (block-time is 2035),
            ;;so the release succeeds and returns the underlying. This assertion is the one that
            ;;measures the defect's real cost -- 200.0 of value that used to be unreachable.
            (expect "<<VST-11>> FIXED: it releases, returning the underlying to the holder"
                true (!= "" (format "{}" [(ref-TS01-C2::VST|C_Unsleep patron patron slp 3)])))
            ;;FIXED 2026-09-12: the release now SUCCEEDS, so the nonce is decommissioned (-1.0)
            ;;rather than left stranded at its full 200.0. This is the assertion that shows the
            ;;defect's real cost was a stuck holding, and that the fix returns it.
            (expect "<<VST-11>> ...and the nonce is decommissioned by the successful release"
                -1.0 (ref-DPOF::UR_NonceSupply slp 3))
        ]
    )
    ""
)
(print "===^^^===")
(commit-tx)

