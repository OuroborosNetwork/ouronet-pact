;;================================================================================
(print "")
(print "================================================================")
(print "FILE  REPL/modules/S1-UNCLAIMED.repl")
(print "================================================================")
(print "WHAT THIS PINS, AND WHY IT COULD NOT PASS BEFORE S1.")
(print "")
(print "`unclaimed-count` is DOCUMENTED as the users with unclaimed rewards and was MAINTAINED")
(print "as the accounts that can ever claim: it fell ONLY at an unstake, never when a")
(print "still-staked account collected to zero. So on a live aggregator it never reached 1, the")
(print "last-claimant dust sweep was unreachable, and the floor dust accrued. Measured against")
(print "mainnet 2026-11-08: the count exceeded the positive-claimable leg count on ALL ELEVEN")
(print "live lanes -- SubsidiaryTreasury/AURYN read 69 against 27 -- and THREE lanes held a")
(print "balance with ZERO collectable legs, reachable by no collect and no evict.")
(print "")
(print "THE PROOF IS A DESCENT TO ZERO. Two stakers on one lane, one injection, then both")
(print "collect: the count must read 2, then 1, and the SECOND collector must take the whole")
(print "remainder so the lane ends at EXACTLY 0.0. Every one of those four facts is false")
(print "against the old maintenance rule.")
(print "")
(load "../Stage00_Sanboxes.repl")
(load "../Stage01_Tester.repl")
(load "../deploy-stage02.repl")
(load "../Stage_02/[5.2]_PopulateBloodshed.repl")
(load "../Stage_02/[5.1]_PopulateNosferatu.repl")
(load "../Stage_02/[5.4]_PopulateBunnies.repl")
(load "../Stage_02/[6.2.1]_AQP-ANK.repl")
(load "../Stage_02/[6.2.2]_AQP-SCORE.repl")
(load "../Stage_02/[6.2.3]_AQP-POOL.repl")
(load "../Stage_02/[6.2.9]_AQP-BOOT-FULL.repl")
(load "../Stage_02/[6.4]_AQP-EXHAUSTIVE-PREP.repl")
(load "../Stage_02/[6.4]_AQP-EXHAUSTIVE-BOOT-POOLS.repl")
;;RPS STAKES A SECOND BENEFICIARY (LUMY) INTO DHCompany, which is what gives
;;CompanySharesTreasury two legs on one lane -- the shape the bulked path exists for. Without
;;it every boot FVT carries exactly one staker and this file would silently test the
;;single-leg path instead.
(load "../Stage_02/[6.4]_AQP-EXHAUSTIVE-RPS.repl")

(print "")
(print "===================S1 UNCLAIMED-COUNT Block=====================")
(print "")
;;================================================================================
(begin-tx "TX-S1-01 - the count descends to 1 and the last collector sweeps the lane to zero")
(print "")
(print "=== TX-S1-01 — descent to zero ======================================================")
(namespace "ouronet-ns")
(env-gasmodel "table")(env-gaslimit 900000000)(env-gas 0)
;;==== TX-S1-01 · 01 · env-sigs (caps) ====
(print "--- [TX-S1-01 · 01 · env-sigs (caps)] ---")
(env-sigs [ { "key": "PK_AncientHodler", "caps": [] } { "key": "PK_Lumy", "caps": [] } ])
(let*
    (
        (ref-U|DALOS:module{UtilityDalosV2} U|DALOS)
        (ref-DALOS:module{OuronetDalosV3} DALOS)
        (ref-TS02-C3:module{TalosStageTwo_ClientThreeV8} TS02-C3)
        (ref-FVT:module{AcquisitionFarmsVaultsTreasuriesV7} AQP-FVT)
        (ref-RPS:module{AcquisitionRewardPerShareV8} RPS)
        (ref-AQP:module{AcquisitionPoolsV3} AQP-POOL)
        ;;
        (patron:string KST.ANHD)
        (fvt-id:string (ref-U|DALOS::UDC_Makeid "CompanySharesTreasury"))
        (lane:string (ref-DALOS::UR_OuroborosID))
        (score-id:string (ref-U|DALOS::UDC_Makeid "DemiourgosShareholder"))
        (users:[string] (ref-RPS::URH_FvtPresentUsers fvt-id))
        (inject-amt:decimal 7.000000000000000000000003)
    )
    ;;==== TX-S1-01 · 02 · fixture — TWO earning legs on ONE lane ====
    (print "--- [TX-S1-01 · 02 · fixture — TWO earning legs on ONE lane] ---")
    ;;TWO LEGS IS THE MINIMUM THAT CAN DISCRIMINATE. With one leg the count is 1 from the first
    ;;accrual and the sweep fires on the only possible collect, so a broken counter passes.
    (map print
        [
            (expect "<<TX-S1-01>> fixture: two earning legs, two present users, one lane"
                [2 2]
                [(ref-FVT::UR_FVT|EarningLegCount fvt-id) (length users)])
        ]
    )
    ;;==== TX-S1-01 · 03 · inject — the RESTORE fires (T1) ====
    (print "--- [TX-S1-01 · 03 · inject — the RESTORE fires (T1)] ---")
    ;;AN AMOUNT THAT CANNOT SPLIT EVENLY, deliberately: 7.000000000000000000000003 over two legs
    ;;leaves a sub-unit remainder at 24 decimals, which is exactly the dust the sweep exists for.
    ;;An amount that halves exactly would end at 0.0 whether or not the sweep fired.
    (ref-TS02-C3::AQP-FVT|CC_Inject patron patron fvt-id lane inject-amt)
    (map print
        [
            (format "<(available-rewards after inject)> => {}" [(ref-FVT::UR_FVT-RG|AvailableRewards fvt-id lane)])
            ;;THE ASSERTION THAT FAILS WITHOUT THE PHASE-4.1 RESTORE. Before S1 that slot was a
            ;;COMMENT -- "Do not reset unclaimed-count" -- inherited from the canonical `coin` vault
            ;;without the reason it was removed there, so nothing ever raised the count at accrual.
            (expect (format "<<TX-S1-01>> inject RESTORES the count to earning + dormant got={}" [(ref-FVT::UR_FVT-RG|UnclaimedCount fvt-id lane)])
                2 (ref-FVT::UR_FVT-RG|UnclaimedCount fvt-id lane))
            (expect "<<TX-S1-01>> ...and nothing is dormant yet — nobody has exited owed"
                0 (ref-FVT::UR_FVT-RG|DormantClaimCount fvt-id lane))
        ]
    )
    ;;==== TX-S1-01 · 04 · first collect — the count DESCENDS (T3) ====
    (print "--- [TX-S1-01 · 04 · first collect — the count DESCENDS (T3)] ---")
    ;;THIS IS THE RULE THAT DID NOT EXIST. The old condition was `deb == 0 AND pending > 0` -- only
    ;;an account that had already UNSTAKED was ever retired -- so a still-staked collector left the
    ;;count untouched and `= 1` was unreachable.
    (let*
        (
            (u1:string (at 0 users))
            (u2:string (at 1 users))
            (pre-1:decimal (DPTF.UR_AccountSupply lane u1))
        )
        (ref-TS02-C3::AQP-FVT|CC_Collect u1 u1 fvt-id 1 score-id lane)
        (map print
            [
                (expect (format "<<TX-S1-01>> a STAKED collector is retired — count 2 -> 1 got={}" [(ref-FVT::UR_FVT-RG|UnclaimedCount fvt-id lane)])
                    1 (ref-FVT::UR_FVT-RG|UnclaimedCount fvt-id lane))
                (expect (format "<<TX-S1-01>> ...and the lane still holds a remainder got={}" [(ref-FVT::UR_FVT-RG|AvailableRewards fvt-id lane)])
                    true (> (ref-FVT::UR_FVT-RG|AvailableRewards fvt-id lane) 0.0))
                (expect (format "<<TX-S1-01>> the first collector was PAID got={}" [(- (DPTF.UR_AccountSupply lane u1) pre-1)])
                    true (> (DPTF.UR_AccountSupply lane u1) pre-1))
            ]
        )
        ;;==== TX-S1-01 · 05 · second collect — the SWEEP fires, lane ends at EXACTLY 0.0 ====
        (print "--- [TX-S1-01 · 05 · second collect — the SWEEP fires] ---")
        ;;THE WHOLE POINT. With the count at 1 the last claimant takes the lane's entire
        ;;available-rewards, remainder included, so no dust is left behind. Before S1 the count
        ;;could not reach 1 on a live aggregator, so this branch was dead code in production --
        ;;which is why three mainnet lanes were measured holding a balance no transaction could
        ;;reach.
        (let
            (
                (lane-pre:decimal (ref-FVT::UR_FVT-RG|AvailableRewards fvt-id lane))
                (pre-2:decimal (DPTF.UR_AccountSupply lane u2))
            )
            (ref-TS02-C3::AQP-FVT|CC_Collect u2 u2 fvt-id 1 score-id lane)
            (map print
                [
                    (format "<(lane before/after)> => {} / {}" [lane-pre (ref-FVT::UR_FVT-RG|AvailableRewards fvt-id lane)])
                    (expect (format "<<TX-S1-01>> the LAST claimant sweeps — the lane ends at EXACTLY 0.0 got={}" [(ref-FVT::UR_FVT-RG|AvailableRewards fvt-id lane)])
                        0.0 (ref-FVT::UR_FVT-RG|AvailableRewards fvt-id lane))
                    ;;CONSERVATION, which a sweep that over-paid could not satisfy: the last
                    ;;collector received exactly what the lane held, not a floored share of it.
                    (expect (format "<<TX-S1-01>> ...and received exactly the lane's remainder got={}" [(- (DPTF.UR_AccountSupply lane u2) pre-2)])
                        lane-pre (- (DPTF.UR_AccountSupply lane u2) pre-2))
                    (expect (format "<<TX-S1-01>> the count is now 0 — no leg is owed anything got={}" [(ref-FVT::UR_FVT-RG|UnclaimedCount fvt-id lane)])
                        0 (ref-FVT::UR_FVT-RG|UnclaimedCount fvt-id lane))
                    ;;AND THE EARNING COUNT IS UNTOUCHED: both accounts are still staked, so the
                    ;;next injection restores the count to 2 and the cycle repeats. A fix that
                    ;;retired them from EARNING too would silently stop paying them.
                    (expect (format "<<TX-S1-01>> both legs are still EARNING — the next accrual will count them again got={}" [(ref-FVT::UR_FVT|EarningLegCount fvt-id)])
                        2 (ref-FVT::UR_FVT|EarningLegCount fvt-id))
                ]
            )
        )
    )
    (env-sigs [])
    ""
)
(print "===^^^===")
(commit-tx)
