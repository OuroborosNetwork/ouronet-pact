;;================================================================================
(begin-tx "TX-S1-03 - a DORMANT last claimant sweeps, which the old guard refused")
(print "")
(print "=== TX-S1-03 — the guard re-derivation, where it actually bites ======================")
(namespace "ouronet-ns")
(env-gasmodel "table")(env-gaslimit 900000000)(env-gas 0)
;;THIS TEST EXISTS BECAUSE A MUTATION ROUND SHOWED <<TX-S1-01>> DOES NOT COVER THE SWEEP GUARD.
;;Reverting the guard from `own > 0` back to `deb-user > 0` left that suite GREEN: its last
;;claimant is still STAKED, so both predicates admit it and the change is invisible.
;;
;;THE GUARD ONLY BITES ON A **DORMANT** LAST CLAIMANT -- an account that fully unstaked while still
;;owed. `deb-user > 0` refuses it, because it has no stake; `own > 0` admits it, because it IS owed.
;;Under the old guard the lane's remainder is stranded in exactly the wind-down the sweep exists
;;for: nobody left can take it.
;;
;;AND IT STILL REFUSES THE EMMA CASE. The old guard was introduced after a measured theft -- an
;;exited account with NOTHING owed collected a sweep that belonged to the sole real claimant. That
;;account's `own` is 0, so it is refused here too. The re-derivation is STRICTER where the incident
;;needed it ("is owed something") and looser only where the old one was wrong ("has stake").
;;Pinned from the other side by [6.4]_AQP-TRIPLET-COLLECT <<TX-AQP-CL04>>.
;;
;;T5 IS ALSO ONLY COVERED HERE: this is the one place a leg moves from EARNING to DORMANT.
(env-sigs [ { "key": "PK_AncientHodler", "caps": [] } { "key": "PK_Lumy", "caps": [] } ])
(let*
    (
        (ref-U|DALOS:module{UtilityDalosV2} U|DALOS)
        (ref-DALOS:module{OuronetDalosV3} DALOS)
        (ref-TS02-C3:module{TalosStageTwo_ClientThreeV8} TS02-C3)
        (ref-FVT:module{AcquisitionFarmsVaultsTreasuriesV7} AQP-FVT)
        (ref-RPS:module{AcquisitionRewardPerShareV8} RPS)
        ;;
        (patron:string KST.ANHD)
        (fvt-id:string (ref-U|DALOS::UDC_Makeid "CompanySharesTreasury"))
        (pool-id:string (ref-U|DALOS::UDC_Makeid "DHCompany"))
        (lane:string (ref-DALOS::UR_OuroborosID))
        (score-id:string (ref-U|DALOS::UDC_Makeid "DemiourgosShareholder"))
        ;;DHCompany's canonical asset is the EQUITY collection, not DHCD -- probed, not assumed:
        ;;`UR_AQP|PoolAssetId` returns `E|DH-...`, and `UEV_` refuses a leg that does not match it.
        (dhcd-id:string "E|DH-98c486052a51")
        (users:[string] (ref-RPS::URH_FvtPresentUsers fvt-id))
    )
    (let
        (
            (u1:string (at 0 users))
            (u2:string (at 1 users))
        )
        ;;==== TX-S1-03 · 01 · inject, then u2 fully UNSTAKES while owed (T5) ====
        (print "--- [TX-S1-03 · 01 · inject, then u1 fully UNSTAKES while owed (T5)] ---")
        (ref-TS02-C3::AQP-FVT|CC_Inject patron patron fvt-id lane 5.000000000000000000000001)
        (map print
            [
                (expect (format "<<TX-S1-03>> both legs are claimable after the inject got={}" [(ref-FVT::UR_FVT-RG|UnclaimedCount fvt-id lane)])
                    2 (ref-FVT::UR_FVT-RG|UnclaimedCount fvt-id lane))
            ]
        )
        ;;u1 exits completely. It is still OWED -- its pending was banked by the unstake -- so T5
        ;;must move it from EARNING to DORMANT rather than retire it. Retiring it here would make
        ;;the count read LOW and the next collect would sweep while u1 is owed.
        ;;
        ;;u1 AND NOT u2, DISCOVERED NOT ASSUMED: `URH_AQP|ActiveDpsfTrackerRows` on this pool holds
        ;;exactly one row -- nonce 6, balance 5.0, owned by u1. u2's leg sits on a DIFFERENT member
        ;;of the same FVT, which is what lets it collect independently below. The nonce and amount
        ;;are read from the tracker rather than hardcoded, so the fixture cannot drift out from
        ;;under this test.
        (ref-TS02-C3::AQP-POOL|CC_UnstakeSemiFungibleCollectable patron u1 u1 pool-id dhcd-id [6]
            [(round (AQP-POOL.UR_AQP|DPSFTrackerBalance pool-id dhcd-id u1 u1 6))])
        (map print
            [
                (expect (format "<<TX-S1-03>> T5: the exiting leg stops EARNING got={}" [(ref-FVT::UR_FVT|EarningLegCount fvt-id)])
                    1 (ref-FVT::UR_FVT|EarningLegCount fvt-id))
                (expect (format "<<TX-S1-03>> T5: ...and becomes DORMANT, not retired got={}" [(ref-FVT::UR_FVT-RG|DormantClaimCount fvt-id lane)])
                    1 (ref-FVT::UR_FVT-RG|DormantClaimCount fvt-id lane))
                (expect (format "<<TX-S1-03>> T5: so it is STILL counted as claimable got={}" [(ref-FVT::UR_FVT-RG|UnclaimedCount fvt-id lane)])
                    2 (ref-FVT::UR_FVT-RG|UnclaimedCount fvt-id lane))
                (expect (format "<<TX-S1-03>> ...and it really is owed something got={}" [(ref-FVT::URC_CollectClaimableRewards u1 pool-id fvt-id 1 score-id lane)])
                    true (> (ref-FVT::URC_CollectClaimableRewards u1 pool-id fvt-id 1 score-id lane) 0.0))
                (expect (format "<<TX-S1-03>> ...while holding NO stake — which is what the old guard refused got={}" [(ref-FVT::URC_ScoreEntityUserWeight u1 fvt-id pool-id 1 score-id)])
                    0.0 (ref-FVT::URC_ScoreEntityUserWeight u1 fvt-id pool-id 1 score-id))
            ]
        )
        ;;==== TX-S1-03 · 02 · the staked leg collects — count 2 -> 1 ====
        (print "--- [TX-S1-03 · 02 · the staked leg collects — count 2 -> 1] ---")
        (ref-TS02-C3::AQP-FVT|CC_Collect u2 u2 fvt-id 1 score-id lane)
        (map print
            [
                (expect (format "<<TX-S1-03>> the staked leg is retired — count 2 -> 1 got={}" [(ref-FVT::UR_FVT-RG|UnclaimedCount fvt-id lane)])
                    1 (ref-FVT::UR_FVT-RG|UnclaimedCount fvt-id lane))
                (expect (format "<<TX-S1-03>> the lane still holds a remainder got={}" [(ref-FVT::UR_FVT-RG|AvailableRewards fvt-id lane)])
                    true (> (ref-FVT::UR_FVT-RG|AvailableRewards fvt-id lane) 0.0))
            ]
        )
        ;;==== TX-S1-03 · 03 · the DORMANT leg sweeps — the assertion the old guard fails ====
        (print "--- [TX-S1-03 · 03 · the DORMANT leg sweeps] ---")
        ;;WITH `deb-user > 0` THIS LANE STAYS DIRTY. u2 has no stake, so the old guard refuses it
        ;;the sweep, it is paid only its floored share, and the remainder is stranded with nobody
        ;;left to claim it. With `own > 0` it is paid the whole remainder and the lane closes.
        (let
            (
                (lane-pre:decimal (ref-FVT::UR_FVT-RG|AvailableRewards fvt-id lane))
            )
            (ref-TS02-C3::AQP-FVT|CC_Collect u1 u1 fvt-id 1 score-id lane)
            (map print
                [
                    (format "<(lane before/after the dormant collect)> => {} / {}"
                        [lane-pre (ref-FVT::UR_FVT-RG|AvailableRewards fvt-id lane)])
                    (expect (format "<<TX-S1-03>> a DORMANT last claimant SWEEPS — lane ends at EXACTLY 0.0 got={}" [(ref-FVT::UR_FVT-RG|AvailableRewards fvt-id lane)])
                        0.0 (ref-FVT::UR_FVT-RG|AvailableRewards fvt-id lane))
                    ;;T4: a dormant leg leaves BOTH counters, or the restore would count it forever
                    ;;and stall every future sweep on this lane.
                    (expect (format "<<TX-S1-03>> T4: it leaves the dormant set too got={}" [(ref-FVT::UR_FVT-RG|DormantClaimCount fvt-id lane)])
                        0 (ref-FVT::UR_FVT-RG|DormantClaimCount fvt-id lane))
                    (expect (format "<<TX-S1-03>> ...and the claimant count is 0 got={}" [(ref-FVT::UR_FVT-RG|UnclaimedCount fvt-id lane)])
                        0 (ref-FVT::UR_FVT-RG|UnclaimedCount fvt-id lane))
                ]
            )
        )
    )
    (env-sigs [])
    ""
)
(print "===^^^===")
(commit-tx)

