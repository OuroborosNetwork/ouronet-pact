(begin-tx)
;;==== TX-S1-COL · 01 · absent-column semantics, measured ====
(print "--- [TX-S1-COL · 01 · absent-column semantics, measured] ---")
(print "")
(print "WHY A MODEL AND NOT THE REAL READERS. The adversarial state is an OLD ROW under NEW CODE,")
(print "and no ordinary fixture can build it: every suite loads the current module first and")
(print "`insert` always supplies every column, so a fresh row can NEVER be missing one. Reaching")
(print "it for AQP would mean pinning the pre-upgrade RPS and its whole dependency chain. So this")
(print "pins the LANGUAGE FACTS the four AQP guards rest on, and")
(print "`REPL/tools/_newcolumnsafety.py` -- negative-controlled against the pre-fix 04_RPS.pact,")
(print "which it reports at seven sites -- enforces that the real readers are shaped this way.")
(print "")
(print "THIS IS THE DEFECT THAT HALTED CHAIN 0 FOR ~16h ON 2026-11-09, and then was repeated the")
(print "same day in AQP on the stated belief that `try` would default an absent column.")
(module S1COL GOV
    (defcap GOV () true)
    (defschema row-v1 a:integer)
    (deftable T:{row-v1})
    (defun seed:string () (insert T "k" {"a": 1}))
)
(create-table T)
(commit-tx)

;;|| NEXT >
;;||
;;||
(begin-tx)
;;==== TX-S1-COL · 02 · seed a row under the OLD schema ====
(print "--- [TX-S1-COL · 02 · seed a row under the OLD schema] ---")
(S1COL.seed)
(commit-tx)

;;|| NEXT >
;;||
;;||
(begin-tx)
;;==== TX-S1-COL · 03 · UPGRADE: the schema gains two columns ====
(print "--- [TX-S1-COL · 03 · UPGRADE: the schema gains two columns] ---")
;;The row written in TX 02 carries neither `b` nor `stored`. This mirrors FVT|RPS|Global gaining
;;`dormant-claim-count` beside the `unclaimed-count` it already had.
(module S1COL GOV
    (defcap GOV () true)
    (defschema row-v1 a:integer b:integer stored:integer)
    (deftable T:{row-v1})
    (defun seed:string () (insert T "k" {"a": 1, "b": 0, "stored": 0}))
    ;;---- the four forms that DO NOT work -------------------------------------------------
    (defun r-bare:integer    () (at "b" (read T "k")))
    (defun r-wdr:integer     () (with-default-read T "k" {"a":0,"b":0} {"b":=b} b))
    (defun r-try:integer     () (try 99 (at "b" (read T "k"))))
    (defun r-try-wdr:integer () (try 99 (with-default-read T "k" {"a":0,"b":0} {"b":=b} b)))
    ;;---- the one form that does ----------------------------------------------------------
    (defun r-contains:integer ()
        (let ((row:object (try {} (read T "k"))))
            (if (contains "b" row) (at "b" row) 0)))
    ;;`try` DOES catch a missing ROW, which is why `(try {} (read ...))` covers both cases.
    (defun r-absent-row:integer ()
        (let ((row:object (try {} (read T "nope"))))
            (if (contains "b" row) (at "b" row) 0)))
    ;;---- the restore guard, in the shape 04_RPS.pact now uses ----------------------------
    ;;`XI_2|RestoreUnclaimedFromCounts`: the guarded readers DEFAULT to 0 rather than abort, and
    ;;0 is the direction that LOSES MONEY -- writing it over a lane whose legs are still owed
    ;;makes the next collect see a count below 1 and sweep the whole lane to one account. So the
    ;;restore refuses to write a zero over a positive stored count.
    (defun stored-count:integer ()
        (let ((row:object (try {} (read T "k"))))
            (if (contains "stored" row) (at "stored" row) 0)))
    (defun restore:string (earning:integer dormant:integer stored:integer)
        (let ((restored:integer (+ earning dormant)))
            (if (and (= restored 0) (> stored 0))
                (format "left at {} -- counters not yet repaired" [stored])
                (format "restored to {}" [restored]))))
)
(commit-tx)

;;|| NEXT >
;;||
;;||
(begin-tx)
;;==== TX-S1-COL · 04 · the assertions ====
(print "--- [TX-S1-COL · 04 · the assertions] ---")
(map print
    [
        (expect-failure "<<TX-S1-COL>> a BARE `at` on an absent column ABORTS"
            (S1COL.r-bare))
        ;;THE ONE THAT MATTERED. Four doc strings in 04_RPS.pact asserted this form was the
        ;;remedy. It is not: the default object covers an absent ROW, and the row EXISTS.
        (expect-failure "<<TX-S1-COL>> `with-default-read` does NOT default an absent COLUMN"
            (S1COL.r-wdr))
        ;;AND THE ONE THE ROUND ACTUALLY SHIPPED WITH, in all four readers.
        (expect-failure "<<TX-S1-COL>> `try` does NOT catch a missing-column read"
            (S1COL.r-try))
        (expect-failure "<<TX-S1-COL>> `try` + `with-default-read` does not catch it either"
            (S1COL.r-try-wdr))
        (expect "<<TX-S1-COL>> `contains`-then-`at` SURVIVES an absent column, yielding the default"
            0 (S1COL.r-contains))
        (expect "<<TX-S1-COL>> ...and the same form survives an absent ROW, because `try` DOES catch that"
            0 (S1COL.r-absent-row))
        ;;---- the restore guard ----
        (expect "<<TX-S1-COL>> the unrepaired lane reads 0 on both counters"
            0 (S1COL.stored-count))
        ;;Pre-repair: both counters read 0 while 5 legs are still owed. The restore must NOT
        ;;write 0 -- that is the irreversible direction.
        (expect "<<TX-S1-COL>> restore REFUSES to write a 0 over a positive stored count"
            "left at 5 -- counters not yet repaired" (S1COL.restore 0 0 5))
        ;;Post-repair, or any lane with live legs: it restores normally.
        (expect "<<TX-S1-COL>> ...and restores normally once the counters are real"
            "restored to 7" (S1COL.restore 5 2 5))
        ;;The case it gives up is EMPTY -- nothing earns, nothing is owed, so there is no
        ;;claimant a low count could mis-pay.
        (expect "<<TX-S1-COL>> a genuinely empty lane still restores to 0"
            "restored to 0" (S1COL.restore 0 0 0))
    ]
)
(print "===^^^===")
(commit-tx)

(print "")
(print "================================================================")
(print "S1-UNCLAIMED END")
(print "================================================================")
