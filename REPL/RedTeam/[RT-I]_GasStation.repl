;;   Inter-tx:   ;;|| NEXT >  (same three lines as REPL/Stage_01/[2.2]_Core.repl)
;;   Intra-tx:   ;;==== <TX label> · mm · <slug> ====  + next-line (print "--- [<label> · mm · …] ---"); mm = 01.. within each (begin-tx …) (see OuronetInformational/ARCHITECTURE/REPL_AND_TESTS.md).
;;   format "{}": Talos / module echoes and (env-gas) — document additional prefixes in this file's (print …) lines as needed.
;;
(print "")
(print "================================================================")
(print "FILE  REPL/RedTeam/[RT-I]_GasStation.repl")
(print "================================================================")
(print "Legend (terminal observability): see ;; preface; echoes use <(…)> where helpful.")
(print "Source: ;;|| NEXT > between txs; ;;==== … · mm · … ==== + banner before each begin-tx.")
(print "")
;;
;; REPL/RedTeam/[RT-I]_GasStation.repl — FAMILY I: the gas station's payable surface.
;;
;; "What will Ouronet agree to pay for?"
;;
;; This is the last first-rank target Stage 0 produced and the only one never attacked. Stage 0's
;; own words: "`GAS_PAYER` Case 3 validates exec-code forms 0, 1 and 2 only; forms at index >= 3
;; are unconstrained and form 2 need only *start with* `(let`. The only bound is economic."
;;
;; GAS_PAYER is the capability the gas station acquires before agreeing to pay a transaction's KDA.
;; Its whole input is `(read-msg "exec-code")`, so `env-data` IS the fixture and `test-capability`
;; acquires the cap exactly as chainweb would during buy-gas. The idiom is borrowed from
;; modules/DALOS-ADMIN.repl <<DALOS-G2a>>.
;;
;; Run: cd REPL && pact "RedTeam/[RT-I]_GasStation.repl"
;;
(load "../deploy-stage00.repl")
(load "../deploy-stage01.repl")

;;|| NEXT >
;;
(begin-tx "RT-I-001a - BASELINE: the intended Case 3 shape is funded")
(env-gasmodel "table")(env-gaslimit 100000000)(env-gas 0)
(namespace "ouronet-ns")
(print "--- [RT-I-001a] ---")
;;<<RT-I-001>> FAMILY: I | STATUS: FIXED
;;HYPOTHESIS: the Ouronet gas station whitelists by reading the transaction's top-level forms out of
;;            `exec-code`. Case 1 pins a SINGLE form to `(coin.C_`, `(ouronet-ns.TS`,
;;            `(ouronet-ns.DSP` or `(ouronet-ns.STOAICO.`; Case 2 pins BOTH of two forms to
;;            `(coin.C_`. Case 3 accepts `(>= n 3)` and then inspects indices 0, 1 and 2 ONLY. If an
;;            attacker supplies the three-form prefix Case 3 wants and APPENDS a fourth form, that
;;            form is never looked at -- and Ouronet pays the gas for whatever it is. The appended
;;            code still has to satisfy its own guards, so this is not theft; it is FREE EXECUTION,
;;            which is the thing a gas station exists to ration.
;;METHOD:     drive `DALOS.GAS_PAYER` directly with `env-data` supplying `exec-code`, exactly as
;;            chainweb supplies it during buy-gas -- the idiom modules/DALOS-ADMIN.repl
;;            <<DALOS-G2a>> establishes. ONE TRANSACTION PER CASE, because `test-capability` grants
;;            the cap for the remainder of the transaction. Then PRICE the door by measuring a real
;;            `IGNIS::XE_CollectIgnis` of `UDC_CustomCodeCumulator`, for a standard patron and for a
;;            gassless one.
;;
;;RESULT: BOTH FINDINGS ARE NOW CLOSED (2026-09-20). This block used to read "SUCCEEDED ... a
;;        plain DESIGN-INTENT VIOLATION". That verdict covered TWO separate things, and they were
;;        resolved separately -- one by a code fix, one by the owner stating that it was never a
;;        finding at all. Leaving the old verdict in place would have this file asserting two
;;        vulnerabilities the system no longer has.
;;
;;        [1] THE GASLESS-PATRON EXEMPTION -- WAS REAL, IS FIXED.
;;            The owner's rule: only ONE hardcoded smart account may be a gasless payer. The code
;;            at the time read `iz-gassles-patron` off the `smart-contract` flag, which
;;            XI_DeploySmartAccount sets unconditionally -- so EVERY smart account was exempt.
;;            02_IGNIS.pact:1901 now reads:
;;                (iz-gassles-patron:bool (= patron (ref-DALOS::GOV|DALOS|SC_NAME)))
;;            -- a single hardcoded account, exactly as specified. The narrowing was measured
;;            first: all 37 genuine patron slots that pass a smart-account constant are in
;;            03_DSP+.pact, so nothing outside the daily minter relied on the wide exemption.
;;
;;        [2] CASE 3's UNINSPECTED FOURTH FORM -- WAS NEVER A VIOLATION.
;;            Owner, 2026-09-20: this is the PRODUCT. The caller pays 25 IGNIS and the gas station
;;            sponsors a custom `let` block of arbitrary size. The whitelist inspects forms 0-2
;;            and deliberately does not read the fourth, because the fourth is what the 25 IGNIS
;;            BUYS. It is rationed execution, not free execution -- the door has a price.
;;            The paid door is now `DPTF|C_Transmute` of the IGNIS DPTF (see that function's @doc
;;            for why 25, and why it costs no IGNIS), NOT a direct XE_CollectIgnis call: the
;;            collector became an IMC-gated X_ function in the same pass and can no longer be
;;            reached from exec-code at all.
;;
;;        OWNER: "an IGNIS gas payer account can only be a STANDARD account. A smart account
;;        can never be a gassless payer, EXCEPT one single account HARDCODED into the code,
;;        to allow admin-based gassless IGNIS transactions -- the Ouroboros daily minter uses
;;        such a gassless patron. No other smart account should have this property."
;;
;;        THE CODE IMPLEMENTS NO SUCH HARDCODING. `iz-gassles-patron` is
;;        `(DALOS::UR_AccountType patron)` = the `smart-contract` flag, which
;;        `XI_DeploySmartAccount` sets to `true` UNCONDITIONALLY. "gassles" appears exactly
;;        TWICE in all of 1_SOVEREIGN and both are those two lines. So the exemption's
;;        population is not one account -- it is SEVEN system smart accounts created by
;;        [4.0]_Sovereign-Executor, PLUS every user smart account, because
;;        `DALOS|C_DeploySmartAccount` is a CLIENT wrapper (TS01-C1:311), not an admin one.
;;        Measured on KC.BJ -- an ordinary user account on a user keyset -- at RT-I-001h.
;;
;;        FIX SHAPE (the account is the owner's to name): `iz-gassles-patron` should compare
;;        the patron against the ONE designated account, not read the smart flag.
;;
;;        The original framing below still holds and is the mechanism: the defect is NOT the
;;        unvalidated tail -- that is the custom-code door
;;        working as designed, with the fee as its bound. The defect is that THE FEE CAN BE
;;        DECLINED. Every link measured below:
;;
;;  1. Case 3 inspects forms 0, 1, 2 only; `(>= n 3)` bounds nothing above.   [RT-I-001c]
;;  2. The COUNT of appended forms is unbounded.                              [RT-I-001d]
;;  3. Form 2 need only START with "(let" -- its body is unread.              [RT-I-001e]
;;  4. The door is priced at a FLAT (* 5.0 tier-biggest): 25 raw, 13.25 after
;;     a top-tier discount -- independent of what the tail does.              [RT-I-001f]
;;  5. A GASSLESS (smart) account pays 0.0. `IGNIS::XE_CollectIgnis` collects only
;;     `(if (and (!= ignis-sum 0.0) (not iz-gassles-patron)) ...)`.           [RT-I-001g]
;;  6. Smart accounts are PERMISSIONLESS: `DALOS|C_DeploySmartAccount` is a CLIENT wrapper on
;;     TS01-C1:311, not an admin one, priced in STOA at `acct-smart` 1000 deter = 100 STOA (~$10)
;;     -- and that fee is itself conditional on `UR_AccountCreationStoa`, so it is ZERO when the
;;     account-creation toggle is off.
;;
;;  So: pay once (or nothing), then submit unlimited transactions of the shape
;;  `namespace + IGNIS.XE_CollectIgnis(CustomCodeCumulator) + (let ...) + <arbitrary code>`, paying NO
;;  IGNIS, with the gas station funding up to DALOS|GAS-BUDGET = 2,000,000 gas units of NATIVE STOA
;;  each time. (There is no gas station for IGNIS -- only for native STOA.)
;;
;;  THIS IS RT-A-001's SHAPE IN THE GAS STATION: a deterrent that can be declined. There the second
;;  door skipped `lp-churn`; here the gassless exemption skips the custom-code fee. The appended
;;  code still satisfies its own guards, so it is not theft -- it is FREE EXECUTION, which is the
;;  one thing a gas station exists to ration.
;;
;;SCOPE OF WHAT IS PROVEN. Links 1-5 are measured in this file; link 6 is read off the Talos surface.
;;The COMPOSITION is not executed end to end, because the REPL cannot simulate chainweb's buy-gas
;;phase -- `test-capability` acquires GAS_PAYER exactly as buy-gas would, which is what makes 1-3
;;real, but no REPL can show the KDA actually leaving the station. That last step is an on-chain
;;smoke test, and it is the only part of this finding that is inference rather than measurement.
;;
;;ONE TRANSACTION PER CASE, AND THAT IS NOT COSMETIC. The first draft of this attack put all five
;;cases in ONE begin-tx and reported a clean success. It was vacuous: `test-capability` GRANTS the
;;capability for the remainder of the transaction, so cases 2-5 never re-evaluated the defcap body
;;at all -- they were reading a cap already in scope from case 1. The CONTROL is what exposed it:
;;a single foreign form, which DALOS-G2c proves is refused, came back as "expected failure, got
;;result: ()". Without that control this file would have claimed a gas-station hole it had not
;;demonstrated. Capability scope is per-transaction; so is each case below.
;;BASELINE. Without this the refusals below prove nothing -- a Case 3 that rejects everything is not
;;a hole, it is a closed door.
;;==== RT-I-001a - BASELINE: the intended Case 3 shape is funded · 01 · env-sigs (caps) ==== ======
(print "--- [RT-I-001a - BASELINE: the intended Case 3 shape is funded · 01 · env-sigs (caps)] ---")
(env-sigs [{ "key": "PK_AncientHodler", "caps": [] }])
(env-data { "exec-code": ["(namespace \"ouronet-ns\")"
                   "(TS01-C1.DPTF|C_Transmute \"Ѻ.attacker\" \"GAS-98c486052a51\" \"Ѻ.attacker\" 25.0)"
                   "(let ((x 1)) x)"] })
(print
    (expect "<<RT-I-001>> BASELINE: the intended three-form Case 3 shape is funded"
        true (!= "" (format "{}" [(test-capability (DALOS.GAS_PAYER KST.EMMA 1000 0.0000001))])))
)
(print "===^^^===")
(env-sigs [])
(env-data {})
(commit-tx)

;;|| NEXT >
;;
(begin-tx "RT-I-001b - CONTROL: a single foreign form is refused")
(env-gasmodel "table")(env-gaslimit 100000000)(env-gas 0)
(namespace "ouronet-ns")
(print "--- [RT-I-001b] ---")
;;CONTROL. Case 1 really is tight, so the station is not simply open to everything; the only
;;question is what Case 3 lets past. This is the assertion that caught the vacuous first draft.
;;==== RT-I-001b - CONTROL: a single foreign form is refused · 01 · env-sigs (caps) ==== ==========
(print "--- [RT-I-001b - CONTROL: a single foreign form is refused · 01 · env-sigs (caps)] ---")
(env-sigs [{ "key": "PK_AncientHodler", "caps": [] }])
(env-data { "exec-code": ["(bogus.thing)"] })
(print
    (expect-failure "<<RT-I-001>> CONTROL: a single foreign form is refused by Case 1"
        "Payable Modules / form count not satisfied"
        (test-capability (DALOS.GAS_PAYER KST.EMMA 1000 0.0000001)))
)
(print "===^^^===")
(env-sigs [])
(env-data {})
(commit-tx)

;;|| NEXT >
;;
(begin-tx "RT-I-001c - ATTACK: a fourth, unvalidated form")
(env-gasmodel "table")(env-gaslimit 100000000)(env-gas 0)
(namespace "ouronet-ns")
(print "--- [RT-I-001c] ---")
;;THE ATTACK. Identical prefix, one extra form at index 3 that no enforce in Case 3 ever reads.
;;==== RT-I-001c - ATTACK: a fourth, unvalidated form · 01 · env-sigs (caps) ==== =================
(print "--- [RT-I-001c - ATTACK: a fourth, unvalidated form · 01 · env-sigs (caps)] ---")
(env-sigs [{ "key": "PK_AncientHodler", "caps": [] }])
(env-data { "exec-code": ["(namespace \"ouronet-ns\")"
                   "(TS01-C1.DPTF|C_Transmute \"Ѻ.attacker\" \"GAS-98c486052a51\" \"Ѻ.attacker\" 25.0)"
                   "(let ((x 1)) x)"
                   "(bogus.thing)"] })
(print
    (expect "<<RT-I-001>> ATTACK: a FOURTH form of arbitrary code rides in unvalidated"
        true (!= "" (format "{}" [(test-capability (DALOS.GAS_PAYER KST.EMMA 1000 0.0000001))])))
)
(print "===^^^===")
(env-sigs [])
(env-data {})
(commit-tx)

;;|| NEXT >
;;
(begin-tx "RT-I-001d - ATTACK: the appended count is unbounded")
(env-gasmodel "table")(env-gaslimit 100000000)(env-gas 0)
(namespace "ouronet-ns")
(print "--- [RT-I-001d] ---")
;;...and it is not a one-form allowance. `(>= n 3)` bounds nothing above.
;;==== RT-I-001d - ATTACK: the appended count is unbounded · 01 · env-sigs (caps) ==== ============
(print "--- [RT-I-001d - ATTACK: the appended count is unbounded · 01 · env-sigs (caps)] ---")
(env-sigs [{ "key": "PK_AncientHodler", "caps": [] }])
(env-data { "exec-code": ["(namespace \"ouronet-ns\")"
                   "(TS01-C1.DPTF|C_Transmute \"Ѻ.attacker\" \"GAS-98c486052a51\" \"Ѻ.attacker\" 25.0)"
                   "(let ((x 1)) x)"
                   "(bogus.one)" "(bogus.two)" "(bogus.three)"] })
(print
    (expect "<<RT-I-001>> ATTACK: neither is the COUNT of appended forms bounded"
        true (!= "" (format "{}" [(test-capability (DALOS.GAS_PAYER KST.EMMA 1000 0.0000001))])))
)
(print "===^^^===")
(env-sigs [])
(env-data {})
(commit-tx)

;;|| NEXT >
;;
(begin-tx "RT-I-001e - ATTACK: form 2's body is unread")
(env-gasmodel "table")(env-gaslimit 100000000)(env-gas 0)
(namespace "ouronet-ns")
(print "--- [RT-I-001e] ---")
;;A SECOND, INDEPENDENT way past the same case: the form-2 check is `(take 4 ...)` = "(let", so
;;everything after those four characters is free.
;;==== RT-I-001e - ATTACK: form 2's body is unread · 01 · env-sigs (caps) ==== ====================
(print "--- [RT-I-001e - ATTACK: form 2's body is unread · 01 · env-sigs (caps)] ---")
(env-sigs [{ "key": "PK_AncientHodler", "caps": [] }])
(env-data { "exec-code": ["(namespace \"ouronet-ns\")"
                   "(TS01-C1.DPTF|C_Transmute \"Ѻ.attacker\" \"GAS-98c486052a51\" \"Ѻ.attacker\" 25.0)"
                   "(let ((y 0)) (bogus.thing))"] })
(print
    (expect "<<RT-I-001>> ATTACK: form 2 need only START with (let -- its body is unread"
        true (!= "" (format "{}" [(test-capability (DALOS.GAS_PAYER KST.EMMA 1000 0.0000001))])))
)
(print "===^^^===")
(env-sigs [])
(env-data {})
(commit-tx)
;;|| NEXT >
;;
(begin-tx "RT-I-001f - what the unvalidated tail actually COSTS the attacker")
(env-gasmodel "table")(env-gaslimit 100000000)(env-gas 0)
(namespace "ouronet-ns")
(print "--- [RT-I-001f · the price of the custom-code door] ---")
;;THE ECONOMICS, WHICH DECIDE WHETHER THE HOLE MATTERS. Case 3 is not an oversight in shape: it is
;;the CUSTOM CODE door, and it obliges the caller to run
;;`(IGNIS.XE_CollectIgnis "Ѻ.…" (IGNIS.UDC_CustomCodeCumulator))` as form 1. That cumulator is
;;`(* 5.0 (UC_IgnisLeg "tier-biggest"))` -- a FLAT fee, independent of how much work the appended
;;forms do, while the gas Ouronet subsidises is bounded only by DALOS|GAS-BUDGET (2,000,000 units at
;;the protocol floor, per UEV_enforce-notional-at-floor).
;;
;;So the question is not "can arbitrary code ride in" -- RT-I-001c proves it can -- but "what is the
;;exchange rate". Measured here rather than asserted, because a flat fee against a bounded subsidy
;;is only a defect if the fee is the smaller number.
;;==== RT-I-001f - what the unvalidated tail actually COSTS the attacker · 01 · env-sigs (caps) ==== 
(print "--- [RT-I-001f - what the unvalidated tail actually COSTS the attacker · 01 · env-sigs (caps)] ---")
(env-sigs [{ "key": "PK_AncientHodler", "caps": [] }])
;;==== RT-I-001f - what the unvalidated tail actually COSTS the attacker · 02 · let / invocation ==== 
(print "--- [RT-I-001f - what the unvalidated tail actually COSTS the attacker · 02 · let / invocation] ---")
(let
    (
        (ref-DALOS:module{OuronetDalosV2} DALOS)
        (ref-IGNIS:module{IgnisCollectorV3} IGNIS)
        (patron:string KST.ANHD)
    )
    (let
        (
            (b0:decimal (ref-DALOS::UR_TF_AccountSupply patron false))
        )
        (test-capability (DPTF.P|DPTF|CALLER))
        (ref-IGNIS::XE_CollectIgnis patron (ref-IGNIS::UDC_CustomCodeCumulator))
        (let
            (
                (paid:decimal (- b0 (ref-DALOS::UR_TF_AccountSupply patron false)))
            )
            (map print
                [
                    (format "<<RT-I-001>> custom-code door costs the caller {} IGNIS, and unlocks up to {} gas"
                        [paid DALOS.DALOS|GAS-BUDGET])
                    ;;the door is PRICED -- a free door would make the unvalidated tail serious
                    (expect "<<RT-I-001>> the custom-code door is not free: the caller really is charged"
                        true (> paid 0.0))
                    ;;...and the fee is FLAT. This is the property that makes the exchange rate
                    ;;attacker-controlled: identical fee whether the tail does nothing or 2M gas of work.
                    (expect "<<RT-I-001>> the fee is the FLAT 5x tier-biggest, not a function of the work"
                        (* (ref-DALOS::URC_IgnisGasDiscount patron) (* 5.0 (ref-IGNIS::UC_IgnisLeg "tier-biggest")))
                        paid)
                ])
        )
    )
    ""
)
(print "===^^^===")
(env-sigs [])
(commit-tx)
;;|| NEXT >
;;
(begin-tx "RT-I-001g - the exemption jumped over a guard that already said this")
(env-gasmodel "table")(env-gaslimit 100000000)(env-gas 0)
(namespace "ouronet-ns")
(print "--- [RT-I-001g · the shadowed patron guard] ---")
;;THE RULE ALREADY EXISTED. `IGNIS::UEV_Patron` is exactly the owner's sentence, in code:
;;
;;    (if (ref-DALOS::UR_AccountType patron)
;;        (do (enforce (= patron DALOS|SC_NAME) "Only the DALOS Account can be a Smart Patron")
;;            (ref-DALOS::CAP_EnforceAccountOwnership DALOS|SC_NAME))
;;        (ref-DALOS::CAP_EnforceAccountOwnership patron))
;;
;;BUT IT WAS UNREACHABLE FOR THE ACCOUNTS IT IS ABOUT. `UEV_Patron` runs inside
;;`IGNIS|C>COLLECT`, and `XE_CollectIgnis` acquires that capability only when it actually collects:
;;
;;    (if (and (!= ignis-sum 0.0) (not iz-gassles-patron)) (with-capability (IGNIS|C>DC patron) ...))
;;
;;and `iz-gassles-patron` was `(UR_AccountType patron)` -- true for EVERY smart account. So a smart
;;patron took the branch that SKIPS collection, and skipping collection skipped the guard that says
;;only one smart account may be a patron. THE EXEMPTION JUMPED OVER THE RULE WRITTEN TO CONSTRAIN
;;IT. That is RT-C-001's shadowed admin gate, in the billing path: a guard that is present, correct,
;;and never consulted for the inputs it was written about.
;;
;;FIXED 2026-09-15 by making `iz-gassles-patron` compare against GOV|DALOS|SC_NAME instead of
;;reading the flag. The designated account stays exempt -- the DSP daily minters are unaffected --
;;and every other smart account now reaches UEV_Patron and is REFUSED BY NAME.
;;==== RT-I-001g - the exemption jumped over a guard that already said this · 01 · env-sigs (caps) ==== 
(print "--- [RT-I-001g - the exemption jumped over a guard that already said this · 01 · env-sigs (caps)] ---")
(env-sigs [{ "key": "PK_AncientHodler", "caps": [] }, { "key": "PK_BJ", "caps": [] }])
;;==== RT-I-001g - the exemption jumped over a guard that already said this · 02 · let / invocation ==== 
(print "--- [RT-I-001g - the exemption jumped over a guard that already said this · 02 · let / invocation] ---")
(let
    (
        (ref-DALOS:module{OuronetDalosV2} DALOS)
        (ref-IGNIS:module{IgnisCollectorV3} IGNIS)
        (smart:string KC.BJ)
    )
    ;;XE_CollectIgnis is now P|UEV_IMC-protected, so a bare REPL call cannot reach the billing
    ;;path at all. Grant the stand-in caller capability FIRST -- otherwise the refusal below
    ;;would be the IMC gate, not the patron guard, and the test would prove the wrong thing.
    (test-capability (DPTF.P|DPTF|CALLER))
    (map print
        [
            ;;non-vacuity: the fixture really is the gassless KIND, so the refusal below is about
            ;;WHICH smart account it is, not about it being ordinary.
            (expect "<<RT-I-001>> the fixture really is a smart account"
                true (ref-DALOS::UR_AccountType smart))
            ;;THE FIX, ASSERTED AS A REFUSAL AND PINNED BY MESSAGE. Before the repair this call
            ;;SUCCEEDED and charged 0.0 -- free execution through the custom-code door. Now it
            ;;reaches the guard that was always there, and the message proves WHICH guard refused.
            (expect-failure "<<RT-I-001>> FIXED: a non-designated smart patron is refused BY NAME"
                "Only the DALOS Account can be a Smart Patron"
                (ref-IGNIS::XE_CollectIgnis smart (ref-IGNIS::UDC_CustomCodeCumulator)))
        ])
)
(print "===^^^===")
(env-sigs [])
(commit-tx)
;;|| NEXT >
;;
(begin-tx "RT-I-001h - WHICH accounts are gassless, against the stated design")
(env-gasmodel "table")(env-gaslimit 100000000)(env-gas 0)
;;==== RT-I-001h - WHICH accounts are gassless, against the stated design · 01 · namespace ==== ===
(print "--- [RT-I-001h - WHICH accounts are gassless, against the stated design · 01 · namespace] ---")
(namespace "ouronet-ns")
(print "--- [RT-I-001h · the exemption's actual population] ---")
;;OWNER'S STATED DESIGN (2026-09-15): "an IGNIS gas payer account can only be a STANDARD account. A
;;smart account can never be a gassless payer, EXCEPT for one single account hardcoded into the
;;code, to allow admin-based gassless IGNIS transactions -- for example the Ouroboros daily minter
;;uses such a gassless patron. No other smart account should have this property."
;;
;;WHAT THE CODE DOES. `iz-gassles-patron` is `(DALOS::UR_AccountType patron)`, and UR_AccountType is
;;`(at 0 (UR_AccountProperties account))` = the `smart-contract` flag. `XI_DeploySmartAccount`
;;sets that flag to `true` UNCONDITIONALLY for every account deployed through it, and BOTH
;;`DALOS|A_DeploySmartAccount` (admin) and `DALOS|C_DeploySmartAccount` (CLIENT, TS01-C1:311,
;;permissionless, STOA-priced) route there. There is NO hardcoded account: "gassles" appears exactly
;;twice in all of 1_SOVEREIGN, and both are the two lines in IGNIS::XE_CollectIgnis.
;;
;;So the exemption's population is "every smart account", not "one". This block states that as a
;;measurement on a specific, ordinary user account.
;;==== RT-I-001h - WHICH accounts are gassless, against the stated design · 02 · let / invocation ==== 
(print "--- [RT-I-001h - WHICH accounts are gassless, against the stated design · 02 · let / invocation] ---")
(let
    (
        (ref-DALOS:module{OuronetDalosV2} DALOS)
        (user-smart:string KC.BJ)
    )
    (map print
        [
            (format "<<RT-I-001>> KC.BJ (us-0008_bnjr, an ORDINARY user smart account) gassless={}"
                [(ref-DALOS::UR_AccountType user-smart)])
            ;;THE DESIGN VIOLATION, stated positively so it cannot pass vacuously: an ordinary user
            ;;account -- deployed from the client surface, owned by a user keyset, not hardcoded
            ;;anywhere -- carries the exemption that the design reserves for ONE system account.
            ;;the FLAG is still "is smart" -- that is a correct account property and untouched.
            ;;What changed is that the EXEMPTION no longer follows it (see RT-I-001g).
            (expect "<<RT-I-001>> the smart-contract FLAG is still set on an ordinary user account"
                true (ref-DALOS::UR_AccountType user-smart))
            ;;...and a standard account does not, so the flag really is "is smart", not "is the
            ;;designated payer". Without this the line above could be true of everything.
            (expect "<<RT-I-001>> ...while a standard account does not -- the flag is 'is smart'"
                false (ref-DALOS::UR_AccountType KST.ANHD))
        ])
)
(print "===^^^===")
(commit-tx)
;;|| NEXT >
;;
(begin-tx "RT-I-001i - why the one-line fix is NOT safe")
(env-gasmodel "table")(env-gaslimit 100000000)(env-gas 0)
;;==== RT-I-001i - why the one-line fix is NOT safe · 01 · namespace ==== =========================
(print "--- [RT-I-001i - why the one-line fix is NOT safe · 01 · namespace] ---")
(namespace "ouronet-ns")
(print "--- [RT-I-001i · the exemption's live dependants] ---")
;;THE INTENDED ACCOUNT EXISTS, AND THE OWNER REMEMBERED IT CORRECTLY. `03_DSP+.pact` defines
;;`(defconst GASLESS-PATRON (URC_Gassless))` and `URC_Gassless` returns
;;`(ref-DALOS::GOV|DALOS|SC_NAME)` -- the DALOS smart account. Every daily-emission call in the
;;Ouroboros and Koson minters passes exactly that.
;;
;;BUT IT IS A CALLER-SIDE CONVENTION, NOT AN ENFORCEMENT. DSP *chooses* to pass one account;
;;`IGNIS::XE_CollectIgnis` still exempts ANY smart patron. That is RT-C-001's lesson in a new place: a
;;convention that is honoured is indistinguishable from a rule that is enforced, until someone does
;;not honour it -- and the Case 3 door lets an attacker write the patron into their own transaction
;;text, where DSP's discipline has no reach at all.
;;
;;AND THE OBVIOUS ONE-LINE FIX WOULD BREAK LIVE FLOWS. Narrowing `iz-gassles-patron` to
;;`(= patron (GOV|DALOS|SC_NAME))` would start charging IGNIS to system accounts that are ALREADY
;;used as patrons and hold none:
;;    SWP|SC_NAME -> VST::C_Freeze / C_Sleep   (20_MTX-SWP:684,830,983; 18_SWPLC:1168,1229,1299,1381)
;;    AQP|SC_NAME -> SWPLC::C_Fuel             (04_RPS:5317)
;;This block pins that those accounts really are gassless today, so the constraint on any fix is a
;;measurement rather than a worry.
;;==== RT-I-001i - why the one-line fix is NOT safe · 02 · let / invocation ==== ==================
(print "--- [RT-I-001i - why the one-line fix is NOT safe · 02 · let / invocation] ---")
(let
    (
        (ref-DALOS:module{OuronetDalosV2} DALOS)
        (ref-SWP:module{SwapperV4} SWP)
    )
    (map print
        [
            (format "<<RT-I-001>> DALOS|SC_NAME gassless={} (the DESIGNATED one, per DSP's GASLESS-PATRON)"
                [(ref-DALOS::UR_AccountType (ref-DALOS::GOV|DALOS|SC_NAME))])
            ;;the designated account is gassless -- the mechanism does serve its intended consumer
            (expect "<<RT-I-001>> the DESIGNATED account (DALOS|SC_NAME) is gassless, as designed"
                true (ref-DALOS::UR_AccountType (ref-DALOS::GOV|DALOS|SC_NAME)))
            ;;...and so is SWP's, which is passed as a PATRON by live liquidity code. Narrowing the
            ;;exemption to the designated account alone would start charging this one.
            ;;CORRECTION (2026-09-15). This block first claimed SWP|SC_NAME was passed AS A
            ;;PATRON by live liquidity code, and concluded the fix was unsafe. That was a
            ;;NAME-COLLISION ERROR in the sweep: it matched callees by bare name, so VST::C_Freeze
            ;;matched a DIFFERENT module's C_Freeze whose first parameter is `patron`. VST's is
            ;;`freezer`; C_Sleep takes `sleeper`, C_Hibernate `hibernator`, SWPLC::C_Fuel
            ;;`account`. Resolving each call site to its actual callee gives 37 genuine patron
            ;;slots, ALL 37 in 03_DSP+.pact and none elsewhere -- which is exactly what the owner
            ;;said from memory, and why the narrow fix was safe after all.
            (expect "<<RT-I-001>> SWP|SC_NAME is smart, but is NOT a patron anywhere -- flag only"
                true (ref-DALOS::UR_AccountType (ref-SWP::GOV|SWP|SC_NAME)))
        ])
)
(print "===^^^===")
(commit-tx)

;;|| NEXT >
;;
(begin-tx "RT-I-002 — the station's spending cap, and who it does not apply to")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(namespace "ouronet-ns")
;;==== RT-I-002 · 01 · the cap holds for a stranger ====
(print "--- [RT-I-002 · 01 · the cap holds for a stranger] ---")
;;<<RT-I-002>> FAMILY: I | STATUS: REFUSED
;;HYPOTHESIS: `GAS_PAYER`'s spending cap is not a plain enforce -- it is one arm of an `enforce-one`
;;            whose FIRST arm is `(enforce-guard GOV|MD_DALOS)`. An `enforce-one` passes if ANY arm
;;            passes, so the Demiurgoi master keyset does not merely have a higher allowance: it has
;;            NO allowance check at all. If that is so, the gas station's only spending bound is
;;            absent for its most powerful key, and nothing in the tree says so.
;;METHOD:     hold EVERYTHING constant -- the same payable form, the same 100,000,000 gas at a
;;            1,000x price -- and change ONLY the signer set. A differential of exactly one variable,
;;            because a refusal and an admission under different inputs would prove nothing about
;;            the guard.
;;RESULT:     REFUSED for a stranger, ADMITTED for the master keyset. No privilege was escalated --
;;            this is the documented shape of the `enforce-one`, not a bypass of it -- but the
;;            PROPERTY had never been witnessed, and it is worth witnessing: the station's spending
;;            cap is the difference between subsidising a client call and funding an arbitrarily
;;            expensive transaction, and for one keyset that difference does not exist. It matters
;;            the day the master key is driven by automation rather than by a person.
;;
;;WHY THIS BLOCK EXISTS AT ALL. Family I was assessed as the round's thinnest surface on an attack
;;COUNT -- one attack. That assessment was wrong in the way counts usually are: `modules/DALOS-ADMIN.repl`
;;already drives `GAS_PAYER` through five blocks, including the notional ceiling at <<DALOS-G2d>>
;;and two dead guards at <<DALOS-G2e>>. Counting attacks in a family undercounts coverage that lives
;;in a module suite. What was genuinely missing was not the cap -- it was the ARM BESIDE the cap.
(env-data {"exec-code": ["(ouronet-ns.TS01-C1.something)"]})
(env-chain-data { "gas-limit": 100000000, "gas-price": 0.001 })
;;==== RT-I-002 — the station's spending cap, and who it does not apply to · 01 · env-sigs (caps) ==== 
(print "--- [RT-I-002 — the station's spending cap, and who it does not apply to · 01 · env-sigs (caps)] ---")
(env-sigs [{ "key": "PK_Emma", "caps": [] }])
(map print
    [
        ;;The stranger is refused -- and by the OUTER `enforce-one`'s message, never the cap's own.
        ;;Every nested message inside a Pact `enforce-one` is mute: all arms are tried, and the outer
        ;;message is what surfaces. So a caller who exceeds the allowance is never told that is why.
        (expect-failure "<<RT-I-002>> a stranger cannot have an over-budget transaction funded"
            "Add multiple conditions needed to use Ouronet DALOS Gas-Station"
            (test-capability (DALOS.GAS_PAYER KST.EMMA 1000 0.001)))
    ]
)
(commit-tx)

;;|| NEXT >
;;
(begin-tx "RT-I-002b — the identical notional, signed by the Demiurgoi master")
(env-gasmodel "table")(env-gaslimit 10000000)(env-gas 0)
(namespace "ouronet-ns")
;;==== RT-I-002 · 02 · and does not apply to the master keyset ====
(print "--- [RT-I-002 · 02 · and does not apply to the master keyset] ---")
;;Same form, same gas-limit, same gas-price, same account being funded. ONLY the signer set differs.
;;The admission is therefore attributable to `(enforce-guard GOV|MD_DALOS)` and to nothing else.
(env-data {"exec-code": ["(ouronet-ns.TS01-C1.something)"]})
(env-chain-data { "gas-limit": 100000000, "gas-price": 0.001 })
;;==== RT-I-002b — the identical notional, signed by the Demiurgoi master · 01 · env-sigs (caps) ==== 
(print "--- [RT-I-002b — the identical notional, signed by the Demiurgoi master · 01 · env-sigs (caps)] ---")
(env-sigs [{ "key": "PK_AncientHodler", "caps": [] } { "key": "PK_Florin", "caps": [] }])
(map print
    [
        (expect "<<RT-I-002>> the master keyset has the same transaction funded, uncapped"
            true (!= "" (format "{}" [(test-capability (DALOS.GAS_PAYER KST.EMMA 1000 0.001))])))
    ]
)
(commit-tx)
