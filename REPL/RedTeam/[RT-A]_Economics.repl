;;
;; REPL/RedTeam/[RT-A]_Economics.repl — canonical integration layout (OuronetInformational/ARCHITECTURE/REPL_AND_TESTS.md)
;;   Inter-tx:   ;;|| NEXT >  (same three lines as REPL/Stage_01/[2.2]_Core.repl)
;;   Intra-tx:   ;;==== <TX label> · mm · <slug> ====  + next-line (print "--- [<label> · mm · …] ---"); mm = 01.. within each (begin-tx …) (see OuronetInformational/ARCHITECTURE/REPL_AND_TESTS.md).
;;   format "{}": Talos / module echoes and (env-gas) — document additional prefixes in this file's (print …) lines as needed.
;;
(print "")
(print "================================================================")
(print "FILE  REPL/RedTeam/[RT-A]_Economics.repl")
(print "================================================================")
(print "Legend (terminal observability): see ;; preface; echoes use <(…)> where helpful.")
(print "Source: ;;|| NEXT > between txs; ;;==== … · mm · … ==== + banner before each begin-tx.")
(print "")
;;
;; REPL/RedTeam/[RT-A]_Economics.repl — FAMILY A: arithmetic & value.
;;
;; "Can the math be made to produce something other than what was intended?"
;;
;; The first attack in this file is not a rounding trick or an overflow. It is the cheaper kind:
;; the protocol prices one operation TWICE, in two places, and a client may choose which price to
;; pay. No guard is bypassed and no arithmetic is wrong — both routes do exactly what their code
;; says. The defect is that the code says two different things.
;;
;; Run: cd REPL && pact "RedTeam/[RT-A]_Economics.repl"
;;
(load "../deploy-stage00.repl")
(load "../deploy-stage01.repl")
(load "../Stage_01/[6.2]_DPTF.repl")
(load "../Stage_01/[6.3]_SWP.repl")

;;|| NEXT >
;;
(begin-tx "RT-A-001 - route around the lp-churn deterrent by picking the other Talos client")
(env-gasmodel "table")(env-gaslimit 100000000)(env-gas 0)
(namespace "ouronet-ns")
;;==== RT-A-001 · 01 · the same operation, two Talos entrypoints, two prices ====
(print "--- [RT-A-001 · 01 · the same operation, two Talos entrypoints, two prices] ---")
;;<<RT-A-001>> FAMILY: A | STATUS: FIXED
;;HYPOTHESIS: adding standard liquidity is reachable through TWO live Talos client paths, and one
;;            of them does not charge the `lp-churn` deterrent. If so, the deterrent is optional:
;;            a liquidity provider pays it only if they pick the more expensive door.
;;METHOD:     read the flat leg each route charges. The defpact's step 0 bills NOTHING except its
;;            flat fee -- it quotes the pool, yields, and collects -- so the patron's IGNIS delta
;;            across the starting transaction isolates that leg exactly. The single-tx route's
;;            deterrent is read from the price table it bills through.
;;RESULT:     CONFIRMED, then FIXED. Measured exploit-first: the defpact door charged 53.0 (a flat
;;            literal 100.0 at this patron's 0.53 discount) where the single-tx door's deterrent is
;;            1051.0 raw / 557.03 net -- a 10.5x saving on the same operation on the same pool.
;;            Repaired in 20_MTX-SWP.pact; the assertions below now pin that both doors read one
;;            price table. The same gap was fixed in the Frozen and Sleeping twins at the same time.
;;
;;WHY THIS IS A REAL FINDING AND NOT A PRICING PREFERENCE. `lp-churn` is a DETERRENT: its purpose
;;is to make frequent add/remove cycling expensive, which protects the remaining liquidity providers
;;from having the pool churned around them. A deterrent that can be declined is not a deterrent. And
;;the cheaper door is the one the gas station subsidises.
;;
;;    TS01-C3::SWP|C_AddLiquidity          -> SWPLC   -> UC_IgnisPrice "..." "lp-churn"  = 1051.0
;;    TS01-CP::SWP|C_AddStandardLiquidity  -> MTX-SWP -> a literal                       =  100.0
;;
;;Both are `P|UEV_IMC`-gated Talos clients, so both are the supported path; this is not a matter of
;;calling core directly. `lp-churn` appears ZERO times in `20_MTX-SWP.pact`. The earlier repair that
;;put every add-liquidity op onto `UC_IgnisPrice` landed in `18_SWPLC.pact` only, and nothing
;;compared the two modules afterwards -- the suite measured each route against ITS OWN preview, and
;;both agreed with themselves.
;;
;;THAT IS THE GENERAL LESSON, and it is worth the paper: a preview-versus-charge check, however
;;rigorous, cannot see this class. It asks "does this route quote what it charges", and both routes
;;pass. The question nobody was asking is "do two routes to the same operation charge the same".
;;==== RT-A-001 - route around the lp-churn deterrent by picking the other Talos client · 01 · env-sigs (caps) ==== 
(print "--- [RT-A-001 - route around the lp-churn deterrent by picking the other Talos client · 01 · env-sigs (caps)] ---")
(env-sigs [{ "key": "PK_AncientHodler", "caps": [] } { "key": "PK_Emma", "caps": [] }])
;;==== RT-A-001 - route around the lp-churn deterrent by picking the other Talos client · 02 · let / invocation ==== 
(print "--- [RT-A-001 - route around the lp-churn deterrent by picking the other Talos client · 02 · let / invocation] ---")
(let
    (
        (ref-TS01-CP:module{TalosStageOne_ClientPactsV4} TS01-CP)
        (ref-DALOS:module{OuronetDalosV2} DALOS)
        (ref-IGNIS:module{IgnisCollectorV2} IGNIS)
        (ref-SWPLC:module{SwapperLiquidityClientV2} SWPLC)
        (patron:string KST.ANHD)
        ;;the same standard pool modules/SWP.repl measures the SINGLE-TX route on at <<SWP-I14>>,
        ;;so the two figures are directly comparable rather than merely similar.
        (pool:string "S|DLK-98c486052a51|OURO-98c486052a51|DWK-98c486052a51")
        (amounts:[decimal] [10.0 10.0 10.0])
    )
    (let
        (
            (discount:decimal (ref-DALOS::URC_IgnisGasDiscount patron))
            ;;the deterrent the OTHER Talos route bills, read from the table it bills through
            (single-tx-flat:decimal
                (ref-IGNIS::UC_IgnisPrice "SWP|C_AddStandardLiquidity" "lp-churn"))
            (stoa-pid:decimal (U|CT.UR_STOA-PID|Price))
        )
        (let
            (
                ;;READ BEFORE THE ADD -- the CLAD is a function of pool state, and the add moves it.
                (tax:decimal
                    (at "total-ignis-tax-needed"
                        (ref-SWPLC::URCi_AddStandardLiquidityClad patron pool amounts stoa-pid)))
                (quoted:decimal
                    (at "ignis-need" (at "ignis"
                        (INFO-ONE.INFO_SWP|AddStandardLiquidity patron patron pool amounts stoa-pid))))
                (ignis-before:decimal (ref-DALOS::UR_TF_AccountSupply patron false))
            )
            ;;DRIVE THE WHOLE DEFPACT INSIDE ONE TRANSACTION. `continue-pact` resolves against the
            ;;pact started in this same transaction, so all three steps -- and therefore the TOTAL
            ;;they bill -- can be bracketed by one pair of balance reads. Until 2026-09-14 this
            ;;block measured STEP 0 ALONE and compared it to a whole-operation figure, which is why
            ;;the assertions below used to be about the opening leg rather than the price of the op.
            ;;The idiom and its justification live in modules/DEFPACT-BILLING.repl.
            (ref-TS01-CP::SWP|C_AddStandardLiquidity patron patron pool amounts)
            (let
                (
                    (charged0:decimal (- ignis-before (ref-DALOS::UR_TF_AccountSupply patron false)))
                )
                (continue-pact 1)
                (continue-pact 2)
                (let
                    (
                        (total:decimal (- ignis-before (ref-DALOS::UR_TF_AccountSupply patron false)))
                    )
                    (map print
                        [
                            (format "<<RT-A-001>> defpact step-0={} | TOTAL={} | quoted={} + tax={} | deterrent={} raw @ discount={}"
                                [charged0 total quoted tax single-tx-flat discount])
                            ;;1] THE REPAIR, stated where a bypass would now have to hide: the TOTAL.
                            ;;   The multi-step door bills exactly what its preview quotes plus the
                            ;;   declared asymmetry tax -- the same identity modules/SWP.repl pins
                            ;;   for the SINGLE-TX door at <<SWP-I14>> (quoted + tax = real). Two
                            ;;   doors, one price. Before the repair the defpact door billed a flat
                            ;;   100.0 for the churn deterrent where the single-tx door billed
                            ;;   1051.0, and a liquidity provider could simply choose the cheap one.
                            ;;   This is an EQUALITY on a measured balance delta, so dropping any
                            ;;   leg -- including the deterrent remainder now collected in step 1 --
                            ;;   turns it red.
                            (expect "<<RT-A-001>> the defpact door bills exactly its quote plus the declared tax"
                                total (+ quoted tax))
                            ;;2] and it is the real TABLE price, not a second literal that happens to
                            ;;   match -- a literal would drift the moment the price table moved, which is
                            ;;   how the two doors came apart in the first place.
                            (expect "<<RT-A-001>> ...and that price is the table's: deter 1000 + this op's component 51"
                                1051.0 single-tx-flat)
                            ;;3] THE EXPLOIT, INVERTED, and MOVED TO THE TOTAL. This read TRUE before
                            ;;   the repair and must now be false. It is deliberately asserted on the
                            ;;   whole-pact total rather than on step 0, because step 0 is now SMALL
                            ;;   BY DESIGN -- the owner's 2026-09-14 ruling splits the fee so a pact
                            ;;   killed by an altered pool costs its owner only the initiation slice
                            ;;   (see RedTeam/[RT-F]_Griefing.repl <<RT-F-001>>). Asserting the old
                            ;;   "step 0 is not cheap" form would now fail on the FIX, and re-pointing
                            ;;   it at the total is what keeps it a bypass test instead of a
                            ;;   fee-schedule test.
                            (expect "<<RT-A-001>> ...so the ~10x discount the defpact door used to offer is GONE"
                                false (< total (* discount single-tx-flat)))
                            ;;4] the fee SPLIT itself, pinned: step 0 takes the initiation slice only.
                            ;;   This is the assertion that would catch the deterrent creeping back
                            ;;   into step 0 -- which is what RT-F-001 measured the cost of.
                            (expect "<<RT-A-001>> ...and step 0 takes only the initiation slice, not the deterrent"
                                (* discount 100.0) charged0)
                            ;;5] non-vacuity: the route really did DO something -- the pact ran to
                            ;;   completion and money moved, so this is a live add and not a call
                            ;;   that failed early.
                            (expect "<<RT-A-001>> ...and the route really executed, rather than failing early"
                                true (> total (* discount single-tx-flat)))
                        ]
                    )
                )
            )
        )
    )
    ""
)
(env-sigs [])
(commit-tx)
;;||>>>>>>>>>>>>>>>>>>>>>>>>>
;;|| NEXT                   >
;;||>>>>>>>>>>>>>>>>>>>>>>>>>
(begin-tx "RT-A-002 - the door that requires asymmetry is the one that does not tax it")
(env-gasmodel "table")(env-gaslimit 100000000)(env-gas 0)
(namespace "ouronet-ns")
;;==== RT-A-002 · 01 · two doors, two prices ====
(print "--- [RT-A-002 · 01 · two doors, two prices] ---")
;;<<RT-A-002>> FAMILY: A | STATUS: REFUSED
;;HYPOTHESIS: this looks exactly like RT-A-001 from the outside, which is why it was chased.
;;            `MTX|C_AddLiquidity` takes `asymmetric-collection` and `gaseous-collection`, and the
;;            CORE picks them per door -- the client only picks the door:
;;                C_AddStandardLiquidity -> true  true    (asymmetry tax ON)
;;                C_AddIcedLiquidity     -> false true    (asymmetry tax OFF)
;;                C_AddGlacialLiquidity  -> false false   (neither tax)
;;            All three branches then call the IDENTICAL function with IDENTICAL arguments --
;;            `ref-SWPL::XE_STOA-PID|AddLiquidity account swpair asymmetric-collection
;;            gaseous-collection stoa-pid ld clad` -- differing only in which capability is
;;            acquired. And inside SWPL the flag gates nothing but TAX COLLECTION. So: same
;;            operation, two prices, caller picks. That is RT-A-001's shape exactly.
;;            Worse, `UEV_AddChilledLiquidity` enforces
;;            "Chilled Liquidity can only be added when asymtric liquidity exists" -- so THE TWO
;;            DOORS THAT REQUIRE ASYMMETRY ARE EXACTLY THE TWO THAT DO NOT TAX IT.
;;METHOD:     drive the SAME asymmetric input through both doors and compare the IGNIS charged, then
;;            look for what the cheaper door takes instead.
;;RESULT:     REFUSED. The tax is not skipped, it is EXCHANGED FOR A LOCK. Step 2 of the pact reads
;;                (if (not asymmetric-collection)
;;                    (ref-VST::C_Freeze SWP|SC_NAME account lp-id secondary) ...)
;;            -- so the doors that skip the asymmetry tax hand back FROZEN LP, locked in VST, while
;;            the Standard door hands back free LP. The provider pays in liquidity instead of IGNIS.
;;            A coherent product trade-off, not a bypass.
;;
;;            WHY THIS BLOCK EXISTS ANYWAY. The two consequences of one flag -- "no tax" and "LP is
;;            frozen" -- live FORTY LINES AND ONE DEFPACT STEP APART, in different capabilities. The
;;            price and the thing paid for it are not visible together anywhere. If a future change
;;            ever removed or conditioned that freeze, the bypass would become real and nothing
;;            would notice, because no test asserts the two are coupled. This one does.
;;==== RT-A-002 - the door that requires asymmetry is the one that does not tax it · 01 · env-sigs (caps) ==== 
(print "--- [RT-A-002 - the door that requires asymmetry is the one that does not tax it · 01 · env-sigs (caps)] ---")
(env-sigs [{ "key": "PK_AncientHodler", "caps": [] }])
;;==== RT-A-002 - the door that requires asymmetry is the one that does not tax it · 02 · let / invocation ==== 
(print "--- [RT-A-002 - the door that requires asymmetry is the one that does not tax it · 02 · let / invocation] ---")
(let
    (
        (ref-SWPLC:module{SwapperLiquidityClientV2} SWPLC)
        (ref-SWP:module{SwapperV4} SWP)
        (patron:string KST.ANHD)
        (pool:string "S|DLK-98c486052a51|OURO-98c486052a51|DWK-98c486052a51")
        (amounts:[decimal] [10.0 10.0 10.0])
    )
    (let
        (
            (stoa-pid:decimal (U|CT.UR_STOA-PID|Price))
        )
        (let
            (
                ;;the tax the STANDARD door quotes for this exact asymmetric input
                ;;untyped on purpose: the Clad row shape is not a named member of
                ;;SwapperLiquidityV2, so annotating it fails to load.
                (tax:decimal
                    (at "total-ignis-tax-needed"
                        (ref-SWPLC::URCi_AddStandardLiquidityClad patron pool amounts stoa-pid)))
            )
            (map print
                [
                    (format "<<RT-A-002>> standard-door asymmetry tax = {} | frozen-LP enabled on pool = {}"
                        [tax (ref-SWP::UR_IzFrozenLP pool)])
                    ;;1] the STANDARD door really does charge an asymmetry tax on this input --
                    ;;   without this the comparison below is meaningless.
                    (expect "<<RT-A-002>> the STANDARD door charges a real asymmetry tax here"
                        true (> tax 0.0))
                    ;;2] THE COUPLING, asserted from the other side: the cheaper doors are not
                    ;;   available at all unless the pool has FROZEN LP enabled -- which is what
                    ;;   makes the lock deliverable. A pool without it cannot use the untaxed door,
                    ;;   so "untaxed" and "locked" cannot come apart by pool configuration.
                    ;;   NOTE WHERE THE REFUSAL LIVES. Step 0 of the Iced door SUCCEEDS and collects
                    ;;   the initiation fee -- `UEV_AddChilledLiquidity` runs in STEP 1, so the
                    ;;   caller learns the door is unavailable only after paying. That is the
                    ;;   RT-F-001 shape, and it is now the documented design (owner ruling: 100 at
                    ;;   step 0, the rest at the succeeding step).
                    (expect "<<RT-A-002>> step 0 of the untaxed door charges before it validates"
                        true (!= "" (TS01-CP.SWP|C_AddIcedLiquidity patron patron pool amounts)))
                    (expect-failure "<<RT-A-002>> ...and STEP 1 refuses it: no frozen LP, no untaxed door"
                        "Frozen LP Functionality is not enabled on Swpair"
                        (continue-pact 1))
                ]
            )
        )
    )
    ""
)
(print "===^^^===")
(env-sigs [])
(rollback-tx)

;;|| NEXT >
;;
(begin-tx "RT-A-003 - the share price has a singularity, and one of its two doors is unguarded")
(env-gasmodel "table")(env-gaslimit 100000000)(env-gas 0)
(namespace "ouronet-ns")
;;==== RT-A-003 · 01 · coil into a zero-index pool ====
(print "--- [RT-A-003 · 01 · coil into a zero-index pool] ---")
;;<<RT-A-003>> FAMILY: A | STATUS: FIXED
;;HYPOTHESIS: an ATS pool's index is a SHARE PRICE -- `floor(resident-sum / rbt-supply, p)` -- and
;;            `URC_RBT` inverts it to price a deposit: `floor(rt-amount / index, p-rbt)`. This was
;;            entered looking for the classic vault-inflation attack (tiny genesis supply, then
;;            donate to inflate the price against later depositors). Audit finding #11M already
;;            bounded the KickStart RATIO to [0.1, 100.0] for exactly that reason, and the RBT's
;;            24-decimal precision makes the remaining rounding loss (index x 10^-24 per coil)
;;            uneconomic to chase. But the same expression has a SINGULARITY the bound does not
;;            cover: `index = 0`, which is a reachable live state -- any pool whose reward-bearing
;;            token has supply MINTED OUTSIDE THE POOL reads resident-sum 0 against a positive
;;            rbt-supply. Five such pools exist at deploy (the AOZ primal assets).
;;METHOD:     measure the state first rather than assume it, then drive the real client entrypoint
;;            `TS01-C2::ATS|C_Coil` into it, and pin the refusal BY MESSAGE. The control is the
;;            SIBLING op: `ATS|C_Fuel` guards this identical state deliberately and says so.
;;RESULT:     CONFIRMED, then FIXED. The inflation attack itself is REFUSED on economics -- at 24
;;            decimals the per-coil rounding loss is index x 10^-24, so moving a real pool would
;;            take ~10^24 times its own supply in donated tokens. The SINGULARITY was live:
;;            `ATS|C_Coil` into a zero-index pool died with "Arithmetic exception: div by zero,
;;            decimal", through the real Talos client, on a pool that exists at deploy. The same
;;            call on the sibling op was refused cleanly by name. Repaired in 08_ATS.pact by
;;            enforcing (> index 0.0) inside `URC_RBT` -- the function that actually divides, and
;;            the one the INFO previews share, so a quote for an impossible coil now refuses in
;;            the same words instead of throwing. A healthy pool still prices normally.
;;
;;WHY THE SIBLING IS THE WHOLE POINT. `ATSU|C>FUEL` carries
;;    (enforce (>= index 0.1) "Fueling requires an ATS-Pair Index of at least 0.1")
;;and its comment block is unusually careful -- it was REWORDED on 2026-09-13 precisely so a caller
;;whose index is 0.05 is not told something untrue about their own pair. That much thought went
;;into the message of one guard, while `ATSU|C>COIL` -- the op an ordinary user actually reaches --
;;has NO index check at all and dies inside the arithmetic. The guard was not missing because the
;;state was unknown. It was missing on the door nobody looked at.
;;
(let*
    (
        (pool:string "Bisthanium-98c486052a51")
        (rt:string (at 0 (ouronet-ns.ATS.UR_RewardTokenList pool)))
        (healthy:string "ComatiCommand-98c486052a51")
        (h-rt:string (at 0 (ouronet-ns.ATS.UR_RewardTokenList healthy)))
    )
    (map print
        [
            ;;The precondition, MEASURED. A zero index is not a contrived input: it is what a
            ;;positive rbt-supply with a zero resident-sum evaluates to, and the AOZ primal-asset
            ;;pools are in that state from deploy.
            (expect
                (format "<<RT-A-003a>> {} is live and its index is ZERO: supply {} against resident-sum {}"
                    [pool (ouronet-ns.ATS.URC_PairRBTSupply pool) (ouronet-ns.ATS.URC_ResidentSum pool)])
                [0.0 true 0.0]
                [ (ouronet-ns.ATS.URC_Index pool)
                  (> (ouronet-ns.ATS.URC_PairRBTSupply pool) 0.0)
                  (ouronet-ns.ATS.URC_ResidentSum pool) ])
            ;;The sibling op ALREADY refuses this exact pool, with a message written with care.
            (expect-failure
                "<<RT-A-003b>> the SIBLING op, C_Fuel, refuses this very pool and says why"
                "Fueling requires an ATS-Pair Index of at least 0.1"
                (let ((r:module{TalosStageOne_ClientTwoV2} TS01-C2))
                    (r::ATS|C_Fuel KST.ANHD KST.ANHD pool rt 100.0)))
            ;;The door a user actually uses.
            (expect-failure
                "<<RT-A-003c>> ...and C_Coil must refuse it too, by a guard rather than by dividing"
                "Coiling requires an ATS-Pair Index greater than zero"
                (let ((r:module{TalosStageOne_ClientTwoV2} TS01-C2))
                    (r::ATS|C_Coil KST.ANHD KST.ANHD pool rt 100.0)))
            ;;The shared reader -- so the INFO preview of a coil refuses identically rather than
            ;;throwing an arithmetic exception at anyone asking for a quote.
            (expect-failure
                "<<RT-A-003d>> the shared pricing reader refuses it too, so a PREVIEW cannot throw"
                "Coiling requires an ATS-Pair Index greater than zero"
                (ouronet-ns.ATS.URC_RBT pool rt 100.0))
            ;;NON-VACUITY: the same reader on a HEALTHY pool prices normally. Without this, the
            ;;three refusals above are consistent with the reader simply being broken.
            (expect
                (format "<<RT-A-003e>> the same reader prices a HEALTHY pool (index {}) normally"
                    [(ouronet-ns.ATS.URC_Index healthy)])
                true
                (> (ouronet-ns.ATS.URC_RBT healthy h-rt 100.0) 0.0))
        ])
    ""
)
(print "")
(print "===^^^===")
(commit-tx)

;;|| NEXT >
;;
(begin-tx "RT-A-004 - execute a quote after the price has moved under it")
(env-gasmodel "table")(env-gaslimit 150000000)(env-gas 0)
(namespace "ouronet-ns")
;;==== RT-A-004 · 01 · stale quote, moved price ====
(print "--- [RT-A-004 · 01 · stale quote, moved price] ---")
;;<<RT-A-004>> FAMILY: A | STATUS: REFUSED
;;HYPOTHESIS: `UDC_SpawnSmartSwapSlippageBounds` quotes an expected output from the reserves AS THEY
;;            ARE WHEN IT RUNS, and the bound is then carried into `CC_SmartSwapWithSlippage` as
;;            plain data. If nothing re-checks it against live reserves at EXECUTION time, any trade
;;            landing in between settles the quoted swap at the worse rate -- the back half of a
;;            sandwich, whose cost to the attacker is an ordinary trade.
;;METHOD:     the quote is bound EAGERLY in the `let`, so it is taken before anything else in the
;;            block and is genuinely stale by the time the body runs. A swap in the same direction
;;            then moves the price. The quoted swap is then executed carrying the pre-move bound.
;;            The mover here is the same account, for fixture reasons -- the guard under test is
;;            indifferent to WHO moved the price, only to whether execution re-reads the reserves.
;;RESULT:     REFUSED. `UC_SlippageMinMax` derives the floor from the caller\'s OWN quoted expected
;;            output, and `19_SWPU.pact` checks `(>= feeless-final min)` against live reserves at
;;            execution -- the source calls it "the real protection this whole check exists for".
;;
;;WHY THIS BLOCK EXISTS AT ALL. That floor had NO witness before 2026-09-17. The only tests naming
;;"out of Slippage bounds" are the #26M pair in `[6.2+3]_DPTF-SWP_Issuance-Only.repl`, and BOTH assert
;;the message must NOT appear -- positive slippage is deliberately allowed, matching every major AMM.
;;So the most important economic guard in the AMM was asserted only in the direction that proves it
;;stays quiet. Deleting `(>= feeless-final min)` would have turned nothing in this tree red.
(env-sigs
    [
        { "key": "PK_AncientHodler", "caps": [] }
        { "key": "PK_AOZ", "caps": [] }
    ]
)
(let
    (
        (ref-SWPU:module{SwapperUsageV3} SWPU)
        (ref-DPTF:module{DemiourgosPactTrueFungibleV2} DPTF)
        (ref-TS01-C3:module{TalosStageOne_ClientThreeV4} TS01-C3)
        (trader:string KST.AOZT)
        (in-id:string "AKOSON-98c486052a51")
        (out-id:string "TUSD-98c486052a51")
    )
    (let
        (
            ;;THE QUOTE, taken BEFORE anything moves. Eager `let` is what makes this faithful rather
            ;;than a re-quote: the bound is fixed here and cannot refresh.
            (stale-bounds:object{SwapperUsageV3.Slippage}
                (ref-SWPU::UDC_SpawnSmartSwapSlippageBounds in-id 5.0 out-id 0.01))
        )
        ;;THE PRICE MOVE: an ordinary, permitted swap in the same direction, priced at its own live
        ;;quote so it cannot itself be the thing that fails.
        (print (format "<(RT-A-004 price move)> => \"{}\""
            [(ref-TS01-C3::SWP|CC_SmartSwapWithSlippage KST.ANHD trader in-id 5.0 out-id
                (ref-SWPU::UDC_SpawnSmartSwapSlippageBounds in-id 5.0 out-id 50.0))]))
        ;;G-46 IS FIXED, SO THIS ASSERTION CHANGED SHAPE -- and the history is the point.
        ;;When this block was first written the call RAISED `Array index out of bounds. Length (1),
        ;;Index (3)`, and the assertion was an `expect-failure` that deliberately pinned NO message:
        ;;pinning the fault text would have made the defect the expected behaviour and turned its
        ;;repair red, the inversion DEFECT-LEDGER 1.2 warns about. Root-caused since: the slippage
        ;;floor SOFT-FAILS -- it RETURNS a 1-element cumulator carrying the exceed-message -- and the
        ;;Talos wrapper indexed `(at 3 out)` unconditionally, destroying the message the guard had
        ;;already built. With the wrapper guarded, the call RETURNS the refusal instead of raising,
        ;;so `expect-failure` no longer applies and the message is finally worth pinning.
        (let
            (
                ;;Pact `let` evaluates its bindings IN ORDER, so these four are a timeline, not a
                ;;set. The two `-before` reads must happen AFTER the price move (which is itself a
                ;;real swap by this same trader and moves these balances) and BEFORE the attack.
                (in-before:decimal (ref-DPTF::UR_AccountSupply in-id trader))
                (out-before:decimal (ref-DPTF::UR_AccountSupply out-id trader))
                (result:string
                    (ref-TS01-C3::SWP|CC_SmartSwapWithSlippage KST.ANHD trader in-id 5.0 out-id stale-bounds))
                (in-after:decimal (ref-DPTF::UR_AccountSupply in-id trader))
                (out-after:decimal (ref-DPTF::UR_AccountSupply out-id trader))
            )
            (map print
                [
                    ;;ATTACK REFUSED, BY THE GUARD, IN ITS OWN WORDS.
                    (expect "<<RT-A-004>> ATTACK REFUSED: a stale quote is turned away by the slippage floor"
                        true (contains "out of Slippage bounds" result))
                    ;;...and it is the REFUSAL sentence, not a success sentence with the refusal
                    ;;interpolated into it. That distinction is not pedantic: it is exactly the
                    ;;defect G-47 found on the single/multi-swap doors, where the identical soft-fail
                    ;;payload was rendered as "Succesfully swapped input(s) to <refusal>".
                    (expect "<<RT-A-004>> ...and the wrapper does NOT report it as a success"
                        false (contains "Succesfully" result))
                    ;;THE REFUSAL IS TOTAL. The call now COMMITS rather than reverting, so "nothing
                    ;;moved" stopped being guaranteed by transaction rollback and has to be measured.
                    (expect "<<RT-A-004>> ...and the trader spent nothing"
                        in-before in-after)
                    (expect "<<RT-A-004>> ...and received nothing"
                        out-before out-after)
                ]
            )
        )
    )
    ""
)
(env-sigs [])
(rollback-tx)

;;|| NEXT >
;;
(begin-tx "RT-A-004b - the identical swap, price unmoved, must SUCCEED")
(env-gasmodel "table")(env-gaslimit 150000000)(env-gas 0)
(namespace "ouronet-ns")
;;==== RT-A-004 · 02 · the tolerance is not the reason ====
(print "--- [RT-A-004 · 02 · the tolerance is not the reason] ---")
;;THE NON-VACUITY HALF, and the block is worthless without it. A 0.01% tolerance refused could mean
;;"the price moved" or it could mean "0.01% is tighter than this route\'s own rounding". Only running
;;the identical swap, at the identical tolerance, with NOTHING moving in between, separates them.
(env-sigs
    [
        { "key": "PK_AncientHodler", "caps": [] }
        { "key": "PK_AOZ", "caps": [] }
    ]
)
(let
    (
        (ref-SWPU:module{SwapperUsageV3} SWPU)
        (ref-TS01-C3:module{TalosStageOne_ClientThreeV4} TS01-C3)
        (trader:string KST.AOZT)
        (in-id:string "AKOSON-98c486052a51")
        (out-id:string "TUSD-98c486052a51")
    )
    (let
        (
            (fresh-bounds:object{SwapperUsageV3.Slippage}
                (ref-SWPU::UDC_SpawnSmartSwapSlippageBounds in-id 5.0 out-id 0.01))
        )
        (map print
            [
                (expect "<<RT-A-004>> unmoved, the same swap at the same tolerance succeeds"
                    true (contains "Succesfully smart-swapped"
                        (ref-TS01-C3::SWP|CC_SmartSwapWithSlippage KST.ANHD trader in-id 5.0 out-id fresh-bounds)))
            ]
        )
    )
    ""
)
(env-sigs [])
(rollback-tx)

;;|| NEXT >
;;
(begin-tx "RT-A-005 - a refused swap that reported SUCCESS (G-47)")
(env-gasmodel "table")(env-gaslimit 150000000)(env-gas 0)
(namespace "ouronet-ns")
;;==== RT-A-005 · 01 · the single-swap door told the caller it had swapped ====
(print "--- [RT-A-005 · 01 · the single-swap door told the caller it had swapped] ---")
;;<<RT-A-005>> FAMILY: A | STATUS: FIXED
;;HYPOTHESIS: a swap refused by the slippage floor should tell the caller it was refused. Found
;;            while root-causing G-46: the smart-swap door faulted LOUDLY on a refused swap
;;            (`Array index out of bounds`), which raised the question of what the single- and
;;            multi-swap doors -- carrying the identical soft-fail payload -- do instead.
;;METHOD:     drive `SWP|C_SingleSwapWithSlippage` with an unreachable expected output (1,000,000)
;;            so the floor must refuse, then read the returned string and both trader balances.
;;            Not an adversarial input: this is the ORDINARY refusal path, and the finding is what
;;            the protocol SAYS when it refuses.
;;RESULT:     FIXED. On shipped code it answered "Succesfully swapped input(s) to <the refusal
;;            message>", committed, and emitted a swap event, having moved nothing.
;;THE DEFECT: `SWPU`'s slippage floor SOFT-FAILS -- it RETURNS a one-element cumulator carrying
;;            the exceed-message instead of raising. On the smart-swap door the success payload has
;;            four elements, so `(at 3 out)` on a refusal raised `Array index out of bounds` (G-46,
;;            fixed). On THESE doors the success payload is also ONE element -- `[o-id-netto]`, a
;;            decimal -- so `(at 0 out)` did not fault. It silently interpolated the refusal text
;;            into a sentence beginning "Succesfully swapped".
;;
;;            Measured on shipped code before the fix, verbatim:
;;              "Succesfully swapped input(s) to Expected Output of 2366.80... out of Slippage
;;               bounds min of 990000.0 - max of 1010000.0 OURO-98c486052a51"
;;
;;            The transaction COMMITS. The swap `@event` has already fired -- it sits on the
;;            `with-capability`, ahead of the floor check -- so an off-chain indexer sees a swap
;;            event and a success string for a swap that never happened. Zero in, zero out.
;;
;;WHY LENGTH CANNOT FIX IT: on this door BOTH payloads are one element. The refusal is a string,
;;            the success a decimal, so the TYPE is the only discriminator -- which is why the
;;            repair here differs from G-46's `(= (length out) 4)` even though the cause is shared.
;;
;;THE ASSERTION THAT IS THE REGRESSION is the second one. Before the fix `(contains "Succesfully"
;;            result)` was TRUE on a swap that moved nothing. Everything else here would have passed
;;            on the defective code.
(env-sigs [{ "key": "PK_AncientHodler", "caps": [] }])
(let
    (
        (ref-SWPU:module{SwapperUsageV3} SWPU)
        (ref-DPTF:module{DemiourgosPactTrueFungibleV2} DPTF)
        (ref-TS01-C3:module{TalosStageOne_ClientThreeV4} TS01-C3)
        (trader:string KST.ANHD)
        (in-id:string "EURT-98c486052a51")
        (out-id:string "OURO-98c486052a51")
        (pool:string "W|OURO-98c486052a51|TEUR-98c486052a51|EURT-98c486052a51|EURC-98c486052a51|EURD-98c486052a51|AEUR-98c486052a51|CEUR-98c486052a51")
    )
    (let
        (
            ;;Ordered: the two `-before` reads must precede the call. An unreachable expected output
            ;;of 1,000,000 puts the floor permanently out of range, so the guard must refuse.
            (in-before:decimal (ref-DPTF::UR_AccountSupply in-id trader))
            (out-before:decimal (ref-DPTF::UR_AccountSupply out-id trader))
            (result:string
                (ref-TS01-C3::SWP|C_SingleSwapWithSlippage trader trader pool in-id 2400.0 out-id
                    (ref-SWPU::UDC_Slippage 1000000.0 12 1.0)))
            (in-after:decimal (ref-DPTF::UR_AccountSupply in-id trader))
            (out-after:decimal (ref-DPTF::UR_AccountSupply out-id trader))
        )
        (map print
            [
                (expect "<<RT-A-005>> the floor refuses, and says so in its own words"
                    true (contains "out of Slippage bounds" result))
                ;;THE REGRESSION. This was TRUE on shipped code, for a swap that moved nothing.
                (expect "<<RT-A-005>> ...and the wrapper does NOT call that refusal a success"
                    false (contains "Succesfully" result))
                ;;Nothing moved -- measured, not assumed, because the call COMMITS rather than
                ;;reverting, so transaction rollback guarantees nothing here.
                (expect "<<RT-A-005>> ...the trader spent nothing" in-before in-after)
                (expect "<<RT-A-005>> ...and received nothing" out-before out-after)
            ]
        )
    )
    ""
)
(env-sigs [])
(rollback-tx)

;;|| NEXT >
;;
(begin-tx "RT-A-005b - the same door, with a reachable floor, must SUCCEED")
(env-gasmodel "table")(env-gaslimit 150000000)(env-gas 0)
(namespace "ouronet-ns")
;;==== RT-A-005 · 02 · non-vacuity ====
(print "--- [RT-A-005 · 02 · non-vacuity] ---")
;;Without this half, RT-A-005 would pass if `C_SingleSwapWithSlippage` were broken outright -- a
;;wrapper that returned "Swap not executed" unconditionally satisfies every assertion above.
(env-sigs [{ "key": "PK_AncientHodler", "caps": [] }])
(let
    (
        (ref-SWPU:module{SwapperUsageV3} SWPU)
        (ref-DPTF:module{DemiourgosPactTrueFungibleV2} DPTF)
        (ref-TS01-C3:module{TalosStageOne_ClientThreeV4} TS01-C3)
        (trader:string KST.ANHD)
        (out-id:string "OURO-98c486052a51")
        (pool:string "W|OURO-98c486052a51|TEUR-98c486052a51|EURT-98c486052a51|EURC-98c486052a51|EURD-98c486052a51|AEUR-98c486052a51|CEUR-98c486052a51")
    )
    (let
        (
            (out-before:decimal (ref-DPTF::UR_AccountSupply out-id trader))
            ;;A 1.0 expected output at the maximum permitted 50% tolerance puts the floor at 0.5 --
            ;;satisfiable by any sane execution, so only a genuinely broken door could fail here.
            ;;(50.0 is the ceiling: `UEV_Slippage` enforces 0.0 < slippage <= 50.0, or -1.0.)
            (result:string
                (ref-TS01-C3::SWP|C_SingleSwapWithSlippage trader trader pool
                    "EURT-98c486052a51" 2400.0 out-id (ref-SWPU::UDC_Slippage 1.0 12 50.0)))
        )
        (map print
            [
                (expect "<<RT-A-005>> with a reachable floor, the identical door swaps"
                    true (contains "Succesfully swapped" result))
                (expect "<<RT-A-005>> ...and the trader actually received something"
                    true (> (ref-DPTF::UR_AccountSupply out-id trader) out-before))
            ]
        )
    )
    ""
)
(env-sigs [])
(rollback-tx)
