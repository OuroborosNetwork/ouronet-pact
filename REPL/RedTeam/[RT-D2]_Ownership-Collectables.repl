(print "")
;;
;; REPL/RedTeam/[RT-D2]_Ownership-Collectables.repl — FAMILY D: ownership bypass, Stage 2.
;;
;; "Can I act on assets whose ownership I have not proven?"
;;
;; [RT-D]_Ownership.repl asks that of Stage 1, where the interesting shape is `patron` vs `account`.
;; Stage 2 has a different one. A DPNF (NFT) nonce does not record WHO holds it — it records an
;; ELEVEN-CHARACTER ABBREVIATION of who holds it, and an abbreviation is not an identity.
;;
;; Legend:
;;   <<RT-D-002a>>  the real holder passes            (the gate is not simply "always true")
;;   <<RT-D-002b>>  an unrelated account is refused   (the gate is not simply "always false")
;;   <<RT-D-002c>>  the collider is a VALID, DISTINCT account with an IDENTICAL abbreviation
;;   <<RT-D-002d>>  the collider is refused           (the finding)
;;   <<RT-D-002e>>  ...BY THE FULL-ACCOUNT CHECK      (pinned by message)
;;   <<RT-D-002f>>  the ORIGINAL check keeps its ORIGINAL message for everyone else
;;
;; The tail of this file asks a THIRD version of the same question, of the AQP vacate surface,
;; where the shape is neither `patron` vs `account` nor an abbreviation but a SHADOW: three
;; `VCT|C>*` capabilities call `CAP_VctVacatePoolOwner` only AFTER a four- or five-conjunct
;; business `enforce`, so every negative ever written for them was refused by the business rule
;; and the ownership line had never once been seen refusing anybody (DEFECT-LEDGER 7.2h). The
;; remedy is a FIXTURE that satisfies the earlier conjuncts, never a reorder.
;;
;;   <<RT-D-005*>>  VCT|C>TRUE-FUNGIBLE-VACATE        (TfStakePool — a SMART-account owner konto)
;;   <<RT-D-006*>>  VCT|C>ORTO-FUNGIBLE-VACATE-BATCH  (OfStakePool — attacker vacates her OWN leg)
;;   <<RT-D-007*>>  VCT|C>COLLECTABLE-VACATE-BATCH    (NfSyncPool + SfStakePool, both branches)
;;
;;   ...a  the checks that run BEFORE the gate are all satisfied  (the fixture, asserted)
;;   ...b  the attacker demonstrably does not own the pool
;;   ...c  THE ATTACK, refused, pinned by the VICTIM's key or konto
;;   ...d  the fast-drain twin on the same defcap, refused identically
;;   ...e  the gate ALONE produces that exact refusal                 (attribution)
;;   ...f/g/h/i  NON-VACUITY: one added signature, same call, it succeeds
;;
;; Source: 1_SOVEREIGN/STAGE_02/2_Core/01_DPDC/02_DPDC.pact  (UEV_NonceQuantityInclusion)
;;         1_SOVEREIGN/STAGE_01/2_Core/02_IGNIS.pact         (OI|UC_ShortAccount)
;;         1_SOVEREIGN/STAGE_01/1_Utilities/08_U_DALOS.pact  (GLYPH|UEV_DalosAccount)
;;         1_SOVEREIGN/STAGE_02/2_Core/03_AQP/06_VCT.pact    (the three VCT|C>* vacate caps,
;;                                                            CAP_VctVacatePoolOwner)
;;         1_SOVEREIGN/STAGE_01/2_Core/01_DALOS.pact         (CAP_EnforceAccountOwnership —
;;                                                            BOTH halves, standard and smart)
;;         1_SOVEREIGN/STAGE_02/3_Talos/04_TS02-C3.pact      (AQP-POOL|CCp_Batch* wrappers)
;;
;; REPL tests: <<RT-D-002a>> <<RT-D-002b>> <<RT-D-002c>> <<RT-D-002d>> <<RT-D-002e>> <<RT-D-002f>>
;;             <<RT-D-005a>>..<<RT-D-005g>>  <<RT-D-006a>>..<<RT-D-006g>>
;;             <<RT-D-007a>>..<<RT-D-007i>>
;;
;; Run: cd REPL && pact "RedTeam/[RT-D2]_Ownership-Collectables.repl"
;;
(load "../deploy-stage00.repl")
(load "../deploy-stage01.repl")
(load "../deploy-stage02.repl")
(load "../Stage_02/[6.1.4]_DPDC-NF.repl")

;;|| NEXT >
;;
(begin-tx "RT-D-002 - an abbreviation is not an identity")
(env-gasmodel "table")(env-gaslimit 100000000)(env-gas 0)
;;==== RT-D-002 - an abbreviation is not an identity · 01 · namespace ==== ========================
(print "--- [RT-D-002 - an abbreviation is not an identity · 01 · namespace] ---")
(namespace "ouronet-ns")
;;==== RT-D-002 · 01 · two different accounts, one stored holder ====
(print "--- [RT-D-002 · 01 · two different accounts, one stored holder] ---")
;;<<RT-D-002>> FAMILY: D | STATUS: FIXED
;;HYPOTHESIS: `DPDC|NonceElement.nonce-holder` is documented as "Stores the <OuronetAccount>
;;            holding the Nonce". It does not. `XE_U|NonceHolder` writes
;;            `OI|UC_ShortAccount(account)` = `(take 5) + "..." + (take -3)` -- ELEVEN characters,
;;            of which the first two are the fixed `Ѻ.` prefix, leaving SIX characters of entropy.
;;            `UEV_NonceQuantityInclusion` -- the possession gate inside `DPDC-C|C>SINGLE-DEBIT`,
;;            which guards every NFT debit, burn and transfer -- decides possession by comparing
;;            that abbreviation. If two valid accounts can share it, the gate cannot tell them
;;            apart, and the one that does NOT hold the NFT passes the check that exists to stop it.
;;METHOD:     construct a second account that is glyph-valid, exactly 162 characters, DISTINCT from
;;            the holder, and shares its first three and last three body characters. No grinding is
;;            involved and none is needed: `GLYPH|UEV_DalosAccount` enforces length, the `Ѻ`/`Σ`
;;            prefix, the `.` separator and the DALOS|CHARSET -- and NOTHING ELSE. The account
;;            string is not derived from the guard, so it is chosen freely by whoever deploys it.
;;            Then call the gate directly with three accounts: the true holder, an unrelated
;;            account, and the collider.
;;RESULT:     CONFIRMED, then FIXED. Measured exploit-first, all three arms in one run: the true
;;            holder PASSES, an unrelated account is REFUSED -- so the gate is neither always-true
;;            nor always-false -- and the collider, a distinct glyph-valid 162-character account,
;;            PASSES. Repaired in 02_DPDC.pact by enforcing `amount <= nonce-supply` on the NFT
;;            branch, where `nonce-supply` is the AccountSupplies read keyed by the COMPLETE
;;            account string and was already bound, unused, at the top of the function. The
;;            abbreviation compare is kept, with its own message, because it also carries the
;;            "nonce is active" meaning -- an inactivated NFT stores BAR there.
;;
;;WHY THE `patron`/`account` SPLIT DOES NOT SAVE THIS. `DPDC-C|C>SINGLE-DEBIT` gates with
;;`CAP_EnforceAccountOwnership account` -- so the caller must genuinely own the account they name.
;;An attacker naming their OWN colliding account satisfies that completely. The second gate, the
;;one that is supposed to establish that this account holds THIS NFT, is the abbreviation compare.
;;And `DALOS|C_DeployStandardAccount` is a permissionless CLIENT wrapper on TS01-C1, whose STOA fee
;;is itself toggle-conditional -- so the colliding account costs nothing to obtain.
;;
;;WHAT THE FUNCTION ALREADY HAD. `UEV_NonceQuantityInclusion` opens by binding
;;`(nonce-supply (UR_AccountNonceSupply account id son nonce))` -- a read keyed by the FULL account
;;string. The SFT branch enforces against it. The NFT branch BINDS IT AND NEVER USES IT. The fix is
;;not new machinery; it is spending the value the function already computed.
;;
(let*
    (
        (id:string "CNF-98c486052a51")
        (nonce:integer 2)
        (ref-I|OURONET:module{OuronetInfoV2} IGNIS)
        (ref-U|DALOS:module{UtilityDalosGlyphsV3} U|DALOS)
        ;;Built exactly as an attacker would: the holder's first three and last three body
        ;;characters, with 154 characters of another real account's body in between -- which
        ;;guarantees they are in DALOS|CHARSET without needing to reproduce the charset here.
        (collider:string "Ѻ.éXøьπΨтÎșπЦĐđŽ6ЫêÀεÅĐȘдÞЩ4Ł2ďй5žömiτsλÚÇдěÒaV₱ÏûιЩД₳îJÍşыyÜŹżęìvAЙsÄ¢ÿnΦIťQůЮ7ĄвaèďíoáнõÎLJθÆEáПiXÿÒÀĘ14цU1çΞêSťüIψчèι₱ê9ŽчΓüЦrÀÓμĆ99κQťqPÖшŮ1ÈČSĐŁÌбÝàŞbPσŃĎÌàî")
        (try-gate (lambda (acct:string)
            (try "REFUSED" (let ((z:string "PASSES"))
                (ouronet-ns.DPDC.UEV_NonceQuantityInclusion acct id false nonce 1) z))))
    )
    (map print
        [
            (expect
                (format "<<RT-D-002a>> the TRUE holder of {} nonce {} passes the possession gate" [id nonce])
                "PASSES" (try-gate KST.ANHD))
            (expect
                "<<RT-D-002b>> an unrelated account is refused -- the gate is not vacuous"
                "REFUSED" (try-gate KST.EMMA))
            (expect
                (format "<<RT-D-002c>> the collider is a VALID, DISTINCT account whose stored abbreviation is identical: [{}]"
                    [(ref-I|OURONET::OI|UC_ShortAccount collider)])
                [true 162 false true]
                [ (ref-U|DALOS::GLYPH|UEV_DalosAccountCheck collider)
                  (length collider)
                  (= collider KST.ANHD)
                  (= (ref-I|OURONET::OI|UC_ShortAccount collider)
                     (ouronet-ns.DPDC.UR_NonceHolder id false nonce)) ])
            (expect
                "<<RT-D-002d>> the collider does NOT hold the NFT and must be refused"
                "REFUSED" (try-gate collider))
            ;;Pinned BY MESSAGE, because a refusal by the wrong guard is indistinguishable from a
            ;;refusal by the right one (RT-C-001). The collider passes the abbreviation compare --
            ;;that is the whole finding -- so the ONLY check that can refuse it is the full-account
            ;;one. Delete that check and this goes red even if some other guard starts refusing.
            (expect-failure
                "<<RT-D-002e>> ...and it is the FULL-ACCOUNT check that refuses it, not the abbreviation compare"
                "is not the full-account holder of NFT"
                (ouronet-ns.DPDC.UEV_NonceQuantityInclusion collider id false nonce 1))
            (expect-failure
                "<<RT-D-002f>> an unrelated account still trips the ORIGINAL check, with its ORIGINAL message"
                "doesnt hold NFT"
                (ouronet-ns.DPDC.UEV_NonceQuantityInclusion KST.EMMA id false nonce 1))
        ])
    ""
)
(print "")
(print "===^^^===")
(commit-tx)

;;|| NEXT >
;;
(begin-tx "RT-K-004 - the collectable family: a role reported on a collection that does not exist")
(env-gasmodel "table")(env-gaslimit 100000000)(env-gas 0)
(namespace "ouronet-ns")
;;==== RT-K-004 - the collectable family: a role reported on a collection that does not exist · 01 · env-sigs (caps) ==== 
(print "--- [RT-K-004 - the collectable family: a role reported on a collection that does not exist · 01 · env-sigs (caps)] ---")
(env-sigs [ { "key": "PK_AncientHodler", "caps": [] } { "key": "PK_Emma", "caps": [] } ])
;;==== RT-K-004 · 01 · DPDC preview vs exec at a collection that does not exist ====
(print "--- [RT-K-004 · 01 · DPDC preview vs exec at a collection that does not exist] ---")
;;<<RT-K-004>> FAMILY: K | STATUS: FIXED
;;HYPOTHESIS: fourth family swept for refusal parity. Five DPDC ops, preview against exec, driven at
;;            a collection id that does not exist.
;;METHOD:     as RT-K-001/002/003 -- one input, both paths, compare the message.
;;RESULT:     CONFIRMED, then FIXED -- one divergence of five, and it exposed an EXEC diagnosis bug
;;            as well. The preview died on a raw properties read; the exec answered cleanly but
;;            about a ROLE ON A COLLECTION IT HAD NOT ESTABLISHED EXISTS. `UEV_id` -- which DPDC
;;            already has -- now runs FIRST in DPDC-MNG|C>BURN-NFT and is called by the preview,
;;            so both say "DPNF ID <id> does not exist". A real collection still quotes normally.
;;
;;THE SWEEP: three of five in parity (DPNF/DPSF TogglePause, DPNF ToggleBurnRole -- both paths give
;;the same raw properties-table read). One mismatch of internals, recorded not fixed: DPNF
;;MoveCreateRole's preview names `DPNF|T|Properties` while its exec names `DPNF|T|VerumRoles` --
;;both refuse, both rawly, and they disagree only about WHICH table they failed to read. That is the
;;same shared-raw-wording gap recorded for DPTF|C_Transfer in DEFECT-LEDGER 7.3.
;;
;;AND ONE REAL DIVERGENCE, which also turned out to be an EXEC diagnosis bug:
;;
;;   preview  raw `No value found in table ouronet-ns.DPDC_DPNF|T|Properties for key: ...`
;;   exec     clean, but WRONG ABOUT WHY:
;;            "NFT Burn Role for NOSUCHCOL-98c486052a51 on Account ... must be set to true for exec"
;;
;;The op answered about a ROLE ON A COLLECTION IT HAD NOT ESTABLISHED EXISTS. That message is true
;;and useless: there is no collection to hold a role on. `DPDC-MNG|C>BURN-NFT` checked the role
;;before existence, so `UEV_id` -- which DPDC already has, and which yields
;;"DPNF ID <id> does not exist" -- never got the chance to say the useful thing.
;;
;;WHY THE PREVIEW GOT ONLY THE STRUCTURAL CHECK, and not the role check its exec also runs: family
;;K's rule from RT-K-002 is that a preview validates what the caller CANNOT change (the collection
;;does not exist) and not what they can (a role they may be granted between quote and submission).
;;Mirroring the role check would have bought message parity at the cost of turning 401 cost quotes
;;into dry runs, which was decided against.
;;
;;==== RT-K-004 - the collectable family: a role reported on a collection that does not exist · 02 · let / invocation ==== 
(print "--- [RT-K-004 - the collectable family: a role reported on a collection that does not exist · 02 · let / invocation] ---")
(let
    (
        (bad:string "NOSUCHCOL-98c486052a51")
        (real:string "CNF-98c486052a51")
        (r2:module{TalosStageTwo_ClientTwoV2} TS02-C2)
    )
    (map print
        [
            (expect-failure
                "<<RT-K-004a>> Burn · PREVIEW refuses a collection that does not exist"
                "DPNF ID NOSUCHCOL-98c486052a51 does not exist"
                (ouronet-ns.INFO-TWO.INFO_DPNF|Burn KST.ANHD bad KST.ANHD 1))
            (expect-failure
                "<<RT-K-004b>> Burn · EXEC   (same message -- and no longer a role report on nothing)"
                "DPNF ID NOSUCHCOL-98c486052a51 does not exist"
                (r2::DPNF|C_Burn KST.ANHD KST.ANHD bad 1))
            ;;NON-VACUITY: the guard must not have turned the preview into one that always refuses.
            (expect
                (format "<<RT-K-004c>> ...and the preview still QUOTES the real collection {}" [real])
                true
                (> (at "ignis-need" (at "ignis"
                      (ouronet-ns.INFO-TWO.INFO_DPNF|Burn KST.ANHD real KST.ANHD 2))) 0.0))
            ;;THE NEGATIVE HALF, pinned as parity and not as wording.
            (expect-failure
                "<<RT-K-004d>> TogglePause · PREVIEW and EXEC agree (parity pinned, wording not blessed)"
                "DPNF|T|Properties"
                (ouronet-ns.INFO-TWO.INFO_DPNF|TogglePause KST.ANHD bad true))
            (expect-failure
                "<<RT-K-004d>> TogglePause · EXEC   (same failure as the preview)"
                "DPNF|T|Properties"
                (r2::DPNF|C_TogglePause KST.ANHD (DPDC.UR_OwnerKonto bad false) bad true))
        ])
    ""
)
(env-sigs [])
(print "")
(print "===^^^===")
(commit-tx)

;;|| NEXT >
;;
(begin-tx "RT-K-007 - a third guard that existed and could not run")
(env-gasmodel "table")(env-gaslimit 100000000)(env-gas 0)
(namespace "ouronet-ns")
;;==== RT-K-007 - a third guard that existed and could not run · 01 · env-sigs (caps) ==== ========
(print "--- [RT-K-007 - a third guard that existed and could not run · 01 · env-sigs (caps)] ---")
(env-sigs [ { "key": "PK_AncientHodler", "caps": [] } ])
;;==== RT-K-007 · 01 · AQP anchors: the validator beneath a bare read ====
(print "--- [RT-K-007 · 01 · AQP anchors: the validator beneath a bare read] ---")
;;<<RT-K-007>> FAMILY: K | STATUS: FIXED
;;HYPOTHESIS: seventh surface -- the AQP readers, the most derived cost logic in the codebase.
;;METHOD:     three ops driven at an id that does not exist (RevokeAnchor, RotateScoreOwnership,
;;            ControlScore). The last two were already in parity. RevokeAnchor was not, and chasing
;;            it reached something better than a preview defect.
;;RESULT:     CONFIRMED, then FIXED on the exec side, and the preview half is RECORDED with its
;;            reason. The exec's refusal for a non-existent anchor moved from
;;            `No value found in table ouronet-ns.AQP-ANK_ANK|T|Anchor for key: <id>` to
;;            `Anchor <id> must be alive for operation` -- the sentence UEV_LiveAnchor was written
;;            to say and could never reach. Two of the three ops swept were already in parity.
;;
;;`UEV_LiveAnchor` EXISTS AND IS WRITTEN FOR EXACTLY THIS INPUT:
;;
;;    (enforce iz-anchor-active (format "Anchor {} must be alive for operation" [anchor-id]))
;;
;;It could not deliver that sentence. `iz-anchor-active` comes from `UR_ANK|State`, which was a bare
;;`read` -- so for an anchor that does not exist the raw
;;`No value found in table ouronet-ns.AQP-ANK_ANK|T|Anchor for key: <id>` fired one line earlier,
;;every time. The validator was reachable for anchors that exist and unreachable for the only input
;;that needed it.
;;
;;THIRD INSTANCE OF ONE SHAPE, and the first where the obstruction was a READER rather than an eager
;;`let`: C_Recover (2026-09-12) and C_HotRecovery (RT-H-003) had their capability below the bindings;
;;C_DeployAccount (RT-K-003) had its check below the bindings; here the check is in the right place
;;and the value it reads raises before it can be tested. Same lesson from a new direction: A GUARD
;;BEING PRESENT IS NOT A GUARD BEING REACHABLE, and `grep` cannot tell the two apart.
;;
;;Fixed by defaulting `UR_ANK|State` -- an anchor that does not exist is not active, which is what
;;both of its callers mean by the question (the other, an anchor filter, already screens BAR and
;;wants false for anything not alive). Same shape as DPTF's `UEV_id`, which defaults <supply> to
;;-1.0 for exactly this reason.
;;
;;THE PREVIEW HALF IS RECORDED, NOT FIXED, and DEFECT-LEDGER 7.3 carries the reason:
;;`INFO_AQP-ANK|RevokeAnchor` still quotes a revoke of an anchor that never existed, post-text
;;"Anchor <id> revoked." Guarding it is a two-line change, and it breaks
;;`[6.5]_AQP-INFO.repl` -- a DELIBERATELY FIXTURE-FREE cost-shape suite that passes arbitrary ids
;;("ANK-x", "DPTF-x", "BC-x") to all 83 AQP readers on the sound principle that AQP prices are
;;ARGUMENT-INDEPENDENT. Making AQP previews validate ids would require anchor, score and boost-class
;;fixtures for every one of them. That is a real piece of work with a real design question inside it,
;;and it is not something to smuggle in behind a one-line commit.
;;
;;==== RT-K-007 - a third guard that existed and could not run · 02 · let / invocation ==== =======
(print "--- [RT-K-007 - a third guard that existed and could not run · 02 · let / invocation] ---")
(let
    (
        (bad:string "NOSUCHANK-98c486052a51")
        (other:string "ALSONOSUCHANK-98c486052a51")
        (r:module{TalosStageTwo_ClientThreeV1} TS02-C3)
    )
    (map print
        [
            (expect-failure
                "<<RT-K-007a>> RevokeAnchor refuses BY NAME, not with a raw table read"
                "Anchor NOSUCHANK-98c486052a51 must be alive for operation"
                (r::AQP-ANK|C_RevokeAnchor KST.ANHD KST.ANHD bad))
            ;;NON-VACUITY: the message must be DERIVED FROM THE ARGUMENT, not a constant that any
            ;;input would produce. A second id must appear in its own refusal.
            (expect-failure
                "<<RT-K-007b>> ...and the refusal names the id it was given, so it is not a constant"
                "Anchor ALSONOSUCHANK-98c486052a51 must be alive for operation"
                (r::AQP-ANK|C_RevokeAnchor KST.ANHD KST.ANHD other))
            ;;And the defaulted reader answers the question directly, rather than raising.
            (expect
                "<<RT-K-007c>> UR_ANK|State on a non-existent anchor is FALSE, not an exception"
                false (ouronet-ns.AQP-ANK.UR_ANK|State bad))
        ])
    ""
)
(env-sigs [])
(print "")
(print "===^^^===")
(commit-tx)

;;|| NEXT >
;;
(begin-tx "RT-D-004 - the same theft, one collectable nonce")
(env-gasmodel "table")(env-gaslimit 100000000)(env-gas 0)
(namespace "ouronet-ns")
;;==== RT-D-004 · 01 · collectable transfer, patron is not owner ====
(print "--- [RT-D-004 · 01 · collectable transfer, patron is not owner] ---")
;;<<RT-D-004>> FAMILY: D | STATUS: REFUSED
;;HYPOTHESIS: RT-D-001 and RT-D-003 shut the two TRUE-FUNGIBLE doors. The collectable family has
;;            its own, and it does not share their code: `DPNF|C_TransferNonce` reaches
;;            `DPDC-T|C>TRANSFER`, not `DPTF|C>X-TRANSFER` or `DPTF|C>DEBIT`. So the question has
;;            to be asked again rather than inferred -- the same patron/owner split, on the one
;;            family where possession is tracked per NONCE instead of per balance.
;;METHOD:     the attacker is patron AND receiver, the victim is sender, only the attacker signs.
;;            The nonce is one RT-D-002 already proved the victim holds -- it passes that block's
;;            possession gate as the TRUE holder -- so possession cannot be what refuses this, and
;;            ownership is the only thing left.
;;RESULT:     REFUSED at the owner gate, naming the victim's key.
;;==== RT-D-004 - the same theft, one collectable nonce · 01 · env-sigs (caps) ==== ===============
(print "--- [RT-D-004 - the same theft, one collectable nonce · 01 · env-sigs (caps)] ---")
(env-sigs [{ "key": "PK_Emma", "caps": [] }])
;;==== RT-D-004 - the same theft, one collectable nonce · 02 · let / invocation ==== ==============
(print "--- [RT-D-004 - the same theft, one collectable nonce · 02 · let / invocation] ---")
(let
    (
        (ref-DPDC:module{DpdcV2} DPDC)
        (ref-TS02-C2:module{TalosStageTwo_ClientTwoV2} TS02-C2)
        (ref-TS02-C1:module{TalosStageTwo_ClientOneV2} TS02-C1)
        (id:string "CNF-98c486052a51")
        (nonce:integer 2)
        (attacker:string KST.EMMA)
        (victim:string KST.ANHD)
    )
    (map print
        [
            ;;THE ATTACK. Message pinned: an unqualified refusal on a collectable op could be the
            ;;possession gate, a pause state, a freeze or a missing transfer role -- and RT-D-002
            ;;exists precisely because the possession gate on this family was once wrong.
            ;;The VICTIM's key is named, not merely "a keyset failed": that is what separates
            ;;"the owner gate refused" from "the attacker's own signature was somehow rejected",
            ;;which would pass an unqualified match while proving the opposite.
            (expect-failure "<<RT-D-004>> ATTACK REFUSED: holding the nonce is the victim's, not the payer's"
                "Keyset failure (keys-all): [PK_Ancie...]"
                (ref-TS02-C2::DPNF|C_TransferNonce attacker victim attacker id nonce 1 false))
            ;;...and the nonce did not move: the victim still passes the possession gate afterwards.
            ;;THE PLURAL DOOR, a separate defcap with its own `CAP_EnforceAccountOwnership sender`.
            ;;The singular assertion above says nothing about it. Unlike the singular collectable
            ;;door, this one checks ownership BEFORE its list-shape fold, so the batch below is
            ;;well-formed only so that a shape error cannot be mistaken for the refusal under test.
            (expect-failure "<<RT-D-004>> ...nor in bulk, which is a separate gate"
                "Keyset failure (keys-all): [PK_Ancie...]"
                (ref-TS02-C1::DPDC|C_BulkTransfer attacker victim [attacker] id false [[nonce]] [[1]] false))
            (expect "<<RT-D-004>> ...and the victim still holds the nonce"
                true (> (ref-DPDC::UR_AccountNonceSupply victim id false nonce) 0))
        ]
    )
    ""
)
(env-sigs [])
(rollback-tx)

;;|| NEXT >
;;
;; ============================================================================================
;; THE VCT VACATE OWNER GATES — fixture chain, loaded HERE and not at the top of the file.
;; ============================================================================================
;; The three attacks below need a live AQP pool with live staked legs, which the DPDC chain above
;; does not provide. The four AQP suites are therefore loaded at this point, AFTER every existing
;; assertion in this file has already run, so that nothing they mutate (OURO anchors, MVST/DHCD/DHB
;; nonces, pool trackers) can move a fixture RT-D-002 / RT-K-004 / RT-K-007 / RT-D-004 depend on.
;; Loading them at the top would have been tidier and would have put four suites' worth of state
;; changes upstream of six assertions that were green before this block existed.
;;
;; Cost measured: the file goes from ~7s to ~12s. [6.2.5]_AQP-VCT is deliberately NOT loaded — it
;; DRAINS these pools, and an empty pool cannot satisfy the leg checks the attacks must satisfy.
;;
;;==== RT-D-004 - the same theft, one collectable nonce · 03 · load module ==== ===================
(print "--- [RT-D-004 - the same theft, one collectable nonce · 03 · load module] ---")
(load "../Stage_02/[6.2.1]_AQP-ANK.repl")
(load "../Stage_02/[6.2.2]_AQP-SCORE.repl")
(load "../Stage_02/[6.2.3]_AQP-POOL.repl")
(load "../Stage_02/[6.2.4]_AQP-FVT.repl")

;;|| NEXT >
;;
(begin-tx "RT-D-VCT-FIXTURE - live legs for the three vacate gates")
(env-gasmodel "table")(env-gaslimit 100000000)(env-gas 0)
(namespace "ouronet-ns")
;;==== RT-D-VCT-FIXTURE · 01 · stake the legs the gates will be driven against ====
(print "--- [RT-D-VCT-FIXTURE · 01 · stake the legs the gates will be driven against] ---")
;;NOT AN ATTACK — the fixture the three attacks below are built on, and the reason they are not
;;vacuous. Each gate's defcap runs a business `enforce` BEFORE its ownership call, and that enforce
;;is satisfied only by a leg that really is staked, for exactly its full tracker balance, in a pool
;;of the right class holding the right asset. A batch that fails any of those is turned away by the
;;business rule and never reaches the owner gate at all — which is the precise trap DEFECT-LEDGER
;;7.2h was written about. So the legs are made real first.
;;
;;[6.2.4] leaves TfStakePool with two live TF legs (EMMA 40.0, ANHD 60.0) and every OF/DPSF/DPNF
;;pool EMPTY — its stake suites unstake what they stake. The three stakes below re-fill one leg in
;;each of the remaining families. Chosen so that in every case the leg belongs to the ATTACKER or
;;to somebody other than the pool owner, so the only authority the refusal can be about is the
;;POOL's.
(env-sigs [ { "key": "PK_Emma", "caps": [] } { "key": "PK_AncientHodler", "caps": [] } ])
(let
    (
        (ref-U|DALOS:module{UtilityDalosV2} U|DALOS)
        (ref-TS02-C3:module{TalosStageTwo_ClientThreeV1} TS02-C3)
    )
    (map print
        [
            ;;OF — EMMA stakes HER OWN MVST nonce 2 into OfStakePool, which ANHD owns.
            (format "<(CC_StakeOrtoFungible EMMA)> => \"{}\""
                [(ref-TS02-C3::AQP-POOL|CC_StakeOrtoFungible KST.EMMA
                    (ref-U|DALOS::UDC_Makeid "OfStakePool") KST.EMMA KST.EMMA "MVST-98c486052a51" [2])])
            ;;DPNF — ANHD stakes HIS OWN DHB nonce 1 into NfSyncPool, which LUMY owns.
            (format "<(CC_StakeNonFungibleCollectable ANHD)> => \"{}\""
                [(ref-TS02-C3::AQP-POOL|CC_StakeNonFungibleCollectable KST.ANHD
                    (ref-U|DALOS::UDC_Makeid "NfSyncPool") KST.ANHD KST.ANHD "DHB-98c486052a51" [1])])
            ;;DPSF — ANHD stakes DHCD nonce 1 into SfStakePool, which ANHD owns. This one exists so
            ;;the SAME defcap can be shown naming a DIFFERENT victim (see RT-D-007).
            (format "<(CC_StakeSemiFungibleCollectable ANHD)> => \"{}\""
                [(ref-TS02-C3::AQP-POOL|CC_StakeSemiFungibleCollectable KST.ANHD
                    (ref-U|DALOS::UDC_Makeid "SfStakePool") KST.ANHD KST.ANHD "DHCD-98c486052a51" [1])])
        ])
    ""
)
(env-sigs [])
(print "")
(print "===^^^===")
(commit-tx)

;;|| NEXT >
;;
(begin-tx "RT-D-005 - the true-fungible vacate gate, witnessed for the first time")
(env-gasmodel "table")(env-gaslimit 100000000)(env-gas 0)
(namespace "ouronet-ns")
;;==== RT-D-005 · 01 · the shadowing checks, satisfied on purpose ====
(print "--- [RT-D-005 · 01 · the shadowing checks, satisfied on purpose] ---")
;;<<RT-D-005>> FAMILY: D | STATUS: REFUSED
;;HYPOTHESIS: `VCT|C>TRUE-FUNGIBLE-VACATE` gates the TF batch-vacate recipe
;;            (`CCp_BatchVacateTrueFungible` / `CCp_BatchDrainTrueFungible`) on
;;            `CAP_VctVacatePoolOwner`. That call sits AFTER a four-conjunct business `enforce`
;;            ("Invalid TF vacate cap input"), and no test has ever reached past it: every negative
;;            in the suite trips the business rule, and a business-rule refusal is byte-identical
;;            whether the ownership line is present or DELETED. So the claim under test is not
;;            "vacate is protected" but "the protection can be SEEN protecting" -- a stranger who
;;            supplies a perfectly valid batch must still be refused, BY OWNERSHIP, by name.
;;METHOD:     satisfy all four earlier conjuncts by construction and assert each one true before
;;            attacking, so the refusal cannot be the business rule. EMMA is the attacker and the
;;            batch names HER OWN leg (owner EMMA, beneficiary EMMA, 40.0 OURO -- left live by
;;            [6.2.4]), so no third party's authority is needed for any part of the request except
;;            the pool's. Then the same call is repeated with one extra signature.
;;RESULT:     REFUSED, and attributably: `Smart DALOS Account <konto> Ownership could not be
;;            verified!`. TfStakePool's owner konto is the OURO token's konto, which is the
;;            Talos/gas SMART account -- so this gate speaks the SMART-account half of
;;            `CAP_EnforceAccountOwnership`, not a keyset failure (DEFECT-LEDGER 7.2h defect 4:
;;            a detector that knew only the keyset half read every smart-owned gate as unobserved).
;;            Non-vacuity: the identical call with ANHD -- the smart account's SOVEREIGN -- also
;;            signing succeeds and vacates the leg.
;;
;;WHAT ALREADY EXISTED, stated precisely, because "no test has ever reached this" is the kind of
;;claim this project has been wrong about before. TWO things were already green and NEITHER of them
;;covers these three capabilities:
;;
;;  * `[6.2.5]_AQP-VCT.repl` <<TX-VCT-L04b>> drives a non-owner at `CC_FullVacate`, `C_AbortVacate`
;;    and `C_EnablePoolStake`. Those caps call `CAP_VctVacatePoolOwner` FIRST, before any business
;;    rule -- they are the correctly-ordered siblings, and they are exactly the ones that were easy
;;    to witness. The three BATCH caps were left alone.
;;  * `modules/AQP.repl` <<AQP-F16>> calls `CAP_VctVacatePoolOwner` DIRECTLY, unsigned. That
;;    witnesses the DEFUN. It says nothing about whether any capability ever reaches it: a defcap
;;    whose business `enforce` always fires first would leave AQP-F16 green forever. The gate and
;;    the route to the gate are two different claims, and only the first had evidence.
;;
;;So `...e` below is NOT the interesting assertion -- it is the attribution instrument. `...c` and
;;`...d` are the new facts: the ROUTE through a batch capability actually arrives at the gate.
;;
;;WHY EMMA AND NOT ANHD. ANHD is the Demiurgoi master key AND the sovereign of the account that
;;owns this pool, so an "attack" signed by ANHD would pass the gate and prove nothing. EMMA is a
;;STAKER here and nothing else: she has value in the pool and still may not run the pool-owner
;;recipe. `URC_AqpOwnerKonto` is asserted below to be neither her nor anything she controls.
;;
;;SHAPE, since it decides how these may be driven: `CCp_` is a HYDRA recipe, not a defpact, and
;;this one is a FED SLICE -- it takes explicit owner/beneficiary/amount arrays rather than a page
;;size, and computes no window from stored progress. Per CLAUDE.md's recipe axes that makes it
;;order-independent; the attack therefore needs no prior batch to have run.
(env-sigs [{ "key": "PK_Emma", "caps": [] }])
(let*
    (
        (ref-U|DALOS:module{UtilityDalosV2} U|DALOS)
        (ref-AQP:module{AcquisitionPoolsV1} AQP-POOL)
        (ref-DALOS:module{OuronetDalosV2} DALOS)
        (ref-VCT:module{AcquisitionVacateV1} AQP-VCT)
        (ref-TS02-C3:module{TalosStageTwo_ClientThreeV1} TS02-C3)
        (pool-id:string (ref-U|DALOS::UDC_Makeid "TfStakePool"))
        (ouro-id:string "OURO-98c486052a51")
        (attacker:string KST.EMMA)
        (owner-konto:string (ref-AQP::URC_AqpOwnerKonto pool-id))
    )
    (map print
        [
            ;;THE FIXTURE IS THE WHOLE POINT. If any of these four goes false the attack below stops
            ;;testing ownership and starts testing the business rule -- silently, and still green.
            ;;Asserting them makes that failure mode turn THIS line red instead.
            (expect
                "<<RT-D-005a>> all four checks that run BEFORE the owner gate are satisfied by this batch"
                [true true true true]
                [ (ref-AQP::URC_StakeTrueFungiblePoolClassOk pool-id)
                  (ref-AQP::URC_StakeTrueFungibleDptfMatchesPool pool-id ouro-id)
                  (ref-VCT::URC_TfOwnerArraysGasOk [attacker] [attacker] [40.0])
                  (ref-VCT::URC_VacateTfLegsOk pool-id ouro-id
                      [(ref-VCT::UDC_VacateTfLeg attacker attacker 40.0)]) ])
            ;;...and the attacker demonstrably does not own the pool, by either route the smart
            ;;account admits (its own konto, or its sovereign).
            (expect
                (format "<<RT-D-005b>> the attacker is neither the pool's owner konto nor its sovereign [{}]"
                    [(ref-DALOS::UR_AccountSovereign owner-konto)])
                [false false true]
                [ (= attacker owner-konto)
                  (= attacker (ref-DALOS::UR_AccountSovereign owner-konto))
                  (ref-DALOS::UR_AccountType owner-konto) ])
        ])
    ;;==== RT-D-005 · 02 · the attack, and the gate that refuses it ====
    (print "--- [RT-D-005 · 02 · the attack, and the gate that refuses it] ---")
    (map print
        [
            ;;THE ATTACK. Pinned by the FULL sentence, with the victim konto interpolated: an
            ;;unqualified match would not separate "the owner gate refused" from any other
            ;;`enforce-one` in the tree, and a bare "it was refused" would survive deletion of the
            ;;very line under test.
            ;;
            ;;THE SENTENCE IS SPELLED OUT AT EACH SITE RATHER THAN BOUND ONCE, against this repo's
            ;;usual let-it-if-used-twice rule, and the reason is measurement. `REPL/tools/_ownerobs.py`
            ;;-- the instrument that answers "which owner gates has no test ever reached" -- reads
            ;;the BALANCED extent of each `expect-failure` and looks for the ownership signature
            ;;INSIDE it. A message hoisted into the enclosing `let*` is invisible to it, so the
            ;;first draft of this block left two of these three gates still reported as NEVER
            ;;OBSERVED while actually witnessing them. That is the false-comfort direction, and a
            ;;repeated string literal is a cheap price for a tool that can see its own coverage.
            (expect-failure
                "<<RT-D-005c>> ATTACK REFUSED: a staker with a perfectly valid batch is not the pool owner"
                (format "Smart DALOS Account {} Ownership could not be verified!" [owner-konto])
                (ref-TS02-C3::AQP-POOL|CCp_BatchVacateTrueFungible
                    attacker pool-id ouro-id [attacker] [attacker] [40.0]))
            ;;THE TWIN ENTRY on the same defcap. A separate `defun` is a separate door, and an
            ;;adjacent green assertion is the most convincing way for one to stay dark
            ;;(DEFECT-LEDGER 7.2h, the sibling-gate trap).
            (expect-failure
                "<<RT-D-005d>> ...and the fast-drain twin, which acquires the same cap, refuses identically"
                (format "Smart DALOS Account {} Ownership could not be verified!" [owner-konto])
                (ref-TS02-C3::AQP-POOL|CCp_BatchDrainTrueFungible
                    attacker pool-id ouro-id [attacker] [attacker] [40.0]))
            ;;ATTRIBUTION, in isolation. The gate is a bare `defun`, so it can be called on its own:
            ;;the same sentence from `CAP_VctVacatePoolOwner` alone is what makes the two refusals
            ;;above ATTRIBUTABLE rather than merely COINCIDENT with it.
            (expect-failure
                "<<RT-D-005e>> ...and the gate ALONE produces that exact sentence, so the refusal is its"
                (format "Smart DALOS Account {} Ownership could not be verified!" [owner-konto])
                (ouronet-ns.AQP-VCT.CAP_VctVacatePoolOwner pool-id))
        ])
    ""
)
;;==== RT-D-005 · 03 · non-vacuity: one added signature, same call, it succeeds ====
(print "--- [RT-D-005 · 03 · non-vacuity: one added signature, same call, it succeeds] ---")
;;WITHOUT THIS HALF a refusal proves nothing: "this call is broken" and "this call is guarded"
;;look the same from outside. Exactly ONE thing changes -- ANHD's signature is added. Same patron,
;;same pool, same asset, same arrays.
(env-sigs [{ "key": "PK_Emma", "caps": [] } { "key": "PK_AncientHodler", "caps": [] }])
(let
    (
        (ref-U|DALOS:module{UtilityDalosV2} U|DALOS)
        (ref-TS02-C3:module{TalosStageTwo_ClientThreeV1} TS02-C3)
    )
    (let
        (
            (pool-id:string (ref-U|DALOS::UDC_Makeid "TfStakePool"))
        )
        (map print
            [
                (expect
                    "<<RT-D-005f>> ...and the gate alone now PASSES for the sovereign's signature"
                    true (ouronet-ns.AQP-VCT.CAP_VctVacatePoolOwner pool-id))
                (expect
                    "<<RT-D-005g>> NON-VACUITY: the identical batch succeeds once the owner signs"
                    "Batch-vacated 1 TF leg(s) on Pool TfStakePool-98c486052a51 (asset OURO-98c486052a51)."
                    (ref-TS02-C3::AQP-POOL|CCp_BatchVacateTrueFungible
                        KST.EMMA pool-id "OURO-98c486052a51" [KST.EMMA] [KST.EMMA] [40.0]))
            ])
        ""
    )
)
(env-sigs [])
(print "")
(print "===^^^===")
;;ROLLED BACK, not committed: the non-vacuity half really does vacate the leg, and the next two
;;blocks are written against a pool set that still has its stake in it.
(rollback-tx)

;;|| NEXT >
;;
(begin-tx "RT-D-006 - the orto-fungible vacate gate, witnessed for the first time")
(env-gasmodel "table")(env-gaslimit 100000000)(env-gas 0)
(namespace "ouronet-ns")
;;==== RT-D-006 · 01 · the shadowing checks, satisfied on purpose ====
(print "--- [RT-D-006 · 01 · the shadowing checks, satisfied on purpose] ---")
;;<<RT-D-006>> FAMILY: D | STATUS: REFUSED
;;HYPOTHESIS: same shape, different family and different code.
;;            `VCT|C>ORTO-FUNGIBLE-VACATE-BATCH` guards `CCp_BatchVacateOrtoFungible` /
;;            `CCp_BatchDrainOrtoFungible` and puts `CAP_VctVacatePoolOwner` after a FOUR-conjunct
;;            `enforce` ("Invalid OF vacate batch"). Nothing in the suite has ever driven it with a
;;            non-owner, so deleting the ownership line would turn no assertion red while being the
;;            only thing between a stranger and every staker's position in an OF pool.
;;METHOD:     EMMA stakes her OWN MVST nonce 2 into OfStakePool (fixture block above), which ANHD
;;            owns, then tries to vacate exactly that leg. Every earlier conjunct is satisfied and
;;            asserted. Note the amounts are NOT supplied by the caller here -- the recipe resolves
;;            them from the live tracker (`URC_ResolveOfDecimalAmountsFromTracker`, an EAGER `let`
;;            that runs BEFORE the `with-capability`), so the "no partial vacate" conjunct is true
;;            by construction and cannot be what refuses.
;;RESULT:     REFUSED, naming the VICTIM: `Keyset failure (keys-all): [PK_Ancie...]` while the
;;            attacker signs PK_Emma. Non-vacuity: one added signature and the same call vacates.
;;
;;WHY THE LEG IS THE ATTACKER'S OWN, and why that matters more than it looks. If the batch named
;;ANHD's leg, then adding ANHD's signature in the control would be ambiguous -- it could be
;;authorising the leg rather than the pool. Naming EMMA's own leg removes that reading entirely:
;;the ONLY thing ANHD's signature can be doing is satisfying `CAP_VctVacatePoolOwner`. It also
;;states the rule being tested in its sharpest form -- VACATE IS A POOL-OWNER OPERATION, so a
;;staker may not use it even to withdraw her own stake.
(env-sigs [{ "key": "PK_Emma", "caps": [] }])
(let*
    (
        (ref-U|DALOS:module{UtilityDalosV2} U|DALOS)
        (ref-AQP:module{AcquisitionPoolsV1} AQP-POOL)
        (ref-VCT:module{AcquisitionVacateV1} AQP-VCT)
        (ref-TS02-C3:module{TalosStageTwo_ClientThreeV1} TS02-C3)
        (pool-id:string (ref-U|DALOS::UDC_Makeid "OfStakePool"))
        (mvst-id:string "MVST-98c486052a51")
        (attacker:string KST.EMMA)
        (nonces:[[integer]] [[2]])
    )
    (map print
        [
            (expect
                "<<RT-D-006a>> all four checks that run BEFORE the owner gate are satisfied by this batch"
                [true true true true]
                [ (ref-AQP::URC_StakeOrtoFungibleDpofMatchesPool pool-id mvst-id)
                  (ref-VCT::URC_BatchOwnerArraysGasOk [attacker] [attacker] nonces 33)
                  (ref-VCT::URC_VacateBatchNonceTotalOk nonces)
                  (ref-VCT::URC_VacateOrtoLegsOk pool-id mvst-id [attacker] [attacker] nonces
                      (ref-VCT::URC_ResolveOfDecimalAmountsFromTracker
                          pool-id mvst-id [attacker] [attacker] nonces)) ])
            ;;The victim named in the refusal below is the pool owner, and it is not the attacker.
            (expect
                "<<RT-D-006b>> the pool is owned by ANHD, a STANDARD account, and not by the attacker"
                [true false]
                [ (= (ref-AQP::URC_AqpOwnerKonto pool-id) KST.ANHD)
                  (= (ref-AQP::URC_AqpOwnerKonto pool-id) attacker) ])
        ])
    ;;==== RT-D-006 · 02 · the attack, and the gate that refuses it ====
    (print "--- [RT-D-006 · 02 · the attack, and the gate that refuses it] ---")
    (map print
        [
            ;;Pinned to the VICTIM's key, not to a bare "Keyset failure": the attacker signs
            ;;PK_Emma, so a refusal naming PK_Ancie cannot be "the attacker's own signature was
            ;;rejected" -- which is the reading an unqualified match would let through while
            ;;proving the opposite (RT-D-004 carries the same caution).
            (expect-failure
                "<<RT-D-006c>> ATTACK REFUSED: a staker may not vacate even her OWN leg -- the pool is not hers"
                "Keyset failure (keys-all): [PK_Ancie...]"
                (ref-TS02-C3::AQP-POOL|CCp_BatchVacateOrtoFungible
                    attacker pool-id mvst-id [attacker] [attacker] nonces))
            (expect-failure
                "<<RT-D-006d>> ...and the fast-drain twin, which acquires the same cap, refuses identically"
                "Keyset failure (keys-all): [PK_Ancie...]"
                (ref-TS02-C3::AQP-POOL|CCp_BatchDrainOrtoFungible
                    attacker pool-id mvst-id [attacker] [attacker] nonces))
            (expect-failure
                "<<RT-D-006e>> ...and the gate ALONE produces that exact refusal, so the refusal is its"
                "Keyset failure (keys-all): [PK_Ancie...]"
                (ouronet-ns.AQP-VCT.CAP_VctVacatePoolOwner pool-id))
        ])
    ""
)
;;==== RT-D-006 · 03 · non-vacuity: one added signature, same call, it succeeds ====
(print "--- [RT-D-006 · 03 · non-vacuity: one added signature, same call, it succeeds] ---")
(env-sigs [{ "key": "PK_Emma", "caps": [] } { "key": "PK_AncientHodler", "caps": [] }])
(let
    (
        (ref-U|DALOS:module{UtilityDalosV2} U|DALOS)
        (ref-TS02-C3:module{TalosStageTwo_ClientThreeV1} TS02-C3)
    )
    (let
        (
            (pool-id:string (ref-U|DALOS::UDC_Makeid "OfStakePool"))
        )
        (map print
            [
                (expect
                    "<<RT-D-006f>> ...and the gate alone now PASSES for the pool owner's signature"
                    true (ouronet-ns.AQP-VCT.CAP_VctVacatePoolOwner pool-id))
                (expect
                    "<<RT-D-006g>> NON-VACUITY: the identical batch succeeds once the owner signs"
                    "Batch-vacated 1 OF leg(s) on Pool OfStakePool-98c486052a51 (asset MVST-98c486052a51)."
                    (ref-TS02-C3::AQP-POOL|CCp_BatchVacateOrtoFungible
                        KST.EMMA pool-id "MVST-98c486052a51" [KST.EMMA] [KST.EMMA] [[2]]))
            ])
        ""
    )
)
(env-sigs [])
(print "")
(print "===^^^===")
(rollback-tx)

;;|| NEXT >
;;
(begin-tx "RT-D-007 - the collectable vacate gate, witnessed for the first time")
(env-gasmodel "table")(env-gaslimit 100000000)(env-gas 0)
(namespace "ouronet-ns")
;;==== RT-D-007 · 01 · the shadowing checks, satisfied on purpose ====
(print "--- [RT-D-007 · 01 · the shadowing checks, satisfied on purpose] ---")
;;<<RT-D-007>> FAMILY: D | STATUS: REFUSED
;;HYPOTHESIS: the third of the three, and the one with the longest shadow.
;;            `VCT|C>COLLECTABLE-VACATE-BATCH` guards `CCp_BatchVacateCollectables` /
;;            `CCp_BatchDrainCollectable` for BOTH collectable branches (son=true DPSF, son=false
;;            DPNF) and puts `CAP_VctVacatePoolOwner` after a FIVE-conjunct `enforce` ("Invalid
;;            collectable vacate batch"). Five business conjuncts is five different ways for an
;;            attack to be turned away before the gate is reached, and none of the suite's
;;            negatives gets past them.
;;METHOD:     the attacker is ANHD -- deliberately the strongest key available, the Demiurgoi
;;            master keyset member, AND the owner of the very nonce in the batch. The pool is
;;            NfSyncPool, which LUMY owns. So the request is impeccable in every respect except
;;            the one under test, and the attacker's own authority is maximal.
;;RESULT:     REFUSED, naming LUMY: `Keyset failure (keys-all): [PK_Lumy...]` while the attacker
;;            signs PK_AncientHodler. The admin key does not override pool ownership. Non-vacuity:
;;            adding PK_Lumy -- and changing nothing else -- vacates.
;;
;;AND A DIFFERENTIAL, because "the message names the victim" is only worth asserting if the message
;;is DERIVED. The SAME defcap is driven a second time on SfStakePool (son=true, DPSF, owned by
;;ANHD) with EMMA attacking, and names PK_Ancie instead. One capability, two pools, two different
;;keys in the refusal: the sentence tracks `URC_AqpOwnerKonto` and is not a constant.
;;
;;WHY ANHD IS THE RIGHT ATTACKER HERE AND THE WRONG ONE IN RT-D-005/006. An attack signed by a key
;;that already owns the thing proves nothing -- ANHD owns OfStakePool and is sovereign of
;;TfStakePool's owner, so there he is useless. NfSyncPool is LUMY's, and that makes ANHD the most
;;informative possible attacker: if the gate can refuse the master key, it refuses anybody.
(env-sigs [{ "key": "PK_AncientHodler", "caps": [] }])
(let*
    (
        (ref-U|DALOS:module{UtilityDalosV2} U|DALOS)
        (ref-AQP:module{AcquisitionPoolsV1} AQP-POOL)
        (ref-VCT:module{AcquisitionVacateV1} AQP-VCT)
        (ref-TS02-C3:module{TalosStageTwo_ClientThreeV1} TS02-C3)
        (pool-id:string (ref-U|DALOS::UDC_Makeid "NfSyncPool"))
        (dhb-id:string "DHB-98c486052a51")
        (attacker:string KST.ANHD)
        (nonces:[[integer]] [[1]])
        (amounts:[[integer]] [[1]])
    )
    (map print
        [
            (expect
                "<<RT-D-007a>> all five checks that run BEFORE the owner gate are satisfied by this batch"
                [true true true true true]
                [ (ref-AQP::URC_StakeCollectablePoolClassOk pool-id false)
                  (ref-AQP::URC_StakeCollectableMatchesPool pool-id dhb-id)
                  (ref-VCT::URC_BatchOwnerArraysGasOk [attacker] [attacker] nonces 30)
                  (ref-VCT::URC_VacateBatchNonceTotalOk nonces)
                  (ref-VCT::URC_VacateCollectableLegsOk pool-id dhb-id false
                      [attacker] [attacker] nonces amounts) ])
            (expect
                "<<RT-D-007b>> the pool is LUMY's; the attacker owns the NONCE in it but not the POOL"
                [true false true]
                [ (= (ref-AQP::URC_AqpOwnerKonto pool-id) KST.LUMY)
                  (= (ref-AQP::URC_AqpOwnerKonto pool-id) attacker)
                  (> (ref-AQP::UR_AQP|DPNFTrackerBalance pool-id dhb-id attacker attacker 1) 0.0) ])
        ])
    ;;==== RT-D-007 · 02 · the attack, and the gate that refuses it ====
    (print "--- [RT-D-007 · 02 · the attack, and the gate that refuses it] ---")
    (map print
        [
            (expect-failure
                "<<RT-D-007c>> ATTACK REFUSED: the Demiurgoi master key does not override pool ownership"
                "Keyset failure (keys-all): [PK_Lumy...]"
                (ref-TS02-C3::AQP-POOL|CCp_BatchVacateCollectables
                    attacker pool-id dhb-id false [attacker] [attacker] nonces amounts))
            (expect-failure
                "<<RT-D-007d>> ...and the fast-drain twin, which acquires the same cap, refuses identically"
                "Keyset failure (keys-all): [PK_Lumy...]"
                (ref-TS02-C3::AQP-POOL|CCp_BatchDrainCollectable
                    attacker pool-id dhb-id false [attacker] [attacker] nonces amounts))
            (expect-failure
                "<<RT-D-007e>> ...and the gate ALONE produces that exact refusal, so the refusal is its"
                "Keyset failure (keys-all): [PK_Lumy...]"
                (ouronet-ns.AQP-VCT.CAP_VctVacatePoolOwner pool-id))
        ])
    ""
)
;;==== RT-D-007 · 03 · the same defcap, a different pool, a different victim ====
(print "--- [RT-D-007 · 03 · the same defcap, a different pool, a different victim] ---")
(env-sigs [{ "key": "PK_Emma", "caps": [] }])
(let*
    (
        (ref-U|DALOS:module{UtilityDalosV2} U|DALOS)
        (ref-AQP:module{AcquisitionPoolsV1} AQP-POOL)
        (ref-VCT:module{AcquisitionVacateV1} AQP-VCT)
        (ref-TS02-C3:module{TalosStageTwo_ClientThreeV1} TS02-C3)
        (pool-id:string (ref-U|DALOS::UDC_Makeid "SfStakePool"))
        (dhcd-id:string "DHCD-98c486052a51")
        (attacker:string KST.EMMA)
        (nonces:[[integer]] [[1]])
        (amounts:[[integer]] [[500]])
    )
    (map print
        [
            ;;son=true this time: the DPSF branch of the same capability, whose gas-max conjunct
            ;;takes the other side of the `if`. The five conjuncts are re-asserted because they are
            ;;computed from DIFFERENT readers on this branch.
            (expect
                "<<RT-D-007f>> the DPSF branch's five earlier checks are satisfied too"
                [true true true true true]
                [ (ref-AQP::URC_StakeCollectablePoolClassOk pool-id true)
                  (ref-AQP::URC_StakeCollectableMatchesPool pool-id dhcd-id)
                  (ref-VCT::URC_BatchOwnerArraysGasOk [KST.ANHD] [KST.ANHD] nonces 29)
                  (ref-VCT::URC_VacateBatchNonceTotalOk nonces)
                  (ref-VCT::URC_VacateCollectableLegsOk pool-id dhcd-id true
                      [KST.ANHD] [KST.ANHD] nonces amounts) ])
            ;;THE DIFFERENTIAL. Same capability, same line of code, a pool with a different owner --
            ;;and the refusal names a different key. That is what makes RT-D-007c's "[PK_Lumy...]"
            ;;evidence about ownership rather than a constant string that any refusal would print.
            (expect-failure
                "<<RT-D-007g>> the SAME defcap names a DIFFERENT victim on a DIFFERENTLY-OWNED pool"
                "Keyset failure (keys-all): [PK_Ancie...]"
                (ref-TS02-C3::AQP-POOL|CCp_BatchVacateCollectables
                    attacker pool-id dhcd-id true [KST.ANHD] [KST.ANHD] nonces amounts))
        ])
    ""
)
;;==== RT-D-007 · 04 · non-vacuity: one added signature, same call, it succeeds ====
(print "--- [RT-D-007 · 04 · non-vacuity: one added signature, same call, it succeeds] ---")
;;PK_AncientHodler is still the patron and still the leg's owner; PK_Lumy is ADDED. Nothing else
;;about the call changes.
(env-sigs [{ "key": "PK_AncientHodler", "caps": [] } { "key": "PK_Lumy", "caps": [] }])
(let
    (
        (ref-U|DALOS:module{UtilityDalosV2} U|DALOS)
        (ref-TS02-C3:module{TalosStageTwo_ClientThreeV1} TS02-C3)
    )
    (let
        (
            (pool-id:string (ref-U|DALOS::UDC_Makeid "NfSyncPool"))
        )
        (map print
            [
                (expect
                    "<<RT-D-007h>> ...and the gate alone now PASSES for the pool owner's signature"
                    true (ouronet-ns.AQP-VCT.CAP_VctVacatePoolOwner pool-id))
                (expect
                    "<<RT-D-007i>> NON-VACUITY: the identical batch succeeds once the owner signs"
                    "Batch-vacated 1 collectable leg(s) on Pool NfSyncPool-98c486052a51 (asset DHB-98c486052a51, son false)."
                    (ref-TS02-C3::AQP-POOL|CCp_BatchVacateCollectables
                        KST.ANHD pool-id "DHB-98c486052a51" false [KST.ANHD] [KST.ANHD] [[1]] [[1]]))
            ])
        ""
    )
)
(env-sigs [])
(print "")
(print "===^^^===")
(rollback-tx)
