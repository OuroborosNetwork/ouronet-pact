;;
;; REPL/RedTeam/[RT-J]_Conservation.repl — canonical integration layout (OuronetInformational/ARCHITECTURE/REPL_AND_TESTS.md)
;;   Inter-tx:   ;;|| NEXT >  (same three lines as REPL/Stage_01/[2.2]_Core.repl)
;;   Intra-tx:   ;;==== <TX label> · mm · <slug> ====  + next-line (print "--- [<label> · mm · …] ---"); mm = 01.. within each (begin-tx …) (see OuronetInformational/ARCHITECTURE/REPL_AND_TESTS.md).
;;   format "{}": Talos / module echoes and (env-gas) — document additional prefixes in this file's (print …) lines as needed.
;;
(print "")
(print "================================================================")
(print "FILE  REPL/RedTeam/[RT-J]_Conservation.repl")
(print "================================================================")
(print "Legend (terminal observability): see ;; preface; echoes use <(…)> where helpful.")
(print "Source: ;;|| NEXT > between txs; ;;==== … · mm · … ==== + banner before each begin-tx.")
(print "")
;;
;; REPL/RedTeam/[RT-J]_Conservation.repl — FAMILY J: ledger conservation.
;;
;; "Does the money add up?"
;;
;; Every other family in this programme attacks a guard. This one attacks the BOOKS. A token's
;; recorded `supply` and the sum of every account's balance are written by two different code
;; paths, in two different modules, and nothing in the tree has ever compared them. The invariant
;; is the oldest one in finance: supply == the sum of what everyone holds.
;;
;; Legend:
;;   <<RT-J-00Na>>  partition completeness   — every balance row attributed to exactly one token
;;   <<RT-J-00Nb>>  account-set completeness — the swept account set IS every account that exists
;;   <<RT-J-00Nc>>  the invariant itself, across every token in the tree
;;
;; Source: 1_SOVEREIGN/STAGE_01/2_Core/09_TFT.pact  (C_ClearDispo)
;;         1_SOVEREIGN/STAGE_01/2_Core/05_DPTF.pact (XBv_UpdateSupply / XB_Debit / XB_Credit)
;;         1_SOVEREIGN/STAGE_01/2_Core/01_DALOS.pact (XB_UpdateBalance — core-token balances)
;;
;; REPL tests: <<RT-J-001a>> <<RT-J-001b>> <<RT-J-001c>> <<RT-J-001d>> <<RT-J-001e>>
;;             <<RT-J-002a>> .. <<RT-J-002f>>
;;
;; Run: cd REPL && pact "RedTeam/[RT-J]_Conservation.repl"
;;
(load "../deploy-stage00.repl")
(load "../deploy-stage01.repl")
(load "../Stage_01/[6.2]_DPTF.repl")
(load "../Stage_01/[6.3]_SWP.repl")
;;[6.6]+[6.7] are what actually POPULATE DPOF: without them 11 of 12 ortofungibles sit
;;at zero supply and the RT-J-002 sweep is a sweep over zeros. [6.5]_DPOF is deliberately
;;NOT loaded -- the Stage-2 AQP path self-loads it, and a second load re-issues MVST
;;(duplicate insert). ZALL.repl carries the same note.
(load "../Stage_01/[6.6]_ATS.repl")
(load "../Stage_01/[6.7]_VST.repl")

;;|| NEXT >
;;
(begin-tx "RT-J-001 - does every token's supply equal the sum of its balances")
(env-gasmodel "table")(env-gaslimit 100000000)(env-gas 0)
;;==== RT-J-001 - does every token's supply equal the sum of its balances · 01 · namespace ==== ===
(print "--- [RT-J-001 - does every token's supply equal the sum of its balances · 01 · namespace] ---")
(namespace "ouronet-ns")
;;==== RT-J-001 · 01 · sweep every token, every holder ====
(print "--- [RT-J-001 · 01 · sweep every token, every holder] ---")
;;<<RT-J-001>> FAMILY: J | STATUS: FIXED
;;HYPOTHESIS: a DPTF's `supply` and the sum of its account balances are maintained by SEPARATE
;;            write paths -- `XBv_UpdateSupply` writes the supply column of DPTF|PropertiesTable,
;;            while balances are written by `XI_UpdateBalance`, which for the two CORE tokens
;;            (OUROBOROS and IGNIS) dispatches into a table owned by a DIFFERENT MODULE, DALOS.
;;            Nothing anywhere compares the two. If any client path moves one without the other,
;;            the ledger drifts silently and permanently, and no existing test can see it: every
;;            conservation assertion in the suite is LOCAL and HAND-NAMED ("op+emma+lumy = 5000").
;;METHOD:     sweep, do not reason. Enumerate every token with `DPTF.UR_P-KEYS` and every balance
;;            row with `DPTF.UR_KEYS`, attribute each row to its token by FULL-ID prefix (two token
;;            ids contain the separator -- `F|VST-...`, `R|OURO-...` -- so splitting on the first
;;            bar misattributes them), and compare `UR_Supply` against the summed balances. The
;;            two CORE tokens are not row-enumerable at all: DALOS exposes no key list for
;;            DALOS|AccountTable, only a COUNT. So their holders are supplied as a candidate set
;;            and the sweep is made non-vacuous by proving that set exhaustive AGAINST that count.
;;RESULT:     CONFIRMED, then FIXED. Measured exploit-first across 296 tokens and 739 balance
;;            rows: 295 tokens conserved to the last decimal and ONE did not -- OURO, the
;;            protocol's own money, with supply 8.0 BELOW the sum of all balances. Bisected to a
;;            single transaction and then to a single call, `DPTF|C_ClearDispo`. Its step 6 zeroes
;;            a negative OURO balance by calling DALOS::XB_UpdateBalance DIRECTLY -- the only
;;            one-sided use of that writer in the tree -- so the balance rises by the cleared
;;            dispo while supply does not. Repaired in 09_TFT.pact by pairing that write with
;;            `XBv_UpdateSupply ouro-id ouro-amount true`. After the fix all 296 tokens conserve.
;;
;;WHY THE TWO NON-VACUITY GUARDS ARE NOT DECORATION. This sweep is an argument of the form "I
;;looked everywhere and found nothing", which is worthless unless "everywhere" is proven. Both
;;guards fired for real during construction:
;;
;;  (a) the first run reported OURO conserved and GAS off by 9302.0225. Both were WRONG -- the
;;      sweep was summing DALOS balances over only the accounts that happened to own a DPTF
;;      placeholder row, 6 of 24. The partition guard says every row is attributed; the account
;;      guard says every ACCOUNT is swept. Only the second one could catch that.
;;  (b) loading [6.3]_SWP raised the account count from 24 to 26 -- it deploys two more. The
;;      account guard went red immediately. Without it the sweep would have quietly gone back to
;;      under-counting, and reported a DIFFERENT wrong number with equal confidence.
;;
(let*
    (
        (ids:[string] (ouronet-ns.DPTF.UR_P-KEYS))
        (bkeys:[string] (ouronet-ns.DPTF.UR_KEYS))
        ;;The candidate holder set for the two CORE tokens. Non-existent entries are harmless --
        ;;they read 0.0 -- so this is deliberately a SUPERSET, made exact by <<RT-J-001b>>.
        (cand0:[string]
            (+  [ KST.ANHD KST.FLRN KST.EMMA KST.BYTA KST.LUMY KST.COCA KST.KISS
                  KST.PLCS KST.NANI KST.AOZT KST.TALOS KST.ATSTK KST.VESTG KST.LIQST
                  KST.OURBR KST.SWAPR KC.BM KC.BJ
                  (+ "Σ" (drop 1 KST.ANHD))
                  (ouronet-ns.DALOS.GOV|DHV1|SC_NAME) (ouronet-ns.DALOS.GOV|DHV2|SC_NAME)
                  (ouronet-ns.DALOS.GOV|AQP|SC_NAME)
                  "Ѻ.hÜ5ĞÊÜεŞΓõè1Ă₳äàÄìãÓЦφLÕзЯŮμĞ₿мK6àŘуVćχδдзηφыβэÎχUHRêγBğΛ∇VŒižďЬШ£îOÜøE4ÖFSõЩЩAłκè1ččΨΦŻЖэч6Iчη₱ØćнúŒψУćÀyпãЗцÚäδÏÍtςřïçγț6γÎęôigFzÝûηы₿ÏЬüБэΞčмŃт₳ŘчjζsŠȚHъĘïЦ0" "Σ.hÜ5ĞÊÜεŞΓõè1Ă₳äàÄìãÓЦφLÕзЯŮμĞ₿мK6àŘуVćχδдзηφыβэÎχUHRêγBğΛ∇VŒižďЬШ£îOÜøE4ÖFSõЩЩAłκè1ččΨΦŻЖэч6Iчη₱ØćнúŒψУćÀyпãЗцÚäδÏÍtςřïçγț6γÎęôigFzÝûηы₿ÏЬüБэΞčмŃт₳ŘчjζsŠȚHъĘïЦ0" "Ѻ.Щę7ãŽÓλ4ěПîЭđЮЫAďбQOχnиИДχѺNŽł6ПžιéИąĞuπЙůÞ1ęrПΔżæÍžăζàïαŮŘDzΘ€ЦBGÝŁЭЭςșúÜđŻõËŻκΩÎzŁÇÉΠмłÔÝÖθσ7₱в£μŻzéΘÚĂИüyćťξюWc2И7кςαTnÿЩE3MVTÀεPβafÖôoъBσÂбýжõÞ7ßzŁŞε0âłXâÃЛ" "Σ.Щę7ãŽÓλ4ěПîЭđЮЫAďбQOχnиИДχѺNŽł6ПžιéИąĞuπЙůÞ1ęrПΔżæÍžăζàïαŮŘDzΘ€ЦBGÝŁЭЭςșúÜđŻõËŻκΩÎzŁÇÉΠмłÔÝÖθσ7₱в£μŻzéΘÚĂИüyćťξюWc2И7кςαTnÿЩE3MVTÀεPβafÖôoъBσÂбýжõÞ7ßzŁŞε0âłXâÃЛ" "Σ.i₿čУÕнЩťÛБoÛțmbюØДбgΣÞvhÉDτĞШU€ΛρÉycÇŒιЫWвфÓìÙõЙȚcąÅγXμSЛdăœρΣЫœąЛз4ěìvŹ₱OßeЛåγЬÿ5цůăÑœдżÛöÃŁτTĆĚŤйO9лцìŒUμvŤxBãĘΠÒÁõЪЖÌțȚeв¢jþψHtΣŹõÒqúΠğďßżpш2t3Şëχμι3DciüÏγλM" "Ѻ.þódýSå∇θœŻθäЮânΦěÂCÉΛŠĚыćжŃУфÑíтσÈŸüÓÿÂи₳áìĚàŘhÃѺuΔuțŒЭěвžsÊ¢tWÛěbtõ₿1LΔмëøÆŚøξѺŮŤÒÚτцoDêžńęQvNTжÚž∇9ÂKуŞşи0ΛкДżεŽбÎбεÀÆãчvĚЫбçrЭKãwÿŽΨáÕЦê1мòğćZЮĞÉø1Î$mДMѺπďRЫ" ]
                (ouronet-ns.DALOS.UR_DemiurgoiID)))
        (cand:[string] (fold (lambda (a:[string] x:string) (if (contains x a) a (+ a [x]))) [] cand0))
        (live:[string] (filter (lambda (x:string)
            (try false (let ((z:bool true)) (ouronet-ns.DALOS.UEV_EnforceAccountExists x) z))) cand))
        ;;Attribution: a row belongs to token <id> iff it starts with <id> + BAR. Counted per
        ;;token and summed, so a row matching TWO ids is counted twice and the guard goes red.
        (attributed:integer (fold (+) 0 (map (lambda (id:string)
            (let ((n:integer (+ 1 (length id))))
                (length (filter (lambda (k:string)
                    (and (>= (length k) n) (= (take n k) (format "{}|" [id])))) bkeys)))) ids)))
        (rows:[object] (map (lambda (id:string)
            (let* ((core:bool (ouronet-ns.DPTF.URC_IzCoreDPTF id))
                   (n:integer (+ 1 (length id)))
                   (accts:[string] (if core live
                        (map (lambda (k:string) (drop n k))
                             (filter (lambda (k:string)
                                (and (>= (length k) n) (= (take n k) (format "{}|" [id])))) bkeys))))
                   (sum:decimal (fold (+) 0.0
                        (map (lambda (a:string) (ouronet-ns.DPTF.UR_AccountSupply id a)) accts))))
                { "id" : id , "delta" : (- (ouronet-ns.DPTF.UR_Supply id) sum) })) ids))
        (bad:[string] (map (lambda (r:object) (format "{}:{}" [(at "id" r) (at "delta" r)]))
                        (filter (lambda (r:object) (!= (at "delta" r) 0.0)) rows)))
        (ouro:string (ouronet-ns.DALOS.UR_OuroborosID))
        (gas:string (ouronet-ns.DALOS.UR_IgnisID))
        (ouro-sum:decimal (fold (+) 0.0
            (map (lambda (a:string) (ouronet-ns.DPTF.UR_AccountSupply ouro a)) live)))
        (gas-sum:decimal (fold (+) 0.0
            (map (lambda (a:string) (ouronet-ns.DPTF.UR_AccountSupply gas a)) live)))
    )
    (map print
        [
            (expect
                (format "<<RT-J-001a>> every one of the {} balance rows is attributed to exactly one of the {} tokens"
                    [(length bkeys) (length ids)])
                (length bkeys) attributed)
            (expect
                (format "<<RT-J-001b>> the swept core-holder set is EVERY account that exists ({} of them)"
                    [(length live)])
                (ouronet-ns.DALOS.URH_AccountCounter)
                (format "Ouronet has {} real Accounts!" [(length live)]))
            (expect
                (format "<<RT-J-001c>> supply == sum-of-balances for all {} tokens; offenders: {}"
                    [(length ids) bad])
                [] bad)
            (expect
                (format "<<RT-J-001d>> OURO: the protocol's own money balances -- supply {} vs held {}"
                    [(ouronet-ns.DPTF.UR_Supply ouro) ouro-sum])
                (ouronet-ns.DPTF.UR_Supply ouro) ouro-sum)
            (expect
                (format "<<RT-J-001e>> IGNIS: the virtual-gas ledger balances -- supply {} vs held {}"
                    [(ouronet-ns.DPTF.UR_Supply gas) gas-sum])
                (ouronet-ns.DPTF.UR_Supply gas) gas-sum)
        ])
    ""
)
(print "")
(print "===^^^===")
(commit-tx)

;;|| NEXT >
;;
(begin-tx "RT-J-002 - the ortofungible keeps a CACHED total beside the ledger it summarises")
(env-gasmodel "table")(env-gaslimit 100000000)(env-gas 0)
;;==== RT-J-002 - the ortofungible keeps a CACHED total beside the ledger it summarises · 01 · namespace ==== 
(print "--- [RT-J-002 - the ortofungible keeps a CACHED total beside the ledger it summarises · 01 · namespace] ---")
(namespace "ouronet-ns")
;;==== RT-J-002 · 01 · DPOF: three levels that must agree ====
(print "--- [RT-J-002 · 01 · DPOF: three levels that must agree] ---")
;;<<RT-J-002>> FAMILY: J | STATUS: REFUSED
;;HYPOTHESIS: DPOF (ortofungible) keeps the SAME quantity in three places -- `Properties.supply`,
;;            a per-account `total-account-supply` in DPOF|T|AccountRoles, and a per-nonce `supply`
;;            in DPOF|T|Nonces where each nonce records its own `holder`. The nonce table is the
;;            LEDGER; `total-account-supply` is a CACHED AGGREGATE of it. A cached aggregate beside
;;            its own source of truth is the classic place for drift, and no test had ever compared
;;            them -- RT-J-001's sweep covers DPTF only, and DPOF's writers are a different family.
;;METHOD:     enumerate ids (UR_P-KEYS), account rows (UR_KEYS) and nonce rows (UR_N-KEYS), attribute
;;            by FULL-ID prefix -- DPOF ids contain the separator far more often than DPTF's do
;;            (`V|OURO-`, `Z|VST-`, `Z|P|OURO-BUSD|LP-`), so splitting on the first bar is useless
;;            here -- and cross-check all three levels against each other.
;;RESULT:     REFUSED. 16 ortofungibles, 34 account rows, 80 nonce rows: every level agrees exactly,
;;            including the aggregate-vs-ledger check, which is the one that had never been run.
;;
;;THE FIRST RUN LOOKED LIKE FOUR DEFECTS AND WAS FOUR MISREADINGS OF ONE CONVENTION. Summing nonce
;;supplies naively gave `Z|VST` short by 31.0, `DDKOSON` by 4.0, `V|OURO` by 1.0, and `Z|OURO` a
;;NEGATIVE total of -1.0 against a supply of 0.0. Every one of those deltas turned out to equal that
;;token's `UR_NoncesExcluded` exactly, because an excluded nonce is TOMBSTONED, not deleted:
;;
;;      supply = -1.0   and   holder = BAR
;;
;;`-1.0` is a marker, not a balance. So the assertions below do not merely skip tombstones -- that
;;would hide the convention rather than test it. They pin it: the tombstone COUNT must equal
;;`UR_NoncesExcluded`, no nonce may carry any other negative value, and `supply = -1.0` must hold
;;if and only if `holder = BAR`.
;;
;;MUTATION-TESTED, because an all-green sweep is exactly the shape a vacuous one has. TWO controls
;;were needed, and finding that out was the point:
;;
;;  1] sentinel -1.0 -> -2.0 in this block: <<RT-J-002b>>, <<RT-J-002c>> and <<RT-J-002d>> go red.
;;  2] that control left <<RT-J-002e>> GREEN -- and the reason matters. 002e selects a nonce by its
;;     HOLDER, and a tombstone's holder is BAR, which is not an account, so no account ever picks a
;;     tombstone up no matter what the sentinel is. The aggregate-vs-ledger check is therefore
;;     independent of the tombstone convention, and needed its own control: flipping the holder
;;     match to `!=` reddens <<RT-J-002e>> and NOTHING ELSE.
;;
;;One perturbation reddening four assertions would have PROVEN LESS, not more -- it would have meant
;;the four were one assertion wearing four labels.
;;
(let*
    (
        (ids:[string] (ouronet-ns.DPOF.UR_P-KEYS))
        (akeys:[string] (ouronet-ns.DPOF.UR_KEYS))
        (nkeys:[string] (ouronet-ns.DPOF.UR_N-KEYS))
        ;;BAR, read out of the module rather than retyped: UC_IdAccount "" "" is exactly the separator.
        (bar:string (ouronet-ns.DPOF.UC_IdAccount "" ""))
        (res:[object] (map (lambda (id:string)
            (let* ((n:integer (+ 1 (length id)))
                   (pfx:string (format "{}|" [id]))
                   (owns (lambda (k:string) (and (>= (length k) n) (= (take n k) pfx))))
                   (ak:[string] (filter (lambda (k:string) (owns k)) akeys))
                   (nk:[string] (filter (lambda (k:string) (owns k)) nkeys))
                   (ncs:[integer] (map (lambda (k:string) (str-to-int (drop n k))) nk))
                   (sup:[decimal] (map (lambda (c:integer) (ouronet-ns.DPOF.UR_NonceSupply id c)) ncs))
                   (live:decimal (fold (+) 0.0 (filter (lambda (x:decimal) (!= x -1.0)) sup)))
                   ;;tombstone <=> holder is BAR, tested in BOTH directions with !=  on two booleans
                   (tomb-mismatch:integer (length (filter (lambda (c:integer)
                        (!= (= (ouronet-ns.DPOF.UR_NonceSupply id c) -1.0)
                            (= (ouronet-ns.DPOF.UR_NonceHolder id c) bar))) ncs)))
                   ;;the cached aggregate, against the nonce ledger it summarises
                   (acct-drift:integer (length (filter (lambda (k:string)
                        (let ((acct:string (drop n k)))
                            (!= (ouronet-ns.DPOF.UR_AccountSupply id acct)
                                (fold (+) 0.0 (map (lambda (c:integer)
                                    (if (and (!= (ouronet-ns.DPOF.UR_NonceSupply id c) -1.0)
                                             (= (ouronet-ns.DPOF.UR_NonceHolder id c) acct))
                                        (ouronet-ns.DPOF.UR_NonceSupply id c) 0.0)) ncs))))) ak)))
                   (acct-sum:decimal (fold (+) 0.0
                        (map (lambda (k:string) (ouronet-ns.DPOF.UR_AccountSupply id (drop n k))) ak))))
                { "id"            : id
                , "d-live"        : (- (ouronet-ns.DPOF.UR_Supply id) live)
                , "d-acct"        : (- (ouronet-ns.DPOF.UR_Supply id) acct-sum)
                , "d-tomb"        : (- (length (filter (lambda (x:decimal) (= x -1.0)) sup))
                                       (ouronet-ns.DPOF.UR_NoncesExcluded id))
                , "other-neg"     : (length (filter (lambda (x:decimal) (and (< x 0.0) (!= x -1.0))) sup))
                , "tomb-mismatch" : tomb-mismatch
                , "acct-drift"    : acct-drift
                , "na"            : (length ak)
                , "nn"            : (length nk) })) ids))
        (off (lambda (field:string)
            (map (lambda (r:object) (at "id" r))
                 (filter (lambda (r:object)
                    (if (= field "d-live") (!= (at "d-live" r) 0.0)
                    (if (= field "d-acct") (!= (at "d-acct" r) 0.0)
                    (if (= field "d-tomb") (!= (at "d-tomb" r) 0)
                    (if (= field "other-neg") (!= (at "other-neg" r) 0)
                    (if (= field "tomb-mismatch") (!= (at "tomb-mismatch" r) 0)
                                                  (!= (at "acct-drift" r) 0))))))) res))))
        (attr-a:integer (fold (+) 0 (map (lambda (r:object) (at "na" r)) res)))
        (attr-n:integer (fold (+) 0 (map (lambda (r:object) (at "nn" r)) res)))
    )
    (map print
        [
            (expect
                (format "<<RT-J-002a>> all {} account rows and {} nonce rows attribute to exactly one of the {} ortofungibles"
                    [(length akeys) (length nkeys) (length ids)])
                [(length akeys) (length nkeys)] [attr-a attr-n])
            (expect
                (format "<<RT-J-002b>> supply == sum of LIVE nonce supplies, all {} ortofungibles; offenders: {}"
                    [(length ids) (off "d-live")])
                [] (off "d-live"))
            (expect
                (format "<<RT-J-002c>> tombstone count == UR_NoncesExcluded, and no other negative supply exists; offenders: {} / {}"
                    [(off "d-tomb") (off "other-neg")])
                [[] []] [(off "d-tomb") (off "other-neg")])
            (expect
                (format "<<RT-J-002d>> a nonce is tombstoned (-1.0) IF AND ONLY IF its holder is BAR [{}]; offenders: {}"
                    [bar (off "tomb-mismatch")])
                [] (off "tomb-mismatch"))
            (expect
                (format "<<RT-J-002e>> the CACHED total-account-supply equals the nonces that account actually holds; offenders: {}"
                    [(off "acct-drift")])
                [] (off "acct-drift"))
            (expect
                (format "<<RT-J-002f>> supply == sum of the cached per-account totals; offenders: {}"
                    [(off "d-acct")])
                [] (off "d-acct"))
        ])
    ""
)
(print "")
(print "===^^^===")
(commit-tx)
