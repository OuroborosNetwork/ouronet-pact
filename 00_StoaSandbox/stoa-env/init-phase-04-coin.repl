;; Phase 4 — root `coin` (Stoa native token; live coin.pact) + genesis mint (stoa-genesis-4 tail)
(begin-tx)
(namespace "")

(env-chain-data {"chain-id": "0"})

(env-data
  {
    "payload_stoa-foundation": {
      "keys": [
        "625ad78ab8c1df826d69e1f0e6457334b8e085b7d256d10be41726ced17fdf74"
        "35d7f82a7754d10fc1128d199aadb51cb1461f0eb52f4fa89790a44434f12ed8"
      ],
      "pred": "keys-any"
    }
  }
)

(load "../coin.pact")

(create-table coin-table)
(create-table LocalSupply)
(create-table UR|StoaTable)
(create-table UR|LocalSupply)
(create-table URV|UrStoaVault)
(create-table URV|UrStoaVaultUser)

;; Stoa master key satisfies GOV|STOA_MASTERS; GENESIS is a separate magic cap required inside
;; XM_InitialMint / XM_UR|InitialMint / XM_InitialiseUrStoaVault (mirrors genesis tx granting it).
(env-sigs
  [{"key": "625ad78ab8c1df826d69e1f0e6457334b8e085b7d256d10be41726ced17fdf74", "caps": []}])
(test-capability (coin.GOVERNANCE))
(test-capability (coin.GENESIS))

(define-keyset "stoa-foundation-keyset" (read-keyset "payload_stoa-foundation"))
(coin.A_InitialiseStoaChain "stoa-foundation" (keyset-ref-guard "stoa-foundation-keyset"))

(commit-tx)
(print "Stoa sandbox phase 04: root coin module + tables + genesis initialise")
