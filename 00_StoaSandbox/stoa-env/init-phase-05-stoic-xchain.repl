;; Phase 5 — stoa-ns.stoic-xchain + xchain gas accounts (stoa-genesis-5)
(begin-tx)
(namespace "stoa-ns")
;; Loading into `stoa-ns` needs `ns-operate-keyset`; GOVERNANCE uses `ns-admin-keyset` (phase 01).
(env-sigs
  [{"key": "1a4e15d3c51e0b73e92644600487ba8eaae312e1a178b91801d54e13c1b350a5", "caps": []}
   {"key": "625ad78ab8c1df826d69e1f0e6457334b8e085b7d256d10be41726ced17fdf74", "caps": []}])
(load "../stoa-ns/modules/stoic-xchain.pact")
(test-capability (stoic-xchain.GOVERNANCE))
(stoic-xchain.create-xchain-gas-account true)
(stoic-xchain.create-xchain-gas-account false)
(commit-tx)
(print "Stoa sandbox phase 05: stoic-xchain + kadena-xchain-gas / stoa-xchain-gas accounts")
