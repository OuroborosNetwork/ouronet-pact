.ssh/ouronet_deploy_key
.ssh/ouronet_deploy_key.pub

# Local credentials (PAT, etc.) — never commit
.secrets/

__pycache__/
*.pyc

# BeeDev
.bee/

# Deployed Pact source, cached by module hash. Regenerable in one command
# (REPL/tools/_livemodules.py --probe) and 5.7MB of duplicated source, which would
# make the committed artefact's diff unreadable. The SHAPES live in
# Deploy/LIVE-MODULES.json and are committed.
Deploy/.live-source-cache.json

# The multipact ROUND manifest is a byte-for-byte re-packaging of the .pact files
# beside it (which `_arweave.py --check` already diffs), so it carries no state of
# its own -- committing 3.5 MB of already-checked duplication buys nothing.
# Regenerate with `python3 REPL/tools/_arweave.py --multipact`.
# The small committed format fixture is links/SAMPLE.multipact.json, NOT this.
Deploy/4_Arweave/ROUND.multipact.json

# The virtual chain `_livesandbox.py` builds from `describe-module` output: 389 .pact files,
# 23 MB, rewritten in full on every run. Same class as `.live-source-cache.json` above --
# fetched source, not authored source. Regenerate with
# `python3 REPL/tools/_livesandbox.py --round <dir>`.
Deploy/.livesandbox/

# Stray tool caches. The Pact repo has no npm project; a vitest run from a sibling
# directory created node_modules/.vitest-cache here and it got committed with the
# registry change on 2026-10-27. Ignored so it cannot happen twice.
node_modules/
